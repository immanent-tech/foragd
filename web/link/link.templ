package link

import (
	"context"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"io"
)

templ (l *InternalLink) render() {
	@link.Build(
		// link.WithContent(l
		// 	partials.IconText(tabler.Edit(i.Props{Size: i.SizeXS}), "Edit Subcription")),
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(l.generateAttrs()),
		link.WithExtraClasses("text-xs"),
	).Show()
}

func (l *InternalLink) Render(ctx context.Context, w io.Writer) error {
	return l.render().Render(ctx, w)
}
