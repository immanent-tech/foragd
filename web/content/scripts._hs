def fetchAndProxy(remoteUrl, inputID, formID)
  fetch remoteUrl as HTML
  if the fetch's status >= 200 and the fetch's status < 300
    set inputID's value to the result
    send submit to formID
  else
    log "fetchAndProxy failed with status: " + the fetch's status
    set inputID's value to ''
    send submit to formID
  end
end

def loadingButton
  -- define a reusable behaviour
  behavior LoadingButton
    on htmx:beforeRequest from me
      add .in-flight-request to me
      set my.disabled to true
    on htmx:afterRequest from me
      remove .in-flight-request from me
      set my.disabled to false
  end
end
