package views

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"strconv"
)

// DrawerSubscriptionListID is the ID of the element containing the subscription list in the drawer.
var DrawerSubscriptionListID = attributes.ID("drawer-subscriptions-list")

// TriggerSubscriptionListUpdateHS is a hyperscript snippet to trigger an update of the subscription list in the drawer.
var TriggerSubscriptionListUpdateHS = "on htmx:afterRequest send UpdateState to " + DrawerSubscriptionListID.Target()

templ DrawerHomeLink() {
	@partials.MenuItem(partials.LinkWithIcon(tabler.Home(), "Home", templ.Attributes{
		"hx-get":      "/home",
		"hx-target":   partials.ContentID.Target(),
		"hx-push-url": "true",
	}, nil), nil)
}

templ DrawerSubscriptionList(list templ.Component) {
	@partials.MenuItem(list, templ.Attributes{
		"id":         DrawerSubscriptionListID.String(),
		"hx-get":     "/subscriptions/state",
		"hx-trigger": "htmx:historyRestore from:body,UpdateState from:body,UpdateState",
	})
}

templ SubscriptionList(subscriptions models.Subscriptions) {
	<details>
		<summary>
			<div class="flex gap-2">
				@tabler.Rss()
				Subscriptions
			</div>
		</summary>
		<ul>
			for subscription := range slices.Values(subscriptions) {
				<li>
					<div class="flex">
						<div class="text-sm flex-1">
							@link.Build(
								link.WithContent(subscription.GetTitle()),
								link.WithUnderlineOnHover(),
								link.WithExtraAttributes(viewAction(ctx, subscription.GetID(), subscription.IsUnread())),
								link.WithExtraClasses("text-sm"),
							).Show()
						</div>
						// Display unread count (if any).
						<div class="flex-none">
							if subscription.IsUnread() {
								@badge.Build(
									badge.WithSize(badge.SM),
									badge.WithColor(badge.Secondary),
									badge.WithContent(strconv.Itoa(subscription.UnreadCount)),
									// badge.WithExtraAttributes(templ.Attributes{
									// 	"sse-swap": subscription.GetFeedID() + "_unread",
									// }),
								).Show()
							}
						</div>
					</div>
				</li>
			}
		</ul>
	</details>
}
