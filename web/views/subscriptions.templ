// Layout is the complete page layout for the subscriptions page.
templ (page *SubscriptionsPage) Layout() {
	@layouts.Drawer() {
		@layouts.Header()
		@partials.Content() {
			@page.Content()
		}
	}
}

// Content is the content section of the subscriptions page.
templ (page *SubscriptionsPage) Content() {
	// Fragment: content filters
	<div id="content-filters" class="hidden">
		for name, value := range page.filters.Parameters() {
			@hiddeninput.Build(
				hiddeninput.WithName(name),
				hiddeninput.WithValue(attributes.Value(value)),
			).Show()
		}
	</div>
	<div id="card-controls" class="flex flex-row justify-end m-2">
		@breadcrumbs.Build(
			breadcrumbs.WithClasses("text-sm", "flex-1"),
			breadcrumbs.WithCrumbs(partials.SubscriptionList()),
		).Show()
		<div class="flex flex-row justify-end gap-2">
			@RefreshAction("/subscriptions", page.filters.Parameters())
			@UpdateSorting("/subscriptions", page.filters.GetSort())
			@UpdateFilters(page.categories, "/subscriptions", page.filters.GetCategories(), page.filters.GetView())
			@CollectionActionsMenu(
				markAllSubscriptionsAction(page.filters.GetView()),
			)
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 justify-center gap-4" id={ CardsID.String() }>
		if len(page.cards) > 0 {
			// Fragment: cards
			@page.Cards()
		} else {
			@EmptyContent()
		}
	</div>
	<div id="content-loading" class="items-center justify-center">
		@loading.Build(loading.Bars,
			loading.AsHTMXIndicator(),
			loading.WithThemeColor(color.Accent),
		).Show()
	</div>
}

// Cards is the list of subscriptions as cards within the subscriptions page.
templ (page *SubscriptionsPage) Cards() {
	@templ.Join(page.cards...)
}

// Template will render the home page based on the request details.
func (page *SubscriptionsPage) Template(req *http.Request) templ.Component {
	switch {
	case req.Method == http.MethodPost:
		return page.Cards()
	case htmx.IsHTMX(req) && !htmx.IsHistoryRestoreRequest(req):
		return page.Content()
	default:
		return templates.NewPage("Go Feed Me - Subscriptions",
			templates.WithBodyContent(page.Layout()),
		)
	}
}

type Subscription struct {
	*models.Subscription
	classes []components.Class
}

func NewSubscriptionContent(subscription *models.Subscription) *Subscription {
	card := &Subscription{
		Subscription: subscription,
	}
	if !subscription.IsUnread() {
		card.classes = append(card.classes, opacity.Apply(75))
	}
	return card
}

// Visit is the action for visiting the subscription's source webpage.
templ (c *Subscription) Visit() {
	@link.Build(
		link.WithUnderlineOnHover(),
		link.WithAttributes(templ.Attributes{"href": c.GetLink()}),
		link.WithClasses("text-xs"),
	).Show() {
		<div class="flex gap-2">
			@tabler.ExternalLink(i.Props{Size: i.SizeXS})
			Feed Website
		</div>
	}
}

// Share is the action for sharing the subscription to an external service.
templ (c *Subscription) Share() {
	// @link.Build(
	// 	link.WithContent(
	// 		partials.IconText(tabler.Share(i.Props{Size: i.SizeXS}), "Share")),
	// 	link.WithUnderlineOnHover(),
	// 	link.WithExtraClasses("text-xs"),
	// ).Show()
}

// Mark is the action for marking a subscription read/unread.
templ (c *Subscription) Mark() {
	if c.IsUnread() {
		@partials.LinkMarkRead("Mark Read", c.markAttributes())
	} else {
		@partials.LinkMarkUnread("Mark Unread", c.markAttributes())
	}
}

// Edit is the action for editing a subscription.
templ (c *Subscription) favouriteLink() {
	@partials.NewAction("/user/favourite/subscription/"+c.GetID(),
		partials.ActionMethod(http.MethodPut),
		partials.ActionSwap("none"),
	) {
		<div class="flex gap-2">
			@tabler.Star(i.Props{Size: i.SizeXS})
			Favourite
		</div>
	}
}

// Edit is the action for editing a subscription.
templ (c *Subscription) Edit() {
	@partials.NewAction("/user/subscription/edit/"+c.GetID(),
		partials.ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+partials.ModalID.Target()),
		partials.ActionTarget(partials.ModalContainerID.Target()),
	) {
		<div class="flex gap-2">
			@tabler.Edit(i.Props{Size: i.SizeXS})
			Edit Subscription
		</div>
	}
}

// Unsubscribe is the action for unsubscribing from a subscription.
templ (c *Subscription) Unsubscribe() {
	@partials.NewAction("/subscriptions/remove",
		partials.ActionMethod(http.MethodPost),
		partials.ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+partials.ModalID.Target()),
		partials.ActionTarget(partials.ModalContainerID.Target()),
		partials.ActionValues(map[string]string{
			"subscriptions": c.GetID(),
			"confirmation":  "no",
		}),
	) {
		<div class="flex gap-2">
			@tabler.Trash()
			Remove Subscription
		</div>
	}
}

// Summary displays the subscription's image (or a avatar), title and unread count (if any).
templ (c *Subscription) Summary() {
	@link.Build(
		link.WithUnderlineOnHover(),
		link.WithAttributes(c.viewAttributes()),
	).Show() {
		<div class="flex flex-row gap-2">
			// Generate a thumbnail to display next to the title.
			if c.GetImage() != nil {
				// If the source has an image, use that as the avatar.
				@avatar.Build(
					c.GetImage().URL(),
					avatar.WithWidth("w-12"),
					avatar.WithImageOptions(image.WithLazyLoading()),
					avatar.WithExtraClasses("rounded"),
				).Show()
			} else {
				// Otherwise, take the first letter of the title and create a placeholder avatar.
				@placeholder.Build(c.GetTitle()[0:1], placeholder.SM).Show()
			}
			// Title text is a link to the view action of the card.
			<div class="text-sm grow content-center">
				{ c.GetTitle() }
			</div>
			// Display unread count (if any).
			<div class="content-center">
				if c.IsUnread() {
					@badge.Build(
						badge.WithSize(badge.SM),
						badge.WithColor(badge.Secondary),
						badge.WithContent(strconv.Itoa(c.GetUnreadCount())+" Unread"),
						badge.WithExtraAttributes(templ.Attributes{
							"sse-swap": c.GetFeedID() + "_unread",
						}),
						badge.WithExtraClasses("grow", "text-nowrap"),
					).Show()
				}
			</div>
		</div>
	}
}

// State displays the subscription title and its unread count (if any).
templ (s *Subscription) State() {
	@link.Build(
		link.WithUnderlineOnHover(),
		link.WithAttributes(s.viewAttributes()),
	).Show() {
		<div class="flex gap-2 w-full">
			<div class="flex-1 text-sm content-center">
				{ s.GetTitle() }
			</div>
			// Display unread count (if any).
			<div class="content-center">
				if s.IsUnread() {
					@badge.Build(
						badge.WithSize(badge.SM),
						badge.WithColor(badge.Secondary),
						badge.WithContent(strconv.Itoa(s.GetUnreadCount())+" Unread"),
						badge.WithExtraAttributes(templ.Attributes{
							"sse-swap": s.GetFeedID() + "_unread",
						}),
						badge.WithExtraClasses("grow", "text-nowrap"),
					).Show()
				}
			</div>
		</div>
	}
}

// Card displays the subscription as a card.
templ (c *Subscription) Card() {
	@card.Build(
		card.WithStyle(card.Border),
		card.WithShadow(shadow.SM),
		card.WithExtraClasses("card-sm", "lg:card-md", "bg-base-300"),
		card.WithID(c.GetID()),
		card.WithBodyOptions(
			// Card title.
			card.WithTitle(c.Summary()),
			// Card content.
			card.WithContent(
				templ.Join(
					partials.ContentMetadata(c.GetAuthors(), c.GetUpdatedDate()),
					text.Build(c.GetDescription(),
						text.WithSize(text.XS),
						text.WithOverflow(text.Truncate),
					).Show(),
				),
			),
			// Card actions.
			card.WithActions(
				partials.ContentMenu(c.Share(), c.Visit(), c.Mark(), c.Edit(), c.favouriteLink(), c.Unsubscribe()),
			),
		),
		card.WithExtraClasses(c.classes...),
	).Show()
}

templ (c *Subscription) ShowAsSearchSuggestion() {
	<li class="list-row" _="on click call document.activeElement.blur()">
		<div>
			<div class="list-col-wrap text-xs">
				@c.Summary()
			</div>
			// <div class="text-xs uppercase font-semibold opacity-60">{ article.Item.FeedTitle }</div>
		</div>
	</li>
}

func (c *Subscription) markAttributes() templ.Attributes {
	parameters := map[string]string{
		"subscriptions": c.GetID(),
	}
	// Create htmx attributes: don't replace URL, swap the subscription card only.
	attrs := templ.Attributes{
		"hx-target":       "#" + c.GetID(),
		"hx-target-error": partials.ErrorID.Target(),
		"hx-swap":         "outerHTML",
		"hx-vals":         partials.GenerateHXVals(parameters),
	}
	if c.IsUnread() {
		attrs["hx-post"] = "/subscriptions/mark/" + string(models.MarkRead)
		return attrs
	}
	attrs["hx-post"] = "/subscriptions/mark/" + string(models.MarkUnread)
	return attrs
}

func (c *Subscription) viewAttributes() templ.Attributes {
	overrides := map[string]string{
		models.ParamSortBy: string(models.SortByLastUpdated),
		"subscriptions":    c.GetID(),
	}
	if c.IsUnread() {
		overrides[models.ParamView] = string(models.ViewUnread)
	} else {
		overrides[models.ParamView] = string(models.ViewRead)
	}
	return templ.Attributes{
		"hx-get":      "/articles",
		"hx-include":  "#content-filters",
		"hx-vals":     partials.GenerateHXVals(overrides),
		"hx-target":   partials.ContentID.Target(),
		"hx-push-url": "true",
		"hx-swap":     "innerHTML show:top",
	}
}
