package views

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/actions/modal"
	"github.com/joshuar/go-templ-daisyui/display/text"
	"github.com/joshuar/go-templ-daisyui/feedback/loading"
	"github.com/joshuar/go-templ-daisyui/input/fieldset"
	"github.com/joshuar/go-templ-daisyui/input/form"
	"github.com/joshuar/go-templ-daisyui/input/hiddeninput"
	"github.com/joshuar/go-templ-daisyui/input/textinput"
	"github.com/joshuar/go-templ-daisyui/layout/join"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
)

type SubscriptionEditRequest struct {
	*models.Subscription
	TopCategories []models.Category
}

templ (s *SubscriptionEditRequest) EditSubscriptionModal() {
	@modal.Build(
		modal.WithID(partials.ModalID.String()),
		modal.WithCloseButton(),
		modal.WithCloseOutside(),
	).Show() {
		@text.Build("Edit Subscription", text.WithSize(text.LG)).Show()
		// Display the Subscription details.
		@form.BuildForm(
			form.WithID("subscription-details"),
			form.WithExtraAttributes(
				templ.Attributes{
					"hx-put":       "/subscription/edit/" + s.GetID(),
					"hx-swap":      "none",
					"hx-indicator": "#add-processing",
				},
			),
			form.WithElements(
				fieldset.Build(
					fieldset.WithField("",
						hiddeninput.Build(
							hiddeninput.WithName("subscription_id"),
							hiddeninput.WithValue(s.GetID()),
						),
					),
					fieldset.WithField("Nickname (optional)",
						textinput.Build(
							textinput.WithName("user_nickname"),
							textinput.WithValue(s.GetName()),
							textinput.WithPlaceholder("My memorable feed name"),
							textinput.Required(),
						),
					),
				).Show(),
			),
		).Show()
		@editCategories(s.GetCategories(), s.TopCategories)
		// Add a button to submit the Subscription details when finished editing.
		@fieldset.Build(
			fieldset.WithField("",
				button.Build(
					button.WithContent("Make it so!"),
					button.WithExtraAttributes(templ.Attributes{
						"form": "subscription-details",
						"_":    "on click remove @open from " + partials.ModalID.Target(),
					})),
			),
		).Show()
		<center id="add-processing" class="htmx-indicator">
			Adding
			@loading.Build(loading.Infinity).Show()
		</center>
	}
}

// SubscriptionRequest is a wrapper around models.SubscriptionRequest to allow extending it with templates.
type SubscriptionRequest struct {
	*models.SubscriptionRequest
	TopCategories []models.Category
}

func NewSubscriptionRequest(req *models.SubscriptionRequest) *SubscriptionRequest {
	return &SubscriptionRequest{
		SubscriptionRequest: req,
	}
}

// NewSubscriptionModal will display a modal for the user to enter new Subscription details.
templ NewSubscriptionModal(request *models.SubscriptionRequest) {
	@modal.Build(
		modal.WithID(partials.ModalID.String()),
		modal.WithCloseButton(),
		modal.WithCloseOutside(),
	).Show() {
		@text.Build("Add a new subscription", text.WithSize(text.LG)).Show()
		if request.Result != nil {
			@partials.Alert(request.Result, nil)
		}
		// Display the Subscription details.
		@form.BuildForm(
			form.WithID("subscription_details"),
			form.WithExtraAttributes(
				templ.Attributes{
					"hx-put":       "/subscription/add",
					"hx-target":    partials.ModalID.Target(),
					"hx-swap":      "morph:outerHTML",
					"hx-indicator": "#add-processing",
				},
			),
			form.WithElements(
				fieldset.Build(
					// fieldset.WithField("",
					// 	hiddeninput.Build(
					// 		hiddeninput.WithName("subscription_id"),
					// 		hiddeninput.WithValue(request.GetID()),
					// 	),
					// ),
					fieldset.WithLegend("Subscription details:"),
					fieldset.WithField("URL",
						textinput.Build(
							textinput.AsType(textinput.URL),
							textinput.WithName("url"),
							textinput.WithPlaceholder("https://awesomefeed.lol.rss"),
							textinput.Required(),
							textinput.Validate(),
							textinput.ValidateHint("A valid URL to a feed is required."),
							textinput.WithValue(request.URL),
						),
					),
					fieldset.WithField("Nickname (optional)",
						textinput.Build(
							textinput.WithName("user_nickname"),
							textinput.WithValue(request.UserNickname),
							textinput.WithPlaceholder("My memorable feed name"),
						),
					),
				).Show(),
			),
		).Show()
		@editCategories(request.UserCategories, nil)
		// Add a button to submit the Subscription details when finished editing.
		@fieldset.Build(
			fieldset.WithField("",
				button.Build(
					button.WithContent("Make it so!"),
					button.WithExtraAttributes(templ.Attributes{
						"form": "subscription_details",
					})),
			),
		).Show()
		<center id="add-processing" class="htmx-indicator">
			Adding
			@loading.Build(loading.Infinity).Show()
		</center>
	}
}

templ editCategories(existing []models.Category, suggested []models.Category) {
	<form
		id="editCategories"
		_={ `on submit
      halt the event
      set categoryInput to (first <input/> in me).value
      set formID to my id
      send newCategory(category: categoryInput, formTarget: 'subscription-details') to #categories
      set value of first <input/> in me to ''
      ` }
	>
		<fieldset class="fieldset">
			<label class="label">Add Category (optional)</label>
			@join.Horizontally() {
				@textinput.Build(
					textinput.WithPlaceholder("CoolStuff"),
					textinput.WithExtraAttributes(templ.Attributes{
						"list": "categorySuggestions",
					}),
				).Show("join-item")
				@button.Build(
					button.AsShape(button.Square),
					button.WithContent(tabler.CategoryPlus()),
				).Show("join-item")
			}
			<datalist id="categorySuggestions">
				for category := range slices.Values(suggested) {
					<option value={ category }></option>
				}
			</datalist>
		</fieldset>
	</form>
	<form>
		<fieldset
			id="categories"
			class="fieldset"
			_="
			on newCategory(category, formTarget)
			  make a <input/>
			  set its type to 'hidden'
			  set its name to 'user_categories[]'
			  set its value to category
			  set its id to category
			  set its @form to formTarget
			  append it to me
			  make a <li/> then put category into it
       		  put it at the start of #shown-categories
			end

			on delCategory(category)
			  tell <input[id=`${category}`]/>
			  	remove yourself
			  end
			for el in #shown-categories.children
         	  if innerHTML of el == category
           	  	remove el
         	  end
       		end
			"
		>
			<label class="label">Current Categories (click a category to remove):</label>
			<ul
				id="shown-categories"
				_="on click send delCategory(category: innerHTML of target) to #categories"
			>
				for category := range slices.Values(existing) {
					<li>{ category }</li>
				}
			</ul>
			for category := range slices.Values(existing) {
				@hiddeninput.Build(
					hiddeninput.WithID(category),
					hiddeninput.WithName("user_categories[]"),
					hiddeninput.WithValue(category),
					hiddeninput.WithExtraAttributes(templ.Attributes{
						"form": "subscription-details",
					}),
				).Show()
			}
		</fieldset>
	</form>
}
