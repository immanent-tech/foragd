package views

import (
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/actions/dropdown"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/joshuar/go-templ-daisyui/navigation/navbar"
	"github.com/sebasvil20/templicons/tabler"
)

var HeaderID = attributes.ID("header")

templ Header() {
	@navbar.Build(navbar.WithID(HeaderID.String()),
		navbar.WithBaseColor(color.Base200),
		navbar.NavBarStart(DefaultHeaderStart()),
		navbar.NavBarCenter(DefaultHeaderCenter()),
		navbar.NavBarEnd(DefaultHeaderEnd()),
	).Show()
}

templ DefaultHeaderStart() {
	<div class="flex-none">
		<label for="body-drawer" class="btn btn-square drawer-button">
			@tabler.Menu()
		</label>
	</div>
}

templ DefaultHeaderCenter() {
	<div class="flex-1">
		@SearchForm()
	</div>
}

templ DefaultHeaderEnd() {
	<div title="Settings" class="flex-none">
		@dropdown.Build(
			dropdown.WithButtonContent(tabler.User()),
			dropdown.WithOpenAlignment(dropdown.AlignEnd),
			dropdown.WithMenuClasses("flex-nowrap", "grow", "min-w-52"),
		).Show() {
			<li>
				@partials.LinkWithIcon(tabler.Settings(), "Settings", templ.Attributes{
					"hx-get":         "/settings",
					"hx-target":      partials.ContentID.Target(),
					"hx-replace-url": "true",
				}, []string{"text-sm"})
			</li>
			<li _="on click call document.activeElement.blur()">
				@partials.LinkWithIcon(tabler.FilePlus(), "Add Subscription", templ.Attributes{
					"hx-get":    "/subscription/new",
					"hx-target": partials.ModalContainerID.Target(),
					// "_":         "on htmx:afterOnLoad wait 10ms then add @open to " + ModalID.Target(),
				}, []string{"text-sm"})
			</li>
			<li _="on click call document.activeElement.blur()">
				@partials.LinkWithIcon(tabler.FilePlus(), "Import Subscriptions", templ.Attributes{
					"hx-get":         "/subscriptions/import",
					"hx-target":      partials.ContentID.Target(),
					"hx-replace-url": "true",
					// "_":         "on htmx:afterOnLoad wait 10ms then add @open to " + ModalID.Target(),
				}, []string{"text-sm"})
			</li>
			<li>
				@partials.LinkWithIcon(tabler.Logout(), "Logout", templ.Attributes{
					"href": "/logout",
				}, []string{"text-sm"})
			</li>
		}
	</div>
}
