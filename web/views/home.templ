package views

import (
	"github.com/angelofallars/htmx-go"
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/content"
	"github.com/joshuar/go-feed-me/web/templates/layouts"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"strconv"
)

// Layout is the complete page layout for the home page.
templ (page *HomePage) Layout() {
	@layouts.Drawer() {
		@layouts.Header()
		@partials.Content() {
			@page.Content()
		}
	}
}

// Content is the content section of the home page
templ (page *HomePage) Content() {
	if len(page.Subscriptions) == 0 {
		@EmptyHome()
		return
	}
	<div class="grid justify-center">
		<div class="stats shadow">
			@link.Build(
				link.WithUnderlineOnHover(),
				link.WithAttributes(templ.Attributes{
					"hx-get":      "/subscriptions",
					"hx-vals":     partials.GenerateHXVals(session.SubscriptionFiltersFromSession(ctx).Parameters()),
					"hx-target":   partials.ContentID.Target(),
					"hx-swap":     "innerHTML",
					"hx-push-url": "true",
				}),
			) {
				<div class="stat bg-base-300">
					<div class="stat-figure">
						@tabler.Rss(i.Props{StrokeWidth: i.StrokeBold, Size: "48"})
					</div>
					<div class="stat-title">Subscriptions</div>
					<div class="stat-value">{ strconv.Itoa(len(page.Subscriptions)) }</div>
				</div>
			}
			@link.Build(
				link.WithUnderlineOnHover(),
				link.WithAttributes(templ.Attributes{
					"hx-get":      "/articles",
					"hx-vals":     partials.GenerateHXVals(session.ArticleFiltersFromSession(ctx).Parameters()),
					"hx-target":   partials.ContentID.Target(),
					"hx-swap":     "innerHTML",
					"hx-push-url": "true",
				}),
			) {
				<div class="stat bg-base-300">
					<div class="stat-figure">
						@tabler.Article(i.Props{StrokeWidth: i.StrokeBold, Size: "48"})
					</div>
					<div class="stat-title">Unread Articles</div>
					<div class="stat-value">{ strconv.Itoa(page.Subscriptions.GetTotalUnreadCount()) }</div>
				</div>
			}
		</div>
	</div>
	if page.TopCategories != nil {
		<div class="flex justify-center gap-2 m-4">
			<h1 class="content-center text-center">Top Categories:</h1>
			<div id="top-categories" class="flex flex-row flex-wrap gap-2">
				@page.TopCategories
			</div>
		</div>
	}
	if page.RareCategories != nil {
		<div class="flex justify-center gap-2 m-4">
			<h1 class="content-center text-center">Interesting Categories:</h1>
			<div id="rare-categories" class="flex flex-row flex-wrap gap-2">
				@page.RareCategories
			</div>
		</div>
	}
	if page.RandomArticles != nil {
		<div class="flex flex-col gap-2">
			<h1>Random Articles:</h1>
			@content.CardGrid(page.RandomArticles...)
		</div>
	}
	@partials.Footer()
}

// Template will render the home page based on the request details.
func (page *HomePage) Template(req *http.Request) templ.Component {
	switch {
	case htmx.IsHTMX(req) && !htmx.IsHistoryRestoreRequest(req):
		return page.Content()
	default:
		return templates.NewPage("Go Feed Me - Home",
			templates.WithBodyContent(page.Layout()),
		)
	}
}

templ EmptyHome() {
	@layouts.Drawer() {
		// Fragment: content header
		@partials.Fragment("content-header") {
			@layouts.Header()
		}
		@partials.Fragment("content") {
			@partials.Content() {
				<div class="hero bg-base-200 min-h-screen">
					<div class="hero-content text-center">
						<div class="max-w-md">
							<h1 class="text-5xl font-bold">Welcome Home</h1>
							<p class="py-6">
								There does not seem to be anything to show you. Maybe you should try one of the following:
							</p>
							@partials.NewAction("/user/subscription/new", partials.DisplayActionAsButton,
								partials.ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+partials.ModalID.Target()),
								partials.ActionTarget(partials.ModalContainerID.Target()),
							) {
								New Subscription
							}
							@partials.NewAction("/user/subscription/new", partials.DisplayActionAsButton,
								partials.ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+partials.ModalID.Target()),
							) {
								Import Subscriptions
							}
						</div>
					</div>
				</div>
			}
		}
		// Fragment: content footer
		@partials.Fragment("content-footer") {
			@partials.Footer()
		}
	}
}
