package templates

templ formSection(title, description string) {
	<div>
		<h3 class="text-base/7 font-semibold">{ title }</h3>
		if description != "" {
			<p class="mt-1 text-sm/6">{ description }</p>
		}
	</div>
	<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:place-items-center sm:grid-cols-6 md:col-span-2">
		{ children... }
	</div>
}
