package templates

import (
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
)

// Body represents a page's <body></body> element.
type Body struct {
	header  templ.Component
	footer  templ.Component
	content templ.Component
}

// BodyOption is a functional option to apply to the body.
type BodyOption func(*Body)

// WithBodyHeader option adds a header component to the body.
func WithBodyHeader(header templ.Component) BodyOption {
	return func(b *Body) {
		b.header = header
	}
}

// WithBodyFooter option adds a footer component to the body.
func WithBodyFooter(footer templ.Component) BodyOption {
	return func(b *Body) {
		b.footer = footer
	}
}

// NewBody creates a new body page component with the given content and options.
func NewBody(content templ.Component, options ...BodyOption) *Body {
	body := &Body{
		content: content,
	}
	for option := range slices.Values(options) {
		option(body)
	}
	return body
}

// Show renders the Body as a templ Component.
templ (body *Body) Show() {
	<div class="drawer">
		<input id="body-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="drawer-content">
			if body.header != nil {
				@body.header
			} else {
				@partials.Header(
					partials.DefaultHeaderStart(),
					partials.DefaultHeaderCenter(),
					partials.DefaultHeaderEnd(),
				)
			}
			<div
				id={ partials.ContentID.String() }
				class="m-2"
				hx-swap="morph:innerHTML"
				hx-target={ partials.ContentID.Target() }
				hx-target-error={ partials.ErrorID.Target() }
			>
				@body.content
			</div>
			if body.footer != nil {
				@body.footer
			} else {
				@partials.Footer()
			}
		</div>
		<div class="drawer-side">
			@partials.DrawerDefault()
		</div>
	</div>
}
