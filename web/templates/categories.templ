package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"strings"
)

templ CategoryManagement(path, inputName string, suggested []models.Category, existing []models.Category) {
	<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
		<label for="add-categories">
			@partials.Heading3() {
				Add Categories
			}
			<p class="mt-1 text-sm/6">Optional. Add additional categories to the subscription.</p>
		</label>
		// Add categories.
		<div class="grid sm:max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
			// Add from suggested categories.
			<el-autocomplete class="sm:col-span-4 mt-2">
				<form
					id="add-categories"
					hx-post={ path }
					hx-on::after-request="if(event.detail.successful) this.reset()"
					hx-include="[name='categories']"
					hx-vals={ templ.JSONString(map[string]any{"inputName": inputName}) }
					hx-target="#current-categories"
					hx-swap="beforeend"
					class="join"
				>
					<input
						name="category"
						class="input input-primary bg-base-content/10 join-item"
						placeholder="Category"
					/>
					<button
						type="button"
						if len(suggested) == 0 {
							disabled
						}
						class="btn bg-base-content/10 join-item"
					>
						@tabler.ChevronDown()
					</button>
					<button
						type="submit"
						class="btn btn-primary join-item"
					>
						@tabler.Plus()
					</button>
				</form>
				<el-options popover anchor="bottom start" class="w-(--input-width) overflow-auto">
					for category := range slices.Values(suggested) {
						<el-option value={ category }>{ category }</el-option>
					}
				</el-options>
			</el-autocomplete>
		</div>
	</div>
	// Manage categories.
	<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
		<div>
			<label for="current-categories">
				@partials.Heading3() {
					Manage Existing Categories
				}
			</label>
			<p class="mt-1 text-sm/6">Existing categories. Click the X to remove them from the subscription.</p>
		</div>
		<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
			<div class="sm:col-span-4">
				<div class="flex gap-2 p-2 m-2">
					<div id="current-categories" class="flex flex-row flex-wrap p-2 gap-2">
						for category := range slices.Values(existing) {
							@AddCategory(path, inputName, category)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

// AddCategory renders a new category item to the list of categories of a subscription.
templ AddCategory(path, inputName string, category models.Category) {
	<button
		hx-delete={ path }
		hx-target="closest button"
		hx-swap="delete"
	>
		<input type="hidden" name={ inputName } value={ category }/>
		<div class="flex gap-2 text-sm">
			@NewCategoryBadge(category).Render("badge-outline") {
				@tabler.X(i.Props{Class: "size-4"})
			}
		</div>
	</button>
}

// CategoryBadge represents a Category as a badge in the UI.
type CategoryBadge models.Category

// NewCategoryBadge creates a new CategoryBadge from the given Category.
func NewCategoryBadge(category models.Category) CategoryBadge {
	return CategoryBadge(category)
}

// Render will render the CategoryBadge.
templ (c CategoryBadge) Render(classes ...string) {
	<div class={ "badge", templ.KV(strings.Join(classes," "),len(classes)>0) }>
		{ c }
		{ children... }
	</div>
}
