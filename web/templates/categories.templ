package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"slices"
	"strings"
)

templ CategoryManagement(suggested []models.Category, existing []models.Category) {
	<div>
		<button type="button" command="--toggle" commandfor="categories" class="flex w-full items-center justify-between text-left">
			<div>
				<h2 class="text-base/7 font-semibold">Categories</h2>
				<p class="mt-1 max-w-2xl text-sm/6">Add/remove categories to the subscription.</p>
			</div>
			<span class="ml-6 flex h-7 items-center">
				<svg aria-label="Expand section" xmlns="http://www.w3.org/2000/svg" data-slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus in-aria-expanded:hidden">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path>
				</svg>
				<svg aria-label="Collapse section" xmlns="http://www.w3.org/2000/svg" data-slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-minus not-in-aria-expanded:hidden">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l14 0"></path>
				</svg>
			</span>
		</button>
		@partials.FormSection() {
			<el-disclosure
				hidden
				id="categories"
			>
				<div class="space-y-8 border-b border-base-300 sm:space-y-0 sm:divide-y sm:divide-base-300 sm:border-t sm:border-t-base-300">
					@partials.FormField() {
						<label for="category-suggestion" class="block text-sm/6 font-medium text-base-content sm:pt-1.5">Add category</label>
						<div class="mt-2 sm:col-span-2 sm:mt-0 join">
							<el-autocomplete class="sm:col-span-4 join join-item">
								<input
									id="category-suggestion"
									name="category"
									class="input input-primary bg-base-300 brightness-95 join-item"
									placeholder="Category..."
									_="on keydown[key=='Enter'] send categorySuggestionSelected then halt the event"
								/>
								<button
									type="button"
									if len(suggested) == 0 {
										disabled
									}
									class="btn bg-base-100 brightness-95 join-item"
								>
									<span class="sr-only">Show category suggestions</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6 9l6 6l6 -6"></path>
									</svg>
								</button>
								<el-options popover anchor="bottom start" class="w-(--input-width) overflow-auto">
									for category := range slices.Values(suggested) {
										<el-option value={ category }>{ category }</el-option>
									}
								</el-options>
							</el-autocomplete>
							<button
								hx-post="/subscription/category"
								hx-params={ strings.Join([]string{"category", models.ParamCustomisationCategories}, ",") }
								hx-target="#current-categories"
								hx-swap="beforeend"
								hx-trigger="click, categorySuggestionSelected from:body"
								type="button"
								class="btn btn-primary join-item"
								_="on htmx:afterRequest if event.detail.successful then set #category-suggestion.value to ''"
							>
								<span class="sr-only">Add category</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path>
								</svg>
							</button>
						</div>
					}
					@partials.FormField() {
						<label for="categories" class="block text-sm/6 font-medium text-base-content sm:pt-1.5">Categories</label>
						<div id="current-categories" class="mt-2 sm:col-span-2 sm:mt-0 flex flex-row flex-wrap p-2 gap-2">
							for category := range slices.Values(existing) {
								@AddCategory(category)
							}
						</div>
					}
				</div>
			</el-disclosure>
		}
	</div>
}

// AddCategory renders a new category item to the list of categories of a subscription.
templ AddCategory(category models.Category) {
	<div class="badge badge-outline m-1 flex items-center">
		<input type="hidden" name={ models.ParamCustomisationCategories } value={ category }/>
		{ category }
		<button
			type="button"
			aria-label={ "Remove category " + category }
			_="on click remove the closest <div/>"
		>
			<span class="sr-only">Remove category</span>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
			</svg>
		</button>
	</div>
}
