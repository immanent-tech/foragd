package templates

import "github.com/dimmerz92/go-icons/tabler-outline"

templ pricing() {
	<form class="group/tiers">
		<div class="mt-16 mb-8 flex justify-center">
			<fieldset aria-label="Payment frequency">
				<div class="grid grid-cols-2 gap-x-1 rounded-full p-1 text-center font-display text-lg font-semibold inset-ring inset-ring-neutral">
					<label class="group relative rounded-full px-2.5 py-1 has-checked:bg-primary">
						<input type="radio" name="frequency" value="monthly" class="absolute inset-0 appearance-none rounded-full"/>
						<span class="group-has-checked:text-primary-content">Monthly</span>
					</label>
					<label class="group relative rounded-full px-2.5 py-1 has-checked:bg-primary">
						<input type="radio" name="frequency" value="annually" checked class="absolute inset-0 appearance-none rounded-full"/>
						<span class="group-has-checked:text-primary-content">Annually</span>
					</label>
				</div>
			</fieldset>
		</div>
		<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
			<div class="col-span-full -m-2 mx-auto grid max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
				<div class="grid grid-cols-1 gap-4 rounded-4xl p-2">
					<div class="group/tier card w-full bg-base-200 shadow-sm sm:w-lg">
						<div class="card-body">
							<h2 class="font-display text-2xl font-semibold text-primary">The One <span class="sr-only">plan</span></h2>
							<div class="flex-separated mt-2 flex flex-wrap items-center justify-center text-lg/7 text-pretty text-neutral">
								<span>Single plan</span>
								<span>All features included</span>
								<span>Generous limits</span>
							</div>
							<div class="mt-4 mb-auto flex items-center gap-4 group-not-has-[[name=frequency][value=annually]:checked]/tiers:hidden">
								<div class="text-5xl font-semibold">$59</div>
								<div class="text-sm">
									<p>USD annually (with 14 day free trial)</p>
								</div>
							</div>
							<div class="mt-4 mb-auto flex items-center gap-4 group-not-has-[[name=frequency][value=monthly]:checked]/tiers:hidden">
								<div class="text-5xl font-semibold">$7</div>
								<div class="text-sm">
									<p>USD per month (with 14 day free trial)</p>
								</div>
							</div>
							<p class="mt-2 text-left text-sm/6 font-semibold text-accent group-not-has-[[name=frequency][value=annually]:checked]/tiers:hidden">
								<span class="badge badge-sm text-warning-content badge-warning">Best value</span>
								Save ~30% discount vs. monthly subscription.
							</p>
							<div class="mt-8 text-left">
								<h3 class="text-lg font-medium">Features:</h3>
								<ul class="mt-3 space-y-3">
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										3000 subscriptions.
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										50 email newsletters.
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										Fetch remote article content.
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										Add favorite subscriptions and articles.
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 shrink-0 text-accent", "aria-hidden": "true"})
										Group subscriptions (combine multiple feeds into one).
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 shrink-0 text-accent", "aria-hidden": "true"})
										Search subscriptions (save search results as a subscription).
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										Full text search through articles.
									</li>
									<li class="group flex items-center gap-4 text-base/7 data-disabled:text-neutral data-disabled:brightness-95">
										@tableroutline.Check(templ.Attributes{"class": "size-4 text-accent", "aria-hidden": "true"})
										No ads, no recommended content, ever.
									</li>
								</ul>
							</div>
							<div class="mt-8">
								<div class="my-2 text-center text-lg font-semibold text-primary">
									Plan includes a 14 day free trial. Sign up now, pay nothing until end of trial period.
								</div>
								{ children... }
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</form>
}
