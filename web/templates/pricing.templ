package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ pricingGrid(action, method, selectedID, selectedText string) {
	<div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
		<div class="-m-2 grid mx-auto col-span-full rounded-4xl bg-base-100 shadow-[inset_0_0_2px_1px_#ffffff4d] max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
			<div class="grid grid-cols-1 rounded-4xl p-2 shadow-md shadow-black/5">
				<div class="rounded-3xl bg-base-200 p-10 pb-9 shadow-2xl">
					<h2 class="text-lg/7 font-semibold text-primary">The One <span class="sr-only">plan</span></h2>
					if selectedID == "TheOne-85297d6" {
						<span class="badge badge-xs badge-primary">{ selectedText }</span>
					}
					<p class="mt-2 text-sm/6 text-pretty text-neutral">Single plan, all features, generous inclusions.</p>
					<div class="mt-8 flex items-center gap-4">
						<div class="text-5xl font-semibold">$7</div>
						<div class="text-sm">
							<p>USD</p>
							<p>per month</p>
						</div>
					</div>
					<div class="mt-8">
						if user, err := models.UserFromCtx(ctx); err != nil && user != nil {
							<form action={ action } method={ method }>
								<input type="hidden" name={ models.ParamPlanID } value="TheOne-85297d6"/>
								<button aria-label="Start a free trial on the One plan" id="checkout-theone" type="submit" class="btn btn-accent btn-block">Start a free trial</button>
							</form>
						} else {
							<a
								role="button"
								class="btn btn-accent btn-block"
								rel="noopener"
								target="_blank"
								href="https://docs.google.com/forms/d/e/1FAIpQLSfMnLy6zJToJ8yuQfr8TlsnTuC7Bt4x2OGhl9F_jP6IncGiCA/viewform?usp=dialog"
							>Sign up for beta access</a>
						}
					</div>
					<div class="mt-8">
						<h3 class="text-sm/6 font-medium">Features:</h3>
						<ul class="mt-3 space-y-3">
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								3000 subscriptions.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								50 email newsletters.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Fetch remote article content.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Add favorite subscriptions and articles.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Group subscriptions (combine multiple feeds into one).
								<a href="/help#group-subscriptions" rel="noopener" target="_blank" class="link">
									@tabler.HelpCircle(i.Props{Class: "size-6"})
								</a>
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Search subscriptions (save search results as a subscription).
								<a href="/help#search-subscriptions" rel="noopener" target="_blank" class="link">
									@tabler.HelpCircle(i.Props{Class: "size-6"})
								</a>
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Full text search through articles.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								No ads, no recommended content, ever.
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Personal use only.
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
}
