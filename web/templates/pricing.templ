package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ pricingGrid(action, method, selectedID, selectedText string) {
	<div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
		<div class="-m-2 grid grid-cols-1 rounded-4xl bg-base-100 shadow-[inset_0_0_2px_1px_#ffffff4d] max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
			<div class="grid grid-cols-1 rounded-4xl p-2 shadow-md shadow-black/5">
				<div class="rounded-3xl bg-base-200 p-10 pb-9 shadow-2xl">
					<h2 class="text-lg/7 font-semibold text-primary">Gatherer <span class="sr-only">plan</span></h2>
					if selectedID == "Gatherer-85297d6" {
						<span class="badge badge-xs badge-primary">{ selectedText }</span>
					}
					<p class="mt-2 text-sm/6 text-pretty text-neutral">Perfect for keeping up with the latest news feeds.</p>
					<div class="mt-8 flex items-center gap-4">
						<div class="text-5xl font-semibold">$6</div>
						<div class="text-sm">
							<p>USD</p>
							<p>per month</p>
						</div>
					</div>
					<div class="mt-8">
						<form action={ action } method={ method }>
							@UpdateCSRFToken()
							<input type="hidden" name={ models.ParamPlanID } value="Gatherer-85297d6"/>
							<button aria-label="Start a free trial on the Gatherer plan" id="checkout-gatherer" type="submit" class="btn btn-accent btn-block">Start a free trial</button>
						</form>
					</div>
					<div class="mt-8">
						<h3 class="text-sm/6 font-medium">Features:</h3>
						<ul class="mt-3 space-y-3">
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Last week article history
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								15 feed subscriptions
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Personal use only
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="-m-2 grid grid-cols-1 rounded-4xl bg-base-100 shadow-[inset_0_0_2px_1px_#ffffff4d] max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
			<div class="grid grid-cols-1 rounded-4xl p-2 shadow-md shadow-black/5">
				<div class="rounded-3xl bg-base-200 p-10 pb-9 shadow-2xl">
					<h2 class="text-lg/7 font-semibold text-primary">Collector <span class="sr-only">plan</span></h2>
					if selectedID == "Collector-07ad4d0" {
						<span class="badge badge-xs badge-primary">{ selectedText }</span>
					}
					<p class="mt-2 text-sm/6 text-pretty text-neutral">Great for following the news and your favorite blogs/content sites.</p>
					<div class="mt-8 flex items-center gap-4">
						<div class="text-5xl font-semibold">$8</div>
						<div class="text-sm">
							<p>USD</p>
							<p>per month</p>
						</div>
					</div>
					<div class="mt-8">
						<form action={ action } method={ method }>
							@UpdateCSRFToken()
							<input type="hidden" name={ models.ParamPlanID } value="Collector-07ad4d0"/>
							<button aria-label="Start a free trial on the Collector plan" id="checkout-collector" type="submit" class="btn btn-accent btn-block">Start a free trial</button>
						</form>
					</div>
					<div class="mt-8">
						<h3 class="text-sm/6 font-medium">Features:</h3>
						<ul class="mt-3 space-y-3">
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Last six months article history
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								150 feed subscriptions
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Add favorite subscriptions and articles
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Personal use only
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="-m-2 grid grid-cols-1 rounded-4xl bg-base-100 shadow-[inset_0_0_2px_1px_#ffffff4d] max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
			<div class="grid grid-cols-1 rounded-4xl p-2 shadow-md shadow-black/5">
				<div class="rounded-3xl bg-base-200 p-10 pb-9 shadow-2xl">
					<h2 class="text-lg/7 font-semibold text-primary">Curator <span class="sr-only">plan</span></h2>
					if selectedID == "Curator-2c67637" {
						<span class="badge badge-xs badge-primary">{ selectedText }</span>
					}
					<p class="mt-2 text-sm/6 text-pretty text-neutral">Extensive article history with all current and new features.</p>
					<div class="mt-8 flex items-center gap-4">
						<div class="text-5xl font-semibold">$18</div>
						<div class="text-sm">
							<p>USD</p>
							<p>per month</p>
						</div>
					</div>
					<div class="mt-8">
						<form action={ action } method={ method }>
							@UpdateCSRFToken()
							<input type="hidden" name={ models.ParamPlanID } value="Curator-2c67637"/>
							<button aria-label="Start a free trial on the Curator plan" id="checkout-curator" type="submit" class="btn btn-accent btn-block">Start a free trial</button>
						</form>
					</div>
					<div class="mt-8">
						<h3 class="text-sm/6 font-medium">Features:</h3>
						<ul class="mt-3 space-y-3">
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Last two years article history
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Unlimited feed subscriptions
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Group subscriptions (combine multiple feeds into one)
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Search subscriptions (save search results as subscription)
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Add favorite subscriptions and articles
							</li>
							<li class="group flex items-start gap-4 text-sm/6 data-disabled:text-neutral/90">
								<span class="inline-flex h-6 items-center">
									@tabler.Plus(i.Props{Class: "size-4 group-data-disabled:text-neutral/90"})
								</span>
								Personal use only
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
}
