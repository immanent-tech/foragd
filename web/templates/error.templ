package templates

import "github.com/immanent-tech/foragd/models"

const ErrorFragment templFragmentKey = "error"

templ InternalError(user *models.User, referer string, msg *models.UserMessage) {
	@LayoutInternal(&InternalLayoutProps{User: user}) {
		@templ.Fragment(ErrorFragment) {
			@container() {
				<div class="mt-12 text-center">
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mood-confuzed mx-auto size-12 text-accent">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 10l.01 0"></path><path d="M15 10l.01 0"></path><path d="M9.5 16a10 10 0 0 1 6 -1.5"></path>
					</svg>
					if msg != nil {
						<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ msg.Summary }</h1>
						if msg.HasDetails() {
							<p>{ *msg.Details }</p>
						}
					} else {
						<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Whoops!</h1>
						<p>An unexpected problem occurred and the request could not be completed. This is likely a temporary problem. Please try again.</p>
					}
					<div class="mt-6">
						<a
							if referer != "" {
								href={ referer }
							} else {
								href="/home"
							}
							role="button"
							class="btn btn-outline"
						>
							Go Back
						</a>
						<a href="/contact" class="btn btn-primary">
							Contact Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				</div>
			}
		}
	}
}

templ ExternalError(user *models.User, msg *models.UserMessage) {
	@LayoutExternal() {
		@templ.Fragment(ErrorFragment) {
			@container() {
				<div class="my-auto py-24 sm:pt-12 sm:pb-32">
					@container() {
						<div class="text-center">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mood-confuzed mx-auto size-12 text-accent">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 10l.01 0"></path><path d="M15 10l.01 0"></path><path d="M9.5 16a10 10 0 0 1 6 -1.5"></path>
							</svg>
							if msg != nil {
								<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ msg.Summary }</h1>
								if msg.HasDetails() {
									<p>{ *msg.Details }</p>
								}
							} else {
								<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Whoops!</h1>
								<p>An unexpected problem occurred and the request could not be completed. This is likely a temporary problem. Please try again.</p>
							}
							<div class="mx-auto mt-8 flex items-center justify-center space-x-4">
								<a href="/" role="button" class="btn btn-primary">
									Go Back
								</a>
								<a role="button" href="mailto:support@immanent.tech&subject=Foragd Issue" class="btn btn-primary">
									Email Support <span aria-hidden="true">&rarr;</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		}
	}
}

templ NotFound() {
	@templ.Fragment(ErrorFragment) {
		@container() {
			<div class="my-auto py-24 sm:pt-12 sm:pb-32">
				<div class="text-center">
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-file-unknown mx-auto size-12 text-accent">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 2l.117 .007a1 1 0 0 1 .876 .876l.007 .117v4l.005 .15a2 2 0 0 0 1.838 1.844l.157 .006h4l.117 .007a1 1 0 0 1 .876 .876l.007 .117v9a3 3 0 0 1 -2.824 2.995l-.176 .005h-10a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-14a3 3 0 0 1 2.824 -2.995l.176 -.005zm0 15a1 1 0 0 0 -.993 .883l-.007 .127a1 1 0 0 0 1.993 .117l.007 -.127a1 1 0 0 0 -1 -1m1.136 -5.727a2.5 2.5 0 0 0 -3.037 .604a1 1 0 0 0 1.434 1.389l.088 -.09a.5 .5 0 1 1 .379 .824a1 1 0 0 0 -.002 2a2.5 2.5 0 0 0 1.137 -4.727"></path><path d="M19 7h-4l-.001 -4.001z"></path>
					</svg>
					<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Not Found</h1>
					<p>Sorry, we couldn't find the page you're looking for.</p>
					<div class="mt-6">
						<a href="/home" role="button" class="btn btn-primary">
							Go Back Home
						</a>
						<a href="mailto:support@immanent.tech&subject=Foragd Issue" class="btn btn-primary">
							Email Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				</div>
			</div>
		}
	}
}
