package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

const ErrorFragment templFragmentKey = "error"

templ InternalError(user *models.User, msg *models.UserMessage) {
	@content() {
		@templ.Fragment(ErrorFragment) {
			@container() {
				<div class="text-center">
					@tabler.MoodConfuzed(i.Props{Class: "mx-auto text-accent size-12"})
					@partials.Heading3() {
						Whoops!
					}
					@partials.Paragraph() {
						{ msg.Summary }
					}
					if msg.HasDetails() {
						@partials.Paragraph() {
							{ *msg.Details }
						}
					}
					<div class="mt-6">
						<a href="/home" role="button" class="btn btn-primary">
							Go Back Home
						</a>
						<a href="mailto:support@immanent.tech&subject=Foragd Issue" role="button" class="btn btn-primary">
							Email Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				</div>
			}
		}
	}
}

templ ExternalError(user *models.User, msg *models.UserMessage) {
	@content() {
		@templ.Fragment(ErrorFragment) {
			@container() {
				<div class="text-center">
					@tabler.MoodConfuzed(i.Props{Class: "mx-auto text-accent size-12"})
					@partials.Heading3() {
						Whoops!
					}
					@partials.Paragraph() {
						{ msg.Summary }
					}
					if msg.HasDetails() {
						@partials.Paragraph() {
							{ *msg.Details }
						}
					}
					<div class="mt-6">
						<a href="mailto:support@immanent.tech&subject=Foragd Issue" role="button" class="btn btn-primary">
							Email Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				</div>
			}
		}
	}
}
