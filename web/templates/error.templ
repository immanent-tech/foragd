package templates

import "github.com/immanent-tech/foragd/models"

const ErrorFragment templFragmentKey = "error"

templ InternalError(user *models.User, msg *models.UserMessage) {
	@content() {
		@templ.Fragment(ErrorFragment) {
			@container() {
				@userMessage("Whoops 😿", msg) {
					<div class="mt-10 flex items-center justify-center gap-x-6">
						<a href="/home" role="button" class="btn btn-primary">
							Go Back Home
						</a>
						<a href="mailto:support@immanent.tech&subject=Foragd Issue" role="button" class="btn btn-primary">
							Email Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				}
			}
		}
	}
}

templ ExternalError(user *models.User, msg *models.UserMessage) {
	@content() {
		@templ.Fragment(ErrorFragment) {
			@container() {
				@userMessage("Whoops 😿", msg) {
					<div class="mt-10 flex items-center justify-center gap-x-6">
						<a href="mailto:support@immanent.tech&subject=Foragd Issue" role="button" class="btn btn-primary">
							Email Support <span aria-hidden="true">&rarr;</span>
						</a>
					</div>
				}
			}
		}
	}
}
