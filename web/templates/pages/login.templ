package pages

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/input/fieldset"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/tabler"
)

type Login struct{}

func (page *Login) Template() templ.Component {
	return templates.NewPage("Go Feed Me - Login",
		templates.WithBodyContent(page.layout()),
	)
}

// Base: https://tailwindcss.com/plus/ui-blocks/application-ui/forms/sign-in-forms#component-bc08eb211afa45fad7c9f89c1891f284
templ (page *Login) layout() {
	<div id={ partials.ContentID.String() }>
		<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
			<div class="sm:mx-auto sm:w-full sm:max-w-md">
				@partials.Logo("mx-auto h-10 w-auto")
				<h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight">Sign in to your account</h2>
			</div>
			<div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
				<div class="bg-base-200 px-6 py-12 shadow-sm sm:rounded-lg sm:px-12">
					<div>
						<div class="flex items-center gap-x-6">
							<div class="w-full flex-1 border-t border-gray-200"></div>
							<h3 class="text-xl/6 font-semibold text-nowrap">Continue with</h3>
							<div class="w-full flex-1 border-t border-gray-200"></div>
						</div>
						<div class="mt-6 grid grid-cols-2 gap-4">
							@LoginAuth0Button()
						</div>
					</div>
				</div>
				<p class="mt-10 text-center text-sm/6">
					Don't have an account?&Tab;
					@partials.NewAction("/signup", partials.DisplayActionAsLink,
						partials.ActionClasses("font-semibold hover:text-accent"),
						partials.ActionPushURL(),
						partials.ActionTarget(partials.ContentID.Target()),
					) {
						Sign up now
					}
				</p>
			</div>
		</div>
	</div>
}

templ LoginGoogleButton() {
	<a href="#" class="flex w-full items-center justify-center gap-3 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 focus-visible:inset-ring-transparent">
		<svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
			<path d="M12.0003 4.75C13.7703 4.75 15.3553 5.36002 16.6053 6.54998L20.0303 3.125C17.9502 1.19 15.2353 0 12.0003 0C7.31028 0 3.25527 2.69 1.28027 6.60998L5.27028 9.70498C6.21525 6.86002 8.87028 4.75 12.0003 4.75Z" fill="#EA4335"></path>
			<path d="M23.49 12.275C23.49 11.49 23.415 10.73 23.3 10H12V14.51H18.47C18.18 15.99 17.34 17.25 16.08 18.1L19.945 21.1C22.2 19.01 23.49 15.92 23.49 12.275Z" fill="#4285F4"></path>
			<path d="M5.26498 14.2949C5.02498 13.5699 4.88501 12.7999 4.88501 11.9999C4.88501 11.1999 5.01998 10.4299 5.26498 9.7049L1.275 6.60986C0.46 8.22986 0 10.0599 0 11.9999C0 13.9399 0.46 15.7699 1.28 17.3899L5.26498 14.2949Z" fill="#FBBC05"></path>
			<path d="M12.0004 24.0001C15.2404 24.0001 17.9654 22.935 19.9454 21.095L16.0804 18.095C15.0054 18.82 13.6204 19.245 12.0004 19.245C8.8704 19.245 6.21537 17.135 5.2654 14.29L1.27539 17.385C3.25539 21.31 7.3104 24.0001 12.0004 24.0001Z" fill="#34A853"></path>
		</svg>
		<span class="text-sm/6 font-semibold">Google</span>
	</a>
}

templ LoginGitHubButton() {
	<a href="#" class="flex w-full items-center justify-center gap-3 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 focus-visible:inset-ring-transparent">
		<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 fill-[#24292F]">
			<path d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" fill-rule="evenodd"></path>
		</svg>
		<span class="text-sm/6 font-semibold">GitHub</span>
	</a>
}

templ LoginAuth0Button() {
	@link.Build(
		link.WithClasses("btn", "bg-white", "text-black", "border-[#e5e5e5]"),
		link.WithHref("/login/auth0"),
	) {
		@tabler.BrandAuth0()
		<span class="text-sm/6 font-semibold">Auth0</span>
	}
}

templ LoginSelect() {
	@fieldset.Build(
		fieldset.WithLegend("Choose Provider"),
	) {
		@LoginAuth0Button()
	}
}
