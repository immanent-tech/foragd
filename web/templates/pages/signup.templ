package pages

import (
	"github.com/angelofallars/htmx-go"
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"net/http"
)

type Signup struct {
	Request *models.UserSignupRequest
	Message *models.UserMessage
}

func NewSignup(request *models.UserSignupRequest, msg *models.UserMessage) *Signup {
	signup := &Signup{
		Message: msg,
		Request: &models.UserSignupRequest{},
	}
	if request != nil {
		signup.Request = request
	}
	return signup
}

func (page *Signup) Template(req *http.Request) templ.Component {
	switch {
	case htmx.IsHTMX(req) && !htmx.IsHistoryRestoreRequest(req):
		return page.layout()
	default:
		return templates.NewPage("Go Feed Me - Sign up",
			templates.WithBodyContent(page.layout()),
		)
	}

}

templ (page *Signup) layout() {
	<div id={ partials.ContentID.String() }>
		<div id="signup-hero" class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
			<div class="sm:mx-auto sm:w-full sm:max-w-md mb-4">
				<img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&shade=600" alt="Your Company" class="mx-auto h-10 w-auto"/>
				<h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-base-content">Create an account</h2>
			</div>
			<div class="sm:mx-auto sm:w-full sm:max-w-[480px]">
				<div class="bg-base-200 border-base-content/20 px-6 py-12 shadow-sm sm:rounded-lg sm:px-12">
					@templ.Fragment(templates.ContentFragment) {
						if page.Message != nil {
							switch page.Message.Status {
								case models.UserMessageStatusSuccess:
									<div class="rounded-md bg-success/10 p-4 outline outline-success/20">
										<div class="flex">
											<div class="shrink-0">
												@partials.HeroIconSuccess("size-5", "text-success")
											</div>
											<div class="ml-3 flex-1 md:flex md:justify-between">
												<p class="text-sm text-success">Account created!</p>
												<p class="mt-3 text-sm md:mt-0 md:ml-6">
													<a href="/login" class="text-sm text-success">
														Log In  <span aria-hidden="true">&rarr;</span>
													</a>
												</p>
											</div>
										</div>
									</div>
								case models.UserMessageStatusWarning:
									<div class="rounded-md bg-warning/10 p-4 outline outline-warning/15">
										<div class="flex">
											<div class="shrink-0">
												@partials.HeroIconWarn("size-5", "text-warning")
											</div>
											<div class="ml-3">
												<h3 class="text-sm font-medium text-warning">{ page.Message.Summary }</h3>
												if page.Message.HasDetails() {
													<div class="mt-2 text-sm text-warning/80">
														<p>{ page.Message.Details }</p>
													</div>
												}
											</div>
										</div>
									</div>
								case models.UserMessageStatusError:
									<div class="rounded-md bg-error/10 p-4 outline outline-error/15">
										<div class="flex">
											<div class="shrink-0">
												@partials.HeroIconError("size-5", "text-error")
											</div>
											<div class="ml-3">
												<h3 class="text-sm font-medium text-error">{ page.Message.Summary }</h3>
												if page.Message.HasDetails() {
													<div class="mt-2 text-sm text-error/80">
														<p>{ page.Message.Details }</p>
													</div>
												}
											</div>
										</div>
									</div>
							}
						}
						<form hx-post="/signup" hx-target={ partials.ContentID.Target() } hx-target-error={ partials.ContentID.Target() } class="mt-10 space-y-6">
							<div>
								<label for="nickname" class="app-textinput-label font-medium text-sm/6">Nickname</label>
								<div class="mt-2">
									<input id="nickname" name="nickname" value={ page.Request.Nickname } class="app-textinput sm:text-sm/6"/>
								</div>
							</div>
							<div>
								<label for="email" class="app-textinput-label font-medium text-sm/6">Email address</label>
								<div class="mt-2">
									<input id="email" type="email" name="email" value={ page.Request.Email } required autocomplete="email" class="app-textinput validator sm:text-sm/6"/>
									<span class="validator-hint hidden">Email address is required</span>
								</div>
							</div>
							<div>
								<label for="password" class="app-textinput-label font-medium text-sm/6">Password</label>
								<div class="mt-2">
									<input id="password" type="password" name="password" value={ page.Request.Password } required minlength="10" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{ 8,  }" autocomplete="current-password" class="app-textinput sm:text-sm/6"/>
									<span class="validator-hint hidden">Password needs to be minimum 10 characters and include at least one: lowercase letter, uppercase letter and number</span>
								</div>
							</div>
							<div>
								<button type="submit" class="app-button text-sm/6">Sign in</button>
							</div>
						</form>
					}
				</div>
			</div>
		</div>
	</div>
}
