package pages

import (
	"github.com/immanent-tech/go-feed-me/models"
	"github.com/immanent-tech/go-feed-me/web/templates/layouts"
	"github.com/immanent-tech/go-feed-me/web/templates/partials"
	"slices"
	"time"
)

type SearchResultsPage struct {
	subscriptions []*partials.Subscription
	articles      []*partials.Article
	search        *models.SearchRequest
	favoriteID    models.FavoriteID
}

func NewSearchResultsPage(fav *models.Favorite, search *models.SearchRequest, subscriptions []*partials.Subscription, articles []*partials.Article) *SearchResultsPage {
	page := &SearchResultsPage{
		search:        search,
		subscriptions: subscriptions,
		articles:      articles,
	}
	if fav != nil {
		page.favoriteID = fav.GetID()
	}
	return page
}

templ (page *SearchResultsPage) Content() {
	<nav class="relative flex mt-8 items-center">
		// Show jump links if both subscription and article results are available.
		<div class="flex flex-1">
			if len(page.subscriptions) > 0 && len(page.articles) > 0 {
				<div class="text-sm font-medium px-1 py-2">Jump to:</div>
				<a href="#subscription-results" class="link link-hover rounded-md px-1 py-2 text-sm font-medium hover:bg-accent/5 hover:text-accent-content">Subscriptions</a>
				<a href="#article-results" class="link link-hover rounded-md px-1 py-2 text-sm font-medium hover:bg-accent/5 hover:text-accent-content">Articles</a>
			}
		</div>
		// Show button to toggle favorite status of search.
		<div id="search-request" class="hidden">
			<input type="hidden" name="text" value={ page.search.Text }/>
		</div>
		<div id="favorite-button" class="flex justify-end">
			if page.favoriteID != "" {
				@RemoveFavoriteSearchButton(page.favoriteID)
			} else {
				@AddFavoriteSearchButton()
			}
		</div>
	</nav>
	<ul role="list">
		// Subscription results.
		if len(page.subscriptions) > 0 {
			<div class="flex items-center mt-8">
				<div class="relative flex justify-start">
					<span class="pr-3 text-base font-semibold text-base-content">Subscriptions</span>
				</div>
				<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
			</div>
			<ul id="subscription-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-3">
				for subscription := range slices.Values(page.subscriptions) {
					@showSearchResult(subscription)
				}
			</ul>
		}
		// Article results.
		if len(page.articles) > 0 {
			<div class="flex items-center mt-8">
				<div class="relative flex justify-start">
					<span class="pr-3 text-base font-semibold text-base-content">Articles</span>
				</div>
				<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
			</div>
			<ul id="article-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				for article := range slices.Values(page.articles) {
					@showSearchResult(article)
				}
			</ul>
		}
	</ul>
	<button class="btn btn-neutral fixed right-0 bottom-0 m-4" hidden _="on intersect remove @hidden from me" href="#">Back to top</button>
}

templ AddFavoriteSearchButton() {
	<button
		class="btn btn-primary btn-square"
		hx-put="/user/favorite/search"
		hx-target="#favorite-button"
		hx-include="#search-request"
	>
		@partials.HeroIconHeart("size-4")
	</button>
}

templ RemoveFavoriteSearchButton(id models.FavoriteID) {
	<button
		class="btn btn-primary btn-square"
		hx-delete="/user/favorite/search"
		hx-target="#favorite-button"
		hx-include="#search-request"
	>
		@partials.HeroIconHeartFilled("size-4")
	</button>
}

type searchResult interface {
	GetImage() *models.RemoteImage
	GetTitle() string
	GetUpdatedDate() time.Time
	GetDescription() string
	ViewLink(classes ...string) templ.Component
}

templ showSearchResult(result searchResult) {
	<li>
		<div class="flex gap-x-4 py-5">
			// Show article image or placeholder thumbnail.
			if result.GetImage().URL != "" {
				<div class="avatar">
					<div class="rounded-box size-12">
						<img
							src={ result.GetImage().URL }
							if result.GetImage().Title != "" {
								alt={ result.GetImage().Title }
							}
						/>
					</div>
				</div>
			} else {
				<div class="avatar avatar-placeholder">
					<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
						<span class="text-3xl capitalize">{ result.GetTitle()[0:1] }</span>
					</div>
				</div>
			}
			<div class="flex-auto">
				// Show article title.
				<div class="flex items-baseline justify-between gap-x-4">
					@result.ViewLink() {
						<p class="text-sm/6 font-semibold text-pretty line-clamp-2">{ result.GetTitle() }</p>
					}
					<p class="flex-none text-xs text-base-content/80">
						@partials.ShowTimestamp(result.GetUpdatedDate())
					</p>
				</div>
			</div>
		</div>
		// Show article description (if exists).
		if result.GetDescription() != "" {
			<div class="flex">
				<article class="mt-1 prose prose-sm prose-img:hidden prose-figure:hidden dark:prose-invert line-clamp-2">
					@templ.Raw(result.GetDescription())
				</article>
			</div>
		}
	</li>
}

// SimilarArticles renders a page of articles that are the result of a search for similar articles to a given input set.
templ SimilarArticles(articles models.Articles) {
	if len(articles) > 0 {
		<ul role="list">
			<div class="flex items-center">
				<div class="relative flex justify-start">
					<span class="pr-3 text-base font-semibold text-base-content">Similar Articles</span>
				</div>
				<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
			</div>
			<ul id="article-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				for article := range slices.Values(articles) {
					@showSearchResult(partials.NewArticleContent(article))
				}
			</ul>
		</ul>
		<button class="btn btn-neutral fixed right-0 bottom-0 m-4" hidden _="on intersect remove @hidden from me" href="#">Back to top</button>
	} else {
		@layouts.EmptyContent()
	}
}

// NoSearchResults renders an informational message for when no search results were returned.
templ NoSearchResults() {
	<div class="text-center">
		<h1 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-4xl">Nothing found 😕</h1>
		<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Looks like there are no matches for that search.</p>
		<div class="mt-10 flex items-center justify-center gap-x-6">
			<a href="/home" role="button" class="btn btn-primary">Go to home</a>
		</div>
	</div>
}
