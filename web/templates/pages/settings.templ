package pages

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates/partials"
)

type Settings struct {
	CurrentPage     string
	user            *models.User
	editUserRequest *models.EditUserRequest
}

func NewSettingsPage(page string, user *models.User, editUser *models.EditUserRequest) *Settings {
	return &Settings{
		CurrentPage:     page,
		user:            user,
		editUserRequest: editUser,
	}
}

templ (page *Settings) Content() {
	<div class="mt-8">
		<div class="tabs tabs-lift">
			<input id="subscriptions-tab" type="radio" name="settings" class="tab" aria-label="Subscriptions" checked="true"/>
			<div class="tab-content bg-base-100 border-base-300 p-6">
				@SubscriptionSettings()
			</div>
			<input id="app-tab" type="radio" name="settings" class="tab" aria-label="App"/>
			<div class="tab-content bg-base-100 border-base-300 p-6">
				@AppSettings()
			</div>
			<input id="billing-tab" type="radio" name="settings" class="tab" aria-label="Billing"/>
			<div class="tab-content bg-base-100 border-base-300 p-6">Tab content 3</div>
		</div>
	</div>
}

// SubscriptionSettings shows settings for managing user subscriptions.
templ SubscriptionSettings() {
	<div class="flex flex-col mt-2 gap-y-4">
		<div class="pb-12">
			<div class="flex flex-row gap-x-4">
				<button
					type="button"
					class="btn btn-primary btn-sm"
					hx-get="/user/subscription/add"
					hx-target={ partials.ContentID.Target() }
					hx-push-url="true"
				>Add</button>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					hx-get="/user/import"
					hx-target={ partials.ContentID.Target() }
					hx-push-url="true"
				>Import</button>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					hx-get="/user/export"
					hx-target={ partials.ContentID.Target() }
					hx-push-url="true"
				>Export</button>
			</div>
		</div>
		<div>
			<form
				hx-post="/user/settings/subscriptions"
				hx-trigger="input changed delay:500ms, keyup[key=='Enter'], load"
				hx-target="#subscriptions-list"
				hx-indicator=".htmx-indicator"
				hx-push-url="false"
			>
				<div class="grid grid-cols-1">
					<input id="filter-subscriptions" type="text" name="text" placeholder="Filter..." class="input input-primary input-xs"/>
					<span class="htmx-indicator loading loading-spinner loading-sm"></span>
				</div>
			</form>
		</div>
	</div>
	//
	// class="divide-y divide-base-content/5 max-w-prose"
	<ul id="subscriptions-list" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"></ul>
}

templ ShowSubscriptionSettings(subscription *models.Subscription) {
	@partials.NewSubscriptionContent(subscription).Settings()
}

// AppSettings shows settings for the application.
templ AppSettings() {
	<div class="divide-y divide-base-content/5">
		<div class="grid max-w-7xl grid-cols-1 gap-x-8 gap-y-10 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
			<div class="col-span-full">
				<h2 class="text-sm/7 font-semibold">Theme</h2>
			</div>
			@themePreview("light")
			@themePreview("dark")
			@themePreview("synthwave")
			@themePreview("lofi")
			@themePreview("black")
			@themePreview("dracula")
			@themePreview("business")
			@themePreview("night")
			@themePreview("dim")
			@themePreview("nord")
		</div>
	</div>
}

templ themePreview(theme string) {
	<div
		class="border-base-content/20 hover:border-base-content/40 overflow-hidden rounded-lg border outline-2 outline-offset-2 outline-transparent"
		data-act-class="outline-base-content!"
		data-set-theme={ theme }
		_="on click set #page-theme.value to @data-set-theme"
		hx-trigger="click"
		hx-put={ "/user/settings/theme/" + theme }
		hx-swap="none"
	>
		<div class="bg-base-100 text-base-content w-full cursor-pointer font-sans" data-theme={ theme }>
			<div class="grid grid-cols-5 grid-rows-3">
				<div class="bg-base-200 col-start-1 row-span-2 row-start-1"></div>
				<div class="bg-base-300 col-start-1 row-start-3"></div>
				<div class="bg-base-100 col-span-4 col-start-2 row-span-3 row-start-1 flex flex-col gap-1 p-2">
					<div class="font-bold capitalize">{ theme }</div>
					<div class="flex flex-wrap gap-1">
						<div class="bg-primary flex aspect-square w-5 items-center justify-center rounded lg:w-6">
							<div class="text-primary-content text-sm font-bold">A</div>
						</div>
						<div class="bg-secondary flex aspect-square w-5 items-center justify-center rounded lg:w-6">
							<div class="text-secondary-content text-sm font-bold">A</div>
						</div>
						<div class="bg-accent flex aspect-square w-5 items-center justify-center rounded lg:w-6">
							<div class="text-accent-content text-sm font-bold">A</div>
						</div>
						<div class="bg-neutral flex aspect-square w-5 items-center justify-center rounded lg:w-6">
							<div class="text-neutral-content text-sm font-bold">A</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
