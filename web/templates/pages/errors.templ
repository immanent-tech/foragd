package pages

import "github.com/immanent-tech/go-feed-me/web/templates"
import "github.com/immanent-tech/go-feed-me/models"

templ NotFound() {
	<main class="grid min-h-full place-items-center bg-base-100 px-6 py-24 sm:py-32 lg:px-8">
		<div class="text-center">
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Page not found</h1>
			<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Sorry, we couldn’t find the page you’re looking for.</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				<a href="/home" role="button" class="btn btn-primary">Go back home</a>
				<a href="#" class="text-sm font-semibold">Contact support <span aria-hidden="true">&rarr;</span></a>
			</div>
		</div>
	</main>
}

templ Error(msg *models.UserMessage) {
	@templates.Page("Go Feed Me - Error", nil) {
		<main class="grid min-h-full place-items-center bg-base-100 px-6 py-24 sm:py-32 lg:px-8">
			<div class="text-center">
				<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Whoops</h1>
				<h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-5xl">{ msg.Summary }</h2>
				if msg.HasDetails() {
					<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">{ msg.Details }</p>
				}
				<div class="mt-10 flex items-center justify-center gap-x-6">
					<a href="/home" role="button" class="btn btn-primary">Go back home</a>
					<a href="#" class="text-sm font-semibold">Contact support <span aria-hidden="true">&rarr;</span></a>
				</div>
			</div>
		</main>
	}
}
