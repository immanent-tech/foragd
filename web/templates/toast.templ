package templates

import (
	tabler "github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/web/templates/element"
)

// UpdatesToast renders a toast notification to inform the user that updated content is available.
templ UpdatesToast(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		id="updates-toast"
		role="alert"
		class="z-99 alert alert-outline alert-soft alert-info"
	>
		<span>New updates available.</span>
		<div>
			<button
				class="btn btn-square btn-soft btn-sm btn-info"
				{ props.Attributes()... }
				_="on click scroll to the top of the body smoothly"
			>
				<span class="sr-only">Refresh</span>
				@tabler.Refresh(templ.Attributes{"class": "hide-loading size-4 text-info", "aria-hidden": "true"})
				@tabler.Refresh(templ.Attributes{"class": "show-loading size-4 text-info animate-spin", "aria-hidden": "true"})
			</button>
			<button class="btn btn-square btn-soft btn-sm btn-info" _="on click remove #updates-toast">
				<span class="sr-only">Close</span>
				@tabler.X(templ.Attributes{"class": "size-4 text-info", "aria-hidden": "true"})
			</button>
		</div>
	</div>
}
