package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"slices"
)

templ PostsIndex(posts *models.DocsDirectory) {
	@header(nil)
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 bg-base-100 h-full">
		<div class="mx-auto max-w-2xl lg:mx-0">
			<h2 class="ui-h2">Posts</h2>
			<p class="ui-p">Posts from the Foragd team.</p>
		</div>
		<div class="mx-auto mt-10 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 border-t border-neutral pt-10 sm:mt-16 sm:pt-16 lg:mx-0 lg:max-w-none lg:grid-cols-3">
			for post := range slices.Values(posts.Docs) {
				<article class="flex max-w-xl flex-col items-start justify-between">
					<div class="flex items-center gap-x-4 text-xs">
						<time datetime={ post.GetTimestamp() } class="label">{ post.GetTimestamp() }</time>
					</div>
					<div class="group relative grow">
						<h3 class="ui-h3 mt-3 text-lg/6 font-semibold ">
							<a href={ "/posts/" + post.Path } class="link link-hover">
								<span class="absolute inset-0"></span>
								{ post.Title }
							</a>
						</h3>
						<p class="mt-5 line-clamp-3 text-sm/6">{ post.Description }</p>
					</div>
					// <div class="relative mt-8 flex items-center gap-x-4 justify-self-end">
					// 	<img src="https://images.unsplash.com/photo-1519244703995-f4e0f30006d5?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80" alt="" class="size-10 rounded-full bg-gray-50 dark:bg-gray-800"/>
					// 	<div class="text-sm/6">
					// 		<p class="font-semibold text-gray-900 dark:text-white">
					// 			<a href="#">
					// 				<span class="absolute inset-0"></span>
					// 				Michael Foster
					// 			</a>
					// 		</p>
					// 		<p class="text-gray-600 dark:text-gray-400">Co-Founder / CTO</p>
					// 	</div>
					// </div>
				</article>
			}
		</div>
		@partials.ButtonBackToTop()
	</div>
	@footer()
}
