package templates

import (
	"encoding/json"
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/pkg/formats/text"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"time"
)

templ PostsIndex(posts []*models.MarkdownFile) {
	@LayoutExternal() {
		@container(element.WithClasses("pt-4")) {
			@pageHeading() {
				@pageTitle("The Foragd Blog. RSS Feed Reader Guides, Tips and Comparisons")
			}
			<p class="mt-2 text-base">
				The Foragd blog covers RSS and Atom feed readers, guides to finding and managing feeds, comparisons
				with other feed readers, and practical strategies for taking back control of your reading in an era
				of algorithmic content. Whether you're new to RSS or switching from Feedly or Inoreader, you'll find
				guides and opinions here to help you get the most out of independent web reading.
			</p>
			@masonryGrid()
			{{ postsJSONLD := make([]map[string]any, 0, len(posts)) }}
			@grid(element.WithClasses("masonry-grid", "relative", "my-12"),
				element.WithAttribute("_", "install MasonryGrid")) {
				// <div
				// 	id="grid-objects"
				// 	_="install MasonryGrid"
				// 	class="relative masonry-grid grid grid-cols-1 gap-4 sm:grid-cols-2 p-2 mt-12"
				// >
				for idx, post := range posts {
					// Create a post JSON-LD document.
					{{
						postJSONLD := map[string]any{
							"@type":         "BlogPosting",
							"headline":      post.Frontmatter.Title,
							"url":           config.GetBaseURL() + "/blog/" + post.Details.Path,
							"datePublished": post.Frontmatter.GetCreatedDate(),
							"author": map[string]any{
								"@type": "Person",
								"name":  "Joshua Rich",
							},
						}
						postsJSONLD = append(postsJSONLD, postJSONLD)
					}}
					@partials.Card(element.WithAttribute("style", "--i: "+strconv.Itoa(idx)),
						element.WithClasses(
							"group", "animate-fadeinup", "self-start", "cursor-pointer", "touch-manipulation", "masonry-item", "w-full", "sm:w-400", "mx-auto"),
						element.WithHXMethod(http.MethodGet, "/blog/"+post.Details.Path),
						element.WithHXTarget(ContentID.Target()),
						element.WithHXSwap("innerHTML show:window:top transition:true"),
						element.WithHXTrigger("click"),
						element.WithHXPushURL(true),
						element.WithAttribute("hx-disinherit", "*"),
					) {
						<div>
							if post.Frontmatter.Image != nil {
								<figure>
									<img
										src={ *post.Frontmatter.Image }
										alt={ post.Frontmatter.Title }
										if idx == 0 {
											fetchpriority="high"
										} else {
											loading="lazy"
										}
										width="400"
										height="300"
									/>
								</figure>
							}
						</div>
						{{
							var bodyClasses string
							if post.Frontmatter.Image != nil {
								bodyClasses = "flex-1"
							}
						}}
						@partials.CardBody(element.WithClasses(bodyClasses)) {
							<h2 class="card-title tracking-tight text-balance">{ post.Frontmatter.Title }</h2>
							if post.Frontmatter.Author != nil {
								<span class="text-sm text-neutral">{ *post.Frontmatter.Author }</span>
							}
							<p class="mt-4">{ post.Frontmatter.Description }</p>
							<div class="card-actions justify-end">
								<time datetime={ post.Frontmatter.GetCreatedDate() } class="label">{ post.Frontmatter.GetCreatedDate() }</time>
							</div>
						}
					}
				}
				// </div>
			}
			// Add all the posts JSON-LD documents to the index document.
			{{
				blogURL, _ := url.JoinPath(config.GetBaseURL(), "blog")
				// Create an index JSON-LD document.
				indexJSONLD := map[string]any{
					"@context":    "https://schema.org",
					"@type":       "Blog",
					"name":        "The Foragd Blog. RSS Feed Reader Guides, Tips and Comparisons",
					"description": "Guides, comparisons and tips on RSS feed readers, finding feeds, managing information overload, and taking back control of your reading from social media algorithms.",
					"url":         blogURL,
					"publisher": map[string]any{
						"@type": "Organization",
						"name":  "Foragd",
						"url":   config.GetBaseURL(),
					},
				}
				indexJSONLD["blogPost"] = postsJSONLD
			}}
			if jsonLD, err := json.Marshal(indexJSONLD); err == nil {
				{{ data := new(json.RawMessage(jsonLD)) }}
				@partials.RenderJSONLD("posts-index", *data)
			}
		}
		@buttonBackToTop()
	}
}

// Post renders a post.
//
// See also: https://developers.google.com/search/docs/appearance/structured-data/article#microdata
templ Post(post *models.MarkdownFile) {
	@LayoutExternal() {
		@narrowContainer() {
			<div class="breadcrumbs text-sm">
				<ul>
					<li><a href="/blog">Blog</a></li>
					<li><span>{ post.Frontmatter.Title }</span></li>
				</ul>
			</div>
			<article itemscope itemtype="https://schema.org/NewsArticle" class="mx-auto my-4 prose sm:prose-lg prose-img:shadow-md">
				// Show a subtle reading progress bar across the top of the article.
				@partials.ReadingProgress()
				<div class="flex flex-1 flex-separated items-center justify-self-end text-sm/6 text-neutral">
					<time
						datetime={ post.Frontmatter.GetCreatedDate() }
						itemprop="datePublished"
					>
						Created: { post.Frontmatter.GetCreatedDate() }
					</time>
					if post.Frontmatter.UpdatedAt != nil {
						<time
							datetime={ *post.Frontmatter.UpdatedAt }
							itemprop="dateModified"
						>
							Updated: { *post.Frontmatter.UpdatedAt }
						</time>
					}
				</div>
				<h1
					class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl"
					itemprop="headline"
				>
					{ post.Frontmatter.Title }
				</h1>
				<p class="font-semibold">{ post.Frontmatter.Description }</p>
				<div class="mb-4 flex items-center justify-between border-t border-b border-neutral/20 p-1">
					// Author.
					if post.Frontmatter.Author != nil {
						<strong
							itemprop="author"
							itemscope
							itemtype="https://schema.org/Person"
							class="label text-sm"
						>
							<span itemprop="name">{ *post.Frontmatter.Author }</span>
						</strong>
					}
					// Actions.
					<div class="flex shrink-0 items-center">
						<span class="text-sm/6">
							Reading time:
							{ strings.ReplaceAll(text.ReadingTime(string(post.Content)).Round(time.Minute).String(),"0s","") }
						</span>
					</div>
				</div>
				@templ.Raw(string(post.Content))
			</article>
			@buttonBackToTop()
		}
	}
}
