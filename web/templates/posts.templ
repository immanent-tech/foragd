package templates

import (
	"encoding/json"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/immanent-tech/go-base/config"
	"github.com/immanent-tech/go-base/pkg/markdownx"
	"github.com/immanent-tech/go-base/pkg/textx"
	"net/url"
	"strconv"
	"strings"
	"time"
)

templ PostsIndex(posts []*markdownx.File) {
	@LayoutExternal() {
		@container(element.WithClasses("pt-4")) {
			@buttonBackToTop()
			@pageHeading() {
				@pageTitle("The Foragd Blog. RSS Feed Reader Guides, Tips and Comparisons")
			}
			<p class="mt-2 font-serif font-medium text-base">
				The Foragd blog covers RSS and Atom feed readers, guides to finding and managing feeds, comparisons
				with other feed readers, and practical strategies for taking back control of your reading in an era
				of algorithmic content. Whether you're new to RSS or switching from Feedly or Inoreader, you'll find
				guides and opinions here to help you get the most out of independent web reading.
			</p>
			@masonryGrid()
			{{ postsJSONLD := make([]map[string]any, 0, len(posts)) }}
			@grid(element.WithClasses("masonry-grid", "relative", "my-12"),
				element.WithAttribute("_", "install MasonryGrid")) {
				for idx, post := range posts {
					// Create a post JSON-LD document.
					{{
						postJSONLD := map[string]any{
							"@type":         "BlogPosting",
							"headline":      post.Frontmatter.Title,
							"url":           config.GetBaseURL() + "/blog/" + post.Frontmatter.Slug,
							"datePublished": post.Frontmatter.GetCreatedDate(),
							"author": map[string]any{
								"@type": "Person",
								"name":  "Joshua Rich",
							},
						}
						postsJSONLD = append(postsJSONLD, postJSONLD)
					}}
					@partials.Card(element.WithAttribute("style", "--i: "+strconv.Itoa(idx)),
						element.WithClasses(
							"group", "animate-fadeinup", "animation-delay-[calc(min(var(--i),15)*80ms)]", "self-start", "cursor-pointer", "masonry-item", "touch-manipulation", "w-full", "sm:w-400", "mx-auto"),
					) {
						<a href={ "/blog/" + post.Frontmatter.Slug }>
							<div>
								if post.Frontmatter.Image != nil {
									<figure class="relative overflow-hidden rounded-t-[inherit]">
										<img
											src={ *post.Frontmatter.Image }
											alt={ post.Frontmatter.Title }
											if idx == 0 {
												fetchpriority="high"
											} else {
												loading="lazy"
											}
											width="400"
											height="300"
											class="w-full aspect-4/3 object-cover transition-transform duration-400 ease-in-out group-hover:scale-[1.04]"
										/>
									</figure>
								}
							</div>
							{{
								var bodyClasses string
								if post.Frontmatter.Image != nil {
									bodyClasses = "flex-1"
								}
							}}
							@partials.CardBody(element.WithClasses(bodyClasses)) {
								<h2 class="card-title tracking-tight text-balance">{ post.Frontmatter.Title }</h2>
								if post.Frontmatter.Author != nil {
									<span class="text-sm text-neutral">{ *post.Frontmatter.Author }</span>
								}
								<p class="mt-4 prose-summary">{ post.Frontmatter.Description }</p>
							}
							@partials.CardFooter() {
								<div class="card-actions justify-end">
									{{ var ts time.Time }}
									{{ var tsPrefix string }}
									if !post.Frontmatter.GetUpdatedDate().IsZero() {
										{{ ts = post.Frontmatter.GetUpdatedDate() }}
										{{ tsPrefix = "Updated" }}
									} else {
										{{ ts = post.Frontmatter.GetCreatedDate() }}
										{{ tsPrefix = "Created" }}
									}
									<span class="text-xs/4 text-neutral capitalize tabular-nums">
										{ tsPrefix }
										<relative-time
											datetime={ ts.Format(time.DateOnly) }
											format="relative"
											class="shrink-0"
										>
											{ ts.Format("Jan _2, 2006") }
										</relative-time>
									</span>
								</div>
							}
						</a>
					}
				}
			}
			// Add all the posts JSON-LD documents to the index document.
			{{
				blogURL, _ := url.JoinPath(config.GetBaseURL(), "blog")
				// Create an index JSON-LD document.
				indexJSONLD := map[string]any{
					"@context":    "https://schema.org",
					"@type":       "Blog",
					"name":        "The Foragd Blog. RSS Feed Reader Guides, Tips and Comparisons",
					"description": "Guides, comparisons and tips on RSS feed readers, finding feeds, managing information overload, and taking back control of your reading from social media algorithms.",
					"url":         blogURL,
					"publisher": map[string]any{
						"@type": "Organization",
						"name":  "Foragd",
						"url":   config.GetBaseURL(),
					},
				}
				indexJSONLD["blogPost"] = postsJSONLD
			}}
			if jsonLD, err := json.Marshal(indexJSONLD); err == nil {
				{{ data := new(json.RawMessage(jsonLD)) }}
				@partials.RenderJSONLD("posts-index", *data)
			}
		}
	}
}

// Post renders a post.
//
// See also: https://developers.google.com/search/docs/appearance/structured-data/article#microdata
templ Post(post *markdownx.File) {
	@LayoutExternal() {
		// Show a subtle reading progress bar across the top of the article.
		<div
			id="progress-bar"
			class="fixed top-0 left-0 h-1 w-0 bg-accent z-9999 transition-[width] duration-50 ease-linear"
			_="on scroll from the window debounced at 20ms
          set my.style.width to
            ((document.documentElement.scrollTop /
             (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100) + '%'
        end

        on load
          trigger scroll on the window
        end"
		></div>
		@buttonBackToTop()
		@narrowContainer() {
			// <div class="breadcrumbs text-sm">
			// 	<ul>
			// 		<li><a href="/blog">Blog</a></li>
			// 		<li><span>{ post.Frontmatter.Title }</span></li>
			// 	</ul>
			// </div>
			<article itemscope itemtype="https://schema.org/NewsArticle" class="mx-auto my-4 prose sm:prose-lg prose-img:shadow-md">
				<div class="flex flex-1 flex-separated items-center justify-self-end">
					<span class="text-xs/4 text-neutral capitalize tabular-nums">
						Created
						<relative-time
							datetime={ post.Frontmatter.GetCreatedDate().Format(time.DateOnly) }
							format="datetime"
							class="shrink-0"
						>
							{ post.Frontmatter.GetCreatedDate().Format("Jan _2, 2006") }
						</relative-time>
					</span>
					if !post.Frontmatter.GetUpdatedDate().IsZero() {
						<span class="text-xs/4 text-neutral capitalize tabular-nums">
							Updated
							<relative-time
								datetime={ post.Frontmatter.GetUpdatedDate().Format(time.DateOnly) }
								format="datetime"
								class="shrink-0"
							>
								{ post.Frontmatter.GetUpdatedDate().Format("Jan _2, 2006") }
							</relative-time>
						</span>
					}
				</div>
				<article class="prose-article px-2">
					<h1
						class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl"
						itemprop="headline"
					>
						{ post.Frontmatter.Title }
					</h1>
					<p class="font-medium font-serif">{ post.Frontmatter.Description }</p>
					<div class="mb-4 flex font-sans items-center justify-between border-t border-b border-neutral/20 p-1">
						// Author.
						if post.Frontmatter.Author != nil {
							<strong
								itemprop="author"
								itemscope
								itemtype="https://schema.org/Person"
								class="label text-sm"
							>
								<span itemprop="name">{ *post.Frontmatter.Author }</span>
							</strong>
						}
						// Actions.
						<div class="flex shrink-0 items-center">
							<span class="text-sm/6">
								Reading time:
								{ strings.ReplaceAll(textx.ReadingTime(string(post.Content)).Round(time.Minute).String(),"0s","") }
							</span>
						</div>
					</div>
					@templ.Raw(string(post.Content))
				</article>
			</article>
		}
	}
}
