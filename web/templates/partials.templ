package templates

import (
	"context"
	"fmt"
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strings"
	"time"
)

// NotFound renders a layout appropriate to use for a 404 response.
templ NotFound() {
	<main class="grid min-h-full place-items-center bg-base-100 px-6 py-24 sm:py-32 lg:px-8">
		<div class="text-center">
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Page not found</h1>
			<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Sorry, we couldn't find the page you're looking for.</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				<a href="/home" role="button" class="btn btn-primary">Go back home</a>
				<a href="#" class="text-sm font-semibold">Contact support <span aria-hidden="true">&rarr;</span></a>
			</div>
		</div>
	</main>
}

// EmptyContent renders a layout appropriate for use when there is nothing to show.
templ EmptyContent(backLink string, vals map[string]string) {
	<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			@tabler.FileUnknown(i.Props{Class: "mx-auto size-12 text-base-content"})
			<h3 class="mt-2 text-base font-semibold">Nothing to show</h3>
			<p class="mt-1 text-sm text-base-content">Try adjusting your filters/search, or maybe you are all caught up?</p>
			<btn
				class="btn btn-ghost mt-1 text-sm text-base-content"
				hx-get={ backLink }
				hx-target={ ContentID.Target() }
				hx-push-url="true"
				if vals != nil {
					hx-vals={ models.GenerateHXVals(vals) }
				}
			>Go back</btn>
		</div>
	</main>
}

templ Content(content templ.Component) {
	@ContentSideBar(nil)
	<div class="lg:pl-36">
		@Header()
		<div id={ ContentID.String() } hx-indicator="#content-loading">
			@templ.Fragment(FragmentContent) {
				@content
			}
		</div>
	</div>
	@ContentDock(nil)
}

templ ContentSideBar(attributes templ.Attributes) {
	<div id="page-sidebar" class="hidden bg-base-200 lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-36 lg:flex-col" { attributes... }>
		<div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-base-content/10 px-6 pb-4">
			<div class="flex flex-col h-16 shrink-0 gap-4 mt-8 items-center text-accent">
				@Logo("logo-drawer size-16")
				Foragd
			</div>
			// Remove any subscription filter from the saved filters in the session and use these filters for links in the drawer.
			<nav aria-label="Sidebar" class="flex flex-1 flex-col items-center">
				<ul role="list" class="flex flex-1 flex-col gap-y-7">
					<li>
						<a
							href="/home"
							class="group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"
						>
							<span class="sr-only">Go to home page</span>
							@tabler.Home(i.Props{Class: "size-6 shrink-0 text-current"})
							Home
						</a>
					</li>
					<li>
						@NewLink(
							WithHXMethod(http.MethodGet, "/list/subscriptions"),
							WithHXTarget(ContentID.Target()),
							WithHXPushURL(),
							WithHXVals(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()),
							WithClasses("group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
						) {
							<span class="sr-only">Show all unread subscriptions</span>
							@tabler.Rss(i.Props{Class: "size-6 shrink-0 text-current"})
							Subscriptions
						}
					</li>
					<li>
						@NewLink(
							WithHXMethod(http.MethodGet, "/list/articles"),
							WithHXTarget(ContentID.Target()),
							WithHXPushURL(),
							WithHXVals(models.PageFiltersFromCtx(ctx, "/list/articles").Values()),
							WithClasses("group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
						) {
							<span class="sr-only">Show all unread articles</span>
							@tabler.FileRss(i.Props{Class: "size-6 shrink-0 text-current"})
							Articles
						}
					</li>
					<li>
						@NewLink(
							WithHXMethod(http.MethodGet, "/list/favorites"),
							WithHXTarget(ContentID.Target()),
							WithHXPushURL(),
							WithClasses("group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
						) {
							<span class="sr-only">Show favorites</span>
							@tabler.HeartFilled(i.Props{Class: "size-6 shrink-0 text-current"})
							Favorites
						}
					</li>
				</ul>
			</nav>
		</div>
	</div>
}

templ ContentDock(attributes templ.Attributes) {
	<div id="page-dock" class="dock bg-base-200 lg:hidden" { attributes... }>
		<button
			hx-get="/home"
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/home" {
				class="dock-active"
			}
		>
			@tabler.HomeFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Home</span>
		</button>
		<button
			hx-get="/list/subscriptions"
			hx-target={ ContentID.Target() }
			hx-vals={ models.GenerateHXVals(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()) }
			hx-params={ "not " + models.ParamSubscriptions }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/list/subscriptions" {
				class="dock-active"
			}
		>
			@tabler.Rss(i.Props{Class: "size-6"})
			<span class="dock-label">Subscriptions</span>
		</button>
		<button
			hx-get="/list/articles"
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/list/articles" {
				class="dock-active"
			}
			if strings.HasPrefix(models.PathFromCtx(ctx), "/view/article") {
				hx-include="[name='subscriptions']"
			}
		>
			@tabler.FileRssFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Articles</span>
		</button>
		<button
			hx-get="/list/favorites"
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/list/favorites" {
				class="dock-active"
			}
		>
			@tabler.HeartFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Favorites</span>
		</button>
	</div>
}

// ContentLoadingPlaceholder renders a (hidden by default) element that is shown when a (HTMX) request is loading.
templ ContentLoadingPlaceholder() {
	<div id="content-loading" class="htmx-indicator">
		<div class="text-center">
			<span class="loading loading-bars loading-xl"></span>
			<h3 class="mt-2 text-base font-semibold">Loading content...</h3>
		</div>
	</div>
}

templ Header() {
	<div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-base-content/10 bg-base-200 px-4 sm:gap-x-6 sm:px-6 lg:px-8">
		<div class="flex flex-1 items-center gap-x-4 lg:gap-x-6">
			@GlobalSearch()
			<div class="flex flex-1 items-center justify-end">
				// <button type="button" class="-m-2.5 p-2.5 btn btn-ghost btn-square hover:text-primary">
				// 	<span class="sr-only">View notifications</span>
				// 	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
				// 		<path d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" stroke-linecap="round" stroke-linejoin="round"></path>
				// 	</svg>
				// </button>
				<div aria-hidden="true" class="hidden lg:block lg:h-6 lg:w-px lg:bg-base-content/10"></div>
				{{ user, _ := models.UserFromCtx(ctx) }}
				if user != nil {
					<el-dropdown id="header-user-menu" class="relative">
						<button id="header-menu-button" class="btn btn-ghost btn-square hover:text-primary">
							<span class="sr-only">Open user menu</span>
							<img src={ user.GetAvatar() } alt={ user.GetNickname() } class="size-8 rounded-full outline -outline-offset-1 outline-base-content/10"/>
						</button>
						<el-menu id="header-menu" anchor="bottom end" popover class="context-menu-base">
							// Open settings menu.
							<a
								class="context-menu-item-base"
								hx-get="/user/settings"
								hx-target={ ContentID.Target() }
								hx-push-url="true"
								_="on click remove @open from #header-menu"
							>
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.SettingsFilled(i.Props{Class: "size-4"})
									Settings
								</div>
							</a>
							// Report issue.
							<a
								hx-get={ "/issue" }
								hx-target={ ContentID.Target() }
								class="link link-hover context-menu-item-base"
							>
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.FlagFilled(i.Props{Class: "size-4"})
									Report an issue
								</div>
							</a>
							// Logout
							<a href="/logout" class="context-menu-item-base">
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.Logout(i.Props{Class: "size-4"})
									Log out
								</div>
							</a>
						</el-menu>
					</el-dropdown>
				}
			</div>
		</div>
	</div>
}

// PaginationControl generates an element that will cause a pagination request when scrolled into view.
templ PaginationControl(ctx context.Context, route string, pagination models.Pagination) {
	<div
		class="isolate"
		hx-post={ route }
		hx-include="#content-filters,[name='csrf_token']"
		hx-vals={ fmt.Sprintf("{%q:%q}", models.ParamPagination, pagination) }
		hx-trigger="intersect once"
		hx-target="#grid-objects"
		hx-swap="beforeend"
		hx-indicator="#content-loading"
		preload
		_="on htmx:afterRequest remove me"
	></div>
}

// ShowTimestamp will display the given timestamp as a relative/human-friendly timestamp that will update as time
// passes.
templ ShowTimestamp(timestamp time.Time) {
	<human-time datetime={ timestamp.Format("2006-01-02T15:04:05-0700") }>{ timestamp.Format("2006-01-02 15:04:05 -0700") }</human-time>
}

// PageHeader renders the given title in a style appropriate for the page header.
templ PageHeader(title string) {
	<div class="md:flex md:items-center md:justify-between">
		<div class="min-w-0 flex-1">
			<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight">{ title }</h2>
		</div>
		<div class="mt-4 flex md:mt-0 md:ml-4">
			{ children... }
			// <button type="button" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20">Edit</button>
			// <button type="button" class="ml-3 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-400">Publish</button>
		</div>
	</div>
}

// PageDescription renders the given description in a style appropriate to use as a description on the page.
templ PageDescription(description string) {
	<p class="mt-2 max-w-4xl text-sm text-base-content/80">
		if description != "" {
			{ description }
		}
		{ children... }
	</p>
}

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button popovertarget={ id } type="button" class="btn btn-circle btn-ghost btn-xs text-info">
		<span class="sr-only">Search filters help</span>
		@tabler.InfoCircle(i.Props{Class: "size-6 text-info"})
	</button>
	<el-popover popover id={ id } anchor={ anchor } class="[--anchor-gap:4px] rounded-box">
		{ children... }
	</el-popover>
}

templ ContextMenu(name string) {
	// Actions menu.
	<el-dropdown class="relative ml-auto">
		<button class="btn btn-sm btn-ghost btn-square">
			<span class="sr-only">{ name }</span>
			@tabler.DotsVertical(i.Props{Class: "size-5"})
		</button>
		<el-menu
			anchor="bottom end"
			popover
			class="context-menu-base"
		>
			{ children... }
		</el-menu>
	</el-dropdown>
}

// GenerateAvatar will render an image appropriate to use as an "avatar" for the object.
templ GenerateAvatar(obj models.Object) {
	// Generate a thumbnail to display next to the title.
	if img := obj.GetImage(); img != nil {
		// If the source has an image, use that as the avatar.
		<div class="avatar">
			<div class="rounded-box size-12">
				<img
					src={ img.GetURL() }
					if img.GetTitle() != "" {
						alt={ img.GetTitle() }
					}
				/>
			</div>
		</div>
	} else {
		// Otherwise, take the first letter of the title and create a placeholder avatar.
		<div class="avatar avatar-placeholder">
			<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
				<span class="text-3xl capitalize">{ obj.GetTitle()[0:1] }</span>
			</div>
		</div>
	}
}

// ViewObjectLink will render a link for viewing an object.
templ ViewObjectLink(obj models.Object, include string, vals map[string]string, classes ...string) {
	<a
		hx-get={ obj.ViewURL() }
		if include != "" {
			hx-include={ include }
		}
		if vals != nil {
			hx-vals={ models.GenerateHXVals(vals) }
		}
		hx-target={ ContentID.Target() }
		hx-push-url="true"
		hx-swap="innerHTML show:top"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// FavoriteObjectLink will render a link for toggling the favorite status of the object.
templ FavoriteObjectLink(obj models.Object, classes ...string) {
	<a
		if obj.IsFavorite() {
			hx-post={ "/user/favorite/remove/" + string(obj.Type()) + "/" + obj.GetID() }
		} else {
			hx-post={ "/user/favorite/add/" + string(obj.Type()) + "/" + obj.GetID() }
		}
		hx-target={ "#favorite_" + obj.GetID() }
		hx-include="[name='csrf_token']"
		class={ "link link-hover", classes }
	>
		switch obj.IsFavorite() {
			case true:
				@tabler.HeartFilled(i.Props{Class: "size-4"})
				Remove Favorite
			case false:
				@tabler.Heart(i.Props{Class: "size-4"})
				Add Favorite
		}
	</a>
}

// ToggleFavorite renders an updated favorite link based on the object's favorite status.
templ ToggleFavorite(obj models.Object) {
	@FavoriteObjectLink(obj, "context-menu-item-base")
}

// MarkObjectLink will render a link for toggling the mark status of the object.
templ MarkObjectLink(obj models.Object, target, swap string, classes ...string) {
	<a
		hx-post={ obj.MarkURL() }
		hx-include="[name='csrf_token']"
		hx-target={ target }
		hx-swap={ swap }
		class={ "link link-hover", classes }
	>
		switch obj.IsUnread() {
			case true:
				@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
				Mark Read
			case false:
				@tabler.MailFilled(i.Props{Class: "size-4"})
				Mark Unread
		}
	</a>
}

templ CategoryManagement(path string, suggested []models.Category, existing []models.Category) {
	<div>
		<form
			id="add-categories"
			hx-post={ path }
			hx-on::after-request="if(event.detail.successful) this.reset()"
			hx-include="[name='csrf_token'],[name='user_categories']"
			hx-push-url="false"
			hx-target="#current-categories"
			hx-swap="beforeend"
			hx-trigger="submit"
		>
			<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
				<div>
					<label for="category" class="block text-sm/6 font-medium">Add category</label>
					<p id="category-hint" class="mt-3 text-sm/6 text-base-content/60">Optional. Add a category to the subscription.</p>
				</div>
				<div class="mt-2 sm:col-span-2 sm:mt-0">
					<div class="join">
						<el-autocomplete class="join-item">
							<label class="flex input input-primary bg-base-content/10">
								<input
									id="add-category"
									type="text"
									name="category"
									placeholder="Cool Stuff"
								/>
								<button
									if len(suggested) == 0 {
										hidden
									}
								>
									@tabler.ChevronDown(i.Props{Class: "size-4 text-primary"})
								</button>
							</label>
							<el-options popover anchor="bottom start">
								<div class="grid grid-cols-1 bg-base-content/10 p-4 text-sm/6 outline-1 -outline-offset-1 outline-neutral focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent sm:text-sm/6 capitalize">
									for category := range slices.Values(suggested) {
										<el-option value={ category }>{ category }</el-option>
									}
								</div>
							</el-options>
						</el-autocomplete>
						<button class="btn btn-primary join-item">
							@tabler.Plus(i.Props{Class: "size-4"})
						</button>
					</div>
				</div>
			</div>
		</form>
		// Show current categories.
		<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
			<label class="label block text-sm/6 font-medium sm:pt-1.5">Current Categories</label>
			<div class="mt-2 sm:col-span-2 sm:mt-0">
				<ul id="current-categories" class="-my-3 divide-y divide-base-content/10 px-6 py-4 text-sm/6">
					for category := range slices.Values(existing) {
						@AddCategory(path, category)
					}
				</ul>
			</div>
		</div>
	</div>
}

// AddCategory renders a new category item to the list of categories of a subscription.
templ AddCategory(path string, category models.Category) {
	{{ csrf_token := models.CSRFTokenFromCtx(ctx) }}
	<li class="flex flex-row items-center py-4 gap-x-4 group-hover:text-accent">
		<input type="hidden" name="user_categories" value={ category }/>
		{ category }
		<button
			hx-delete={ path }
			hx-push-url="false"
			hx-target="closest li"
			hx-swap="delete"
			hx-headers={ `{"X-CSRF-Token": "` + csrf_token + `"}` }
			class="btn btn-square btn-ghost"
		>
			@tabler.X(i.Props{Class: "size-4"})
		</button>
	</li>
}

// FavoritesList renders the given favorites in a list, grouped by type.
templ FavoritesList(favorites models.FavoritesSlice, swap models.HTMXFlag) {
	{{ subscriptions := favorites.FilterByType(models.FavoriteTypeSubscription) }}
	{{ articles := favorites.FilterByType(models.FavoriteTypeArticle) }}
	{{ searches := favorites.FilterByType(models.FavoriteTypeSearch) }}
	// Show a message if user doesn't have any favorites.
	if len(favorites) == 0 {
		<div class="text-center">
			<p class="text-sm/6 text-base-content/80 font-semibold mt-4">No favorites!</p>
			<p class="text-sm/6 text-base-content/80 text-pretty">Favorite a subscription, article or search...</p>
		</div>
	}
	<ul
		id="favorites-list"
		class="-mx-2 mt-2 space-y-1"
		if swap {
			hx-swap-oob="true"
		}
	>
		if len(subscriptions) > 0 {
			// Show favorite subscriptions.
			for fav := range slices.Values(subscriptions) {
				<li>
					{{ values := models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values() }}
					{{ values[models.ParamSubscriptions] = fav.GetID() }}
					<a
						hx-get="/articles"
						hx-target={ ContentID.Target() }
						hx-vals={ models.GenerateHXVals(values) }
						hx-push-url="true"
						_="on click toggle @open on #mobile-sidebar-dialog"
						class="group link link-hover hover:text-accent flex gap-x-3 rounded-md p-2"
					>
						<div class="flex items-center gap-x-2">
							@tabler.Rss(i.Props{Class: "size-4"})
							<p class="text-sm/6 line-clamp-3 text-ellipsis text-pretty">
								{ fav.Nickname }
							</p>
						</div>
					</a>
				</li>
			}
		}
		if len(articles) > 0 {
			// Show favorite articles.
			for fav := range slices.Values(articles) {
				<li>
					{{ article, err := fav.ObjectData.AsFavoriteArticle() }}
					if err == nil {
						<a
							hx-get={ "/subscription/" + article.SubscriptionID + "/article/" + fav.GetID() }
							hx-target={ ContentID.Target() }
							hx-push-url="true"
							_="on click toggle @open on #mobile-sidebar-dialog"
							class="group link link-hover hover:text-accent flex gap-x-3 rounded-md p-2"
						>
							<div class="flex items-center gap-x-2">
								@tabler.FileRss(i.Props{Class: "size-4"})
								<p class="text-sm/6 line-clamp-3 text-ellipsis text-pretty">
									{ fav.Nickname }
								</p>
							</div>
						</a>
					}
				</li>
			}
		}
		if len(searches) > 0 {
			// Show favorite searches.
			for fav := range slices.Values(searches) {
				<li>
					{{ search, err := fav.ObjectData.AsFavoriteSearch() }}
					if err == nil {
						<a
							hx-get="/search"
							hx-target={ ContentID.Target() }
							hx-vals={ search.HXVals() }
							hx-push-url="true"
							_="on click toggle @open on #mobile-sidebar-dialog"
							class="group link link-hover hover:text-accent flex gap-x-3 rounded-md p-2"
						>
							<div class="flex items-center gap-x-2">
								@tabler.Search(i.Props{Class: "size-4"})
								<p class="text-sm/6 line-clamp-3 text-ellipsis text-pretty">
									{ fav.Nickname }
								</p>
							</div>
						</a>
					}
				</li>
			}
		}
	</ul>
}

// Modal will render a modal with the given content.
templ Modal(id string) {
	{{ modalID := id + "-modal" }}
	<el-dialog id={ modalID }>
		<dialog id={ id } aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor={ id }
							_={ "on click remove " + modalID }
							class="rounded-md text-base-content hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-hidden"
						>
							<span class="sr-only">Close</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					{ children... }
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

// UnsubscribeModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ UnsubscribeModal(obj models.Object) {
	{{ id := "unsubscribe" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { obj.GetTitle() }?</p>
				</div>
			</div>
		</div>
		<div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
			<button
				type="button"
				hx-post={ "/remove/" + string(obj.Type()) + "/" + obj.GetID() }
				hx-target={ "#" + obj.GetID() }
				hx-swap="outerHTML"
				_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
				hx-include="[name='csrf_token']"
				class="inline-flex w-full justify-center rounded-md bg-error/80 px-3 py-2 text-sm font-semibold text-error-content shadow-xs hover:bg-error sm:ml-3 sm:w-auto"
			>Unsubscribe</button>
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="mt-3 inline-flex w-full justify-center rounded-md bg-primary/80 px-3 py-2 text-sm font-semibold text-primary-content shadow-xs ring-1 ring-base-content/10 ring-inset hover:bg-primary sm:mt-0 sm:w-auto"
			>Cancel</button>
		</div>
	}
}
