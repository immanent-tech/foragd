package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"time"
)

// NotFound renders a layout appropriate to use for a 404 response.
templ NotFound() {
	@Main() {
		<div class="text-center">
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Page not found</h1>
			<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Sorry, we couldn't find the page you're looking for.</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "/home"),
					WithClasses("btn", "btn-primary", "btn-soft"),
				) {
					Go Back Home
				}
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "mailto:support@immanent.tech&subject=Foragd Issue"),
					WithClasses("btn", "btn-ghost"),
				) {
					Email Support <span aria-hidden="true">&rarr;</span>
				}
			</div>
		</div>
	}
}

templ ErrorPage(msg *models.UserMessage) {
	@Main() {
		<div class="text-center">
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Whoops 😿</h1>
			<h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-5xl">{ msg.Summary }</h2>
			if msg.HasDetails() {
				<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">{ msg.Details }</p>
			}
			<div class="mt-10 flex items-center justify-center gap-x-6">
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "/home"),
					WithClasses("btn", "btn-primary", "btn-soft"),
				) {
					Go Back Home
				}
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "mailto:support@immanent.tech&subject=Foragd Issue"),
					WithClasses("btn", "btn-ghost"),
				) {
					Email Support <span aria-hidden="true">&rarr;</span>
				}
			</div>
		</div>
	}
}

// EmptyContent renders a layout appropriate for use when there is nothing to show.
templ EmptyContent() {
	@Main() {
		<div class="text-center">
			@tabler.FileUnknown(i.Props{Class: "mx-auto size-16 text-base-content"})
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance">Nothing to show</h1>
			<h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance">Try adjusting your filters, or maybe you are all caught up?</h2>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "/home"),
					WithClasses("btn", "btn-primary", "btn-soft"),
				) {
					Go Back Home
				}
				@NewLink(
					WithCustomAttribute("role", "button"),
					WithCustomAttribute("href", "mailto:support@immanent.tech&subject=Foragd Issue"),
					WithClasses("btn", "btn-ghost"),
				) {
					Email Support <span aria-hidden="true">&rarr;</span>
				}
			</div>
		</div>
	}
}

templ Content(content templ.Component) {
	@header()
	@SideBar(nil)
	<div class="lg:pl-36">
		<div id={ ContentID.String() } hx-indicator="#content-loading">
			// @templ.Fragment(FragmentContent) {
			@content
			// }
		</div>
		<div id="content-loading" class="htmx-indicator">
			<div class="text-center">
				<span class="loading loading-bars loading-xl"></span>
				<h3 class="mt-2 text-base font-semibold">Loading content...</h3>
			</div>
		</div>
	</div>
	@Dock(nil)
}

// ShowTimestamp will display the given timestamp as a relative/human-friendly timestamp that will update as time
// passes.
templ ShowTimestamp(timestamp time.Time) {
	<human-time datetime={ timestamp.Format("2006-01-02T15:04:05-0700") }>{ timestamp.Format("2006-01-02 15:04:05 -0700") }</human-time>
}

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button id={ id + "-button" } popovertarget={ id } type="button" class="btn btn-circle btn-ghost btn-xs text-info">
		@tabler.InfoCircle(i.Props{Class: "size-6 text-info"})
	</button>
	<el-popover popover id={ id } anchor={ anchor } class="[--anchor-gap:4px] rounded-box">
		{ children... }
	</el-popover>
}

templ CategoryManagement(path, inputName string, suggested []models.Category, existing []models.Category) {
	<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
		<div>
			<h2 class="text-base/7 font-semibold">Add Categories</h2>
			<p class="mt-1 text-sm/6 text-base-content/60">Optional. Add additional categories to the subscription.</p>
		</div>
		// Add categories.
		<div class="grid sm:max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
			// Add from suggested categories.
			if len(suggested) > 0 {
				<div class="sm:col-span-4 mt-2">
					<form
						id="add-categories"
						hx-post={ path }
						hx-on::after-request="if(event.detail.successful) this.reset()"
						hx-include="[name='csrf_token'],[name='categories']"
						hx-push-url="false"
						hx-target="#current-categories"
						hx-swap="beforeend"
						hx-trigger="change"
					>
						<select class="select select-primary bg-base-content/10" name="category">
							<option disabled selected>Suggested Categories</option>
							for category := range slices.Values(suggested) {
								<option class="text-sm/6 capitalize" value={ category }>{ category }</option>
							}
						</select>
					</form>
				</div>
			}
			// Add custom categories.
			<div class="sm:col-span-6 mt-2">
				<form
					id="add-categories"
					hx-post={ path }
					hx-on::after-request="if(event.detail.successful) this.reset()"
					hx-include="[name='csrf_token'],[name='categories']"
					hx-vals={ models.GenerateHXVals(map[string]any{"inputName": inputName}) }
					hx-push-url="false"
					hx-target="#current-categories"
					hx-swap="beforeend"
				>
					<div class="join">
						<label class="input input-primary bg-base-content/10 join-item">
							<input type="text" placeholder="Custom Category" name="category"/>
						</label>
						<button type="submit" class="btn btn-primary btn-soft join-item">
							@tabler.Plus()
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
	// Manage categories.
	<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
		<div>
			<h2 class="text-base/7 font-semibold">Manage Existing Categories</h2>
			<p class="mt-1 text-sm/6 text-base-content/60">Existing categories. Click the X to remove them from the subscription.</p>
		</div>
		<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
			<div class="sm:col-span-4">
				<div class="flex gap-2 p-2 m-2">
					<div id="current-categories" class="flex flex-row flex-wrap p-2 gap-2">
						for category := range slices.Values(existing) {
							@AddCategory(path, inputName, category)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

// AddCategory renders a new category item to the list of categories of a subscription.
templ AddCategory(path, inputName string, category models.Category) {
	{{ csrf_token := models.CSRFTokenFromCtx(ctx) }}
	<button
		hx-delete={ path }
		hx-push-url="false"
		hx-target="closest button"
		hx-swap="delete"
		hx-headers={ `{"X-CSRF-Token": "` + csrf_token + `"}` }
	>
		<input type="hidden" name={ inputName } value={ category }/>
		<div class="flex gap-2 text-sm capitalize">
			<div
				class="badge badge-soft badge-primary"
			>
				{ category }
				@tabler.X(i.Props{Class: "size-4"})
			</div>
		</div>
	</button>
}

// Modal will render a modal with the given content.
templ Modal(id string) {
	{{ modalID := id + "-modal" }}
	<el-dialog id={ modalID }>
		<dialog id={ id } aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor={ id }
							_={ "on click remove " + modalID }
							class="rounded-md text-base-content hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-hidden"
						>
							<span class="sr-only">Close</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					{ children... }
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ DeleteAccountModal() {
	{{ id := "delete-account" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Delete Account Confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to delete your account. Once done, it cannot be recovered.</p>
				</div>
			</div>
		</div>
		<div class="mt-5 sm:mt-4 sm:flex sm:justify-end gap-x-2">
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="btn btn-ghost"
			>Cancel</button>
			<button
				type="button"
				hx-post="/user/delete"
				hx-swap="none"
				_="on htmx:afterRequest(successful) if successful remove #delete-account-modal"
				hx-include="[name='csrf_token']"
				class="btn btn-error"
			>Yes</button>
		</div>
	}
}

templ generateFilters(filters *models.ListDisplayFilters) {
	<div id="content-filters" class="hidden">
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for category := range slices.Values(filters.GetCategories()) {
			<input type="hidden" name={ models.ParamCategories } value={ category }/>
		}
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
	</div>
}
