// emptyContent renders a layout appropriate for use when there is nothing to show.
templ emptyContent() {
	<div class="text-center">
		@tabler.RosetteDiscountCheckFilled(i.Props{Class: "mx-auto text-success size-12"})
		<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight">All caught up!</h2>
	</div>
}

// showTimestamp will display the given timestamp as a relative/human-friendly timestamp that will update as time
// passes.
templ showTimestamp(timestamp time.Time) {
	<human-time datetime={ timestamp.Format("2006-01-02T15:04:05-0700") }>{ timestamp.Format("2006-01-02 15:04:05 -0700") }</human-time>
}

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button id={ id + "-button" } popovertarget={ id } type="button" class="btn btn-circle btn-ghost btn-xs text-info">
		@tabler.InfoCircle(i.Props{Class: "size-6 text-info"})
	</button>
	<el-popover popover id={ id } anchor={ anchor } class="[--anchor-gap:4px] rounded-box">
		{ children... }
	</el-popover>
}

// Modal will render a modal with the given content.
templ Modal(id string) {
	{{ modalID := id + "-modal" }}
	<el-dialog id={ modalID }>
		<dialog id={ id } aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor={ id }
							_={ "on click remove " + modalID }
							class="rounded-md hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-hidden"
						>
							<span class="sr-only">Close</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					{ children... }
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ generateFilters(filters *models.ListFilters) {
	<div id="content-filters" class="hidden">
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for category := range slices.Values(filters.GetCategories()) {
			<input type="hidden" name={ models.ParamCategories } value={ category }/>
		}
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
	</div>
}
