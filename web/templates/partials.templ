	@container() {
		<div class="text-center">
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Whoops 😿</h1>
			<h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-5xl">{ msg.Summary }</h2>
			if msg.HasDetails() {
				<p class="mt-6 text-lg font-medium text-pretty sm:text-xl/8">{ msg.Details }</p>
			}
			<div class="mt-10 flex items-center justify-center gap-x-6">
				@NewLink(
					WithAttribute("role", "button"),
					WithAttribute("href", "/home"),
					WithClasses("btn", "btn-primary"),
				) {
					Go Back Home
