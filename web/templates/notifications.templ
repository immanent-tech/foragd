package templates

import (
	"github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/models"
	"slices"
	"time"
)

// DefaultNotificationTimeout is the default duration which a notification is shown (unless overridden on a per
// notification basis).
const DefaultNotificationTimeout = 5 * time.Second

// NotificationsID points to an element that can be used for displaying notifications to the user.
var NotificationsID = models.ElementID("notifications")

type notificationOpts struct {
	timeout time.Duration
}

type notificationOption func(*notificationOpts)

func WithNotificationTimeout(duration time.Duration) notificationOption {
	return func(no *notificationOpts) {
		if duration > 0 {
			no.timeout = duration
		}
	}
}

// Notification renders a notification (or alert) in the UI. The notification will be coloured appropriately for the
// status/severity of the UserMessage.
templ Notification(msg *models.UserMessage, options ...notificationOption) {
	{{
		opts := &notificationOpts{
			timeout: DefaultNotificationTimeout,
		}
		for option := range slices.Values(options) {
			option(opts)
		}
	}}
	<div hx-swap-oob={ "beforeend:" + NotificationsID.Target() }>
		<div
			role="alert"
			class={ "transition-transform duration-800 ease-in-out pointer-events-auto w-full max-w-sm alert", templ.KV("alert-info",msg.IsInfo()), templ.KV("alert-success",msg.IsSuccess()), templ.KV("alert-warning",msg.IsWarning()), templ.KV("alert-error",msg.IsError()) }
			if opts.timeout != 0 {
				_={ "on load wait for " + opts.timeout.String() + " then remove me" }
			} else {
				_={ "on load wait for " + DefaultNotificationTimeout.String() + " then remove me" }
			}
		>
			switch msg.Status {
				case models.UserMessageStatusSuccess:
					@tableroutline.CircleCheck(templ.Attributes{"class": "size-6 text-success-content", "aria-hidden": "true"})
				case models.UserMessageStatusError:
					@tableroutline.ExclamationCircle(templ.Attributes{"class": "size-6 text-error-content", "aria-hidden": "true"})
				case models.UserMessageStatusWarning:
					@tableroutline.AlertTriangle(templ.Attributes{"class": "size-6 text-warning-content", "aria-hidden": "true"})
				default:
					@tableroutline.InfoCircle(templ.Attributes{"class": "size-6 text-info-content", "aria-hidden": "true"})
			}
			<div>
				<h3 class={ "text-sm font-medium", templ.KV("info-content",msg.IsInfo()), templ.KV("success-content",msg.IsSuccess()), templ.KV("warning-content",msg.IsWarning()), templ.KV("error-content",msg.IsError()) }>
					{ msg.Summary }
				</h3>
				if msg.HasDetails() {
					<div class={ "mt-2 text-sm", templ.KV("info-content",msg.IsInfo()), templ.KV("success-content",msg.IsSuccess()), templ.KV("warning-content",msg.IsWarning()), templ.KV("error-content",msg.IsError()) }>
						{ *msg.Details }
					</div>
				}
			</div>
			<button
				type="button"
				class="btn btn-square btn-outline btn-sm"
				_="on click settle then remove the closest parent <div/>"
			>
				<span class="sr-only">Close</span>
				@tableroutline.X(templ.Attributes{"class": "size-5", "aria-hidden": "true"})
			</button>
		</div>
	</div>
}
