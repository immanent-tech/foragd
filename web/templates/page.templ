package templates

import "github.com/immanent-tech/foragd/web/templates/element"
import "github.com/dimmerz92/go-icons/tabler-outline"

// pageHeading renders a section appropriate for displaying a page title and actions.
templ pageHeading(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		id="page-heading"
		class={ "flex md:flex-row md:items-center md:justify-between", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// pageTitle renders a page title and any additional/supporting content.
templ pageTitle(title string) {
	<div id="page-title" class="min-w-0 flex-1 self-center sm:self-start">
		<h1 class="font-display text-2xl font-bold tracking-tight text-balance sm:text-3xl">{ title }</h1>
		{ children... }
	</div>
}

// pageActions renders page action content. Placement will be on the right of the title on desktop screens, or under the
// title on mobile screens.
templ pageActions(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		id="page-actions"
		class={ "flex flex-col sm:flex-row justify-end sm:justify-start items-center", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// sectionHeading renders a section appropriate for displaying a section title and actions.
templ sectionHeading(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		class={ "border-b border-neutral/15 pb-2 sm:flex sm:items-center sm:justify-between", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// sectionTitle renders a section title and any additional/supporting content.
templ sectionTitle(title string) {
	<div class="min-w-0 flex-1">
		<h2 class="font-display text-lg font-semibold">{ title }</h2>
		{ children... }
	</div>
}

// sectionActions renders section action content. Placement will be on the right of the title on desktop screens, or under the
// title on mobile screens.
templ sectionActions() {
	<div class="mt-3 flex sm:mt-0 sm:ml-4">
		{ children... }
	</div>
}

// buttonBackToTop adds a "back to top" button that is only shown when the user has scrolled down the page.
templ buttonBackToTop() {
	<div
		id="scroll-sentinel"
		style="height:1px;"
		_="
		on intersection(intersecting)
			if intersecting
				send scrollSentinelVisible
			else
				send scrollSentinelHidden
			end
		end
		"
	></div>
	<button
		class="btn pointer-events-none fixed right-5 bottom-20 z-50 btn-circle translate-y-4 opacity-0 transition-[opacity,transform] duration-200 ease-out btn-secondary hover:animate-bounce sm:right-10 lg:bottom-10"
		_="
  		on scrollSentinelHidden from #scroll-sentinel
  		  remove .opacity-0 .translate-y-4 .pointer-events-none from me
  		end
  		on scrollSentinelVisible from #scroll-sentinel
  		  add .opacity-0 .translate-y-4 .pointer-events-none to me
  		end
  		on click scroll to top of #content smoothly
  		"
	>
		<span class="sr-only">Back to top</span>
		@tableroutline.ArrowUp(templ.Attributes{"class": "text-secondary-content", "aria-hidden": "true"})
	</button>
}

templ pullToRefreshScript() {
	<script type="text/hyperscript">
  behavior PullToRefresh(threshold)
    init
      set my.startY to 0
      set my.pulling to false
      set my.refreshing to false
      set my.content to the first <.ptr-content/> in me
      set my.canPtr to false
    end

    on ptrSentinelVisible from #ptr-sentinel
      set my.canPtr to true
    end

    on ptrSentinelHidden from #ptr-sentinel
      set my.canPtr to false
    end

    on touchstart
      -- only start tracking a pull if the container is already at the top
      if my.canPtr and not my.refreshing
        set my.startY to event.touches[0].clientY
        set my.pulling to true
      end
    end

    on touchmove
      if my.pulling and not my.refreshing
        set dy to event.touches[0].clientY - my.startY
        if dy > 0
          -- we're pulling down on an already-topped-out list: take over the gesture
          halt the event
          set drag to Math.min(dy * 0.45, threshold * 1.6)
          set my.content's *transform to `translateY(${drag}px)`
          if drag >= threshold
            add .armed to me
          else
            remove .armed from me
          end
        end
      end
    end

    on touchend or touchcancel
      if my.pulling and not my.refreshing
        set my.pulling to false
        if I match .armed
          set my.refreshing to true
          remove .armed from me
          add .refreshing to me
          set my.content's *transform to `translateY(${threshold}px)`
          trigger refresh on the first <[hx-trigger~="refresh"]/> in me
          -- safety net in case the request never resolves / no htmx target
          wait for refreshComplete or 6s
          remove .refreshing from me
          set my.content's *transform to `translateY(0px)`
          set my.refreshing to false
        else
          set my.content's *transform to `translateY(0px)`
        end
      end
    end

    -- also support desktop testing with a mouse-drag simulation
    on mousedown
      if my.canPtr <= 0 and not my.refreshing
        set my.startY to event.clientY
        set my.pulling to true
        set my.mouseSim to true
      end
    end
    on mousemove from the document
      if my.pulling and my.mouseSim and not my.refreshing
        set dy to event.clientY - my.startY
        if dy > 0
          set drag to Math.min(dy * 0.45, threshold * 1.6)
          set my.content's *transform to `translateY(${drag}px)`
          if drag >= threshold then add .armed to me else remove .armed from me end
        end
      end
    end
    on mouseup from the document
      if my.pulling and my.mouseSim and not my.refreshing
        set my.pulling to false
        set my.mouseSim to false
        if I match .armed
          set my.refreshing to true
          remove .armed from me
          add .refreshing to me
          set my.content's *transform to `translateY(${threshold}px)`
          trigger refresh on the first <[hx-trigger~="refresh"]/> in me
          wait for refreshComplete or 6s
          remove .refreshing from me
          set my.content's *transform to `translateY(0px)`
          set my.refreshing to false
        else
          set my.content's *transform to `translateY(0px)`
        end
      end
    end

  end
</script>
}
