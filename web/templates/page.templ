package templates

import (
	"context"
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/models"
)

const (
	pageTitleCtxKey contextKey = "page_title"
)

// DefaultPageTitle is the default <title> tag value if none is set.
var DefaultPageTitle = config.AppName + ": " + config.AppDescription

func PageTitleToCtx(ctx context.Context, title string) context.Context {
	return context.WithValue(ctx, pageTitleCtxKey, GeneratePageTitle(title))
}

func PageTitleFromCtx(ctx context.Context) string {
	title, ok := ctx.Value(pageTitleCtxKey).(string)
	if !ok {
		return DefaultPageTitle
	}
	return title
}

// GeneratePageTitle generates an appropriate page title string by combining the input with the app name.
func GeneratePageTitle(title string) string {
	return title + " | " + config.AppName
}

// UpdateCSRFToken renders an input with the csrf token taken from the context.
templ UpdateCSRFToken() {
	<input id="csrf_token" hx-swap-oob="true" hx-swap="outerHTML" type="hidden" name="csrf_token" value={ models.CSRFTokenFromCtx(ctx) }/>
}

// Page renders a full HTML page with the given body content and title.
templ Page(body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		@Head()
		if body != nil {
			@Body(body)
		} else {
			@Body(nil) {
				{ children... }
			}
		}
	</html>
}

// Head renders the `<head>` html element. If the title is blank, a default title is used.
templ Head() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="description" content="Foragd is a cloud-based content viewer for syndicated formats like RSS and Atom."/>
		// https://developer.mozilla.org/en-US/docs/Web/HTML/Guides/Viewport_meta_element#interactive-widget
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual"/>
		<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
		<meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width"/>
		<meta property="og:title" content={ PageTitleFromCtx(ctx) }/>
		<meta property="og:url" content="https://foragd.app"/>
		<meta
			property="og:description"
			content="A beautiful, web based, online feed reader. Keep your RSS, Atom and other syndication sources in one place. Stay up to date with news, blogs and other online sources, across your mobile, tablet, desktop and laptop."
		/>
		<meta property="og:image" content="https://foragd.app/content/logo-color.webp"/>
		<link rel="canonical" href="https://foragd.app"/>
		<link rel="manifest" href="/content/manifest.json"/>
		<link rel="apple-touch-icon" href="/content/apple-touch-icon.png"/>
		<link rel="icon" href="/content/favicon.svg" type="image/svg+xml"/>
		<link rel="icon" href="/content/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)"/>
		<link rel="icon" href="/content/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"/>
		<link rel="shortcut icon" href="/content/favicon.ico" type="image/x-icon"/>
		<link href={ "/content/fonts/inter/inter.css?v=" + config.Version } rel="stylesheet"/>
		// if config.Environment == "production" {
		<script defer src="https://cloud.umami.is/script.js" data-website-id="24250832-ccab-4bbc-bef9-6ba418e0ea51" crossorigin="anonymous"></script>
		// }
		<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module" crossorigin="anonymous"></script>
		<script src={ "/content/scripts.js?v=" + config.Version }></script>
		<link href={ "/content/styles.css?v=" + config.Version } rel="stylesheet"/>
		// Site-wide htmx config.
		<meta
			name="htmx-config"
			content='{
				"selfRequestsOnly":true,
				"allowNestedOobSwaps":true,
				"responseHandling":[
            		{"code":"204", "swap": false},
            		{"code":"[23]..", "swap": true},
            		{"code":"422", "swap": true},
            		{"code":"[45]..", "swap": true, "error":true},
            		{"code":"...", "swap": false}
        		]
			}'
		/>
		@PageTitle()
	</head>
}

// Body renders the `<body>` element. Body content can be passed directly or the children templ syntax can be used.
templ Body(content templ.Component) {
	<body
		class="h-full"
		hx-ext="response-targets,preload,sse"
		_="on every htmx:beforeSend in <button:not(.no-disable)/> tell it toggle [@disabled='true'] until htmx:afterOnLoad"
		hx-target-404={ ContentID.Target() }
	>
		<input id="page-theme" type="checkbox" value={ models.GetUserTheme(ctx) } class="toggle theme-controller hidden" checked="checked"/>
		<input id="csrf_token" type="hidden" name="csrf_token" value={ models.CSRFTokenFromCtx(ctx) }/>
		<div id={ ModalContainerID.String() } hx-target-error="#modal-errors"></div>
		if content != nil {
			@content
		}
		{ children... }
		//  px-4 py-6 sm:p-6
		<div aria-live="assertive" class="pointer-events-none fixed inset-0 flex items-end sm:items-start z-999">
			<div id={ NotificationsID.String() } class="flex w-full flex-col items-center space-y-4 m-4 sm:items-end"></div>
		</div>
		// @ShowTailwindBreakpoints()
	</body>
}

templ PageTitle() {
	<title>{ PageTitleFromCtx(ctx) }</title>
}
