package templates

import (
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
	"strings"
)

// DefaultKeywords are the default keywords to insert in a "keywords" <meta> tag.
var DefaultKeywords = []string{"feeds", "atom", "jsonfeed", "rss", "feed reader", "news", "current affairs"}

// DefaultPageTitle is the default <title> tag value if none is set.
const DefaultPageTitle = "Go Feed Me"

// Page represents a single HTML page.
type Page struct {
	Head Head
	Body *Body
}

// PageOption is a functional option to apply to a page.
type PageOption func(*Page)

// WithDescription option sets the page description.
func WithDescription(description string) PageOption {
	return func(p *Page) {
		p.Head.AddMetaTag("description", description)
	}
}

// WithKeywords option sets the page keywords.
func WithKeywords(keywords ...string) PageOption {
	return func(p *Page) {
		p.Head.AddMetaTag("keywords", strings.Join(keywords, ","))
	}
}

// NewPage creates a new page with the given title and options.
func NewPage(title string, body *Body, options ...PageOption) *Page {
	page := &Page{}
	page.Head.Title = title

	// Set the page body if specified.
	if body != nil {
		page.Body = body
	}

	for option := range slices.Values(options) {
		option(page)
	}

	return page
}

// Show renders the page as a templ Component.
templ (page *Page) Show() {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme=""
		_="
		init
			fetch /settings/theme then
				put the result into @data-theme
		on setTheme(theme)
			log 'theme changed to ' + theme
			set @data-theme to theme
		end
		on htmx:historyRestore
			log 'back to ' + detail.path
		end
		"
	>
		@page.Head.Show()
		<body
			hx-ext="morph,sse,response-targets"
			hx-target-error={ partials.NotificationsID.String() }
		>
			<div id={ partials.ModalContainerID.String() }></div>
			<div id={ partials.NotificationsID.String() } class="fixed top-0 right-0 left-0 mt-4 p-2 z-50"></div>
			if page.Body != nil {
				@page.Body.Show()
			} else {
				{ children... }
			}
		</body>
	</html>
}
