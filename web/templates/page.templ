package templates

import (
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
)

const (
	FragmentContent FragmentKey = "content"
)

type FragmentKey string

// DefaultPageTitle is the default <title> tag value if none is set.
var DefaultPageTitle = config.AppName + ": " + config.AppDescription

// GeneratePageTitle generates an appropriate page title string by combining the input with the app name.
func GeneratePageTitle(title string) string {
	return title + " " + config.AppName
}

// SetPageTitle sets (or updates) the page's <title></title> tag. If the title is an empty string, a default title will
// be set instead.
templ SetPageTitle(title string) {
	if title != "" {
		<title>{ title }</title>
	} else {
		<title>{ DefaultPageTitle }</title>
	}
}

templ UpdateCSRFToken() {
	<input id="csrf_token" hx-swap-oob="true" hx-swap="outerHTML" type="hidden" name="csrf_token" value={ models.CSRFTokenFromCtx(ctx) }/>
}

// Page renders a full HTML page with the given body content and title.
templ Page(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			// https://developer.mozilla.org/en-US/docs/Web/HTML/Guides/Viewport_meta_element#interactive-widget
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
			<link rel="manifest" href="/web/content/manifest.json"/>
			<link rel="apple-touch-icon" href="/web/content/apple-touch-icon.png"/>
			<link rel="icon" href="/web/content/favicon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/web/content/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)"/>
			<link rel="icon" href="/web/content/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"/>
			<link rel="shortcut icon" href="/web/content/favicon.ico" type="image/x-icon"/>
			<link href="/web/content/fonts/inter/inter.css" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
			<script src="/web/content/scripts.js"></script>
			<link href="/web/content/styles.css" rel="stylesheet"/>
			// Site-wide htmx config.
			<meta
				name="htmx-config"
				content='{
				"selfRequestsOnly":true,
				"allowNestedOobSwaps":true,
				"historyRestoreAsHxRequest":false,
				"historyCacheSize":0,
				"responseHandling":[
            		{"code":"204", "swap": false},
            		{"code":"[23]..", "swap": true},
            		{"code":"422", "swap": true},
            		{"code":"500", "swap": true},
            		{"code":"[45]..", "swap": false, "error":true},
            		{"code":"...", "swap": true}
        		]
			}'
			/>
			@SetPageTitle(title)
		</head>
		<body
			class="h-full"
			hx-ext="response-targets,preload,ajax-header,sse"
			_="on every htmx:beforeSend in <button:not(.no-disable)/> tell it toggle [@disabled='true'] until htmx:afterOnLoad"
			hx-target-404={ partials.ContentID.Target() }
		>
			<input id="page-theme" type="checkbox" value={ models.GetUserTheme(ctx) } class="toggle theme-controller hidden" checked="checked"/>
			<input id="csrf_token" type="hidden" name="csrf_token" value={ models.CSRFTokenFromCtx(ctx) }/>
			<div id={ partials.ModalContainerID.String() } hx-target-error="#modal-errors"></div>
			if body != nil {
				@body
			}
			{ children... }
			//  px-4 py-6 sm:p-6
			<div aria-live="assertive" class="pointer-events-none fixed inset-0 flex items-end sm:items-start z-999">
				<div id={ partials.NotificationsID.String() } class="flex w-full flex-col items-center space-y-4 sm:items-end"></div>
			</div>
		</body>
	</html>
}
