package templates

import "github.com/immanent-tech/foragd/web/templates/element"

// pageHeading renders a section appropriate for displaying a page title and actions.
templ pageHeading(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		class={ "md:flex md:items-center md:justify-between", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// pageTitle renders a page title and any additional/supporting content.
templ pageTitle(title string) {
	<div class="min-w-0 flex-1">
		<h1 class="font-display text-2xl font-bold tracking-tight text-balance sm:text-3xl">{ title }</h1>
		{ children... }
	</div>
}

// pageActions renders page action content. Placement will be on the right of the title on desktop screens, or under the
// title on mobile screens.
templ pageActions(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		class={ "mt-4 flex items-center md:mt-0 md:ml-4", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// sectionHeading renders a section appropriate for displaying a section title and actions.
templ sectionHeading(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		class={ "border-b border-neutral/15 pb-2 sm:flex sm:items-center sm:justify-between", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// sectionTitle renders a section title and any additional/supporting content.
templ sectionTitle(title string) {
	<div class="min-w-0 flex-1">
		<h2 class="font-display text-lg font-semibold">{ title }</h2>
		{ children... }
	</div>
}

// sectionActions renders section action content. Placement will be on the right of the title on desktop screens, or under the
// title on mobile screens.
templ sectionActions() {
	<div class="mt-3 flex sm:mt-0 sm:ml-4">
		{ children... }
	</div>
}
