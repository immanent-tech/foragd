package content

import (
	"context"
	"fmt"
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/input/hiddeninput"
)

// PaginationControl generates an element that will cause a pagination request when scrolled into view.
templ PaginationControl(ctx context.Context, route string, pagination models.Pagination) {
	<div
		hx-post={ route }
		hx-include="#content-filters"
		hx-vals={ fmt.Sprintf("{%q:%q}", models.ParamPagination, pagination) }
		hx-trigger="intersect once"
		hx-target={ CardsID.Target() }
		hx-swap="beforeend"
		hx-indicator="#content-loading"
		_="on htmx:afterRequest remove me"
	></div>
}

templ Filters(filters models.Filters) {
	<div id="content-filters" class="hidden">
		for name, value := range filters.Parameters() {
			@hiddeninput.Build(
				hiddeninput.WithName(name),
				hiddeninput.WithValue(attributes.Value(value)),
			).Show()
		}
	</div>
}
