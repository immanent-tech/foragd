type ProxiedImage struct {
	HTMLElement
}

templ NewProxiedImage(img *types.ImageInfo, props string, options ...Option[element]) {
	{{ elem := &ProxiedImage{HTMLElement: NewHTMLElement()} }}
	for option := range slices.Values(options) {
		{{ option(elem) }}
	}
	{{ elem.SetAttribute("class", strings.Join(elem.GetClasses(), " ")) }}
	<img
		if elem.GetID() != "" {
			id={ elem.GetID() }
		}
		src={ generateImageProxyURL(ctx, img.GetURL(), props) }
		alt={ img.GetTitle() }
		{ elem.attributes... }
	/>
	// src={ generateImageProxyURL(ctx, img.GetURL(), props) }
}

func generateImageProxyURL(ctx context.Context, url, props string) string {
	var keyBin, saltBin []byte
	var err error

	// Extract the key.
	key, ok := ctx.Value(ImgProxyKey).(string)
	if !ok {
		return url
	}
	if keyBin, err = hex.DecodeString(key); err != nil {
		return url
	}

	// Extract the salt.
	salt, ok := ctx.Value(ImgProxySalt).(string)
	if !ok {
		return url
	}
	if saltBin, err = hex.DecodeString(salt); err != nil {
		return url
	}

	encodedImageURL := base64.RawURLEncoding.EncodeToString([]byte(url))

	path := "/" + props + "/" + encodedImageURL

	mac := hmac.New(sha256.New, keyBin)
	mac.Write(saltBin)
	mac.Write([]byte(path))
	signature := base64.RawURLEncoding.EncodeToString(mac.Sum(nil))

	return "/img-proxy/" + signature + path
}

func generateHXVals(values map[string]any) string {
	data, err := json.Marshal(values)
	if err != nil {
		return ""
	}
	return string(data)
}
