package templates

import "github.com/immanent-tech/foragd/providers/google/android"

templ androidCheckoutButton(frequency string) {
	{{ priceID, err := android.GetPriceID(frequency) }}
	if err != nil {
		<a href="/contact" class="btn btn-primary">
			Contact Support <span aria-hidden="true">&rarr;</span>
		</a>
	} else {
		<button
			aria-label={ "Activate " + frequency + " subscription" }
			id={ "checkout-" + frequency }
			type="button"
			class="btn btn-block btn-accent"
			onclick={ templ.JSFuncCall("purchaseAndroidSKU", priceID) }
			data-sku={ priceID }
		>
			Activate { frequency } subscription
		</button>
	}
}

templ androidPurchaseScript() {
	<script id="android-purchase" nonce={ templ.GetNonce(ctx) }>
		async function purchaseAndroidSKU(skuID) {
		// Only available inside TWA
		if (!('getDigitalGoodsService' in window)) {
			alert('In-app purchases are only available in the Foragd Android app.');
			return;
		}

		let service;
		try {
			service = await window.getDigitalGoodsService('https://play.google.com/billing');
		} catch (e) {
			console.error('getDigitalGoodsService failed:', e);
			return;
		}

		const paymentMethod = {
			supportedMethods: 'https://play.google.com/billing',
			data: { sku: skuID },
		};

		// The Payment Request API's spec requires a total parameter even when the actual payment method (Play Billing, in this
		// case) doesn't use it — it's a generic web payments API designed to work across many payment methods, some of which do
		// need a client-specified total (e.g. a custom checkout). Play Billing isn't one of them, so it discards yours.
		const request = new PaymentRequest([paymentMethod], {
			total: { label: 'Total', amount: { currency: 'USD', value: '0' } },
		});

		let response;
		try {
			response = await request.show();
		} catch (e) {
			// User cancelled
			return;
		}

		const { purchaseToken } = response.details;
		const subscriptionType = "android";

		let res;
	    try {
	        res = await fetch('/checkout', {
	            method: 'POST',
	            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: `sku=${encodeURIComponent(skuID)}&purchaseToken=${encodeURIComponent(purchaseToken)}&subscription_type=${encodeURIComponent(subscriptionType)}`,
	            redirect: 'follow', // default, but explicit here
	        });
	    } catch (e) {
	        // Network failure — tell Play Billing it failed, don't redirect
			console.error('checkout fetch failed:', e);
	        await response.complete('fail');
	        return;
	    }

	    // fetch() follows redirects transparently and res.ok reflects the FINAL response
	    await response.complete(res.ok ? 'success' : 'fail');
    	if (res.ok) {
    	    window.location.href = res.url;
    	} else {
    	    console.error('checkout verification failed, status:', res.status);
			window.location.href = res.url;
    	}
		}
	</script>
}

templ androidPreCheckout() {
	@androidPurchaseScript()
}
