package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
)

// Document renders the given raw HTML data as full-page prose content. Used primarily for hosted markdown documents
// (i.e., privacy policy, terms of service, etc.)
templ Document(data []byte) {
	@content() {
		@container() {
			<article class="mx-auto my-4 prose sm:prose-lg prose-img:shadow-md">
				@templ.Raw(string(data))
			</article>
			@partials.ButtonBackToTop()
		}
	}
}

// content renders children wrapped with appropriate header/footer navigation.
templ content(options ...element.PropertiesOption) {
	{{
		props := element.NewProperties(options...)
		user := models.UserFromCtx(ctx)
	}}
	// Header.
	@header(user)
	if user != nil {
		// Navigation sidebar (on large displays) for logged in user.
		@SideBar(nil)
	}
	<main
		id={ ContentID.String() }
		class={ "mb-24 scroll-mt-16 pt-16 min-h-svh-safe bg-base-100", templ.KV("lg:pl-36",user!=nil),  props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</main>
	if user != nil {
		// Bottom navigation dock (on small displays) for logged in user.
		@Dock(nil)
	} else {
		// Footer for non logged in user (external) pages.
		@footer()
	}
}

// container constrained to breakpoint with padded content.
templ container(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		class={ "container mx-auto px-4 sm:px-6 lg:px-8", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

// narrowContainer constrained on larger screens with padded content
templ narrowContainer(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class={ "mx-auto max-w-3xl", props.Classes() }
			{ props.Attributes()... }
		>
			{ children... }
		</div>
	</div>
}

templ grid(options ...element.PropertiesOption) {
	{{ props := element.NewProperties(options...) }}
	<div
		id="grid-objects"
		class={ "grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-8 xl:grid-cols-3 xl:gap-12 p-2 items-start content-auto", props.Classes() }
		style="display: grid;grid-template-rows: masonry;"
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}
