package templates

import "github.com/sebasvil20/templicons/tabler"

// main can be used as a container for the main content of the page. It restricts content to a max width and adds
// padding.
templ main() {
	<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 pb-24 sm:pb-8">
		{ children... }
	</main>
}

// grid can be used as a container for defining a responsive grid layout for children elements.
templ grid() {
	<div
		role="list"
		class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2 sm:gap-4 items-center"
		id="grid-objects"
		_="on scroll send scrolled"
	>
		{ children... }
	</div>
	// Back to top button only revealed when user scrolls through results.
	<button
		class="btn btn-circle btn-accent opacity-0 fixed bottom-10 right-10"
		_="
		on scroll from window queue last
  			if the window's pageYOffset is greater than 20
    			transition opacity to 1
  			otherwise
    			transition opacity to 0
		end
		on click go to the top of the body smoothly
		"
	>
		@tabler.ArrowUp()
	</button>
}

// Document renders the given raw HTML data as full-page prose content. Used primarily for hosted markdown documents
// (i.e., privacy policy, terms of service, etc.)
templ Document(data []byte) {
	<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 prose my-4">
		@templ.Raw(string(data))
	</main>
}
