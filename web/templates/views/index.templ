package views

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/actions/button"
)

type IndexPage struct{}

func (page *IndexPage) Template() templ.Component {
	return templates.NewPage("Go Feed Me",
		templates.WithBodyContent(page.layout()),
	)
}

templ (page *IndexPage) layout() {
	<div id="index-hero" class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">Go Feed Me</h1>
				<p class="py-6">
					Your new homepage on the internet.
				</p>
				<div id={ partials.ContentID.String() }>
					<div class="flex gap-2 justify-center">
						@partials.NewAction("/login", partials.DisplayActionAsButton,
							partials.ActionButtonOptions(
								button.WithClasses(button.Primary),
							),
							partials.ActionTarget(partials.ContentID.Target()),
						) {
							Login
						}
						@partials.NewAction("/signup", partials.DisplayActionAsButton,
							partials.ActionButtonOptions(
								button.WithClasses(button.Primary),
							),
							partials.ActionTarget(partials.ContentID.Target()),
						) {
							Sign-up
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
