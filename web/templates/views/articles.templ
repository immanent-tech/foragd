package views

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates/layouts"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
)

type ArticlesPage struct {
	filters    *models.ArticleFilters
	articles   models.Articles
	pagination models.Pagination
}

func NewArticlesPage(articles models.Articles, filters *models.ArticleFilters, pagination models.Pagination) *ArticlesPage {
	return &ArticlesPage{
		articles:   articles,
		filters:    filters,
		pagination: pagination,
	}
}

// Content renders article cards and filter/sorting controls.
templ (page *ArticlesPage) Content() {
	<div id="content-filters" class="hidden">
		for name, value := range page.filters.Parameters() {
			<input type="hidden" name={ name } value={ value }/>
		}
	</div>
	@partials.ListControls{
		Path:       "/articles",
		Filters:    page.filters,
		Categories: page.articles.GetCategoryCounts(),
	}.Template()
	@layouts.CardGrid() {
		@page.List()
	}
}

// List renders just article cards. Called when paginating through subscriptions.
templ (page *ArticlesPage) List() {
	for article := range slices.Values(page.articles) {
		@partials.NewArticleContent(article).Card(page.filters.GetView())
	}
	// Add pagination element if pagination is required.
	if page.pagination != "" && len(page.articles) == page.filters.GetCount() {
		// Add pagination htmx props to last article.
		@layouts.PaginationControl(ctx, "/articles", page.pagination)
	}
}

type ArticlePage struct {
	article *models.Article
}

func NewArticlePage(article *models.Article) *ArticlePage {
	return &ArticlePage{
		article: article,
	}
}

// Content renders an article.
templ (page *ArticlePage) Content() {
	@partials.NewArticleContent(page.article).Content()
}
