package views

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-feed-me/web/templates/layouts"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
)

type ArticlesPage struct {
	filters    *models.ArticleFilters
	articles   models.Articles
	pagination models.Pagination
}

func NewArticlesPage(articles models.Articles, filters *models.ArticleFilters, pagination models.Pagination) *ArticlesPage {
	return &ArticlesPage{
		articles:   articles,
		filters:    filters,
		pagination: pagination,
	}
}

// Content renders article cards and filter/sorting controls.
templ (page *ArticlesPage) Content() {
	<div id="content-filters" class="hidden">
		for name, value := range page.filters.Parameters() {
			<input type="hidden" name={ name } value={ value }/>
		}
	</div>
	// Breadcrumbs/Navigation.
	<div>
		<nav aria-label="Back" class="sm:hidden">
			<a _="on click call history.back()" class="link link-hover flex items-center text-sm font-medium text-base-content/50 hover:text-base-content">
				<svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="mr-1 -ml-1 size-5 shrink-0 text-base-content/50">
					<path d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" fill-rule="evenodd"></path>
				</svg>
				Back
			</a>
		</nav>
		<nav aria-label="Breadcrumb" class="hidden sm:flex">
			<ol role="list" class="flex items-center space-x-4">
				<li>
					<div class="flex">
						<a
							hx-get="/subscriptions"
							hx-target={ partials.ContentID.Target() }
							hx-vals={ models.GenerateHXVals(session.SubscriptionFiltersFromSession(ctx).Parameters()) }
							hx-push-url="true"
							class="link link-hover text-sm font-medium text-base-content/50 hover:text-base-content"
						>Subscriptions</a>
					</div>
				</li>
				if len(page.filters.Subscriptions) > 0 {
					<li>
						<div class="flex items-center">
							<svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 shrink-0 text-base-content/50">
								<path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"></path>
							</svg>
							<a href="#" class="ml-4 link link-hover text-sm font-medium text-base-content/50 hover:text-base-content">
								{ page.articles[0].GetFeedTitle() }
							</a>
						</div>
					</li>
				}
			</ol>
		</nav>
	</div>
	@partials.ListControls{
		Path:       "/articles",
		Filters:    page.filters,
		Categories: page.articles.GetCategoryCounts(),
	}.Template()
	@layouts.CardGrid() {
		@page.List()
	}
}

// List renders just article cards. Called when paginating through subscriptions.
templ (page *ArticlesPage) List() {
	for article := range slices.Values(page.articles) {
		@partials.NewArticleContent(article).Card(page.filters.GetView())
	}
	// Add pagination element if pagination is required.
	if page.pagination != "" && len(page.articles) == page.filters.GetCount() {
		// Add pagination htmx props to last article.
		@layouts.PaginationControl(ctx, "/articles", page.pagination)
	}
}

type ArticlePage struct {
	article *models.Article
}

func NewArticlePage(article *models.Article) *ArticlePage {
	return &ArticlePage{
		article: article,
	}
}

// Content renders an article.
templ (page *ArticlePage) Content() {
	@partials.NewArticleContent(page.article).Content()
}
