package views

import (
	"context"
	"github.com/angelofallars/htmx-go"
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/layouts"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/actions/dropdown"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/feedback/loading"
	"github.com/joshuar/go-templ-daisyui/input/hiddeninput"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strings"
)

type ArticlesPage struct {
	filters    *models.ArticleFilters
	articles   models.Articles
	pagination models.Pagination
}

func NewArticlesPage(articles models.Articles, filters *models.ArticleFilters, pagination models.Pagination) *ArticlesPage {
	return &ArticlesPage{
		articles:   articles,
		filters:    filters,
		pagination: pagination,
	}
}

// Template will render the home page based on the request details.
func (page *ArticlesPage) Template(req *http.Request) templ.Component {
	switch {
	case req.Method == http.MethodPost:
		return page.cards()
	case htmx.IsHTMX(req) && !htmx.IsHistoryRestoreRequest(req):
		return page.content()
	default:
		return templates.NewPage("Go Feed Me - Articles",
			templates.WithBodyContent(page.layout()),
		)
	}
}

// layout is the complete page layout for the articles page.
templ (page *ArticlesPage) layout() {
	@layouts.Drawer() {
		@page.content()
	}
}

// content is the main content to show for a collection of articles.
templ (page *ArticlesPage) content() {
	<div id="content-filters" class="hidden">
		for name, value := range page.filters.Parameters() {
			@hiddeninput.Build(
				hiddeninput.WithName(name),
				hiddeninput.WithValue(attributes.Value(value)),
			)
		}
	</div>
	<div id="card-controls" class="controls">
		@partials.NewAction("/articles", partials.DisplayActionAsButton,
			partials.ActionInclude("#content-filters"),
			partials.ActionValues(page.filters.Parameters()),
		) {
			@tabler.Refresh()
		}
		@UpdateSorting("/articles", page.filters.GetSort())
		@UpdateFilters(page.articles.GetCategoryCounts(), "/articles", page.filters.GetCategories(), page.filters.GetView())
		@dropdown.Build(
			dropdown.WithButtonContent(tabler.DotsVertical()),
			dropdown.WithOpenAlignment(dropdown.AlignEnd),
			dropdown.WithMenuClasses("flex-nowrap", "grow", "min-w-52", "text-xs"),
		).Show() {
			<li>
				switch page.filters.GetView() {
					case models.ViewUnread:
						@partials.NewAction("/subscriptions/mark/"+string(models.MarkRead), partials.DisplayActionAsLink,
							partials.ActionMethod(http.MethodPost),
							partials.ActionValues(map[string]string{
								models.ParamSubscriptions: strings.Join(page.articles.GetSubscriptionIDs(), ","),
								"redirect":                "/subscriptions",
							}),
						) {
							<div class="flex gap-2">
								@tabler.Bookmark(i.Props{Size: i.SizeXS})
								Mark Read
							</div>
						}
					default:
						@partials.NewAction("/subscriptions/mark/"+string(models.MarkUnread), partials.DisplayActionAsLink,
							partials.ActionMethod(http.MethodPost),
							partials.ActionValues(map[string]string{
								models.ParamSubscriptions: strings.Join(page.articles.GetSubscriptionIDs(), ","),
								"redirect":                "/subscriptions",
							}),
						) {
							<div class="flex gap-2">
								@tabler.Bookmark(i.Props{Size: i.SizeXS})
								Mark Read
							</div>
						}
				}
			</li>
		}
	</div>
	@layouts.CardGrid() {
		if len(page.articles) > 0 {
			@page.cards()
		} else {
			@page.emptyContent()
		}
	}
	<div id="content-loading" class="items-center justify-center">
		@loading.Build(loading.Bars,
			loading.AsHTMXIndicator(),
			loading.WithThemeColor(color.Accent),
		).Show()
	</div>
	@partials.Footer()
}

// emptyContent will render a hero with some options when there are no articles to display.
templ (page *ArticlesPage) emptyContent() {
	<div class="hero bg-base-200 min-h-screen rounded-box">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">No content to show</h1>
				<p class="py-6">
					Try adjusting your filters, or maybe there is nothing left to read?
				</p>
				@partials.NewAction("/home", partials.DisplayActionAsButton,
					partials.ActionButtonOptions(
						button.WithClasses(button.Primary),
					),
				) {
					Take me home
				}
			</div>
		</div>
	</div>
}

func (s ArticlesPage) generateCards(ctx context.Context) []templ.Component {
	cards := make([]templ.Component, 0, len(s.articles))
	for article := range slices.Values(s.articles) {
		cards = append(cards, partials.NewArticleContent(article).Card())
	}
	// Add pagination element if pagination is required.
	if s.pagination != "" && len(cards) == s.filters.GetCount() {
		// Add pagination htmx props to last article.
		cards = append(cards, layouts.PaginationControl(ctx, "/articles", s.pagination))
	}
	return cards
}

// cards will render just the article cards.
templ (page *ArticlesPage) cards() {
	for cards := range slices.Values(page.generateCards(ctx)) {
		@cards
	}
}

type ArticlePage struct {
	article *models.Article
}

func NewArticlePage(article *models.Article) *ArticlePage {
	return &ArticlePage{
		article: article,
	}
}

// Template will render the home page based on the request details.
func (page *ArticlePage) Template(req *http.Request) templ.Component {
	switch {
	case htmx.IsHTMX(req) && !htmx.IsHistoryRestoreRequest(req):
		return page.content()
	default:
		return templates.NewPage("Go Feed Me - "+page.article.GetTitle(),
			templates.WithBodyContent(page.layout()),
		)
	}
}

// layout is the complete page layout for the articles page.
templ (page *ArticlePage) layout() {
	@layouts.Drawer() {
		@page.content()
	}
}

// content is the main content to show for a collection of articles.
templ (page *ArticlePage) content() {
	@partials.NewArticleContent(page.article).Content()
}
