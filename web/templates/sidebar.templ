package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
)

type SideBarComponent struct {
	attributes templ.Attributes
}

templ SideBar(attributes templ.Attributes) {
	<nav id="page-sidebar" class="hidden bg-base-200 border-r border-base-content/30 lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-36 lg:flex-col" { attributes... }>
		<div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-base-content/10 px-6 pb-4">
			<div class="flex flex-row shrink-0 p-2 items-center text-primary">
				@LogoSmall("flex size-16")
				<p class="font-bold">Foragd</p>
			</div>
			<div aria-label="Sidebar Navigation" class="flex flex-1 flex-col place-items-center">
				<ul role="list" class="flex flex-1 flex-col my-64 justify-between">
					<li>
						@NewLink(
							WithHXTrigger("click,globalShortcutHome"),
							WithHXMethod(http.MethodGet, models.RouteHome),
							WithHXTarget(ContentID.Target()),
							WithHXSwap("innerHTML show:window:top transition:true"),
							WithHXPushURL(true),
							WithClasses("group link no-underline flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
							WithAttribute("_", "on keydown from body if the event's key is 'h' and event.altKey then send globalShortcutHome"),
						) {
							<span class="sr-only">Go to Home Page</span>
							@tabler.HomeFilled(i.Props{Class: "size-10 shrink-0 text-primary"})
							<span class={ "text-primary", templ.KV("underline underline-offset-4 decoration-4",models.PathFromCtx(ctx) == models.RouteHome) }>Home</span>
						}
					</li>
					<li>
						@NewLink(
							WithHXTrigger("click,globalShortcutSubscriptions"),
							WithHXMethod(http.MethodGet, models.RouteListSubscriptions),
							WithHXTarget(ContentID.Target()),
							WithHXSwap("innerHTML show:window:top transition:true"),
							WithHXPushURL(true),
							WithHXVals(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()),
							WithClasses("group link no-underline flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
							WithAttribute("_", "on keydown from body if the event's key is 's' and event.altKey then send globalShortcutSubscriptions"),
						) {
							<span class="sr-only">Go to Subscriptions</span>
							@tabler.Rss(i.Props{Class: "size-10 shrink-0 text-primary"})
							<span class={ "text-primary", templ.KV("underline underline-offset-4 decoration-4",models.PathFromCtx(ctx) == models.RouteListSubscriptions) }>Subscriptions</span>
						}
					</li>
					<li>
						@NewLink(
							WithHXTrigger("click,globalShortcutArticles"),
							WithHXMethod(http.MethodGet, models.RouteListArticles),
							WithHXTarget(ContentID.Target()),
							WithHXSwap("innerHTML show:window:top transition:true"),
							WithHXPushURL(true),
							WithHXVals(models.PageFiltersFromCtx(ctx, "/list/articles").Values()),
							WithClasses("group link no-underline flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
							WithAttribute("_", "on keydown from body if the event's key is 'a' and event.altKey then send globalShortcutArticles"),
						) {
							<span class="sr-only">Go to Articles</span>
							@tabler.FileRssFilled(i.Props{Class: "size-10 shrink-0 text-primary"})
							<span class={ "text-primary", templ.KV("underline underline-offset-4 decoration-4",models.PathFromCtx(ctx) == models.RouteListArticles) }>Articles</span>
						}
					</li>
					<li>
						@NewLink(
							WithHXTrigger("click,globalShortcutFavorites"),
							WithHXMethod(http.MethodGet, models.RouteListFavorites),
							WithHXTarget(ContentID.Target()),
							WithHXSwap("innerHTML show:window:top transition:true"),
							WithHXPushURL(true),
							WithClasses("group link no-underline flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
							WithAttribute("_", "on keydown from body if the event's key is 'f' and event.altKey then send globalShortcutFavorites"),
						) {
							<span class="sr-only">Go to Favorites</span>
							@tabler.HeartFilled(i.Props{Class: "size-10 shrink-0 text-primary"})
							<span class={ "text-primary", templ.KV("underline underline-offset-4 decoration-4",models.PathFromCtx(ctx) == models.RouteListFavorites) }>Favorites</span>
						}
					</li>
				</ul>
			</div>
		</div>
	</nav>
}
