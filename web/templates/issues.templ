package templates

import "github.com/immanent-tech/foragd/models"
import "github.com/immanent-tech/foragd/web/templates/helpers/mailto"
import "github.com/dimmerz92/go-icons/tabler-outline"

// ReportIssue renders a form for reporting issues with the app.
templ ReportIssue(details *models.ReportIssueRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container() {
				<section class="mx-auto sm:max-w-3xl">
					// Show a page header.
					<h1 id="page-title" class="mt-4 mb-2 scroll-mt-16 font-display text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Report an Issue</h1>
					<p class="mt-2 max-w-4xl text-neutral">
						Use this form to report an issue with the app. We will look into it and get back to you as soon as we can.
					</p>
					<p class="mt-2 max-w-4xl text-neutral">
						Alternatively, you can <a class="link" href={ mailto.Build("support@immanent.tech", mailto.WithSubject("Foragd Issue")) }>email us</a> instead.
					</p>
					<form
						id="report-app-issue"
						hx-post={ "/issue" }
						hx-target={ ContentID.Target() }
						hx-target-error={ ContentID.Target() }
						hx-encoding="multipart/form-data"
						hx-swap="none"
						hx-push-url="false"
						class="mt-12"
					>
						// Hidden input containing the current page url.
						<input type="hidden" name="page_url" value={ details.PageUrl }/>
						if details.ObjectID != nil && *details.ObjectID != "" {
							<input type="hidden" name="object_id" value={ *details.ObjectID }/>
						}
						<div class="space-y-12">
							<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
								// User email.
								<div class="sm:col-span-4">
									<label for="email" class="block text-sm/6 font-medium text-neutral">Email address</label>
									<div class="mt-2">
										<input
											id="email"
											type="email"
											name="user_email"
											value={ details.UserEmail }
											autocomplete="email"
											required
											class="input input-primary bg-base-300 brightness-95"
										/>
									</div>
								</div>
								// Screenshot.
								<div class="sm:col-span-full">
									<span class="block text-sm/6 font-medium">Screenshot</span>
									<div
										id="drop-zone"
										class="group mt-2 flex justify-center rounded-lg border border-dashed border-neutral/20 px-6 py-10 sm:max-w-lg"
										_="
                                        on dragover
                                          halt the event
                                          add .bg-base-300 .border-accent to me
                                        end

                                        on dragleave
                                          remove .bg-base-300 .border-accent from me
                                        end

                                        on drop
                                          halt the event
                                          remove .bg-base-300 .border-accent from me
                                          set files to event.dataTransfer.files
                                          set #screenshot-upload's files to files
                                          set #file-name's textContent to files[0].name
										  set f to event.dataTransfer.files[0]
									      js(f)
      										return new Promise(resolve => {
      										  if (!f.type.startsWith('image/')) { resolve(null); return; }
      										  const r = new FileReader();
      										  r.onload = e => resolve(e.target.result);
      										  r.readAsDataURL(f);
      										});
    									  end
                                        end
                                    "
									>
										<div class="text-center">
											<div id="preview-area">
												@tableroutline.FileUpload(templ.Attributes{"class": "group-hover:text-primary group-active:text-primary mx-auto size-12 stroke-1"})
												<p id="preview-meta" style="font-size:0.85rem; color:#666;"></p>
											</div>
											<span id="file-name"></span>
											<div class="mt-4 flex items-center justify-center text-sm/6 strok">
												<label for="screenshot-upload" class="relative cursor-pointer rounded-md bg-transparent font-semibold focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary hover:text-primary">
													<span class="btn btn-dash btn-neutral">Upload a file</span>
													<input
														id="screenshot-upload"
														type="file"
														name="screenshot"
														class="sr-only"
														_="on change set #file-name's textContent to my files[0].name"
													/>
												</label>
												<p class="pl-1">or drag and drop</p>
											</div>
											<p class="text-xs/5">JPG, PNG or WEBP up to 10MB</p>
										</div>
									</div>
								</div>
								// Issue description.
								<div class="col-span-full">
									<label for="about" class="block text-sm/6 font-medium">Describe the issue</label>
									<div class="mt-2">
										<textarea id="details" name="details" rows="5" class="textarea textarea-primary w-full sm:max-w-prose bg-base-300 brightness-95"></textarea>
									</div>
									<p class="mt-3 text-sm/6 neutral">Describe the issue in as much detail as possible.</p>
								</div>
							</div>
						</div>
						<div class="mt-6 flex items-center justify-end gap-x-6 w-full sm:max-w-3xl">
							<button
								type="button"
								class="btn btn-secondary hover:btn-error"
								hx-get={ details.PageUrl }
								hx-target={ ContentID.Target() }
								hx-swap="innerHTML transition:true"
							>
								<span class="text-sm/6">Back</span>
							</button>
							<button type="submit" class="btn btn-primary">
								<span class="show-loading items-center">
									<span class="loading mr-3 loading-spinner"></span>
									<span class="text-sm/6">Processing</span>
								</span>
								<span class="hide-loading items-center">
									<span class="text-sm/6">Submit</span>
								</span>
							</button>
						</div>
					</form>
				</section>
			}
		}
	}
}
