package templates

import (
	"github.com/dimmerz92/go-icons/tabler-outline"
	tabler "github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/indaco/teseo/schemaorg"
)

templ HeaderExternal() {
	{{
		navJsonLd := schemaorg.NewSiteNavigationElementList(
			"main",
			[]schemaorg.SiteNavigationElement{
				schemaorg.NewSimpleSiteNavigationElement(1, "Home", config.GetBaseURL()),
				schemaorg.NewSimpleSiteNavigationElement(2, "About", config.GetBaseURL()+"/about"),
				schemaorg.NewSimpleSiteNavigationElement(3, "Features", config.GetBaseURL()+"/features"),
				schemaorg.NewSimpleSiteNavigationElement(4, "Blog", config.GetBaseURL()+"/blog"),
				schemaorg.NewSimpleSiteNavigationElement(5, "Changelog", config.GetBaseURL()+"/changelog"),
				schemaorg.NewSimpleSiteNavigationElement(6, "Viewer", config.GetBaseURL()+"/viewer"),
			},
		)
	}}
	@navJsonLd.ToJsonLd()
	<header id="page-header" class="absolute inset-x-safe-or-0 top-0 z-50 pt-safe">
		<nav aria-label="Navigation" class="flex items-center justify-between p-6 lg:px-8">
			<div class="flex lg:flex-1">
				<a
					href="/"
					class="-m-1.5 p-1.5"
					aria-label="Back to landing page"
				>
					<div class="flex shrink-0 items-center justify-center p-2 sm:w-36 sm:flex-row">
						@partials.Logo(element.WithClasses("size-10"))
					</div>
				</a>
			</div>
			<div class="flex lg:hidden">
				<button type="button" command="show-modal" commandfor="mobile-menu" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5">
					<span class="sr-only">Open main menu</span>
					@tableroutline.Menu2(templ.Attributes{"class": "size-6 stroke-accent", "aria-hidden": "true"})
				</button>
			</div>
			<ul class="hidden menu menu-horizontal menu-lg lg:flex lg:gap-x-12">
				<li>
					<a href="/about" class="link text-sm/6 font-semibold text-primary link-hover">About</a>
				</li>
				<li>
					<a href="/features" class="link text-sm/6 font-semibold text-primary link-hover">Features</a>
				</li>
				<li>
					<a href="/#pricing" class="link text-sm/6 font-semibold text-primary link-hover">Pricing</a>
				</li>
				<li>
					<a href="/blog" class="link text-sm/6 font-semibold text-primary link-hover">Blog</a>
				</li>
				<li>
					<a href="/changelog" class="link text-sm/6 font-semibold text-primary link-hover">Changelog</a>
				</li>
				<li>
					<a href="/viewer" class="link text-sm/6 font-semibold text-primary link-hover">Feed Viewer</a>
				</li>
			</ul>
			<div class="hidden lg:flex lg:flex-1 lg:justify-end">
				<a href="/login" class="link text-sm/6 font-semibold text-secondary link-hover">Log in <span aria-hidden="true">&rarr;</span></a>
			</div>
		</nav>
		<el-dialog>
			<dialog id="mobile-menu" class="backdrop:bg-transparent lg:hidden">
				<div tabindex="0" class="fixed inset-0 focus:outline-none">
					<el-dialog-panel class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-base-100 p-6 sm:max-w-sm sm:ring-1 sm:ring-neutral/10">
						<div class="flex items-center justify-between">
							<a href="#" class="-m-1.5 p-1.5">
								<span class="sr-only">Foragd</span>
								@partials.Logo(element.WithClasses("size-10"))
							</a>
							<button type="button" command="close" commandfor="mobile-menu" class="btn btn-ghost btn-square">
								<span class="sr-only">Close menu</span>
								@tableroutline.X(templ.Attributes{"class": "size-6 stroke-accent", "aria-hidden": "true"})
							</button>
						</div>
						<div class="mt-6 flow-root">
							<ul class="-my-6 menu menu-lg w-full divide-y divide-neutral/10">
								<ul>
									<li class="menu-title">Navigation</li>
									<li>
										<a href="/about" class="font-semibold text-primary link-hover">About</a>
									</li>
									<li>
										<a href="/features" class="font-semibold text-primary link-hover">Features</a>
									</li>
									<li>
										<a href="/#pricing" class="font-semibold text-primary link-hover">Pricing</a>
									</li>
									<li>
										<a href="/blog" class="font-semibold text-primary link-hover">Blog</a>
									</li>
									<li>
										<a href="/changelog" class="font-semibold text-primary link-hover">Changelog</a>
									</li>
									<li>
										<a href="/viewer" class="font-semibold text-primary link-hover">Feed Viewer</a>
									</li>
								</ul>
								<li>
									<a href="/login" class="font-semibold text-secondary link-hover">Log in</a>
								</li>
							</ul>
						</div>
					</el-dialog-panel>
				</div>
			</dialog>
		</el-dialog>
	</header>
}

templ HeaderInternal(props *InternalLayoutProps) {
	<header
		id="page-header"
		aria-label="Header"
		class="fixed top-0 inset-x-safe-or-0 z-50 h-16 w-screen border-b border-neutral/10 bg-base-200 pt-safe shadow-sm"
	>
		<div class="flex w-full items-center justify-between">
			<a
				hx-get="/home"
				hx-target={ ContentID.Target() }
				hx-swap="innerHTML scroll:#content:top transition:true"
				class="flex shrink link link-hover"
				aria-label="Foragd home"
			>
				<div class="flex shrink-0 items-center justify-center p-2 sm:w-36 sm:flex-row">
					@partials.Logo(element.WithClasses("size-10"))
					<span class="hidden font-serif text-xs font-bold text-primary sm:flex sm:text-lg">foragd</span>
				</div>
			</a>
			// Global search bar.
			<div class="flex flex-1 justify-center">
				@Search()
			</div>
			// User settings menu.
			<div class="mx-2 flex items-center justify-end space-x-2 sm:mr-4">
				<div aria-hidden="true" class="hidden lg:block lg:h-6 lg:w-px lg:bg-base-content/10"></div>
				<el-popover-group class="flex items-center gap-x-2">
					// Display a clickable warning popover to indicate the user's trial has expired and they need to purchase a subscription.
					if !props.User.InTrial() && props.User.InTrialGracePeriod() {
						<button popovertarget="trial-grace-period" type="button" class="btn btn-warning btn-square">
							@tabler.AlertTriangle(templ.Attributes{"class": "icon text-warning-content"})
						</button>
						<el-popover popover id="trial-grace-period" anchor="bottom end" class="rounded-box [--anchor-gap:--spacing(2.5)]">
							<div role="alert" class="alert alert-warning">
								<div class="grid grid-cols-3">
									<div class="col-span-full flex items-center gap-x-2">
										<div class="shrink-0">
											@tabler.AlertTriangle(templ.Attributes{"class": "icon text-warning-content"})
										</div>
										<span>
											Warning: Your trial has expired and your access will be removed within the next seven
											days. To continue using the app, please purchase a subscription.
										</span>
									</div>
									<a class="col-start-2 col-span-2 justify-self-end link font-semibold" href="/checkout">Purchase a subscription</a>
									<a class="col-start-2 col-span-2 justify-self-end link font-semibold" href="/contact">Contact support</a>
								</div>
							</div>
						</el-popover>
					}
					<el-dropdown id="header-user-menu" class="flex">
						<button class="inline-flex btn-square w-full btn-ghost">
							<span class="sr-only">Open settings menu</span>
							@UserAvatar(props.User, templ.Attributes{
								"loading": "eager",
							})
						</button>
						@partials.Menu(element.WithAttribute("id", "header-menu")) {
							// Open settings menu.
							@partials.MenuItem() {
								<a
									hx-get="/user/settings"
									hx-target={ ContentID.Target() }
								>
									<div class="flex flex-1 items-center gap-x-2">
										@tabler.Settings(templ.Attributes{"class": "text-accent", "aria-hidden": "true"})
										Settings
									</div>
								</a>
							}
							// Open Help/Documentation.
							@partials.MenuItem() {
								<a
									hx-get="/docs"
									hx-target={ ContentID.Target() }
									hx-swap="innerHTML transition:true"
									hx-replace-url="true"
								>
									<div class="flex flex-1 items-center gap-x-2">
										@tabler.Lifebuoy(templ.Attributes{"class": "text-accent", "aria-hidden": "true"})
										Help/Documentation
									</div>
								</a>
							}
							@partials.MenuItem() {
								<a
									href="/changelog"
								>
									<div class="flex flex-1 items-center gap-x-2">
										@tabler.Transform(templ.Attributes{"class": "text-accent", "aria-hidden": "true"})
										Changelog
									</div>
								</a>
							}
							// Report issue.
							@partials.MenuItem() {
								<a
									hx-get="/issue"
									hx-target={ ContentID.Target() }
									hx-replace-url="true"
								>
									<div class="flex flex-1 items-center gap-x-2">
										@tabler.Flag(templ.Attributes{"class": "text-accent", "aria-hidden": "true"})
										Report an issue
									</div>
								</a>
							}
							// Logout.
							@partials.MenuItem() {
								<a
									_="
								on click
								    js localStorage.clear() end
								    js sessionStorage.clear() end
								    then go to url '/logout'
								"
								>
									<div class="flex flex-1 items-center gap-x-2">
										@tabler.Logout(templ.Attributes{"class": "text-accent", "aria-hidden": "true"})
										Log out
									</div>
								</a>
							}
						}
					</el-dropdown>
				</el-popover-group>
			</div>
		</div>
	</header>
}
