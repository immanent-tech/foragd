package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ header() {
	<header class="sticky w-full top-0 z-50 flex h-16 items-center bg-base-200 border-b border-base-content/30 lg:pl-36">
		<div class="flex flex-1 mx-auto items-center">
			// Show small logo on mobile.
			<div class="flex flex-col lg:hidden h-16 shrink-0 mt-8 items-center text-accent mx-2">
				@LogoSmall("size-8")
			</div>
			// Global search bar.
			<div class="flex flex-1 justify-center">
				<el-command-palette class="grid w-full sm:max-w-3xl">
					<label for="global-search" class="w-full sm:max-w-3xl input input-accent text-base sm:text-sm/6 placeholder:text-base-content/50 bg-base-content/10">
						@tabler.Search(i.Props{Class: "pointer-events-none flex-none text-accent"})
						<form
							hx-trigger="input changed delay:100ms"
							hx-post="/search/suggestions"
							hx-target="#global-search-suggestions"
							hx-include="[name='csrf_token'],#search-filters"
							hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
							class="flex-1"
						>
							<input
								id="global-search"
								type="search"
								name="text"
								hx-push-url="false"
								placeholder="Search..."
								_="on customCtrlK from body me.focus()"
							/>
						</form>
						// Filters button opens advanced search dialog.
						<button
							type="button"
							command="show-modal"
							commandfor="search-filters-dialog"
						>
							// _="on click toggle .hidden on #search-filters-dialog then toggle .disabled on #global-search then halt bubbling"
							@tabler.Filter(i.Props{Class: "flex-none text-accent"})
						</button>
					</label>
					// _="on keydown[key is 'Escape'] add @hidden end on click from elsewhere add .hidden end"
					<el-command-list
						id="global-search-suggestions"
						class="absolute left-0 sm:fixed sm:left-auto top-16 mt-2 w-full sm:max-w-3xl max-h-svh sm:h-fit scroll-py-2 overflow-y-auto rounded-md shadow-lg bg-base-300 text-base sm:text-sm/6 outline-1 -outline-offset-1 outline-base-content/10"
						_="on keydown[key is 'Escape'] add .hidden"
					></el-command-list>
				</el-command-palette>
			</div>
			// User settings menu.
			<div class="flex items-center justify-end mx-2 sm:mr-4">
				<div aria-hidden="true" class="hidden lg:block lg:h-6 lg:w-px lg:bg-base-content/10"></div>
				{{ user, _ := models.UserFromCtx(ctx) }}
				if user != nil {
					<el-dropdown id="header-user-menu" class="relative">
						<button id="header-menu-button" class="btn btn-ghost btn-square hover:text-primary">
							<span class="sr-only">Open settings menu</span>
							<img src={ "/img-proxy/32x32/" + user.GetAvatar() } alt={ "Avatar for user " + user.GetNickname() } width="32" height="32" class="size-8 rounded-full outline -outline-offset-1 outline-base-content/10"/>
						</button>
						<el-menu id="header-menu" anchor="bottom end" popover class="context-menu-base">
							// Open settings menu.
							<a
								hx-get="/user/settings"
								hx-target={ ContentID.Target() }
								hx-push-url="true"
								_="on click remove @open from #header-menu"
							>
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.SettingsFilled(i.Props{Class: "size-4"})
									Settings
								</div>
							</a>
							// Report issue.
							<a
								hx-get={ "/issue" }
								hx-target={ ContentID.Target() }
								class="link link-hover"
							>
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.FlagFilled(i.Props{Class: "size-4"})
									Report an issue
								</div>
							</a>
							// Logout
							<a href="/logout">
								<div class="flex flex-1 items-center gap-x-2">
									@tabler.Logout(i.Props{Class: "size-4"})
									Log out
								</div>
							</a>
						</el-menu>
					</el-dropdown>
				}
			</div>
		</div>
		// Advanced search dialog.
		<el-dialog>
			<dialog id="search-filters-dialog" class="mt-16 mb-auto mx-auto p-4 sm:p-6 w-full sm:max-w-3xl sm:h-fit overflow-y-auto bg-base-300 rounded-box shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
				<el-dialog-panel>
					// or focusout from body
					@SearchFilters(nil)
				</el-dialog-panel>
			</dialog>
		</el-dialog>
	</header>
}
