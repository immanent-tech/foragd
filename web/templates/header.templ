package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ header(user *models.User) {
	<header
		aria-label="Header"
		class="fixed w-full top-0 z-50 flex h-16 items-center bg-base-200 border-b border-base-content/30"
	>
		<a href="/home" class="link link-hover">
			<div class="flex flex-row shrink-0 p-2 items-center">
				<img src="/content/favicon.svg" class="flex size-8" alt="Foragd Logo"/>
				<p class="font-bold text-primary hidden lg:flex">Foragd</p>
			</div>
		</a>
		if user != nil {
			// Global search bar.
			<div class="flex flex-1 justify-center">
				<el-command-palette class="grid w-full sm:max-w-3xl">
					<search>
						<label
							for="global-search"
							class="w-full sm:max-w-3xl input input-primary text-base sm:text-sm/6 placeholder:text-base-content/80 bg-base-content/10"
						>
							@tabler.Search(i.Props{Class: "pointer-events-none flex-none text-primary"})
							<input
								hx-post="/search/suggestions"
								hx-target="#global-search-suggestions"
								hx-include="#search-filters,[id='timezone']"
								hx-trigger="keyup changed delay:300ms"
								id="global-search"
								type="search"
								name="text"
								placeholder="Search..."
								spellcheck="false"
								autocomplete="off"
								_="
								on keydown from body if the event's key is 'k' and event.altKey then focus() me end
								"
							/>
							// on change if my value is '' add .hidden to #clear-search-text else remove .hidden from #clear-search-text end
							// Clear text.
							<button
								id="clear-search-text"
								type="button"
								tabindex="0"
								_="on click set #global-search.value to '' then add @hidden to #global-search-suggestions"
							>
								@tabler.CircleX(i.Props{Class: "flex-none text-primary"})
							</button>
							// Filters button opens advanced search dialog.
							<button
								type="button"
								command="show-modal"
								commandfor="search-filters-dialog"
								tabindex="0"
							>
								@tabler.Filter(i.Props{Class: "flex-none text-primary"})
							</button>
						</label>
					</search>
					<el-command-list
						id="global-search-suggestions"
						class="absolute left-0 sm:fixed sm:left-auto top-16 mt-2 w-full sm:max-w-3xl max-h-128 sm:max-h-196 sm:h-fit scroll-py-2 overflow-y-auto p-2 rounded-md shadow-lg bg-base-300 text-base sm:text-sm/6 outline-1 -outline-offset-1 outline-base-content/10"
						_="on keydown[key is 'Escape'] add .hidden"
					></el-command-list>
				</el-command-palette>
				// Advanced search dialog.
				<el-dialog
					_="
					on open add @disabled to #global-search end
					on close remove @disabled from #global-search end
					"
				>
					<dialog id="search-filters-dialog" class="mt-16 mb-auto mx-auto p-4 sm:p-6 w-full sm:max-w-3xl max-h-9/10 overflow-y-auto bg-base-300 rounded-box shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
						<el-dialog-panel>
							@SearchFilters(models.NewSearchRequest(), nil)
						</el-dialog-panel>
					</dialog>
				</el-dialog>
			</div>
			// User settings menu.
			<div class="flex items-center justify-end mx-2 sm:mr-4 space-x-2">
				<div aria-hidden="true" class="hidden lg:block lg:h-6 lg:w-px lg:bg-base-content/10"></div>
				<el-dropdown id="header-user-menu" class="relative">
					<button class="btn-ghost btn-square">
						<span class="sr-only">Open settings menu</span>
						@UserAvatar(user, nil)
					</button>
					<el-menu id="header-menu" anchor="bottom end" popover>
						// Open settings menu.
						<a
							hx-get="/user/settings"
							hx-target={ ContentID.Target() }
							_="on click remove @open from #header-menu"
							class="link link-hover hover:text-primary"
						>
							<div class="flex flex-1 items-center gap-x-2">
								@tabler.SettingsFilled()
								Settings
							</div>
						</a>
						// Help documentation.
						<a
							href="/help"
							rel="noopener"
							target="_blank"
							class="link link-hover hover:text-primary"
							_="on click remove @open from #header-menu"
						>
							<div class="flex flex-1 items-center gap-x-2">
								@tabler.Help()
								Help/Documentation
							</div>
						</a>
						// Report issue.
						<a
							hx-get="/issue"
							hx-target={ ContentID.Target() }
							hx-replace-url="true"
							class="link link-hover hover:text-primary"
							_="on click remove @open from #header-menu"
						>
							<div class="flex flex-1 items-center gap-x-2">
								@tabler.FlagFilled()
								Report an issue
							</div>
						</a>
						// Logout
						<a
							href="/logout"
							class="link link-hover hover:text-primary"
							_="on click remove @open from #header-menu then call window.sessionStorage.removeItem('htmx-history-cache')"
						>
							<div class="flex flex-1 items-center gap-x-2">
								@tabler.Logout()
								Log out
							</div>
						</a>
					</el-menu>
				</el-dropdown>
			</div>
		}
		//  else {
		// 	<div class="flex flex-1"></div>
		// 	<div class="flex items-center justify-end mx-2 sm:mr-4">
		// 		@NewLink(
		// 			WithAttribute("href", "/login"),
		// 			WithAttribute("role", "button"),
		// 			WithClasses("btn", "btn-primary", "link-hover"),
		// 		) {
		// 			Log in
		// 		}
		// 	</div>
		// }
	</header>
}
