package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ header(user *models.User) {
	<header
		aria-label="Header"
		class="fixed w-full top-0 z-50 flex h-16 items-center bg-base-200 border-b border-base-content/30"
	>
		switch user {
			case nil:
				<nav aria-label="Global" class="flex items-center justify-between p-6 lg:px-8 w-full">
					<div class="flex lg:flex-1">
						<a href="/" class="link link-hover">
							<div class="flex items-center">
								<img src="/content/favicon.svg" class="flex size-8" alt="Foragd Logo"/>
								<p class="font-bold text-primary hidden lg:flex">Foragd</p>
							</div>
						</a>
					</div>
					<div class="flex lg:hidden">
						<button type="button" command="show-modal" commandfor="mobile-menu" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5">
							<span class="sr-only">Open main menu</span>
							@tabler.Menu2(i.Props{Class: "text-primary"})
						</button>
					</div>
					<div class="hidden lg:flex lg:gap-x-12">
						<a href="/about" class="link link-hover text-sm/6 font-semibold text-primary">About</a>
						<a href="/#features" class="link link-hover text-sm/6 font-semibold text-primary">Features</a>
						<a href="/#pricing" class="link link-hover text-sm/6 font-semibold text-primary">Pricing</a>
						<a href="/viewer" class="link link-hover text-sm/6 font-semibold text-primary">Feed Viewer</a>
					</div>
					<div class="hidden lg:flex lg:flex-1 lg:justify-end">
						<a href="/login" class="link link-hover text-sm/6 font-semibold text-primary">Log in <span aria-hidden="true">&rarr;</span></a>
					</div>
				</nav>
				<el-dialog>
					<dialog id="mobile-menu" class="backdrop:bg-transparent lg:hidden">
						<div tabindex="0" class="fixed inset-0 focus:outline-none">
							<el-dialog-panel class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-base-300 p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
								<div class="flex items-center justify-between">
									<a href="#" class="-m-1.5 p-1.5">
										<div class="flex items-center">
											<img src="/content/favicon.svg" class="flex size-8" alt="Foragd Logo"/>
											<p class="font-bold text-primary hidden lg:flex">Foragd</p>
										</div>
									</a>
									<button type="button" command="close" commandfor="mobile-menu" class="-m-2.5 rounded-md p-2.5 text-neutral">
										<span class="sr-only">Close menu</span>
										@tabler.X()
									</button>
								</div>
								<div class="mt-6 flow-root">
									<div class="-my-6 divide-y divide-neutral">
										<div class="space-y-2 py-6">
											<a href="/about" class="link link-hover -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-primary">About</a>
											<a href="/#features" class="link link-hover -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-primary">Features</a>
											<a href="/#pricing" class="link link-hover -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-primary">Pricing</a>
											<a href="/viewer" class="link link-hover -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-primary">Feed Viewer</a>
										</div>
										<div class="py-6">
											<a href="/login" class="link link-hover -mx-3 block rounded-lg px-3 py-2.5 text-base/7 font-semibold text-neutral">Log in</a>
										</div>
									</div>
								</div>
							</el-dialog-panel>
						</div>
					</dialog>
				</el-dialog>
			default:
				<a
					hx-get="/home"
					hx-target={ ContentID.Target() }
					hx-swap="innerHTML show:window:top transition:true"
					class="link link-hover"
				>
					<div class="flex flex-row shrink-0 p-2 items-center">
						<img src="/content/favicon.svg" class="flex size-8" alt="Foragd Logo"/>
						<p class="font-bold text-primary hidden lg:flex">Foragd</p>
					</div>
				</a>
				// Global search bar.
				<div class="flex flex-1 justify-center">
					@searchBox()
					// @searchCommands()
					// Advanced search dialog.
					// <el-dialog
					// 	_="
					// on open add @disabled to #global-search end
					// on close remove @disabled from #global-search end
					// "
					// >
					// 	<dialog id="search-filters-dialog" class="mt-16 mb-auto mx-auto p-4 sm:p-6 w-full sm:max-w-3xl max-h-9/10 overflow-y-auto bg-base-300 rounded-box shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
					// 		<el-dialog-panel>
					// 			@SearchFilters(models.NewSearchRequest(), nil)
					// 		</el-dialog-panel>
					// 	</dialog>
					// </el-dialog>
				</div>
				// User settings menu.
				<div class="flex items-center justify-end mx-2 sm:mr-4 space-x-2">
					<div aria-hidden="true" class="hidden lg:block lg:h-6 lg:w-px lg:bg-base-content/10"></div>
					<el-dropdown id="header-user-menu" class="relative">
						<button class="btn-ghost btn-square">
							<span class="sr-only">Open settings menu</span>
							@UserAvatar(user, nil)
						</button>
						<el-menu id="header-menu" anchor="bottom end" popover>
							<ul class="menu">
								<li>
									// Open settings menu.
									<a
										hx-get="/user/settings"
										hx-target={ ContentID.Target() }
										_="on click remove @open from #header-menu"
										role="menuitem"
										tabindex="-1"
									>
										<div class="flex flex-1 items-center gap-x-2">
											@tabler.SettingsFilled()
											Settings
										</div>
									</a>
								</li>
								<li>
									// Help documentation.
									<a
										href="/help"
										rel="noopener"
										target="_blank"
										role="menuitem"
										tabindex="-1"
										_="on click remove @open from #header-menu"
									>
										<div class="flex flex-1 items-center gap-x-2">
											@tabler.Help()
											Help/Documentation
										</div>
									</a>
								</li>
								// Report issue.
								<li>
									<a
										hx-get="/issue"
										hx-target={ ContentID.Target() }
										hx-replace-url="true"
										role="menuitem"
										tabindex="-1"
										_="on click remove @open from #header-menu"
									>
										<div class="flex flex-1 items-center gap-x-2">
											@tabler.FlagFilled()
											Report an issue
										</div>
									</a>
								</li>
								// Logout
								<li>
									<a
										href="/logout"
										role="menuitem"
										tabindex="-1"
										_="on click remove @open from #header-menu then call window.sessionStorage.removeItem('htmx-history-cache')"
									>
										<div class="flex flex-1 items-center gap-x-2">
											@tabler.Logout()
											Log out
										</div>
									</a>
								</li>
							</ul>
						</el-menu>
					</el-dropdown>
				</div>
		}
		//  else {
		// 	<div class="flex flex-1"></div>
		// 	<div class="flex items-center justify-end mx-2 sm:mr-4">
		// 		@NewLink(
		// 			WithAttribute("href", "/login"),
		// 			WithAttribute("role", "button"),
		// 			WithClasses("btn", "btn-primary", "link-hover"),
		// 		) {
		// 			Log in
		// 		}
		// 	</div>
		// }
	</header>
}
