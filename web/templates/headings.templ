package templates

templ PageHeading(heading string) {
	<h1 class="font-display text-2xl font-bold tracking-tight text-balance sm:text-3xl">{ heading }</h1>
}

templ SectionLabel(label string) {
	<p class="section-label">{ label }</p>
}
