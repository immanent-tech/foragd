package templates

import "github.com/sebasvil20/templicons/tabler"

// btnBackToTop adds a "back to top" button that is only shown when the user has scrolled down the page.
templ btnBackToTop() {
	<button
		class="btn btn-circle btn-secondary hidden fixed bottom-20 right-5 lg:bottom-10 sm:right-10"
		_="
		on scroll from window queue last
  			if the window's pageYOffset is greater than 20
    			remove .hidden
  			otherwise
    			add .hidden
		end
		on click go to the top of the body smoothly
		"
	>
		@tabler.ArrowUp()
	</button>
}
