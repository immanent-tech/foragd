package templates

templ NotFound() {
	@NewPage("Go Feed Me - Not Found") {
		<div class="hero bg-base-200 min-h-screen">
			<div class="hero-content text-center">
				<div class="max-w-md">
					<h1 class="text-5xl font-bold">Welp, I give up.</h1>
					<p class="py-6">
						There does not seem to be anything to show you.
					</p>
					// @partials.NewAction("/home", partials.DisplayActionAsButton,
					// 	partials.ActionButtonOptions(
					// 		button.WithClasses(button.Primary),
					// 	),
					// ) {
					// 	Take me home
					// }
				</div>
			</div>
		</div>
	}
}
