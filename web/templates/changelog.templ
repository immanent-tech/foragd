package templates

import "github.com/dimmerz92/go-icons/tabler-outline"

// ChangeType represents the type of change in a release
type ChangeType string

const (
	ChangeTypeNew      ChangeType = "new"
	ChangeTypeImproved ChangeType = "improved"
	ChangeTypeFixed    ChangeType = "fixed"
	ChangeTypeRemoved  ChangeType = "removed"
	ChangeTypeSecurity ChangeType = "security"
)

// VersionType represents semver release tier
type VersionType string

const (
	VersionMajor VersionType = "major"
	VersionMinor VersionType = "minor"
	VersionPatch VersionType = "patch"
)

// ChangeEntry is a single change within a release
type ChangeEntry struct {
	Type        ChangeType `toml:"type"`
	Description string     `toml:"description"`
}

// Release represents a single versioned release
type Release struct {
	Version  string        `toml:"version"`
	Date     string        `toml:"date"`
	Type     VersionType   `toml:"type"`
	IsLatest bool          `toml:"is_latest"`
	Changes  []ChangeEntry `toml:"changes"`
}

// changeTagClasses returns badge classes for a change type
func changeTagClasses(t ChangeType) string {
	switch t {
	case ChangeTypeNew:
		return "badge badge-success badge-sm"
	case ChangeTypeImproved:
		return "badge badge-info badge-sm"
	case ChangeTypeFixed:
		return "badge badge-warning badge-sm"
	case ChangeTypeRemoved:
		return "badge badge-error badge-sm"
	case ChangeTypeSecurity:
		return "badge badge-secondary badge-sm"
	default:
		return "badge badge-ghost badge-sm"
	}
}

// changeTagLabel returns a display label for a change type
func changeTagLabel(t ChangeType) string {
	switch t {
	case ChangeTypeNew:
		return "New"
	case ChangeTypeImproved:
		return "Improved"
	case ChangeTypeFixed:
		return "Fixed"
	case ChangeTypeRemoved:
		return "Removed"
	case ChangeTypeSecurity:
		return "Security"
	default:
		return string(t)
	}
}

// versionBadgeClasses returns badge classes for a version type
func versionBadgeClasses(t VersionType) string {
	switch t {
	case VersionMajor:
		return "badge badge-primary badge-outline badge-sm"
	case VersionMinor:
		return "badge badge-accent badge-outline badge-sm"
	case VersionPatch:
		return "badge badge-ghost badge-sm"
	default:
		return "badge badge-ghost badge-sm"
	}
}

// versionBadgeLabel returns a display label for a version type
func versionBadgeLabel(t VersionType) string {
	switch t {
	case VersionMajor:
		return "Major"
	case VersionMinor:
		return "Minor"
	case VersionPatch:
		return "Patch"
	default:
		return string(t)
	}
}

// ChangelogPage renders a full changelog page
templ ChangelogPage(releases []Release) {
	@templ.Fragment(ContentFragment) {
		@narrowContainer() {
			// Header
			<div class="mb-8">
				<h1 id="page-title" class="mt-4 mb-2 scroll-mt-16 font-display text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Changelog</h1>
				<p class="text-sm text-base-content/60">
					Foragd updates and improvements — shipped often.
				</p>
			</div>
			// Subscribe.
			<div class="mb-8 alert border border-neutral/20 bg-base-200 py-3">
				@tableroutline.Rss(templ.Attributes{"class": "size-5 shrink-0 text-base-content/50", "aria-hidden": "true"})
				<span class="flex-1 text-sm text-base-content/70">Get notified when we ship something new.</span>
				<a href="/changelog/feed" class="link text-sm font-medium link-primary">Subscribe to updates</a>
			</div>
			// Timeline.
			<ul class="timeline timeline-vertical timeline-compact">
				for i, release := range releases {
					<li>
						@releaseItem(release, i == len(releases)-1)
					</li>
				}
			</ul>
		}
	}
}

// releaseItem renders a single release in the timeline
templ releaseItem(r Release, isLast bool) {
	if !isLast {
		<hr class="bg-base-300"/>
	}
	// Timeline middle dot.
	<div class="timeline-middle">
		if r.IsLatest {
			<div class="h-3 w-3 rounded-full bg-success ring-2 ring-success/30"></div>
		} else {
			<div class="h-3 w-3 rounded-full bg-base-300 ring-2 ring-base-200"></div>
		}
	</div>
	// Release details.
	<div class="timeline-end mb-6 ml-2 w-full timeline-box border border-neutral/20 bg-base-100 shadow-none">
		// Header.
		<div class="mb-4 flex flex-wrap items-center gap-2">
			<span id={ r.Version } class="text-base font-semibold text-base-content">{ r.Version }</span>
			<span class="text-xs text-base-content/50">{ r.Date }</span>
			<span class={ versionBadgeClasses(r.Type) }>{ versionBadgeLabel(r.Type) }</span>
			if r.IsLatest {
				<span class="badge badge-sm badge-success">Latest</span>
			}
		</div>
		// Changes.
		<ul class="space-y-2">
			for _, change := range r.Changes {
				<li class="flex items-start gap-2 text-sm leading-relaxed">
					<span class={ changeTagClasses(change.Type) + " mt-0.5 shrink-0" }>
						{ changeTagLabel(change.Type) }
					</span>
					<span class="text-base-content/80">
						@templ.Raw(change.Description)
					</span>
				</li>
			}
		</ul>
	</div>
	if isLast {
		<hr class="bg-base-300"/>
	}
}
