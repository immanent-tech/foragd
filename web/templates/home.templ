package templates

import (
	tableroutline "github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"net/http"
	"slices"
	"strconv"
	"time"
)

type HomeData struct {
	LatestArticles models.Articles
	RareCategories models.CategoryCounts
	Subscriptions  models.Subscriptions
	TopCategories  models.CategoryCounts
}

// UserHome is the default user home page.
templ UserHome(data *HomeData) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				if len(data.LatestArticles) == 0 {
					// User has no unread content, show a message and link to favorites.
					@partials.NoContent()
				} else {
					// Home Header.
					@pageHeading() {
						@pageTitle("Your Feed") {
							<p class="mt-0.5 text-sm text-base-content/50">{ time.Now().Format("Mon, 02 Jan 2006") }</p>
						}
					}
					<div class="grid grid-cols-1 items-start gap-6 px-2 sm:grid-cols-3 sm:gap-8 pt-4">
						// Left Column.
						<div class="space-y-8 sm:col-span-2">
							// Section: Latest Articles.
							<section aria-labelledby="section-latest-articles">
								@sectionHeading() {
									@sectionTitle("Latest Articles")
									@sectionActions() {
										<a
											hx-get="/list/articles"
											hx-target="#content"
											hx-swap="innerHTML scroll:#content:top transition:true"
											class="link text-sm text-primary link-hover"
										>See all <span aria-hidden="true">-></span></a>
									}
								}
								@masonryGrid()
								<div class="grid grid-cols-1 items-start gap-2 pt-12 sm:grid-cols-2 masonry-grid relative" _="install MasonryGrid">
									for idx, article := range data.LatestArticles {
										@ArticleCard(idx, article)
									}
								</div>
							</section>
						</div>
						// Right Column.
						<aside class="space-y-5">
							// List: Latest Updated Subscriptions.
							<div class="overflow-hidden rounded-box border border-base-content/8 bg-base-200">
								@sectionHeading(element.WithClasses("pt-2 px-4")) {
									@sectionTitle("Latest Updated Feeds")
									@sectionActions() {
										<a class="link text-xs text-primary link-hover" hx-get="/list/subscriptions" hx-target={ ContentID.Target() }>All</a>
									}
								}
								<ul role="list" class="scrollbar-thin divide-y divide-neutral/15 overflow-y-auto">
									for idx, subscription := range data.Subscriptions {
										{{ s := &Subscription{Subscription: subscription} }}
										<li
											class="group hover:hover-shadow flex animate-fadeinup cursor-pointer touch-manipulation flex-col px-4 py-4 will-change-[opacity,transform]"
											style={ "--i: " + strconv.Itoa(idx) }
											id={ subscription.GetID() }
											{ s.viewAttributes()... }
										>
											<div class="flex flex-1">
												<div class="ease-[cubic-bezier(0.2, 0, 0, 1)] mr-4 shrink-0 self-center transition-transform duration-400 group-hover:scale-[1.05]">
													if subscription.GetImage() == "" {
														@subscriptionThumbnail(nil, subscription.GetTitle())
													} else {
														@subscriptionThumbnail(models.NewRemoteImage(subscription.GetImage(), subscription.GetTitle()), subscription.GetTitle())
													}
												</div>
												<h2 class="font-xl flex-1 font-serif text-lg font-bold text-balance">{ subscription.GetTitle() }</h2>
											</div>
											<span class="mt-1 self-end text-right badge badge-neutral badge-soft">
												<relative-time
													datetime={ subscription.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
													format="relative"
													class="tabular-nums"
												>
													{ subscription.GetUpdatedDate().Format("Jan _2, 2006") }
												</relative-time>
											</span>
										</li>
									}
								</ul>
								// Quick Add Feed Action.
								<div class="border-t border-base-content/6 px-4 py-3">
									<button
										class="btn flex w-full items-center justify-center gap-1.5 text-base-content/50 btn-ghost btn-xs"
										aria-label="Add a new feed"
										hx-get="/subscription/add/feed"
										hx-target={ ContentID.Target() }
										hx-push-url="true"
									>
										@tableroutline.Plus(templ.Attributes{"class": "size-4", "aria-hidden": "true"})
										<span>Add a feed</span>
									</button>
								</div>
							</div>
							// List: Top Categories.
							if len(data.TopCategories) > 0 {
								<div class="rounded-box border border-base-content/8 bg-base-200">
									@sectionHeading(element.WithClasses("pt-2 px-4")) {
										@sectionTitle("Top Categories")
									}
									<div class="flex flex-wrap gap-1.5 p-4">
										for category := range slices.Values(data.TopCategories) {
											{{
												filters := models.NewListDisplayFilters()
												filters.Categories = append(filters.Categories, category.Category)
											}}
											@CategoryBadge(category.Category,
												element.WithHXMethod(http.MethodGet, "/list/articles"),
												element.WithHXTarget(ContentID.Target()),
												element.WithHXValues(filters.Values()),
												element.WithAttribute("_", "on click halt the event's bubbling"),
											)
										}
									</div>
								</div>
							}
						</aside>
					</div>
				}
				@buttonBackToTop()
			}
			// Updates Toast.
			{{ filters := new(models.NewListDisplayFilters()) }}
			<div
				id="updates"
				class="toast toast-center z-10"
				hx-post="/list/articles/updates"
				hx-vals={ templ.JSONString(filters.Values()) }
				hx-trigger="every 5m"
				hx-target="#updates"
			></div>
		}
	}
}

// NewUserHome is a home page displayed for new users, with some instructions and actions to help them set up the app.
templ NewUserHome() {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container() {
				<div class="mt-16 animate-fadeinup transition-transform duration-300 ease-in-out" style="--i: 0">
					<p class="text-base text-balance text-accent uppercase">Welcome to Foragd</p>
					<h1 class="my-4 text-2xl/7 font-bold tracking-tight text-balance sm:text-3xl">Your feed reader,<br/>your way.</h1>
					<p>No algorithms. No ads. Follow any website, blog, or newsletter. Everything in one fully searchable place. Let's get you set up.</p>
				</div>
				<div class="mt-12 animate-fadeinup transition-transform duration-300 ease-in-out" style="--i: 1">
					@sectionHeading() {
						@sectionTitle("Add subscriptions")
					}
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 pt-4">
						<a
							class="card-body rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/subscription/add"
							hx-target={ ContentID.Target() }
							hx-swap="innerHTML scroll:#content:top transition:true"
							hx-push-url="true"
						>
							@tableroutline.Plus(templ.Attributes{"class": "rounded-selector bg-secondary p-1 text-secondary-content", "aria-hidden": "true"})
							<div>
								<div class="card-title text-secondary">Add a feed</div>
								<p class="text-base/7 text-secondary">Paste any URL or webpage and Foragd will find the RSS feed automatically.</p>
							</div>
							<div class="card-actions justify-end text-accent">Get started <span aria-hidden="true">-></span></div>
						</a>
						<a
							class="card-body rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/user/import"
							hx-target={ ContentID.Target() }
							hx-swap="innerHTML scroll:#content:top transition:true"
							hx-push-url="true"
						>
							@tableroutline.CloudDownload(templ.Attributes{"class": "rounded-selector bg-secondary p-1 text-secondary-content", "aria-hidden": "true"})
							<div>
								<div class="card-title text-secondary">Import from OPML</div>
								<p class="text-base/7 text-secondary">Moving from Feedly, Inoreader, or another reader? Import all your feeds at once.</p>
							</div>
							<div class="card-actions justify-end text-accent">Upload OPML file <span aria-hidden="true">-></span></div>
						</a>
					</div>
				</div>
				<div class="mt-12 animate-fadeinup transition-transform duration-300 ease-in-out" style="--i: 2">
					@sectionHeading() {
						@sectionTitle("Or start with a curated set")
					}
					<form>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-3 pt-4">
							<div
								class="card-body rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
								_="on click toggle @checked on <input/> in me"
							>
								<div class="flex flex-row items-center gap-x-3">
									<input
										id="informed"
										type="checkbox"
										name="feedset"
										value="informed"
										class="checkbox checkbox-sm checkbox-primary"
									/>
									@tableroutline.News(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
									<label class="card-title text-secondary" for="informed">Informed</label>
								</div>
								<p class="text-sm/6">News and information from across the web.</p>
							</div>
							<div
								class="card-body rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
								_="on click toggle @checked on <input/> in me"
							>
								<div class="flex flex-row items-center gap-x-3">
									<input
										id="inspired"
										type="checkbox"
										name="feedset"
										value="inspired"
										class="checkbox checkbox-sm checkbox-primary"
									/>
									@tableroutline.Palette(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
									<label class="card-title text-secondary" for="inspired">Inspired</label>
								</div>
								<p class="text-sm/6">Digital art, design and creative oddities.</p>
							</div>
							<div
								class="card-body rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
								_="on click toggle @checked on <input/> in me"
							>
								<div class="flex flex-row items-center gap-x-3">
									<input
										id="enlightened"
										type="checkbox"
										name="feedset"
										value="enlightened"
										class="checkbox checkbox-sm checkbox-primary"
									/>
									@tableroutline.Atom(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
									<label class="card-title text-secondary" for="enlightened">Enlightened</label>
								</div>
								<p class="text-sm/6">Alternative and fringe perspectives.</p>
							</div>
						</div>
						<div class="mt-4 animate-fadeinup transition-transform duration-300 ease-in-out" style="--i: 2">
							<button
								hx-post="/user/feedset"
								hx-swap="none"
								type="submit"
								class="btn btn-primary"
								class="btn btn-outline"
								id="add-sets-btn"
							>
								<span class="show-loading items-center">
									<span class="loading mr-3 loading-spinner"></span>
									Processing
								</span>
								<span class="hide-loading">
									<div class="flex flex-row items-center gap-x-3">
										@tableroutline.CirclePlus(templ.Attributes{"aria-hidden": "true"})
										<span class="text-sm/6">Add Sets</span>
									</div>
								</span>
							</button>
						</div>
					</form>
				</div>
				<div class="mt-12 animate-fadeinup transition-transform duration-300 ease-in-out" style="--i: 3">
					@sectionHeading() {
						@sectionTitle("Learn more")
					}
					<ul role="list" class="divide-y divide-accent">
						<li class="px-4 py-4 sm:px-0">
							<a class="link link-hover" href="/docs">Documentation Home</a>
						</li>
						<li class="px-4 py-4 sm:px-0">
							<a class="link link-hover" href="/blog">Blog</a>
						</li>
						<li class="px-4 py-4 sm:px-0">
							<a class="link link-hover" href="/changelog">Changelog</a>
						</li>
					</ul>
				</div>
			}
		}
	}
}
