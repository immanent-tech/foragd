package templates

import (
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"strconv"
)

// UserHome is the default user home page.
templ UserHome(data *models.HomeResponse) {
	@content() {
		@templ.Fragment(ContentFragment) {
			if len(data.LatestArticles) == 0 {
				@container() {
					@partials.Heading1() {
						Home
					}
					// User has no unread content, show a message and link to favorites.
					<div class="text-center">
						@tabler.Confetti(i.Props{Class: "mx-auto text-accent size-12"})
						@partials.Heading1() {
							All caught up!
						}
						@partials.Paragraph() {
							Congratulations, you've read everything!
						}
						<div class="mt-6">
							<button
								hx-get="/list/favorites"
								hx-target={ ContentID.Target() }
								hx-swap="innerHTML show:window:top transition:true"
								class="btn btn-accent"
							>
								View favorites
							</button>
						</div>
					</div>
				}
			} else {
				@container() {
					@partials.Heading1() {
						Home
					}
					<div class="relative mx-auto justify-between">
						// Show some useful sections for unread content.
						// <div
						// 	id="update-notifications"
						// 	sse-connect="/home/updates"
						// 	sse-swap="updates"
						// 	class="toast toast-center z-50"
						// ></div>
						if len(data.LatestArticles) > 0 {
							<div class="flex mb-4 sm:pr-128">
								@partials.Heading2() {
									Latest Articles
								}
							</div>
							// Grid of latest articles on large displays.
							<div class="hidden sm:grid grid-cols-1 place-items-center gap-4 sm:grid-cols-2 sm:gap-8 sm:pr-128">
								for article := range slices.Values(data.LatestArticles) {
									@NewArticleView(article).Card()
								}
							</div>
							// Carousel of latest articles on small displays.
							<div class="sm:hidden w-full">
								<div class="carousel w-full">
									for idx, article := range data.LatestArticles {
										<div id={ "article" + strconv.Itoa(idx+1) } class="carousel-item relative w-full">
											@NewArticleView(article).Card()
											<div class="absolute left-2 right-2 top-1/2 flex -translate-y-1/2 transform justify-between">
												if idx == 0 {
													<a href={ "#article" + strconv.Itoa(len(data.LatestArticles)) } class="btn btn-sm btn-circle btn-primary btn-outline opacity-50">❮</a>
												} else {
													<a href={ "#article" + strconv.Itoa(idx) } class="btn btn-sm btn-circle btn-primary btn-outline opacity-50">❮</a>
												}
												if idx == len(data.LatestArticles)-1 {
													<a href="#article1" class="btn btn-sm btn-circle btn-primary btn-outline opacity-50">❯</a>
												} else {
													<a href={ "#article" + strconv.Itoa(idx+2) } class="btn btn-sm btn-circle btn-primary btn-outline opacity-50">❯</a>
												}
											</div>
										</div>
									}
								</div>
							</div>
						}
						<aside class="sm:absolute sm:inset-y-0 sm:right-0 sm:w-lg sm:overflow-y-auto sm:block">
							if len(data.Subscriptions) > 0 {
								<div class="flex mb-4 px-4 sm:px-6 lg:px-8">
									@partials.Heading2() {
										Last Updated Subscriptions
									}
								</div>
								<div class="grid grid-cols-1 grid-flow-row gap-y-4 px-4 py-6 sm:px-6 lg:px-8">
									for idx, subscription := range data.Subscriptions {
										if idx >= 6 {
											{{ break }}
										}
										<div
											class="card mx-auto h-full w-full max-w-prose bg-base-200 shadow-md card-sm cursor-pointer"
											{ NewSubscriptionView(subscription).ViewArticlesAttributes()... }
										>
											<div class="card-body">
												<div class="card-title flex items-center">
													<div class="mr-4 shrink-0 self-center">
														if subscription.GetImage() == "" {
															@subscriptionThumbnail(nil, subscription.GetTitle())
														} else {
															@subscriptionThumbnail(
																&models.RemoteImage{
																	URL:   new(subscription.GetImage()),
																	Title: new(subscription.GetTitle()),
																},
																subscription.GetTitle(),
															)
														}
													</div>
													<div class="text-pretty line-clamp-3 tracking-tight">{ subscription.GetTitle() }</div>
												</div>
												<div class="card-actions mt-auto items-center">
													// Timestamp.
													<div class="flex flex-1 gap-x-2">
														<span class="label text-xs/4 capitalize">
															Updated&nbsp;
															<relative-time
																datetime={ subscription.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
																format="relative"
															>
																{ subscription.GetUpdatedDate().Format("ANSIC") }
															</relative-time>
														</span>
													</div>
													if models.UserFromCtx(ctx).GetSettings().ShowSubscriptionStats {
														<div class="flex flex-none gap-x-2">
															<span class="label text-xs/4">
																{ subscription.GetStats().UnreadTotal() }
																Unread
															</span>
														</div>
													}
												</div>
											</div>
										</div>
									}
								</div>
							}
							if len(data.TopCategories) > 0 {
								<div class="flex my-4 px-4 sm:px-6 lg:px-8">
									@partials.Heading2() {
										Top Categories
									}
								</div>
								<div class="flex justify-center gap-2 p-2 m-2">
									<div id="top-categories" class="flex flex-row flex-wrap place-content-center p-2 gap-2">
										for category := range data.TopCategories {
											{{ params := models.NewListDisplayFilters() }}
											{{ params.Categories = append(params.Categories, category.Category) }}
											<a
												hx-get="/list/articles"
												hx-target={ ContentID.Target() }
												hx-vals={ templ.JSONString(params) }
												class="link link-hover"
											>
												<span class="badge badge-secondary badge-lg line-clamp-1">
													{ category.Category }
												</span>
											</a>
										}
									</div>
								</div>
							}
						</aside>
					</div>
				}
			}
		}
	}
}

// NewUserHome is a home page displayed for new users, with some instructions and actions to help them set up the app.
templ NewUserHome() {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				@partials.Heading1() {
					{ "Welcome to " + config.AppName }
				}
				@partials.Paragraph() {
					This is your home page, where you can find all your subscriptions. At the moment its a little bare!
				}
				<p class="py-2"></p>
				<div class="py-4">
					@partials.Heading2() {
						Add/Import Subscriptions
					}
					@partials.Paragraph() {
						Import your subscriptions from an external service or start fresh.
					}
					<div class="relative flex items-center space-x-4 rounded-xl p-2 focus-within:outline-2 focus-within:outline-primary hover:bg-primary/50 hover:text-primary-content max-w-prose">
						<div class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-primary">
							@tabler.Plus(i.Props{Class: "size-6 text-secondary-content"})
						</div>
						<div>
							<h4 class="text-sm font-medium ">
								<a
									hx-get="/user/subscription/add/feed"
									hx-target={ ContentID.Target() }
									hx-swap="innerHTML show:window:top transition:true"
									hx-push-url="true"
									class="focus:outline-hidden"
								>
									<span aria-hidden="true" class="absolute inset-0"></span>
									<span>Add a feed subscription</span>
									<span aria-hidden="true">&rarr;</span>
								</a>
							</h4>
							<p class="mt-1 text-sm text-base-content">Add a single subscription from a URL or webpage.</p>
						</div>
					</div>
					<div class="relative flex items-center space-x-4 rounded-xl p-2 focus-within:outline-2 focus-within:outline-secondary hover:bg-secondary/50 hover:text-secondary-content max-w-prose">
						<div class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-secondary">
							@tabler.CloudDownload(i.Props{Class: "size-6 text-secondary-content"})
						</div>
						<div>
							<h4 class="text-sm font-medium">
								<a
									hx-get="/user/import"
									hx-target={ ContentID.Target() }
									hx-swap="innerHTML show:window:top transition:true"
									hx-push-url="true"
									class="focus:outline-hidden"
								>
									<span aria-hidden="true" class="absolute inset-0"></span>
									<span>Import subscriptions</span>
									<span aria-hidden="true">&rarr;</span>
								</a>
							</h4>
							<p class="mt-1 text-sm text-base-content">Import multiple subscriptions using an OPML file.</p>
						</div>
					</div>
				</div>
				<div class="py-4">
					@partials.Heading2() {
						Start With Curated Subscription Sets
					}
					@partials.Paragraph() {
						Or try one or more curated starter sets (you can also add these later in settings).
					}
					<form
						hx-post="/user/feedset"
						hx-swap="none"
						hx-indicator="#processing"
					>
						<fieldset>
							<div class="mt-6 space-y-6">
								<div class="flex gap-3">
									<div class="flex h-6 shrink-0 items-center">
										<div class="group grid size-4 grid-cols-1">
											<input id="informed" type="checkbox" name="feedset" value="informed" aria-describedby="informed-description" class="checkbox checkbox-sm checkbox-primary"/>
										</div>
									</div>
									<div class="text-sm/6">
										<label for="informed" class="font-medium">Informed</label>
										<p id="inspired-description" class="text-base-content/80">News and information sites.</p>
									</div>
								</div>
								<div class="flex gap-3">
									<div class="flex h-6 shrink-0 items-center">
										<div class="group grid size-4 grid-cols-1">
											<input id="inspired" type="checkbox" name="feedset" value="inspired" aria-describedby="inspired-description" class="checkbox checkbox-sm checkbox-primary"/>
										</div>
									</div>
									<div class="text-sm/6">
										<label for="inspired" class="font-medium">Inspired</label>
										<p id="inspired-description" class="text-base-content/80">Digital art and other oddities.</p>
									</div>
								</div>
								<div class="flex gap-3">
									<div class="flex h-6 shrink-0 items-center">
										<div class="group grid size-4 grid-cols-1">
											<input id="enlightened" type="checkbox" name="feedset" value="enlightened" aria-describedby="enlightened-description" class="checkbox checkbox-sm checkbox-primary"/>
										</div>
									</div>
									<div class="text-sm/6">
										<label for="enlightened" class="font-medium">Enlightened</label>
										<p id="enlightened-description" class="text-base-content/80">Alternative and fringe sites.</p>
									</div>
								</div>
							</div>
						</fieldset>
						<div class="mt-6 flex items-center justify-end gap-x-6 max-w-prose">
							<div id="processing" class="htmx-indicator">
								Processing...
								<span class="loading loading-spinner loading-md"></span>
							</div>
							<button type="submit" class="btn btn-primary">Add sets</button>
						</div>
					</form>
				</div>
				<div class="py-4">
					@partials.Heading2() {
						Get to know Foragd
					}
					@partials.Paragraph() {
						Read the documentation/help to get familiar with the app.
					}
					<ul class="list-disc list-inside">
						<li><a class="link" href="/help">Documentation Home</a></li>
					</ul>
				</div>
			}
		}
	}
}
