package templates

import (
	"fmt"
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"html"
)

// RemoveObjectModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ RemoveObjectModal(obj models.Object) {
	{{ id := "unsubscribe" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { obj.GetTitle() }?</p>
				</div>
			</div>
		</div>
		<div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
			<button
				type="button"
				hx-post={ "/remove/" + string(obj.Type()) + "/" + obj.GetID() }
				hx-target={ "#" + obj.GetID() }
				hx-swap="outerHTML"
				_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
				hx-include="[name='csrf_token']"
				class="inline-flex w-full justify-center rounded-md bg-error/80 px-3 py-2 text-sm font-semibold text-error-content shadow-xs hover:bg-error sm:ml-3 sm:w-auto"
			>Unsubscribe</button>
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="mt-3 inline-flex w-full justify-center rounded-md bg-primary/80 px-3 py-2 text-sm font-semibold text-primary-content shadow-xs ring-1 ring-base-content/10 ring-inset hover:bg-primary sm:mt-0 sm:w-auto"
			>Cancel</button>
		</div>
	}
}

// RemoveObjectModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ ShareObjectModal(obj models.Object) {
	{{ id := "share-" + obj.GetID() }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.Share(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Share</h3>
				<div class="mt-2">
					<p class="text-sm">{ obj.GetTitle() }</p>
				</div>
			</div>
		</div>
		<div class="grid grid-flow-row grid-cols-3 mt-5 items-center justify-center sm:mt-4 gap-y-2 gap-x-2">
			// @NewLink(
			// 	WithCustomAttribute("href", fmt.Sprintf("https://twitter.com/intent/tweet?text=%s&url%s", html.EscapeString(obj.GetTitle()), html.EscapeString(obj.GetLink()))),
			// 	WithClasses("btn", "col-span-1", "twitter-share-button"),
			// ) {
			// 	@tabler.Mail(i.Props{Class: "size-4"})
			// 	Email
			// }
			@NewLink(
				WithCustomAttribute("href", fmt.Sprintf("mailto:?subject=%q&body=%s&NewLine;&NewLine;%s", html.EscapeString(obj.GetTitle()), obj.GetDescription(), obj.GetLink())),
				WithClasses("btn", "col-span-1", "col-start-2"),
			) {
				@tabler.Mail(i.Props{Class: "size-4"})
				Email
			}
			<div class="join col-span-3">
				<div class="flex-1">
					<label class="input join-item w-full">
						<input type="text" value={ obj.GetLink() } readonly/>
					</label>
				</div>
				@NewButton(
					WithCustomAttribute("_",
						"on click set currentValue to (my innerHTML) then writeText('"+obj.GetLink()+"') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me",
					),
					WithClasses("join-item"),
				) {
					@tabler.Copy(i.Props{Class: "size-4"})
					Copy Link
				}
			</div>
		</div>
	}
}

func shareAPIDialog(obj models.Object) string {
	return fmt.Sprintf("navigator.share({title: %q, url: %q})", obj.GetTitle(), obj.GetLink())
}
