package partials

import (
	"github.com/joshuar/go-templ-daisyui/display/text"
	"time"
)

templ generateRelativeTimestamp() {
	<script>
		me().innerText = me().formatTimestamp()
	</script>
}

templ ShowTimestamp(timestamp time.Time) {
	// <relative-time
	// prefix="" tense="past"
	// datetime={ timestamp.Format("2006-01-02T15:04:05-0700") } data-tooltip-content={ timestamp.Format("Jan 2, 2006, 3:04 PM GMT-7") }
	// data-tooltip-interactive="true" title="">{ timestamp.Format("2006-01-02 15:04:05 -0700") }</relative-time>
	@text.Build(
		generateRelativeTimestamp(),
		text.WithSize(text.XS),
		text.AsItalicText(),
		text.WithWeight(text.Light),
		text.WithAttributes(templ.Attributes{
			"value": timestamp.Format("2006-01-02T15:04:05-0700"),
		}),
	).Show()
}
