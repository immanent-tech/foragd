package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"slices"
)

const (
	controlItemTextClasses = "text-sm text-gray-500"
)

// ListControls represents the controls (filtering/sorting options) for lists of objects.
type ListControls struct {
	Path       string
	Filters    models.Filters
	Categories models.CategoryCounts
}

// Template will display controls for sorting and filtering lists.
//
// Reference: https://tailwindcss.com/plus/ui-blocks/ecommerce/components/category-filters#component-cb75aacd7c636865835476c98f606a38
templ (c ListControls) Template() {
	<div>
		// Mobile filter dialog.
		<el-dialog>
			<dialog id="mobile-filters" class="overflow-hidden backdrop:bg-transparent sm:hidden">
				<el-dialog-backdrop class="fixed inset-0 bg-black/25 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>
				<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
					<el-dialog-panel class="relative ml-auto flex size-full max-w-xs transform flex-col overflow-y-auto bg-base-200 pt-4 pb-6 shadow-xl transition duration-300 ease-in-out data-closed:translate-x-full">
						<div class="flex items-center justify-between px-4">
							<h2 class="text-lg font-medium text-gray-900">Filters</h2>
							<button
								type="button"
								command="close"
								commandfor="mobile-filters"
								class="relative -mr-2 flex size-10 items-center justify-center rounded-md bg-base-200 p-2 text-gray-400 hover:bg-gray-50 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden"
							>
								<span class="absolute -inset-0.5"></span>
								<span class="sr-only">Close menu</span>
								@HeroIconClose("size-6")
							</button>
						</div>
						// Mobile Filters.
						@c.controlForm("mt-4") {
							<div class="border-t border-gray-200 px-4 py-6">
								<h3 class="-mx-2 -my-3 flow-root">
									<button type="button" command="--toggle" commandfor="filter-section-category" class="flex w-full items-center justify-between bg-base-200 px-2 py-3 text-sm text-gray-400">
										<span class="font-medium text-gray-900">Category</span>
										<span class="ml-6 flex items-center">
											@HeroIconChevronDown("size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180")
										</span>
									</button>
								</h3>
								// Category Filters.
								<el-disclosure id="filter-section-category" hidden class="block pt-6">
									<div class="space-y-6">
										// Top 10 categories only.
										for category := range slices.Values(c.Categories.GetTopCategories(10)) {
											@categoryFilter("filter-mobile-category-"+models.CategoryID(category.Category), category, c.Filters.GetCategories())
										}
										<a
											class={ controlItemTextClasses }
											hx-get={ c.Path }
											hx-push-url="true"
											hx-target={ ContentID.Target() }
											hx-include="#content-filters"
											hx-params={ "not " + models.ParamCategories }
										>Clear</a>
									</div>
								</el-disclosure>
							</div>
							// Mobile View Filters.
							<div class="border-t border-gray-200 px-4 py-6">
								<h3 class="-mx-2 -my-3 flow-root">
									<button type="button" command="--toggle" commandfor="filter-section-view" class="flex w-full items-center justify-between bg-base-200 px-2 py-3 text-sm text-gray-400">
										<span class="font-medium text-gray-900">View</span>
										<span class="ml-6 flex items-center">
											@HeroIconChevronDown("size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180")
										</span>
									</button>
								</h3>
								<el-disclosure id="filter-section-view" hidden class="block pt-6">
									<div class="space-y-6">
										@viewFilter("filter-mobile-view-unread", models.ViewUnread, c.Filters.GetView())
										@viewFilter("filter-mobile-view-read", models.ViewRead, c.Filters.GetView())
										@viewFilter("filter-mobile-view-all", models.ViewAll, c.Filters.GetView())
									</div>
								</el-disclosure>
							</div>
						}
					</el-dialog-panel>
				</div>
			</dialog>
		</el-dialog>
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:max-w-7xl lg:px-8">
			<section aria-labelledby="filter-heading" class="py-6">
				<h2 id="filter-heading" class="sr-only">Filters</h2>
				<div class="flex items-center justify-between">
					// Sort Options.
					<el-dropdown class="relative inline-block text-left">
						<button class="group inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900">
							Sort
							@HeroIconChevronDown("-mr-1 ml-1 size-5 shrink-0 text-gray-400 group-hover:text-gray-500")
						</button>
						<el-menu anchor="bottom start" popover class="w-52 origin-top-left rounded-md bg-base-200 shadow-2xl ring-1 ring-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
							<div class="space-y-4 p-2">
								@sortOption(c.Path, models.SortLastUpdatedDesc, c.Filters.GetSort())
								@sortOption(c.Path, models.SortLastUpdatedAsc, c.Filters.GetSort())
								if c.Path == "/subscriptions" {
									@sortOption(c.Path, models.SortUnreadCountDesc, c.Filters.GetSort())
									@sortOption(c.Path, models.SortUnreadCountAsc, c.Filters.GetSort())
								}
							</div>
						</el-menu>
					</el-dropdown>
					// Desktop Filters.
					<button type="button" command="show-modal" commandfor="mobile-filters" class="inline-block text-sm font-medium text-gray-700 hover:text-gray-900 sm:hidden">Filters</button>
					<el-popover-group class="hidden sm:flex sm:items-baseline sm:space-x-8">
						<div class="relative inline-block text-left">
							<div>
								<button popovertarget="desktop-menu-category" class="group inline-flex items-center justify-center text-sm font-medium text-gray-700 hover:text-gray-900">
									<span>Category</span>
									<span class="ml-1.5 rounded-sm bg-gray-200 px-1.5 py-0.5 text-xs font-semibold text-gray-700 tabular-nums">{ len(c.Filters.GetCategories()) }</span>
									@HeroIconChevronDown("-mr-1 ml-1 size-5 shrink-0 text-gray-400 group-hover:text-gray-500")
								</button>
							</div>
							<el-popover id="desktop-menu-category" anchor="bottom end" popover class="origin-top-right overflow-visible rounded-md bg-base-200 p-4 shadow-2xl ring-1 ring-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] backdrop:bg-transparent open:block focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
								@c.controlForm("space-y-4") {
									<input type="hidden" name={ models.ParamView } value={ string(c.Filters.GetView()) }/>
									// Top 10 categories only.
									for category := range slices.Values(c.Categories.GetTopCategories(10)) {
										@categoryFilter("filter-mobile-category-"+models.CategoryID(category.Category), category, c.Filters.GetCategories())
									}
								}
								<a
									class={ controlItemTextClasses, "flex", "gap-3", "mt-4", "self-center" }
									hx-get={ c.Path }
									hx-push-url="true"
									hx-target={ ContentID.Target() }
									hx-include="#content-filters"
									hx-params={ "not " + models.ParamCategories }
								>Clear</a>
							</el-popover>
						</div>
						// Desktop View Filters.
						<div class="relative inline-block text-left">
							<div>
								<button popovertarget="desktop-menu-view" class="group inline-flex items-center justify-center text-sm font-medium text-gray-700 hover:text-gray-900">
									<span>View</span>
									@HeroIconChevronDown("-mr-1 ml-1 size-5 shrink-0 text-gray-400 group-hover:text-gray-500")
								</button>
							</div>
							<el-popover id="desktop-menu-view" anchor="bottom end" popover class="origin-top-right overflow-visible rounded-md bg-base-200 p-4 shadow-2xl ring-1 ring-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] backdrop:bg-transparent open:block focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
								@c.controlForm("space-y-4") {
									@viewFilter("filter-view-unread", models.ViewUnread, c.Filters.GetView())
									@viewFilter("filter-view-read", models.ViewRead, c.Filters.GetView())
									@viewFilter("filter-view-all", models.ViewAll, c.Filters.GetView())
								}
							</el-popover>
						</div>
					</el-popover-group>
				</div>
			</section>
		</div>
	</div>
}

// controlForm wraps controls in a form that will handle applying the given controls.
templ (c *ListControls) controlForm(classes ...string) {
	<form
		hx-get={ c.Path }
		hx-push-url="true"
		hx-target={ ContentID.Target() }
		class={ classes }
		hx-trigger="change,selectionchange"
	>
		// Add other filters.
		<input type="hidden" name={ models.ParamSortBy } value={ string(c.Filters.GetSort().SortBy) }/>
		<input type="hidden" name={ models.ParamSortOrder } value={ string(c.Filters.GetSort().SortOrder) }/>
		<input type="hidden" name={ models.ParamCount } value={ c.Filters.GetCount() }/>
		{ children... }
	</form>
}

// viewFilter renders a checkbox for a view filter.
templ viewFilter(id string, view models.View, current models.View) {
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid size-4 grid-cols-1">
				<input
					id={ id }
					type="radio"
					name={ models.ParamView }
					value={ string(view) }
					class="relative size-4 appearance-none rounded-full border border-gray-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-indigo-600 checked:bg-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:before:bg-gray-400 forced-colors:appearance-auto forced-colors:before:hidden"
					if current == view {
						checked
					}
					hx-vals={ GenerateHXVals(map[string]string{models.ParamView: string(view)}) }
				/>
			</div>
		</div>
		<label for={ id } class={ controlItemTextClasses, "capitalize" }>{ string(view) }</label>
	</div>
}

templ categoryFilter(id string, category models.CategoryCount, current models.Categories) {
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid size-4 grid-cols-1">
				<input
					id={ id }
					type="radio"
					name={ models.ParamCategories }
					value={ category.Category }
					if current.HasCategory(category.Category) {
						checked
						_="on click toggle @checked on me"
					} else {
						hx-vals={ GenerateHXVals(map[string]string{models.ParamCategories: category.Category}) }
					}
					class="relative size-4 appearance-none rounded-full border border-gray-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-indigo-600 checked:bg-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:before:bg-gray-400 forced-colors:appearance-auto forced-colors:before:hidden"
				/>
			</div>
		</div>
		<label for={ id } class={ controlItemTextClasses }>{ category.Category }</label>
	</div>
}

// sortOption renders a checkbox for a sort option.
templ sortOption(path string, sort models.Sort, current models.Sort) {
	// Set this sort as active if indicated in the current view filters.
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid size-4 grid-cols-1">
				<input
					id={ sort.ID() }
					type="radio"
					class="relative size-4 appearance-none rounded-full border border-gray-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-indigo-600 checked:bg-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:before:bg-gray-400 forced-colors:appearance-auto forced-colors:before:hidden"
					if current.IsEqual(sort) {
						checked
					}
					hx-get={ path }
					hx-push-url="true"
					hx-include="#content-filters"
					hx-target={ ContentID.Target() }
					hx-vals={ GenerateHXVals(map[string]string{models.ParamSortBy: string(sort.SortBy), models.ParamSortOrder: string(sort.SortOrder)}) }
				/>
			</div>
		</div>
		<label for={ sort.ID() } class={ controlItemTextClasses, "capitalize" }>{ sort.String() }</label>
	</div>
}
