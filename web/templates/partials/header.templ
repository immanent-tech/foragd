package partials

import (
	"github.com/joshuar/go-templ-daisyui/actions/dropdown"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/input"
	"github.com/joshuar/go-templ-daisyui/input/textinput"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/joshuar/go-templ-daisyui/navigation/navbar"
	"github.com/sebasvil20/templicons/tabler"
)

var HeaderID = attributes.ID("header")

templ Header() {
	@navbar.Build(navbar.WithID(HeaderID.String()),
		navbar.WithBaseColor(color.Base200),
		navbar.NavBarStart(DefaultHeaderStart()),
		navbar.NavBarCenter(DefaultHeaderCenter()),
		navbar.NavBarEnd(DefaultHeaderEnd()),
	).Show()
}

templ DefaultHeaderStart() {
	<div class="flex-none">
		<label for="body-drawer" class="btn btn-square drawer-button">
			@tabler.Menu()
		</label>
	</div>
}

templ DefaultHeaderCenter() {
	<div class="flex-1">
		@input.Build(
			textinput.Build(
				textinput.WithID("search"),
				textinput.WithPlaceholder("Search anything..."),
				textinput.WithExtraAttributes(templ.Attributes{
					"tabindex":     0,
					"hx-post":      "/home/search",
					"hx-trigger":   "input changed delay:500ms, SearchRequest",
					"hx-target":    "#search-results",
					"hx-indicator": ".htmx-indicator",
				}),
			),
			input.WithLabel(input.Left, tabler.Search()),
		).Show()
	</div>
}

templ DefaultHeaderEnd() {
	<div title="Settings" class="flex-none">
		@dropdown.Build(
			dropdown.WithButtonContent(tabler.User()),
			dropdown.WithOpenAlignment(dropdown.AlignEnd),
			dropdown.WithMenuClasses("flex-nowrap", "grow", "min-w-52"),
		).Show() {
			<li>
				@LinkWithIcon(tabler.Settings(), "Settings", templ.Attributes{
					"hx-get":         "/settings",
					"hx-target":      ContentID.Target(),
					"hx-replace-url": "true",
				}, []string{"text-sm"})
			</li>
			<li>
				@LinkWithIcon(tabler.FilePlus(), "Add Subscription", templ.Attributes{
					"hx-get":    "/susbcription/new",
					"hx-target": ModalContainerID.Target(),
					"_":         HyperscriptOpenModal(ModalID.Target()),
				}, []string{"text-sm"})
			</li>
			<li>
				@LinkWithIcon(tabler.FilePlus(), "Import Subscriptions", templ.Attributes{
					"hx-get":    "/susbcription/import",
					"hx-target": ModalContainerID.Target(),
					"_":         HyperscriptOpenModal(ModalID.Target()),
				}, []string{"text-sm"})
			</li>
			<li>
				@LinkWithIcon(tabler.Logout(), "Logout", templ.Attributes{
					"href": "/logout",
				}, []string{"text-sm"})
			</li>
		}
	</div>
}
