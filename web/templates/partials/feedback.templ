package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/actions/modal"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/feedback/alert"
)

var NotificationsID = attributes.ID("notifications")
var ModalID = attributes.ID("modal")

type UserMessage struct {
	*models.Message
}

func NewMessage(msg *models.Message) *UserMessage {
	return &UserMessage{Message: msg}
}

// hsCopyText is hyperscript to insert the given text into the clipboard.
func hsCopyText(text string) string {
	return "on click writeText(" + text + ") on navigator.clipboard put 'Copied!' into me wait 1s put 'Copy' into me"
}

func (m *UserMessage) applyBackgroundColor() string {
	switch m.Status {
	case models.MessageStatusError:
		return "bg-error/50"
	case models.MessageStatusWarning:
		return "bg-warning/50"
	case models.MessageStatusSuccess:
		return "bg-success/50"
	case models.MessageStatusInfo:
		fallthrough
	default:
		return "bg-info/50"
	}
}

func (m *UserMessage) applyTextColor() string {
	switch m.Status {
	case models.MessageStatusError:
		return "text-error-content"
	case models.MessageStatusWarning:
		return "text-warning-content"
	case models.MessageStatusSuccess:
		return "text-success-content"
	case models.MessageStatusInfo:
		fallthrough
	default:
		return "text-info-content"
	}
}

// ShowMessage will show a models.Message as a collapsable component, with the summary shown and details revealed when
// the collapse is opened.
templ (m *UserMessage) AsNote() {
	<div tabindex="0" class={ "collapse", "collapse-arrow", m.applyBackgroundColor() }>
		<input type="checkbox"/>
		<div class={ "collapse-title", "font-semibold", "text-justify", "text-sm", m.applyTextColor() }>
			{ m.Summary }
		</div>
		<div class={ "collapse-content", "text-xs", "text-justify", m.applyTextColor() }>
			if m.HasDetails() {
				{ *m.Details }
			}
		</div>
	</div>
}

templ (m *UserMessage) AsNotification() {
	<div id={ templates.NotificationsID.String() } hx-swap-oob="true">
		@alert.Build(
			alert.AlertState(m.Status),
			alert.WithStyle(alert.Soft),
			alert.WithText(m.Summary),
			alert.WithExtraAttributes(templ.Attributes{
				"_": "on load wait 5s then transition opacity to 0 then remove me",
			}),
		).Show()
	</div>
}

// ShowNotification displays the given message as a notification in the UI.
templ ShowNotification(msg *models.Message) {
	<div id={ templates.NotificationsID.String() } class="fixed top-0 right-0 left-0 mt-4 p-2 z-50" hx-swap-oob="true" hx-swap="outerHTML swap:1s settle:1s">
		@alert.Build(
			alert.AlertState(msgStatusToAlertState(msg.Status)),
			alert.WithExtraAttributes(templ.Attributes{
				"_": "on load wait 5s then transition opacity to 0 then remove me",
			}),
		).Show() {
			if msg.HasDetails() {
				<div>
					<h3 class="font-bold">{ msg.Summary }</h3>
					<div class="text-xs">{ *msg.Details }</div>
				</div>
			} else {
				<span>{ msg.Summary }</span>
			}
		}
	</div>
}

templ AskQuestion(question string, attributes templ.Attributes) {
	@modal.Build(
		modal.WithID(ModalID.String()),
		modal.WithCloseOutside(),
	).Show() {
		<h3 class="font-bold">Unsubscribe from feed?</h3>
		<div class="modal-action">
			<form method="dialog" _={ "on click remove @open from " + ModalID.Target() }>
				<button name="confirmation" value="yes" class="btn" { attributes... }>Yes</button>
				<button name="confirmation" value="cancel" class="btn" { attributes... }>No</button>
			</form>
		</div>
	}
}

// CopyTextButton builds a button that will copy the given text to the clipboard when clicked.
templ CopyTextButton(label, text string) {
	<div>
		@button.Build(
			button.WithContent(label),
			button.WithSize(button.SM),
			button.WithExtraAttributes(templ.Attributes{
				"_": hsCopyText(text),
			}),
		).Show()
	</div>
}

func msgStatusToAlertState(status models.MessageStatus) alert.AlertState {
	switch status {
	case models.MessageStatusError:
		return alert.Error
	case models.MessageStatusWarning:
		return alert.Warning
	case models.MessageStatusInfo:
		return alert.Info
	case models.MessageStatusSuccess:
		fallthrough
	default:
		return alert.Success
	}
}
