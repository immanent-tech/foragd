package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/actions/dropdown"
	"github.com/joshuar/go-templ-daisyui/classes/shadow"
	"github.com/joshuar/go-templ-daisyui/display/avatar"
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/display/card"
	"github.com/joshuar/go-templ-daisyui/display/image"
	"github.com/joshuar/go-templ-daisyui/feedback/tooltip"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
)

type Subscription struct {
	*models.Subscription
	classes []components.Class
}

func NewSubscriptionContent(subscription *models.Subscription) *Subscription {
	card := &Subscription{
		Subscription: subscription,
	}
	if !subscription.IsUnread() {
		card.classes = append(card.classes, "brightness-50")
	}
	return card
}

// Summary displays the subscription's image (or a avatar), title and unread count (if any).
templ (c *Subscription) Summary() {
	@link.Build(
		link.WithAttributes(c.viewAttributes()),
	) {
		<div class="flex flex-row gap-2 items-center">
			<div class="flex-none">
				// Generate a thumbnail to display next to the title.
				if c.GetImage().URL != "" {
					// If the source has an image, use that as the avatar.
					@avatar.Build(
						avatar.WithClasses("w-12", "rounded"),
					) {
						@image.Build(
							c.GetImage().URL,
						).Show()
					}
				} else {
					// Otherwise, take the first letter of the title and create a placeholder avatar.
					@avatar.Build(
						avatar.WithClasses("w-12", "rounded", "bg-secondary/30"),
						avatar.AsPlaceholder(),
					) {
						<span class="text-sm">{ c.GetTitle()[0:1] }</span>
					}
				}
			</div>
			<h2 class="card-title">
				// Title text is a link to the view action of the card.
				{ c.GetTitle() }
			</h2>
			<div class="flex justify-end">
				// Display unread count (if any).
				if c.IsUnread() {
					@badge.Build(
						badge.WithClasses("badge-unread-count"),
					) {
						{ c.GetUnreadCount() }
					}
				}
			</div>
		</div>
	}
}

// Card displays the subscription as a card.
templ (c *Subscription) Card() {
	@card.Build(
		card.WithStyle(card.Border),
		card.WithShadow(shadow.SM),
		card.WithClasses("subscription-card"),
		card.WithClasses(c.classes...),
		card.WithAttributes(templ.Attributes{
			"id": c.GetID(),
		}),
	) {
		@card.BuildBody() {
			// Title.
			@c.Summary()
			// Details.
			<div class="card-details flex">
				<div class="flex italic flex-1 justify-start">
					@ShowTimestamp(c.GetUpdatedDate())
				</div>
			</div>
			// Description.
			<div class="card-description">
				{ c.GetDescription() }
			</div>
			// Actions.
			<div class="card-actions">
				@tooltip.Build("Actions") {
					@dropdown.Build(
						dropdown.WithButtonContent(tabler.DotsVertical(i.Props{Size: i.SizeXS})),
						dropdown.WithOpenFrom(dropdown.OpenTop),
						dropdown.WithOpenAlignment(dropdown.AlignEnd),
						dropdown.WithMenuClasses("justify-end", "flex-nowrap", "grow", "text-xs"),
						dropdown.WithButtonClasses(button.Square, button.XS, button.Secondary),
					).Show() {
						// Visit action.
						<li _="on click call document.activeElement.blur()">
							@link.Build(
								link.WithAttributes(templ.Attributes{"href": c.GetLink()}),
								link.WithClasses("text-xs"),
							) {
								<div class="icontext">
									@tabler.ExternalLink(i.Props{Size: i.SizeXS})
									Feed Website
								</div>
							}
						</li>
						// Mark action.
						<li _="on click call document.activeElement.blur()">
							@markSubscriptionLink(c.GetID(), c.IsUnread())
						</li>
						// Edit action.
						<li _="on click call document.activeElement.blur()">
							@NewAction("/user/subscription/edit/"+c.GetID(), DisplayActionAsLink,
								ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
								ActionTarget(ModalContainerID.Target()),
								ActionLinkOptions(
									link.WithClasses("text-xs"),
								),
							) {
								<div class="icontext">
									@tabler.Edit(i.Props{Size: i.SizeXS})
									Edit Subscription
								</div>
							}
						</li>
						// Favorite action.
						<li id={ "favorite_" + c.GetID() } _="on click call document.activeElement.blur()">
							@ToggleFavoriteSubscriptionText(c.GetID(), c.Favorite, "#favorite_"+c.GetID(), "innerHTML")
						</li>
						// Unsubscribe action.
						<li _="on click call document.activeElement.blur()">
							@NewAction("/subscriptions/remove", DisplayActionAsLink,
								ActionMethod(http.MethodPost),
								ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
								ActionTarget(ModalContainerID.Target()),
								ActionValues(map[string]string{
									"subscriptions": c.GetID(),
									"confirmation":  "no",
								}),
								ActionLinkOptions(
									link.WithClasses("text-xs"),
								),
							) {
								<div class="icontext">
									@tabler.Trash(i.Props{Size: i.SizeXS})
									Remove Subscription
								</div>
							}
						</li>
					}
				}
			</div>
		}
	}
}

// ShowSettings renders subscription data in a table row suitable for the subscription settings page.
templ (c *Subscription) ShowSettings() {
	<tr id={ c.GetID() }>
		// TODO: subscription multi-select/bulk action.
		// <th>
		// 	<label>
		// 		<input type="checkbox" class="checkbox checkbox-xs"/>
		// 	</label>
		// </th>
		<td>{ c.GetTitle() }</td>
		<td>
			@NewAction("/user/subscription/edit/"+c.GetID(), DisplayActionAsLink,
				ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
				ActionTarget(ModalContainerID.Target()),
				ActionLinkOptions(
					link.WithClasses("text-xs"),
				),
			) {
				@tabler.Edit(i.Props{Size: i.SizeXS})
			}
		</td>
		<td>
			@ToggleFavoriteSubscriptionIcon(c.GetID(), c.Favorite, "#"+c.GetID(), "outerHTML")
		</td>
		<td>
			@NewAction("/subscriptions/remove", DisplayActionAsLink,
				ActionMethod(http.MethodPost),
				ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
				ActionTarget(ModalContainerID.Target()),
				ActionValues(map[string]string{
					"subscriptions": c.GetID(),
					"confirmation":  "no",
				}),
				ActionLinkOptions(
					link.WithClasses("text-xs"),
				),
			) {
				@tabler.Trash(i.Props{Size: i.SizeXS})
			}
		</td>
	</tr>
}

templ (c *Subscription) ShowAsSearchSuggestion() {
	<li class="list-row" _="on click call document.activeElement.blur()">
		<div>
			<div class="list-col-wrap text-xs">
				@c.Summary()
			</div>
			// <div class="text-xs uppercase font-semibold opacity-60">{ article.Item.FeedTitle }</div>
		</div>
	</li>
}

// ToggleFavoriteSubscriptionIcon renders an icon that when clicked will toggle the favorite status of the subscription.
templ ToggleFavoriteSubscriptionIcon(id models.SubscriptionID, isFavorite bool, target string, swap string) {
	@favoriteSubscriptionLink(id, isFavorite, target, swap) {
		switch isFavorite {
			case true:
				@tabler.HeartFilled(i.Props{Size: i.SizeXS})
			case false:
				@tabler.Heart(i.Props{Size: i.SizeXS})
		}
	}
}

// ToggleFavoriteSubscriptionText renders an icon and text that when clicked will toggle the favorite status of the
// subscription.
templ ToggleFavoriteSubscriptionText(id models.SubscriptionID, isFavorite bool, target string, swap string) {
	@favoriteSubscriptionLink(id, isFavorite, target, swap) {
		<div class="icontext">
			switch isFavorite {
				case true:
					@tabler.HeartFilled(i.Props{Size: i.SizeXS})
					Remove Favorite
				case false:
					@tabler.Heart(i.Props{Size: i.SizeXS})
					Add Favorite
			}
		</div>
	}
}

// favoriteSubscription link will generate an appropriate link action to favorite a subscription.
templ favoriteSubscriptionLink(id models.SubscriptionID, isFavorite bool, target string, swap string) {
	{{ var method string }}
	switch isFavorite {
		case true:
			{{ method = http.MethodDelete }}
		case false:
			{{ method = http.MethodPut }}
	}
	@NewAction("/user/favorite/subscription/"+id, DisplayActionAsLink,
		ActionMethod(method),
		ActionTarget(target),
		ActionSwap(swap),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		{ children... }
	}
}

// markSubscriptionLink generates a link/action that will mark the subscription read/unread depending on its current
// read state.
templ markSubscriptionLink(id models.SubscriptionID, unread bool) {
	{{ var mark string }}
	if unread {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	@NewAction("/subscription/"+id+"/mark/"+mark, DisplayActionAsLink,
		ActionMethod(http.MethodPost),
		ActionTarget("#"+id),
		ActionSwap("outerHTML"),
		ActionInclude("[name='view']"),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		<div class="icontext">
			switch mark {
				case "read":
					@tabler.Bookmark(i.Props{Size: i.SizeXS})
					Mark Read
				case "unread":
					@tabler.BookmarkFilled(i.Props{Size: i.SizeXS})
					Mark Unread
			}
		</div>
	}
}

func (c *Subscription) viewAttributes() templ.Attributes {
	overrides := map[string]string{
		models.ParamSortBy: string(models.SortByLastUpdated),
		"subscriptions":    c.GetID(),
	}
	if c.IsUnread() {
		overrides[models.ParamView] = string(models.ViewUnread)
	} else {
		overrides[models.ParamView] = string(models.ViewRead)
	}
	return templ.Attributes{
		"hx-get":      "/articles",
		"hx-include":  "#content-filters",
		"hx-vals":     GenerateHXVals(overrides),
		"hx-target":   ContentID.Target(),
		"hx-push-url": "true",
		"hx-swap":     "innerHTML show:top",
	}
}
