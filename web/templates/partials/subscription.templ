package partials

import "github.com/immanent-tech/go-feed-me/models"

type Subscription struct {
	*models.Subscription
}

// NewSubscriptionContent converts a subscription into an object that can be rendered in different ways within the app
// UI.
func NewSubscriptionContent(subscription *models.Subscription) *Subscription {
	return &Subscription{
		Subscription: subscription,
	}
}

// Card renders a subscription in a card format, suitable for showing together with other subscriptions in a list/grid.
templ (s *Subscription) Card() {
	<li id={ s.GetID() }>
		<div
			class={ "relative border-base-content/20 hover:border-base-content/40 bg-base-200 overflow-hidden rounded-xl border p-4",
		templ.KV("opacity-50",!s.IsUnread()) }
		>
			<dt class="flex items-center">
				@s.ViewLink("flex", "items-center", "gap-x-4") {
					<div class="size-12 flex-none">
						@s.image()
					</div>
					<div class="text-base font-medium">{ s.GetTitle() }</div>
				}
				@s.actionsMenu()
			</dt>
			<dd class="pt-4">
				<dt>
					if s.GetDescription() != "" {
						<p class="text-xs/4 line-clamp-2 sm:line-clamp-4">{ s.GetDescription() }</p>
					}
				</dt>
				<dd>
					if s.IsUnread() {
						<p class="text-sm/6 font-semibold">{ s.GetUnreadCount() } Unread</p>
					}
					<p class="text-xs/4">
						Updated&nbsp;
						@ShowTimestamp(s.GetUpdatedDate())
					</p>
				</dd>
			</dd>
		</div>
	</li>
}

// SearchSuggestion renders the subscription in a format suitable for showing as a search suggestion for the global app
// search.
templ (s *Subscription) SearchSuggestion() {
	<div class="overflow-hidden">
		<div class="px-4 py-5 sm:p-6">
			@s.title()
		</div>
	</div>
}

// Settings renders the subscription in a format suitable for showing on the subscription settings page.
templ (s *Subscription) Settings() {
	<li class="flex items-center justify-between px-4 py-5 sm:px-6">
		@s.title()
		@s.actionsMenu()
	</li>
}

// title renders the subscription title, which is its favicon (or a placeholder) and the title text, all as a link to
// the subscription articles.
templ (s *Subscription) title() {
	@s.ViewLink("flex", "items-center", "gap-x-4", "hover:text-accent") {
		<div class="size-12 flex-none">
			@s.image()
		</div>
		<div class="text-base font-bold">{ s.GetTitle() }</div>
	}
}

// actionsMenu renders a dropdown menu containing actions specific to the subscription (e.g. mark, share, favorite).
templ (s *Subscription) actionsMenu() {
	@ContextMenu(s.GetTitle() + " Actions") {
		// View action.
		<a href={ s.GetLink() } class="menu-item">
			@HeroIconExternalLink("size-4")
			Feed Website
		</a>
		// Mark action.
		@s.markLink("menu-item") {
			switch s.IsUnread() {
				case true:
					@HeroIconMarkRead("size-4")
					Mark Read
				case false:
					@HeroIconMarkUnread("size-4")
					Mark Unread
			}
		}
		// Edit action.
		@s.editLink("menu-item") {
			@HeroIconEdit("size-4")
			Edit Subscription
		}
		// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
		<div id={ "favorite_" + s.GetID() }>
			@s.favoriteLink("menu-item") {
				switch s.Favorite {
					case true:
						@HeroIconHeartFilled("size-4")
						Remove Favorite
					case false:
						@HeroIconHeart("size-4")
						Add Favorite
				}
			}
		</div>
		// Unsubscribe action.
		@s.unsubscribeLink("menu-item") {
			@HeroIconTrash("size-4")
			Remove Subscription
		}
	}
}

templ (c *Subscription) image() {
	// Generate a thumbnail to display next to the title.
	if c.GetImage().URL != "" {
		// If the source has an image, use that as the avatar.
		<div class="avatar">
			<div class="rounded-box bg-base-content/10 size-12 p-1">
				<img
					src={ c.GetImage().URL }
					if c.GetImage().Title != "" {
						alt={ c.GetImage().Title }
					}
				/>
			</div>
		</div>
	} else {
		// Otherwise, take the first letter of the title and create a placeholder avatar.
		<div class="avatar avatar-placeholder">
			<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
				<span class="text-3xl capitalize">{ c.GetTitle()[0:1] }</span>
			</div>
		</div>
	}
}

// ToggleFavorite renders an updated favorite link based on the subscriptions favorite status.
templ (s *Subscription) ToggleFavorite() {
	@s.favoriteLink("menu-item") {
		switch s.Favorite {
			case true:
				@HeroIconHeartFilled("size-4")
				Remove Favorite
			case false:
				@HeroIconHeart("size-4")
				Add Favorite
		}
	}
}

// markLink generates a link that will toggle the mark status (read/unread) of the subscription.
templ (c *Subscription) markLink(classes ...string) {
	{{ var mark string }}
	if c.IsUnread() {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	<a
		hx-post={ "/subscription/" + c.GetID() + "/mark/" + mark }
		hx-target={ "#" + c.GetID() }
		hx-swap="outerHTML"
		hx-include="[name='view']"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// editLink generates a link that will open a modal for editing the subscription.
templ (c *Subscription) editLink(classes ...string) {
	<a
		hx-get={ "/user/subscription/edit/" + c.GetID() }
		hx-target={ ContentID.Target() }
		hx-push-url="true"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// favoriteLink generates a link that will toggle the favorite status of the subscription.
templ (c *Subscription) favoriteLink(classes ...string) {
	<a
		if c.Favorite {
			hx-delete={ "/user/favorite/subscription/" + c.GetID() }
		} else {
			hx-put={ "/user/favorite/subscription/" + c.GetID() }
		}
		hx-target={ "#favorite_" + c.GetID() }
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// unsubscribeLink generates a link for unsubscribing from the subscription.
templ (c *Subscription) unsubscribeLink(classes ...string) {
	<a
		hx-get={ "/user/subscription/remove/" + c.GetID() }
		hx-target={ ModalContainerID.Target() }
		class={ "link link-hover", classes }
		_="on htmx:afterOnLoad wait 10ms then call document.getElementById('unsubscribe').show()"
	>
		{ children... }
	</a>
}

// viewLink generates a link for viewing the subscription articles.
templ (c *Subscription) ViewLink(classes ...string) {
	{{ overrides := map[string]string{models.ParamSortBy: string(models.SortByLastUpdated), "subscriptions": c.GetID()} }}
	if c.IsUnread() {
		{{ overrides[models.ParamView] = string(models.ViewUnread) }}
	} else {
		{{ overrides[models.ParamView] = string(models.ViewRead) }}
	}
	<a
		hx-get="/articles"
		hx-include="#content-filters"
		hx-vals={ models.GenerateHXVals(overrides) }
		hx-target={ ContentID.Target() }
		hx-push-url="true"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// UnsubscribeModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ (c *Subscription) UnsubscribeModal() {
	<el-dialog id="unsubscribe-modal">
		<dialog id="unsubscribe" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-content/75 modal-transition"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor="unsubscribe"
							_="on click remove #unsubscribe-modal"
							class="rounded-md text-base-content hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-hidden"
						>
							<span class="sr-only">Close</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					<div class="sm:flex sm:items-start">
						<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-warning sm:mx-0 sm:size-10">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-warning-content">
								<path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						</div>
						<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
							<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
							<div class="mt-2">
								<p class="text-sm">Are you sure you want to unsubscribe from { c.GetTitle() }?</p>
							</div>
						</div>
					</div>
					<div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
						<button
							type="button"
							hx-post={ "/user/subscription/remove/" + c.GetID() }
							hx-target={ "#" + c.GetID() }
							hx-swap="outerHTML"
							_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
							class="inline-flex w-full justify-center rounded-md bg-error/80 px-3 py-2 text-sm font-semibold text-error-content shadow-xs hover:bg-error sm:ml-3 sm:w-auto"
						>Unsubscribe</button>
						<button
							type="button"
							command="close"
							commandfor="unsubscribe"
							_="on click remove #unsubscribe-modal"
							class="mt-3 inline-flex w-full justify-center rounded-md bg-primary/80 px-3 py-2 text-sm font-semibold text-primary-content shadow-xs ring-1 ring-base-content/10 ring-inset hover:bg-primary sm:mt-0 sm:w-auto"
						>Cancel</button>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}
