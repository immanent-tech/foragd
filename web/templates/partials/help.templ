package partials

import tabler "github.com/dimmerz92/go-icons/tabler-outline"

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button id={ id + "-button" } popovertarget={ id } type="button" class="btn btn-circle btn-ghost text-info btn-xs">
		<span class="sr-only">Additional information</span>
		@tabler.InfoCircle(templ.Attributes{"class": "size-6 text-info", "aria-hidden": "true"})
	</button>
	<el-popover ppover id={ id } anchor={ anchor } class="mx-4 [--anchor-gap:4px] sm:mx-auto sm:max-w-prose">
		<div class="card-body rounded-box bg-base-300 shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
			{ children... }
		</div>
	</el-popover>
}
