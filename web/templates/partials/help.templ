package partials

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button id={ id + "-button" } popovertarget={ id } type="button" class="btn btn-circle btn-ghost btn-xs text-info">
		<span class="sr-only">Additional information</span>
		<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icons-tabler-outline icon-tabler-info-circle size-6 text-info" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M12 9h.01"></path><path d="M11 12h1v4h1"></path>
		</svg>
	</button>
	<el-popover ppover id={ id } anchor={ anchor } class="mx-4 sm:mx-auto sm:max-w-prose [--anchor-gap:4px]">
		<div class="card-body bg-base-300 shadow-sm rounded-box outline-1 -outline-offset-1 outline-base-content/15">
			{ children... }
		</div>
	</el-popover>
}
