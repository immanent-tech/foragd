package partials

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"time"
)

// ShowTimestamp will display the given timestamp as a relative/human-friendly timestamp that will update as time
// passes.
templ ShowTimestamp(timestamp time.Time) {
	<human-time datetime={ timestamp.Format("2006-01-02T15:04:05-0700") }>{ timestamp.Format("2006-01-02 15:04:05 -0700") }</human-time>
}

// PageHeader renders the given title in a style appropriate for the page header.
templ PageHeader(title string) {
	<div class="md:flex md:items-center md:justify-between">
		<div class="min-w-0 flex-1">
			<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight">{ title }</h2>
		</div>
		<div class="mt-4 flex md:mt-0 md:ml-4">
			{ children... }
			// <button type="button" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20">Edit</button>
			// <button type="button" class="ml-3 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-400">Publish</button>
		</div>
	</div>
}

// PageDescription renders the given description in a style appropriate to use as a description on the page.
templ PageDescription(description string) {
	<p class="mt-2 max-w-4xl text-sm text-base-content/80">
		if description != "" {
			{ description }
		}
		{ children... }
	</p>
}

// Document renders the given raw HTML data as full-page prose content. Used primarily for hosted markdown documents
// (i.e., privacy policy, terms of service, etc.)
templ Document(data []byte) {
	<main class="prose m-4">
		@templ.Raw(string(data))
	</main>
}

// HelpPopover can be used to render a help icon, that when clicked, will open a popover displaying informational or
// help text.
templ HelpPopover(id, anchor string) {
	<button popovertarget={ id } type="button" class="btn btn-circle btn-ghost btn-xs text-info">
		<span class="sr-only">Search filters help</span>
		@tabler.InfoCircle(i.Props{Class: "size-6 text-info"})
	</button>
	<el-popover popover id={ id } anchor={ anchor } class="[--anchor-gap:4px] rounded-box">
		{ children... }
	</el-popover>
}

// Dock renders a dock at the bottom of the page with navigation buttons for the main pages of the service. Where
// applicable, the button for the current page will be marked.
templ Dock() {
	<div class="dock bg-base-200 lg:hidden">
		<button
			hx-get="/home"
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/home" {
				class="dock-active"
			}
		>
			@tabler.HomeFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Home</span>
		</button>
		<button
			hx-get="/list/subscriptions"
			hx-target={ ContentID.Target() }
			hx-vals={ models.GenerateHXVals(models.ListFiltersFromCtx(ctx).Values()) }
			hx-params={ "not " + models.ParamSubscriptions }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/list/subscriptions" {
				class="dock-active"
			}
		>
			@tabler.Rss(i.Props{Class: "size-6"})
			<span class="dock-label">Subscriptions</span>
		</button>
		<button
			hx-get="/list/articles"
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			if models.PathFromCtx(ctx) == "/list/articles" {
				class="dock-active"
			}
		>
			@tabler.FileRssFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Articles</span>
		</button>
		<button
			if models.PathFromCtx(ctx) == "/favorites" {
				class="dock-active"
			}
		>
			@tabler.HeartFilled(i.Props{Class: "size-6"})
			<span class="dock-label">Favorites</span>
		</button>
	</div>
}
