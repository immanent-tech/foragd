package partials

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/display/icon"
	"github.com/joshuar/go-templ-daisyui/feedback/tooltip"
)

templ MarkButton(action *templates.Action) {
	@tooltip.Build("Mark Read").Show() {
		@button.Build(
			button.WithSize(button.XS),
			button.WithContent(icon.Build("fa-check")),
			button.WithExtraAttributes(action.Attributes()),
		).Show()
	}
}
