import (
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ ContextMenu(name string) {
	// Actions menu.
	<el-dropdown class="relative ml-auto">
		<button class="btn btn-sm btn-ghost btn-square">
			<span class="sr-only">{ name }</span>
			@tabler.DotsVertical(i.Props{Class: "size-5"})
		</button>
		<el-menu
			anchor="bottom end"
			popover
			class="bg-base-300 ring-base-content/20 origin-top-right rounded-md py-2 shadow-lg ring-1 transition transition-discrete [--anchor-gap:--spacing(0.5)] focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
		>
			{ children... }
		</el-menu>
	</el-dropdown>
}
