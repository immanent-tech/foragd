package partials

templ ContextMenu(name string) {
	// Actions menu.
	<el-dropdown class="relative ml-auto">
		<button class="relative block rounded-md text-base-content/80 hover:bg-primary hover:text-primary-content focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2">
			// <span class="absolute -inset-2.5"></span>
			<span class="sr-only">{ name }</span>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"></path>
			</svg>
		</button>
		<el-menu
			anchor="bottom end"
			popover
			class="w-52 bg-base-300 ring-base-content/20 origin-top-right rounded-md py-2 shadow-lg ring-1 transition transition-discrete [--anchor-gap:--spacing(0.5)] focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
		>
			{ children... }
		</el-menu>
	</el-dropdown>
}
