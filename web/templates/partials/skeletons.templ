package partials

// CardSkeleton renders a skeleton for a card, as shown on the list/home pages.
templ CardSkeleton() {
	<div class="card w-80 border border-neutral/20 bg-base-200">
		<div class="card-header px-4 pt-5 pb-2 sm:px-6">
			<div class="flex min-w-0">
				<div class="mr-4 shrink-0">
					<div class="h-12 w-12 shrink-0 skeleton rounded-full"></div>
				</div>
				<div class="min-w-0 flex-1">
					<div class="h-5 w-3/4 max-w-56 skeleton"></div>
					<div class="mt-2 space-y-2">
						<div class="h-3 w-full skeleton"></div>
						<div class="h-3 w-5/6 skeleton"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="px-4 py-5 sm:p-6">
			<div class="mt-auto h-full">
				<ul class="latest-items">
					<li class="my-1 border-l-2 border-accent/40 pl-3 text-base">
						<div class="h-4 w-11/12 skeleton"></div>
					</li>
					<li class="my-1 border-l-2 border-accent/40 pl-3 text-base">
						<div class="h-4 w-2/3 skeleton"></div>
					</li>
					<li class="my-1 border-l-2 border-accent/40 pl-3 text-base">
						<div class="h-4 w-4/5 skeleton"></div>
					</li>
				</ul>
			</div>
		</div>
		<div class="card-footer mt-auto flex justify-end px-4 pt-2 pb-4 sm:px-6">
			<div class="h-10 w-28 skeleton rounded-field"></div>
		</div>
	</div>
}
