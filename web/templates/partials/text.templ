package partials

templ Heading1() {
	<h1 class="mt-4 mb-2 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl scroll-mt-16">
		{ children... }
	</h1>
}

templ Heading2() {
	<h2 class="mt-4 mb-2 text-xl/7 font-semibold tracking-tight sm:mt-8 sm:mb-4 sm:text-2xl scroll-mt-16">
		{ children... }
	</h2>
}

templ Heading3() {
	<h3 class="mt-4 mb-2 text-lg font-medium sm:mt-8 sm:mb-4 scroll-mt-1.5">
		{ children... }
	</h3>
}

templ Paragraph() {
	<p class="mt-4 text-sm/6 text-pretty">
		{ children... }
	</p>
}
