package partials

templ Heading1(text string) {
	<h1 class="mt-4 mb-2 text-5xl font-semibold tracking-tight text-balance capitalize sm:mt-8 sm:mb-4 sm:text-7xl">
		{ text }
		{ children... }
	</h1>
}

templ Heading2() {
	<h2 class="mt-4 mb-2 text-2xl/7 font-bold tracking-tight capitalize sm:mt-8 sm:mb-4 sm:text-3xl">
		{ children... }
	</h2>
}

templ Heading3() {
	<h3 class="mt-4 mb-2 text-lg font-medium capitalize sm:mt-8 sm:mb-4">
		{ children... }
	</h3>
}

templ Paragraph() {
	<p class="mt-4 text-sm/6 text-pretty">
		{ children... }
	</p>
}
