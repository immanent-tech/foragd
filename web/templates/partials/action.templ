package partials

import (
	"context"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"io"
)

templ (a *Action) link() {
	@link.Build(
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(a.generateAttrs()),
		link.WithExtraClasses("text-xs"),
	).Show() {
		{ children... }
	}
}

templ (a *Action) button() {
	@button.Build(
		button.WithSize(button.SM),
		button.WithExtraAttributes(a.generateAttrs()),
	).Show() {
		{ children... }
	}
}

func (l *Action) Render(ctx context.Context, w io.Writer) error {
	switch l.display {
	case DisplayAsButton:
		return l.button().Render(ctx, w)
	default:
		return l.link().Render(ctx, w)
	}
}
