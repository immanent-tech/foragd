package partials

import (
	"context"
	"io"
)

templ (a *Action) link() {
	<a class={ "link", "link-hover" } { a.Attributes()... }>
		{ children... }
	</a>
	// @link.Build(a.linkOptions...) {
	// 	{ children... }
	// }
}

templ (a *Action) button() {
	<button class={ "btn" } { a.Attributes()... }>
		{ children... }
	</button>
}

// Render will display the action with its set options as the defined display type. Satisfies the templ.Component
// interface.
func (l *Action) Render(ctx context.Context, w io.Writer) error {
	switch l.display {
	case DisplayActionAsButton:
		return l.button().Render(ctx, w)
	default:
		return l.link().Render(ctx, w)
	}
}
