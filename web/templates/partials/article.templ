package partials

import (
	"fmt"
	"github.com/immanent-tech/foragd/models"
	"strings"
)

type Article struct {
	*models.Article
}

func NewArticleContent(article *models.Article) *Article {
	return &Article{
		Article: article,
	}
}

// Card renders an article as a card, for displaying in a list.
templ (a *Article) Card(view models.View) {
	<li id={ a.GetID() }>
		<div
			class={ "card-base", templ.KV("opacity-50",!a.IsUnread()) }
		>
			// Header.
			<div class="px-4 py-5 sm:px-6">
				if img := a.GetImage(); img != nil {
					@ViewObjectLink(a, "", nil) {
						<div class="relative w-full">
							<img
								class="aspect-video w-full rounded-2xl bg-base-content-10 object-cover sm:aspect-2/1 lg:aspect-3/2"
								src={ img.GetURL() }
								if img.GetTitle() != "" {
									alt={ img.GetTitle() }
								}
							/>
							<div class="inset-0 rounded-2xl inset-ring inset-ring-base-content/20"></div>
						</div>
						<div class="flex max-w-xl grow flex-col justify-between">
							<div class="group relative grow">
								<h3 class="mt-3 text-lg/6 font-semibold text-pretty">
									if a.GetTitle() != "" {
										{ a.GetTitle() }
									} else {
										(no title)
									}
								</h3>
							</div>
						</div>
					}
				} else {
					@ViewObjectLink(a, "", nil) {
						<div class="group relative grow">
							<h3 class="mt-3 text-lg/6 font-semibold text-pretty">
								if a.GetTitle() != "" {
									{ a.GetTitle() }
								} else {
									(no title)
								}
							</h3>
						</div>
					}
				}
			</div>
			// Body.
			<div class="px-4 sm:px-6">
				<p class="text-xs/4 text-base-content/80 italic text-ellipsis">
					{ strings.Join(a.GetAuthors(),",") }
				</p>
			</div>
			<div class="px-4 py-5 sm:p-6">
				{{ text, err := models.ExtractText(a.GetContent()) }}
				if err == nil {
					<article class="prose prose-sm line-clamp-3">
						{ text }
					</article>
				}
			</div>
			// Footer.
			<div class="px-4 py-4 sm:px-6">
				<div class="flex items-center">
					<div class="flex flex-1">
						<p class="text-xs/4 text-base-content/80 capitalize">
							@ShowTimestamp(a.GetUpdatedDate())
						</p>
					</div>
					<div class="flex flex-1">
						@articleActions(a.Article, view)
					</div>
				</div>
			</div>
		</div>
	</li>
}

// ArticleSummary renders a summary of the article with an image (if available) and snippet of the article content.
templ ArticleSummary(article *models.Article) {
	<div class={ "sm:flex items-center", templ.KV("opacity-50",!article.IsUnread()) }>
		if img := article.GetImage(); img != nil {
			<div class="mb-4 shrink-0 sm:mr-4 sm:mb-0">
				<img
					src={ img.GetURL() }
					if img.GetTitle() != "" {
						alt={ article.GetImage().GetTitle() }
					}
					class="h-32 sm:w-32 w-full object-cover sm:aspect-2/1 lg:aspect-3/2 rounded-box border border-base-content"
				/>
			</div>
		}
		<div class="space-y-4">
			<a
				hx-get={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() }
				hx-target={ ContentID.Target() }
				hx-push-url="true"
				hx-swap="innerHTML show:top"
				class={ "link link-hover" }
			>
				<h4 class="text-lg font-bold">{ article.GetTitle() }</h4>
			</a>
			<div class="flex gap-x-4">
				<p class="flex-none text-xs text-base-content/80">
					@ShowTimestamp(article.GetUpdatedDate())
				</p>
				<p class="flex-none text-xs text-base-content/80">
					{ article.GetFeedTitle() }
				</p>
			</div>
			{{ text, err := models.ExtractText(article.GetContent()) }}
			if err == nil {
				<article class="prose prose-sm line-clamp-3">
					{ text }
				</article>
			}
		</div>
	</div>
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(article *models.Article) {
	<main class="px-4 pt-8">
		// Mobile breadcrumbs/navigation.
		<div class="breadcrumbs-mobile">
			<ul>
				<li aria-label="Back">
					<a
						hx-get="/list/articles"
						hx-target={ ContentID.Target() }
						hx-push-url="true"
						class="link link-hover ml-4 text-sm font-medium text-base-content/50 hover:text-base-content min-w-0 truncate"
					>
						<svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="mr-1 -ml-1 size-5 shrink-0 text-base-content/50">
							<path d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" fill-rule="evenodd"></path>
						</svg>
						Back to articles
					</a>
				</li>
			</ul>
		</div>
		// Desktop breadcrumbs/navigation.
		<div class="breadcrumbs-desktop">
			<ul>
				<li aria-label="Subscriptions">
					<a
						hx-get="/list/subscriptions"
						hx-target={ ContentID.Target() }
						hx-push-url="true"
						class="link link-hover text-sm font-medium text-base-content/50 hover:text-base-content"
					>Subscriptions</a>
				</li>
				<li aria-label="Articles">
					<a
						hx-get="/list/articles"
						hx-target={ ContentID.Target() }
						hx-push-url="true"
						class="link link-hover ml-4 text-sm font-medium text-base-content/50 hover:text-base-content min-w-0 truncate"
					>
						{ article.GetFeedTitle() }
					</a>
				</li>
				<li class="min-w-0">
					<a href="#" aria-current="page" class="ml-4 text-sm font-medium text-base-content/50 hover:text-base-content min-w-0"><p class="truncate min-w-0">{ article.GetTitle() }</p></a>
				</li>
			</ul>
		</div>
		// Article.
		<div class="flex justify-center">
			<article id={ article.GetID() } class="prose prose-sm sm:prose-lg w-full dark:prose-invert px-4 py-4 sm:px-6">
				<a href={ article.GetLink() } target="_blank" rel="noopener" class="link link-hover">
					<h2 class="text-xl font-bold text-pretty sm:text-2xl sm:tracking-tight">{ article.GetTitle() }</h2>
				</a>
				<p class="text-base-content/80 text-wrap italic">
					{ strings.Join(article.GetAuthors(),",") }
				</p>
				<p class="text-base-content/80 capitalize">
					@ShowTimestamp(article.GetUpdatedDate())
				</p>
				switch  {
					case article.GetContent() != "":
						@templ.Raw(article.GetContent())
					case article.GetDescription() != "":
						@templ.Raw(article.GetDescription())
				}
			</article>
		</div>
		// Actions menu.
		<div class="fixed bottom-4 right-4">
			<button popovertarget="article-actions" class="btn btn-circle btn-primary" type="button">
				<label class="swap">
					<input type="checkbox"/>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="swap-off size-6">
						<path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"></path>
					</svg>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="swap-on size-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
					</svg>
				</label>
			</button>
			<el-popover popover id="article-actions" anchor="top end" class="bg-base-100/0 [--anchor-gap:4px] data-closed:opacity-0 data-enter:duration-75 data-enter:ease-out data-leave:duration-100 data-leave:ease-in">
				<div class="flex flex-col space-y-2 text-sm">
					// Toggle full content.
					<form
						hx-post={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() }
						hx-target={ ContentID.Target() }
						hx-include="[name='csrf_token']"
					>
						<input
							type="hidden"
							name={ models.ParamFullArticleContent }
							if article.ShowFullContent {
								value="false"
							} else {
								value="true"
							}
						/>
						<button
							type="submit"
							class="btn btn-circle btn-primary btn-soft opacity-100"
						>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
							</svg>
						</button>
					</form>
					// View original article action.
					<a role="btn" href={ article.GetLink() } target="_blank" rel="noopener" class="btn btn-circle btn-primary btn-soft">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
						</svg>
					</a>
					// Mark article action.
					<div id={ "mark_" + article.GetID() }>
						@UpdateViewArticleMark(article)
					</div>
					// Favorite action.
					<form>
						<input type="hidden" name="display" value="content"/>
						<div id={ "favorite_" + article.GetID() }>
							@UpdateViewArticleFavorite(article)
						</div>
					</form>
					// Share action.
					<a
						role="btn"
						_={ "on click set currentValue to (my innerHTML) then writeText('" + article.GetLink() + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
						class="btn btn-circle btn-primary btn-soft"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"></path>
						</svg>
					</a>
				</div>
			</el-popover>
		</div>
		// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is read and mark it so.
		if article.IsUnread() {
			<div
				hx-post={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() + "/mark/" + string(models.MarkRead) }
				hx-target={ "#mark_" + article.GetID() }
				hx-include="[name='csrf_token']"
				hx-swap="innerHTML"
				hx-trigger="intersect once,load delay:10s"
				hx-push-url="false"
				_="on htmx:afterRequest remove me"
			></div>
		}
	</main>
}

// UpdateViewArticleMark updates the mark action when viewing an article.
templ UpdateViewArticleMark(article *models.Article) {
	{{ var mark string }}
	if article.IsUnread() {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	<a
		role="btn"
		hx-post={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() + "/mark/" + mark }
		hx-target={ "#mark_" + article.GetID() }
		hx-include="[name='csrf_token']"
		class="btn btn-circle btn-primary btn-soft"
	>
		switch article.IsUnread() {
			case true:
				@ReadIcon("size-4")
			case false:
				@UnreadIcon("size-4")
		}
	</a>
}

// UpdateViewArticleFavorite updates the favorite action when viewing an article.
templ UpdateViewArticleFavorite(article *models.Article) {
	<a
		if article.Favorite {
			hx-post={ "/user/favorite/remove/article/" + article.GetID() }
		} else {
			hx-post={ "/user/favorite/add/article/" + article.GetID() }
		}
		hx-target={ "#favorite_" + article.GetID() }
		hx-vals={ fmt.Sprintf("{%q:%q}", "display", "content") }
		hx-include="[name='csrf_token']"
		role="btn"
		class="btn btn-circle btn-primary btn-soft"
	>
		switch article.Favorite {
			case true:
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
					<path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001article.752.752 0 0 1-.704 0l-.003-.001Z"></path>
				</svg>
			case false:
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
				</svg>
		}
	</a>
}

templ articleActions(article *models.Article, view models.View) {
	@ContextMenu(article.GetTitle() + " Actions") {
		// View action.
		<a href={ article.GetLink() } target="_blank" rel="noopener" class="menu-item">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
				<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
			</svg>
			Original Article
		</a>
		// Find similar action.
		<a
			hx-get={ "/subscription/" + article.GetFeedID() + "/article/" + article.GetID() + "/similar" }
			hx-target={ ContentID.Target() }
			hx-push-url="true"
			class="menu-item"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			</svg>
			Find similar...
		</a>
		// Mark action.
		if view == models.ViewAll {
			@MarkObjectLink(article, "#"+article.GetID(), "outerHTML", "menu-item")
		} else {
			@MarkObjectLink(article, "#"+article.GetID(), "delete", "menu-item")
		}
		// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
		<form>
			<input type="hidden" name="display" value="card"/>
			<div id={ "favorite_" + article.GetID() }>
				@FavoriteObjectLink(article, "menu-item")
			</div>
		</form>
		// Share action.
		@articleShareLink(article, "menu-item") {
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
				<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"></path>
			</svg>
			Share
		}
		// Report issue action.
		<a
			hx-get={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() + "/issue" }
			hx-target={ ContentID.Target() }
			class="link link-hover menu-item"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5"></path>
			</svg>
			Report an issue
		</a>
	}
}

// shareLink generates a link that can be used for sharing the article externally
templ articleShareLink(article *models.Article, classes string) {
	<a
		_={ "on click set currentValue to (my innerHTML) then writeText('" + article.GetLink() + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}
