package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/display/figure"
	"github.com/joshuar/go-templ-daisyui/display/image"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"net/url"
	"strings"
)

type Article struct {
	*models.Article
	classes []components.Class
}

func NewArticleContent(article *models.Article) *Article {
	card := &Article{
		Article: article,
	}
	if !article.IsUnread() {
		card.classes = append(card.classes, "brightness-50")
	}
	return card
}

templ (c *Article) Card() {
	if c.GetImage().URL == "" {
		<li id={ c.GetID() } class="overflow-hidden rounded-xl border border-gray-200 bg-base-200 row-span-1">
			@c.cardWithoutImage()
		</li>
	} else {
		<li id={ c.GetID() } class="overflow-hidden rounded-xl border border-gray-200 bg-base-200 md:row-span-2 md:col-span-2">
			@c.cardWithImage()
		</li>
	}
}

templ (a *Article) cardWithImage() {
	<article class="flex flex-col items-start justify-between p-4">
		@a.viewLink() {
			<div class="relative w-full">
				@image.Build(
					a.GetImage().URL,
					image.WithLazyLoading(),
					image.WithExtraClasses("aspect-video w-full rounded-2xl bg-gray-100 object-cover sm:aspect-2/1 lg:aspect-3/2"),
				)
				<div class="absolute inset-0 rounded-2xl inset-ring inset-ring-gray-900/10"></div>
			</div>
			<div class="flex max-w-xl grow flex-col justify-between">
				<div class="group relative grow">
					<h3 class="mt-3 text-lg/6 font-semibold text-gray-900 group-hover:text-gray-600">
						{ a.GetTitle() }
					</h3>
				</div>
			</div>
		}
		<div class="mt-8 w-full">
			<div class="flex items-center justify-between">
				@a.articleInfo()
				@a.articleActions()
			</div>
		</div>
	</article>
}

templ (a *Article) cardWithoutImage() {
	<article id={ a.GetID() } class="flex max-w-xl flex-col items-start justify-between p-4">
		@a.viewLink() {
			<div class="group relative grow">
				<h3 class="mt-3 text-lg/6 font-semibold text-gray-900 group-hover:text-gray-600">
					{ a.GetTitle() }
				</h3>
			</div>
		}
		<div class="mt-8 w-full">
			<div class="flex items-center justify-between">
				@a.articleInfo()
				@a.articleActions()
			</div>
		</div>
	</article>
}

// Content shows the full article content.
templ (a *Article) Content() {
	<div class="grid grid-cols-1 justify-items-center">
		<div class="max-w-prose rounded-xl border border-gray-200 bg-base-200 p-4 mt-8">
			<article class="prose dark:prose-invert prose-img:rounded-xl prose-figure:rounded-xl">
				<a href={ a.GetLink() } class="link link-hover">
					<h2>
						{ a.GetTitle() }
					</h2>
				</a>
				<section id="article-info" class="flex items-center justify-between">
					@a.articleInfo()
					@a.articleActions()
				</section>
				<section id="article-text">
					switch  {
						case a.GetContent() != "":
							@templ.Raw(a.GetContent())
						case a.GetDescription() != "":
							@templ.Raw(a.GetDescription())
					}
				</section>
			</article>
		</div>
		// TODO: display a category cloud of the article's categories underneath it, all linked to categories.
		// <ul
		// 	role="list"
		// 	class="grid grid-cols-6 auto-rows-max justify-center gap-x-4 max-w-prose rounded-xl border border-gray-200 bg-base-200 p-4 mt-2"
		// >
		// 	for category := range slices.Values(a.GetCategories()) {
		// 		<li>
		// 			if len(category) > 10 {
		// 				<span class="inline-flex items-center rounded-md bg-accent/30 px-2 py-1 mx-2 my-1 text-xs text-nowrap col-span-2 font-medium">{ category }</span>
		// 			} else {
		// 				<span class="inline-flex items-center rounded-md bg-accent/30 px-2 py-1 mx-2 my-1 text-xs text-nowrap font-medium">{ category }</span>
		// 			}
		// 		</li>
		// 	}
		// </ul>
	</div>
	// After a delay or when the user scrolls this div into view, assume the article is read and mark it so.
	<div
		hx-post={ "/subscription/" + a.GetSubscriptionID() + "/article/" + a.GetID() + "/mark/" + string(models.MarkRead) }
		hx-swap="none"
		hx-trigger="intersect once,load delay:20s"
		hx-vals='{"view": "unread"}'
		hx-push-url="false"
		_="on htmx:afterRequest remove me"
	></div>
}

// articleInfo renders additional information about the article, ideal to put under the title.
templ (a *Article) articleInfo() {
	<div class="flex flex-none text-xs gap-x-4 items-center">
		<div class="text-gray-500">
			@ShowTimestamp(a.GetUpdatedDate())
		</div>
		<p class="italic text-gray-900">
			{ strings.Join(a.GetAuthors(),",") }
		</p>
	</div>
}

// articleActions renders a menu containing actions to perform on the article (e.g., mark, favorite, share...).
templ (a *Article) articleActions() {
	// Actions menu.
	<el-dropdown class="relative ml-auto">
		<button class="relative block text-gray-400 hover:text-gray-500">
			// <span class="absolute -inset-2.5"></span>
			<span class="sr-only">{ a.GetTitle() + " Actions" }</span>
			@HeroIconContextMenu("size-5")
		</button>
		<el-menu anchor="bottom end" popover class="w-52 origin-top-right rounded-md bg-base-300 py-2 shadow-lg ring-1 ring-gray-900/5 transition transition-discrete [--anchor-gap:--spacing(0.5)] focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
			// View action.
			@link.Build(
				link.WithAttributes(templ.Attributes{"href": a.GetLink()}),
				link.WithClasses(components.Class(CardActionClasses)),
			) {
				@HeroIconExternalLink("size-4")
				Original Article
			}
			// Mark action.
			@a.markLink(components.Class(CardActionClasses)) {
				switch a.IsUnread() {
					case true:
						@HeroIconMarkRead("size-4")
						Mark Read
					case false:
						@HeroIconMarkUnread("size-4")
						Mark Unread
				}
			}
			// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
			<div id={ "favorite_" + a.GetID() }>
				@a.favoriteLink(components.Class(CardActionClasses)) {
					switch a.Favorite {
						case true:
							@HeroIconHeartFilled("size-4")
							Remove Favorite
						case false:
							@HeroIconHeart("size-4")
							Add Favorite
					}
				}
			</div>
			// Share action.
			@a.shareLink(components.Class(CardActionClasses))
		</el-menu>
	</el-dropdown>
}

templ (c *Article) ShowAsSearchSuggestion() {
	<div class="col-span-2">
		<div class="flex flex-row gap-2 m-2 items-center">
			@c.link()
		</div>
	</div>
}

templ (c *Article) ShowAsSearchResult() {
	<div class="col-span-2">
		<div class="flex flex-row gap-2 m-2 items-center">
			@c.link()
		</div>
	</div>
}

// MarkArticleLink generates a link/action that will mark the article read/unread depending on its current
// read state.
templ MarkArticleLink(subscriptionID models.SubscriptionID, itemID models.ItemID, unread bool) {
	{{ var mark string }}
	if unread {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	@NewAction("/subscription/"+subscriptionID+"/article/"+itemID+"/mark/"+mark, DisplayActionAsLink,
		ActionMethod(http.MethodPost),
		ActionTarget("#"+itemID),
		ActionSwap("outerHTML"),
		ActionInclude("[name='view']"),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		<div class="icontext">
			switch mark {
				case "read":
					@tabler.Bookmark()
					Mark Read
				case "unread":
					@tabler.BookmarkFilled()
					Mark Unread
			}
		</div>
	}
}

// ShowAsSummary shows a summarised version of the article.
templ (c *Article) link() {
	@link.Build(
		link.WithAttributes(c.viewAttributes()),
	) {
		<div class="flex flex-row gap-2">
			@c.image()
			<div class="text-sm flex-1 font-semibold">{ c.GetTitle() }</div>
		</div>
		<div class="flex flex-row justify-end">
			<div class="text-xs uppercase font-semibold">{ c.GetFeedTitle() }</div>
		</div>
	}
}

// image returns an appropriate image to use in the article card. It will either be the article's image or a
// placeholder.
templ (c Article) image() {
	if c.GetImage().URL != "" {
		@figure.Build(
			image.Build(
				c.GetImage().URL,
				image.WithLazyLoading(),
				image.WithExtraClasses("rounded"),
			),
			figure.WithFigureClasses("max-w-24"),
		)
	}
}

func (c *Article) viewAttributes() templ.Attributes {
	return templ.Attributes{
		"hx-get":      "/subscription/" + c.GetSubscriptionID() + "/article/" + c.GetID(),
		"hx-target":   ContentID.Target(),
		"hx-push-url": "true",
		"hx-swap":     "innerHTML scroll:top",
	}
}

// ToggleFavoriteArticleText renders an icon and text that when clicked will toggle the favorite status of the
// article.
templ ToggleFavoriteArticleText(id models.SubscriptionID, isFavorite bool, target string, swap string) {
	@favoriteArticleLink(id, isFavorite, target, swap) {
		<div class="icontext">
			switch isFavorite {
				case true:
					@tabler.HeartFilled(i.Props{Size: i.SizeXS})
					Remove Favorite
				case false:
					@tabler.Heart(i.Props{Size: i.SizeXS})
					Add Favorite
			}
		</div>
	}
}

// ToggleFavorite renders an updated favorite link based on the article favorite status.
templ (a *Article) ToggleFavorite() {
	@a.favoriteLink(CardActionClasses) {
		switch a.Favorite {
			case true:
				@HeroIconHeartFilled("size-4")
				Remove Favorite
			case false:
				@HeroIconHeart("size-4")
				Add Favorite
		}
	}
}

// favoriteSubscription link will generate an appropriate link action to favorite a subscription.
templ favoriteArticleLink(id models.ItemID, isFavorite bool, target string, swap string) {
	{{ var method string }}
	switch isFavorite {
		case true:
			{{ method = http.MethodDelete }}
		case false:
			{{ method = http.MethodPut }}
	}
	@NewAction("/user/favorite/article/"+id, DisplayActionAsLink,
		ActionMethod(method),
		ActionTarget(target),
		ActionSwap(swap),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		{ children... }
	}
}

// shareArticleLink generates a link that triggers a modal with options for sharing the article externally.
templ shareArticleLink(subscriptionID models.SubscriptionID, itemID models.ItemID) {
	@NewAction("/subscription/"+subscriptionID+"/article/"+itemID+"/share", DisplayActionAsLink,
		ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
		ActionTarget(ModalContainerID.Target()),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		<div class="icontext">
			@tabler.Share(i.Props{Size: i.SizeXS})
			Share article
		</div>
	}
}

// AskQuestion displays a modal that asks the given question, with the given actions as options.
templ ShareArticleModal(article *models.Article) {
	@Modal() {
		<h3 class="font-bold">Share via...</h3>
		<div class="flex justify-center">
			<div class="grid grid-cols-4 gap-4">
				@link.Build(
					link.WithAttributes(mailToAttrs(article)),
					link.WithClasses("btn"),
				) {
					<div class="icontext text-sm">
						@tabler.Mail()
						Send Email
					</div>
				}
				@button.Build(
					button.WithAttributes(templ.Attributes{
						"_": "on click call navigator.clipboard.writeText('" + article.GetLink() + "')",
					}),
				) {
					<div class="icontext text-sm">
						@tabler.Copy()
						Copy Link
					</div>
				}
			</div>
		</div>
	}
}

func mailToAttrs(article *models.Article) templ.Attributes {
	var href strings.Builder
	href.WriteString("mailto:?subject=")
	href.WriteString(url.QueryEscape(article.GetTitle()))
	href.WriteString("&body=")
	href.WriteString(url.QueryEscape(article.GetLink()))
	return templ.Attributes{
		"href":   href.String(),
		"target": "_blank",
	}
}

// viewLink generates a link for viewing the article.
templ (a *Article) viewLink(classes ...components.Class) {
	@link.Build(
		link.WithAttributes(templ.Attributes{
			"hx-get":      "/subscription/" + a.GetSubscriptionID() + "/article/" + a.GetID(),
			"hx-target":   ContentID.Target(),
			"hx-push-url": "true",
			"hx-swap":     "innerHTML show:top",
		}),
		link.WithClasses(classes...),
	) {
		{ children... }
	}
}

// markLink generates a link that will toggle the mark status (read/unread) of the subscription.
templ (a *Article) markLink(classes ...components.Class) {
	{{ var mark string }}
	if a.IsUnread() {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	@NewAction("/subscription/"+a.GetSubscriptionID()+"/article/"+a.GetID()+"/mark/"+mark, DisplayActionAsLink,
		ActionMethod(http.MethodPost),
		ActionTarget("#"+a.GetID()),
		ActionSwap("outerHTML"),
		ActionInclude("[name='view']"),
		ActionLinkOptions(
			link.WithClasses(classes...),
		),
	) {
		{ children... }
	}
}

// favoriteLink generates a link that will toggle the favorite status of the subscription.
templ (a *Article) favoriteLink(classes ...components.Class) {
	{{ var method string }}
	switch a.Favorite {
		case true:
			{{ method = http.MethodDelete }}
		case false:
			{{ method = http.MethodPut }}
	}
	@NewAction("/user/favorite/article/"+a.GetID(), DisplayActionAsLink,
		ActionMethod(method),
		ActionTarget("#favorite_"+a.GetID()),
		ActionLinkOptions(
			link.WithClasses(classes...),
		),
	) {
		{ children... }
	}
}

// shareLink generates a link that can be used for sharing the article externally
templ (a *Article) shareLink(classes ...components.Class) {
	@NewAction("/subscription/"+a.GetSubscriptionID()+"/article/"+a.GetID()+"/share", DisplayActionAsLink,
		ActionTarget("#favorite_"+a.GetID()),
		ActionLinkOptions(
			link.WithClasses(classes...),
		),
	) {
		@HeroIconShare("size-4")
		Share
	}
}
