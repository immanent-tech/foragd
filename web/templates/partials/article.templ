type Article struct {
	*models.Article
	classes []components.Class
}

func NewArticleContent(article *models.Article) *Article {
	card := &Article{
		Article: article,
	}
	if !article.IsUnread() {
		card.classes = append(card.classes, "brightness-50")
	}
	return card
}

templ (c *Article) ShowAsItem() {
	if c.GetImage().URL == "" {
		@c.summaryWithoutImage()
	} else {
		@c.summaryWithImage()
	}
}

