templ (c *Article) summaryWithoutImage() {
	<article id={ c.GetID() } class="flex max-w-xl flex-col items-start justify-between">
		<div class="flex items-center gap-x-4 text-xs">
			<div class="text-gray-500">
				@ShowTimestamp(c.GetUpdatedDate())
			</div>
			// <a href="#" class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100">Marketing</a>
		</div>
		<div class="group relative grow">
			<h3 class="mt-3 text-lg/6 font-semibold text-gray-900 group-hover:text-gray-600">
				<a href="#">
					<span class="absolute inset-0"></span>
					{ c.GetTitle() }
				</a>
			</h3>
			// <p class="mt-5 line-clamp-3 text-sm/6 text-gray-600">Illo sint voluptas. Error voluptates culpa eligendi. Hic vel totam vitae illo. Non aliquid explicabo necessitatibus unde. Sed exercitationem placeat consectetur nulla deserunt vel. Iusto corrupti dicta.</p>
		</div>
		<div class="relative mt-8 flex items-center gap-x-4 justify-self-end">
			<img src="https://images.unsplash.com/photo-1519244703995-f4e0f30006d5?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80" alt="" class="size-10 rounded-full bg-gray-50"/>
			<div class="text-sm/6">
				<p class="font-semibold text-gray-900">
					<a href="#">
						<span class="absolute inset-0"></span>
						{ strings.Join(c.GetAuthors(),",") }
					</a>
				</p>
				// <p class="text-gray-600">Co-Founder / CTO</p>
			</div>
		</div>
	</article>
}

templ (c *Article) ShowAsSearchSuggestion() {
	<div class="col-span-2">
		<div class="flex flex-row gap-2 m-2 items-center">
			@c.link()
		</div>
	</div>
}

templ (c *Article) ShowAsSearchResult() {
	<div class="col-span-2">
		<div class="flex flex-row gap-2 m-2 items-center">
			@c.link()
		</div>
	</div>
}

// Content shows the full article content.
templ (c *Article) Content() {
	<div class="flex justify-center">
		@article.Build() {
			<h2>
				{ c.GetTitle() }
			</h2>
			<div class="flex flex-row justify-start gap-2">
				if len(c.GetAuthors()) > 0 {
					<div class="text-sm font-semibold">{ strings.Join(c.GetAuthors(), ",") }</div>
				}
				<div class="text-sm">
					@ShowTimestamp(c.GetUpdatedDate())
				</div>
			</div> // Display the categories associated with the article.
			for category := range slices.Values(c.GetCategories()) {
				@badge.Build(
					badge.WithClasses(badge.Ghost, badge.XS, "capitalize", "w-fit-content"),
				) {
					{ category }
				}
			}
			// Display the article content.
			<div id="article-content">
				switch  {
					case c.GetContent() != "":
						@templ.Raw(c.GetContent())
					case c.GetDescription() != "":
						@templ.Raw(c.GetDescription())
				}
			</div>
			<div class="article-actions">
				// Visit external link.
				<div class="flex">
					@c.visitActionLink()
				</div>
				// Toggle favorite.
				<div class="flex" id={ "favorite_" + c.GetID() }>
					@ToggleFavoriteArticleText(c.GetID(), c.Favorite, "#favorite_"+c.GetID(), "innerHTML")
				</div>
				// Share.
				<div class="flex">
					@shareArticleLink(c.GetSubscriptionID(), c.GetID())
				</div>
			</div>
		}
	</div>
	// After a delay or when the user scrolls this div into view, assume the article is read and mark it so.
	<div
		hx-post={ "/subscription/" + c.GetSubscriptionID() + "/article/" + c.GetID() + "/mark/read" }
		hx-swap="none"
		hx-trigger="intersect once,load delay:20s"
		hx-vals='{"view": "unread"}'
		hx-push-url="false"
		_="on htmx:afterRequest remove me"
	></div>
}

// MarkArticleLink generates a link/action that will mark the article read/unread depending on its current
// read state.
templ MarkArticleLink(subscriptionID models.SubscriptionID, itemID models.ItemID, unread bool) {
	{{ var mark string }}
	if unread {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	@NewAction("/subscription/"+subscriptionID+"/article/"+itemID+"/mark/"+mark, DisplayActionAsLink,
		ActionMethod(http.MethodPost),
		ActionTarget("#"+itemID),
		ActionSwap("outerHTML"),
		ActionInclude("[name='view']"),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		<div class="icontext">
			switch mark {
				case "read":
					@tabler.Bookmark()
					Mark Read
				case "unread":
					@tabler.BookmarkFilled()
					Mark Unread
			}
		</div>
	}
}

// ShowAsSummary shows a summarised version of the article.
templ (c *Article) link() {
	@link.Build(
		link.WithAttributes(c.viewAttributes()),
	) {
		<div class="flex flex-row gap-2">
			@c.image()
			<div class="text-sm flex-1 font-semibold">{ c.GetTitle() }</div>
		</div>
		<div class="flex flex-row justify-end">
			<div class="text-xs uppercase font-semibold">{ c.GetFeedTitle() }</div>
		</div>
	}
}

// image returns an appropriate image to use in the article card. It will either be the article's image or a
// placeholder.
templ (c Article) image() {
	if c.GetImage().URL != "" {
		@figure.Build(
			image.Build(
				c.GetImage().URL,
				image.WithLazyLoading(),
				image.WithExtraClasses("rounded"),
			),
			figure.WithFigureClasses("max-w-24"),
		)
	}
}

func (c *Article) viewAttributes() templ.Attributes {
	return templ.Attributes{
		"hx-get":      "/subscription/" + c.GetSubscriptionID() + "/article/" + c.GetID(),
		"hx-target":   ContentID.Target(),
		"hx-push-url": "true",
		"hx-swap":     "innerHTML scroll:top",
	}
}

// ToggleFavoriteArticleText renders an icon and text that when clicked will toggle the favorite status of the
// article.
templ ToggleFavoriteArticleText(id models.SubscriptionID, isFavorite bool, target string, swap string) {
	@favoriteArticleLink(id, isFavorite, target, swap) {
		<div class="icontext">
			switch isFavorite {
				case true:
					@tabler.HeartFilled(i.Props{Size: i.SizeXS})
					Remove Favorite
				case false:
					@tabler.Heart(i.Props{Size: i.SizeXS})
					Add Favorite
			}
		</div>
	}
}

// favoriteSubscription link will generate an appropriate link action to favorite a subscription.
templ favoriteArticleLink(id models.ItemID, isFavorite bool, target string, swap string) {
	{{ var method string }}
	switch isFavorite {
		case true:
			{{ method = http.MethodDelete }}
		case false:
			{{ method = http.MethodPut }}
	}
	@NewAction("/user/favorite/article/"+id, DisplayActionAsLink,
		ActionMethod(method),
		ActionTarget(target),
		ActionSwap(swap),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		{ children... }
	}
}

// visitActionLink generates a link that redirects to the original article.
templ (a *Article) visitActionLink() {
	@link.Build(
		link.WithAttributes(templ.Attributes{"href": a.GetLink()}),
		link.WithClasses("text-xs"),
	) {
		<div class="flex gap-2">
			@tabler.ExternalLink(i.Props{Size: i.SizeXS})
			Original Article
		</div>
	}
}

// shareArticleLink generates a link that triggers a modal with options for sharing the article externally.
templ shareArticleLink(subscriptionID models.SubscriptionID, itemID models.ItemID) {
	@NewAction("/subscription/"+subscriptionID+"/article/"+itemID+"/share", DisplayActionAsLink,
		ActionHyperScript("on htmx:afterOnLoad wait 10ms then add @open to "+ModalID.Target()),
		ActionTarget(ModalContainerID.Target()),
		ActionLinkOptions(
			link.WithClasses("text-xs"),
		),
	) {
		<div class="icontext">
			@tabler.Share(i.Props{Size: i.SizeXS})
			Share article
		</div>
	}
}

// AskQuestion displays a modal that asks the given question, with the given actions as options.
templ ShareArticleModal(article *models.Article) {
	@Modal() {
		<h3 class="font-bold">Share via...</h3>
		<div class="flex justify-center">
			<div class="grid grid-cols-4 gap-4">
				@link.Build(
					link.WithAttributes(mailToAttrs(article)),
					link.WithClasses("btn"),
				) {
					<div class="icontext text-sm">
						@tabler.Mail()
						Send Email
					</div>
				}
				@button.Build(
					button.WithAttributes(templ.Attributes{
						"_": "on click call navigator.clipboard.writeText('" + article.GetLink() + "')",
					}),
				) {
					<div class="icontext text-sm">
						@tabler.Copy()
						Copy Link
					</div>
				}
			</div>
		</div>
	}
}

func mailToAttrs(article *models.Article) templ.Attributes {
	var href strings.Builder
	href.WriteString("mailto:?subject=")
	href.WriteString(url.QueryEscape(article.GetTitle()))
	href.WriteString("&body=")
	href.WriteString(url.QueryEscape(article.GetLink()))
	return templ.Attributes{
		"href":   href.String(),
		"target": "_blank",
	}
}
