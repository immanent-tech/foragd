package partials

import (
	"fmt"
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/display/figure"
	"github.com/joshuar/go-templ-daisyui/display/image"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"html"
	"net/http"
	"strings"
)

type Article struct {
	*models.Article
	classes []components.Class
}

func NewArticleContent(article *models.Article) *Article {
	card := &Article{
		Article: article,
	}
	if !article.IsUnread() {
		card.classes = append(card.classes, "brightness-50")
	}
	return card
}

// Card renders an article as a card, for displaying in a list.
templ (a *Article) Card() {
	<li
		id={ a.GetID() }
		class={ "border-base-content/20 hover:border-base-content/40 bg-base-200 overflow-hidden rounded-xl border",
		templ.KV("row-span-1",a.GetImage().URL == ""), templ.KV("md:row-span-2 md:col-span-1",a.GetImage().URL != "") }
	>
		<article class="flex flex-col items-start justify-between p-4">
			if a.GetImage().URL != "" {
				@a.ViewLink() {
					<div class="relative w-full">
						@image.Build(
							a.GetImage().URL,
							image.WithLazyLoading(),
							image.WithExtraClasses("aspect-video w-full rounded-2xl bg-base-content-10 object-cover sm:aspect-2/1 lg:aspect-3/2"),
						)
						<div class="absolute inset-0 rounded-2xl inset-ring inset-ring-base-content/20"></div>
					</div>
					<div class="flex max-w-xl grow flex-col justify-between">
						<div class="group relative grow">
							<h3 class="mt-3 text-lg/6 font-semibold">
								{ a.GetTitle() }
							</h3>
						</div>
					</div>
				}
			} else {
				@a.ViewLink() {
					<div class="group relative grow">
						<h3 class="mt-3 text-lg/6 font-semibold">
							{ a.GetTitle() }
						</h3>
					</div>
				}
			}
			<div class="mt-8 w-full">
				<div class="flex items-center justify-between">
					@a.articleInfo()
					@a.articleActions()
				</div>
			</div>
		</article>
	</li>
}

// SearchSuggestion renders the article in a format suitable for showing as a search suggestion for the global app
// search.
templ (a *Article) SearchSuggestion() {
	<div class="overflow-hidden">
		<div class="px-4 py-5 sm:p-6">
			@a.link()
		</div>
	</div>
}

// Content shows the full article content.
templ (a *Article) Content() {
	<div class="grid grid-cols-1 justify-items-center">
		<div class="max-w-prose rounded-xl border border-base-content/20 bg-base-200 p-4 mt-8">
			<article class="prose dark:prose-invert prose-img:rounded-xl prose-figure:rounded-xl">
				<a href={ a.GetLink() } class="link link-hover">
					<h2>
						{ a.GetTitle() }
					</h2>
				</a>
				<section id="article-info" class="flex items-center justify-between">
					@a.articleInfo()
					@a.articleActions()
				</section>
				<section id="article-text">
					switch  {
						case a.GetContent() != "":
							@templ.Raw(a.GetContent())
						case a.GetDescription() != "":
							@templ.Raw(a.GetDescription())
					}
				</section>
			</article>
		</div>
		// TODO: display a category cloud of the article's categories underneath it, all linked to categories.
		// <ul
		// 	role="list"
		// 	class="grid grid-cols-6 auto-rows-max justify-center gap-x-4 max-w-prose rounded-xl border border-gray-200 bg-base-200 p-4 mt-2"
		// >
		// 	for category := range slices.Values(a.GetCategories()) {
		// 		<li>
		// 			if len(category) > 10 {
		// 				<span class="inline-flex items-center rounded-md bg-accent/30 px-2 py-1 mx-2 my-1 text-xs text-nowrap col-span-2 font-medium">{ category }</span>
		// 			} else {
		// 				<span class="inline-flex items-center rounded-md bg-accent/30 px-2 py-1 mx-2 my-1 text-xs text-nowrap font-medium">{ category }</span>
		// 			}
		// 		</li>
		// 	}
		// </ul>
		// After a delay or when the user scrolls this div into view, assume the article is read and mark it so.
		<div
			hx-post={ "/subscription/" + a.GetSubscriptionID() + "/article/" + a.GetID() + "/mark/" + string(models.MarkRead) }
			hx-swap="none"
			hx-trigger="intersect once,load delay:20s"
			hx-vals='{"view": "unread"}'
			hx-push-url="false"
			_="on htmx:afterRequest remove me"
		></div>
	</div>
}

// articleInfo renders additional information about the article, ideal to put under the title.
templ (a *Article) articleInfo() {
	<div class="flex flex-none text-xs gap-x-4 items-center">
		<div class="text-base-content">
			@ShowTimestamp(a.GetUpdatedDate())
		</div>
		<p class="italic text-base-content">
			{ strings.Join(a.GetAuthors(),",") }
		</p>
	</div>
}

// articleActions renders a menu containing actions to perform on the article (e.g., mark, favorite, share...).
templ (a *Article) articleActions() {
	// Actions menu.
	<el-dropdown class="relative ml-auto">
		<button class="relative block rounded-md text-base-content/80 hover:bg-primary hover:text-primary-content focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2">
			// <span class="absolute -inset-2.5"></span>
			<span class="sr-only">{ a.GetTitle() + " Actions" }</span>
			@HeroIconContextMenu("size-5")
		</button>
		<el-menu
			anchor="bottom end"
			popover
			class="w-52 bg-base-300 ring-base-content/20 origin-top-right rounded-md py-2 shadow-lg ring-1 transition transition-discrete [--anchor-gap:--spacing(0.5)] focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
		>
			// View action.
			@link.Build(
				link.WithAttributes(templ.Attributes{"href": a.GetLink()}),
				link.WithClasses(components.Class("flex items-center gap-x-2 px-3 py-1 text-xs/4 inactive-link")),
			) {
				@HeroIconExternalLink("size-4")
				Original Article
			}
			// Mark action.
			@a.markLink(components.Class("flex items-center gap-x-2 px-3 py-1 text-xs/4 inactive-link")) {
				switch a.IsUnread() {
					case true:
						@HeroIconMarkRead("size-4")
						Mark Read
					case false:
						@HeroIconMarkUnread("size-4")
						Mark Unread
				}
			}
			// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
			<div id={ "favorite_" + a.GetID() }>
				@a.favoriteLink(components.Class("flex items-center gap-x-2 px-3 py-1 text-xs/4 inactive-link")) {
					switch a.Favorite {
						case true:
							@HeroIconHeartFilled("size-4")
							Remove Favorite
						case false:
							@HeroIconHeart("size-4")
							Add Favorite
					}
				}
			</div>
			// Share action.
			@a.shareLink("flex items-center gap-x-2 px-3 py-1 text-xs/4 inactive-link") {
				@HeroIconShare("size-4")
				Share
			}
		</el-menu>
	</el-dropdown>
}

// ShowAsSummary shows a summarised version of the article.
templ (c *Article) link() {
	@link.Build(
		link.WithAttributes(c.viewAttributes()),
	) {
		<div class="flex flex-row gap-2">
			@c.image()
			<div class="text-sm flex-1 font-semibold">{ c.GetTitle() }</div>
		</div>
		<div class="flex flex-row justify-end">
			<div class="text-xs uppercase font-semibold">{ c.GetFeedTitle() }</div>
		</div>
	}
}

// image returns an appropriate image to use in the article card. It will either be the article's image or a
// placeholder.
templ (c Article) image() {
	if c.GetImage().URL != "" {
		@figure.Build(
			image.Build(
				c.GetImage().URL,
				image.WithLazyLoading(),
				image.WithExtraClasses("rounded"),
			),
			figure.WithFigureClasses("max-w-24"),
		)
	}
}

func (c *Article) viewAttributes() templ.Attributes {
	return templ.Attributes{
		"hx-get":      "/subscription/" + c.GetSubscriptionID() + "/article/" + c.GetID(),
		"hx-target":   ContentID.Target(),
		"hx-push-url": "true",
		"hx-swap":     "innerHTML scroll:top",
	}
}

// ToggleFavorite renders an updated favorite link based on the article favorite status.
templ (a *Article) ToggleFavorite() {
	@a.favoriteLink("app-context-menu-action") {
		switch a.Favorite {
			case true:
				@HeroIconHeartFilled("size-4")
				Remove Favorite
			case false:
				@HeroIconHeart("size-4")
				Add Favorite
		}
	}
}

// viewLink generates a link for viewing the article.
templ (a *Article) ViewLink(classes ...components.Class) {
	@link.Build(
		link.WithAttributes(templ.Attributes{
			"hx-get":      "/subscription/" + a.GetSubscriptionID() + "/article/" + a.GetID(),
			"hx-target":   ContentID.Target(),
			"hx-push-url": "true",
			"hx-swap":     "innerHTML show:top",
		}),
		link.WithClasses(classes...),
	) {
		{ children... }
	}
}

// markLink generates a link that will toggle the mark status (read/unread) of the subscription.
templ (a *Article) markLink(classes ...components.Class) {
	{{ var mark string }}
	if a.IsUnread() {
		{{ mark = "read" }}
	} else {
		{{ mark = "unread" }}
	}
	@NewAction("/subscription/"+a.GetSubscriptionID()+"/article/"+a.GetID()+"/mark/"+mark, DisplayActionAsLink,
		ActionMethod(http.MethodPost),
		ActionTarget("#"+a.GetID()),
		ActionSwap("outerHTML"),
		ActionInclude("[name='view']"),
		ActionClasses(classes...),
	) {
		{ children... }
	}
}

// favoriteLink generates a link that will toggle the favorite status of the subscription.
templ (a *Article) favoriteLink(classes ...components.Class) {
	{{ var method string }}
	switch a.Favorite {
		case true:
			{{ method = http.MethodDelete }}
		case false:
			{{ method = http.MethodPut }}
	}
	@NewAction("/user/favorite/article/"+a.GetID(), DisplayActionAsLink,
		ActionMethod(method),
		ActionTarget("#favorite_"+a.GetID()),
		ActionClasses(classes...),
	) {
		{ children... }
	}
}

// shareLink generates a link that can be used for sharing the article externally
templ (a *Article) shareLink(classes string) {
	<a
		_={ "on click set currentValue to (my innerHTML) then writeText('" + a.GetLink() + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
		class={ classes }
	>
		{ children... }
	</a>
}

templ (a *Article) ShareModal() {
	<el-dialog id={ "share_" + a.GetID() + "_dialog" }>
		<dialog id={ "share_" + a.GetID() } aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-content/50 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 shadow-xl outline -outline-offset-1 outline-base-content/10 transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-sm sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor={ "share_" + a.GetID() }
							class="rounded-md text-base-content hover:text-primary focus:outline-2 focus:outline-offset-2 focus:outline-primary"
							_={ "on click remove #share_" + a.GetID() + "_dialog" }
						>
							<span class="sr-only">Close</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
								<path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
					<div>
						<div class="mt-3 text-center sm:mt-5">
							<h3 id="dialog-title" class="text-base font-semibold">{ fmt.Sprintf("Share\n%q",a.GetTitle()) }</h3>
						</div>
					</div>
					<div class="flex justify-center gap-x-4 mt-4">
						<a
							href={ "https://www.facebook.com/sharer/sharer.php?u=" + html.EscapeString(a.GetLink()) + "&quote=" + html.EscapeString(a.GetTitle()) }
							title="Share on Facebook"
							target="_blank"
							_={ "on click remove #share_" + a.GetID() + "_dialog" }
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" class="size-8 hover:bg-primary hover:text-primary-content focus-visible:outline-primary rounded-md focus-visible:outline-2 focus-visible:outline-offset-2">
								<!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
								<path d="M240 363.3L240 576L356 576L356 363.3L442.5 363.3L460.5 265.5L356 265.5L356 230.9C356 179.2 376.3 159.4 428.7 159.4C445 159.4 458.1 159.8 465.7 160.6L465.7 71.9C451.4 68 416.4 64 396.2 64C289.3 64 240 114.5 240 223.4L240 265.5L174 265.5L174 363.3L240 363.3z"></path>
							</svg>
						</a>
						<a
							href={ "http://www.reddit.com/submit?url=" + html.EscapeString(a.GetLink()) + "&title=" + html.EscapeString(a.GetTitle()) }
							target="_blank"
							title="Submit to Reddit"
							_={ "on click remove #share_" + a.GetID() + "_dialog" }
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" class="size-8 hover:bg-primary hover:text-primary-content focus-visible:outline-primary rounded-md focus-visible:outline-2 focus-visible:outline-offset-2">
								<!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
								<path d="M64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576L101.1 576C87.4 576 80.6 559.5 90.2 549.8L139 501C92.7 454.7 64 390.7 64 320zM413.6 217.6C437.2 217.6 456.3 198.5 456.3 174.9C456.3 151.3 437.2 132.2 413.6 132.2C393 132.2 375.8 146.8 371.8 166.2C337.3 169.9 310.4 199.2 310.4 234.6L310.4 234.8C272.9 236.4 238.6 247.1 211.4 263.9C201.3 256.1 188.6 251.4 174.9 251.4C141.9 251.4 115.1 278.2 115.1 311.2C115.1 335.2 129.2 355.8 149.5 365.3C151.5 434.7 227.1 490.5 320.1 490.5C413.1 490.5 488.8 434.6 490.7 365.2C510.9 355.6 524.8 335 524.8 311.2C524.8 278.2 498 251.4 465 251.4C451.3 251.4 438.7 256 428.6 263.8C401.2 246.8 366.5 236.1 328.6 234.7L328.6 234.5C328.6 209.1 347.5 188 372 184.6C376.4 203.4 393.3 217.4 413.5 217.4L413.6 217.6zM241.1 310.9C257.8 310.9 270.6 328.5 269.6 350.2C268.6 371.9 256.1 379.8 239.3 379.8C222.5 379.8 207.9 371 208.9 349.3C209.9 327.6 224.3 311 241 311L241.1 310.9zM431.2 349.2C432.2 370.9 417.5 379.7 400.8 379.7C384.1 379.7 371.5 371.8 370.5 350.1C369.5 328.4 382.3 310.8 399 310.8C415.7 310.8 430.2 327.4 431.1 349.1L431.2 349.2zM383.1 405.9C372.8 430.5 348.5 447.8 320.1 447.8C291.7 447.8 267.4 430.5 257.1 405.9C255.9 403 257.9 399.7 261 399.4C279.4 397.5 299.3 396.5 320.1 396.5C340.9 396.5 360.8 397.5 379.2 399.4C382.3 399.7 384.3 403 383.1 405.9z"></path>
							</svg>
						</a>
						<a
							href={ "http://www.linkedin.com/shareArticle?mini=true&url=" + html.EscapeString(a.GetLink()) + "&title=" + html.EscapeString(a.GetTitle()) + "&summary=&source=" }
							target="_blank"
							title="Share on LinkedIn"
							_={ "on click remove #share_" + a.GetID() + "_dialog" }
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" fill="currentColor" class="size-8 hover:bg-primary hover:text-primary-content focus-visible:outline-primary rounded-md focus-visible:outline-2 focus-visible:outline-offset-2">
								<!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
								<path d="M512 96L127.9 96C110.3 96 96 110.5 96 128.3L96 511.7C96 529.5 110.3 544 127.9 544L512 544C529.6 544 544 529.5 544 511.7L544 128.3C544 110.5 529.6 96 512 96zM231.4 480L165 480L165 266.2L231.5 266.2L231.5 480L231.4 480zM198.2 160C219.5 160 236.7 177.2 236.7 198.5C236.7 219.8 219.5 237 198.2 237C176.9 237 159.7 219.8 159.7 198.5C159.7 177.2 176.9 160 198.2 160zM480.3 480L413.9 480L413.9 376C413.9 351.2 413.4 319.3 379.4 319.3C344.8 319.3 339.5 346.3 339.5 374.2L339.5 480L273.1 480L273.1 266.2L336.8 266.2L336.8 295.4L337.7 295.4C346.6 278.6 368.3 260.9 400.6 260.9C467.8 260.9 480.3 305.2 480.3 362.8L480.3 480z"></path>
							</svg>
						</a>
						<a
							href={ "mailto:?subject=" + html.EscapeString(a.GetTitle()) + "&body=" + html.EscapeString(a.GetFeedTitle()) + ":%20" + html.EscapeString(a.GetLink()) }
							target="_blank"
							title="Send email"
							_={ "on click remove #share_" + a.GetID() + "_dialog" }
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor" class="size-8 hover:bg-primary hover:text-primary-content focus-visible:outline-primary rounded-md focus-visible:outline-2 focus-visible:outline-offset-2">
								<!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
								<path d="M112 128C85.5 128 64 149.5 64 176C64 191.1 71.1 205.3 83.2 214.4L291.2 370.4C308.3 383.2 331.7 383.2 348.8 370.4L556.8 214.4C568.9 205.3 576 191.1 576 176C576 149.5 554.5 128 528 128L112 128zM64 260L64 448C64 483.3 92.7 512 128 512L512 512C547.3 512 576 483.3 576 448L576 260L377.6 408.8C343.5 434.4 296.5 434.4 262.4 408.8L64 260z"></path>
							</svg>
						</a>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}
