package partials

import "github.com/joshuar/go-templ-daisyui/actions/modal"

// Modal displays a modal. The modal will have a close button in the top-right and can be closed by clicking outside.
templ Modal() {
	@modal.Build(ModalID.String(),
		modal.WithCloseButton(),
		modal.WithCloseOutside(),
	) {
		{ children... }
	}
}

// AskQuestion displays a modal that asks the given question, with the given actions as options.
templ AskQuestion(question string, attributes templ.Attributes) {
	@Modal() {
		<h3 class="font-bold">Unsubscribe from feed?</h3>
		<div class="modal-action">
			<form method="dialog" _={ "on click remove @open from " + ModalID.Target() + " then send removeModal" }>
				<button name="confirmation" value="yes" class="btn" { attributes... }>Yes</button>
				<button name="confirmation" value="cancel" class="btn">No</button>
			</form>
		</div>
	}
}
