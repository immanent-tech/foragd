import (
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

// Modal will render a modal with the given content.
templ Modal(id string) {
	{{ modalID := id + "-modal" }}
	<el-dialog id={ modalID }>
		<dialog id={ id } aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<div class="absolute top-0 right-0 hidden pt-4 pr-4 sm:block">
						<button
							type="button"
							command="close"
							commandfor={ id }
							_={ "on click remove " + modalID }
							class="rounded-md text-base-content hover:text-primary focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:outline-hidden"
						>
							<span class="sr-only">Close</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					{ children... }
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

// UnsubscribeModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ UnsubscribeModal(obj Object) {
	{{ id := "unsubscribe" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { obj.GetTitle() }?</p>
				</div>
			</div>
		</div>
		<div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
			<button
				type="button"
				hx-post={ "/remove/" + obj.Type() + "/" + obj.GetID() }
				hx-target={ "#" + obj.GetID() }
				hx-swap="outerHTML"
				_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
				hx-include="[name='csrf_token']"
				class="inline-flex w-full justify-center rounded-md bg-error/80 px-3 py-2 text-sm font-semibold text-error-content shadow-xs hover:bg-error sm:ml-3 sm:w-auto"
			>Unsubscribe</button>
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="mt-3 inline-flex w-full justify-center rounded-md bg-primary/80 px-3 py-2 text-sm font-semibold text-primary-content shadow-xs ring-1 ring-base-content/10 ring-inset hover:bg-primary sm:mt-0 sm:w-auto"
			>Cancel</button>
		</div>
	}
}
