package partials

templ ObfuscateEmail(email, label string) {
	<svg
		viewBox="0 0 12 12"
		xmlns="http://www.w3.org/2000/svg"
		class="w-fit"
	>
		<style>
text {
	dominant-baseline: middle;
	fill: #000;
    font-size: 6px;
	font-family: 'Inter';
	text-anchor: middle;
}
</style>
		<a class="link link-hover w-fit" href={ "mailto:" + email }>
			<text x="50%" y="50%">{ label }</text>
		</a>
	</svg>
}
