package partials

import "slices"

templ Card(options ...PropertiesOption) {
	{{
		props := NewProperties()
		for option := range slices.Values(options) {
			option(props)
		}
	}}
	<div
		class={ "card size-full overflow-hidden rounded-lg", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}

templ CardHeader() {
	<div class="px-4 py-5 sm:px-6">
		{ children... }
	</div>
}

templ CardBody() {
	<div class="card-body">
		{ children... }
	</div>
}

templ CardFooter(options ...PropertiesOption) {
	{{
		props := NewProperties()
		for option := range slices.Values(options) {
			option(props)
		}
	}}
	<div
		class={ "px-4 py-4 sm:px-6", props.Classes() }
		{ props.Attributes()... }
	>
		{ children... }
	</div>
}
