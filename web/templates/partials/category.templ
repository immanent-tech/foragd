package partials

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
)

templ CategoryManagement(path string, suggested []models.Category, existing []models.Category) {
	<div>
		<form
			id="add-categories"
			hx-post={ path }
			hx-on::after-request="if(event.detail.successful) this.reset()"
			hx-include="[name='csrf_token'],[name='user_categories']"
			hx-push-url="false"
			hx-target="#current-categories"
			hx-swap="beforeend"
			hx-trigger="submit"
		>
			<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
				<div>
					<label for="category" class="block text-sm/6 font-medium">Add category</label>
					<p id="category-hint" class="mt-3 text-sm/6 text-base-content/60">Optional. Add a category to the subscription.</p>
				</div>
				<div class="mt-2 sm:col-span-2 sm:mt-0">
					<div class="join">
						<el-autocomplete class="join-item">
							<label class="flex input input-primary bg-base-content/10">
								<input
									id="add-category"
									type="text"
									name="category"
									placeholder="Cool Stuff"
								/>
								<button
									if len(suggested) == 0 {
										hidden
									}
								>
									@tabler.ChevronDown(i.Props{Class: "size-4 text-primary"})
								</button>
							</label>
							<el-options popover anchor="bottom start">
								<div class="grid grid-cols-1 bg-base-content/10 p-4 text-sm/6 outline-1 -outline-offset-1 outline-neutral focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent sm:text-sm/6 capitalize">
									for category := range slices.Values(suggested) {
										<el-option value={ category }>{ category }</el-option>
									}
								</div>
							</el-options>
						</el-autocomplete>
						<button class="btn btn-primary join-item">
							@tabler.Plus(i.Props{Class: "size-4"})
						</button>
					</div>
				</div>
			</div>
		</form>
		// Show current categories.
		<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
			<label class="label block text-sm/6 font-medium sm:pt-1.5">Current Categories</label>
			<div class="mt-2 sm:col-span-2 sm:mt-0">
				<ul id="current-categories" class="-my-3 divide-y divide-base-content/10 px-6 py-4 text-sm/6">
					for category := range slices.Values(existing) {
						@AddCategory(path, category)
					}
				</ul>
			</div>
		</div>
	</div>
}

// AddCategory renders a new category item to the list of categories of a subscription.
templ AddCategory(path string, category models.Category) {
	{{ csrf_token := models.CSRFTokenFromCtx(ctx) }}
	<li class="flex flex-row items-center py-4 gap-x-4 group-hover:text-accent">
		<input type="hidden" name="user_categories" value={ category }/>
		{ category }
		<button
			hx-delete={ path }
			hx-push-url="false"
			hx-target="closest li"
			hx-swap="delete"
			hx-headers={ `{"X-CSRF-Token": "` + csrf_token + `"}` }
			class="btn btn-square btn-ghost"
		>
			@tabler.X(i.Props{Class: "size-4"})
		</button>
	</li>
}
