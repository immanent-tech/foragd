package partials

// Content is the container for the main content of the page.
templ Content(content templ.Component) {
	<div
		id={ ContentID.String() }
		class="m-2 h-full"
		hx-swap="morph:innerHTML"
		hx-target={ ContentID.Target() }
	>
		@content
	</div>
}
