package partials

import tabler "github.com/dimmerz92/go-icons/tabler-filled"

templ NoContent() {
	<div id="no-content" class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
		<div class="text-center">
			@tabler.Confetti(templ.Attributes{"class": "mx-auto text-accent size-12", "aria-hidden": "true"})
			<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance">All caught up!</h1>
			<p class="mt-6 text-lg font-medium text-pretty">Congratulations, you've read everything!</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				<a
					href="/favorites"
					hx-get="/favorites"
					hx-target="#content"
					hx-swap="innerMorph show:top transition:true"
					hx-nonce={ templ.GetNonce(ctx) }
					class="btn btn-accent"
				>
					View favorites
				</a>
			</div>
		</div>
	</div>
}
