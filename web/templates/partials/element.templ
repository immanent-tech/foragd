package partials

import (
	"slices"
	"sync"
)

// Option is a generic type for functional options.
type Option[T any] func(T)

type HTMLElement struct {
	sync.Mutex
	attributes templ.Attributes
}

func NewHTMLElement() HTMLElement {
	return HTMLElement{
		attributes: make(templ.Attributes),
	}
}

func (e *HTMLElement) SetAttribute(key string, value any) {
	e.Lock()
	defer e.Unlock()
	e.attributes[key] = value
}

type element interface {
	SetAttribute(key string, value any)
}

func WithHXGet(path string) Option[element] {
	return func(e element) {
		e.SetAttribute("hx-get", path)
	}
}

func WithCustomAttribute(key string, value any) Option[element] {
	return func(e element) {
		e.SetAttribute(key, value)
	}
}

type Link struct {
	HTMLElement
}

templ NewLink(options ...Option[element]) {
	{{ link := &Link{HTMLElement: NewHTMLElement()} }}
	for option := range slices.Values(options) {
		{{ option(link) }}
	}
	<a { link.attributes... }>
		{ children... }
	</a>
}
