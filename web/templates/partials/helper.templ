package partials

import "github.com/joshuar/go-templ-daisyui/actions/dropdown"
import "github.com/joshuar/go-templ-daisyui/modifiers/state"

templ HelperDropDown(content string) {
	@dropdown.BuildHelper(state.Info).Show() {
		<p>{ content }</p>
	}
}
