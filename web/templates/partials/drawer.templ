package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
)

var Favourites = attributes.ID("favourites")

// Drawer is the container for a full-page drawer
templ Drawer() {
	<div class="drawer">
		<input id="body-drawer" type="checkbox" class="drawer-toggle"/>
		{ children... }
	</div>
}

templ DrawerContent() {
	<div class="drawer-content">
		{ children... }
	</div>
}

templ DrawerSide() {
	<div class="drawer-side">
		<label for="body-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
		<ul class="menu bg-base-200 text-base-content text-xs min-h-full w-80 p-4">
			@MenuItemTitle("Navigation")
			@MenuItem(LinkHome(), nil)
			{ children... }
		</ul>
	</div>
}

// MenuItemTitle renders the text as a title element in the drawer side-bar menu.
templ MenuItemTitle(text string) {
	<li class="menu-title">{ text }</li>
}

// MenuItem renders an item element in the drawer side-bar menu.
templ MenuItem(content templ.Component, attributes templ.Attributes) {
	<li { attributes... }>
		if content != nil {
			@content
		} else {
			{ children... }
		}
	</li>
}

templ FavouritesList() {
	@MenuItem(nil, nil) {
		<details id={ Favourites.String() }>
			<summary>
				<div class="flex gap-2">
					@tabler.Stars()
					Favourites
				</div>
			</summary>
			<ul class="text-base-content text-xs">
				if favourites := models.GetUserFavourites(ctx); favourites != nil {
				for favourite := range slices.Values(favourites) {
					<li>
						@link.Build(
							link.WithContent(favourite.Name),
							link.WithExtraAttributes(templ.Attributes{
							"href": favourite.Link,
						}),
						).Show()
					</li>
				}
				} else {
					No favourites found.
				}
			</ul>
		</details>
	}
}
