package partials

import "github.com/joshuar/go-templ-daisyui/attributes"

// DrawerSubscriptionListID is the ID of the element containing the subscription list in the drawer.
var DrawerSubscriptionListID = attributes.ID("drawer-subscriptions-list")

// TriggerSubscriptionListUpdateHS is a hyperscript snippet to trigger an update of the subscription list in the drawer.
var TriggerSubscriptionListUpdateHS = "on htmx:afterRequest send UpdateState to " + DrawerSubscriptionListID.Target()

// Drawer is the container for a full-page drawer
templ Drawer(content templ.Component) {
	<div class="drawer">
		<input id="body-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="drawer-content">
			@content
		</div>
		<div class="drawer-side">
			<label for="body-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
			<ul class="menu bg-base-200 text-base-content text-xs min-h-full w-80 p-4">
				@MenuItemTitle("Navigation")
				@MenuItem(LinkHome(), nil)
				@MenuItem(nil, nil) {
					<details id={ DrawerSubscriptionListID.String() } hx-get="/subscriptions/state" hx-trigger="load" hx-target={ DrawerSubscriptionListID.Target() }></details>
				}
			</ul>
		</div>
	</div>
}

// MenuItemTitle renders the text as a title element in the drawer side-bar menu.
templ MenuItemTitle(text string) {
	<li class="menu-title">{ text }</li>
}

// MenuItem renders an item element in the drawer side-bar menu.
templ MenuItem(content templ.Component, attributes templ.Attributes) {
	<li { attributes... }>
		if content != nil {
			@content
		} else {
			{ children... }
		}
	</li>
}
