package partials

import "github.com/sebasvil20/templicons/tabler"

templ DrawerDefault() {
	<label for="body-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
	<div class="bg-base-200 text-base-content min-h-full w-80 p-4">
		@LinkWithIcon(tabler.Home(), "Home", templ.Attributes{
			"hx-get":      "/home",
			"hx-target":   ContentID.Target(),
			"hx-push-url": "true",
		}, nil)
		<div class="collapse">
			<input type="checkbox"/>
			<div class="collapse-title font-semibold">
				<div class="flex gap-2">
					@tabler.Rss()
					Subscriptions
				</div>
			</div>
			<div class="collapse-content text-sm">
				Click the "Sign Up" button in the top right corner and follow the registration process.
			</div>
		</div>
	</div>
	// <ul class="menu bg-base-200 text-base-content min-h-full w-80 p-4">
	// 	<li></li>
	// 	<!-- Sidebar content here -->
	// 	<li><a>Sidebar Item 1</a></li>
	// 	<li><a>Sidebar Item 2</a></li>
	// </ul>
}
