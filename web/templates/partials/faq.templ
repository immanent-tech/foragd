package partials

import (
	"encoding/json"
	"slices"
	"strings"
)

// FAQEntry represents a single question and answer pair.
type FAQEntry struct {
	ID       string
	Question string
	Answer   string
}

templ FAQ(entries []FAQEntry) {
	//  JSON-LD structured data for search engines.
	@RenderJSONLD("faq", faqJsonLD(entries))
	// Human-readable data.
	<dl class="mt-16 divide-y divide-accent">
		for entry := range slices.Values(entries) {
			@faqEntry(entry)
		}
	</dl>
}

templ faqEntry(entry FAQEntry) {
	<div class="py-6 first:pt-0 last:pb-0">
		<dt>
			<button
				type="button"
				command="--toggle"
				commandfor={ "faq-" + entry.ID }
				class="flex w-full items-start justify-between text-left"
			>
				<span class="text-base/7 font-semibold">{ entry.Question }</span>
				<span class="ml-6 flex h-7 items-center">
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
					</svg>
				</span>
			</button>
		</dt>
		<el-disclosure id={ "faq-" + entry.ID } hidden class="contents">
			<dd class="mt-2 pr-12">
				<div class="text-base/7">
					@templ.Raw(entry.Answer)
				</div>
			</dd>
		</el-disclosure>
	</div>
}

// faqJsonLD builds the JSON-LD FAQPage structured data payload.
func faqJsonLD(entries []FAQEntry) json.RawMessage {
	type mainEntity struct {
		Type           string `json:"@type"`
		Name           string `json:"name"`
		AcceptedAnswer struct {
			Type string `json:"@type"`
			Text string `json:"text"`
		} `json:"acceptedAnswer"`
	}

	type faqPage struct {
		Context    string       `json:"@context"`
		Type       string       `json:"@type"`
		MainEntity []mainEntity `json:"mainEntity"`
	}

	page := faqPage{
		Context:    "https://schema.org",
		Type:       "FAQPage",
		MainEntity: make([]mainEntity, 0, len(entries)),
	}

	for _, e := range entries {
		entity := mainEntity{
			Type: "Question",
			Name: e.Question,
		}
		entity.AcceptedAnswer.Type = "Answer"
		entity.AcceptedAnswer.Text = strings.Join(strings.Fields(e.Answer), " ")
		page.MainEntity = append(page.MainEntity, entity)
	}

	b, _ := json.MarshalIndent(page, "", "  ")
	return b
}
