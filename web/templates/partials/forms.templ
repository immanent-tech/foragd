package partials

import tabler "github.com/dimmerz92/go-icons/tabler-outline"

templ FormSection() {
	<div class="mt-10 space-y-8 border-b border-neutral/20 pb-12 sm:space-y-0 sm:divide-y sm:divide-base-300 sm:border-t sm:border-t-base-300 sm:pb-0">
		{ children... }
	</div>
}

templ FormField() {
	<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
		{ children... }
	</div>
}

templ FormDisclosure(label string) {
	<button type="button" command="--toggle" commandfor="customisation" class="flex w-full items-center justify-between text-left">
		<h3 class="mt-4 mb-2 scroll-mt-1.5 text-lg font-medium sm:mt-8 sm:mb-4">{ label }</h3>
		<span class="ml-6 flex h-7 items-center">
			@tabler.Plus(templ.Attributes{"class": "size-6 in-aria-expanded:hidden"})
			@tabler.Minus(templ.Attributes{"class": "size-6 not-in-aria-expanded:hidden"})
		</span>
	</button>
	<el-disclosure hidden id="customisation">
		{ children... }
	</el-disclosure>
}
