package partials

import (
	"github.com/immanent-tech/foragd/models"
	"slices"
)

// SubscriptionSuggestions renders the given subscriptions as options for an autocomplete dropdown.
templ SubscriptionSuggestions(subscriptions models.Subscriptions) {
	for subscription := range slices.Values(subscriptions) {
		<el-option value={ subscription.GetTitle() }>
			<input type="hidden" name={ "subscription_suggestions[" + subscription.GetID() + "]" } value={ subscription.GetTitle() }/>
			{ subscription.GetTitle() }
		</el-option>
	}
}
