package partials

// PullToRefresh loads a hyperscript behaviour and sentinel element for controlling pull-to-refresh behavior on an
// element. Usage:
//
//  <div class="ptr-scroll" _="install PullToRefresh(threshold: 70)">
//      <!-- Element that can be pulled -->
//      <div class="ptr-content">
//          <!-- Content that will be refreshed. -->
//      </div>
//  </div>
templ PullToRefresh() {
	<script type="text/hyperscript">
  behavior PullToRefresh(threshold)
    init
      set my.startY to 0
      set my.pulling to false
      set my.refreshing to false
      set my.content to the first <.ptr-content/> in me
      set my.canPtr to false
    end

    on ptrSentinelVisible from #ptr-sentinel
      set my.canPtr to true
    end

    on ptrSentinelHidden from #ptr-sentinel
      set my.canPtr to false
    end

    on touchstart
      -- only start tracking a pull if the container is already at the top
      if my.canPtr and not my.refreshing
        set my.startY to event.touches[0].clientY
        set my.pulling to true
      end
    end

    on touchmove
      if my.pulling and not my.refreshing
        set dy to event.touches[0].clientY - my.startY
        if dy > 0
          -- we're pulling down on an already-topped-out list: take over the gesture
          halt the event
          set drag to Math.min(dy * 0.45, threshold * 1.6)
          set my.content's *transform to `translateY(${drag}px)`
          if drag >= threshold
            add .armed to me
          else
            remove .armed from me
          end
        end
      end
    end

    on touchend or touchcancel
      if my.pulling and not my.refreshing
        set my.pulling to false
        if I match .armed
          set my.refreshing to true
          remove .armed from me
          add .refreshing to me
          set my.content's *transform to `translateY(${threshold}px)`
          trigger refresh on the first <[hx-trigger~="refresh"]/> in me
          -- safety net in case the request never resolves / no htmx target
          wait for refreshComplete or 6s
          remove .refreshing from me
          set my.content's *transform to `translateY(0px)`
          set my.refreshing to false
        else
          set my.content's *transform to `translateY(0px)`
        end
      end
    end

    -- also support desktop testing with a mouse-drag simulation
    on mousedown
      if my.canPtr <= 0 and not my.refreshing
        set my.startY to event.clientY
        set my.pulling to true
        set my.mouseSim to true
      end
    end
    on mousemove from the document
      if my.pulling and my.mouseSim and not my.refreshing
        set dy to event.clientY - my.startY
        if dy > 0
          set drag to Math.min(dy * 0.45, threshold * 1.6)
          set my.content's *transform to `translateY(${drag}px)`
          if drag >= threshold then add .armed to me else remove .armed from me end
        end
      end
    end
    on mouseup from the document
      if my.pulling and my.mouseSim and not my.refreshing
        set my.pulling to false
        set my.mouseSim to false
        if I match .armed
          set my.refreshing to true
          remove .armed from me
          add .refreshing to me
          set my.content's *transform to `translateY(${threshold}px)`
          trigger refresh on the first <[hx-trigger~="refresh"]/> in me
          wait for refreshComplete or 6s
          remove .refreshing from me
          set my.content's *transform to `translateY(0px)`
          set my.refreshing to false
        else
          set my.content's *transform to `translateY(0px)`
        end
      end
    end

  end
</script>
	<div
		id="ptr-sentinel"
		style="height:1px;"
		_="
		on intersection(intersecting)
			if intersecting
				send ptrSentinelVisible
			else
				send ptrSentinelHidden
			end
		end
		"
	></div>
}
