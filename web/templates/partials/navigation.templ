package partials

import "github.com/joshuar/go-templ-daisyui/navigation/link"
import "github.com/joshuar/go-templ-daisyui/actions/button"

templ LinkWithIcon(icon templ.Component, label string, attributes templ.Attributes, classes []string) {
	<div class="flex gap-2">
		@icon
		@link.Build(
			link.WithContent(label),
			link.WithUnderlineOnHover(),
			link.WithExtraAttributes(attributes),
			link.WithExtraClasses(classes...),
		).Show()
	</div>
}

templ ButtonLink(icon templ.Component, label string, attributes templ.Attributes, classes []string) {
	@button.Build(
		button.WithExtraAttributes(attributes),
		button.WithStyle(button.Ghost),
		button.WithSize(button.SM),
	).Show() {
		@icon
		<span>{ label }</span>
	}
}
