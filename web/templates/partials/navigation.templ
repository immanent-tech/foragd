package partials

import (
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

templ SubscriptionList() {
	<select class="select select-ghost">
		<option disabled selected>Pick a font</option>
		<option>Inter</option>
		<option>Poppins</option>
		<option>Raleway</option>
	</select>
}

// LinkMarkRead generates a link showing an icon and the given text that will trigger the action with the given attributes.
templ LinkMarkRead(text string, attributes templ.Attributes) {
	@link.Build(
		link.WithAttributes(attributes),
		link.WithClasses("text-xs"),
	) {
		<div class="flex gap-2">
			@tabler.Bookmark(i.Props{Size: i.SizeXS})
			{ text }
		</div>
	}
}

// LinkMarkUnread generates a link showing an icon and the given text that will trigger the action with the given attributes.
templ LinkMarkUnread(text string, attributes templ.Attributes) {
	@link.Build(
		link.WithAttributes(attributes),
		link.WithClasses("text-xs"),
	) {
		<div class="flex gap-2">
			@tabler.BookmarkFilled(i.Props{Size: i.SizeXS})
			{ text }
		</div>
	}
}

templ RefreshButton(route string, parameters map[string]string) {
	@NewAction(route, DisplayActionAsButton,
		ActionInclude("#content-filters"),
		ActionValues(parameters),
		ActionButtonOptions(
			button.WithExtraClasses(button.Square, button.SM, button.Primary),
		),
	) {
		@tabler.Refresh(i.Props{Size: i.SizeXS})
	}
}
