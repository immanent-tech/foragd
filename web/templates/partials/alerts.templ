package partials

import "github.com/joshuar/go-feed-me/models"

// WarningMessage renders the given message in a warning style.
templ WarningMessage(msg *models.UserMessage) {
	<div class="ml-3">
		<h3 class="text-sm font-medium text-warning">{ msg.Summary }</h3>
		if msg.HasDetails() {
			<div class="mt-2 text-sm text-warning/80">
				<p>{ msg.Details }</p>
			</div>
		}
		{ children... }
	</div>
}

// ErrorMessage renders the given message in an error style.
templ ErrorMessage(msg *models.UserMessage) {
	<div class="ml-3">
		<h3 class="text-sm font-medium text-error">{ msg.Summary }</h3>
		if msg.HasDetails() {
			<div class="mt-2 text-sm text-error/80">
				<p>{ msg.Details }</p>
			</div>
		}
		{ children... }
	</div>
}

// SuccessMessage renders the given message in a success style.
templ SuccessMessage(msg *models.UserMessage) {
	<div class="ml-3">
		<h3 class="text-sm font-medium text-success">{ msg.Summary }</h3>
		if msg.HasDetails() {
			<div class="mt-2 text-sm text-success/80">
				<p>{ msg.Details }</p>
			</div>
		}
		{ children... }
	</div>
}

// FormSuccess renders a div that can be used to highlight successful form submission details.
templ FormSuccess() {
	<div class="rounded-md bg-success/10 p-4 outline outline-success/20">
		<div class="flex">
			<div class="shrink-0">
				@HeroIconSuccess("size-5", "text-success")
			</div>
			{ children... }
		</div>
	</div>
}

// FormWarning renders a div that can be used to highlight a warning about form submission.
templ FormWarning() {
	<div class="rounded-md bg-warning/10 p-4 outline outline-warning/15">
		<div class="flex">
			<div class="shrink-0">
				@HeroIconWarn("size-5", "text-warning")
			</div>
			{ children... }
		</div>
	</div>
}

// FormError renders a div that can be used to highlight an error about form submission.
templ FormError() {
	<div class="rounded-md bg-error/10 p-4 outline outline-error/15">
		<div class="flex">
			<div class="shrink-0">
				@HeroIconError("size-5", "text-error")
			</div>
			{ children... }
		</div>
	</div>
}
