package partials

templ ReadingProgress() {
	<div class="fixed top-16 left-0 z-10 h-1 w-full bg-base-100">
		<div class="h-full origin-left transform-border transform-[scaleX(0)] animate-growbar bg-accent"></div>
	</div>
