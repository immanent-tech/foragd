package partials

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/display/text"
	"github.com/joshuar/go-templ-daisyui/input/fieldset"
	"github.com/joshuar/go-templ-daisyui/input/form"
	"github.com/joshuar/go-templ-daisyui/input/hiddeninput"
	"github.com/joshuar/go-templ-daisyui/input/textinput"
)

// FavoriteLink generates a link to the given favorite.
templ FavoriteLink(fav *models.Favorite, classes ...components.Class) {
	switch fav.Type {
		case models.FavoriteTypeSubscription:
			// FavouriteSubscription.
			{{ values := session.SubscriptionFiltersFromSession(ctx).Parameters() }}
			{{ values[models.ParamSubscriptions] = fav.GetID() }}
			@NewAction("/subscriptions", DisplayActionAsLink,
				ActionValues(values),
				ActionPushURL(),
				ActionHyperScript("on click call document.activeElement.blur() end"),
				ActionClasses(classes...),
			) {
				@HeroIconSubscription("size-4")
				{ fav.String() }
			}
		case models.FavoriteTypeArticle:
			// FavoriteArticle.
			@NewAction("/article/"+fav.GetID(), DisplayActionAsLink,
				ActionPushURL(),
				ActionHyperScript("on click call document.activeElement.blur() end"),
				ActionClasses(classes...),
			) {
				@HeroIconArticle("size-4")
				{ fav.String() }
			}
		case models.FavoriteTypeSearch:
			// FavoriteArticle.
			{{ search, err := fav.ObjectData.AsFavoriteSearch() }}
			if err != nil {
				@NewAction("/search/results", DisplayActionAsLink,
					ActionPushURL(),
					ActionHyperScript("on click call document.activeElement.blur() end"),
					ActionValues(map[string]string{"text": search.Text}),
					ActionClasses(classes...),
				) {
					@HeroIconSearch("size-4")
					{ fav.String() }
				}
			}
	}
}

templ AddFavoriteSearchModal(action *Action, search string) {
	@Modal() {
		@text.Build(text.WithSize(text.LG)) {
			Add Favorite
		}
		@form.Build(
			form.WithID("add-favorite"),
		) {
			@hiddeninput.Build(
				hiddeninput.WithName("text"),
				hiddeninput.WithValue(search),
			)
			@fieldset.Build() {
				<label class="fieldset-label">Nickname (optional)</label>
				@textinput.Build(
					textinput.WithName("nickname"),
				).Show()
			}
		}
		@fieldset.Build() {
			@action
		}
	}
}
