package partials

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
)

// GenerateAvatar will render an image appropriate to use as an "avatar" for the object.
templ GenerateAvatar(obj models.Object) {
	// Generate a thumbnail to display next to the title.
	if img := obj.GetImage(); img != nil {
		// If the source has an image, use that as the avatar.
		<div class="avatar">
			<div class="rounded-box size-12">
				<img
					src={ img.GetURL() }
					if img.GetTitle() != "" {
						alt={ img.GetTitle() }
					}
				/>
			</div>
		</div>
	} else {
		// Otherwise, take the first letter of the title and create a placeholder avatar.
		<div class="avatar avatar-placeholder">
			<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
				<span class="text-3xl capitalize">{ obj.GetTitle()[0:1] }</span>
			</div>
		</div>
	}
}

// ViewObjectLink will render a link for viewing an object.
templ ViewObjectLink(obj models.Object, include string, vals map[string]string, classes ...string) {
	<a
		hx-get={ obj.ViewURL() }
		if include != "" {
			hx-include={ include }
		}
		if vals != nil {
			hx-vals={ models.GenerateHXVals(vals) }
		}
		hx-target={ ContentID.Target() }
		hx-push-url="true"
		hx-swap="innerHTML show:top"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// FavoriteObjectLink will render a link for toggling the favorite status of the object.
templ FavoriteObjectLink(obj models.Object, classes ...string) {
	<a
		if obj.IsFavorite() {
			hx-post={ "/user/favorite/remove/" + string(obj.Type()) + "/" + obj.GetID() }
		} else {
			hx-post={ "/user/favorite/add/" + string(obj.Type()) + "/" + obj.GetID() }
		}
		hx-target={ "#favorite_" + obj.GetID() }
		hx-include="[name='csrf_token']"
		class={ "link link-hover", classes }
	>
		switch obj.IsFavorite() {
			case true:
				@tabler.HeartFilled(i.Props{Class: "size-4"})
				Remove Favorite
			case false:
				@tabler.Heart(i.Props{Class: "size-4"})
				Add Favorite
		}
	</a>
}

// ToggleFavorite renders an updated favorite link based on the object's favorite status.
templ ToggleFavorite(obj models.Object) {
	@FavoriteObjectLink(obj, "menu-item")
}

// MarkObjectLink will render a link for toggling the mark status of the object.
templ MarkObjectLink(obj models.Object, target, swap string, classes ...string) {
	<a
		hx-post={ obj.MarkURL() }
		hx-include="[name='csrf_token']"
		hx-target={ target }
		hx-swap={ swap }
		class={ "link link-hover", classes }
	>
		switch obj.IsUnread() {
			case true:
				@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
				Mark Read
			case false:
				@tabler.MailFilled(i.Props{Class: "size-4"})
				Mark Unread
		}
	</a>
}
