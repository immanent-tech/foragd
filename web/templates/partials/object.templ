package partials

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/go-syndication/types"
	"time"
)

type Object interface {
	GetID() string
	GetImage() *types.ImageInfo
	GetUpdatedDate() time.Time
	GetTitle() string
	GetDescription() string
	IsUnread() bool
	IsFavorite() bool
	Type() string
	ViewURL() string
	MarkURL() string
}

// GenerateAvatar will render an image appropriate to use as an "avatar" for the object.
templ GenerateAvatar(obj Object) {
	// Generate a thumbnail to display next to the title.
	if img := obj.GetImage(); img != nil {
		// If the source has an image, use that as the avatar.
		<div class="avatar">
			<div class="rounded-box size-12">
				<img
					src={ img.GetURL() }
					if img.GetTitle() != "" {
						alt={ img.GetTitle() }
					}
				/>
			</div>
		</div>
	} else {
		// Otherwise, take the first letter of the title and create a placeholder avatar.
		<div class="avatar avatar-placeholder">
			<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
				<span class="text-3xl capitalize">{ obj.GetTitle()[0:1] }</span>
			</div>
		</div>
	}
}

// ViewObjectLink will render a link for viewing an object.
templ ViewObjectLink(obj Object, include string, vals map[string]string, classes ...string) {
	<a
		hx-get={ obj.ViewURL() }
		if include != "" {
			hx-include={ include }
		}
		if vals != nil {
			hx-vals={ models.GenerateHXVals(vals) }
		}
		hx-target={ ContentID.Target() }
		hx-push-url="true"
		hx-swap="innerHTML show:top"
		class={ "link link-hover", classes }
	>
		{ children... }
	</a>
}

// FavoriteObjectLink will render a link for toggling the favorite status of the object.
templ FavoriteObjectLink(obj Object, classes ...string) {
	<a
		if obj.IsFavorite() {
			hx-post={ "/user/favorite/remove/" + obj.Type() + "/" + obj.GetID() }
		} else {
			hx-post={ "/user/favorite/add/" + obj.Type() + "/" + obj.GetID() }
		}
		hx-target={ "#favorite_" + obj.GetID() }
		hx-include="[name='csrf_token']"
		class={ "link link-hover", classes }
	>
		switch obj.IsFavorite() {
			case true:
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
					<path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"></path>
				</svg>
				Remove Favorite
			case false:
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
				</svg>
				Add Favorite
		}
	</a>
}

// ToggleFavorite renders an updated favorite link based on the object's favorite status.
templ ToggleFavorite(obj Object) {
	@FavoriteObjectLink(obj, "menu-item")
}

// MarkObjectLink will render a link for toggling the mark status of the object.
templ MarkObjectLink(obj Object, target, swap string, classes ...string) {
	<a
		hx-post={ obj.MarkURL() }
		hx-include="[name='csrf_token']"
		hx-target={ target }
		hx-swap={ swap }
		class={ "link link-hover", classes }
	>
		switch obj.IsUnread() {
			case true:
				@ReadIcon("size-4")
				Mark Read
			case false:
				@UnreadIcon("size-4")
				Mark Unread
		}
	</a>
}
