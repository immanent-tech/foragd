package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"slices"
)

// ListFavorites renders subscription and article favorites in a grid layout.
templ ListFavorites(response *models.ListFavoritesResponse) {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Favorites</h1>
				if len(response.Subscriptions) > 0 || len(response.Articles) > 0 {
					// Show jump to links for quick access when there are both subscriptions and articles.
					<div class="mx-auto w-full navbar justify-center">
						<a href="#subscriptions" class="link link-hover">Subscriptions</a>
						<div aria-hidden="true" class="h-5 w-px bg-base-300 m-4 block"></div>
						<a href="#articles" class="link link-hover">Articles</a>
					</div>
					// Favorite subscriptions.
					if len(response.Subscriptions) > 0 {
						<section id="subscriptions" class="mt-4">
							<div class="pb-5">
								<h2 class="mt-4 mb-2 scroll-mt-16 text-xl/7 font-semibold tracking-tight sm:mt-8 sm:mb-4 sm:text-2xl">Subscriptions</h2>
							</div>
							@grid() {
								for idx, subscription := range response.Subscriptions {
									@SubscriptionCard(idx, subscription) {
										if response.LatestArticles != nil {
											{{ itemsData, ok := response.LatestArticles.Load(subscription.GetID()) }}
											if ok {
												{{ items, ok := itemsData.(models.Items) }}
												if ok {
													<div class="mt-auto h-full">
														<ul role="list" class="latest-items list-disc pl-5 marker:text-accent">
															for item := range slices.Values(items) {
																<li
																	hx-get={ "/view/article/" + item.GetID() }
																	hx-target={ ContentID.Target() }
																	hx-swap="innerHTML show:window:top transition:true"
																	hx-trigger="click"
																	hx-push-url="true"
																	_="on click halt the event's bubbling"
																	class="my-2 link text-pretty link-hover"
																>{ item.GetTitle() }</li>
															}
														</ul>
													</div>
												}
											}
										}
									}
								}
							}
							@partials.ButtonBackToTop()
						</section>
					}
					// Favorite articles.
					if len(response.Articles) > 0 {
						<section id="articles" class="mt-4">
							<div class="pb-5">
								<h2 class="mt-4 mb-2 scroll-mt-16 text-xl/7 font-semibold tracking-tight sm:mt-8 sm:mb-4 sm:text-2xl">Articles</h2>
							</div>
							@grid() {
								for idx, article := range response.Articles {
									@ArticleCard(idx, article)
								}
							}
							@partials.ButtonBackToTop()
						</section>
					}
					@partials.ButtonBackToTop()
				} else {
					// Show a message when the user has no favorites.
					<div class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
						<div class="text-center">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart-question mx-auto text-accent size-12">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.105 17.915l-2.105 2.085l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 0 1 8.524 5.127"></path><path d="M19 22v.01"></path><path d="M19 19a2.003 2.003 0 0 0 .914 -3.782a1.98 1.98 0 0 0 -2.414 .483"></path>
							</svg>
							<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance">Nothing here</h1>
							<p class="mt-6 text-lg font-medium text-pretty">Add a favorite subscription or article and it will show up here.</p>
						</div>
					</div>
				}
			}
		}
	}
}
