package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/helpers/mailto"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/sebasvil20/templicons/tabler"
	"os"
	"strings"
	"time"
)

templ UserSettings() {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				<div
					class="tabs-box mt-8 tabs"
					hx-trigger="load once"
					hx-get="/user/settings/display"
					hx-target="#current-settings"
				>
					<input
						type="radio"
						name="settings_tabs"
						class="tab"
						aria-label="Display"
						checked="checked"
						hx-get="/user/settings/display"
						hx-target="#current-settings"
					/>
					<input
						type="radio"
						name="settings_tabs"
						class="tab"
						aria-label="Account"
						hx-get="/user/settings/account"
						hx-target="#current-settings"
					/>
				</div>
				<section id="current-settings"></section>
			}
		}
	}
}

templ AccountSettings(user *models.User) {
	<div id="account-settings" class="grid max-w-7xl grid-cols-1 gap-x-8 gap-y-10 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
		<div>
			@partials.Heading3() {
				Subscription Plan
			}
			<p class="mt-1 text-sm/6">
				if trial, endDate := user.OnTrial(); trial {
					{ user.GetSubscriptionPlan() +" (trial, ending on "+endDate.Format(time.DateOnly)+")" }
				} else if cancelled, endDate := user.Cancelled(); cancelled {
					{ user.GetSubscriptionPlan() +" (cancelled, ending on "+endDate.Format(time.DateOnly)+")" }
				} else {
					{ user.GetSubscriptionPlan() }
				}
			</p>
		</div>
		<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
			<div class="gap-4 sm:col-span-full">
				if mgmtLink := os.Getenv("FORAGD_STRIPE_SUBCRIPTIONMGMTURL"); mgmtLink != "" {
					<a role="button" class="btn btn-primary" href={ mgmtLink }>Manage Subscription Plan</a>
				} else {
					<a
						role="button"
						href={ mailto.Build("support@immanent.tech", mailto.WithSubject("Foragd Subscription Question")) }
						class="btn btn-primary"
					>
						Email support to manage your subscription
					</a>
				}
			</div>
		</div>
		<div>
			@partials.Heading3() {
				Import/Export
			}
			@partials.Paragraph() {
				Import or Export your subscriptions.
			}
		</div>
		<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
			<div class="sm:col-span-full">
				<button
					type="button"
					class="btn btn-primary"
					hx-push-url="true"
					hx-get="/user/import"
					hx-target={ ContentID.Target() }
				>Import</button>
				<button
					type="button"
					class="btn btn-primary"
					hx-push-url="true"
					hx-get="/user/export"
					hx-target={ ContentID.Target() }
				>Export</button>
			</div>
		</div>
		if !strings.HasPrefix(user.GetExternalID(),"auth0|") {
			<div class="col-span-full">
				@partials.Heading3() {
					Edit Account
				}
				@partials.Paragraph() {
					Your account is provided by an external service provider such as Google or Facebook, please log in to your account on the external service to make changes to your nickname, email, avatar or password.
				}
			</div>
		} else {
			// Account customisation.
			<div>
				@partials.Heading3() {
					Edit Account
				}
				@partials.Paragraph() {
					Use an email address that can receive messages.
				}
			</div>
			<form
				hx-post="/user/settings/account"
				hx-swap="none"
				hx-encoding="multipart/form-data"
				class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2"
			>
				<div class="sm:col-span-full">
					<label for="nickname" class="block text-sm/6 font-medium">Nickname</label>
					<div class="mt-2">
						<input
							id="nickname"
							type="text"
							class="validator input bg-base-content/10 input-primary invalid:input-error"
							placeholder="Nickname"
							name="nickname"
							required
							value={ user.GetNickname() }
						/>
						<p class="validator-hint">Nickname is required</p>
					</div>
				</div>
				<div class="sm:col-span-full">
					<label for="nickname" class="block text-sm/6 font-medium">Email</label>
					<div class="mt-2">
						<input
							id="email"
							type="email"
							class="validator input bg-base-content/10 input-primary invalid:input-error"
							placeholder="Email"
							name="email"
							required
							value={ user.GetEmail() }
						/>
						<p class="validator-hint">Must be a valid email address</p>
					</div>
				</div>
				<div class="sm:col-span-full">
					<label for="avatar" class="block text-sm/6 font-medium">Avatar</label>
					<p class="text-sm/6 text-base-content/80">Use a JPG, PNG or WEBP image. Max size 1MB.</p>
					<div class="mt-2 flex items-center space-x-2">
						@UserAvatar(user, nil)
						<input
							id="avatar"
							type="file"
							class="file-input flex bg-base-content/10 file-input-primary"
							name="avatar"
							accept=".jpg,.png,.webp"
						/>
					</div>
				</div>
				<input type="hidden" name="avatar_url" value={ user.GetAvatar() }/>
				<div class="col-span-full place-self-end">
					<div id="processing" class="htmx-indicator">
						Processing...
						<span class="loading loading-md loading-spinner"></span>
					</div>
					<div class="mt-2 flex items-center justify-end gap-x-6">
						<button type="submit" class="btn btn-primary">Save</button>
					</div>
				</div>
			</form>
			// Change password.
			<div>
				@partials.Heading3() {
					Change Password
				}
				@partials.Paragraph() {
					Update your password associated with your account.
				}
			</div>
			<form
				hx-post="/user/settings/password"
				hx-swap="none"
				class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2"
			>
				<div class="sm:col-span-full">
					<label for="new-password" class="block text-sm/6 font-medium">New Password</label>
					<div class="mt-2">
						<input id="nickname" type="password" class="input bg-base-content/10 input-primary" name="new_password" required/>
					</div>
				</div>
				<div class="sm:col-span-full">
					<label for="nickname" class="block text-sm/6 font-medium">Confirm New Password</label>
					<div class="mt-2">
						<input id="nickname" type="password" class="input bg-base-content/10 input-primary" name="confirm_new_password" required/>
					</div>
				</div>
				<div class="col-span-full place-self-end">
					<div id="processing" class="htmx-indicator">
						Processing...
						<span class="loading loading-md loading-spinner"></span>
					</div>
					<div class="mt-2 flex items-center justify-end gap-x-6">
						<button type="submit" class="btn btn-primary">Change Password</button>
					</div>
				</div>
			</form>
		}
		// Subscription Email
		<div>
			@partials.Heading3() {
				Subcribe to Email Newsletters
			}
			@partials.Paragraph() {
				Use or generate an email for subscribing to email newsletters.
			}
		</div>
		<div id="subscription-email" class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
			if user.Settings.SubscriptionEmail == nil {
				<form
					hx-post="/user/settings/subscriptionemail"
					hx-target="#subscription-email"
					hx-swap="innerHTML transition:true"
					class="col-span-full"
				>
					<div class="col-span-full place-self-end">
						<div id="processing" class="htmx-indicator">
							Processing...
							<span class="loading loading-md loading-spinner"></span>
						</div>
						<div class="mt-2 flex items-center justify-end gap-x-6">
							<button type="submit" class="btn btn-primary">Generate Email Address</button>
						</div>
					</div>
				</form>
			} else {
				@ShowSubscriptionEmail(*user.Settings.SubscriptionEmail)
			}
		</div>
		if cancelled, _ := user.Cancelled(); cancelled {
			<div>
				@partials.Heading3() {
					Cancel deactivation
				}
				@partials.Paragraph() {
					Change of mind? You can cancel the deactivation of your account and restore it to full functionality. You'll continue to get billed at the start of your next billing cycle.
				}
			</div>
			<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
				<div class="sm:col-span-full">
					<form
						hx-post={ models.RouteUserCancelDeactivationAccount }
						hx-target={ partials.ModalContainerID.Target() }
						class="flex items-start md:col-span-2"
					>
						<button type="submit" class="btn btn-success">
							Yes, please cancel the deactivation
						</button>
					</form>
				</div>
			</div>
		} else if user.Active() {
			// Show action to deactivate account.
			<div>
				@partials.Heading3() {
					Deactivate Account
				}
				@partials.Paragraph() {
					No longer want to use our service? You can deactivate your account here.
				}
			</div>
			<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
				<ul class="col-span-full mt-1 list-inside list-disc text-sm/6">
					<li>
						Your active subscription plan will be cancelled and stop at your next billing period.
					</li>
					<li>
						Until then, you can continue to use your account.
					</li>
					<li>
						If you change your mind, you can come
						back here before the cancellation date and stop the cancellation.
					</li>
					<li>
						After the cancellation
						date, your account (including all subscriptions, favorites and settings) will be permanently
						deleted. You will no longer be able to log in.
					</li>
				</ul>
				<div class="col-span-full place-self-end">
					<div id="processing" class="htmx-indicator">
						Processing...
						<span class="loading loading-md loading-spinner"></span>
					</div>
					<div class="mt-2 flex items-center justify-end gap-x-6">
						<form
							hx-get={ models.RouteUserDeactivateAccount }
							hx-target={ partials.ModalContainerID.Target() }
							class="flex items-start md:col-span-2"
						>
							<button type="submit" class="btn btn-error">
								Yes, deactivate my account
							</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
}

templ DisplaySettings(user *models.User) {
	<div id="display-settings">
		// Display settings.
		<div id="behaviour-settings" class="grid max-w-7xl grid-cols-1 gap-x-8 gap-y-10 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
			<div>
				@partials.Heading3() {
					Behaviour
				}
				@partials.Paragraph() {
					Settings that control the display behaviour in the app.
				}
			</div>
			<form
				hx-post="/user/settings/display"
				hx-swap="none"
				hx-include="#theme-settings"
				class="col-span-full space-y-10 md:col-span-2"
			>
				<div class="flex items-center gap-x-4">
					<input
						id="setting-show-subscription-stats"
						type="checkbox"
						name="show_subscription_stats"
						if user.GetSettings().ShowSubscriptionStats {
							checked
						}
						aria-describedby="setting-show-subscription-stats-description"
						class="toggle col-start-1 row-start-1 toggle-primary toggle-sm"
					/>
					<div class="flex-1 text-sm/6">
						<label for="setting-show-subscription-stats" class="font-medium">Show Subscription Stats</label>
						<p id="setting-show-subscription-stats-description" class="text-base-content/80">
							Controls whether to show various stats (e.g., unread counts, articles per day) on subscriptions.
						</p>
					</div>
				</div>
				<div class="flex items-center gap-x-4">
					<input
						id="setting-mark-article-read-on-view"
						type="checkbox"
						name="mark_article_read_on_view"
						if user.GetSettings().MarkArticleReadOnView {
							checked
						}
						aria-describedby="setting-mark-article-read-on-view-description"
						class="toggle col-start-1 row-start-1 toggle-primary toggle-sm"
					/>
					<div class="flex-1 text-sm/6">
						<label for="setting-mark-article-read-on-view" class="font-medium">Mark Article Read on View</label>
						<p id="setting-mark-article-read-on-view-description" class="text-base-content/80">
							When viewing an article, mark it as read automatically when viewed.
						</p>
					</div>
				</div>
				<div class="flex flex-col items-center space-y-4 space-x-4 sm:flex-row">
					<div class="flex-1 text-sm/6">
						<label for="setting-max-view-history" class="font-medium">Max View History</label>
						<p id="setting-mark-article-read-on-view-description" class="text-base-content/80">
							Controls the max age of articles to show (read or unread). It does not affect searches.
						</p>
					</div>
					<select class="select" name="max_view_history">
						// NOTE: these are in hours for readability, need to be multiplied to nanoseconds before storing.
						<option
							value="168"
							if user.GetSettings().MaxViewHistory.Hours() == 168 {
								selected
							}
						>Last week</option>
						<option
							value="730"
							if user.GetSettings().MaxViewHistory.Hours() == 730 {
								selected
							}
						>Last month</option>
						<option
							value="4383"
							if user.GetSettings().MaxViewHistory.Hours() == 4383 {
								selected
							}
						>Last six months</option>
					</select>
				</div>
				<div class="col-span-full place-self-end">
					<div id="processing" class="htmx-indicator">
						Processing...
						<span class="loading loading-md loading-spinner"></span>
					</div>
					<div class="mt-2 flex items-center justify-end gap-x-6">
						<button type="submit" class="btn btn-primary">Save</button>
					</div>
				</div>
			</form>
		</div>
		// Theme settings.
		<div id="theme-settings" class="grid max-w-7xl grid-cols-1 gap-x-8 gap-y-10 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
			<div class="md:col-span-full">
				@partials.Heading3() {
					Theme
				}
				@partials.Paragraph() {
					Choose a theme from the selection below. It will be applied instantly.
				}
			</div>
			// * Changing themes here also requires updating the list in styles.css.
			<div class="col-span-full grid max-w-7xl grid-cols-1 gap-x-8 gap-y-10 px-4 pb-16 sm:px-6 md:grid-cols-3 lg:px-8">
				{{ currentTheme := user.GetSettings().Theme }}
				@themePreview("greenhouse", currentTheme)
				@themePreview("light", currentTheme)
				@themePreview("dark", currentTheme)
				@themePreview("latte", currentTheme)
				@themePreview("mocha", currentTheme)
				@themePreview("nord", currentTheme)
				@themePreview("dracula", currentTheme)
				@themePreview("solarized-dark", currentTheme)
			</div>
		</div>
	</div>
}

templ ShowSubscriptionEmail(email string) {
	<p class="col-span-full mt-1 text-sm/6">This is your unique subscription email. Use it in place of your own email to subscribe to email newsletters.</p>
	<div class="join col-span-full join-vertical sm:join-horizontal">
		<input type="text" class="input join-item w-full input-primary" value={ email } readonly/>
		<button
			class="btn join-item btn-outline btn-primary"
			_={ "on click set currentValue to (my innerHTML) then writeText('" + email + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
		>
			@tabler.Copy()
			<span class="sr-only">Copy</span>
		</button>
	</div>
	// <el-copyable id="subscription-email">{ email }</el-copyable>
	// <button command="--copy" commandfor="subscription-email" class="btn btn-primary">
	// 	<span class="in-data-copied:hidden">Copy</span>
	// 	<span class="not-in-data-copied:hidden">Copied!</span>
	// </button>
}

templ themePreview(theme string, currentTheme string) {
	<div
		class="overflow-hidden rounded-lg border border-base-content/20 outline-2 outline-offset-2 outline-transparent hover:border-base-content/40"
		data-act-class="outline-base-content!"
		data-set-theme={ theme }
		_="on click set #page-theme.value to @data-set-theme"
		hx-trigger="click"
		hx-put={ "/user/settings/theme/" + theme }
		hx-swap="outerHTML"
		hx-target="#display-settings"
		id={ "theme-preview-" + theme }
	>
		<div class="w-full cursor-pointer bg-base-100 font-sans text-base-content" data-theme={ theme }>
			<div class="grid grid-cols-5 grid-rows-3">
				<div class="col-start-1 row-span-2 row-start-1 bg-base-200"></div>
				<div class="col-start-1 row-start-3 bg-base-300"></div>
				<div class="col-span-4 col-start-2 row-span-3 row-start-1 flex flex-col gap-1 bg-base-100 p-2">
					<div class="font-bold capitalize">
						if currentTheme == theme {
							{ theme } (current)
							// This hidden input is used by the save display settings form to also save the current theme.
							<input type="hidden" name="theme" value={ theme }/>
						} else {
							{ theme }
						}
					</div>
					<div class="flex flex-wrap gap-1">
						<div class="flex aspect-square w-5 items-center justify-center rounded bg-primary lg:w-6">
							<div class="text-sm font-bold text-primary-content">A</div>
						</div>
						<div class="flex aspect-square w-5 items-center justify-center rounded bg-secondary lg:w-6">
							<div class="text-sm font-bold text-secondary-content">A</div>
						</div>
						<div class="flex aspect-square w-5 items-center justify-center rounded bg-accent lg:w-6">
							<div class="text-sm font-bold text-accent-content">A</div>
						</div>
						<div class="flex aspect-square w-5 items-center justify-center rounded bg-neutral lg:w-6">
							<div class="text-sm font-bold text-neutral-content">A</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
