package templates

import "github.com/immanent-tech/foragd/models"

const (
	ExternalHeader templFragmentKey = "ExternalHeader"
)

type InternalLayoutProps struct {
	User *models.User
}

templ LayoutInternal(props *InternalLayoutProps, content ...templ.Component) {
	@HeaderInternal(props)
	@SideBar(nil)
	<main
		aria-label="Main Content"
		id={ ContentID.String() }
		class="w-screen scroll-mt-16 scroll-mb-24 pt-16 px-safe pb-24 lg:pl-36"
	>
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@Dock(nil)
}

templ LayoutExternal(content ...templ.Component) {
	@HeaderExternal()
	<main
		aria-label="Main Content"
		id={ ContentID.String() }
		class="mb-24 w-screen flex-1 scroll-mt-16 pt-16 px-safe"
	>
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@FooterExternal()
}
