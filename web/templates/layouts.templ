package templates

import "github.com/immanent-tech/foragd/models"

const (
	ExternalHeader templFragmentKey = "ExternalHeader"
)

type InternalLayoutProps struct {
	User *models.User
}

templ LayoutInternal(props *InternalLayoutProps, content ...templ.Component) {
	<a class="sr-only" href={ ContentID.Target() }>Skip to content</a>
	@HeaderInternal(props)
	@SideBar(nil)
	<main
		aria-label="Main Content"
		id={ ContentID.String() }
		class="w-screen flex-1 scroll-mt-16 scroll-mb-20 pt-16 px-safe pb-20 lg:pl-36 overflow-y-scroll"
	>
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@Dock(nil)
}

templ LayoutExternal(content ...templ.Component) {
	<a class="sr-only" href={ ContentID.Target() }>Skip to content</a>
	@HeaderExternal()
	<main
		aria-label="Main Content"
		id={ ContentID.String() }
		class="w-screen flex-1 scroll-mt-16 pt-16 px-safe pb-20"
	>
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@FooterExternal()
}
