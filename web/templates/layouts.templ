package templates

import "github.com/immanent-tech/foragd/models"

const (
	ExternalHeader templFragmentKey = "ExternalHeader"
)

type InternalLayoutProps struct {
	User *models.User
}

templ LayoutInternal(props *InternalLayoutProps, content ...templ.Component) {
	@HeaderInternal(props)
	@SideBar(nil)
	<main
		id={ ContentID.String() }
		class="mb-24 min-h-svh-safe scroll-mt-16 pt-16 lg:pl-36"
	>
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@Dock(nil)
}

templ LayoutExternal(content ...templ.Component) {
	@HeaderExternal()
	<main id={ ContentID.String() } class="flex-1 min-h-svh-safe mb-24 scroll-mt-16 pt-16">
		if len(content) > 0 {
			@templ.Join(content...)
		}
		{ children... }
	</main>
	@FooterExternal()
}
