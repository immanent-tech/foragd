package templates

import (
	"github.com/immanent-tech/foragd/web/templates/components"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/immanent-tech/go-base/config"
	"slices"
)

templ Landing() {
	@LayoutExternal() {
		<div class="min-h-dvh snap-y snap-mandatory md:snap-none">
			// Main Hero Section.
			<section class="hero h-dvh snap-start md:snap-align-none">
				<div class="hero-content text-center">
					<div class="isolate">
						<div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-16">
							<div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-(--color-primary) to-(--color-secondary) opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
						</div>
					</div>
					<div class="z-10 max-w-md">
						<p class="text-base font-semibold text-primary">
							Algorithms decide.
							<br/>
							You scroll.
						</p>
						<h1 class="mt-2 font-display text-5xl font-semibold tracking-tight sm:text-7xl">
							<span class="font-serif">foragd</span>:
							<br/>
							A calmer way to	follow the web
						</h1>
						<p class="mt-6 font-serif text-lg font-medium text-pretty text-secondary">
							Foragd gathers every RSS feed, YouTube channel, subreddit and email newsletter into one
							searchable place, with no unread-count guilt and no algorithm quietly reordering what you see.
						</p>
						<div class="mt-6 flex items-center justify-center gap-x-6" aria-label="Primary actions">
							<a role="button" class="btn text-sm/6 font-semibold btn-primary" href="/signup">
								Start a free trial
							</a>
							<a role="button" href="/features" class="btn btn-outline text-sm/6 font-semibold">
								See features
							</a>
						</div>
						<p class="my-4 text-sm/6 text-base-content/50">
							No credit card required · Cancel anytime · Import from Feedly, Inoreader or another service in minutes.
						</p>
						<div class="mt-2 text-sm/6 font-semibold text-accent">
							Already have an account?&nbsp;<a href="/login" class="link">Log in</a>
						</div>
						<div class="mt-2">
							<a href="https://play.google.com/store/apps/details?id=app.foragd.twa" rel="_noopener" target="_blank">
								<img src="/content/images/google-play-badge.svg" height="92" width="240" class="mx-auto"/>
							</a>
						</div>
					</div>
					<div class="isolate">
						<div aria-hidden="true" class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
							<div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-(--color-primary) to-(--color-secondary) opacity-30 sm:left-[calc(50%+36rem)] sm:w-288.75"></div>
						</div>
					</div>
				</div>
			</section>
			// Feature Image Section.
			<section id="feature-image" class="relative snap-start md:snap-align-none">
				<div class="mx-auto flex flex-col items-center justify-center gap-8 px-8 sm:flex-row">
					<div class="max-w-280">
						@components.BrowserWindow(config.GetBaseURL()) {
							<img
								src="/content/screenshots/screenshot-home-desktop.webp"
								alt="Foragd RSS feed reader on desktop showing home page with latest articles and subscriptions"
								class="block w-full object-cover"
								loading="lazy"
								fetchpriority="high"
							/>
						}
					</div>
					<div class="shrink-0">
						@components.Mobile() {
							<img
								src="/content/screenshots/screenshot-home-mobile.webp"
								alt="Foragd RSS feed reader on mobile showing home page with latest articles"
								class="block aspect-9/19.5 w-full object-cover"
								loading="lazy"
							/>
						}
					</div>
				</div>
				<div class="mx-auto flex max-w-280 flex-col pt-12">
					@components.MuxPlayer(components.MuxVideo{
						ID:            "2T92kvRpwPS9EiyzPfZz4p1iIpuj02NY7DtRPAimzKIM",
						Title:         "Getting Started",
						ThumbnailTime: new(1),
					})
				</div>
				<div class="border-y border-base-300/60 bg-base-200/40">
					<div class="sm:flex-separated mx-auto flex max-w-6xl flex-wrap justify-center gap-2 px-5 py-6 text-sm text-base-content/55">
						<a href="https://github.com/immanent-tech/foragd" class="link">Open source</a>
						<span>Built by <a href="https://joshuarich.pages.dev" class="link">one indie developer</a>, not a growth team</span>
						<span>Your data is yours — exportable anytime</span>
					</div>
				</div>
			</section>
			// About/Manifesto Section.
			<section id="manifesto" class="hero mx-auto min-h-dvh snap-start md:snap-align-none">
				<div class="hero-content flex-col text-center sm:flex-row">
					<div class="sm:w-1/3">
						<h2 class="text-lg font-semibold tracking-widest text-primary/80 uppercase">Why Foragd</h2>
					</div>
					<div class="sm:w-2/3">
						<p class="font-display text-3xl leading-snug font-medium text-base-content/90 md:text-3xl">
							Social Media shoves content in your face. Traditional feed readers pretend to be an inbox.
							Both suck.
						</p>
						<p class="mt-6 font-serif text-lg font-medium text-pretty text-base-content/70">
							No unread count guilting you into "clearing the queue." No rigid folders you have to
							maintain. No feed silently reordered by an algorithm you can't see. Foragd just holds the
							sources you chose, organized your way, in an interface built for reading.
						</p>
						// <a href="#" class="mt-5 inline-block link text-sm font-medium link-primary">Read the full story →</a>
					</div>
				</div>
			</section>
			// Features/Pillars Section.
			<section id="pillars" class="mx-auto min-h-dvh max-w-6xl snap-start px-5 py-4 pb-24 md:snap-align-none">
				<div class="mx-auto mb-14 max-w-xl text-center">
					<h2 class="font-display text-3xl font-medium tracking-tight">Your internet, gathered together</h2>
					<p class="mt-3 font-serif text-lg font-medium text-pretty text-base-content/65">
						Foragd uses three pillars to build your private library.
					</p>
				</div>
				@featuresLists()
			</section>
			// Comparisons Section.
			<section id="comparison" class="hero h-dvh snap-start md:snap-align-none">
				<div class="hero-content text-center">
					<div class="max-w-md">
						<p class="text-base/7 font-semibold text-primary"></p>
						<h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">
							Built different on purpose
						</h2>
						<p class="mt-6 font-serif text-lg font-medium text-pretty text-secondary">
							No ads sold against your attention, no algorithmic ranking, just your feeds. See exactly how
							that compares to Feedly and Inoreader.
						</p>
						<div class="mt-6 flex items-center justify-center gap-x-6" aria-label="Primary actions">
							<a role="button" href="/compare/feedly" class="btn mt-6 btn-outline btn-primary">vs Feedly</a>
							<a role="button" href="/compare/inoreader" class="btn mt-6 btn-outline btn-primary">vs Inoreader</a>
						</div>
					</div>
				</div>
			</section>
			// Pricing Section.
			<section id="pricing" class="mx-auto min-h-dvh max-w-3xl snap-start px-5 py-4 pb-24 md:snap-align-none">
				<div class="hero-content text-center">
					<div class="max-w-lg">
						<p class="text-base/7 font-semibold text-primary"></p>
						<h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">
							Simple, honest pricing
						</h2>
						<p class="mt-6 font-serif text-lg font-medium text-pretty text-secondary">
							One plan. Every feature. No tiers designed to make you feel behind.
						</p>
						@pricing() {
							<a
								role="button"
								aria-label="Start a free trial on the One plan"
								type="submit"
								class="btn btn-block btn-accent"
							>
								Start a free trial
							</a>
						}
					</div>
				</div>
			</section>
			// FAQ Section.
			<section id="faq" class="mx-auto min-h-dvh max-w-3xl snap-start px-5 pb-24 md:snap-align-none">
				<h2 class="mb-10 text-center font-display text-3xl font-medium tracking-tight">Frequently Asked Questions</h2>
				<div class="mx-auto max-w-4xl">
					@partials.FAQ(slices.Concat(FAQ, BillingFAQ))
				</div>
			</section>
			// Final CTA Section
			@ctaBanner()
		</div>
	}
}

templ ctaBanner() {
	<section class="snap-start border-y border-primary/20 bg-primary/10 md:snap-align-none">
		<div class="mx-auto max-w-3xl px-5 py-20 text-center">
			<h2 class="font-display text-3xl font-medium tracking-tight">Ready to read without the noise?</h2>
			<p class="mt-3 font-serif text-lg font-medium text-base-content/65">Start free. No credit card, no algorithm, no catch.</p>
			<a role="button" href="/signup" class="btn mt-7 btn-primary">Start your free trial</a>
		</div>
	</section>
}
