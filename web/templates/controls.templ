package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	gonanoid "github.com/matoous/go-nanoid/v2"
	"slices"
	"strings"
)

templ FilterControls(path string, filters *models.ListFilters) {
	// Mobile filters dialog slides in from the right.
	<el-dialog id="content-filters-mobile">
		<dialog id="mobile-filters-menu" class="overflow-hidden sm:hidden">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="relative ml-auto flex size-full max-w-xs transform flex-col overflow-y-auto bg-base-300 pt-4 pb-6 shadow-xl">
					<div class="flex items-center justify-between px-4">
						<h3 class="text-lg font-medium">Filters</h3>
						<button
							type="button"
							command="close"
							commandfor="mobile-filters-menu"
							class="relative -mr-2 flex size-10 items-center justify-center rounded-md p-2"
						>
							<span class="absolute -inset-0.5"></span>
							<span class="sr-only">Close menu</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-6">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					// Category Filters.
					<div class="border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-category-filters-disclosure"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
								id="filters-mobile-disclosure-button"
							>
								<span class="sr-only">Show category filters</span>
								<span class="not-sr-only font-medium">Category</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure
							id="mobile-category-filters-disclosure"
							hidden
							class="flex flex-col pt-4"
							hx-get={ path + "/categories" }
							hx-include="[name='selected_subscriptions']"
							hx-vals={ templ.JSONString(filters.Values()) }
							hx-trigger="click from:#filters-mobile-disclosure-button once"
							hx-target="#category-filters-mobile"
						>
							<span class="show-loading mx-auto justify-center">
								<span class="loading loading-dots"></span>
							</span>
							<ul id="category-filters-mobile" class="hide-loading menu"></ul>
						</el-disclosure>
					</div>
					// View Filters (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-view-filters-disclosure"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
							>
								<span class="sr-only">Show view filters</span>
								<span class="not-sr-only font-medium">View</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure
							id="mobile-view-filters-disclosure"
							hidden
							class="block pt-4"
						>
							<div class="space-y-6 text-sm">
								<ul class="menu">
									@viewOption("mobile", path, models.ViewUnread, *filters)
									@viewOption("mobile", path, models.ViewRead, *filters)
									@viewOption("mobile", path, models.ViewAll, *filters)
									@viewOptionFavorites("mobile", path, filters)
								</ul>
							</div>
						</el-disclosure>
					</div>
					// Sorting (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-sort-filters-disclosure"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
							>
								<span class="sr-only">Show sort filters</span>
								<span class="font-medium">Sort</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure
							id="mobile-sort-filters-disclosure"
							hidden
							class="block pt-4"
						>
							<fieldset aria-label="Sorting">
								<ul class="menu">
									@sortOption("mobile", path, models.SortNewestFirst, *filters)
									@sortOption("mobile", path, models.SortOldestFirst, *filters)
									if path == "/list/subscriptions" {
										@sortOption("mobile", path, models.SortMostUnread, *filters)
										@sortOption("mobile", path, models.SortLeastUnread, *filters)
									}
								</ul>
							</fieldset>
						</el-disclosure>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	<nav id="content-filters-desktop" aria-labelledby="filter-heading">
		<h2 id="filter-heading" class="sr-only">Filters</h2>
		<div class="border-b border-base-content/40 py-4">
			<div class="mx-auto flex items-center justify-between">
				{ children... }
				<button
					id="filters-mobile-button"
					type="button"
					command="show-modal"
					commandfor="mobile-filters-menu"
					class="btn inline-block sm:hidden"
				>Filters</button>
				<el-popover-group class="hidden sm:flex sm:items-baseline sm:space-x-8">
					<div class="flex gap-x-4">
						// View and category filters (desktop).
						<el-dropdown class="inline-block">
							<button
								class="btn inline-flex btn-wide"
								id="desktop-filters-button"
							>
								<span class="sr-only">Show filters</span>
								<span class="not-sr-only">Filters</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
							@partials.Menu(element.WithClasses("divide-y", "divide-neutral/25")) {
								<div class="py-1">
									@partials.MenuItem() {
										<h3 class="menu-title">View</h3>
										<ul>
											@viewOption("desktop", path, models.ViewUnread, *filters)
											@viewOption("desktop", path, models.ViewRead, *filters)
											@viewOption("desktop", path, models.ViewAll, *filters)
											@viewOptionFavorites("desktop", path, filters)
										</ul>
									}
								</div>
								<div
									class="py-1"
									hx-get={ path + "/categories" }
									hx-include="[name='selected_subscriptions']"
									hx-vals={ templ.JSONString(filters.Values()) }
									hx-target="#desktop-category-filters-list"
									hx-trigger="click from:#desktop-filters-button once"
								>
									<div class="show-loading w-full justify-center">
										<span class="loading loading-dots"></span>
									</div>
									<div class="hide-loading flex-col">
										@partials.MenuItem() {
											<h3 class="menu-title">Categories</h3>
											<ul id="desktop-category-filters-list"></ul>
										}
									</div>
								</div>
							}
						</el-dropdown>
						// Sorting (desktop).
						<el-dropdown class="inline-block">
							<button class="btn inline-flex btn-wide" popovertarget="desktop-sort-filters-menu">
								<span class="sr-only">Show sort filters</span>
								<span class="not-sr-only">Sort</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
							@partials.Menu() {
								@sortOption("desktop", path, models.SortNewestFirst, *filters)
								@sortOption("desktop", path, models.SortOldestFirst, *filters)
								if path == "/list/subscriptions" {
									@sortOption("desktop", path, models.SortMostUnread, *filters)
									@sortOption("desktop", path, models.SortLeastUnread, *filters)
								}
							}
						</el-dropdown>
					</div>
				</el-popover-group>
			</div>
		</div>
		// Active Filters.
		if (path == "/list/subscriptions" && filters.OnlyFavorites) || len(filters.GetCategories()) > 0 {
			<div class="mx-auto max-w-7xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
				<span class="text-lg font-medium">Filtered By</span>
				<div aria-hidden="true" class="hidden h-5 w-px bg-base-content/40 sm:ml-4 sm:block"></div>
				<div class="mt-2 sm:mt-0 sm:ml-4">
					<div id="active-filters" class="-m-1 flex flex-wrap items-center">
						// Add favorites filter badge if listing subscriptions and favorites filter is active.
						if path == "/list/subscriptions" && filters.OnlyFavorites {
							<form
								id="filter-clear-only-favorites"
								class="flex items-center"
								hx-get={ PathFromCtx(ctx) }
								hx-replace-url="true"
								hx-target={ ContentID.Target() }
								hx-vals={ `{"only_favorites": "false"}` }
							>
								<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
								<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
								<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
								for subscription := range slices.Values(filters.GetSubscriptions()) {
									<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
								}
								for category := range slices.Values(filters.GetCategories()) {
									<input type="hidden" name={ models.ParamCategories } value={ category }/>
								}
								@CategoryBadge("Favorites") {
									<button type="submit" aria-label="Clear favorites filter">
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
										</svg>
									</button>
								}
							</form>
						}
						if len(filters.GetCategories()) > 0 {
							@activeCategoryFilterBadge(path, filters.GetCategories()[0], filters)
						}
					</div>
				</div>
			</div>
		}
	</nav>
}

// viewOption renders a checkbox for a view filter.
templ viewOption(layout, path string, view models.View, filters models.ListFilters) {
	{{
		var checked bool
		if view == filters.GetView() {
			checked = true
		}
		filters.View = view
	}}
	@partials.MenuItem() {
		<button
			class="group relative flex items-center"
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-vals={ templ.JSONString(filters.Values()) }
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class={ "icon icon-tabler icons-tabler-outline icon-tabler-check size-5 shrink-0 text-secondary", templ.KV("opacity-100",checked), templ.KV("opacity-0",!checked) }
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l5 5l10 -10"></path>
			</svg>
			<span class="block text-sm/6 font-medium capitalize">{ view }</span>
		</button>
	}
}

templ viewOptionFavorites(layout, path string, filters *models.ListFilters) {
	{{
		values := filters.Values()
		values["only_favorites"] = !filters.OnlyFavorites
	}}
	@partials.MenuItem() {
		<button
			class="group relative flex items-center"
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-vals={ templ.JSONString(values) }
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class={ "icon icon-tabler icons-tabler-outline icon-tabler-check size-5 shrink-0 text-secondary", templ.KV("opacity-100",filters.OnlyFavorites), templ.KV("opacity-0",!filters.OnlyFavorites) }
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l5 5l10 -10"></path>
			</svg>
			<span class="block text-sm/6 font-medium">Favorites</span>
		</button>
	}
}

templ CategoryFilters(data *models.CategoryFilters) {
	if len(data.Categories) == 0 {
		<div class="flex p-4">
			<div class="flex h-5 shrink-0 items-center">
				<div class="group grid grid-cols-1">
					No categories
				</div>
			</div>
		</div>
	} else {
		for category := range slices.Values(data.Categories.Limit(10)) {
			@categoryOption(data.Path, category.Category, data.Filters)
		}
		if len(data.Filters.GetCategories()) > 0 {
			@clearCategoryFiltersOption(data.Path, data.Filters)
		}
	}
}

// categoryFilter renders a checkbox for a category filter.
templ categoryOption(path string, category models.Category, filters models.ListFilters) {
	{{
		var checked bool
		if filters.GetCategories().HasCategory(category) {
			checked = true
		}
		filters.Categories = []models.Category{category}
		var id string
		id, err := gonanoid.New()
		if err != nil {
			id = strings.ToLower(strings.ReplaceAll(category, " ", "-"))
		} else {
			id = id + "-" + strings.ToLower(strings.ReplaceAll(category, " ", "-"))
		}
	}}
	@partials.MenuItem() {
		<button
			aria-label={ category }
			class="group relative flex items-center"
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-vals={ templ.JSONString(filters.Values()) }
			hx-params="not selected_subscriptions"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class={ "icon icon-tabler icons-tabler-outline icon-tabler-check size-5 shrink-0 text-secondary", templ.KV("opacity-100",checked), templ.KV("opacity-0",!checked) }
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l5 5l10 -10"></path>
			</svg>
			<span class="block text-sm/6 font-medium">{ category }</span>
		</button>
	}
}

templ clearCategoryFiltersOption(path string, filters models.ListFilters) {
	// Remove all current category filters.
	{{ filters.Categories = nil }}
	@partials.MenuItem() {
		<button
			class="group relative flex items-center"
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-vals={ templ.JSONString(filters.Values()) }
			hx-params="not selected_subscriptions,categories"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="icon icon-tabler icons-tabler-outline icon-tabler-x size-5 shrink-0 text-secondary"
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
			</svg>
			<span class="block text-sm/6 font-medium">Clear</span>
		</button>
	}
}

templ activeCategoryFilterBadge(path string, category models.Category, filters *models.ListFilters) {
	<div hx-swap-oob="beforeend:#active-filters">
		<form
			id={ "clear-filter-category-" + strings.ToLower(strings.ReplaceAll(category, " ", "_")) }
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-params="not categories"
		>
			<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
			<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
			<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
			for subscription := range slices.Values(filters.GetSubscriptions()) {
				<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
			}
			@CategoryBadge(category) {
				<button type="submit" aria-label={ "Clear category filter " + category }>
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
					</svg>
				</button>
			}
		</form>
	</div>
}

templ sortOption(layout, path string, sort models.Sort, filters models.ListFilters) {
	{{
		var checked bool
		if sort == filters.GetSort() {
			checked = true
		}
		filters.Sort = sort
	}}
	@partials.MenuItem() {
		<button
			class="group relative flex items-center"
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-vals={ templ.JSONString(filters.Values()) }
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class={ "icon icon-tabler icons-tabler-outline icon-tabler-check size-5 shrink-0 text-secondary", templ.KV("opacity-100",checked), templ.KV("opacity-0",!checked) }
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l5 5l10 -10"></path>
			</svg>
			<span class="block text-sm/6 font-medium">{ sort.String() }</span>
		</button>
	}
}
