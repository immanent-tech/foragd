package templates

import (
	"github.com/immanent-tech/foragd/models"
	"slices"
	"strconv"
	"strings"
)

templ FilterControls(path string, filters *models.ListFilters) {
	// Mobile filters dialog slides in from the right.
	<el-dialog id="content-filters-mobile">
		<dialog id="mobile-filters-menu" class="overflow-hidden sm:hidden">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="relative ml-auto flex size-full max-w-xs transform flex-col overflow-y-auto bg-base-300 pt-4 pb-6 shadow-xl">
					<div class="flex items-center justify-between px-4">
						<h3 class="text-lg font-medium">Filters</h3>
						<button
							type="button"
							command="close"
							commandfor="mobile-filters-menu"
							class="relative -mr-2 flex size-10 items-center justify-center rounded-md p-2"
						>
							<span class="absolute -inset-0.5"></span>
							<span class="sr-only">Close menu</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-6">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					// Category Filters.
					<div class="border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								id="filters-mobile-disclosure"
								type="button"
								command="--toggle"
								commandfor="mobile-category-filters"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
							>
								<span class="sr-only">Show category filters</span>
								<span class="not-sr-only font-medium">Category</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure id="mobile-category-filters" hidden class="flex flex-col pt-4">
							<div
								id="category-filters-mobile"
								class="space-y-6 text-sm"
								hx-get={ path + "/categories" }
								hx-include="[name='displayed_subscriptions']"
								hx-vals={ generateHXVals(filters.Values()) }
								hx-trigger="click from:#filters-mobile-disclosure"
								hx-indicator="#load-categories-mobile"
							></div>
							<span id="load-categories-mobile" class="htmx-indicator loading loading-sm loading-spinner"></span>
						</el-disclosure>
					</div>
					// View Filters (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-view-filters"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
							>
								<span class="sr-only">Show view filters</span>
								<span class="not-sr-only font-medium">View</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure id="mobile-view-filters" hidden class="block pt-4">
							<div class="space-y-6 text-sm">
								@viewFilters(path, filters)
							</div>
						</el-disclosure>
					</div>
					// Sorting (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h4 class="-mx-2 -my-3 flow-root text-lg font-medium">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-sort-filters"
								class="flex w-full items-center justify-between px-2 py-3 text-sm"
							>
								<span class="sr-only">Show sort filters</span>
								<span class="font-medium">Sort</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down ml-6 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
						</h4>
						<el-disclosure id="mobile-sort-filters" hidden class="block pt-4">
							<div class="space-y-6 text-sm">
								@sortFilters(path, filters)
							</div>
						</el-disclosure>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	<nav id="content-filters-desktop" aria-labelledby="filter-heading">
		<h2 id="filter-heading" class="sr-only">Filters</h2>
		<div class="border-b border-base-content/40 py-4">
			<div class="mx-auto flex max-w-7xl items-center justify-between">
				{ children... }
				<button
					id="filters-mobile-button"
					type="button"
					command="show-modal"
					commandfor="mobile-filters-menu"
					class="btn inline-block sm:hidden"
				>Filters</button>
				<el-popover-group class="hidden sm:flex sm:items-baseline sm:space-x-8">
					<div class="flex gap-x-4">
						// Category filters (desktop).
						<div class="relative inline-block text-left">
							<div>
								<button
									id="desktop-category-filters-button"
									class="btn inline-flex btn-wide"
									popovertarget="desktop-category-filters"
								>
									<span class="sr-only">Show category filters</span>
									<span class="not-sr-only">Category</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
									</svg>
								</button>
								<el-popover
									id="desktop-category-filters"
									anchor="bottom end"
									popover
									class="w-fit rounded-box bg-base-300 p-4 shadow-xl [--anchor-gap:4px]"
									hx-get={ path + "/categories" }
									hx-include="[name='displayed_subscriptions']"
									hx-vals={ generateHXVals(filters.Values()) }
									hx-target="#desktop-category-filters-list"
									hx-indicator="#load-categories-desktop"
									hx-trigger="click from:#desktop-category-filters-button"
								>
									<div id="desktop-category-filters-list" class="space-y-4 text-sm"></div>
									<span id="load-categories-desktop" class="htmx-indicator loading loading-sm loading-spinner"></span>
								</el-popover>
							</div>
						</div>
						// View filters (desktop).
						<div class="relative inline-block text-left">
							<div>
								<button class="btn inline-flex btn-wide" popovertarget="desktop-view-filters">
									<span class="sr-only">Show view filters</span>
									<span class="not-sr-only">View</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
									</svg>
								</button>
								<el-popover id="desktop-view-filters" anchor="bottom end" popover class="w-fit rounded-box bg-base-300 p-4 shadow-xl [--anchor-gap:4px]">
									<div class="space-y-4 text-sm">
										@viewFilters(path, filters)
									</div>
								</el-popover>
							</div>
						</div>
						// Sorting (desktop).
						<div class="relative inline-block text-left">
							<div>
								<button class="btn inline-flex btn-wide" popovertarget="desktop-sort-filters">
									<span class="sr-only">Show sort filters</span>
									<span class="not-sr-only">Sort</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
									</svg>
								</button>
								<el-popover id="desktop-sort-filters" anchor="bottom end" popover class="w-fit rounded-box bg-base-300 p-4 shadow-xl [--anchor-gap:4px]">
									<div class="space-y-4 text-sm">
										@sortFilters(path, filters)
									</div>
								</el-popover>
							</div>
						</div>
					</div>
				</el-popover-group>
			</div>
		</div>
		// Active Filters.
		if (path == "/list/subscriptions" && filters.OnlyFavorites) || len(filters.GetCategories()) > 0 {
			<div class="mx-auto max-w-7xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
				<span class="text-lg font-medium">Filtered By</span>
				<div aria-hidden="true" class="hidden h-5 w-px bg-base-content/40 sm:ml-4 sm:block"></div>
				<div class="mt-2 sm:mt-0 sm:ml-4">
					<div id="active-filters" class="-m-1 flex flex-wrap items-center">
						// Add favorites filter badge if listing subscriptions and favorites filter is active.
						if path == "/list/subscriptions" && filters.OnlyFavorites {
							<form
								id="filter-clear-only-favorites"
								class="flex items-center"
								hx-get={ PathFromCtx(ctx) }
								hx-replace-url="true"
								hx-target={ ContentID.Target() }
								hx-vals={ `{"only_favorites": "false"}` }
							>
								<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
								<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
								<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
								for subscription := range slices.Values(filters.GetSubscriptions()) {
									<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
								}
								for category := range slices.Values(filters.GetCategories()) {
									<input type="hidden" name={ models.ParamCategories } value={ category }/>
								}
								<div class="m-1 badge flex items-center badge-secondary">
									Favorites
									<button type="submit" aria-label="Clear favorites filter">
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
										</svg>
									</button>
								</div>
							</form>
						}
						if len(filters.GetCategories()) > 0 {
							@activeCategoryFilterBadge(path, filters.GetCategories()[0], filters)
						}
					</div>
				</div>
			</div>
		}
	</nav>
}

templ viewFilters(path string, filters *models.ListFilters) {
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@viewFilterOption(path, "filter-mobile-view-unread", models.ViewUnread, filters)
			</div>
		</div>
	</div>
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@viewFilterOption(path, "filter-mobile-view-unread", models.ViewRead, filters)
			</div>
		</div>
	</div>
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@viewFilterOption(path, "filter-mobile-view-unread", models.ViewAll, filters)
			</div>
		</div>
	</div>
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@viewFilterOptionFavorites(path, "filter-mobile-only-favorites", filters)
			</div>
		</div>
	</div>
}

// viewFilter renders a checkbox for a view filter.
templ viewFilterOption(path, id string, view models.View, filters *models.ListFilters) {
	<form
		id={ "view-filter-" + view }
		hx-get={ path }
		hx-target={ ContentID.Target() }
		hx-replace-url="true"
		hx-swap="innerHTML transition:true"
		hx-trigger="change"
	>
		<input type="hidden" name={ models.ParamView } value={ view }/>
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
		for category := range slices.Values(filters.GetCategories()) {
			<input type="hidden" name={ models.ParamCategories } value={ category }/>
		}
		<label for={ "view-" + view } class="flex items-center gap-x-2">
			<input
				id={ "view-" + view }
				type="radio"
				if view == filters.GetView() {
					checked
				}
				class="radio radio-sm"
			/>
			<span class="capitalize">
				{ view }
			</span>
		</label>
	</form>
}

templ viewFilterOptionFavorites(path, id string, filters *models.ListFilters) {
	<form
		id={ id }
		hx-get={ path }
		hx-target={ ContentID.Target() }
		hx-vals={ templ.JSONString(map[string]any{"only_favorites": strconv.FormatBool(!filters.OnlyFavorites)}) }
		hx-replace-url="true"
		hx-swap="innerHTML transition:true"
		hx-trigger="change"
	>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
		for category := range slices.Values(filters.GetCategories()) {
			<input type="hidden" name={ models.ParamCategories } value={ category }/>
		}
		<label for="view-favorites" class="flex items-center gap-x-2">
			<input
				id="view-favorites"
				type="radio"
				if filters.OnlyFavorites {
					checked
				}
				class="radio radio-sm"
			/>
			<span>
				Favorites
			</span>
		</label>
	</form>
}

templ CategoryFilters(filters *models.CategoryFilters) {
	if len(filters.Categories) == 0 {
		<div class="flex gap-3">
			<div class="flex h-5 shrink-0 items-center">
				<div class="group grid grid-cols-1">
					No categories
				</div>
			</div>
		</div>
	} else {
		for idx, category := range filters.Categories.Limit(10) {
			<div class="flex gap-3">
				<div class="flex h-5 shrink-0 items-center">
					<div class="group grid grid-cols-1">
						@categoryFilterOption(filters.Path, "filter-category-"+strconv.Itoa(idx), category, &filters.Filters)
					</div>
				</div>
			</div>
		}
		if len(filters.Filters.GetCategories()) > 0 {
			<div class="flex gap-3">
				<div class="flex h-5 shrink-0 items-center">
					<div class="group grid grid-cols-1">
						@clearCategoryFiltersOption(filters.Path, "clear-category-filters", &filters.Filters)
					</div>
				</div>
			</div>
		}
	}
}

// categoryFilter renders a checkbox for a category filter.
templ categoryFilterOption(path, id string, category models.CategoryCount, filters *models.ListFilters) {
	<form
		id={ "filter-category-" + strings.ToLower(strings.ReplaceAll(category.Category, " ", "_")) }
		hx-get={ path }
		hx-target={ ContentID.Target() }
		hx-replace-url="true"
		hx-swap="innerHTML transition:true"
		hx-trigger="change"
		hx-params="not displayed_subscriptions,subscriptions,subscription_id"
	>
		<input type="hidden" name={ models.ParamCategories } value={ category.Category }/>
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
		<label for={ id } class="flex items-center gap-x-2">
			<input
				id={ id }
				type="radio"
				if filters.GetCategories().HasCategory(category.Category) {
					checked
				}
				class="radio radio-sm"
			/>
			<span class="capitalize">
				{ category.Category }
			</span>
		</label>
	</form>
}

templ clearCategoryFiltersOption(path, id string, filters *models.ListFilters) {
	<form
		id={ id }
		hx-get={ path }
		hx-target={ ContentID.Target() }
		hx-replace-url="true"
		hx-swap="innerHTML transition:true"
		hx-params="not categories"
	>
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
		<button type="submit" class="btn btn-wide">Clear</button>
	</form>
}

templ activeCategoryFilterBadge(path string, category models.Category, filters *models.ListFilters) {
	<div hx-swap-oob="beforeend:#active-filters">
		<form
			id={ "clear-filter-category-" + strings.ToLower(strings.ReplaceAll(category, " ", "_")) }
			hx-get={ path }
			hx-target={ ContentID.Target() }
			hx-replace-url="true"
			hx-swap="innerHTML transition:true"
			hx-params="not categories"
		>
			<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
			<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
			<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
			for subscription := range slices.Values(filters.GetSubscriptions()) {
				<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
			}
			<div class="m-1 badge flex items-center badge-secondary">
				{ category }
				<button type="submit" aria-label={ "Clear category filter " + category }>
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</form>
	</div>
}

templ sortFilters(path string, filters *models.ListFilters) {
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@sortOption(path, models.SortNewestFirst, filters)
			</div>
		</div>
	</div>
	<div class="flex gap-3">
		<div class="flex h-5 shrink-0 items-center">
			<div class="group grid grid-cols-1">
				@sortOption(path, models.SortOldestFirst, filters)
			</div>
		</div>
	</div>
	if path == "/list/subscriptions" {
		<div class="flex gap-3">
			<div class="flex h-5 shrink-0 items-center">
				<div class="group grid grid-cols-1">
					@sortOption(path, models.SortMostUnread, filters)
				</div>
			</div>
		</div>
		<div class="flex gap-3">
			<div class="flex h-5 shrink-0 items-center">
				<div class="group grid grid-cols-1">
					@sortOption(path, models.SortLeastUnread, filters)
				</div>
			</div>
		</div>
	}
}

templ sortOption(path string, sort models.Sort, filters *models.ListFilters) {
	<form
		id={ "sort-" + string(sort) }
		hx-get={ path }
		hx-target={ ContentID.Target() }
		hx-replace-url="true"
		hx-swap="innerHTML transition:true"
		hx-trigger="change"
	>
		<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
		<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		<input type="hidden" name={ models.ParamSort } value={ string(sort) }/>
		for subscription := range slices.Values(filters.GetSubscriptions()) {
			<input type="hidden" name={ models.ParamSubscriptions } value={ subscription }/>
		}
		for category := range slices.Values(filters.GetCategories()) {
			<input type="hidden" name={ models.ParamCategories } value={ category }/>
		}
		<label for={ "sort-" + sort } class="flex items-center gap-x-2">
			<input
				id={ "sort-" + sort }
				type="radio"
				if sort == filters.GetSort() {
					checked
				}
				class="radio radio-sm"
			/>
			<span>
				{ sort.String() }
			</span>
		</label>
	</form>
}
