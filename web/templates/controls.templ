package templates

import (
	"github.com/go-chi/chi/v5"
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strconv"
)

templ FilterControls(categories models.CategoryCounts, filters *models.ListDisplayFilters) {
	{{ var path string }}
	switch chi.RouteContext(ctx).URLParam(models.ParamListType) {
		case "subscriptions":
			{{ path = "/list/subscriptions" }}
		case "articles":
			{{ path = "/list/articles" }}
	}
	// Mobile filters dialog slides in from the right.
	<el-dialog>
		<dialog id="mobile-filters-menu" class="overflow-hidden backdrop:bg-transparent sm:hidden">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/25 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="relative ml-auto flex size-full max-w-xs transform flex-col overflow-y-auto bg-base-300 pt-4 pb-6 shadow-xl transition duration-300 ease-in-out data-closed:translate-x-full">
					<div class="flex items-center justify-between px-4">
						<h2 class="text-lg font-medium">Filters</h2>
						<button type="button" command="close" commandfor="mobile-filters-menu" class="relative -mr-2 flex size-10 items-center justify-center rounded-md  p-2 text-base-content hover:bg-accent/50 focus:ring-2 focus:ring-accent focus:outline-hidden">
							<span class="absolute -inset-0.5"></span>
							<span class="sr-only">Close menu</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					// Category Filters.
					if len(categories.GetTopCategories(10)) > 0 {
						<div class="border-t border-base-content/10 px-4 py-6">
							<h3 class="-mx-2 -my-3 flow-root">
								<button type="button" command="--toggle" commandfor="filter-section-category" class="flex w-full items-center justify-between px-2 py-3 text-sm">
									<span class="font-medium">Category</span>
									<span class="ml-6 flex items-center">
										@tabler.ChevronDown(i.Props{Class: "size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
									</span>
								</button>
							</h3>
							<el-disclosure id="filter-section-category" hidden class="block pt-6">
								<div class="flex flex-col">
									<form
										hx-get={ path }
										hx-push-url="true"
										hx-target={ ContentID.Target() }
										hx-trigger="click"
										hx-vals={ models.GenerateHXVals(filters.Values()) }
										class="mt-4 space-y-4"
									>
										// Top 10 categories only.
										for idx, category := range categories.GetTopCategories(10) {
											@categoryFilter("filter-mobile-category-"+strconv.Itoa(idx), category, filters.GetCategories())
										}
									</form>
									<div class="flex justify-end">
										<button
											hx-get={ path }
											hx-push-url="true"
											hx-target={ ContentID.Target() }
											hx-trigger="click"
											hx-vals={ models.GenerateHXVals(filters.Values()) }
											hx-params="not categories"
											class="btn btn-secondary btn-soft btn-sm"
										>
											Clear
										</button>
									</div>
								</div>
							</el-disclosure>
						</div>
					}
					// View Filters (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h3 class="-mx-2 -my-3 flow-root">
							<button type="button" command="--toggle" commandfor="filter-section-view" class="flex w-full items-center justify-between px-2 py-3 text-sm">
								<span class="font-medium">View</span>
								<span class="ml-6 flex items-center">
									@tabler.ChevronDown(i.Props{Class: "size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
								</span>
							</button>
						</h3>
						<el-disclosure id="filter-section-view" hidden class="block pt-6">
							<div class="space-y-6">
								@viewFilter(path, "filter-mobile-view-unread", models.ViewUnread, filters.GetView())
								@viewFilter(path, "filter-mobile-view-read", models.ViewRead, filters.GetView())
								@viewFilter(path, "filter-mobile-view-all", models.ViewAll, filters.GetView())
							</div>
						</el-disclosure>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	<section aria-labelledby="filter-heading">
		<h2 id="filter-heading" class="sr-only">Filters</h2>
		<div class="border-b border-base-content/40 py-4">
			<div class="mx-auto flex max-w-7xl items-center justify-between">
				@filtersButton("sort-menu") {
					<span class="sr-only">Sort options</span>
					Sort
					@tabler.ChevronDown(i.Props{Class: "-mr-1 ml-1 size-5 shrink-0"})
				}
				@filtersMenu("sort-menu", "bottom start") {
					<fieldset>
						<div class="space-y-4">
							@sortOption(path, models.SortLastUpdatedDesc, filters.GetSort())
							@sortOption(path, models.SortLastUpdatedAsc, filters.GetSort())
							if path == "/subscriptions" {
								@sortOption(path, models.SortUnreadCountDesc, filters.GetSort())
								@sortOption(path, models.SortUnreadCountAsc, filters.GetSort())
							}
						</div>
					</fieldset>
				}
				<button
					type="button"
					command="show-modal"
					commandfor="mobile-filters-menu"
					class="inline-block text-sm font-medium hover:bg-accent/50 btn btn-ghost sm:hidden"
				>Filters</button>
				<div class="hidden sm:block">
					<div class="flow-root">
						<el-popover-group class="-mx-4 flex items-center divide-x divide-gray-200">
							<div class="relative inline-block px-4 text-left">
								// Category filters.
								if len(categories) > 0 {
									@filtersButton("desktop-filters-menu-category") {
										<span class="sr-only">Category Filters</span>
										Category
										@tabler.ChevronDown(i.Props{Class: "-mr-1 ml-1 size-5 shrink-0"})
									}
									@filtersMenu("desktop-filters-menu-category", "bottom end") {
										<div class="space-y-4">
											<form
												hx-get={ path }
												hx-push-url="true"
												hx-target={ ContentID.Target() }
												hx-trigger="click"
												hx-vals={ models.GenerateHXVals(filters.Values()) }
												class="mt-4 space-y-4"
											>
												// Top 10 categories only.
												for idx, category := range categories.GetTopCategories(10) {
													@categoryFilter("filter-mobile-category-"+strconv.Itoa(idx), category, filters.GetCategories())
												}
											</form>
											<a
												hx-get={ path }
												hx-push-url="true"
												hx-target={ ContentID.Target() }
												hx-trigger="click"
												hx-vals={ models.GenerateHXVals(filters.Values()) }
												hx-params="not categories"
												class="link link-hover"
											>
												<div class="flex items-center">
													@tabler.X(i.Props{Class: "size-4"})
													<p class="ml-3 text-sm font-medium capitalize hover:underline">Clear</p>
												</div>
											</a>
										</div>
									}
								}
								// View filter.
								@filtersButton("desktop-filters-menu-view") {
									<span class="sr-only">View Filters</span>
									View
									@tabler.ChevronDown(i.Props{Class: "-mr-1 ml-1 size-5 shrink-0"})
								}
								@filtersMenu("desktop-filters-menu-view", "bottom end") {
									<fieldset>
										<div class="space-y-4">
											@viewFilter(path, "filter-view-unread", models.ViewUnread, filters.GetView())
											@viewFilter(path, "filter-view-read", models.ViewRead, filters.GetView())
											@viewFilter(path, "filter-view-all", models.ViewAll, filters.GetView())
										</div>
									</fieldset>
								}
							</div>
						</el-popover-group>
					</div>
				</div>
			</div>
		</div>
		// Active Filters.
		<div>
			<div class="mx-auto max-w-7xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
				<h3 class="text-sm font-medium text-accent">
					Filters
					<span class="sr-only">, active</span>
				</h3>
				<div aria-hidden="true" class="hidden h-5 w-px bg-base-content/40 sm:ml-4 sm:block"></div>
				<div class="mt-2 sm:mt-0 sm:ml-4">
					<div class="-m-1 flex flex-wrap items-center">
						<div class="badge badge-accent badge-soft m-1 capitalize">
							{ filters.GetView() }
						</div>
						<div class="badge badge-accent badge-soft m-1 capitalize">
							{ filters.GetSort().String() }
						</div>
						for category := range slices.Values(categories.GetTopCategories(10)) {
							if slices.Contains(filters.GetCategories(),category.Category) {
								@activeCategoryFilterBadge(category.Category)
							}
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ filtersButton(id string) {
	<button
		class="group-has-open:bg-accent/50 hover:bg-accent/50 btn btn-ghost"
		popovertarget={ id }
		type="button"
	>
		{ children... }
	</button>
}

templ filtersMenu(id, anchor string) {
	<el-popover
		id={ id }
		anchor={ anchor }
		popover
		class="bg-base-300 ring-base-content/10 origin-top-right overflow-visible rounded-md p-4 shadow-2xl ring-1 transition transition-discrete [--anchor-gap:--spacing(2)] backdrop:bg-transparent open:block focus:outline-hidden data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
	>
		{ children... }
	</el-popover>
}

// controlForm wraps controls in a form that will handle applying the given controls.
templ listDisplayFiltersForm(path string, filters *models.ListDisplayFilters, classes ...string) {
	<form
		hx-get={ path }
		hx-push-url="true"
		hx-target={ ContentID.Target() }
		class={ classes }
		hx-trigger="change,selectionchange"
		hx-include="#content-filters,[name='subscriptions'],[name='csrf_token']"
	>
		// // Add other filters.
		// <input type="hidden" name={ models.ParamSortBy } value={ string(filters.GetSort().SortBy) }/>
		// <input type="hidden" name={ models.ParamSortOrder } value={ string(filters.GetSort().SortOrder) }/>
		// <input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
		{ children... }
	</form>
}

// viewFilter renders a checkbox for a view filter.
templ viewFilter(path, id string, view models.View, current models.View) {
	{{ var class string }}
	if view ==current {
		{{ class = "text-accent font-semibold" }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, path),
		WithHXInclude("#content-filters"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXVals(map[string]string{models.ParamView: string(view)}),
		WithID(id),
		WithClasses("group/item", "flex", "items-center", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden", "capitalize", class),
	) {
		{ string(view) }
	}
}

// categoryFilter renders a checkbox for a category filter.
templ categoryFilter(id string, category models.CategoryCount, current models.Categories) {
	<div class="flex items-center">
		<input
			id={ id }
			type="radio"
			name={ models.ParamCategories }
			value={ category.Category }
			if current.HasCategory(category.Category) {
				checked
				_="on click toggle @checked on me"
			} else {
				hx-vals={ models.GenerateHXVals(map[string]string{models.ParamCategories: category.Category}) }
			}
			class={ "radio radio-sm", templ.KV("radio-accent",current.HasCategory(category.Category)) }
		/>
		<label for={ id } class="ml-3 text-sm font-medium capitalize hover:underline">{ category.Category }</label>
	</div>
}

templ activeCategoryFilterBadge(category models.Category) {
	<div class="badge badge-accent badge-soft m-1">
		{ category }
		<button
			hx-get={ models.PathFromCtx(ctx) }
			hx-push-url="true"
			hx-target={ ContentID.Target() }
			hx-include="#content-filters,[name='subscriptions']"
			hx-params="not categories"
		>
			@tabler.X(i.Props{Class: "size-4"})
		</button>
	</div>
	// <span class="m-1 inline-flex items-center rounded-full border border-gray-200 bg-white py-1.5 pr-2 pl-3 text-sm font-medium text-gray-900">
	// 	<span>Objects</span>
	// 	<button type="button" class="ml-1 inline-flex size-4 shrink-0 rounded-full p-1 text-gray-400 hover:bg-gray-200 hover:text-gray-500">
	// 		<span class="sr-only">Remove filter for Objects</span>
	// 		<svg viewBox="0 0 8 8" fill="none" stroke="currentColor" class="size-2">
	// 			<path d="M1 1l6 6m0-6L1 7" stroke-width="1.5" stroke-linecap="round"></path>
	// 		</svg>
	// 	</button>
	// </span>
}

templ sortOption(path string, sort models.Sort, current models.Sort) {
	{{ var class string }}
	if current.IsEqual(sort) {
		{{ class = "text-accent font-semibold" }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, path),
		WithHXInclude("#content-filters"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXVals(map[string]string{models.ParamSortBy: string(sort.SortBy), models.ParamSortOrder: string(sort.SortOrder)}),
		WithID(sort.ID()),
		WithClasses("group/item", "flex", "items-center", "text-sm", "gap-x-2", "focus:text-accent", "focus:outline-hidden", class),
	) {
		switch sort.SortOrder {
			case models.SortOrderDesc:
				@tabler.SortDescending2(i.Props{Class: "size-4"})
			case models.SortOrderAsc:
				@tabler.SortAscending2(i.Props{Class: "size-4"})
		}
		{ sort.String() }
	}
}
