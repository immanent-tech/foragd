package templates

import (
	"github.com/go-chi/chi/v5"
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strconv"
)

templ FilterControls(categories models.CategoryCounts, filters *models.ListDisplayFilters) {
	{{ listType := chi.RouteContext(ctx).URLParam(models.ParamListType) }}
	{{ var path string }}
	switch listType {
		case "subscriptions":
			{{ path = "/list/subscriptions" }}
		case "articles":
			{{ path = "/list/articles" }}
	}
	// Mobile filters dialog slides in from the right.
	<el-dialog>
		<dialog id="mobile-filters-menu" class="overflow-hidden sm:hidden">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="relative ml-auto flex size-full max-w-xs transform flex-col overflow-y-auto bg-base-300 pt-4 pb-6 shadow-xl">
					<div class="flex items-center justify-between px-4">
						<h2 class="text-lg font-medium">Filters</h2>
						<button type="button" command="close" commandfor="mobile-filters-menu" class="relative -mr-2 flex size-10 items-center justify-center rounded-md  p-2 hover:bg-accent/50 focus:ring-2 focus:ring-accent focus:outline-hidden">
							<span class="absolute -inset-0.5"></span>
							<span class="sr-only">Close menu</span>
							@tabler.X(i.Props{Class: "size-6"})
						</button>
					</div>
					// Category Filters.
					if len(categories.GetTopCategories(10)) > 0 {
						<div class="border-t border-base-content/10 px-4 py-6">
							<h3 class="-mx-2 -my-3 flow-root">
								<button type="button" command="--toggle" commandfor="filter-section-category" class="flex w-full items-center justify-between px-2 py-3 text-sm">
									<span class="font-medium">Category</span>
									<span class="ml-6 flex items-center">
										@tabler.ChevronDown(i.Props{Class: "size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
									</span>
								</button>
							</h3>
							<el-disclosure id="filter-section-category" hidden class="block pt-6">
								<div class="flex flex-col">
									// Top 10 categories only.
									for idx, category := range categories.GetTopCategories(10) {
										@categoryFilter(path, "filter-mobile-category-"+strconv.Itoa(idx), category, filters.GetCategories())
									}
									if len(filters.GetCategories()) > 0 {
										<div class="flex justify-end">
											<button
												hx-get={ path }
												hx-push-url="true"
												hx-target={ ContentID.Target() }
												hx-trigger="click"
												hx-vals={ models.GenerateHXVals(filters.Values()) }
												hx-params="not categories"
												class="btn btn-secondary btn-soft btn-sm"
											>
												Clear
											</button>
										</div>
									}
								</div>
							</el-disclosure>
						</div>
					}
					// View Filters (mobile).
					<div class="mt-4 border-t border-base-content/10 px-4 py-6">
						<h3 class="-mx-2 -my-3 flow-root">
							<button type="button" command="--toggle" commandfor="filter-section-view" class="flex w-full items-center justify-between px-2 py-3 text-sm">
								<span class="font-medium">View</span>
								<span class="ml-6 flex items-center">
									@tabler.ChevronDown(i.Props{Class: "size-5 transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
								</span>
							</button>
						</h3>
						<el-disclosure id="filter-section-view" hidden class="block pt-6">
							<div class="space-y-6">
								@viewFilter(path, "filter-mobile-view-unread", models.ViewUnread, filters.GetView())
								@viewFilter(path, "filter-mobile-view-read", models.ViewRead, filters.GetView())
								@viewFilter(path, "filter-mobile-view-all", models.ViewAll, filters.GetView())
								if chi.RouteContext(ctx).URLParam(models.ParamListType) == "subscriptions" {
									{{ var onlyFavoritesActiveClass string }}
									{{ overrides := make(map[string]any) }}
									if filters.OnlyFavorites {
										{{ onlyFavoritesActiveClass = "text-accent font-semibold" }}
										{{ overrides[models.ParamOnlyFavorites] = "false" }}
									}
									@NewLink(
										WithHXMethod(http.MethodGet, path),
										WithHXInclude("#content-filters"),
										WithHXTarget(ContentID.Target()),
										WithHXVals(overrides),
										WithHXPushURL(),
										WithHXVals(map[string]any{"only_favorites": strconv.FormatBool(!filters.OnlyFavorites)}),
										WithClasses("block", "px-4", "py-2", "text-sm", "focus:text-accent", "focus:outline-hidden", "capitalize", onlyFavoritesActiveClass),
									) {
										Only Favorites
									}
								}
							</div>
						</el-disclosure>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	<section aria-labelledby="filter-heading">
		<h2 id="filter-heading" class="sr-only">Filters</h2>
		<div class="border-b border-base-content/40 py-4">
			<div class="mx-auto flex max-w-7xl items-center justify-between">
				<el-dropdown class="inline-block">
					<button class="inline-flex btn btn-wide">
						Sort
						@tabler.ChevronDown(i.Props{Class: "-mr-1 size-5"})
					</button>
					<el-menu anchor="bottom end" popover class="origin-top-right divide-y divide-base-content/15 rounded-md bg-base-300 shadow-lg outline-1 outline-base-content/15 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
						<div class="py-1">
							@sortOption(path, models.SortNewestFirst, filters.GetSort())
							@sortOption(path, models.SortOldestFirst, filters.GetSort())
							if listType == "subscriptions" {
								@sortOption(path, models.SortMostUnread, filters.GetSort())
								@sortOption(path, models.SortLeastUnread, filters.GetSort())
							}
						</div>
					</el-menu>
				</el-dropdown>
				<button
					type="button"
					command="show-modal"
					commandfor="mobile-filters-menu"
					class="inline-block sm:hidden btn"
				>Filters</button>
				<div class="hidden sm:flex">
					<div class="flex gap-x-4 ">
						if len(categories.GetTopCategories(10)) > 0 {
							<el-dropdown class="inline-block">
								<button class="inline-flex btn btn-wide">
									Category
									@tabler.ChevronDown(i.Props{Class: "-mr-1 size-5"})
								</button>
								<el-menu anchor="bottom end" popover class="origin-top-right divide-y divide-base-content/15 rounded-md bg-base-300 shadow-lg outline-1 outline-base-content/15 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
									<div class="py-1">
										// Top 10 categories only.
										for idx, category := range categories.GetTopCategories(10) {
											@categoryFilter(path, "filter-mobile-category-"+strconv.Itoa(idx), category, filters.GetCategories())
										}
									</div>
									if len(filters.GetCategories()) > 0 {
										<div class="py-1">
											<a
												hx-get={ path }
												hx-push-url="true"
												hx-target={ ContentID.Target() }
												hx-trigger="click"
												hx-vals={ models.GenerateHXVals(filters.Values()) }
												hx-params="not categories"
												class="link link-hover flex items-center gap-x-4 px-4 py-2 text-sm focus:text-accent focus:outline-hidden capitalize"
											>
												@tabler.X(i.Props{Class: "size-4"})
												Clear
											</a>
										</div>
									}
								</el-menu>
							</el-dropdown>
						}
						// View filters.
						<el-dropdown class="inline-block">
							<button class="inline-flex btn btn-wide">
								View
								@tabler.ChevronDown(i.Props{Class: "-mr-1 size-5"})
							</button>
							<el-menu anchor="bottom end" popover class="origin-top-right divide-y divide-base-content/15 rounded-md bg-base-300 shadow-lg outline-1 outline-base-content/15 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
								<div class="py-1">
									@viewFilter(path, "filter-view-unread", models.ViewUnread, filters.GetView())
									@viewFilter(path, "filter-view-read", models.ViewRead, filters.GetView())
									@viewFilter(path, "filter-view-all", models.ViewAll, filters.GetView())
								</div>
								if chi.RouteContext(ctx).URLParam(models.ParamListType) == "subscriptions" {
									<div class="py-1">
										{{ var onlyFavoritesActiveClass string }}
										if filters.OnlyFavorites {
											{{ onlyFavoritesActiveClass = "text-accent font-semibold" }}
										}
										@NewLink(
											WithHXMethod(http.MethodGet, path),
											WithHXInclude("#content-filters"),
											WithHXTarget(ContentID.Target()),
											WithHXPushURL(),
											WithHXVals(map[string]any{"only_favorites": strconv.FormatBool(!filters.OnlyFavorites)}),
											WithClasses("block", "px-4", "py-2", "text-sm", "focus:text-accent", "focus:outline-hidden", "capitalize", onlyFavoritesActiveClass),
										) {
											Only Favorites
										}
									</div>
								}
							</el-menu>
						</el-dropdown>
						// // View filter.
						// @filtersButton("desktop-filters-menu-view") {
						// 	<span class="sr-only">View Filters</span>
						// 	View
						// 	@tabler.ChevronDown(i.Props{Class: "-mr-1 ml-1 size-5 shrink-0"})
						// }
						// @filtersMenu("desktop-filters-menu-view", "bottom end") {
						// 	<fieldset>
						// 		<div class="space-y-4">
						// 		</div>
						// 	</fieldset>
						// }
						// </div>
						// </el-popover-group>
					</div>
				</div>
			</div>
		</div>
		// Active Filters.
		<div>
			<div class="mx-auto max-w-7xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
				<h3 class="text-sm font-medium">
					Filtered By
				</h3>
				<div aria-hidden="true" class="hidden h-5 w-px bg-base-content/40 sm:ml-4 sm:block"></div>
				<div class="mt-2 sm:mt-0 sm:ml-4">
					<div class="-m-1 flex flex-wrap items-center">
						// Show view filter badge indicator.
						<div class="badge badge-accent m-1 capitalize">
							{ filters.GetView() }
						</div>
						// Show sort filter badge indicator.
						<div class="badge badge-accent m-1 capitalize">
							{ filters.GetSort().String() }
						</div>
						// Add favorites filter badge if listing subscriptions and favorites filter is active.
						if chi.RouteContext(ctx).URLParam(models.ParamListType) == "subscriptions" && filters.OnlyFavorites {
							<div class="badge badge-accent badge-soft m-1">
								Favorites
								<button
									hx-get={ models.PathFromCtx(ctx) }
									hx-push-url="true"
									hx-target={ ContentID.Target() }
									hx-include="#content-filters"
									hx-vals={ `{"only_favorites": "false"}` }
								>
									@tabler.X(i.Props{Class: "size-4"})
								</button>
							</div>
						}
						// Add filter badges for any active category filters.
						for category := range slices.Values(categories.GetTopCategories(10)) {
							if slices.Contains(filters.GetCategories(),category.Category) {
								@activeCategoryFilterBadge(category.Category)
							}
						}
					</div>
				</div>
			</div>
			// 	<input
			// 		type="text"
			// 		placeholder="Search Quotes..."
			// 		_="on keyup
			//  if the event's key is 'Escape'
			//    set my value to ''
			//    trigger keyup
			//  else
			//   show <li/> in #grid-objects when the textContent of its id contains my value"
			// 	/>
		</div>
	</section>
}

// viewFilter renders a checkbox for a view filter.
templ viewFilter(path, id string, view models.View, current models.View) {
	{{ var class string }}
	if view == current {
		{{ class = "text-accent font-semibold" }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, path),
		WithHXInclude("#content-filters"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXVals(map[string]any{models.ParamView: string(view)}),
		WithID(id),
		WithClasses("block", "px-4", "py-2", "text-sm", "focus:text-accent", "focus:outline-hidden", "capitalize", class),
	) {
		{ string(view) }
	}
}

// categoryFilter renders a checkbox for a category filter.
templ categoryFilter(path, id string, category models.CategoryCount, current models.Categories) {
	{{ var class string }}
	{{ overrides := make(map[string]any) }}
	if current.HasCategory(category.Category) {
		{{ class = "text-accent font-semibold" }}
	} else {
		{{ overrides[models.ParamCategories] = category.Category }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, path),
		WithHXInclude("#content-filters"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXVals(overrides),
		WithID(id),
		WithClasses("block", "px-4", "py-2", "text-sm", "focus:text-accent", "focus:outline-hidden", "capitalize", class),
	) {
		{ string(category.Category) }
	}
}

templ activeCategoryFilterBadge(category models.Category) {
	<div class="badge badge-accent badge-soft m-1">
		{ category }
		<button
			hx-get={ models.PathFromCtx(ctx) }
			hx-push-url="true"
			hx-target={ ContentID.Target() }
			hx-include="#content-filters,[name='subscriptions']"
			hx-params="not categories"
		>
			@tabler.X(i.Props{Class: "size-4"})
		</button>
	</div>
	// <span class="m-1 inline-flex items-center rounded-full border border-gray-200 bg-white py-1.5 pr-2 pl-3 text-sm font-medium text-gray-900">
	// 	<span>Objects</span>
	// 	<button type="button" class="ml-1 inline-flex size-4 shrink-0 rounded-full p-1 text-gray-400 hover:bg-gray-200 hover:text-gray-500">
	// 		<span class="sr-only">Remove filter for Objects</span>
	// 		<svg viewBox="0 0 8 8" fill="none" stroke="currentColor" class="size-2">
	// 			<path d="M1 1l6 6m0-6L1 7" stroke-width="1.5" stroke-linecap="round"></path>
	// 		</svg>
	// 	</button>
	// </span>
}

templ sortOption(path string, sort models.Sort, current models.Sort) {
	{{ var class string }}
	if current == sort {
		{{ class = "text-accent font-semibold" }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, path),
		WithHXInclude("#content-filters"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXVals(map[string]any{models.ParamSort: string(sort)}),
		WithID(string(sort)),
		WithClasses("flex", "items-center", "gap-x-2", "px-4", "py-2", "text-sm", "focus:text-accent", "focus:outline-hidden", "capitalize", class),
	) {
		switch sort {
			case models.SortNewestFirst:
				@tabler.SortDescending2(i.Props{Class: "size-4"})
			case models.SortOldestFirst:
				@tabler.SortAscending2(i.Props{Class: "size-4"})
			case models.SortMostUnread:
				@tabler.SortDescendingNumbers(i.Props{Class: "size-4"})
			case models.SortLeastUnread:
				@tabler.SortAscendingNumbers(i.Props{Class: "size-4"})
		}
		{ sort.String() }
	}
}
