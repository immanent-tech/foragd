package opengraph

templ (m *Metadata) Render() {
	<meta property="og:title" content={ m.Title.Value }/>
	<meta property="og:description" content={ m.Description.Value }/>
	<meta property="og:type" content={ m.ObjectType.Value }/>
	for key, value := range m.ObjectType.Attributes {
		<meta property={ key } content={ value }/>
	}
	<meta property="og:url" content={ m.URL.Value }/>
	<meta property="og:image" content={ m.Image.Value }/>
}
