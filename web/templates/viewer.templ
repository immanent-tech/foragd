package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
	"strings"
)

templ Viewer(feed *models.Feed, errMsg *models.UserMessage) {
	@content() {
		@container() {
			<section id="viewer">
				@partials.Heading1() {
					Feed Viewer
				}
				@partials.Paragraph() {
					Enter a URL in the input below to search for syndicated content (RSS, Atom, JSONFeed feeds) on the site.
					The feed content, if found, will be displayed below.
				}
				@partials.Paragraph() {
					<span class="font-semibold text-primary">Tip:</span> You can directly search for feed content for any website from the browser bar by navigating to
					<span
						class="font-mono"
					>
						https://foragd.app/viewer/url/https://some.site
					</span>. For example, <a
	href="https://foragd.app/viewer/url/https://theverge.com"
	class="link
					font-mono"
>https://foragd.app/viewer/url/https://theverge.com</a>. You can also use this
					<a
						class="link"
						href="javascript:(function(){var currentUrl=window.location.href; var targetUrl='https://foragd.app/viewer/url/'+currentUrl; window.open(targetUrl,'_blank','noreferrer');})();"
					>
						Bookmarklet
					</a> (drag to your bookmarks then use on any site).
				}
				@partials.Paragraph() {
					Want to keep track of feeds and email newsletters in one place? Search across content and discover
					topics and interests? Try out <a href="https://foragd.app" class="link">Foragd</a>.
				}
				<form
					id="viewer-form"
					hx-post="/viewer"
					hx-push-url="true"
					hx-target="#viewer-results"
					hx-swap="innerHTML transition:true"
					hx-indicator="#processing"
				>
					<div class="join w-full mt-4">
						<input
							type="url"
							inputmode="url"
							name="url"
							class="input input-primary w-full bg-base-300 brightness-95"
							placeholder="https://some.site"
							if feed != nil {
								value={ feed.GetSourceURLs()[0] }
							}
							aria-label="Feed or Site URL"
						/>
						<button class="btn join-item">View</button>
					</div>
				</form>
			</section>
			<div id="processing" class="htmx-indicator my-4 flex justify-center mx-auto">
				<span class="flex loading loading-dots loading-lg"></span>
			</div>
			<section id="viewer-results" class="mt-8 mb-24 overflow-y-auto">
				switch  {
					case errMsg != nil:
						@ViewerError(errMsg)
					case feed != nil:
						@ViewerResults(feed)
				}
			</section>
			<section>
				<div class="lg:grid lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-5">
						<h2 class="text-3xl font-semibold tracking-tight text-pretty sm:text-4xl">Frequently asked questions</h2>
						<p class="mt-4 text-base/7 text-pretty">Got more questions? Reach out to us via <a href="mailto:hello@immanent.tech" class="link">email</a>.</p>
					</div>
					<div class="mt-10 lg:col-span-7 lg:mt-0">
						<dl class="space-y-10">
							<div>
								<dt class="text-base/7 font-semibold">How does the feed viewer work?</dt>
								<dd class="mt-2	text-base/7">
									When you enter a URL, the feed viewer will fetch the source of the page, if the
									source is one of the known feed formats like RSS or Atom, the viewer will format and
									return the posts contained in the feed. If the source is normal webpage, the viewer
									will look at links in the page and try to find one that points to feed content,
									which it will then fetch, format and display.
								</dd>
							</div>
							<div>
								<dt class="text-base/7 font-semibold">Why did the feed viewer not find content for my URL?</dt>
								<dd class="mt-2	text-base/7">
									Unfortunately, not all websites have RSS and Atom feeds. While the viewer tries its
									best to find feed content, and uses a few tricks for this, there are still websites
									that cannot be parsed.
								</dd>
							</div>
							<div>
								<dt class="text-base/7 font-semibold">
									Does the feed viewer collect or store any information about me, the URL or the feed
									content it fetches?
								</dt>
								<dd class="mt-2	text-base/7">
									No. Content is fetched and displayed dynamically, and is not stored once you
									navigate away from the page. We do store webserver logs and use Umami analytics to
									track minimal, anonymous usage of the feed viewer. No personal information is
									collected or stored. The feed viewer does not require cookies.
								</dd>
							</div>
							<div>
								<dt class="text-base/7 font-semibold">
									Is this open-source?
								</dt>
								<dd class="mt-2	text-base/7">
									The underlying library that does most of the heavy lifting, <a
	href="https://github.com/immanent-tech/go-syndication"
	class="link"
>go-syndication</a> is open-source! The site itself is part of <a
	href="https://foragd.app"
	class="link"
>Foragd</a>, a beautiful, web based, online feed reader, that uses the go-syndication library.
								</dd>
							</div>
						</dl>
					</div>
				</div>
			</section>
		}
	}
}

templ ViewerResults(feed *models.Feed) {
	<div aria-live="polite">
		<h2 id="profile-overview-title" class="sr-only">Feed Overview</h2>
		<div class="p-6">
			<div class="sm:flex sm:items-center sm:justify-between">
				<div class="sm:flex sm:space-x-5">
					if img := feed.GetImage(); img != nil {
						<div class="flex">
							<div class="mr-4 shrink-0 self-center">
								if img := feed.GetImage(); img != nil {
									// If the source has an image, use that as the avatar.
									<div class="avatar">
										<div class="rounded-box size-12 border border-base-content">
											// rs:auto:48:48 - resize to 48x48 https://docs.imgproxy.net/usage/processing#resize
											// sh:0.5 - sharpen https://docs.imgproxy.net/usage/processing#sharpen
											// q:80 - quality https://docs.imgproxy.net/usage/processing#quality
											// sm:1 - strip metadata
											// kcr:1 - keep copyright
											// scp:1 - convert color profile to sRGB
											@partials.NewProxiedImage(img, "rs:auto:48:48/q:80/sm:1/kcr:1/scp:1/ext:webp",
												element.WithAttribute("width", "48"),
												element.WithAttribute("height", "48"),
												element.WithAttribute("loading", "lazy"),
												element.WithAttribute("decoding", "async"),
											)
										</div>
									</div>
								} else {
									// Otherwise, take the first letter of the title and create a placeholder avatar.
									<div class="avatar avatar-placeholder">
										<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
											<span class="text-3xl capitalize">{ feed.GetTitle()[0:1] }</span>
										</div>
									</div>
								}
							</div>
							<div>
								@partials.Heading2() {
									{ feed.GetTitle() }
								}
								if feed.GetDescription() != "" {
									@partials.Paragraph() {
										{ feed.GetDescription() }
									}
								}
							</div>
						</div>
					}
				</div>
				<div class="mt-5 flex justify-center sm:mt-0">
					<a
						href={ feed.GetLink() }
						target="_blank"
						rel="noopener"
						role="button"
						class="btn btn-primary link link-hover flex items-center"
					>
						View Website
						@tabler.ExternalLink()
					</a>
				</div>
			</div>
		</div>
		<div class="mx-auto grid grid-cols-1 sm:grid-cols-3 justify-center">
			<div class="px-6 py-5 text-center text-sm font-medium">
				<span class="">{ len(feed.GetItems()) }</span>
				<span class="">Items</span>
			</div>
			<div class="px-6 py-5 text-center text-sm font-medium">
				<span class="">Last Updated</span>
				<span class="label">
					if !feed.GetTimestamp().Equal(models.UnixEpoch) {
						<relative-time
							datetime={ feed.GetTimestamp().Format("2006-01-02T15:04:05-0700") }
							format="relative"
						>
							{ feed.GetTimestamp().Format("Jan _2, 2006") }
						</relative-time>
					} else {
						Unknown
					}
				</span>
			</div>
		</div>
	</div>
	if len(feed.GetItems()) > 0 {
		@grid() {
			for item := range slices.Values(feed.GetItems()) {
				@viewerItemCard(item)
			}
		}
		@partials.ButtonBackToTop()
	}
}

templ ViewerError(msg *models.UserMessage) {
	<div class="text-center">
		@partials.Heading2() {
			{ msg.Summary }
		}
		if msg.HasDetails() {
			@partials.Paragraph() {
				{ *msg.Details }
			}
		}
	</div>
}

// inspectorItemCard renders a feed item in a card.
templ viewerItemCard(item models.Item) {
	<div class="card bg-base-200 w-full shadow-sm">
		{{ var img *models.RemoteImage }}
		{{ img = item.GetImage() }}
		if img == nil {
			{{ img, _ = models.ExtractImageFromContent(item.GetContent()) }}
		}
		if img != nil {
			<figure>
				<img
					src={ img.GetURL() }
					alt={ img.GetTitle() }
					srcset={ partials.GenerateImageProxyURL(ctx, img.GetURL(), "rs:auto:280:280/sh:0.5/el:1/q:80/sm:1/kcr:1/scp:1") + " 280w, " + partials.GenerateImageProxyURL(ctx, img.GetURL(), "rs:auto:600:400/sh:0.5/el:1/q:80/sm:1/kcr:1/scp:1") + " 600w" }
					sizes="(max-width: 480px) 100vw, 600px"
					decoding="async"
					loading="lazy"
					class="card-img"
				/>
			</figure>
		}
		<div class="card-body">
			<div class="card-title line-clamp-3">{ item.GetTitle() }</div>
			<div class="flex-1 inline-grid">
				// Author(s) and Published Time.
				if len(item.GetAuthors()) > 0 {
					<p class="col-span-full text-sm/6 italic truncate">
						{ strings.Join(item.GetAuthors(),",") }
					</p>
				}
				<p class="col-span-full text-sm/6 capitalize">
					Updated&nbsp;
					<relative-time
						datetime={ item.GetTimestamp().Format("2006-01-02T15:04:05-0700") }
						format="relative"
					>
						{ item.GetTimestamp().Format("Jan _2, 2006") }
					</relative-time>
				</p>
			</div>
			<div data-disable-scripting class="prose-summary">
				switch  {
					case item.GetContent() != "":
						@templ.Raw(item.GetContent())
					case item.GetDescription() != "":
						@templ.Raw(item.GetDescription())
				}
			</div>
			<div class="card-actions justify-end">
				<a
					href={ item.GetLink() }
					target="_blank"
					rel="noopener"
					role="button"
					class="btn btn-primary link link-hover flex items-center"
				>
					View
					@tabler.ExternalLink()
				</a>
			</div>
		</div>
	</div>
}
