package templates

import (
	"github.com/immanent-tech/foragd/config"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/server/assets"
	"github.com/immanent-tech/foragd/web/htmx"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/immanent-tech/foragd/web/templates/slots"
	"github.com/indaco/teseo/opengraph"
	"net/url"
	"slices"
	"strings"
)

var (
	// ContentID points to the element containing the main content of the page.
	ContentID = models.ElementID("content")
)

type templFragmentKey string

const (
	// BodyFragment is a fragment key pointing to tbe body section of a page.
	BodyFragment templFragmentKey = "body"
	// ContentFragment is a fragment key pointing to the main content of a page.
	ContentFragment templFragmentKey = "content"
	// PaginateFragment is a fragment key pointing to the content to render when paginating.
	PaginateFragment templFragmentKey = "paginate"
)

// Page contains data for rendering a full HTML page.
type Page struct {
	// Component is the main body content of the page.
	Component templ.Component
	// Title is a string for the (browser) titlebar.
	Title string
	// Description adds a meta tag with the given text.
	Description string
	// OpenGraph contains the Opengraph metadata for the page.
	OpenGraph OpenGraphData
	// JSONLDSchema contains the JSONLDSchema for the page.
	JSONLDSchema []JSONLDSchema
	// CanonicalLink is the link that will be used with <link rel="canonical> on the page.
	CanonicalLink string
}

type PageTitle struct {
	Summary     string
	Description string
	Date        string
}

func (t PageTitle) String() string {
	var title strings.Builder
	title.WriteString(t.Summary)
	if t.Description != "" {
		title.WriteString(": ")
		title.WriteString(t.Description)
	}
	if t.Date != "" {
		title.WriteString(" (")
		title.WriteString(t.Date)
		title.WriteString(")")
	}
	title.WriteString(" | ")
	title.WriteString(config.AppName)
	return title.String()
}

type OpenGraphData interface {
	ToMetaTags() templ.Component
}

type JSONLDSchema interface {
	ToJsonLd() templ.Component
}

// PageOption is a functional option applied to a page.
type PageOption func(*Page)

// WithPageTitle option sets the page title (displayed in the browser titlebar).
func WithPageTitle(title PageTitle) PageOption {
	return func(p *Page) {
		p.Title = title.String()
	}
}

// WithPageDescription option sets a description meta tag in the page header.
func WithPageDescription(desc string) PageOption {
	return func(p *Page) {
		p.Description = desc
	}
}

// WithOpenGraphMetadata option sets the given metadata as appropriate Open Graph tags in the page header.
func WithOpenGraphMetadata(metadata OpenGraphData) PageOption {
	return func(p *Page) {
		p.OpenGraph = metadata
	}
}

// WithJSONLDSchema option adds the given JSON-LD schemas to the page.
func WithJSONLDSchema(schema ...JSONLDSchema) PageOption {
	return func(p *Page) {
		p.JSONLDSchema = append(p.JSONLDSchema, schema...)
	}
}

// WithCanonicalLink sets the <link rel="canonical> link for the page.
func WithCanonicalLink(link string) PageOption {
	return func(p *Page) {
		p.CanonicalLink = link
	}
}

// CreatePage creates a new page with the given body template and additional options.
templ CreatePage(template templ.Component, options ...PageOption) {
	// Build page with specified options.
	{{
		p := &Page{
			Component:   template,
			Title:       config.AppName,
			Description: config.AppDescription,
			OpenGraph: opengraph.NewWebSite(
				config.AppName,
				config.GetBaseURL(),
				config.AppDescription,
				config.GetBaseURL()+"/content/logo-vertical-light.webp",
			),
		}

		for option := range slices.Values(options) {
			option(p)
		}
	}}
	// Render page.
	<!DOCTYPE html>
	<html
		lang="en"
		_="on load
             set theme to localStorage.getItem('theme')
             if theme set @data-theme of me to theme else set @data-theme of me to 'greenhouse' end
		   on mutation of @data-theme send themeChange end"
		class="min-h-dvh scrollbar-thumb-(--color-primary) scrollbar-gutter-stable overscroll-y-none"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="description" content={ p.Description }/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual"/>
			<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
			<meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width"/>
			// Set browser chrome to accent color.
			<meta
				name="theme-color"
				content="#0b1020"
				_="on load or themeChange from <html/>
        			js return getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() end
        			set my @content to it"
			/>
			// Indicate light/dark theme support.
			<meta name="color-scheme" content="light dark"/>
			if p.OpenGraph != nil {
				@p.OpenGraph.ToMetaTags()
			}
			if p.CanonicalLink != "" {
				<link rel="canonical" href={ templ.URL(p.CanonicalLink) }/>
			} else {
				<link rel="canonical" href={ templ.URL(config.GetBaseURL()) }/>
			}
			//  iOS Safari Full screen.
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<meta name="apple-mobile-web-app-title" content="Foragd"/>
			//  Chrome Android Full screen.
			<meta name="mobile-web-app-capable" content="yes"/>
			//  Web app manifest.
			<link rel="manifest" href="/content/manifest.json"/>
			// Favicons.
			<link rel="apple-touch-icon" href="/content/apple-touch-icon.png"/>
			<link rel="icon" href="/content/favicon.svg" type="image/svg+xml"/>
			<link rel="shortcut icon" href="/content/favicon.ico" type="image/x-icon"/>
			// RSS feed.
			{{ feedURL, _ := url.JoinPath(config.GetBaseURL(), "feed") }}
			<link rel="alternate" type="application/rss+xml" title="Foragd RSS Feed" href={ feedURL }/>
			// Performance.
			<link rel="preconnect" href="https://imgproxy.foragd.app"/>
			<link rel="preconnect" href="https://cdn.jsdelivr.net"/>
			<link rel="dns-prefetch" href="//auth.foragd.app"/>
			<link rel="preload" href="/fonts/inter/InterVariable.woff2" crossorigin="anonymous" type="font/woff2" as="font"/>
			<link rel="preload" href="/fonts/tex-gyre/pagella/texgyrepagella-bold.woff2" crossorigin="anonymous" type="font/woff2" as="font"/>
			<link rel="preload" href="/fonts/nunito/nunito-v32-latin-600.woff2" crossorigin="anonymous" type="font/woff2" as="font"/>
			<link rel="preload" href="/fonts/nunito/nunito-v32-latin-700.woff2" crossorigin="anonymous" type="font/woff2" as="font"/>
			// Load style bundles from embedded FS.
			<link rel="preload" href={ "/assets/" + assets.GetPath(ctx, "styles.css") } as="style" onload="this.onload=null;this.rel='stylesheet'"/>
			<noscript><link rel="stylesheet" href={ "/assets/" + assets.GetPath(ctx, "styles.css") }/></noscript>
			<link rel="preload" href="/fonts/inter/inter.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
			<noscript><link rel="stylesheet" href="/fonts/inter/inter.css"/></noscript>
			<link rel="preload" href="/fonts/tex-gyre/pagella/pagella.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
			<noscript><link rel="stylesheet" href="/fonts/tex-gyre/pagella/pagella.css"/></noscript>
			<link rel="preload" href="/fonts/nunito/nunito.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
			<noscript><link rel="stylesheet" href="/fonts/nunito/nunito.css"/></noscript>
			// Load script bundles from embedded FS.
			<script src={ "/assets/" + assets.GetPath(ctx, "scripts.js") } type="module"></script>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" integrity="sha384-E7dy6eN+cKffMM/2+QF5MMP1q8KS0AT4IlmT4v3mG2mNZ7ISeLRPdlHrlWJK/8yx" type="module" crossorigin="anonymous"></script>
			if config.IsProduction() {
				<script defer src="https://cloud.umami.is/script.js" data-website-id="24250832-ccab-4bbc-bef9-6ba418e0ea51" crossorigin="anonymous"></script>
			}
			<link rel="preconnect" href="https://challenges.cloudflare.com"/>
			// Site-wide htmx config.
			<meta
				name="htmx-config"
				content={ templ.JSONString(htmx.Config{
				AllowNestedOOBSwaps: false,
				ResponseHandling: []*htmx.ResponseHandling{
					// Don't swap on no content.
					{Code: "204",Swap: false},
					// Swap all ok responses.
					{Code:"[23]..",Swap: true},
					// Swap for unprocessable inputs.
					{Code:"422",Swap: true},
					// Swap on errors.
					{Code: "[45]..",Swap: true,Error: true},
					// All other status should not swap.
					{Code:"...",Swap: false},
				},
				InlineStyleNonce: templ.GetNonce(ctx),
				InlineScriptNonce: templ.GetNonce(ctx),
				IncludeIndicatorStyles: false,
				HistoryRestoreAsHxRequest: false,
				GlobalViewTransitions: false,
				HistoryCacheSize: 10,
			}) }
			/>
			for schema := range slices.Values(p.JSONLDSchema) {
				@schema.ToJsonLd()
			}
			// Insert any additional header, if defined.
			if slots.HasSlot(ctx,slots.Header) {
				@slots.GetSlot(ctx, slots.Header)
			}
			<title>{ p.Title }</title>
			<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication","WebApplication"],
  "name": "Foragd",
  "applicationCategory": "New & RSS Reader",
  "operatingSystem": "Web",
  "description": "Foragd is a web-based reader that combines RSS and Atom feeds, YouTube channels, subreddits and email newsletters into one searchable view, without ads or an algorithmic feed."
  "offers": {
    "@type": "Offer",
    "price": "59",
    "priceCurrency": "USD",
    "priceValidUntil": "2026-10-31"
  },
}
</script>
		</head>
		<body
			class="flex min-h-dvh w-dvw flex-col bg-base-100 overscroll-y-none"
			_="on every htmx:beforeSend in <button:not(.no-disable)/> tell it toggle [@disabled='true'] until htmx:afterOnLoad end"
		>
			<noscript>Foragd requires Javascript to function. Please enable or allow Javascript to run for the foragd.app domain.</noscript>
			// Hidden input to get and store user timezone from browser.
			<input id="timezone" type="hidden" name="timezone" _="init set my value to Intl.DateTimeFormat().resolvedOptions().timeZone"/>
			// Container for modals.
			<div id={ partials.ModalContainerID.String() }></div>
			// Main page content.
			@templ.Fragment(BodyFragment) {
				@p.Component
			}
			// Notifications.
			<div aria-live="assertive" class="pointer-events-none fixed inset-safe-or-0 z-999 flex items-end sm:items-start">
				<div id={ NotificationsID.String() } class="m-4 flex w-full flex-col items-center space-y-4 sm:items-end"></div>
			</div>
		</body>
	</html>
}

templ UpdateTitle(title PageTitle) {
	<title>{ title.String() }</title>
}
