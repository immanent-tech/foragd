package templates

import (
	"fmt"
	"github.com/immanent-tech/foragd/web/templates/components"
	"github.com/immanent-tech/go-base/pkg/htmx"
	"github.com/immanent-tech/go-base/server/handlers/assets"
	"go.opentelemetry.io/otel"
	"path/filepath"
)

var tracer = otel.Tracer("github.com/immanent-tech/foragd/web/templates")

var (
	// ContentID is the ID attribute value of the main content of the page.
	ContentID = htmx.ID("content")
	// ModalContainerID is the ID attribute value of element that can show modals.
	ModalContainerID = htmx.ID("modals")
)

type FragmentKey string

const (
	// BodyFragment is a fragment key pointing to tbe body section of a page.
	BodyFragment FragmentKey = "body"
	// ContentFragment is a fragment key pointing to the main content of a page.
	ContentFragment FragmentKey = "content"
	// PaginateFragment is a fragment key pointing to the content to render when paginating.
	PaginateFragment FragmentKey = "paginate"
)

const (
	HeaderSlot = "Header"
)

// NewPage renders a full page (<head> and <body>).
templ CreatePage(appCfg AppConfig, session SessionManager, page Page) {
	<!DOCTYPE html>
	<html
		lang="en"
		_="
  		   on mutation of @data-theme
		    set theme to @data-theme
  			then send themeChanged(theme:theme)
		   "
		class="min-h-dvh scrollbar-thumb-(--color-primary) scrollbar-gutter-stable overscroll-y-none"
		if theme, ok := session.Get(ctx,"theme").(string); ok {
			data-theme={ theme }
		} else {
			data-theme="greenhouse"
		}
	>
		<head>
			<!-- Security: Robots and index control -->
			<meta name="robots" content="index, follow" hx-preserve="true"/>
			<meta charset="UTF-8" hx-preserve="true"/>
			<meta name="description" content={ page.GetDescription() } hx-preserve="true"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual" hx-preserve="true"/>
			<meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width" hx-preserve="true"/>
			// Set browser chrome to accent color.
			<meta
				name="theme-color"
				content="#0b1020"
				_="on load or themeChange from <html/>
        			js return getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() end
        			set my @content to it"
				hx-preserve="true"
			/>
			// Indicate light/dark theme support.
			<meta name="color-scheme" content="light dark" hx-preserve="true"/>
			// Load style bundles from embedded FS.
			<link rel="stylesheet" href={ filepath.Join("/assets/", assets.AssetPath("web/assets/fonts.css")) } hx-preserve="true"/>
			<link rel="preload" href={ filepath.Join("/files/assets/", assets.AssetPath("alegreya-latin-wght-normal.woff2")) } as="font" type="font/woff2" crossorigin hx-preserve="true"/>
			<link rel="preload" href={ filepath.Join("/files/assets/", assets.AssetPath("alegreya-sans-latin-400-normal.woff2")) } as="font" type="font/woff2" crossorigin hx-preserve="true"/>
			<link rel="preload" href={ filepath.Join("/files/assets/", assets.AssetPath("alegreya-sans-latin-700-normal.woff2")) } as="font" type="font/woff2" crossorigin hx-preserve="true"/>
			<link rel="stylesheet" href={ filepath.Join("/assets/", assets.AssetPath("web/assets/styles.processed.css")) } hx-preserve="true"/>
			// Leaflet.
			@components.LeafletAssets()
			<link rel="canonical" href={ page.CanonicalLink() }/>
			//  Chrome Android Full screen.
			<meta name="mobile-web-app-capable" content="yes" hx-preserve="true"/>
			//  Web app manifest.
			<link rel="manifest" href="/manifest.json" hx-preserve="true"/>
			// Favicons.
			<link rel="icon" href="/images/favicon.svg" type="image/svg+xml" hx-preserve="true"/>
			<link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" hx-preserve="true"/>
			// RSS feed.
			<link rel="alternate" type="application/rss+xml" title="Foragd RSS Feed" href={ appCfg.GetBaseURL().JoinPath("/feed").String() } hx-preserve="true"/>
			// Performance.
			<link rel="preconnect" href="https://imgproxy.foragd.app" hx-preserve="true"/>
			<link rel="dns-prefetch" href="//auth.foragd.app" hx-preserve="true"/>
			// Load script bundles from embedded FS.
			<script src={ filepath.Join("/assets/", assets.AssetPath("web/assets/scripts.js")) } type="module" nonce={ templ.GetNonce(ctx) } hx-preserve="true"></script>
			if appCfg.IsProduction() {
				// Load Umami.
				<script defer src="https://cloud.umami.is/script.js" data-website-id="24250832-ccab-4bbc-bef9-6ba418e0ea51" crossorigin="anonymous" nonce={ templ.GetNonce(ctx) } hx-preserve="true"></script>
			}
			<link rel="preconnect" href="https://challenges.cloudflare.com" hx-preserve="true"/>
			// Site-wide htmx config.
			<meta
				name="htmx-config"
				content={ templ.JSONString(htmx.Config{
                IncludeIndicatorCSS: new(false),
			}) }
				hx-preserve="true"
			/>
			// OpenGraph.
			@page.ToMetaTags()
			// JSON-LD.
			@components.SiteJSONLD(appCfg.GetBaseURL())
			@components.AppMetadataJSONLD()
			<title>{ page.GetTitle() }</title>
			// Load the default application metadata JSON-LD.
			// Scroll/page restoration management.
			@components.ScrollRestoreBehavior()
			// MasonryGrid for list layouts.
			@components.MasonryGridBehavior()
			// Pull-to-refresh.
			@components.PullToRefreshBehavior()
			if fontStyle, ok := session.Get(ctx,"font-style").(string); ok {
				{{ style := fmt.Sprintf("<style id=\"font-vars\" nonce=\"%s\" hx-preserve=\"true\">:root { --font-serif: var(%s); }</style>", templ.GetNonce(ctx), fontStyle) }}
				@templ.Raw(style)
			} else {
				{{ style := fmt.Sprintf("<style id=\"font-vars\" nonce=\"%s\" hx-preserve=\"true\">:root { --font-serif: var(%s); }</style>", templ.GetNonce(ctx), "--font-oldstyle") }}
				@templ.Raw(style)
			}
		</head>
		<body class="flex min-h-dvh flex-col overscroll-y-none bg-base-100 antialiased" _="install ScrollRestore">
			<noscript>Foragd requires Javascript to function. Please enable or allow Javascript to run for the foragd.app domain.</noscript>
			// Hidden input to get and store user timezone from browser.
			<input id="timezone" type="hidden" name="timezone" _="init set my value to Intl.DateTimeFormat().resolvedOptions().timeZone"/>
			// Container for modals.
			<div id={ ModalContainerID.String() }></div>
			// Main page content.
			@templ.Fragment(BodyFragment) {
				@page.GetTemplate()
			}
			// Notifications.
			<div aria-live="assertive" class="pointer-events-none fixed inset-safe-or-0 z-999 flex items-end sm:items-start">
				<div id="notifications" class="m-4 flex w-full flex-col items-center space-y-4 sm:items-end"></div>
			</div>
		</body>
	</html>
}

// Title renders the <title> tag. It can be used whenever an update to the title is needed.
templ Title(title string) {
	<title>{ title }</title>
}

templ UpdateHead(page Page) {
	<head hx-head="merge" hx-nonce={ templ.GetNonce(ctx) }>
		@page.ToMetaTags()
		<link rel="canonical" href={ page.CanonicalLink() } hx-head="re-eval"/>
		<title>{ page.GetTitle() }</title>
	</head>
}
