package home

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/display/icon"
	"github.com/joshuar/go-templ-daisyui/display/text"
	"slices"
)

templ (filters CategoryFilters) Show(classes ...string) {
	@text.Build("Categories:", text.WithTextWeight(text.Semibold), text.WithTextSize(text.XS)).Show()
	<div class="flex flex-wrap">
		for _, filter := range filters {
			@filter.Show(classes...)
		}
	</div>
}

templ (filter *CategoryFilter) Show(classes ...string) {
	{{ var styleOption badge.Option }}
	if filter.active {
		{{ styleOption = badge.WithStyle(badge.Outline) }}
	} else {
		{{ styleOption = badge.WithStyle(badge.Dashed) }}
	}
	@badge.Build(
		badge.WithSize(badge.SM),
		badge.WithColor(badge.Neutral),
		styleOption,
		badge.WithContent(filter.Category),
		badge.WithExtraAttributes(filter.attributes),
	).Show(classes...)
}

// Show renders the view filter as a set of badges joined together.
templ (filters ViewFilters) Show(classes ...string) {
	{{ classes = append(classes, "join-item") }}
	@text.Build("View:", text.WithTextWeight(text.Semibold), text.WithTextSize(text.XS)).Show()
	<div class="join">
		for viewFilter := range slices.Values(filters) {
			@viewFilter.Show(classes...)
		}
	</div>
}

templ (filter ViewFilter) Show(classes ...string) {
	@filter.Props.Show(classes...)
}

templ BuildFiltersMenu(viewFilters templates.Element, categoryFilters templates.Element) {
	<div id="content-filters" hx-swap-oob="true">
		@partials.DockMenu("Filter",
			icon.Build("fa-sliders"),
			viewFilters.Show(), categoryFilters.Show(),
		)
	</div>
}
