package home

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui/display/text"
	"github.com/joshuar/go-templ-daisyui/feedback/alert"
	"github.com/joshuar/go-templ-daisyui/feedback/loading"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/joshuar/go-templ-daisyui/modifiers/state"
	"slices"
	"time"
)

templ notifications() {
	<!-- Open the modal using ID.showModal() method -->
	<div class="container mx-auto">
		<button class="btn" onclick="my_modal_1.showModal()">open modal</button>
		<dialog id="my_modal_1" class="modal modal-top">
			<div role="alert" class="modal-box alert alert-info alert-soft">
				Foobar
				<div class="modal-action">
					<form method="dialog">
						<!-- if there is a button in form, it will close the modal -->
						<button class="btn">Close</button>
					</form>
				</div>
			</div>
		</dialog>
	</div>
	<div
		id="test-toast"
		class="toast toast-end z-50"
		hx-ext="sse"
		sse-connect="/home/notifications"
		sse-swap="notification"
	></div>
	// <div sse-connect="/home/notifications" sse-swap="notification"></div>
	// <div
	// 	hx-get="/home/notifications"
	// 	hx-trigger="load delay:1s"
	// 	hx-swap="outerHTML"
	// ></div>
}

templ SSE(data chan string) {
	<div id="test-toast" class="toast toast-end z-50">
		for range data {
			@templ.Flush() {
				// event: notification
				// data:
				@alert.Build(state.Info).Show() {
					<div>
						<h3 class="font-bold">New message!</h3>
						<div class="text-xs">You have 1 unread message</div>
					</div>
					<button class="btn btn-sm" _="on click remove #{ d }">See</button>
				}
			}
		}
	</div>
}

templ Notify(data string) {
	@alert.Build(state.Info).Show() {
		<div>
			<h3 class="font-bold">New message!</h3>
			<div class="text-xs">{ data }</div>
		</div>
		<button class="btn btn-sm" _="on click remove #test-alert">See</button>
	}
}

func relativeTime(timestamp time.Time) string {
	return timestamp.Format("Mon Jan 2 15:04")
}

// showLastUpdated shows the timestamp indicating last update of an item as a
// relative time in the bottom left corner.
templ showLastUpdated(description string, updated time.Time) {
	if description != "" {
		@text.Build(description+" "+relativeTime(updated),
			text.WithTextSize(text.XS),
			text.AsItalicText(),
		).Show()
	} else {
		@text.Build(relativeTime(updated),
			text.WithTextSize(text.XS),
			text.AsItalicText(),
		).Show()
	}
}

templ NewContent(content ...models.Template) {
	<div id="content" class="flex flex-wrap md:flex-column p-4 h-full items-start justify-center">
		if len(content) > 0 {
			for c := range slices.Values(content) {
				@c.Show()
			}
		} else {
			@emptyContent()
		}
	</div>
	<div id="content-loading" class="flex items-center justify-center">
		@loading.Build(loading.Bars,
			loading.AsHTMXIndicator(),
			loading.WithThemeColor(color.Accent),
		).Show()
	</div>
}

// EmptyContent renders a hero with options for the user when the request
// returned no other content.
templ emptyContent() {
	<div class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">Nothing to show.</h1>
				<p class="py-6">
					Provident cupiditate voluptatem et in. Quaerat fugiat ut assumenda excepturi exercitationem
					quasi. In deleniti eaque aut repudiandae et a id nisi.
				</p>
				@AddSubscriptionAction("btn", "btn-accent")
				@ImportAction("btn", "btn-accent")
				// <button
				// 	class="btn btn-primary"
				// 	hx-get="/subscription/new"
				// 	hx-target="#command_modal"
				// >Add Subscription</button>
			</div>
		</div>
	</div>
}
