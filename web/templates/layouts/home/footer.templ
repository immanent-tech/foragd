package home

import (
	"context"
	"github.com/go-chi/chi/v5"
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui/attributes"
	"github.com/joshuar/go-templ-daisyui/display/icon"
	"github.com/joshuar/go-templ-daisyui/feedback/tooltip"
)

var ContentFooterID = attributes.ID("content-footer")

// ListHeader represents the content header for a list of objects.
type ListFooter struct {
	backPath    string
	filtersMenu templ.Component
	sortMenu    templ.Component
	actions     []templ.Component
}

templ (f *ListFooter) Show(classes ...string) {
	<div
		id={ ContentFooterID.String() }
		hx-swap-oob="true"
		hx-swap="morph:outerHTML"
		class="bg-base-200 dock dock-sm"
	>
		<div class="basis-xs">
			@tooltip.Build("Back").Show() {
				@BackButton(ctx, f.backPath)
			}
		</div>
		<div class="basis-xs">
			@tooltip.Build("Filter").Show() {
				@f.filtersMenu
			}
		</div>
		<div class="basis-xs">
			@tooltip.Build("Sort").Show() {
				@f.sortMenu
			}
		</div>
		<div class="basis-xs">
			@tooltip.Build("Actions").Show() {
				@BuildActionsMenu(f.actions...)
			}
		</div>
	</div>
}

func BuildListFooter(ctx context.Context, categories models.CategoryCounts) *ListFooter {
	var backPath string
	switch chi.RouteContext(ctx).RoutePattern() {
	case models.FeedsRoute:
		backPath = "/home"
	case models.ItemsRoute:
		backPath = "/home/feeds"
	}
	// Build view filters.
	viewFilters := BuildViewFilters(ctx)
	// Build category filters.
	categoryFilters := BuildCategoryFilters(ctx, categories)
	// Build footer.
	return &ListFooter{
		backPath:    backPath,
		filtersMenu: BuildFiltersMenu(viewFilters, categoryFilters),
		sortMenu:    BuildSortingMenu(),
		actions:     []templ.Component{AddSubscriptionAction(), ImportAction()},
	}
}

// ArticleHeader represents the content header for an individual article.
type ArticleFooter struct {
	backPath string
	item     *models.Item
}

templ (f *ArticleFooter) Show(classes ...string) {
	<div
		id={ ContentFooterID.String() }
		hx-swap-oob="true"
		hx-swap="morph:outerHTML"
		class="bg-base-200 dock dock-sm"
	>
		<div class="basis-xs">
			@BackButton(ctx, f.backPath)
		</div>
		<div class="basis-xs">
			<a href={ templ.URL(f.item.GetLink()) } target="_blank">
				@icon.Build("fa-globe").Show()
			</a>
		</div>
	</div>
}

func BuildArticleFooter(item *models.Item) *ArticleFooter {
	return &ArticleFooter{
		backPath: models.ItemsRoute,
		item:     item,
	}
}
