package home

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-templ-daisyui/feedback/loading"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
)

// MainContent represents the content area of /home pages. This is where lists
// of objects, single objects or search results will be displayed.
// type MainContent struct {
// 	content templates.Component
// 	title   string
// }

type MainContent struct {
	content templates.Elements
}

// Show the main content. In addition to rendering content objects, this will
// also update the page title if set.
templ (c *MainContent) Show(classes ...string) {
	<div id="content" class="flex flex-wrap p-4 h-dvh items-start">
		if len(c.content) != 0 {
			@c.content.Show(classes...)
		} else {
			@emptyContent()
		}
	</div>
	<div id="content-loading" class="flex items-center justify-center">
		@loading.Build(loading.Bars,
			loading.AsHTMXIndicator(),
			loading.WithThemeColor(color.Accent),
		).Show()
	</div>
}

// EmptyContent renders a hero with options for the user when the request
// returned no other content.
templ emptyContent() {
	<div class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">Nothing to show.</h1>
				<p class="py-6">
					Provident cupiditate voluptatem et in. Quaerat fugiat ut assumenda excepturi exercitationem
					quasi. In deleniti eaque aut repudiandae et a id nisi.
				</p>
				@AddSubscriptionAction("btn", "btn-accent")
				@ImportAction("btn", "btn-accent")
				// <button
				// 	class="btn btn-primary"
				// 	hx-get="/subscription/new"
				// 	hx-target="#command_modal"
				// >Add Subscription</button>
			</div>
		</div>
	</div>
}

// BuildMainContent will create a new main content object with an optional title
// and the given content.
func BuildMainContent(content ...templates.Element) *MainContent {
	main := &MainContent{}

	main.content = content

	return main
}
