package home

import "github.com/joshuar/go-templ-daisyui/actions/dropdown"

import "github.com/joshuar/go-templ-daisyui/modifiers/size"
import "github.com/joshuar/go-templ-daisyui/actions/button"
import "github.com/joshuar/go-templ-daisyui/display/icon"
import "github.com/joshuar/go-templ-daisyui/navigation/menu"
import "github.com/joshuar/go-templ-daisyui/classes/width"
import "github.com/joshuar/go-templ-daisyui/modifiers/color"
import "github.com/joshuar/go-feed-me/internal/models"

import "github.com/joshuar/go-feed-me/web/templates"
import "github.com/joshuar/go-templ-daisyui/display/text"
import "github.com/davecgh/go-spew/spew"
import "github.com/go-chi/chi/v5"

type SortBadge struct {
	models.Sort
	action *templates.Action
}

templ (s *SortBadge) Show() {
	@text.Build(s.String(),
		text.WithTextSize(text.SM),
		text.WithAttributes(s.action.Attributes()),
	).Show()
}

templ BuildSortingMenu(filters models.Filters, path string) {
	{{ spew.Dump(chi.RouteContext(ctx)) }}
	<div id="content-sorting" hx-swap-oob="true">
		@dropdown.Build(
			dropdown.WithOpenOptions(
				dropdown.From(dropdown.OpenTop),
				dropdown.Align(dropdown.AlignCenter),
			),
			dropdown.WithButton(
				button.WithSize(size.SM),
				button.AsShape(button.Square, false),
				button.WithContent(icon.Build("fa-sort")),
			),
			dropdown.WithMenuContent(
				menu.WithMenuTitle("Sort"),
				menu.WithBaseColor(color.Base200),
				menu.WithExtraClasses(width.W52),
				menu.WithItems(generateSortOptions(filters, path)...),
			),
		).Show()
	</div>
}
