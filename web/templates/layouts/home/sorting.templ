package home

import (
	"github.com/go-chi/chi/v5"
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/display/icon"
)

type SortBadge struct {
	models.Sort
	active bool
	action *templates.Action
}

templ (s *SortBadge) Show() {
	{{ var styleOption badge.Option }}
	if s.active {
		{{ styleOption = badge.WithStyle(badge.Outline) }}
	} else {
		{{ styleOption = badge.WithStyle(badge.Dashed) }}
	}
	@badge.Build(
		badge.WithSize(badge.SM),
		badge.WithColor(badge.Neutral),
		styleOption,
		badge.WithContent(s.String()),
		badge.WithExtraAttributes(s.action.Attributes()),
		badge.WithExtraClasses("p-2"),
	).Show()
	// @text.Build(s.String(),
	// 	text.WithTextSize(text.SM),
	// 	text.WithAttributes(s.action.Attributes()),
	// ).Show()
}

templ BuildSortingMenu() {
	{{ path := chi.RouteContext(ctx).RoutePattern() }}
	<div id="content-sorting" hx-swap-oob="true">
		@partials.DockMenu("Sort",
			icon.Build("fa-sort"),
			generateSortOptions(models.FiltersFromCtx(ctx), path)...,
		)
	</div>
}
