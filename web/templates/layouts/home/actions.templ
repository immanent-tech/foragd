package home

import (
	"context"
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/actions/dropdown"
	"github.com/joshuar/go-templ-daisyui/feedback/tooltip"
	"github.com/joshuar/go-templ-daisyui/navigation/link"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"maps"
	"net/url"
	"slices"
	"strings"
)

// actionAttributes are the common htmx attributes for mark actions.
var actionAttributes = templ.Attributes{
	"hx-replace-url":  "false",
	"hx-target":       templates.ContentID.Target(),
	"hx-target-error": templates.ErrorID.Target(),
	"hx-swap":         "morph:innerHTML swap:1s",
}

const actionTextClasses = "w-fit text-xs"

// viewAction returns the action for viewing the card's content. For a Feed card this would be the Feed's item as cards.
// For a Item card, this would be the item content.
func (c *Card) viewAction(ctx context.Context) templ.Attributes {
	var view models.PageState
	switch models.IdentifyID(c.id) {
	case models.FeedPFX:
		filters := models.FiltersFromCtx(ctx)
		view = models.PageState{Path: "/feed/" + c.GetFeedID(), Params: filters.ToQueryParams()}
		if c.IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
	case models.ItemPFX:
		view = models.PageState{Path: "/item/" + c.id}
	}
	return templ.Attributes{
		"hx-get":         view.String(),
		"hx-target":      templates.ContentID.Target(),
		"hx-replace-url": "true",
		"hx-swap":        "morph:innerHTML show:top",
	}
}

// AddSubscriptionButton creates a button for displaying a modal to add a new subscription.
func AddSubscriptionAction() templ.Component {
	return openModalLink(
		"hx-get",
		"/subscription/new",
		templ.Join(tabler.CloudPlus(i.Props{Size: i.SizeXS}), components.SetContent("Add Subscription")),
	)
}

// ImportAction creates a button for displaying a modal to import feeds (i.e. // via opml).
func ImportAction() templ.Component {
	return openModalLink(
		"hx-get",
		"/subscription/import",
		templ.Join(tabler.CloudUpload(i.Props{Size: i.SizeXS}), components.SetContent("Import Subscriptions")),
	)
}

func markReadLink(label string, attributes templ.Attributes) templ.Component {
	return link.Build(
		link.WithContent(
			templ.Join(tabler.Bookmark(i.Props{Size: i.SizeXS}), components.SetContent(label)),
		),
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(attributes),
		link.WithExtraClasses(actionTextClasses),
	).Show()
}

func markUnreadLink(label string, attributes templ.Attributes) templ.Component {
	return link.Build(
		link.WithContent(
			templ.Join(tabler.BookmarkFilled(i.Props{Size: i.SizeXS}), components.SetContent(label)),
		),
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(attributes),
		link.WithExtraClasses(actionTextClasses),
	).Show()
}

// MarkAllItemsAction generates an action for the footer menu to mark all items of a feed as either read or unread,
// depending on the current view.
func MarkAllItemsAction(ctx context.Context, feeds []models.FeedID) templ.Component {
	// Create htmx attributes.
	attrs := maps.Clone(actionAttributes)
	// Create url parameters.
	params := make(url.Values)
	params.Add(models.ParamRedirect, string(models.PageViewIDFeeds))
	params.Add(models.ParamFeeds, strings.Join(feeds, ","))

	switch models.FiltersFromCtx(ctx).View {
	case models.ViewUnread:
		attrs["hx-post"] = "home/feeds/" + string(models.MarkRead) + "?" + params.Encode()
		return markReadLink("Mark All Read", attrs)
	case models.ViewRead:
		attrs["hx-post"] = "home/feeds/" + string(models.MarkUnread) + "?" + params.Encode()
		return markUnreadLink("Mark All Unread", attrs)
	default:
		return nil
	}
}

func markItemAction(feedID models.FeedID, itemID models.ItemID, isUnread bool) templ.Component {
	// Set up htmx attributes for action.
	attributes := templ.Attributes{
		"hx-swap":        "outerHTML swap:1s",
		"hx-target":      "#" + itemID,
		"hx-replace-url": "false",
	}

	if isUnread {
		attributes["hx-post"] = "/item/" + string(models.MarkRead) + "/" + itemID
		return markReadLink("Mark Read", attributes)
	}
	attributes["hx-post"] = "/item/" + string(models.MarkUnread) + "/" + itemID
	return markUnreadLink("Mark Unread", attributes)
}

// MarkAllFeedsAction generates an action for the footer menu to mark all feeds as either read or unread, depending on
// the current view.
func MarkAllFeedsAction(ctx context.Context) templ.Component {
	// Create htmx attributes.
	attrs := maps.Clone(actionAttributes)
	// Create url parameters.
	params := make(url.Values)
	params.Add(models.ParamRedirect, string(models.PageViewIDHome))

	switch models.FiltersFromCtx(ctx).View {
	case models.ViewUnread:
		attrs["hx-post"] = "/subscriptions/mark/" + string(models.MarkRead) + "?" + params.Encode()
		return markReadLink("Mark All Read", attrs)
	case models.ViewRead:
		attrs["hx-post"] = "/subscriptions/mark/" + string(models.MarkUnread) + "?" + params.Encode()
		return markUnreadLink("Mark All Unread", attrs)
	default:
		return nil
	}
}

func markFeedAction(id models.SubscriptionID, isRead bool) templ.Component {
	// Create htmx attributes.
	attrs := maps.Clone(actionAttributes)
	// Create url parameters.
	params := make(url.Values)
	params.Add(models.ParamRedirect, string(models.PageViewIDFeeds))

	if isRead {
		attrs["hx-post"] = "/subscription/mark/" + string(models.MarkRead) + "/" + id + "?" + params.Encode()
		return markReadLink("Mark Read", attrs)
	}
	attrs["hx-post"] = "/subscription/mark/" + string(models.MarkUnread) + "/" + id + "?" + params.Encode()
	return markUnreadLink("Mark Unread", attrs)
}

func markAction(mark models.Mark, attributes templ.Attributes) templ.Component {
	switch mark {
	case models.MarkRead:
		return markReadLink("Mark Read", attributes)
	case models.MarkUnread:
		return markUnreadLink("Mark Unread", attributes)
	}
	return nil
}

templ shareAction(attributes templ.Attributes) {
	@link.Build(
		link.WithContent(
			templ.Join(tabler.Share(i.Props{Size: i.SizeXS}), components.SetContent("Share")),
		),
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(attributes),
		link.WithExtraClasses(actionTextClasses),
	).Show()
}

templ visitExternalLinkAction(label, url string) {
	@link.Build(
		link.WithContent(
			templ.Join(tabler.ExternalLink(i.Props{Size: i.SizeXS}), components.SetContent("Visit "+label)),
		),
		link.WithUnderlineOnHover(),
		link.WithExtraAttributes(templ.Attributes{
			"href": url,
			"_":    "on mouseenter add .menu-active to me end on mouseleave remove .menu-active from me end",
		}),
		link.WithExtraClasses(actionTextClasses),
	).Show()
}

func editSubscriptionAction(id models.SubscriptionID) templ.Component {
	return openModalLink(
		"hx-get",
		"/subscription/edit/"+id,
		templ.Join(tabler.Edit(i.Props{Size: i.SizeXS}), components.SetContent("Edit")),
	)
}

func unsubscribeAction(id models.SubscriptionID) templ.Component {
	return openModalLink(
		"hx-delete",
		"/subscription/remove/"+id+"?confirmation=no",
		templ.Join(tabler.Trash(i.Props{Size: i.SizeSM}), components.SetContent("Unsubscribe")),
	)
}

// openModalLink generates a link for a route that opens a modal.
func openModalLink(method, path string, content templ.Component) templ.Component {
	return link.Build(
		link.WithContent(content),
		link.WithUnderlineOnHover(),
		link.WithExtraClasses(actionTextClasses),
		link.WithExtraAttributes(templ.Attributes{
			method:      path,
			"hx-target": templates.ModalID.Target(),
			// "_":         "on htmx:afterOnLoad wait 10ms then add @open to " + partials.ModalID.Target(),
			"_": partials.HyperscriptOpenModal(partials.ModalID.Target()) + " then " + partials.HyperscriptCloseDropdown(),
		}),
	).Show()
}

templ UpdateActions(actions ...templ.Component) {
	<div id="content-actions">
		@tooltip.Build("Actions").Show() {
			@dropdown.Build(
				dropdown.WithButtonContent(tabler.Menu(i.Props{Size: i.SizeSM})),
				dropdown.WithOpenFrom(dropdown.OpenTop),
				dropdown.WithOpenAlignment(dropdown.AlignEnd),
				dropdown.WithMenuClasses("flex-nowrap", "grow", "min-w-52"),
			).Show() {
				for item := range slices.Values(actions) {
					if item != nil {
						<li>
							@item
						</li>
					}
				}
			}
		}
	</div>
}
