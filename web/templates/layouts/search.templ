}

// AddFavoriteSearchButton renders a button that the user can action to favorite the search. It presents a modal to name
// the search (name is required) before saving.
templ AddFavoriteSearchButton() {
	<button type="button" command="show-modal" commandfor="add-favorite-search" class="btn btn-primary btn-square">
		<span class="sr-only">Add favorite search</span>
		@tabler.Star(i.Props{Class: "size-4"})
	</button>
	<el-dialog>
		<dialog id="add-favorite-search" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/80 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-sm sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<form
						hx-post="/user/favorite/add/search"
						hx-target="#favorite-button"
						hx-include="#current-search-filters,[name='csrf_token']"
						hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
					>
						<div>
							<div class="mt-3 sm:mt-5">
								<fieldset class="fieldset">
									<legend class="fieldset-legend">Name this search</legend>
									<input type="text" class="input" name="search_name" required placeholder="Type here"/>
								</fieldset>
							</div>
						</div>
						<div class="mt-5 sm:mt-6 text-center">
							<button type="submit" class="btn btn-primary btn-outline">Save</button>
							<button type="button" command="close" commandfor="add-favorite-search" class="btn btn-outline">Close</button>
						</div>
					</form>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ RemoveFavoriteSearchButton(id models.FavoriteID) {
	<button
		class="btn btn-primary btn-square"
		hx-post="/user/favorite/remove/search"
		hx-target="#favorite-button"
		hx-include="#current-search-filters,[name='csrf_token']"
		hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
	>
		@tabler.StarFilled(i.Props{Class: "size-4"})
	</button>
}

templ showSearchResult(result partials.Object) {
	<li>
		<div class="flex gap-x-4 py-5">
			// Show article image or placeholder thumbnail.
			if img := result.GetImage(); img != nil {
				<div class="avatar">
					<div class="rounded-box size-12">
						<img
							src={ img.GetURL() }
							if img.GetTitle() != "" {
								alt={ img.GetTitle() }
							}
						/>
					</div>
				</div>
			} else {
				<div class="avatar avatar-placeholder">
					<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
						<span class="text-3xl capitalize">{ result.GetTitle()[0:1] }</span>
					</div>
				</div>
			}
			<div class="flex-auto">
				// Show article title.
				<div class="flex items-baseline justify-between gap-x-4">
					@partials.ViewObjectLink(result, "", nil) {
						<p class="text-sm/6 font-semibold text-pretty line-clamp-2">{ result.GetTitle() }</p>
					}
					<p class="flex-none text-xs text-base-content/80">
						@partials.ShowTimestamp(result.GetUpdatedDate())
					</p>
				</div>
			</div>
		</div>
		// Show article description (if exists).
		if result.GetDescription() != "" {
			<div class="flex">
				<article class="mt-1 prose prose-sm prose-img:hidden prose-figure:hidden dark:prose-invert line-clamp-2">
					@templ.Raw(result.GetDescription())
				</article>
			</div>
		}
	</li>
}

// SimilarArticles renders a page of articles that are the result of a search for similar articles to a given input set.
templ SimilarArticles(articles models.Articles) {
	@partials.MainContainer() {
		// Show results.
		@Grid() {
			for article := range slices.Values(articles) {
				@partials.NewArticleContent(article).Card(models.ViewAll)
			}
		}
	}
}

// NoSearchResults renders an informational message for when no search results were returned.
templ NoSearchResults() {
	<div class="text-center">
		<h1 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-4xl">Nothing found 😕</h1>
		<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Looks like there are no matches for that search.</p>
		<div class="mt-10 flex items-center justify-center gap-x-6">
			<a href="/home" role="button" class="btn btn-primary">Go to home</a>
		</div>
	</div>
}
