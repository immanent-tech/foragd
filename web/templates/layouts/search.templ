package layouts

import (
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
)

// SearchSuggestions will render suggestions for a given search.
templ SearchSuggestions(subscriptions []*partials.Subscription, articles []*partials.Article) {
	// <el-defaults class="block divide-y divide-base-content/10 text-sm text-base-content">
	// 	<div class="p-2">
	// 		<h2 class="mt-4 mb-2 px-3 text-xs font-semibold text-gray-400">Recent searches</h2>
	// 		<div class="text-sm text-gray-300">
	// 			<a href="#" class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-indigo-500 aria-selected:text-white">
	// 				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 flex-none text-gray-500 group-aria-selected:text-white forced-colors:group-aria-selected:text-[Highlight]">
	// 					<path d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" stroke-linecap="round" stroke-linejoin="round"></path>
	// 				</svg>
	// 				<span class="ml-3 flex-auto truncate">Workflow Inc. / Website Redesign</span>
	// 				<span aria-hidden="true" class="ml-3 hidden flex-none text-indigo-200 group-aria-selected:inline">Jump to...</span>
	// 			</a>
	// 		</div>
	// 	</div>
	// </el-defaults>
	// Subscription suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="subscriptions-group-label">
		<div id="subscriptions-group-label">Subscriptions</div>
		for subscription := range slices.Values(subscriptions) {
			<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
				@partials.HeroIconSubscription("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
				<span class="ml-3 flex-auto truncate">{ subscription.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
	// Article suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="articles-group-label">
		<div id="articles-group-label">Articles</div>
		for article := range slices.Values(articles) {
			<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
				@partials.HeroIconArticle("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
				<span class="ml-3 flex-auto truncate">{ article.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
	// Page suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="pages-group-label">
		<div id="pages-group-label">Pages</div>
		<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
			@partials.HeroIconSubscription("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
			<span class="ml-3 flex-auto truncate">All subscriptions</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
			@partials.HeroIconArticle("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
			<span class="ml-3 flex-auto truncate">All articles</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
			@partials.HeroIconSettings("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
			<span class="ml-3 flex-auto truncate">Settings</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a href="#" hidden class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content">
			@partials.HeroIconAdd("size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]")
			<span class="ml-3 flex-auto truncate">Add subscription</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
	</el-command-group>
}

// GlobalSearch renders a command palette element for powering global search within the app.
templ GlobalSearch() {
	<el-command-palette id="global-search">
		<div class="grid grid-cols-1 border-b border-base-content/10">
			@partials.HeroIconSearch("pointer-events-none col-start-1 row-start-1 ml-4 self-center text-base-content size-5")
			<input
				type="text"
				name="text"
				hx-post="/search"
				hx-trigger="input changed delay:500ms"
				hx-target="#global-search-suggestions"
				hx-push-url="false"
				autofocus
				placeholder="Search, Command..."
				class="col-start-1 row-start-1 h-12 w-full pr-4 pl-11 app-textinput text-base sm:text-sm"
			/>
		</div>
		// <el-command-list class="absolute w-full md:w-[anchor(width)] left-[anchor(left)] top-[anchor(bottom)] [justify-self:_anchor-center] block max-h-80 scroll-py-2 overflow-y-auto" style="position-anchor: --command-palette">
		<el-command-list
			id="global-search-suggestions"
			class="absolute w-(--input-width) block max-h-80 scroll-py-2 overflow-y-auto rounded-md shadow-lg bg-base-300"
		></el-command-list>
		<el-no-results
			hidden
			class="absolute w-(--input-width) block px-6 py-14 text-center sm:px-14 rounded-md shadow-lg bg-base-300"
		>
			@partials.HeroIconQuestionMark("mx-auto size-6 text-base-content")
			<p class="mt-4 text-sm text-base-content">No suggestions found.</p>
		</el-no-results>
	</el-command-palette>
}
