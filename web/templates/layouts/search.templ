package layouts

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/server/session"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/immanent-tech/go-syndication/types"
	"slices"
	"time"
)

// SearchSuggestions will render suggestions for a given search.
templ SearchSuggestions(request *models.SearchRequest, subscriptions []*partials.Subscription, articles []*partials.Article) {
	// Always generate a suggestion to execute a full search.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="search-group-label">
		<form
			hx-post="/search"
			hx-target={ partials.ContentID.Target() }
			hx-include="[name='csrf_token'],#search-filters"
			hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
			hx-push-url="true"
			hx-trigger="click, keydown['Enter']"
			_="on click or keyup[key is 'Enter'] add @hidden to #global-search-suggestions then set #global-search.value to ''"
		>
			<input type="hidden" name="text" value={ request.Text }/>
			<a
				href="#"
				hidden
				class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content text-sm"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
				</svg>
				<span class="ml-3 flex-auto truncate">Search for { request.Text }</span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Search...</span>
			</a>
		</form>
	</el-command-group>
	// Page suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="pages-group-label">
		<div id="pages-group-label" class="text-base-content/80 px-3 py-2">Pages</div>
		<a
			href="/home"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup[key is 'Enter'] add @hidden to #global-search-suggestions then set #global-search.value to ''"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Home</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/subscriptions"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">All subscriptions</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/articles"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">All articles</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/user/settings"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Settings</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="#"
			hx-get="/user/subscription/add"
			hx-target={ partials.ContentID.Target() }
			hx-push-url="true"
			hidden
			_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Add subscription</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
	</el-command-group>
	// Subscription suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="subscriptions-group-label">
		<div id="subscriptions-group-label" class="text-base-content/80 px-3 py-2">Subscriptions</div>
		for subscription := range slices.Values(subscriptions) {
			{{ values := session.ArticleFiltersFromSession(ctx).Parameters() }}
			{{ values[models.ParamSubscriptions] = subscription.GetID() }}
			<a
				href="#"
				hx-get="/articles"
				hx-vals={ models.GenerateHXVals(values) }
				hx-target={ partials.ContentID.Target() }
				hx-push-url="true"
				hidden
				_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
				class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
				</svg>
				<span class="ml-3 flex-auto truncate">{ subscription.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
	// Article suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="articles-group-label">
		<div id="articles-group-label" class="text-base-content/80 px-3 py-2">Articles</div>
		for article := range slices.Values(articles) {
			<a
				href="#"
				hx-get={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() }
				hx-target={ partials.ContentID.Target() }
				hx-push-url="true"
				hidden
				class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
				_="on click or keyup[key is 'Enter']  add @hidden to #global-search-suggestions then set #global-search.value to ''"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
				</svg>
				<span class="ml-3 flex-auto truncate">{ article.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
}

templ SearchFilters(user *models.User, request *models.SearchRequest) {
	// Search form.
	<div class="mx-auto max-w-3xl mt-4 p-4 overflow-y-auto">
		<form
			hx-post="/search"
			hx-target={ partials.ContentID.Target() }
			hx-push-url="true"
			hx-include="[name='csrf_token']"
			hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
			hx-params="not #current-search-filters"
			_="on htmx:afterRequest(successful) if successful add .hidden to #search-filters"
		>
			<div class="grid grid-cols-1 gap-x-6 gap-y-2 sm:gap-y-8 sm:grid-cols-6 md:col-span-2">
				// Full text search filter.
				<div class="col-span-full">
					<label for="text" class="block text-sm/6 font-medium">Includes the words</label>
					<div class="mt-2">
						<input
							id="text"
							type="text"
							name="text"
							if request.Text != "" {
								value={ request.Text }
							}
							class="input input-sm w-full bg-base-content/10"
						/>
					</div>
				</div>
				// Categories filter.
				<div class="sm:col-span-3">
					<label form="categories" class="block text-sm/6 font-medium">Categories</label>
					<div class="mt-2">
						<input
							id="categories"
							type="text"
							name="categories"
							if request.Categories != "" {
								value={ request.Categories }
							}
							class="input input-sm bg-base-content/10"
						/>
					</div>
				</div>
				// Authors filter.
				<div class="sm:col-span-3">
					<label for="authors" class="block text-sm/6 font-medium">Authors</label>
					<div class="mt-2">
						<input
							id="authors"
							type="text"
							name="authors"
							if request.Authors != "" {
								value={ request.Authors }
							}
							class="input input-sm bg-base-content/10"
						/>
					</div>
				</div>
				// Include subscriptions filter.
				<div class="sm:col-span-full">
					<label for="subscriptions-filter-select" class="block text-sm/6 font-medium">In subscriptions</label>
					<select
						id="subscriptions-filter-select"
						hx-post="/search/filter/subscription"
						hx-target="#subscription-filters"
						hx-swap="beforeend"
						hx-push-url="false"
						name="subscription-filter-select"
						class="select select-sm w-full bg-base-content/10"
					>
						<option disabled selected>Choose...</option>
						for s := range slices.Values(user.GetSubscriptionMetadata().SortByTitle()) {
							<option value={ s.GetID() + "|" + s.Customisation.Nickname }>{ s.Customisation.Nickname }</option>
						}
					</select>
					<div class="mx-auto max-w-7xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
						<div class="mt-2 sm:mt-0">
							<div id="subscription-filters" class="-m-1 flex flex-wrap items-center">
								for id := range slices.Values(request.Subscriptions) {
									{{ subscription := user.GetSubscriptionMetadata().GetByID(id) }}
									if subscription != nil {
										@SubscriptionFilter(id, subscription.Customisation.Nickname)
									}
								}
							</div>
						</div>
					</div>
				</div>
				// Date range filter.
				<div class="sm:col-span-3">
					<label for="published_within" class="block text-sm/6 font-medium">Published within</label>
					<select id="published_within" name="published_within" class="select select-sm my-2 bg-base-content/10">
						<option
							value="last_hour"
							if request.PublishedWithin == models.SearchRequestPublishedWithinLastHour {
								selected
							}
						>Last hour</option>
						<option
							value="last_half_day"
							if request.PublishedWithin == models.SearchRequestPublishedWithinLast12hours {
								selected
							}
						>Last 12 hours</option>
						<option
							value="last_day"
							if request.PublishedWithin == models.SearchRequestPublishedWithinLastDay {
								selected
							}
						>Last day</option>
						<option
							value="last_week"
							if request.PublishedWithin == models.SearchRequestPublishedWithinLastWeek {
								selected
							}
						>Last week</option>
						<option
							value="last_month"
							if request.PublishedWithin == models.SearchRequestPublishedWithinLastMonth {
								selected
							}
						>Last month</option>
						<option
							value="all_time"
							if request.PublishedWithin == models.SearchRequestPublishedWithinAllTime || request.PublishedWithin == "" {
								selected
							}
						>All time</option>
					</select>
				</div>
			</div>
			{ children... }
		</form>
	</div>
	// Help dialog.
	<button type="button" command="show-modal" commandfor="search-filters-help" class="btn btn-sm btn-ghost btn-square absolute right-2 top-2">
		<span class="sr-only">Search filters help</span>
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-info">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"></path>
		</svg>
	</button>
	<el-dialog>
		<dialog id="search-filters-help" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/80 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-sm sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<div>
						<div class="mt-3 sm:mt-5">
							<h3 id="dialog-title" class="text-base font-semibold">Search Help</h3>
							<div class="mt-2 text-sm space-y-2">
								<p>By default words are matched with OR (i.e., cats OR dogs). The following operators can be used for more refined searches:</p>
								<ul class="gap-y-2">
									<li>+ signifies AND operation (i.e., food AND beverages)</li>
									<li>| signifies OR operation (i.e., food OR beverages)</li>
									<li>- negates a the word (i.e., NOT alcoholic)</li>
									<li>"" represents an exact phrase match (i.e., "rum-based drinks")</li>
									<li>* at the end of indicates a prefix match (i.e., match bird, birding and birds)</li>
								</ul>
							</div>
						</div>
					</div>
					<div class="mt-5 sm:mt-6 text-center">
						<button type="button" command="close" commandfor="search-filters-help" class="btn btn-wide btn-outline">Close</button>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ SubscriptionFilter(id, name string) {
	<span id={ id } class="m-1 inline-flex items-center rounded-full border border-base-content/90 bg-base-300 py-1.5 pr-2 pl-3 text-sm font-medium text-base-content">
		<span>{ name }</span>
		<input type="hidden" name="subscriptions" value={ id }/>
		<button type="button" _={ "on click remove #" + id } class="ml-1 inline-flex size-4 shrink-0 rounded-full p-1">
			<span class="sr-only">Remove filter for { name }</span>
			<svg viewBox="0 0 8 8" fill="none" stroke="currentColor" class="size-2">
				<path d="M1 1l6 6m0-6L1 7" stroke-width="1.5" stroke-linecap="round"></path>
			</svg>
		</button>
	</span>
}

// GlobalSearch renders a command palette element for powering global search within the app.
templ GlobalSearch(user *models.User) {
	<el-command-palette>
		<form
			hx-trigger="input changed from:#global-search delay:100ms"
			hx-post="/search/suggestions"
			hx-target="#global-search-suggestions"
			hx-include="[name='csrf_token'],#search-filters"
			hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
		>
			<div class="grid grid-cols-1">
				<input
					id="global-search"
					type="search"
					name="text"
					hx-push-url="false"
					placeholder="Search..."
					class="col-start-1 row-start-1 block size-full outline-hidden pr-4 pl-10 text-base sm:text-sm/6 placeholder:text-base-content/50 bg-base-content/10 rounded-box py-2"
					_="on customCtrlK from body me.focus()"
				/>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="pointer-events-none col-start-1 row-start-1 self-center size-5 ml-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
				</svg>
				// Filters button.
				<button
					type="button"
					class="row-start-1 col-start-1 mr-4 self-center justify-self-end"
					_="on click toggle .hidden on #search-filters then halt bubbling"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 0 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 9.75V10.5"></path>
					</svg>
				</button>
			</div>
		</form>
		<el-command-list
			id="global-search-suggestions"
			class="absolute w-full left-0 sm:w-(--input-width) block max-h-80 lg:max-h-160 scroll-py-2 overflow-y-auto rounded-md shadow-lg bg-base-300 text-base sm:text-sm/6"
			_="on keydown[key is 'Escape'] from body add @hidden"
		></el-command-list>
		<div
			id="search-filters"
			class="hidden absolute w-full h-auto lg:max-h-160 left-0 sm:w-(--input-width) scroll-py-2 overflow-y-auto rounded-md shadow-lg bg-base-300 text-base sm:text-sm/6 p-2"
			_="on keydown[key is 'Escape'] from body add .hidden"
		>
			@SearchFilters(user, &models.SearchRequest{}) {
				<div class="mt-6 flex items-center justify-end gap-x-6">
					<button type="button" class="btn btn-sm btn-outline" _="on click add .hidden to #search-filters">Cancel</button>
					<button type="submit" class="btn btn-sm btn-primary">Search</button>
				</div>
			}
		</div>
	</el-command-palette>
}

// _="on click from elsewhere add .hidden to me"

type SearchResultsPage struct {
	user          *models.User
	subscriptions models.SubscriptionsSlice
	articles      []*models.Article
	search        *models.SearchRequest
	favoriteID    models.FavoriteID
}

func NewSearchResultsPage(user *models.User, fav *models.Favorite, search *models.SearchRequest, subscriptions models.SubscriptionsSlice, articles []*models.Article) *SearchResultsPage {
	page := &SearchResultsPage{
		user:          user,
		search:        search,
		subscriptions: subscriptions,
		articles:      articles,
	}
	if fav != nil {
		page.favoriteID = fav.GetID()
	}
	return page
}

templ (page *SearchResultsPage) Content() {
	@partials.MainContainer() {
		<div class="py-6 first:pt-0 last:pb-0">
			<dt>
				<button type="button" command="--toggle" commandfor="faq-0" class="flex w-full items-start justify-between text-left text-base-content">
					<span class="text-base/7 font-semibold">Filters</span>
					<span class="ml-6 flex h-7 items-center">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
							<path d="M12 6v12m6-6H6" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
							<path d="M18 12H6" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</span>
				</button>
			</dt>
			<el-disclosure id="faq-0" hidden class="contents">
				<dd id="current-search-filters" class="mt-2 pr-12">
					@SearchFilters(page.user, page.search) {
						<input type="hidden" name="update_favorite_search" value="true"/>
						<button type="submit" class="btn btn-sm btn-primary">Update</button>
					}
				</dd>
			</el-disclosure>
		</div>
		<nav class="relative flex items-center">
			<div id="favorite-button" class="fab">
				if page.favoriteID != "" {
					@RemoveFavoriteSearchButton(page.favoriteID)
				} else {
					@AddFavoriteSearchButton()
				}
			</div>
		</nav>
		// Show results.
		@Grid() {
			for article := range slices.Values(page.articles) {
				@partials.NewArticleContent(article).Card(models.ViewAll)
			}
		}
		// <ul role="list">
		// 	// Subscription results.
		// 	if len(page.subscriptions) > 0 {
		// 		<div class="flex items-center mt-8">
		// 			<div class="relative flex justify-start">
		// 				<span class="pr-3 text-base/7 font-semibold text-base-content">Subscriptions</span>
		// 			</div>
		// 			<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
		// 		</div>
		// 		<ul id="subscription-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-3">
		// 			for subscription := range slices.Values(page.subscriptions) {
		// 				@showSearchResult(subscription)
		// 			}
		// 		</ul>
		// 	}
		// 	// Article results.
		// 	if len(page.articles) > 0 {
		// 		<div class="flex items-center mt-8">
		// 			<div class="relative flex justify-start">
		// 				<span class="pr-3 text-base/7 font-semibold text-base-content">Articles</span>
		// 			</div>
		// 			<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
		// 		</div>
		// 		<ul id="article-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
		// 			for article := range slices.Values(page.articles) {
		// 				@showSearchResult(article)
		// 			}
		// 		</ul>
		// 	}
		// </ul>
		// <button class="btn btn-neutral fixed right-0 bottom-0 m-4" hidden _="on intersect remove @hidden from me" href={ partials.ContentID.Target() }>Back to top</button>
	}
}

// AddFavoriteSearchButton renders a button that the user can action to favorite the search. It presents a modal to name
// the search (name is required) before saving.
templ AddFavoriteSearchButton() {
	<button type="button" command="show-modal" commandfor="add-favorite-search" class="btn btn-primary btn-square">
		<span class="sr-only">Add favorite search</span>
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
		</svg>
	</button>
	<el-dialog>
		<dialog id="add-favorite-search" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/80 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-sm sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					<form
						hx-post="/user/favorite/add/search"
						hx-target="#favorite-button"
						hx-include="#current-search-filters,[name='csrf_token']"
						hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
					>
						<div>
							<div class="mt-3 sm:mt-5">
								<fieldset class="fieldset">
									<legend class="fieldset-legend">Name this search</legend>
									<input type="text" class="input" name="search_name" required placeholder="Type here"/>
								</fieldset>
							</div>
						</div>
						<div class="mt-5 sm:mt-6 text-center">
							<button type="submit" class="btn btn-primary btn-outline">Save</button>
							<button type="button" command="close" commandfor="add-favorite-search" class="btn btn-outline">Close</button>
						</div>
					</form>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ RemoveFavoriteSearchButton(id models.FavoriteID) {
	<button
		class="btn btn-primary btn-square"
		hx-post="/user/favorite/remove/search"
		hx-target="#favorite-button"
		hx-include="#current-search-filters,[name='csrf_token']"
		hx-vals="js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
			<path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"></path>
		</svg>
	</button>
}

type searchResult interface {
	HasImage() bool
	GetImage() *types.ImageInfo
	GetTitle() string
	GetUpdatedDate() time.Time
	GetDescription() string
	ViewLink(classes ...string) templ.Component
}

templ showSearchResult(result searchResult) {
	<li>
		<div class="flex gap-x-4 py-5">
			// Show article image or placeholder thumbnail.
			if result.HasImage() {
				<div class="avatar">
					<div class="rounded-box size-12">
						<img
							src={ result.GetImage().GetURL() }
							if result.GetImage().GetTitle() != "" {
								alt={ result.GetImage().GetTitle() }
							}
						/>
					</div>
				</div>
			} else {
				<div class="avatar avatar-placeholder">
					<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
						<span class="text-3xl capitalize">{ result.GetTitle()[0:1] }</span>
					</div>
				</div>
			}
			<div class="flex-auto">
				// Show article title.
				<div class="flex items-baseline justify-between gap-x-4">
					@result.ViewLink() {
						<p class="text-sm/6 font-semibold text-pretty line-clamp-2">{ result.GetTitle() }</p>
					}
					<p class="flex-none text-xs text-base-content/80">
						@partials.ShowTimestamp(result.GetUpdatedDate())
					</p>
				</div>
			</div>
		</div>
		// Show article description (if exists).
		if result.GetDescription() != "" {
			<div class="flex">
				<article class="mt-1 prose prose-sm prose-img:hidden prose-figure:hidden dark:prose-invert line-clamp-2">
					@templ.Raw(result.GetDescription())
				</article>
			</div>
		}
	</li>
}

// SimilarArticles renders a page of articles that are the result of a search for similar articles to a given input set.
templ SimilarArticles(articles models.Articles) {
	if len(articles) > 0 {
		<ul role="list">
			<div class="flex items-center">
				<div class="relative flex justify-start">
					<span class="pr-3 text-base font-semibold text-base-content">Similar Articles</span>
				</div>
				<div aria-hidden="true" class="w-full border-t border-base-content/15"></div>
			</div>
			<ul id="article-results" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				for article := range slices.Values(articles) {
					@showSearchResult(partials.NewArticleContent(article))
				}
			</ul>
		</ul>
		<button class="btn btn-neutral fixed right-0 bottom-0 m-4" hidden _="on intersect remove @hidden from me" href={ partials.ContentID.Target() }>Back to top</button>
	} else {
		@EmptyContent()
	}
}

// NoSearchResults renders an informational message for when no search results were returned.
templ NoSearchResults() {
	<div class="text-center">
		<h1 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-4xl">Nothing found 😕</h1>
		<p class="mt-6 text-lg font-medium text-pretty text-base-content sm:text-xl/8">Looks like there are no matches for that search.</p>
		<div class="mt-10 flex items-center justify-center gap-x-6">
			<a href="/home" role="button" class="btn btn-primary">Go to home</a>
		</div>
	</div>
}
