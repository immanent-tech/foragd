templ SearchSuggestions(subscriptions []*partials.Subscription, articles []*partials.Article) {
	<ul
		role="list"
		class="grid grid-flow-dense grid-cols-1 md:grid-cols-2 justify-center gap-4 m-2"
	>
		for subscription := range slices.Values(subscriptions) {
			<li>
				@subscription.SearchSuggestion()
			</li>
		}
		for article := range slices.Values(articles) {
			<li>
				@article.SearchSuggestion()
			</li>
		}
	</ul>
	// <div class="text-center">All results...</div>
}

