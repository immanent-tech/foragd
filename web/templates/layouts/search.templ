package layouts

import (
	"github.com/immanent-tech/go-feed-me/models"
	"github.com/immanent-tech/go-feed-me/server/session"
	"github.com/immanent-tech/go-feed-me/web/templates/partials"
	"slices"
)

// SearchSuggestions will render suggestions for a given search.
templ SearchSuggestions(request *models.SearchRequest, subscriptions []*partials.Subscription, articles []*partials.Article) {
	// Always generate a suggestion to execute a full search.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="search-group-label">
		<a
			href="#"
			hx-get="/search"
			hx-target={ partials.ContentID.Target() }
			hx-include="[name='text']"
			hx-push-url="true"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content text-sm"
			_="on htmx:afterRequest add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Search for { request.Text }</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Search...</span>
		</a>
	</el-command-group>
	// Page suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="pages-group-label">
		<div id="pages-group-label" class="text-base-content/80 px-3 py-2">Pages</div>
		<a
			href="/home"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Home</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/subscriptions"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">All subscriptions</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/articles"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">All articles</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="/user/settings"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Settings</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
		<a
			href="#"
			hx-get="/user/subscription/add"
			hx-target={ partials.ContentID.Target() }
			hx-push-url="true"
			hidden
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
			_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
			</svg>
			<span class="ml-3 flex-auto truncate">Add subscription</span>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
		</a>
	</el-command-group>
	// Subscription suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="subscriptions-group-label">
		<div id="subscriptions-group-label" class="text-base-content/80 px-3 py-2">Subscriptions</div>
		for subscription := range slices.Values(subscriptions) {
			{{ values := session.ArticleFiltersFromSession(ctx).Parameters() }}
			{{ values[models.ParamSubscriptions] = subscription.GetID() }}
			<a
				href="#"
				hx-get="/articles"
				hx-vals={ models.GenerateHXVals(values) }
				hx-target={ partials.ContentID.Target() }
				hx-push-url="true"
				hidden
				class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
				_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
				</svg>
				<span class="ml-3 flex-auto truncate">{ subscription.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
	// Article suggestions.
	<el-command-group hidden class="block p-2 text-sm text-base-content" aria-labelledby="articles-group-label">
		<div id="articles-group-label" class="text-base-content/80 px-3 py-2">Articles</div>
		for article := range slices.Values(articles) {
			<a
				href="#"
				hx-get={ "/subscription/" + article.GetSubscriptionID() + "/article/" + article.GetID() }
				hx-target={ partials.ContentID.Target() }
				hx-push-url="true"
				hidden
				class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
				_="on click or keyup['Enter'] add @hidden to #global-search-suggestions"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
				</svg>
				<span class="ml-3 flex-auto truncate">{ article.GetTitle() } </span>
				<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
			</a>
		}
	</el-command-group>
}

// GlobalSearch renders a command palette element for powering global search within the app.
templ GlobalSearch() {
	<el-command-palette>
		<div class="grid grid-cols-1">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="pointer-events-none col-start-1 row-start-1 self-center size-5">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			</svg>
			<input
				id="global-search"
				type="text"
				name="text"
				hx-push-url="false"
				placeholder="Search..."
				class="col-start-1 row-start-1 block size-full outline-hidden pr-4 pl-6 text-base sm:text-sm/6 placeholder:text-base-content/50"
				hx-on::after-request="if(event.detail.successful) document.getElementById('global-search').value = ''"
				_="on keyup if the event's key is 'Escape' set my value to '' then add @hidden to #global-search-suggestions then trigger closeSearch"
			/>
			<button
				type="button"
				class="row-start-1 col-start-1 mr-4 self-center justify-self-end"
				_="on click set #global-search.value to '' then add @hidden to #global-search-suggestions"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
			</button>
			// Trigger full search when enter key pressed in search input.
			<div
				hx-trigger="keyup[Enter] from:#global-search"
				hx-get="/search"
				hx-target={ partials.ContentID.Target() }
				hx-include="[name='text']"
				hx-push-url="true"
			></div>
			// Trigger suggestion display after delay when search input contains text.
			<div
				hx-trigger="input changed from:#global-search delay:100ms"
				hx-get="/search/suggestions"
				hx-target="#global-search-suggestions"
				hx-include="[name='text']"
			></div>
		</div>
		<el-command-list
			id="global-search-suggestions"
			class="absolute w-full left-0 sm:left-21 lg:left-5 sm:w-(--input-width) block max-h-80 lg:max-h-160 scroll-py-2 overflow-y-auto rounded-md shadow-lg bg-base-300 text-base sm:text-sm/6"
			_="on keyup['Escape'] set #global-search.value to '' then add @hidden to #global-search-suggestions"
		></el-command-list>
		// <el-no-results
		// 	_="on closeSearch hide me"
		// 	hidden
		// 	class="absolute w-(--input-width) block px-6 py-14 text-center sm:px-14 rounded-md shadow-lg bg-base-300"
		// >
		// 	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto size-6">
		// 		<path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"></path>
		// 	</svg>
		// 	<p class="mt-4 text-sm text-base-content">No suggestions found.</p>
		// </el-no-results>
	</el-command-palette>
}
