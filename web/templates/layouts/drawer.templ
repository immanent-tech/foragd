package layouts

import (
	"github.com/immanent-tech/go-feed-me/models"
	"github.com/immanent-tech/go-feed-me/server/session"
	"github.com/immanent-tech/go-feed-me/web/templates"
	"github.com/immanent-tech/go-feed-me/web/templates/partials"
)

var sidebarID = "mobile-sidebar"

templ Drawer(content templ.Component) {
	// Mobile: drawer sidebar.
	<el-dialog id="mobile-sidebar-dialog">
		<dialog id={ sidebarID } class="backdrop:bg-transparent lg:hidden">
			<el-dialog-backdrop class="drawer-backdrop"></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
					<div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
						<button type="button" command="close" commandfor={ sidebarID } class="-m-2.5 p-2.5">
							<span class="sr-only">Close sidebar</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-base-content">
								<path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
					// Sidebar
					<div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-base-200 px-6 pb-4 ring ring-base-content/10 before:pointer-events-none before:absolute before:inset-0 before:bg-base-200/10">
						// TODO: replace me!
						<div class="relative flex h-16 shrink-0 items-center">
							@partials.Logo()
						</div>
						@DrawerSidebar("relative flex flex-1 flex-col", "mobile")
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	// Desktop: static sidebar.
	<div class="hidden bg-base-200 lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
		<div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-base-content/10 bg-base-200/10 px-6 pb-4">
			// TODO: replace me!
			<div class="flex h-16 shrink-0 items-center">
				@partials.Logo()
			</div>
			@DrawerSidebar("flex flex-1 flex-col", "desktop")
		</div>
	</div>
	<div class="lg:pl-72">
		@Header()
		<div id={ partials.ContentID.String() } class="mx-auto" hx-indicator="#content-loading">
			@templ.Fragment(templates.FragmentContent) {
				@content
			}
		</div>
		<div id="content-loading" class="htmx-indicator">
			<div class="text-center">
				<span class="loading loading-bars loading-xl"></span>
				<h3 class="mt-2 text-base font-semibold">Loading content...</h3>
			</div>
		</div>
		<div aria-live="assertive" class="pointer-events-none fixed inset-0 flex items-end px-4 py-6 sm:items-start sm:p-6 z-999">
			<div id={ partials.NotificationsID.String() } class="flex w-full flex-col items-center space-y-4 sm:items-end"></div>
		</div>
	</div>
}

templ DrawerSidebar(classes, layout string) {
	// <div class="flex h-16 shrink-0 items-center">
	// 	@partials.partials.NewAction("/home", partials.DisplayActionAsLink,
	// 		partials.ActionPushURL(),
	// 	) {
	// 		@partials.Logo("h-8 w-auto")
	// 	}
	// </div>
	<nav aria-label="Sidebar" class={ classes }>
		<ul role="list" class="flex flex-1 flex-col gap-y-7">
			<li>
				<ul role="list" class="-mx-2 space-y-1">
					<li>
						<a
							href="/home"
							class="group drawer-sidebar-link"
						>
							<span class="sr-only">Go to home page</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0 text-current">
								<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
							</svg>
							Home
						</a>
					</li>
					<li>
						<a
							hx-get="/subscriptions"
							hx-target={ partials.ContentID.Target() }
							hx-push-url="true"
							hx-vals={ session.SubscriptionFiltersFromSession(ctx).HXVals() }
							_="on click toggle @open on #mobile-sidebar-dialog"
							class="group drawer-sidebar-link"
						>
							<span class="sr-only">Show all unread subscriptions</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0 text-current">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
							</svg>
							Subscriptions
						</a>
					</li>
					<li>
						<a
							hx-get="/articles"
							hx-target={ partials.ContentID.Target() }
							hx-push-url="true"
							hx-vals={ session.ArticleFiltersFromSession(ctx).HXVals() }
							_="on click toggle @open on #mobile-sidebar-dialog"
							class="group drawer-sidebar-link"
						>
							<span class="sr-only">Show all unread articles</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0 text-current">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
							</svg>
							Articles
						</a>
					</li>
				</ul>
			</li>
			{{ user, found := models.UserFromCtx(ctx) }}
			if found {
				<li>
					<div class="text-sm/6 font-semibold text-base-content/80">Favorites</div>
					@partials.FavoritesList(user.GetFavorites(), models.OOBSwapFalse)
				</li>
			}
		</ul>
	</nav>
}

