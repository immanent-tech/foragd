package layouts

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/navigation/menu"
	"github.com/sebasvil20/templicons/tabler"
	"slices"
)

// Drawer layout will wrap its child template in a drawer layout with a left side bar.
templ Drawer() {
	<div class="drawer">
		<input id="body-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="drawer-content">
			@Header()
			<div id={ partials.ContentID.String() } class="h-full w-screen" hx-swap="innerHTML">
				{ children... }
			</div>
		</div>
		<div class="drawer-side">
			<label for="body-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
			@menu.Build(
				menu.WithClasses("bg-base-200", "text-base-content", "text-xs", "min-h-full", "w-80"),
			) {
				<li class="menu-title">Navigation</li>
				<li>
					@partials.NewAction("/home", partials.DisplayActionAsLink,
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click toggle @checked on #body-drawer"),
					) {
						<div class="icontext">
							@tabler.Home()
							Home
						</div>
					}
				</li>
				<li>
					@partials.NewAction("/subscriptions", partials.DisplayActionAsLink,
						partials.ActionValues(session.SubscriptionFiltersFromSession(ctx).Parameters()),
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click call document.activeElement.blur() end"),
					) {
						<div class="icontext">
							@tabler.Rss()
							Subscriptions
						</div>
					}
				</li>
				<li>
					@partials.NewAction("/articles", partials.DisplayActionAsLink,
						partials.ActionValues(session.SubscriptionFiltersFromSession(ctx).Parameters()),
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click call document.activeElement.blur() end"),
					) {
						<div class="icontext">
							@tabler.Article()
							Articles
						</div>
					}
				</li>
				<li class="menu-title">Favorites</li>
				<div
					id={ partials.FavoritesID.String() }
					hx-trigger="load, updateFavorites from:body"
					hx-get="/user/favorite"
					hx-target={ partials.FavoritesID.Target() }
				></div>
			}
		</div>
	</div>
}

templ FavoritesList(favorites models.FavoritesSlice) {
	{{ subscriptions := favorites.FilterByType(models.FavoriteTypeSubscription) }}
	{{ articles := favorites.FilterByType(models.FavoriteTypeArticle) }}
	{{ searches := favorites.FilterByType(models.FavoriteTypeSearch) }}
	if len(subscriptions) > 0 {
		// Show favorite subscriptions.
		<li>
			<a>Subscriptions</a>
			<ul>
				for fav := range slices.Values(subscriptions) {
					<li>
						@partials.FavoriteLink(fav)
					</li>
				}
			</ul>
		</li>
	}
	if len(articles) > 0 {
		// Show favorite articles.
		<li>
			<a>Articles</a>
			<ul>
				for fav := range slices.Values(articles) {
					<li>
						@partials.FavoriteLink(fav)
					</li>
				}
			</ul>
		</li>
	}
	if len(searches) > 0 {
		// Show favorite articles.
		<li>
			<a>Searches</a>
			<ul>
				for fav := range slices.Values(searches) {
					<li>
						@partials.FavoriteLink(fav)
					</li>
				}
			</ul>
		</li>
	}
}
