package layouts

import (
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/sebasvil20/templicons/tabler"
)

// Drawer layout will wrap its child template in a drawer layout with a left side bar.
templ Drawer() {
	<div class="drawer">
		<input id="body-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="drawer-content">
			@Header()
			<div id={ partials.ContentID.String() } class="m-2 h-full" hx-swap="innerHTML">
				{ children... }
			</div>
		</div>
		<div class="drawer-side">
			<label for="body-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
			<ul class="menu bg-base-200 text-base-content text-xs min-h-full w-80 p-4">
				<li class="menu-title">Navigation</li>
				<li>
					@partials.NewAction("/home", partials.DisplayActionAsLink,
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click toggle @checked on #body-drawer"),
					) {
						<div class="flex gap-2">
							@tabler.Home()
							Home
						</div>
					}
				</li>
				<li>
					@partials.NewAction("/subscriptions", partials.DisplayActionAsLink,
						partials.ActionValues(session.SubscriptionFiltersFromSession(ctx).Parameters()),
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click call document.activeElement.blur() end"),
					) {
						<div class="flex gap-2">
							@tabler.Rss()
							Subscriptions
						</div>
					}
				</li>
				<li>
					@partials.NewAction("/Articles", partials.DisplayActionAsLink,
						partials.ActionValues(session.SubscriptionFiltersFromSession(ctx).Parameters()),
						partials.ActionPushURL(),
						partials.ActionHyperScript("on click call document.activeElement.blur() end"),
					) {
						<div class="flex gap-2">
							@tabler.Article()
							Articles
						</div>
					}
				</li>
				<li class="menu-title">Favourites</li>
			</ul>
		</div>
	</div>
}
