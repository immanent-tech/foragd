package layouts

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/server/session"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"slices"
)

templ Drawer() {
	<el-dialog id="drawer-sidebar" _="on open call document.getElementById('navigation-menu-mobile').show()">
		<dialog id="sidebar" class="backdrop:bg-transparent lg:hidden">
			<el-dialog-backdrop class="fixed inset-0 bg-base-100/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 flex focus:outline-none">
				<el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
					<div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
						<button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
							<span class="sr-only">Close sidebar</span>
							@partials.HeroIconClose("size-6")
						</button>
					</div>
					<div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-base-200 px-6 ring ring-base-content/10 before:pointer-events-none before:absolute before:inset-0 before:bg-base-200/10">
						@DrawerSidebar("relative flex flex-1 flex-col mt-20 mb-8", "mobile")
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
	<div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
		<div
			class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-base-content/10 bg-base-200 px-6 pb-4"
			_="on intersection(intersecting) call document.getElementById('navigation-menu-desktop').show()"
		>
			@DrawerSidebar("flex flex-1 flex-col mt-20 mb-8", "desktop")
		</div>
	</div>
	<div class="lg:pl-72">
		@Header()
		<main class="content-width">
			<div id={ partials.ContentID.String() }>
				@templ.Fragment(templates.ContentFragment) {
					{ children... }
				}
			</div>
		</main>
	</div>
}

templ DrawerSidebar(classes, layout string) {
	// <div class="flex h-16 shrink-0 items-center">
	// 	@partials.partials.NewAction("/home", partials.DisplayActionAsLink,
	// 		partials.ActionPushURL(),
	// 	) {
	// 		@partials.Logo("h-8 w-auto")
	// 	}
	// </div>
	<nav class={ classes }>
		<ul role="list" class="flex flex-1 flex-col gap-y-7">
			<li>
				<ul role="list" class="-mx-2 space-y-1">
					<li>
						<button
							type="button"
							command="--toggle"
							commandfor={ "navigation-menu-" + layout }
							aria-expanded="true"
							aria-controls={ "navigation-menu-" + layout }
							class="flex w-full items-center inactive-link"
						>
							Navigation
							<svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="ml-auto size-5 shrink-0 not-in-aria-expanded:text-base-content in-aria-expanded:rotate-90 in-aria-expanded:text-base-content">
								<path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"></path>
							</svg>
						</button>
						<el-disclosure id={ "navigation-menu-" + layout } hidden class="contents transition transition-discrete duration-1000 data-closed:opacity-0">
							<ul class="mt-1 px-2">
								<li>
									<a
										href="/home"
										class="group inactive-link"
									>
										@partials.HeroIconHome("size-6 shrink-0 text-current")
										Home
									</a>
								</li>
								<li>
									<a
										hx-get="/subscriptions"
										hx-target={ partials.ContentID.Target() }
										hx-push-url="true"
										hx-vals={ session.SubscriptionFiltersFromSession(ctx).HXVals() }
										hx-on::after-request="if(event.detail.successful) document.getElementById('drawer-sidebar').hide()"
										class="group inactive-link"
									>
										@partials.HeroIconSubscription("size-6 shrink-0 text-current")
										Subscriptions
									</a>
								</li>
								<li>
									<a
										hx-get="/articles"
										hx-target={ partials.ContentID.Target() }
										hx-push-url="true"
										hx-vals={ session.ArticleFiltersFromSession(ctx).HXVals() }
										hx-on::after-request="if(event.detail.successful) document.getElementById('drawer-sidebar').hide()"
										class="group inactive-link"
									>
										@partials.HeroIconArticle("size-6 shrink-0 text-current")
										Articles
									</a>
								</li>
							</ul>
						</el-disclosure>
					</li>
					<li>
						<button
							type="button"
							command="--toggle"
							commandfor={ "favorites-menu-" + layout }
							aria-expanded="false"
							aria-controls={ "favorites-menu-" + layout }
							class="flex w-full items-center inactive-link"
						>
							Favorites
							<svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="ml-auto size-5 shrink-0 not-in-aria-expanded:text-base-content in-aria-expanded:rotate-90 in-aria-expanded:text-base-content">
								<path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"></path>
							</svg>
						</button>
						<el-disclosure id={ "favorites-menu-" + layout } hidden class="contents transition transition-discrete duration-1000 data-closed:opacity-0">
							<ul
								class="mt-1 px-2"
								id={ "favorites-" + layout }
								hx-trigger="load, updateFavorites from:body"
								hx-get="/user/favorite"
								hx-target={ "#favorites-" + layout }
							></ul>
						</el-disclosure>
					</li>
				</ul>
			</li>
		</ul>
	</nav>
}

templ FavoritesList(favorites models.FavoritesSlice) {
	{{ subscriptions := favorites.FilterByType(models.FavoriteTypeSubscription) }}
	{{ articles := favorites.FilterByType(models.FavoriteTypeArticle) }}
	{{ searches := favorites.FilterByType(models.FavoriteTypeSearch) }}
	if len(subscriptions) > 0 {
		// Show favorite subscriptions.
		<li class="text-xs/4 font-semibold text-base-content/80">Subscriptions</li>
		for fav := range slices.Values(subscriptions) {
			<li>
				@favoriteLink(fav, "group inactive-link")
			</li>
		}
	}
	if len(articles) > 0 {
		// Show favorite articles.
		<li class="text-xs/4 font-semibold text-base-content/80">Articles</li>
		for fav := range slices.Values(articles) {
			<li>
				@favoriteLink(fav, "group inactive-link")
			</li>
		}
	}
	if len(searches) > 0 {
		// Show favorite searches.
		<li class="text-xs/4 font-semibold text-base-content/80">Searches</li>
		for fav := range slices.Values(searches) {
			<li>
				@favoriteLink(fav, "group inactive-link")
			</li>
		}
	}
}

templ favoriteLink(fav *models.Favorite, classes string) {
	switch fav.Type {
		case models.FavoriteTypeSubscription:
			// FavouriteSubscription.
			{{ values := session.SubscriptionFiltersFromSession(ctx).Parameters() }}
			{{ values[models.ParamSubscriptions] = fav.GetID() }}
			<a
				hx-get="/subscripions"
				hx-target={ partials.ContentID.Target() }
				hx-vals={ partials.GenerateHXVals(values) }
				hx-push-url="true"
				hx-on::after-request="if(event.detail.successful) document.getElementById('drawer-sidebar').hide()"
				class={ classes }
			>
				@partials.HeroIconSubscription("size-4")
				{ fav.String() }
			</a>
		case models.FavoriteTypeArticle:
			// FavoriteArticle.
			<a
				hx-get={ "/article/" + fav.GetID() }
				hx-target={ partials.ContentID.Target() }
				hx-push-url="true"
				hx-on::after-request="if(event.detail.successful) document.getElementById('drawer-sidebar').hide()"
				class={ classes }
			>
				@partials.HeroIconArticle("size-4")
				{ fav.String() }
			</a>
		case models.FavoriteTypeSearch:
			// FavoriteArticle.
			{{ search, err := fav.ObjectData.AsFavoriteSearch() }}
			if err == nil {
				<a
					hx-get="/search"
					hx-target={ partials.ContentID.Target() }
					hx-vals={ partials.GenerateHXVals(map[string]string{"text": search.Text}) }
					hx-push-url="true"
					hx-on::after-request="if(event.detail.successful) document.getElementById('drawer-sidebar').hide()"
					class={ classes }
				>
					@partials.HeroIconSearch("size-4")
					{ fav.String() }
				</a>
			}
	}
}
