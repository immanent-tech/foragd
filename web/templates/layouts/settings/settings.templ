package settings

import (
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials/appbar"
	"github.com/joshuar/go-templ-daisyui/attributes"
)

var FooterID = attributes.ID("settings-footer")

type SettingsLayout struct {
	BackButton templ.Component
}

func BuildSettingsLayout(back templ.Component) *SettingsLayout {
	return &SettingsLayout{
		BackButton: back,
	}
}

templ (l *SettingsLayout) FullRender() {
	@templates.NewPage("Settings").Show() {
		@appbar.AppBar().Show()
		<div class="p-2 m-2">
			<h2>Display</h2>
			@themeChangeMenu()
		</div>
		<button
			id="confirm"
			hx-get="/confirmed"
			hx-trigger="confirmed"
			onclick="my_modal_1.showModal()"
		>
			Click Me
		</button>
		<dialog id="my_modal_1" class="modal" _="on closeModal add .closing then wait for animationend">
			<div class="modal-box">
				<h3 class="font-bold">Are you sure?</h3>
				<div class="modal-action">
					<form method="dialog">
						<button onClick="htmx.trigger('#confirm','confirmed')" class="btn">Yes</button>
						<button class="btn">No</button>
					</form>
				</div>
			</div>
			<div class="modal-backdrop" _="on click or keyup[key=='Esc'] remove @open from #my_modal_1 wait 200ms"></div>
		</dialog>
		@l.footer()
	}
}

templ (l *SettingsLayout) footer() {
	<div
		id={ FooterID.String() }
		hx-swap-oob="true"
		hx-swap="morph:outerHTML"
		class="bg-base-200 dock dock-sm"
	>
		<div title="Back" class="basis-xs">
			@l.BackButton
		</div>
	</div>
}
