package settings

import (
	"github.com/joshuar/go-feed-me/models"
	"github.com/joshuar/go-feed-me/web/templates"
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-feed-me/web/templates/partials/appbar"
)

type SettingsLayout struct {
	lastViewed models.PageView
}

func NewSettingsLayout(lastViewed models.PageView) *SettingsLayout {
	return &SettingsLayout{
		lastViewed: lastViewed,
	}
}

templ (l *SettingsLayout) Template() {
	@SettingsHeader()
	<div id="content">
		@SettingsContent()
	</div>
	@SettingsFooter(l.lastViewed)
}

templ SettingsHeader() {
	@appbar.AppBar().Show()
}

templ SettingsContent() {
	<h2>Display</h2>
	@themeChangeMenu()
	@templates.SetPageTitle("Settings")
}

templ SettingsFooter(lastViewed models.PageView) {
	{{ action := lastViewed.AsAction() }}
	{{ action.SetAttributes(templates.DefaultAttributes) }}
	<div
		id="content-footer"
		hx-swap-oob="true"
		hx-swap="morph:outerHTML"
		class="bg-base-200 dock dock-sm"
	>
		<div title="Back" class="basis-xs">
			@partials.BackButton(action.Attributes())
		</div>
	</div>
}
