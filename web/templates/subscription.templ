package templates

import (
	"github.com/dustin/go-humanize"
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strconv"
	"strings"
	"time"
)

// AddFeedsetsSuccessNotification renders a notification when a new user is successfully subscribed to one or more curated feedsets.
templ AddFeedsetsSuccessNotification(feedsets []string) {
	@Notification(models.NewSuccessMessage("Subscribed!", "You are now subscribed to the "+strings.Join(feedsets, ", ")+" feedsets(s)."), 10*time.Second) {
		<div class="mt-3 flex space-x-7">
			@NewLink(
				WithHXMethod(http.MethodGet, "/list/subscriptions"),
				WithHXTarget(ContentID.Target()),
				WithHXPushURL(),
			) {
				Go to Subscriptions <span aria-hidden="true">&rarr;</span>
			}
		</div>
	}
}

// SubscriptionCard renders a subscription in a card format, suitable for showing together with other subscriptions in a list/grid.
templ SubscriptionCard(s *models.Subscription) {
	{{ user, _ := models.UserFromCtx(ctx) }}
	<div
		id={ s.GetID() }
		class={ "card card-border border-base-content/15 h-full bg-base-100 shadow-sm",
			templ.KV("row-span-2",len(s.GetCategories(0))== 0),
			templ.KV("row-span-3",len(s.GetCategories(0)) >0),
			templ.KV("opacity-50",s.GetSubscriptionType() == models.SubscriptionTypeFeed && !s.GetStats().IsUnread()) }
	>
		<div class="card-body">
			<div class="flex items-center card-section">
				<div class="flex flex-1">
					@subscriptionHeading(s)
				</div>
				<div class="flex flex-none">
					@subscriptionContextMenu(s)
				</div>
			</div>
			// Display up to 5 of the subscription categories.
			if len(s.GetCategories(0)) > 0 {
				<div class="flex justify-center my-auto">
					<div class="flex flex-row flex-wrap place-content-center p-2 gap-2">
						for category := range slices.Values(s.GetCategories(5)) {
							{{ filters := models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values() }}
							{{ filters[models.ParamCategories] = category }}
							@NewLink(
								WithHXMethod(http.MethodGet, "/list/subscriptions"),
								WithHXTarget(ContentID.Target()),
								WithHXPushURL(),
								WithHXVals(filters),
							) {
								<div class="flex gap-2 capitalize">
									<div class="badge badge-accent badge-soft badge-sm">{ category }</div>
								</div>
							}
						}
					</div>
				</div>
			}
			// Show stats and info as appropriate.
			<div class="card-actions mt-auto grid grid-cols-3 px-4 sm:px-6">
				if s.GetSubscriptionType() == models.SubscriptionTypeFeed {
					<p class="grid justify-end col-span-3 text-xs/4 text-base-content/80">
						{ s.GetStats().UpdateFrequency() }
					</p>
				}
				<p class="col-span-2 text-xs/4 text-base-content/80">
					Last update
					if !s.GetUpdatedDate().IsZero() {
						{ humanize.Time(s.GetUpdatedDate()) }
					} else {
						unknown
					}
				</p>
				if user.GetSettings().ShowUnreadCounts {
					<p class="grid justify-end text-xs/4 text-base-content/80">
						{ s.GetStats().UnreadTotal() }
						Unread
					</p>
				}
			</div>
		</div>
	</div>
}

templ subscriptionContextMenu(s *models.Subscription) {
	@ContextMenu(s.GetTitle() + " Actions") {
		// View action.
		if s.GetSubscriptionType() == models.SubscriptionTypeFeed {
			@NewLink(
				WithCustomAttribute("href", s.GetLink()),
				WithCustomAttribute("rel", "noopener"),
				WithCustomAttribute("target", "_blank"),
				WithClasses("context-menu-item-base"),
			) {
				@tabler.ExternalLink(i.Props{Class: "size-4"})
				Feed Website
			}
			// Mark action.
			<form id={ "mark-" + s.GetID() }>
				// MarkURL returns the app URL for marking the subscription.
				{{ var markURL string }}
				if s.GetStats().IsUnread() {
					{{ markURL = "/mark/subscription/" + s.GetID() + "/read" }}
				} else {
					{{ markURL = "/mark/subscription/" + s.GetID() + "/unread" }}
				}
				@NewLink(
					WithHXMethod(http.MethodPost, markURL),
					WithHXInclude("[name='csrf_token'],#content-filters"),
					WithHXTarget("#"+s.GetID()),
					WithClasses("context-menu-item-base"),
				) {
					switch s.GetStats().IsUnread() {
						case true:
							@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
							Mark Read
						case false:
							@tabler.MailFilled(i.Props{Class: "size-4"})
							Mark Unread
					}
				}
				// @MarkObjectLink(s, "#"+s.GetID(), "outerHTML", "context-menu-item-base")
			</form>
			// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
			<div id={ "favorite_" + s.GetID() }>
				@ToggleFavorite(s.GetID(), string(models.ObjectTypeSubscription), s.IsFavorite())
			</div>
		}
		// Edit action.
		@NewLink(
			WithHXMethod(http.MethodGet, "/edit/subscription/"+s.GetID()),
			WithHXTarget(ContentID.Target()),
			WithHXSwap("innerHTML show:top transition:true"),
			WithHXPushURL(),
			WithClasses("context-menu-item-base"),
		) {
			@tabler.Edit(i.Props{Class: "size-4"})
			Edit Subscription
		}
		// Unsubscribe action.
		<form>
			<input type="hidden" name="nickname" value={ s.GetTitle() }/>
			<input type="hidden" name="confirmed" value="false"/>
			@NewLink(
				WithHXMethod(http.MethodPost, "/remove/subscription/"+s.GetID()),
				WithHXTarget(ModalContainerID.Target()),
				WithHXInclude("[name='csrf_token']"),
				WithClasses("context-menu-item-base"),
				WithCustomAttribute("_", "on htmx:afterOnLoad wait 10ms then call document.getElementById('unsubscribe').show()"),
			) {
				@tabler.TrashFilled(i.Props{Class: "size-4"})
				Remove Subscription
			}
		</form>
		// Report issue action.
		@NewLink(
			WithHXMethod(http.MethodGet, "/issue/subscription/"+s.GetID()),
			WithHXTarget(ContentID.Target()),
			WithClasses("context-menu-item-base"),
		) {
			@tabler.FlagFilled(i.Props{Class: "size-4"})
			Report an issue
		}
	}
}

templ subscriptionHeading(s *models.Subscription) {
	switch s.GetSubscriptionType() {
		case models.SubscriptionTypeFeed:
			@viewFeedSubscriptionLink(s)
		case models.SubscriptionTypeSearch:
			@viewSearchSubscriptionLink(s)
	}
}

templ viewFeedSubscriptionLink(s *models.Subscription) {
	{{ overrides := map[string]string{models.ParamSort: string(models.SortNewestFirst), "subscriptions": s.GetID()} }}
	if s.GetStats().IsUnread() {
		{{ overrides[models.ParamView] = string(models.ViewUnread) }}
	} else {
		{{ overrides[models.ParamView] = string(models.ViewRead) }}
	}
	@NewLink(
		WithHXMethod(http.MethodGet, "/list/articles"),
		WithHXInclude("#content-filters"),
		WithHXVals(overrides),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(),
		WithHXSwap("innerHTML show:top transition:true"),
		WithClasses("flex", "items-center", "gap-x-4", "hover:text-accent"),
	) {
		<div class="flex items-center">
			<div class="mr-4 shrink-0 self-center">
				// Generate a thumbnail to display next to the title.
				if img := s.GetImage(); img != "" {
					// If the source has an image, use that as the avatar.
					<div class="avatar">
						<div class="rounded-box size-12">
							<img
								src={ "/img-proxy/48x48/" + img }
								width="48"
								height="48"
							/>
							// if img.GetTitle() != "" {
							// 	alt={ img.GetTitle() }
							// }
						</div>
					</div>
				} else {
					// Otherwise, take the first letter of the title and create a placeholder avatar.
					<div class="avatar avatar-placeholder">
						<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
							<span class="text-3xl capitalize">{ s.GetTitle()[0:1] }</span>
						</div>
					</div>
				}
			</div>
			<div>
				<h4 id="subscription-name" class="text-lg font-bold line-clamp-2">{ s.GetTitle() }</h4>
			</div>
		</div>
	}
}

templ viewSearchSubscriptionLink(s *models.Subscription) {
	<form>
		<input type="hidden" name={ models.ParamSubscriptionID } value={ s.GetID() }/>
		@NewLink(
			WithHXMethod(http.MethodPost, "/search"),
			WithHXInclude("[name='csrf_token']"),
			WithHXValsJS(s.SearchData.Search.HXVals()),
			WithHXTarget(ContentID.Target()),
			WithHXPushURL(),
			WithHXSwap("innerHTML show:top transition:true"),
			WithClasses("flex", "items-center", "gap-x-4", "hover:text-accent"),
		) {
			<div class="flex items-center">
				<div class="mr-4 shrink-0 self-center">
					// Generate a thumbnail to display next to the title.
					if img := s.GetImage(); img != "" {
						// If the source has an image, use that as the avatar.
						<div class="avatar">
							<div class="rounded-box size-12">
								<img
									src={ "/img-proxy/48x48/" + img }
									width="48"
									height="48"
								/>
								// if img.GetTitle() != "" {
								// 	alt={ img.GetTitle() }
								// }
							</div>
						</div>
					} else {
						// Otherwise, take the first letter of the title and create a placeholder avatar.
						<div class="avatar avatar-placeholder">
							<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
								<span class="text-3xl capitalize">{ s.GetTitle()[0:1] }</span>
							</div>
						</div>
					}
				</div>
				<div>
					<h4 id="subscription-name" class="text-lg font-bold line-clamp-2">{ s.GetTitle() }</h4>
				</div>
			</div>
		}
	</form>
}

templ SubscriptionsGrid(pagination models.Pagination, subscriptions ...*models.Subscription) {
	{{ filters := models.PageFiltersFromCtx(ctx, "/list/subscriptions") }}
	@Main() {
		<div class="flex items-center justify-between mt-4">
			// Page heading.
			<div class="min-w-0 flex-1">
				<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">
					Subscriptions
				</h2>
			</div>
			// Subscriptions actions menu.
			<el-dropdown class="inline-block flex-none">
				<button class="inline-flex flex-col items-center">
					<span class="sr-only">Subscriptions Actions</span>
					@tabler.DotsVertical(i.Props{Class: "size-6"})
				</button>
				<el-menu anchor="bottom end" popover class="context-menu-base">
					<div class="py-1">
						// Mark all subscriptions action.
						@NewLink(
							WithHXMethod(http.MethodPost, "/list/subscriptions/mark"),
							WithHXTarget(ContentID.Target()),
							WithHXInclude("#content-filters,[name='csrf_token']"),
							WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
						) {
							if models.PageFiltersFromCtx(ctx,"/list/subscriptions").GetView() == models.ViewUnread {
								@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
								<span class="sr-only">Mark All Read</span>
								Mark all Read
							} else {
								@tabler.MailFilled(i.Props{Class: "size-4"})
								<span class="sr-only">Mark All Unread</span>
								Mark all Unread
							}
						}
					</div>
					<div class="py-1">
						@NewLink(
							WithHXMethod(http.MethodGet, "/user/subscription/add/feed"),
							WithHXTarget(ContentID.Target()),
							WithHXPushURL(),
							WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
						) {
							@tabler.Plus(i.Props{Class: "size-4"})
							Add Feed Subscription
						}
					</div>
					<div class="py-1">
						@NewLink(
							WithHXMethod(http.MethodGet, "/user/subscription/add/search"),
							WithHXTarget(ContentID.Target()),
							WithHXInclude("#search-filters"),
							WithHXPushURL(),
							WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
						) {
							@tabler.Plus(i.Props{Class: "size-4"})
							Add Search Subscription
						}
					</div>
				</el-menu>
			</el-dropdown>
		</div>
		// Hidden content filters.
		<div id="content-filters" class="hidden">
			<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
			<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
			<input type="hidden" name={ models.ParamSort } value={ string(filters.GetSort()) }/>
			<input type="hidden" name={ models.ParamOnlyFavorites } value={ strconv.FormatBool(filters.OnlyFavorites) }/>
			if len(filters.GetCategories()) > 0 {
				<input type="hidden" name={ models.ParamCategories } value={ strings.Join(filters.GetCategories(), ",") }/>
			}
			if len(filters.GetSubscriptions()) > 0 {
				<input type="hidden" name={ models.ParamSubscriptions } value={ strings.Join(filters.GetSubscriptions(), ",") }/>
			}
		</div>
		<div id="update-notifications" sse-connect={ "/list/subscriptions/updates?" + filters.QueryParams().Encode() } sse-swap="message" class="toast toast-center z-50"></div>
		@FilterControls(models.GetCategoryCounts(subscriptions...), filters)
		<section class="mt-4">
			if len(subscriptions) > 0 {
				@Grid() {
					@SubscriptionsList(pagination, subscriptions...)
				}
			} else {
				@EmptyContent()
			}
		</section>
	}
}

templ SubscriptionsList(pagination models.Pagination, subscriptions ...*models.Subscription) {
	{{ filters := models.PageFiltersFromCtx(ctx, "/list/subscriptions") }}
	for subscription := range slices.Values(subscriptions) {
		@SubscriptionCard(subscription)
	}
	if pagination != "" && len(subscriptions) == filters.GetCount() {
		// Add pagination htmx props to last article.
		@PaginationControl(ctx, "/list/subscriptions/paginate", pagination)
	}
}

// SubscriptionsDockActions renders additional actions in the sidebar for acting on a list of subscriptions.
templ SubscriptionsDockActions() {
	<div class="items-center">
		<el-dropdown class="inline-block">
			<button class="inline-flex flex-col items-center">
				@tabler.Menu(i.Props{Class: "size-6"})
				<span class="dock-label">Actions</span>
			</button>
			<el-menu anchor="bottom end" popover class="context-menu-base">
				<div class="py-1">
					// Mark all subscriptions action.
					@NewLink(
						WithHXMethod(http.MethodPost, "/list/subscriptions/mark"),
						WithHXTarget(ContentID.Target()),
						WithHXInclude("#content-filters,[name='csrf_token']"),
						WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
					) {
						if models.PageFiltersFromCtx(ctx,"/list/subscriptions").GetView() == models.ViewUnread {
							@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
							<span class="sr-only">Mark All Read</span>
							Mark all Read
						} else {
							@tabler.MailFilled(i.Props{Class: "size-4"})
							<span class="sr-only">Mark All Unread</span>
							Mark all Unread
						}
					}
				</div>
				<div class="py-1">
					@NewLink(
						WithHXMethod(http.MethodGet, "/user/subscription/add/feed"),
						WithHXTarget(ContentID.Target()),
						WithHXPushURL(),
						WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
					) {
						@tabler.Plus(i.Props{Class: "size-4"})
						Add Subscription
					}
				</div>
			</el-menu>
		</el-dropdown>
	</div>
}

// SubscriptionsSidebarActions renders additional actions in the sidebar for acting on a list of subscriptions.
templ SubscriptionsSidebarActions() {
	// Mark all subscriptions action.
	<li>
		@NewLink(
			WithHXMethod(http.MethodPost, "/list/subscriptions/mark"),
			WithHXTarget(ContentID.Target()),
			WithHXInclude("#content-filters,[name='csrf_token']"),
			WithClasses("group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
		) {
			if models.PageFiltersFromCtx(ctx,"/list/subscriptions").GetView() == models.ViewUnread {
				@tabler.MailOpenedFilled(i.Props{Class: "size-6 shrink-0 text-current"})
				<span class="sr-only">Mark All Read</span>
				Mark all Read
			} else {
				@tabler.MailFilled(i.Props{Class: "size-6 shrink-0 text-current"})
				<span class="sr-only">Mark All Unread</span>
				Mark all Unread
			}
		}
	</li>
	// Add new subscription action.
	<li>
		@NewLink(
			WithHXMethod(http.MethodGet, "/user/subscription/add/feed"),
			WithHXTarget(ContentID.Target()),
			WithHXPushURL(),
			WithClasses("group link link-hover hover:text-accent flex flex-col items-center p-2 text-xs/5 font-semibold text-center"),
		) {
			@tabler.Plus(i.Props{Class: "size-6 shrink-0 text-current	"})
			Add Subscription
		}
	</li>
}

templ EditSubscription(request *models.EditSubscriptionRequest) {
	@Main() {
		<div class="min-w-0 flex-1 pb-8">
			<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">Editing { request.Nickname }</h2>
		</div>
		if request.HasError() {
			<div role="alert" class="alert alert-error alert-outline mt-12">
				<div class="px-4 py-5 sm:p-6 space-y-4">
					<span class="gap-y-2">
						<p class="font-semibold text-base">Invalid Details</p>
						<p class="text-sm">There is a problem with the details. Please check and try again.</p>
					</span>
				</div>
			</div>
		}
		<div class="space-y-8">
			<form
				id="edit-subscription"
				hx-post={ "/edit/subscription/" + request.GetID() }
				hx-include="#current-categories,[name='csrf_token']"
				hx-swap="none"
				hx-indicator="#processing"
			>
				<input type="hidden" name={ models.ParamSubscriptionID } value={ request.SubscriptionID }/>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeFeed) }/>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Nickname</h2>
						<p class="mt-1 text-sm/6 text-base-content/60">A friendly name for this subscription.</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input id="nickname" required type="text" name="nickname" value={ request.GetNickname() } placeholder="My Subscription" class="input input-primary bg-base-content/10"/>
						</div>
					</div>
				</div>
				// Filtering.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Filtering</h2>
						<div class="flex items-center">
							<p class="mt-1 text-sm/6 text-base-content/60">Filter articles by keywords/text in fields.</p>
							@HelpPopover("subscription-filters-help", "top end") {
								<div class="card-body">
									<p>By default words are matched with OR (i.e., cats dogs will match cats OR dogs). The following operators can be used for more refined searches:</p>
									<p>+ signifies AND operation (i.e., food AND beverages)</p>
									<p>| signifies OR operation (i.e., food OR beverages)</p>
									<p>- negates a the word (i.e., NOT alcoholic)</p>
									<p>"" represents an exact phrase match (i.e., "rum-based drinks")</p>
									<p>* at the end of indicates a prefix match (i.e., match bird, birding and birds)</p>
								</div>
							}
						</div>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10">
								<label for="name" class="block text-xs font-medium">Text:</label>
								<input id="article_text_filters" type="text" name="article_filters.text" value={ request.ArticleFilters.Text } placeholder="Text..." class="block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10">
								<label for="name" class="block text-xs font-medium">Categories:</label>
								<input id="article_category_filters" type="text" name="article_filters.categories" value={ request.ArticleFilters.Categories } placeholder="Categories..." class="block w-full"/>
							</div>
						</div>
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10">
								<label for="name" class="block text-xs font-medium">Authors:</label>
								<input id="article_author_filters" type="text" name="article_filters.authors" value={ request.ArticleFilters.Authors } placeholder="Authors..." class="block w-full"/>
							</div>
						</div>
					</div>
				</div>
				// Full article content toggle.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Always Show Full Article Content</h2>
						<div class="flex items-center">
							<p class="mt-1 text-sm/6 text-base-content/60">
								Always fetch and show article content from original site.
							</p>
							@HelpPopover("show-full-article-help", "top end") {
								<div class="card-body">
									<p>If articles in the subscription are only showing a summary, set this toggle to attempt to fetch the full content from the website.</p>
									<p>Note: fetching full content is based on a heuristic that tries to locate the article content on the page. It does not always produce optimal results.</p>
								</div>
							}
						</div>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								type="checkbox"
								if request.ShowFullArticleContent {
									checked="checked"
								}
								name="show_full_article_content"
								class="toggle toggle-sm toggle-primary"
							/>
						</div>
					</div>
				</div>
			</form>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "categories", nil, request.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				<button type="button" onclick="history.back()" class="btn btn-secondary btn-soft">Back</button>
				<button type="submit" form="edit-subscription" class="btn btn-primary btn-soft">Save</button>
			</div>
		</div>
	}
}

templ EditSubscriptionSuccessNotification(subscription *models.Subscription) {
	@Notification(&models.UserMessage{
		Status:  models.UserMessageStatusSuccess,
		Summary: subscription.GetTitle() + " updated",
	}, 15*time.Second) {
		<div class="mt-3 flex space-x-7">
			<button
				type="button"
				class="rounded-md text-sm font-medium hover:bg-accent/20 hover:text-accent-content focus:outline-2 focus:outline-offset-2 focus:outline-primary"
				hx-get="/list/subscriptions"
				hx-target={ ContentID.Target() }
				hx-push-url="true"
				_={ "on click remove #" + GetNotificationIDFromCtx(ctx) }
			>Go to subscriptions <span aria-hidden="true">&rarr;</span></button>
		</div>
	}
}

// AddFeedSubscription is a page for adding a new subscription to a feed.
templ AddFeedSubscription(request *models.AddFeedSubscriptionRequest) {
	@Main() {
		<div class="min-w-0 flex-1 pb-8">
			<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">Add A Subscription</h2>
		</div>
		if request.HasError() {
			<div role="alert" class="alert alert-error alert-outline mt-12">
				<div class="px-4 py-5 sm:p-6 space-y-4">
					<span class="gap-y-2">
						<p class="font-semibold text-base">Invalid Details</p>
						<p class="text-sm">There is a problem with the details. Please check and try again.</p>
					</span>
				</div>
			</div>
		}
		<div class="space-y-8">
			<form
				id="add-subscription"
				hx-post="/user/subscription/add/feed"
				hx-swap="none"
				hx-include="[name='user_categories'],[name='csrf_token']"
				hx-indicator="#processing"
				hx-on::after-request="if(event.detail.successful) this.reset()"
			>
				// URL.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Feed Website or URL</h2>
						<p class="mt-1 text-sm/6 text-base-content/60">Required. The feed's URL or website (feed detection from a website URL may or may not work).</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="url"
								required
								type="url"
								name="url"
								value={ request.URL }
								placeholder="https://my-favorite-site/feed"
								class="input input-primary bg-base-content/10 w-full"
							/>
							if request.URLErr != nil {
								<p class="text-error py-2 text-xs/4 font-semibold">Error: { request.URLErr.Error() }</p>
							}
						</div>
					</div>
				</div>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Feed Nickname</h2>
						<p class="mt-1 text-sm/6 text-base-content/60">Optional. A Friendly name for the subscription. Will use the feed's name if not specified.</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="sm:col-span-4 mt-2">
							<input
								id="nickname"
								type="text"
								name="nickname"
								value={ request.Nickname }
								placeholder="My cool subscription"
								class={ templ.KV("input input-primary bg-base-content/10",request.NicknameErr == nil), templ.KV("input input-error bg-base-content/10",request.NicknameErr !=nil) }
							/>
							if request.NicknameErr != nil {
								<p class="text-error py-2 text-xs/4 font-semibold">{ request.NicknameErr.Error() }</p>
							}
						</div>
					</div>
				</div>
			</form>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "categories", nil, request.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				<button type="button" onclick="history.back()" class="btn btn-secondary btn-soft">Back</button>
				<button type="submit" form="add-subscription" class="btn btn-primary btn-soft">Add</button>
			</div>
		</div>
	}
}

// AddSearchSubscription is a page for adding a new search subscription.
templ AddSearchSubscription(request *models.SearchSubscriptionRequest) {
	@manageSearchSubscription(request, "add")
}

// EditSearchSubscription is a page for editing a search subscription.
templ EditSearchSubscription(request *models.SearchSubscriptionRequest) {
	@manageSearchSubscription(request, "edit")
}

templ manageSearchSubscription(request *models.SearchSubscriptionRequest, action string) {
	@Main() {
		<div class="min-w-0 flex-1 pb-8">
			switch action {
				case "add":
					<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">Add A Search Subscription</h2>
				case "edit":
					<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">{ "Editing "+request.Customisation.Nickname }</h2>
			}
		</div>
		// if request.HasError() {
		// 	<div role="alert" class="alert alert-error alert-outline mt-12">
		// 		<div class="px-4 py-5 sm:p-6 space-y-4">
		// 			<span class="gap-y-2">
		// 				<p class="font-semibold text-base">Invalid Details</p>
		// 				<p class="text-sm">There is a problem with the details. Please check and try again.</p>
		// 			</span>
		// 		</div>
		// 	</div>
		// }
		<div class="flex items-center border-b border-base-content/60">
			<h3 class="text-base font-semibold">Search Filters</h3>
			// Help dialog.
			<div class="ml-4">
				@HelpPopover("subscription-filter-operators-help", "bottom end") {
					<div tabindex="0" class="text-xs/tight sm:text-sm/tight rounded-box p-4 shadow-sm border border-base-content/15 bg-base-300">
						<p>By default words are matched with OR (i.e., cats dogs will match cats OR dogs). The following operators can be used for more refined searches:</p>
						<ul class="gap-y-2">
							<li>+ signifies AND operation (i.e., food AND beverages)</li>
							<li>| signifies OR operation (i.e., food OR beverages)</li>
							<li>- negates a the word (i.e., NOT alcoholic)</li>
							<li>"" represents an exact phrase match (i.e., "rum-based drinks")</li>
							<li>* at the end of indicates a prefix match (i.e., match bird, birding and birds)</li>
						</ul>
					</div>
				}
			</div>
		</div>
		<div class="space-y-8">
			// hx-on::after-request="if(event.detail.successful) this.reset()"
			<form
				id="manage-search-subscription"
				if action == "add" {
					hx-post="/user/subscription/add/search"
				} else {
					hx-post={ "/user/subscription/edit/" + request.Search.ID }
				}
				hx-swap="none"
				hx-include="[name='customisation.user_categories'],[name='csrf_token']"
				hx-vals="js:{'search.timezone': Intl.DateTimeFormat().resolvedOptions().timeZone}"
				hx-indicator="#processing"
			>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeSearch) }/>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Includes the words</h2>
						// <p class="mt-1 text-sm/6 text-base-content/60"></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-text"
								type="text"
								name="search.text"
								value={ request.Search.Text }
								placeholder={ `e.g., "Breaking News" | Live` }
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Article Category Filters</h2>
						// <p class="mt-1 text-sm/6 text-base-content/60"></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-categories"
								type="text"
								name="search.categories"
								value={ request.Search.Categories }
								placeholder="e.g., drinks + mediation"
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Article Author Filters</h2>
						// <p class="mt-1 text-sm/6 text-base-content/60"></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-authors"
								type="text"
								name="search.authors"
								value={ request.Search.Authors }
								placeholder={ `e.g., -"John Smith"` }
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">In Subscriptions</h2>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<label class="input input-primary bg-base-content/10 w-full">
								@tabler.Search(i.Props{Class: "size-5"})
								<input
									id="subscription-filter-subscriptions-search"
									name="subscription-text"
									placeholder="Search subscriptions..."
									autocomplete="off"
									hx-post="/search/subscription/suggestions"
									hx-trigger="input changed delay:500ms,consume"
									hx-target="#subscription-filter-subscriptions-options"
									hx-swap="innerHTML"
									hx-params="subscription-text,csrf_token"
									hx-include="[name='csrf_token']"
									hx-push-url="false"
								/>
							</label>
							<div
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
								id="subscription-filter-subscriptions-options"
								hx-target="#subscription-filter-subscriptions"
								_="on htmx:afterRequest set #subscription-filter-subscriptions-search.value to ''"
							></div>
							<div
								id="subscription-filter-subscriptions"
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
							>
								for subscription := range slices.Values(models.SubscriptionsFromCtx(ctx)) {
									@AddSearchSubscriptionFilter(subscription.GetID(), subscription.GetTitle())
								}
							</div>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Published Within</h2>
						// <p class="mt-1 text-sm/6 text-base-content/60"></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full">
							<select id="subscription-filter-published-within" name="search.published_within" class="select select-primary my-2 bg-base-300">
								<option
									value="last_hour"
								>Last hour</option>
								<option
									value="last_half_day"
								>Last 12 hours</option>
								<option
									value="last_day"
								>Last day</option>
								<option
									value="last_week"
									selected
								>Last week</option>
								<option
									value="last_month"
								>Last month</option>
							</select>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<h2 class="text-base/7 font-semibold">Sort By</h2>
						// <p class="mt-1 text-sm/6 text-base-content/60"></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full">
							<select id="subscription-filter-sort" name="search.sort" class="select select-primary my-2 bg-base-300">
								<option
									value={ string(models.SortMostRelevant) }
									if request.Search.Sort == models.SortMostRelevant {
										selected
									}
								>
									Most Relevant
								</option>
								<option
									value={ string(models.SortNewestFirst) }
									if request.Search.Sort == models.SortNewestFirst {
										selected
									}
								>Newest First</option>
								<option
									value={ string(models.SortOldestFirst) }
									if request.Search.Sort == models.SortOldestFirst {
										selected
									}
								>Oldest First</option>
							</select>
						</div>
					</div>
				</div>
			</form>
			<div class="border-b border-base-content/60">
				<h3 class="text-base font-semibold">Subscription Info</h3>
			</div>
			// Nickname.
			<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
				<div>
					<h2 class="text-base/7 font-semibold">Nickname</h2>
					// <p class="mt-1 text-sm/6 text-base-content/60"></p>
				</div>
				<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
					<div class="col-span-full mt-2">
						<input
							id="subscription-nickname"
							type="text"
							required
							name="customisation.nickname"
							value={ request.Customisation.Nickname }
							placeholder="My Search Subscription"
							class="input input-primary bg-base-content/10 w-full"
							form="manage-search-subscription"
						/>
					</div>
				</div>
			</div>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "customisation.categories", nil, request.Customisation.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				<button type="button" onclick="history.back()" class="btn btn-secondary btn-soft">Back</button>
				<button type="submit" form="manage-search-subscription" class="btn btn-primary btn-soft">
					if action == "add" {
						Add
					} else {
						Save
					}
				</button>
			</div>
		</div>
	}
}

// ImportPage is a page for importing subscriptions from an external source (e.g., an OPML file).
templ ImportSubscriptions() {
	@Main() {
		<div class="md:flex md:items-center md:justify-between">
			<div class="min-w-0 flex-1">
				<h2 class="text-2xl/7 font-bold sm:text-3xl sm:tracking-tight">Import Subscriptions</h2>
			</div>
			<p class="mt-2 max-w-4xl text-sm sm:truncate text-base-content/80">
				You can import your existing subscriptions from an OPML file. Most feed services support generating an OPML file you can use.
			</p>
		</div>
		<div class="border-base-content/10 sm:divide-base-content/10 sm:border-t-base-content/10 mt-10 space-y-8 pb-12 sm:space-y-0 sm:divide-y sm:border-t sm:pb-0">
			<form
				id="import"
				hx-encoding="multipart/form-data"
				hx-post="/user/import"
				hx-target="#import-results"
				hx-include="[name='csrf_token']"
				hx-indicator="#processing"
			>
				<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
					<label for="source" class="block text-sm/6 font-medium">OPML file</label>
					<div class="mt-2 sm:col-span-2 sm:mt-0">
						<input id="source" type="file" required name="source" class="file-input file-input-primary bg-base-content/10"/>
					</div>
				</div>
				<div class="mt-6 flex items-center justify-end gap-x-6">
					<div id="processing" class="htmx-indicator">
						Processing...
						<span class="loading loading-spinner loading-md"></span>
					</div>
					<button
						type="button"
						onclick="history.back()"
						class="btn btn-secondary btn-soft"
					>
						Back
					</button>
					<button
						type="submit"
						class="btn btn-primary btn-soft"
					>
						Import
					</button>
				</div>
			</form>
		</div>
		<div id="import-results" class="space-y-4"></div>
	}
}

// ImportResults is a partial template that displays the results of an import.
templ ImportResults(results []*models.AddFeedSubscriptionResult) {
	{{ successfulResults := filterSuccessfulResults(results) }}
	{{ failedResults := filterUnsuccessfulResults(results) }}
	<div class="min-w-0 flex-1 pb-8">
		<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight capitalize">Import Results</h2>
	</div>
	<p class="mt-2 max-w-4xl text-sm sm:truncate text-base-content/80">
		{ "Imported: " + strconv.Itoa(len(successfulResults)) + " Failed: " + strconv.Itoa(len(failedResults)) }
	</p>
	@NewButton(
		WithHXMethod(http.MethodGet, "/list/subscriptions"),
		WithHXTarget(ContentID.Target()),
		WithHXVals(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()),
		WithClasses("btn-primary"),
	) {
		Go to your subscriptions
	}
	<div class="mt-10 space-y-8 border-t border-neutral">
		<ul class="list">
			for response := range slices.Values(slices.Concat(successfulResults,failedResults)) {
				<li class="list-row items-center">
					switch response.Message.Status {
						case models.UserMessageStatusSuccess:
							@tabler.CircleCheck(i.Props{Class: "size-10 text-success"})
							<div>
								<div>{ response.Message.Summary }</div>
							</div>
						case models.UserMessageStatusError:
							@tabler.ExclamationCircle(i.Props{Class: "size-10 text-error"})
							<div>
								<div>{ response.Message.Summary }</div>
								if response.Message.HasDetails() {
									<p class="list-col-wrap text-xs">
										{ response.Message.Details }
									</p>
								}
							</div>
						case models.UserMessageStatusWarning:
							@tabler.AlertTriangle(i.Props{Class: "size-10 text-warning"})
							<div>
								<div>{ response.Message.Summary }</div>
								if response.Message.HasDetails() {
									<p class="list-col-wrap text-xs">
										{ response.Message.Details }
									</p>
								}
							</div>
					}
				</li>
			}
		</ul>
	</div>
	<button class="btn btn-neutral fixed right-0 bottom-0 m-4" href={ ContentID.Target() }>Back to top</button>
}

func filterSuccessfulResults(results []*models.AddFeedSubscriptionResult) []*models.AddFeedSubscriptionResult {
	return slices.Collect(models.FilterSlice(results, func(result *models.AddFeedSubscriptionResult) bool {
		return result.Message.Status == models.UserMessageStatusSuccess
	}))
}

func filterUnsuccessfulResults(results []*models.AddFeedSubscriptionResult) []*models.AddFeedSubscriptionResult {
	return slices.Collect(models.FilterSlice(results, func(result *models.AddFeedSubscriptionResult) bool {
		return result.Message.Status != models.UserMessageStatusSuccess
	}))
}

// ExportSubscriptions renders a form for exporting all subscriptions as an OPML file.
templ ExportSubscriptions() {
	@Main() {
		<div class="md:flex md:items-center md:justify-between mt-8">
			<div class="min-w-0 flex-1">
				<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight">Export Subscriptions</h2>
			</div>
		</div>
		<p class="mt-2 max-w-4xl text-sm text-base-content/80">
			You can export your current subscription to an OPML file, which all good feed readers can import.
		</p>
		<div class="mt-10 space-y-8">
			<div class="mt-6 flex items-center justify-end gap-x-6">
				<button type="button" onclick="history.back()" class="btn btn-secondary btn-soft">
					Back
				</button>
				<a
					role="button"
					class="btn btn-primary btn-soft"
					href="/user/export/opml"
					download
				>
					Export
				</a>
			</div>
		</div>
		<center id="processing" class="htmx-indicator">
			Processing, this could take a few minutes...
			<span class="loading loading-spinner loading-md"></span>
		</center>
	}
}

// RemoveObjectModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ RemoveSubscriptionModal(request *models.RemoveSubscriptionRequest) {
	{{ id := "unsubscribe" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { request.Nickname }?</p>
				</div>
			</div>
		</div>
		<div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
			<form
				hx-post={ "/remove/subscription/" + string(request.SubscriptionID) }
				hx-target={ "#" + request.SubscriptionID }
				hx-include="[name='csrf_token']"
				hx-swap="delete transition:true"
				_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
			>
				<input type="hidden" name="nickname" value={ request.Nickname }/>
				<input type="hidden" name="confirmed" value="true"/>
				<button
					type="submit"
					class="inline-flex w-full justify-center rounded-md bg-error/80 px-3 py-2 text-sm font-semibold text-error-content shadow-xs hover:bg-error sm:ml-3 sm:w-auto"
				>Unsubscribe</button>
			</form>
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="mt-3 inline-flex w-full justify-center rounded-md bg-primary/80 px-3 py-2 text-sm font-semibold text-primary-content shadow-xs ring-1 ring-base-content/10 ring-inset hover:bg-primary sm:mt-0 sm:w-auto"
			>Cancel</button>
		</div>
	}
}
