package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/go-syndication/types"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strconv"
)

type Subscription struct {
	*models.Subscription
}

// NewSubscriptionView wraps a Subscription object with additional methods for templates involving the subscription.
func NewSubscriptionView(s *models.Subscription) *Subscription {
	return &Subscription{Subscription: s}
}

// ViewOriginAttributes generates a templ.Attributes object containing htmx directives for viewing the subscription's origin URL.
func (s *Subscription) ViewOriginAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed:
		attrs["href"] = s.GetLink()
		attrs["rel"] = "noopener"
		attrs["target"] = "_blank"
		attrs["_"] = "on click halt the event's bubbling"
	}
	return attrs
}

// ViewAttributes generates a templ.Attributes object containing htmx directives for viewing a subscription.
func (s *Subscription) ViewArticlesAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	attrs["hx-target"] = ContentID.Target()
	attrs["hx-swap"] = "innerHTML show:window:top transition:true"
	attrs["hx-push-url"] = "true"
	attrs["hx-trigger"] = "click consume"
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed, models.SubscriptionTypeEmail, models.SubscriptionTypeGroup:
		filters := models.NewListDisplayFilters()
		filters.Subscriptions = []string{s.GetID()}
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		values := filters.Values()
		values[models.ParamSubscriptionID] = s.GetID()
		attrs["hx-vals"] = generateHXVals(values)
		attrs["hx-get"] = "/list/articles"
	case models.SubscriptionTypeSearch:
		attrs["hx-post"] = "/search"
		attrs["hx-include"] = "[name='csrf_token']"
		s.SearchData.Search.SubscriptionID = s.GetID()
		attrs["hx-vals"] = s.SearchData.Search.HXVals()
	}
	return attrs
}

// MarkAttributes generates a templ.Attributes object containing htmx directives for marking a subscription.
func (s *Subscription) MarkAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed, models.SubscriptionTypeEmail, models.SubscriptionTypeGroup:
		attrs["hx-include"] = "[name='csrf_token']"
		attrs["hx-target"] = ID(s.GetID()).Target()
		attrs["hx-trigger"] = "click consume"
		if s.GetStats().IsUnread() {
			attrs["hx-post"] = "/mark/subscription/" + s.GetID() + "/read"
		} else {
			attrs["hx-post"] = "/mark/subscription/" + s.GetID() + "/unread"
		}
	}
	return attrs
}

// EditAttributes generates a templ.Attributes object containing htmx directives for editing a subscription.
func (s *Subscription) EditAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	attrs["hx-get"] = "/edit/subscription/" + s.GetID()
	attrs["hx-target"] = ContentID.Target()
	attrs["hx-swap"] = "innerHTML show:window:top transition:true"
	attrs["hx-push-url"] = "true"
	attrs["hx-trigger"] = "click consume"
	return attrs
}

// UnsubscribeAttributes generates a templ.Attributes object containing htmx directives for unsubscribing from a subscription.
func (s *Subscription) UnsubscribeAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	attrs["hx-post"] = "/remove/subscription/" + s.GetID()
	attrs["hx-target"] = ModalContainerID.Target()
	attrs["hx-include"] = "[name='csrf_token']"
	attrs["_"] = "on htmx:afterOnLoad wait 10ms then call document.getElementById('unsubscribe').show() then halt the event's bubbling"
	return attrs
}

// ReportIssueAttributes generates a templ.Attributes object containing directives for reporting an issue with the subscription.
func (s *Subscription) ReportIssueAttributes() templ.Attributes {
	attrs := make(templ.Attributes)
	attrs["hx-get"] = "/issue/subscription/" + s.GetID()
	attrs["hx-target"] = ContentID.Target()
	attrs["hx-replace-url"] = "true"
	attrs["hx-trigger"] = "click consume"
	return attrs
}

// Card renders a subscription in a card format, suitable for showing together with other subscriptions in a list/grid.
templ (s *Subscription) Card() {
	<article
		id={ s.Subscription.GetID() }
		class={ "card card-link w-full max-w-100 h-full bg-base-200 shadow-md",
			templ.KV("row-span-2",len(s.Subscription.GetCategories(0))== 0),
			templ.KV("row-span-3",len(s.Subscription.GetCategories(0)) >0),
			templ.KV("brightness-50",!s.Subscription.GetStats().IsUnread()) }
		hx-disinherit="*"
		{ s.ViewArticlesAttributes()... }
	>
		// Hidden input used for acting on all displayed subscriptions.
		<input type="hidden" name="displayed_subscriptions" value={ s.GetID() }/>
		<div class="card-body">
			<div class="card-title flex items-center">
				<div class="mr-4 shrink-0 self-center">
					@subscriptionThumbnail(s.Subscription.GetImage(), s.Subscription.GetTitle())
				</div>
				<h2 class="text-pretty line-clamp-3 tracking-tight">{ s.Subscription.GetTitle() }</h2>
			</div>
			<p class="text-xs/4 italic truncate">
				Last update
				if !s.Subscription.GetUpdatedDate().IsZero() {
					@showTimestamp(s.Subscription.GetUpdatedDate())
				} else {
					unknown
				}
			</p>
			// Display up to 5 of the subscription categories.
			if len(s.Subscription.GetCategories(0)) > 0 {
				<div class="flex justify-start my-2">
					<div class="flex flex-row flex-wrap p-2 gap-2">
						for category := range slices.Values(s.Subscription.GetCategories(5)) {
							{{ filters := models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values() }}
							{{ filters[models.ParamCategories] = category }}
							@NewLink(
								WithHXMethod(http.MethodGet, "/list/subscriptions"),
								WithHXTarget(ContentID.Target()),
								WithHXPushURL(true),
								WithHXVals(filters),
								WithClasses("link-hover"),
							) {
								<div class="flex gap-2 capitalize">
									@NewCategoryBadge(category).Render("badge-outline")
								</div>
							}
						}
					</div>
				</div>
			}
			<div class="card-actions mt-auto items-center">
				// Show stats if user requested.
				<div class="inline-flex flex-1 flex-col text-xs/4">
					if s.Subscription.Settings.ShowSubscriptionStats {
						if s.Subscription.GetSubscriptionType() == models.SubscriptionTypeFeed {
							<p>
								{ s.Subscription.GetStats().UpdateFrequency() }
							</p>
						}
						<p>
							{ s.Subscription.GetStats().UnreadTotal() }
							Unread
						</p>
					}
				</div>
				// Favorite action.
				<form>
					<input type="hidden" name={ models.ParamSubscriptionID } value={ s.GetID() }/>
					<label class="swap" _="on click halt the event's bubbling">
						<input
							hx-post={ "/favorite/subscription/" + s.GetID() }
							hx-include="[name='csrf_token']"
							hx-swap="none"
							id={ s.GetID() + "-favorite-state" }
							type="checkbox"
							if s.IsFavorite() {
								checked
							}
							_="on htmx:afterRequest(failed) toggle @checked on me"
						/>
						@tabler.HeartFilled(i.Props{Class: "size-5 swap-on"})
						@tabler.Heart(i.Props{Class: "size-5 swap-off"})
					</label>
				</form>
				// Mark action.
				if s.GetSubscriptionType() != models.SubscriptionTypeSearch {
					<form>
						<input type="hidden" name={ models.ParamSubscriptionID } value={ s.GetID() }/>
						<input
							type="hidden"
							name={ models.ParamMark }
							if s.GetStats().IsUnread() {
								value={ models.MarkRead }
							} else {
								value={ models.MarkUnread }
							}
						/>
						<label class="swap" _="on click halt the event's bubbling">
							<input
								hx-post={ "/mark/subscription/" + s.GetID() }
								hx-include="[name='csrf_token']"
								hx-swap="none"
								id={ s.GetID() + "-read-state" }
								type="checkbox"
								if !s.GetStats().IsUnread() {
									checked
								}
								_="
					on htmx:afterRequest(successful)
					tell the previous <input />
						get your value
						if your value equals 'read'
						set your value to 'unread'
						else
						set your value to 'read'
						end
					on htmx:afterRequest(failed) toggle @checked on me
					"
							/>
							@tabler.MailOpened(i.Props{Class: "size-5 swap-on"})
							@tabler.MailFilled(i.Props{Class: "size-5 swap-off"})
						</label>
					</form>
				}
				// Context menu actions.
				<div class="flex flex-none">
					<el-dropdown class="relative" _="on click halt the event's bubbling">
						<button
							id={ "btn-" + s.GetID() + "-actions" }
							class="btn btn-sm btn-ghost"
						>
							<span class="sr-only">s.GetTitle() + " Actions"</span>
							@tabler.Menu2(i.Props{Class: "size-5"})
						</button>
						<el-menu
							id={ "menu-" + s.GetID() + "-actions" }
							anchor="bottom end"
							popover
							_="on htmx:afterRequest(successful) hidePopover() on me"
						>
							// View action.
							if len(s.ViewOriginAttributes()) > 0 {
								<a class="link link-hover" { s.ViewOriginAttributes()... }>
									@tabler.ExternalLink(i.Props{Class: "size-4"})
									Feed Website
								</a>
							}
							// Edit action.
							<a class="link link-hover" { s.EditAttributes()... }>
								@tabler.Edit(i.Props{Class: "size-4"})
								Edit Subscription
							</a>
							// Unsubscribe action.
							<form>
								<input type="hidden" name="nickname" value={ s.GetTitle() }/>
								<input type="hidden" name="confirmed" value="false"/>
								<a class="link link-hover" { s.UnsubscribeAttributes()... }>
									@tabler.TrashFilled(i.Props{Class: "size-4"})
									Remove Subscription
								</a>
							</form>
							// Report issue action.
							<a class="link link-hover" { s.ReportIssueAttributes()... }>
								@tabler.FlagFilled(i.Props{Class: "size-4"})
								Report an issue
							</a>
						</el-menu>
					</el-dropdown>
				</div>
			</div>
		</div>
	</article>
}

// ListSubscriptions renders the list of subscriptions in a grid layout with filtering controls and an actions menu.
templ ListSubscriptions(response *models.ListSubscriptionsResponse) {
	<div class="ui-container">
		// Watch for updates.
		<div id="update-notifications" sse-connect={ "/list/subscriptions/updates?" + response.Filters.QueryParams().Encode() } sse-swap="message" class="toast toast-center z-50"></div>
		// Show a page header.
		<div class="md:flex md:items-center md:justify-between">
			<div class="min-w-0 flex-1">
				@h2("Subscriptions")
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4 space-x-4">
				@h3(response.Filters.GetView())
				@h3(response.Filters.GetSort().String())
			</div>
		</div>
		@FilterControls("/list/subscriptions", &response.Filters) {
			// Subscriptions actions menu.
			<el-dropdown class="inline-block">
				<button
					id="subscriptions-actions-button"
					class="btn btn-wide"
				>
					Actions
					@tabler.ChevronDown(i.Props{Class: "-mr-1 size-5"})
				</button>
				<el-menu
					id="subscriptions-actions-menu"
					anchor="bottom end"
					popover
					_="on keydown from body if the event's key is 'x' and event.altKey then togglePopover() on me"
					class="w-fit"
				>
					<div class="py-1">
						// Mark all subscriptions action.
						<form class="flex items-center">
							<input type="hidden" name={ models.ParamView } value={ response.Filters.GetView() }/>
							{{ var markText string }}
							{{ var markURL string }}
							{{ var markIcon templ.Component }}
							if response.Filters.GetView() == models.ViewUnread {
								{{ markText = "Mark All Read" }}
								{{ markURL = "/list/subscriptions/mark/" + string(models.MarkRead) }}
								{{ markIcon = tabler.MailOpenedFilled(i.Props{Class: "size-4"}) }}
								<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
							} else {
								{{ markText = "Mark All Unread" }}
								{{ markURL = "/list/subscriptions/mark/" + string(models.MarkUnread) }}
								{{ markIcon = tabler.MailFilled(i.Props{Class: "size-4"}) }}
								<input type="hidden" name={ models.ParamMark } value={ models.MarkUnread }/>
							}
							<a
								hx-post={ markURL }
								hx-target={ ContentID.Target() }
								hx-include="[name='csrf_token'],[name='displayed_subscriptions']"
								class="link link-hover focus:text-primary focus:outline-hidden px-4 py-2"
							>
								@markIcon
								<span class="sr-only">{ markText }</span>
								{ markText }
							</a>
						</form>
						<a
							hx-get="/user/subscription/add/feed"
							hx-target={ ContentID.Target() }
							hx-push-url="true"
							class="flex items-center link link-hover focus:text-primary focus:outline-hidden px-4 py-2"
						>
							@tabler.Plus(i.Props{Class: "size-4"})
							Add Feed Subscription
						</a>
						<a
							hx-get="/user/subscription/add/search"
							hx-target={ ContentID.Target() }
							hx-include="#search-filters"
							hx-push-url="true"
							class="flex items-center link link-hover focus:text-primary focus:outline-hidden px-4 py-2"
						>
							@tabler.Plus(i.Props{Class: "size-4"})
							Add Search Subscription
						</a>
						<a
							hx-get="/user/subscription/add/group"
							hx-target={ ContentID.Target() }
							hx-push-url="true"
							class="flex items-center link link-hover focus:text-primary focus:outline-hidden px-4 py-2"
						>
							@tabler.Plus(i.Props{Class: "size-4"})
							Add Group Subscription
						</a>
					</div>
				</el-menu>
			</el-dropdown>
		}
		<section class="mt-4">
			if len(response.Subscriptions) > 0 {
				<div id="grid-objects" class="ui-grid">
					@PaginateSubscriptions(response)
				</div>
				@btnBackToTop()
			} else {
				@emptyContent()
			}
		</section>
	</div>
}

// PaginateSubscriptions renders the given list of subscriptions as cards with an optional element to trigger pagination
// to load more.
templ PaginateSubscriptions(response *models.ListSubscriptionsResponse) {
	for subscription := range slices.Values(response.Subscriptions) {
		@NewSubscriptionView(subscription).Card()
	}
	if response.Pagination != "" && len(response.Subscriptions) == response.Filters.GetCount() {
		<form
			class="invisible"
			hx-post="/list/subscriptions/paginate"
			hx-include="[name='csrf_token']"
			hx-vals={ generateHXVals(response.Filters.Values()) }
			hx-trigger="intersect once"
			hx-target="#grid-objects"
			hx-swap="beforeend transition:false"
			hx-indicator="#content-loading"
			hx-push-url="false"
			preload
			preload-images="true"
			_="on htmx:afterRequest remove me"
		>
			<input type="hidden" name={ models.ParamPagination } value={ response.Pagination }/>
		</form>
	}
}

templ EditSubscription(request *models.EditSubscriptionRequest) {
	<div class="ui-container">
		<div class="min-w-0 flex-1 pb-8">
			@h2("Editing " + request.Nickname)
		</div>
		if request.HasError() {
			<div role="alert" class="alert alert-error alert-outline mt-12">
				<div class="px-4 py-5 sm:p-6 space-y-4">
					<span class="gap-y-2">
						<p class="font-semibold text-base">Invalid Details</p>
						<p class="text-sm">There is a problem with the details. Please check and try again.</p>
					</span>
				</div>
			</div>
		}
		<div class="space-y-8">
			<form
				id="edit-subscription"
				hx-post={ "/edit/subscription/" + request.GetID() }
				hx-include="#current-categories,[name='csrf_token']"
				hx-swap="none"
				hx-indicator="#processing"
				hx-encoding="multipart/form-data"
			>
				<input type="hidden" name={ models.ParamSubscriptionID } value={ request.SubscriptionID }/>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeFeed) }/>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="nickname" class="text-base/7 font-semibold">Nickname</label>
						<p class="mt-1 text-sm/6 ">A friendly name for this subscription.</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="nickname"
								required
								type="text"
								name="nickname"
								value={ request.GetNickname() }
								placeholder="My Subscription"
								class="input input-primary bg-base-content/10"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="thumbnail" class="text-base/7 font-semibold">Thumbnail</label>
						<p class="mt-1 text-sm/6">Use a JPG, PNG or WEBP image. Max size 1MB.</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2 flex items-center gap-x-2">
							@subscriptionThumbnail(request.ImageURL, request.Nickname)
							<input
								id="thumbnail"
								type="file"
								class="flex file-input file-input-primary bg-base-content/10"
								name={ models.ParamThumbnail }
								accept=".jpg,.png,.webp"
							/>
						</div>
					</div>
				</div>
				// Filtering.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						@h3("Filtering")
						<div class="flex items-center">
							<p class="mt-1 text-sm/6 ">Filter articles by keywords/text in fields.</p>
							@HelpPopover("subscription-filters-help", "top end") {
								<div class="card-body bg-base-300 shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
									<p>By default words are matched with OR (i.e., cats dogs will match cats OR dogs). The following operators can be used for more refined searches:</p>
									<p>+ signifies AND operation (i.e., food AND beverages)</p>
									<p>| signifies OR operation (i.e., food OR beverages)</p>
									<p>- negates a the word (i.e., NOT alcoholic)</p>
									<p>"" represents an exact phrase match (i.e., "rum-based drinks")</p>
									<p>* at thez end of indicates a prefix match (i.e., match bird, birding and birds)</p>
								</div>
							}
						</div>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10 w-full">
								<label for="article_text_filters" class="block text-xs font-medium">Text:</label>
								<input
									id="article_text_filters"
									type="text"
									name="article_filters.text"
									value={ request.ArticleFilters.Text }
									placeholder="Text..."
									class="block w-full"
									spellcheck="false"
								/>
							</div>
						</div>
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10 w-full">
								<label for="article_category_filters" class="block text-xs font-medium">Categories:</label>
								<input
									id="article_category_filters"
									type="text"
									name="article_filters.categories"
									value={ request.ArticleFilters.Categories }
									placeholder="Categories..."
									class="block w-full"
									spellcheck="false"
								/>
							</div>
						</div>
						<div class="sm:col-span-full mt-2">
							<div class="input input-primary bg-base-content/10 w-full">
								<label for="article_author_filters" class="block text-xs font-medium">Authors:</label>
								<input
									id="article_author_filters"
									type="text"
									name="article_filters.authors"
									value={ request.ArticleFilters.Authors }
									placeholder="Authors..."
									class="block w-full"
									spellcheck="false"
								/>
							</div>
						</div>
					</div>
				</div>
				// Full article content toggle.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="show-full-article-content" class="text-base/7 font-semibold">Always Show Full Article Content</label>
						<div class="flex items-center">
							<p class="mt-1 text-sm/6 ">
								Always fetch and show article content from original site.
							</p>
							@HelpPopover("show-full-article-help", "top end") {
								<div class="card-body bg-base-300 shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
									<p>If articles in the subscription are only showing a summary, set this toggle to attempt to fetch the full content from the website.</p>
									<p>Note: fetching full content is based on a heuristic that tries to locate the article content on the page. It does not always produce optimal results.</p>
								</div>
							}
						</div>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="show-full-article-content"
								type="checkbox"
								if request.ShowFullArticleContent {
									checked="checked"
								}
								name="show_full_article_content"
								class="toggle toggle-sm toggle-primary"
							/>
						</div>
					</div>
				</div>
			</form>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "categories", nil, request.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				@btnBack()
				@btnSubmit(templ.Attributes{"form": "edit-subscription"}) {
					Save
				}
			</div>
		</div>
	</div>
}

// AddFeedSubscription is a page for adding a new subscription to a feed.
templ AddFeedSubscription(request *models.AddFeedSubscriptionRequest) {
	<div class="ui-container">
		<div class="min-w-0 flex-1 pb-8">
			@h2("Add A Subscription")
		</div>
		if request.HasError() {
			<div role="alert" class="alert alert-error alert-outline mt-12">
				<div class="px-4 py-5 sm:p-6 space-y-4">
					<span class="gap-y-2">
						<p class="font-semibold text-base">Invalid Details</p>
						<p class="text-sm">There is a problem with the details. Please check and try again.</p>
					</span>
				</div>
			</div>
		}
		<div class="space-y-8">
			<form
				id="add-subscription"
				hx-post="/user/subscription/add/feed"
				hx-swap="none"
				hx-include="[name='user_categories'],[name='csrf_token']"
				hx-indicator="#processing"
				hx-on::after-request="if(event.detail.successful) this.reset()"
			>
				// URL.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						@h3("Feed Website or URL")
						<p class="mt-1 text-sm/6 ">Required. The feed's URL or website (feed detection from a website URL may or may not work).</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="url"
								required
								type="url"
								name="url"
								value={ request.URL }
								placeholder="https://my-favorite-site/feed"
								class="input input-primary bg-base-content/10 w-full"
							/>
							if request.URLErr != nil {
								<p class="text-error py-2 text-xs/4 font-semibold">Error: { request.URLErr.Error() }</p>
							}
						</div>
					</div>
				</div>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						@h3("Feed Nickname")
						<p class="mt-1 text-sm/6 ">Optional. A Friendly name for the subscription. Will use the feed's name if not specified.</p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="sm:col-span-4 mt-2">
							<input
								id="nickname"
								type="text"
								name="nickname"
								value={ request.Nickname }
								placeholder="My cool subscription"
								class={ templ.KV("input input-primary bg-base-content/10",request.NicknameErr == nil), templ.KV("input input-error bg-base-content/10",request.NicknameErr !=nil) }
							/>
							if request.NicknameErr != nil {
								<p class="text-error py-2 text-xs/4 font-semibold">{ request.NicknameErr.Error() }</p>
							}
						</div>
					</div>
				</div>
			</form>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "categories", nil, request.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				@btnBack()
				@btnSubmit(templ.Attributes{"form": "add-subscription"}) {
					Add
				}
			</div>
		</div>
	</div>
}

// AddSearchSubscription is a page for adding a new search subscription.
templ AddSearchSubscription(request *models.SearchSubscriptionRequest) {
	@manageSearchSubscription(request, "add")
}

// EditSearchSubscription is a page for editing a search subscription.
templ EditSearchSubscription(request *models.SearchSubscriptionRequest) {
	@manageSearchSubscription(request, "edit")
}

templ manageSearchSubscription(request *models.SearchSubscriptionRequest, action string) {
	<div class="ui-container">
		<div class="min-w-0 flex-1 pb-8">
			switch action {
				case "add":
					@h2("Add A Search Subscription")
				case "edit":
					@h2("Editing " + request.Customisation.Nickname)
			}
		</div>
		<div class="flex items-center border-b border-base-content/60">
			<h3 class="text-base font-semibold">Search Filters</h3>
			// Help dialog.
			<div class="ml-4">
				@HelpPopover("subscription-filter-operators-help", "bottom end") {
					<div class="card-body bg-base-300 shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
						<p>By default words are matched with OR (i.e., cats dogs will match cats OR dogs). The following operators can be used for more refined searches:</p>
						<p>+ signifies AND operation (i.e., food AND beverages)</p>
						<p>| signifies OR operation (i.e., food OR beverages)</p>
						<p>- negates a the word (i.e., NOT alcoholic)</p>
						<p>"" represents an exact phrase match (i.e., "rum-based drinks")</p>
						<p>* at the end of indicates a prefix match (i.e., match bird, birding and birds)</p>
					</div>
				}
			</div>
		</div>
		<div class="space-y-8">
			// hx-on::after-request="if(event.detail.successful) this.reset()"
			<form
				id="manage-search-subscription"
				if action == "add" {
					hx-post="/user/subscription/add/search"
				} else {
					hx-post={ "/edit/subscription/" + request.Search.SubscriptionID }
				}
				hx-swap="none"
				hx-include="[name='customisation.categories'],[name='csrf_token']"
				hx-params="not subscription-text"
				hx-vals="js:{'search.timezone': Intl.DateTimeFormat().resolvedOptions().timeZone}"
				hx-indicator="#processing"
				hx-encoding="multipart/form-data"
			>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeSearch) }/>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-text" class="text-base/7 font-semibold">Includes the words</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-text"
								type="text"
								name="search.text"
								value={ request.Search.Text }
								placeholder={ `e.g., "Breaking News" | Live` }
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-categories" class="text-base/7 font-semibold">Article Category Filters</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-categories"
								type="text"
								name="search.categories"
								value={ request.Search.Categories }
								placeholder="e.g., drinks + mediation"
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-authors" class="text-base/7 font-semibold">Article Author Filters</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-filter-authors"
								type="text"
								name="search.authors"
								value={ request.Search.Authors }
								placeholder={ `e.g., -"John Smith"` }
								class="input input-primary bg-base-content/10 w-full"
							/>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-subscriptions-search" class="text-base/7 font-semibold">In Subscriptions</label>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<label class="input input-primary bg-base-content/10 w-full">
								@tabler.Search(i.Props{Class: "size-5"})
								<input
									id="subscription-filter-subscriptions-search"
									name="subscription-text"
									placeholder="Search subscriptions..."
									autocomplete="off"
									hx-post="/search/subscription/suggestions"
									hx-trigger="input changed delay:500ms,consume"
									hx-target="#subscription-filter-subscriptions-options"
									hx-swap="innerHTML show:window:top transition:true"
									hx-params="subscription-text,csrf_token"
									hx-include="[name='csrf_token']"
									hx-push-url="false"
								/>
							</label>
							<div
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
								id="subscription-filter-subscriptions-options"
								hx-target="#subscription-filter-subscriptions"
								hx-vals={ templ.JSONString(map[string]any{"subscriptions-input-name": "search.subscriptions"}) }
								_="on htmx:afterRequest set #subscription-filter-subscriptions-search.value to ''"
							></div>
							<div
								id="subscription-filter-subscriptions"
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
							>
								for subscription := range slices.Values(models.SubscriptionsFromCtx(ctx)) {
									@AddSearchSubscriptionFilter(&models.AddSubscriptionSearchFilterRequest{
										InputName:        "search.subscriptions",
										SubscriptionID:   subscription.GetID(),
										SubscriptionName: subscription.GetTitle(),
									})
								}
							</div>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-published-within" class="text-base/7 font-semibold">Published Within</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full">
							<select id="subscription-filter-published-within" name="search.published_within" class="select select-primary my-2 bg-base-300">
								<option
									value="last_hour"
								>Last hour</option>
								<option
									value="last_half_day"
								>Last 12 hours</option>
								<option
									value="last_day"
								>Last day</option>
								<option
									value="last_week"
									selected
								>Last week</option>
								<option
									value="last_month"
								>Last month</option>
							</select>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-view" class="text-base/7 font-semibold">View</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full">
							<select id="subscription-filter-view" name="search.view" class="select select-primary my-2 bg-base-300">
								<option
									value={ string(models.ViewUnread) }
									if request.Search.View == models.ViewUnread {
										selected
									}
								>
									Unread
								</option>
								<option
									value={ string(models.ViewRead) }
									if request.Search.View == models.ViewRead {
										selected
									}
								>Read</option>
								<option
									value={ string(models.ViewAll) }
									if request.Search.View == models.ViewAll {
										selected
									}
								>All</option>
							</select>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-filter-sort" class="text-base/7 font-semibold">Sort By</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full">
							<select id="subscription-filter-sort" name="search.sort" class="select select-primary my-2 bg-base-300">
								<option
									value={ string(models.SortMostRelevant) }
									if request.Search.Sort == models.SortMostRelevant {
										selected
									}
								>
									Most Relevant
								</option>
								<option
									value={ string(models.SortNewestFirst) }
									if request.Search.Sort == models.SortNewestFirst {
										selected
									}
								>Newest First</option>
								<option
									value={ string(models.SortOldestFirst) }
									if request.Search.Sort == models.SortOldestFirst {
										selected
									}
								>Oldest First</option>
							</select>
						</div>
					</div>
				</div>
			</form>
			<div class="border-b border-base-content/60">
				<h3 class="text-base font-semibold">Subscription Info</h3>
			</div>
			// Nickname.
			<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
				<div>
					<label for="subscription-nickname" class="text-base/7 font-semibold">Nickname</label>
					// <p class="mt-1 text-sm/6 "></p>
				</div>
				<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
					<div class="col-span-full mt-2">
						<input
							id="subscription-nickname"
							type="text"
							required
							name="customisation.nickname"
							value={ request.Customisation.Nickname }
							placeholder="My Search Subscription"
							class="input input-primary bg-base-content/10 w-full"
							form="manage-search-subscription"
							autocomplete="off"
						/>
					</div>
				</div>
			</div>
			// Image.
			<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
				<div>
					<label for="image" class="text-base/7 font-semibold">Image</label>
					<p class="mt-1 text-sm/6">Use a JPG, PNG or WEBP image. Max size 1MB.</p>
				</div>
				<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
					<div class="col-span-full mt-2 flex items-center gap-x-2">
						@subscriptionThumbnail(request.Customisation.ImageURL, request.Customisation.Nickname)
						<input
							id="image"
							type="file"
							class="flex file-input file-input-primary bg-base-content/10"
							name="image"
							accept=".jpg,.png,.webp"
						/>
					</div>
				</div>
			</div>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "customisation.categories", nil, request.Customisation.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				@btnBack()
				@btnSubmit(templ.Attributes{"form": "manage-search-subscription"}) {
					if action == "add" {
						Add
					} else {
						Save
					}
				}
			</div>
		</div>
	</div>
}

// AddGroupSubscription is a page for adding a new group subscription.
templ AddGroupSubscription(request *models.GroupSubscriptionRequest) {
	@manageGroupSubscription(request, "add")
}

// EditGroupSubscription is a page for editing a group subscription.
templ EditGroupSubscription(request *models.GroupSubscriptionRequest) {
	@manageGroupSubscription(request, "edit")
}

templ manageGroupSubscription(request *models.GroupSubscriptionRequest, action string) {
	<div class="ui-container">
		<div class="min-w-0 flex-1 pb-8">
			switch action {
				case "add":
					@h2("Add A Group Subscription")
				case "edit":
					@h2("Editing " + request.Customisation.Nickname)
			}
		</div>
		<div class="space-y-8">
			// hx-on::after-request="if(event.detail.successful) this.reset()"
			<form
				id="manage-group-subscription"
				if action == "add" {
					hx-post="/user/subscription/add/group"
				} else {
					hx-post={ "/edit/subscription/" + request.SubscriptionID }
				}
				hx-swap="none"
				hx-include="[name='customisation.categories'],[name='csrf_token']"
				hx-params="not subscription-text"
				hx-indicator="#processing"
				hx-encoding="multipart/form-data"
			>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeGroup) }/>
				// Subscriptions.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscriptions-filter-subscriptions-search" class="text-base/7 font-semibold">In Subscriptions</label>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<label class="input input-primary bg-base-content/10 w-full">
								@tabler.Search(i.Props{Class: "size-5"})
								<input
									id="subscription-filter-subscriptions-search"
									name="subscription-text"
									placeholder="Search subscriptions..."
									autocomplete="off"
									hx-post="/search/subscription/suggestions"
									hx-trigger="input changed delay:500ms,consume"
									hx-target="#subscription-filter-subscriptions-options"
									hx-swap="innerHTML show:window:top transition:true"
									hx-params="subscription-text,csrf_token"
									hx-include="[name='csrf_token']"
									hx-push-url="false"
								/>
							</label>
							<div
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
								id="subscription-filter-subscriptions-options"
								hx-target="#subscription-filter-subscriptions"
								hx-vals={ templ.JSONString(map[string]any{"subscriptions-input-name": "subscriptions"}) }
								_="on htmx:afterRequest set #subscription-filter-subscriptions-search.value to ''"
							></div>
							<div
								id="subscription-filter-subscriptions"
								class="flex flex-wrap items-center mx-auto gap-2 max-w-7xl px-4 py-3 sm:px-6 lg:px-8"
							>
								for subscription := range slices.Values(models.SubscriptionsFromCtx(ctx)) {
									@AddSearchSubscriptionFilter(&models.AddSubscriptionSearchFilterRequest{
										InputName:        "subscriptions",
										SubscriptionID:   subscription.GetID(),
										SubscriptionName: subscription.GetTitle(),
									})
								}
							</div>
						</div>
					</div>
				</div>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-nickname" class="text-base/7 font-semibold">Nickname</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-nickname"
								type="text"
								required
								name="customisation.nickname"
								value={ request.Customisation.Nickname }
								placeholder="My Search Subscription"
								class="input input-primary bg-base-content/10 w-full"
								autocomplete="off"
							/>
						</div>
					</div>
				</div>
			</form>
			// Image.
			<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
				<div>
					<label for="image" class="text-base/7 font-semibold">Image</label>
					<p class="mt-1 text-sm/6">Use a JPG, PNG or WEBP image. Max size 1MB.</p>
				</div>
				<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
					<div class="col-span-full mt-2 flex items-center gap-x-2">
						@subscriptionThumbnail(request.Customisation.ImageURL, request.Customisation.Nickname)
						<input
							id="image"
							type="file"
							class="flex file-input file-input-primary bg-base-content/10"
							name="image"
							accept=".jpg,.png,.webp"
						/>
					</div>
				</div>
			</div>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "customisation.categories", nil, request.Customisation.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				@btnBack()
				@btnSubmit(templ.Attributes{"form": "manage-group-subscription"}) {
					if action == "add" {
						Add
					} else {
						Save
					}
				}
			</div>
		</div>
	</div>
}

templ EditEmailSubscription(request *models.EditEmailSubscriptionRequest) {
	<div class="ui-container">
		<div class="min-w-0 flex-1 pb-8">
			@h2("Editing " + request.Customisation.Nickname)
		</div>
		<div class="space-y-8">
			<form
				id="manage-email-subscription"
				hx-post={ "/edit/subscription/" + request.SubscriptionID }
				hx-swap="none"
				hx-include="[name='customisation.categories'],[name='csrf_token']"
				hx-params="not subscription-text"
				hx-indicator="#processing"
				hx-encoding="multipart/form-data"
			>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeEmail) }/>
				<input type="hidden" name="subscription_id" value={ request.SubscriptionID }/>
				// Nickname.
				<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
					<div>
						<label for="subscription-nickname" class="text-base/7 font-semibold">Nickname</label>
						// <p class="mt-1 text-sm/6 "></p>
					</div>
					<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
						<div class="col-span-full mt-2">
							<input
								id="subscription-nickname"
								type="text"
								required
								name="customisation.nickname"
								value={ request.Customisation.Nickname }
								placeholder="My Email Subscription"
								class="input input-primary bg-base-content/10 w-full"
								autocomplete="off"
							/>
						</div>
					</div>
				</div>
			</form>
			// Image.
			<div class="grid grid-cols-1 gap-x-8 py-6 md:grid-cols-3 items-center">
				<div>
					<label for="image" class="text-base/7 font-semibold">Image</label>
					<p class="mt-1 text-sm/6">Use a JPG, PNG or WEBP image. Max size 1MB.</p>
				</div>
				<div class="grid max-w-2xl grid-cols-1 sm:grid-cols-6 md:col-span-2">
					<div class="col-span-full mt-2 flex items-center gap-x-2">
						@subscriptionThumbnail(request.Customisation.ImageURL, request.Customisation.Nickname)
						<input
							id="image"
							type="file"
							class="flex file-input file-input-primary bg-base-content/10"
							name="image"
							accept=".jpg,.png,.webp"
						/>
					</div>
				</div>
			</div>
			// Categories
			{{ categoryMgmtPath := "/user/subscription/category" }}
			@CategoryManagement(categoryMgmtPath, "customisation.categories", nil, request.Customisation.Categories)
			// Action buttons.
			<div class="flex flex-1 items-center justify-end gap-x-6">
				<div id="processing" class="htmx-indicator">
					Processing...
					<span class="loading loading-spinner loading-md"></span>
				</div>
				@btnBack()
				@btnSubmit(templ.Attributes{"form": "manage-email-subscription"}) {
					Save
				}
			</div>
		</div>
	</div>
}

// ImportPage is a page for importing subscriptions from an external source (e.g., an OPML file).
templ ImportSubscriptions() {
	<div class="ui-container">
		<div class="mx-auto max-w-3xl">
			<div class="min-w-0 flex-1 pb-8">
				@h2("Import Subscriptions")
			</div>
			<div class="md:flex md:items-center md:justify-between">
				<p class="mt-2 max-w-4xl text-sm text-base-content/80">
					You can import your existing subscriptions from an OPML file. Most feed services support generating an OPML file you can use.
				</p>
			</div>
			<form
				id="import-subscriptions-form"
				hx-encoding="multipart/form-data"
				hx-post="/user/import"
				hx-target="#import-results"
				hx-include="[name='csrf_token']"
				hx-indicator="#processing"
			>
				<div class="grid max-w-7xl grid-cols-1 items-center gap-x-8 gap-y-10 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
					<div>
						<h3 class="text-base/7 font-semibold">OPML File</h3>
					</div>
					<div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:place-items-center sm:grid-cols-6 md:col-span-2">
						<div class="sm:col-span-full w-full">
							<input id="source" type="file" required name="source" class="file-input file-input-primary bg-base-content/10 w-full"/>
						</div>
					</div>
					<div class="grid col-span-full justify-end">
						<div class="flex gap-x-2 items-center">
							<div id="processing" class="htmx-indicator">
								Processing...
								<span class="loading loading-spinner loading-md"></span>
							</div>
							@btnBack()
							@btnSubmit(nil) {
								Import
							}
						</div>
					</div>
				</div>
			</form>
			<div id="import-results" class="space-y-4"></div>
		</div>
	</div>
}

// ImportResults is a partial template that displays the results of an import.
templ ImportResults(results []*models.AddFeedSubscriptionResult) {
	{{ successfulResults := filterSuccessfulResults(results) }}
	{{ failedResults := filterUnsuccessfulResults(results) }}
	{{ warningResults := filterWarningResults(results) }}
	<div class="min-w-0 flex-1">
		@h2("Import Results")
	</div>
	// Import results summary.
	<ul class="py-4 space-y-8">
		if len(successfulResults) > 0 {
			<li class="flex items-center">
				@tabler.CircleCheck(i.Props{Class: "size-10 text-success"})
				<p class="text-success font-semibold">{ strconv.Itoa(len(successfulResults)) } Created</p>
			</li>
		}
		if len(failedResults) > 0 {
			<li class="flex items-center">
				@tabler.ExclamationCircle(i.Props{Class: "size-10 text-error"})
				<p class="text-error font-semibold">{ strconv.Itoa(len(failedResults)) } Failed</p>
			</li>
		}
		if len(warningResults) > 0 {
			<li class="flex items-center">
				@tabler.AlertTriangle(i.Props{Class: "size-10 text-warning"})
				<p class="text-warning font-semibold">{ strconv.Itoa(len(warningResults)) } Warnings</p>
			</li>
		}
	</ul>
	<div class="py-4">
		@NewButton(
			WithHXMethod(http.MethodGet, "/list/subscriptions"),
			WithHXTarget(ContentID.Target()),
			WithHXVals(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()),
			WithClasses("btn-primary"),
		) {
			Go to your subscriptions
		}
	</div>
	<div class="py-4 space-y-8">
		<ul class="list">
			for response := range slices.Values(slices.Concat(successfulResults,failedResults,warningResults)) {
				<li class="list-row items-center">
					switch response.Message.Status {
						case models.UserMessageStatusSuccess:
							@tabler.CircleCheck(i.Props{Class: "size-10 text-success"})
							<div>
								<div>{ response.Message.Summary }</div>
							</div>
						case models.UserMessageStatusError:
							@tabler.ExclamationCircle(i.Props{Class: "size-10 text-error"})
							<div>
								<div>{ response.Message.Summary }</div>
								if response.Message.HasDetails() {
									<p class="list-col-wrap text-xs">
										{ response.Message.Details }
									</p>
								}
							</div>
						case models.UserMessageStatusWarning:
							@tabler.AlertTriangle(i.Props{Class: "size-10 text-warning"})
							<div>
								<div>{ response.Message.Summary }</div>
								if response.Message.HasDetails() {
									<p class="list-col-wrap text-xs">
										{ response.Message.Details }
									</p>
								}
							</div>
					}
				</li>
			}
		</ul>
	</div>
	@btnBackToTop()
}

func filterSuccessfulResults(results []*models.AddFeedSubscriptionResult) []*models.AddFeedSubscriptionResult {
	return slices.Collect(models.FilterSlice(results, func(result *models.AddFeedSubscriptionResult) bool {
		return result.Message != nil && result.Message.Status == models.UserMessageStatusSuccess
	}))
}

func filterWarningResults(results []*models.AddFeedSubscriptionResult) []*models.AddFeedSubscriptionResult {
	return slices.Collect(models.FilterSlice(results, func(result *models.AddFeedSubscriptionResult) bool {
		return result.Message != nil && result.Message.Status == models.UserMessageStatusWarning
	}))
}

func filterUnsuccessfulResults(results []*models.AddFeedSubscriptionResult) []*models.AddFeedSubscriptionResult {
	return slices.Collect(models.FilterSlice(results, func(result *models.AddFeedSubscriptionResult) bool {
		return result.Message != nil && result.Message.Status == models.UserMessageStatusError
	}))
}

// ExportSubscriptions renders a form for exporting all subscriptions as an OPML file.
templ ExportSubscriptions() {
	<div class="ui-container">
		<div class="md:flex md:items-center md:justify-between mt-8">
			<div class="min-w-0 flex-1">
				@h2("Export Subscriptions")
			</div>
		</div>
		<p class="mt-2 max-w-4xl text-sm text-base-content/80">
			You can export your current subscription to an OPML file, which all good feed readers can import.
		</p>
		<div class="mt-10 space-y-8">
			<div class="mt-6 flex items-center justify-end gap-x-6">
				@btnBack()
				<form method="post">
					<input id="csrf_token" type="hidden" name="csrf_token" value={ models.CSRFTokenFromCtx(ctx) }/>
					<button type="submit" class="btn btn-primary">Export</button>
				</form>
			</div>
		</div>
		<center id="processing" class="htmx-indicator">
			Processing, this could take a few minutes...
			<span class="loading loading-spinner loading-md"></span>
		</center>
	</div>
}

// RemoveObjectModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ RemoveSubscriptionModal(request *models.RemoveSubscriptionRequest) {
	{{ id := "unsubscribe" }}
	@Modal(id) {
		<div class="sm:flex sm:items-start">
			<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tabler.AlertTriangle(i.Props{Class: "size-12"})
			</div>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { request.Nickname }?</p>
				</div>
			</div>
		</div>
		<div class="flex flex-row-reverse mt-5 sm:mt-4 gap-x-2 justify-center items-center">
			<form
				hx-post={ "/remove/subscription/" + string(request.SubscriptionID) }
				hx-target={ "#" + request.SubscriptionID }
				hx-include="[name='csrf_token']"
				hx-swap="delete transition:true"
				_="on htmx:afterRequest(successful) if successful remove #unsubscribe-modal"
				class="flex"
			>
				<input type="hidden" name="nickname" value={ request.Nickname }/>
				<input type="hidden" name="confirmed" value="true"/>
				<button
					type="submit"
					class="btn btn-primary"
				>Unsubscribe</button>
			</form>
			<button
				type="button"
				command="close"
				commandfor={ id }
				_={ "on click remove #" + id + "-modal" }
				class="btn btn-secondary hover:btn-error"
			>Cancel</button>
		</div>
	}
}

templ subscriptionThumbnail(url, title string) {
	if url != "" {
		// If the source has an image, use that as the avatar.
		<div class="avatar">
			<div class="rounded-box size-12 border border-base-content">
				// rs:auto:48:48 - resize to 48x48 https://docs.imgproxy.net/usage/processing#resize
				// sh:0.5 - sharpen https://docs.imgproxy.net/usage/processing#sharpen
				// q:80 - quality https://docs.imgproxy.net/usage/processing#quality
				// sm:1 - strip metadata
				// kcr:1 - keep copyright
				// scp:1 - convert color profile to sRGB
				@NewProxiedImage(&types.ImageInfo{Title: title, URL: url}, "rs:auto:48:48/q:80/sm:1/kcr:1/scp:1",
					WithAttribute("width", "48"),
					WithAttribute("height", "48"),
				)
			</div>
		</div>
	} else {
		// Otherwise, take the first letter of the title and create a placeholder avatar.
		<div class="avatar avatar-placeholder">
			<div class="bg-neutral text-neutral-content w-12 mask mask-squircle">
				if title != "" {
					<span class="text-3xl capitalize">{ title[0:1] }</span>
				} else {
					<span class="text-3xl capitalize">S</span>
				}
			</div>
		</div>
	}
}
