package templates

import (
	"fmt"
	"github.com/dimmerz92/go-icons/tabler-filled"
	tableroutline "github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/components"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"github.com/immanent-tech/go-base/pkg/htmx"
	"net/http"
	"slices"
	"strings"
)

// SubscriptionFavoriteToggle renders an icon-only button to toggle the subscription favorite status.
templ SubscriptionFavoriteToggle(subscription *models.Subscription, options ...element.PropertiesOption) {
	{{
		props := element.NewProperties(options...)
		var label string
		if subscription.IsFavorite() {
			label = "Remove favorite"
		} else {
			label = "Add favorite"
		}
	}}
	<div
		id={ subscription.GetID() + "-toggle-favorite" }
		data-tip={ label }
		class="tooltip tooltip-top tooltip-end"
		{ props.Attributes()... }
	>
		<button
			aria-label={ label }
			class="btn btn-square btn-ghost btn-md"
			hx-post={ "/subscriptions/" + subscription.GetID() + "/favorite" }
			hx-swap="none"
			hx-trigger="click consume"
		>
			switch subscription.IsFavorite() {
				case true:
					@tablerfilled.Heart(templ.Attributes{"class": "size-5 fill-primary"})
				case false:
					@tableroutline.Heart(templ.Attributes{"class": "size-5 stroke-primary"})
			}
		</button>
	</div>
}

// SubscriptionMarkToggle renders an icon-only button to toggle the subscription mark status.
templ SubscriptionMarkToggle(subscription *models.Subscription, options ...element.PropertiesOption) {
	{{
		if subscription.GetSubscriptionType() == models.SubscriptionTypeSearch {
			return
		}
		var mark models.Mark
		if subscription.GetStats().IsUnread() {
			mark = models.MarkRead
		} else {
			mark = models.MarkUnread
		}
		props := element.NewProperties(options...)
	}}
	<div
		id={ subscription.GetID() + "-toggle-mark" }
		class="tooltip tooltip-top tooltip-end"
		data-tip={ "Mark " + string(mark) }
		{ props.Attributes()... }
	>
		<button
			aria-label={ "Toggle mark status for " + subscription.GetTitle() }
			class="btn btn-square btn-ghost btn-md"
			hx-post={ "/subscriptions/" + subscription.GetID() + "/" + string(mark) }
			hx-swap="none"
			hx-trigger="click consume"
		>
			switch mark {
				case models.MarkRead:
					@tableroutline.MailOpened(templ.Attributes{"class": "size-5 stroke-primary"})
				case models.MarkUnread:
					@tableroutline.Mail(templ.Attributes{"class": "size-5 stroke-primary"})
			}
		</button>
	</div>
}

// ListSubscriptions renders the list of subscriptions in a grid layout with filtering controls and an actions menu.
templ ListSubscriptions(response *models.ListSubscriptionsResponse) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@partials.BackToTopButton()
			@components.PullToRefreshSentinel()
			@container(element.WithClasses("pt-4 ptr-scroll"), element.WithAttribute("_", "install PullToRefresh(threshold: 70)")) {
				// Show a page header.
				@pageHeading() {
					@pageTitle("Subscriptions")
				}
				// List actions.
				@NewListControls("/subscriptions", response.Filters,
					WithListCategories(response.Subscriptions.GetCategories()),
					WithListButtons(listSubscriptionsButtons(response)),
					WithListActions(listSubscriptionsActions(response)),
					WithListLanguages(response.Subscriptions.GetLanguageCounts()),
				)
				<section id="subscriptions-list" class="ptr-content pt-4">
					@partials.LoadingIndicator("refreshing", "Refreshing...", element.WithClasses("py-4"))
					if len(response.Subscriptions) > 0 {
						@listSubscriptionsGrid(response)
					} else {
						@partials.NoContent()
					}
				</section>
			}
			// Watch for updates.
			@partials.UpdatesPoller(string(routeSubscriptionsUpdates), &response.Filters)
		}
	}
}

templ listSubscriptionsGrid(response *models.ListSubscriptionsResponse) {
	<div _={ components.ScrollRestoreScript(string(routeSubscriptions), "subscriptionsList") }>
		@partials.Grid(element.WithClasses("masonry-grid", "relative"),
			element.WithAttribute("_", "install MasonryGrid"),
			element.WithHXMethod(http.MethodGet, string(routeSubscriptions)),
			element.WithHXTarget(ContentID.Target()),
			element.WithHXTrigger("refresh"),
			element.WithHXIndicator("#refreshing"),
		) {
			@templ.Fragment(PaginateFragment) {
				for idx, sub := range response.Subscriptions {
					@SubscriptionCard(idx, sub) {
						@SubscriptionLatestArticles(sub.Articles)
					}
				}
			}
		}
		@ListPaginationControl(routeSubscriptionsPaginate, &response.Filters)
		@partials.LoadingIndicator("loading-items", "Loading content...", element.WithClasses("mt-4"))
		<ul class="menu menu-vertical mt-8 w-full items-center justify-center gap-2 sm:menu-horizontal">
			<li>
				@ListMarkAllSubscriptionsButton(NewMarkAction("/subscriptions", "Mark all", response.Filters.GetView()))
			</li>
		</ul>
	</div>
}

// subscriptionLatestArticles renders a list of latest article summaries for a subscription.
templ SubscriptionLatestArticles(articles []*models.Article) {
	if len(articles) > 0 {
		<div class="mt-auto h-full">
			<ul class="latest-items menu menu-vertical">
				for _, item := range articles {
					@latestArticleSummary(item)
				}
			</ul>
		</div>
	} else {
		<p class="m-0 text-base-content italic">No entries.</p>
	}
}

// latestArticleSummary renders details about a latest article for a subscription.
templ latestArticleSummary(item *models.Article) {
	<li class="my-1 border-l-2 border-accent/40 pl-3 text-base">
		<div class="tooltip tooltip-bottom" data-tip={ item.GetTitle() }>
			<a
				hx-get={ articleURL(item.GetID()) }
				hx-target={ ContentID.Target() }
				hx-swap="innerMorph show:top transition:true"
				hx-trigger="click"
				hx-push-url="true"
				_="on click halt the event's bubbling"
			>
				<span class="line-clamp-2 font-serif text-base/7 font-semibold">
					{ item.GetTitle() }
				</span>
				<relative-time
					datetime={ item.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
					format="relative"
					class="shrink-0 text-sm/6 text-base-content capitalize tabular-nums"
				>
					{ item.GetUpdatedDate().Format("Jan _2, 2006") }
				</relative-time>
			</a>
		</div>
	</li>
}

templ ListMarkAllSubscriptionsButton(a MarkAction) {
	<button class="group btn border-neutral/15 btn-outline" hx-post={ a.Path } hx-target={ ModalContainerID.Target() } hx-include="article > input">
		<span class="hidden items-center group-[.htmx-request]:inline-flex">
			<span class="loading mr-3 loading-spinner"></span>
			<span class="text-sm/6">Loading</span>
		</span>
		<span class="inline-flex items-center group-[.htmx-request]:hidden">
			if a.Read {
				@tableroutline.MailOpened(templ.Attributes{"class": "mr-3 size-5 stroke-base-content/80", "aria-hidden": "true"})
			} else {
				@tableroutline.Mail(templ.Attributes{"class": "mr-3 size-5 stroke-base-content/80", "aria-hidden": "true"})
			}
			<span class="text-sm/6">{ a.Label }</span>
		</span>
	</button>
}

templ ListMarkSubscriptionButton(a MarkAction) {
	<button class="group btn border-neutral/15 btn-outline" hx-post={ a.Path } hx-target={ ModalContainerID.Target() }>
		<span class="hidden items-center group-[.htmx-request]:inline-flex">
			<span class="loading mr-3 loading-spinner"></span>
			Loading
		</span>
		<span class="inline-flex items-center gap-1 group-[.htmx-request]:hidden">
			if a.Read {
				@tableroutline.MailOpened(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
				<span class="text-sm/6">{ a.Label }</span>
			} else {
				@tableroutline.Mail(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
				<span class="text-sm/6">{ a.Label }</span>
			}
		</span>
	</button>
}

templ listSubscriptionsButtons(response *models.ListSubscriptionsResponse) {
	{{
		var mark models.Mark
		if response.Filters.GetView() == models.ViewUnread {
			mark = models.MarkRead
		} else {
			mark = models.MarkUnread
		}
	}}
	<button
		hx-post={ "/subscriptions/" + string(mark) }
		hx-target={ ModalContainerID.Target() }
		hx-include=".card > input"
		class="btn border-neutral/15 btn-outline btn-sm"
	>
		if response.Filters.GetView() == models.ViewUnread {
			@tableroutline.MailOpened(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
			Mark shown as Read
		} else {
			@tableroutline.Mail(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
			Mark shown as Unread
		}
	</button>
	<button
		hx-get="/subscription/add"
		hx-target={ ContentID.Target() }
		hx-swap="innerMorph show:top transition:true"
		class="btn hidden border-neutral/15 btn-outline btn-sm sm:flex"
	>
		@tableroutline.Plus(templ.Attributes{"class": "size-5  stroke-base-content/80", "aria-hidden": "true"})
		Add a subscription
	</button>
}

templ listSubscriptionsActions(response *models.ListSubscriptionsResponse) {
	<li class="menu-title">Actions</li>
	<ul>
		<li>
			<a
				hx-get="/subscription/add"
				hx-target={ ContentID.Target() }
				class="flex items-center gap-1"
			>
				@tableroutline.Plus(templ.Attributes{"class": " size-5 stroke-base-content/80", "aria-hidden": "true"})
				Add a subscription
			</a>
		</li>
		<li>
			<a
				hx-get="/discover"
				hx-target={ ContentID.Target() }
				class="flex items-center gap-1"
			>
				@tableroutline.WorldSearch(templ.Attributes{"class": " size-5 stroke-base-content/80", "aria-hidden": "true"})
				Discover feeds
			</a>
		</li>
	</ul>
}

templ subscriptionArticleFiltersFields(filters *models.ArticleFilters) {
	<fieldset class="fieldset min-w-0 py-8">
		<legend id="article-filtering" class="flex items-center gap-2 text-lg font-medium">
			Article Filtering
			<button popovertarget="article-filtering-help" type="button">
				@tableroutline.InfoCircle(templ.Attributes{"class": "size-6 text-info", "aria-hidden": "true"})
			</button>
			<el-popover popover id="article-filtering-help" anchor="bottom" class="[--anchor-gap:4px]">
				<div class="card-body block rounded-box bg-base-300 font-light shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
					<p>
						The following operators can be used for more refined searches:
					</p>
					<ul class="mt-1">
						<li>| signifies OR operation (i.e., food OR beverages). This is the default.</li>
						<li>+ signifies AND operation (i.e., food AND beverages).</li>
						<li>- negates the word (i.e., NOT samsung)</li>
						<li>"" represents an exact phrase match (i.e., "galaxy watch").</li>
						<li>\* at the end of a word indicates a prefix match (i.e., bird\* will match bird, birding and birds).</li>
					</ul>
				</div>
			</el-popover>
		</legend>
		<label class="fieldset">
			<span class="label">Text</span>
			<textarea
				rows="2"
				id="article-text-filters"
				name="article_filters.text"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Text != nil {
					{ *filters.Text }
				}
			</textarea>
		</label>
		<label class="fieldset">
			<span class="label">Categories</span>
			<textarea
				rows="2"
				id="article-category-filters"
				name="article_filters.categories"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Categories != nil {
					{ *filters.Categories }
				}
			</textarea>
		</label>
		<label class="fieldset">
			<span class="label">Authors</span>
			<textarea
				rows="2"
				id="article-author-filters"
				name="article_filters.authors"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Authors != nil {
					{ *filters.Authors }
				}
			</textarea>
		</label>
	</fieldset>
}

// AddFeedSubscription is a page for adding a new subscription to a feed.
templ AddFeedSubscription(request *models.FeedSubscriptionRequest) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				@pageHeading() {
					@pageTitle("Add a subscription")
				}
				<div id="add-subscription" class="space-y-8 divide-y divide-base-content/15">
					<fieldset class="fieldset min-w-0 py-8">
						<ol>
							<li>Choose from <span class="font-semibold">sources</span> drop-down on right to search Youtube, Google News, etc.</li>
							<li>Enter search terms (see notes below) as appropriate.</li>
						</ol>
						<div class="join mt-2 w-full join-vertical items-center sm:join-horizontal">
							<label class="input join-item w-full p-2 input-primary sm:w-2/3 sm:p-0">
								<span class="label">
									@tableroutline.Search(templ.Attributes{"class": "sm:ml-1 stroke-primary"})
								</span>
								<input
									id="add-subscription-search"
									type="search"
									name="suggestion_text"
									if request.URL != "" {
										value={ request.URL }
									}
									autocomplete="off"
									placeholder="Text, phrase or URL..."
									hx-post="/subscription/add/suggestions"
									hx-target="#subscription-suggestions"
									hx-trigger="keyup changed delay:500ms, search[this.value != ''], load[this.value != '']"
									hx-sync="this:replace"
									hx-indicator="#suggestions-loading"
									hx-include="[name='suggestion_source']"
									_="
									on htmx:before:request set #subscription-suggestions.innerHTML to ''
									on keydown[key=='Enter'] halt the event
									"
								/>
							</label>
							<label class="select join-item w-full select-primary sm:w-1/3">
								<span class="label">Source:</span>
								<select
									id="suggestion-source"
									name="suggestion_source"
									class="shrink"
									_="
									on change if my.value is 'web' set #add-subscription-search.placeholder to 'Text, phrase or URL...' end
									on change if my.value is 'youtube' set #add-subscription-search.placeholder to 'Channel name, text or phrase...' end
									on change if my.value is 'gnews' set #add-subscription-search.placeholder to 'Search keywords...' end
									"
								>
									<option value="web" selected>Web</option>
									<option value="youtube">Youtube</option>
									<option value="gnews">Google News</option>
								</select>
							</label>
						</div>
						<ul class="mt-4 block list-inside list-disc text-neutral">
							<div _="on change from #suggestion-source if its value is 'web' remove @hidden from me else add @hidden to me">
								<li>
									Enter text or a phrase to search feed titles, descriptions and categories in the Foragd database.
								</li>
								<li>
									Enter a URL to fetch and parse the website for a suitable feed.
								</li>
							</div>
							<div _="on change from #suggestion-source if its value is 'youtube' remove @hidden from me else add @hidden to me" hidden>
								<li>
									Enter <span class="italic">{ `@ChannelName` }</span> to fetch a specific channel's feed.
								</li>
								<li>
									Enter keywords or a phrase to search YouTube for channels or playlists that match.
								</li>
							</div>
							<div _="on change from #suggestion-source if its value is 'gnews' remove @hidden from me else add @hidden to me" hidden>
								<li>
									Enter search terms to fetch and generate a feed with matching articles.
								</li>
								<li>
									For example: <span class="italic">when:24h site:reuters.com "World Events"</span>.
								</li>
							</div>
						</ul>
						// Loading skeleton.
						<div id="suggestions-loading" class="group">
							<div id="discover-loading" class="group">
								<div class="mt-8 hidden w-full group-[.htmx-request]:inline-flex sm:max-w-5xl">
									@partials.Grid() {
										@partials.CardSkeleton()
										@partials.CardSkeleton()
										@partials.CardSkeleton()
									}
								</div>
							</div>
						</div>
						// Suggestions.
						<div id="subscription-suggestions" class="mt-8 overflow-x-auto"></div>
					</fieldset>
					// Other Actions.
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						<div
							class="card-body cursor-pointer touch-manipulation rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/subscription/add/group"
							hx-target={ ContentID.Target() }
							hx-push-url="true"
						>
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Plus(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Add a Group Subscription</div>
							</div>
							<p>Combine muliple feed subscriptions into one. Filter across all articles.</p>
						</div>
						<div
							class="card-body cursor-pointer touch-manipulation rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/subscription/add/search"
							hx-target={ ContentID.Target() }
							hx-include="#search-filters"
							hx-push-url="true"
						>
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Plus(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Add a Search Subscription</div>
							</div>
							<p>Search for articles and combine results into a single feed.</p>
						</div>
						<div class="card-body col-span-full justify-self-center rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md">
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Mailbox(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Subscribe to email newsletters</div>
							</div>
							{{ user := models.UserFromCtx(ctx) }}
							<div id="subscription-email" class="group">
								if user.Settings.SubscriptionEmail == nil {
									<p>Generate an email for subscribing to email newsletters.</p>
									<button
										hx-post="/user/settings/subscriptionemail"
										hx-target="#subscription-email"
										hx-swap="innerMorph transition:true"
										class="btn btn-primary"
									>
										<span class="hidden items-center group-[.htmx-request]:inline-flex">
											<span class="loading mr-3 loading-spinner"></span>
											<span class="text-sm/6">Processing</span>
										</span>
										<span class="inline-flex items-center group-[.htmx-request]:hidden">
											<span>Generate email address</span>
										</span>
									</button>
								} else {
									@ShowSubscriptionEmail(*user.Settings.SubscriptionEmail)
								}
							</div>
						</div>
					</div>
				</div>
			}
		}
	}
}

// EditFeedSubscription is a page for editing an existing feed subscription.
templ EditFeedSubscription(request *models.FeedSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@manageFeedSubscription("edit", request, breadcrumbs)
			}
		}
	}
}

// manageFeedSubscription generates the appropriate form layout for either adding or editing a feed subscription.
templ manageFeedSubscription(action string, request *models.FeedSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@pageHeading() {
		{{ var title string }}
		switch action {
			case "add":
				{{ title = "Add a Subscription" }}
			case "edit":
				{{ title = "Editing " + request.Customisation.GetNickname() }}
		}
		@pageTitle(title)
	}
	<div class="mt-12 space-y-8 divide-y divide-base-content/15">
		<form
			id="add-subscription"
			if action == "add" {
				hx-post="/subscription/add"
			} else {
				hx-post={ "/subscriptions/" + request.SubscriptionID + "/edit" }
			}
			hx-swap="none"
			hx-encoding="multipart/form-data"
			hx-disable="find button[type='submit']"
			class="group"
		>
			// Add hidden inputs when editing a subscription to know which subscription we are editing.
			if action == "edit" {
				<input type="hidden" name="subscription_id" value={ request.SubscriptionID }/>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeFeed) }/>
			}
			// Customisation.
			<fieldset class="fieldset min-w-0 py-8">
				<legend class="text-lg font-medium">Customisation</legend>
				<label class="fieldset">
					<span class="label">Nickname</span>
					<input
						id="nickname"
						type="text"
						name="customisation.nickname"
						if request.Customisation != nil && request.Customisation.GetNickname() != "" {
							value={ request.Customisation.GetNickname() }
						}
						placeholder="My cool subscription…"
						class="input w-full bg-base-content/10 input-primary"
					/>
					<p>Add a nickname for the subscription.</p>
				</label>
				<label class="fieldset">
					<span class="label">Thumbnail</span>
					<div class="flex items-center gap-4">
						if request.Customisation != nil && request.Customisation.ImageURL != nil {
							@thumbnail(*request.Customisation.ImageURL, *request.Customisation.Nickname)
						} else {
							@thumbnail("", *request.Customisation.Nickname)
						}
						<input
							id="thumbnail"
							type="file"
							class="file-input flex bg-base-content/10 file-input-primary"
							name="customisation.thumbnail"
							accept=".jpg,.png,.webp"
						/>
					</div>
					<p>Customize the subscription thumbnail</p>
				</label>
			</fieldset>
			// Categories.
			if request.Customisation != nil {
				@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
			} else {
				@CategoryManagement(request.SuggestedCategories, nil)
			}
			// Article Filters.
			@subscriptionArticleFiltersFields(request.ArticleFilters)
			// Additional Options for Existing Subscriptions.
			if action == "edit" {
				<fieldset class="fieldset min-w-0 py-8">
					<legend class="text-lg font-medium">Additional Settings</legend>
					<label class="fieldset">
						<div class="flex items-center gap-4">
							<span class="label">Always Show Full Article Content</span>
							<input
								id="show-full-article-content"
								type="checkbox"
								if request.Settings != nil && request.Settings.ShowFullArticleContent {
									checked="checked"
								}
								name="show_full_article_content"
								class="toggle toggle-primary toggle-sm"
							/>
						</div>
						<p>
							If articles in the subscription are only showing a summary, set this
							toggle to attempt to fetch the full content from the website.
						</p>
						<p>
							Note: fetching full content is based on a heuristic that tries to locate
							the article content on the page. It does not always produce optimal
							results.
						</p>
					</label>
				</fieldset>
			}
			<div class="mt-4 flex w-full justify-end gap-4">
				<button
					type="button"
					class="btn btn-secondary hover:btn-error"
					if prev, found := breadcrumbs.Previous(ctx); !found {
						hx-get="/home"
					} else {
						hx-get={ prev.Path + prev.Fragment }
					}
					hx-target={ ContentID.Target() }
					hx-swap="innerMorph transition:true"
					hx-push-url="true"
				>
					Back
				</button>
				<button type="submit" class="group btn btn-primary">
					<span class="hidden items-center group-[.htmx-request]:inline-flex">
						<span class="loading mr-3 loading-spinner"></span>
						<span class="text-sm/6">Processing</span>
					</span>
					<span class="inline-flex items-center group-[.htmx-request]:hidden">
						switch action {
							case "add":
								<span class="text-sm/6">Add</span>
							case "edit":
								<span class="text-sm/6">Save</span>
						}
					</span>
				</button>
			</div>
		</form>
	</div>
}

templ ShowFeedSuggestions(request *models.SuggestFeedsResults) {
	if len(request.Feeds) == 0 {
		@ShowNoSuggestions(request.Text)
	} else {
		@partials.Grid() {
			for feed := range slices.Values(request.Feeds) {
				@feedSuggestion(feed, request.LatestItems[feed.GetID()])
			}
		}
	}
}

templ ShowNoSuggestions(text string) {
	<div class="flex">
		<div class="mr-4 shrink-0 self-center">
			@tablerfilled.ZoomQuestion(templ.Attributes{"class": "size-16 fill-primary"})
		</div>
		<div>
			<h2 class="text-lg font-semibold">No results.</h2>
			<p class="mt-1 text-neutral">
				We could not find any good matches for <strong>{ text }</strong>.
				if !strings.HasPrefix(text,"http") {
					Try entering the URL of the website you want to subscribe to and Foragd will try to find its feed.
				} else {
					Double-check the keywords you've entered or add additional ones to focus the search.
				}
			</p>
		</div>
	</div>
}

// AddSearchSubscription is a page for adding a new search subscription.
templ AddSearchSubscription(request *models.SearchSubscriptionRequest, breadcrumbs Breadcrumbs) {
	// Change the sort order to newest first as in most cases, when creating a search subscription. Users will be
	// interested in the newest articles that match.
	{{ request.Search.Sort = models.SortNewestFirst }}
	@manageSearchSubscription("add", request, breadcrumbs)
}

// EditSearchSubscription is a page for editing a search subscription.
templ EditSearchSubscription(request *models.SearchSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@manageSearchSubscription("edit", request, breadcrumbs)
}

// manageSearchSubscription generates the appropriate form layout for either adding or editing a search subscription.
templ manageSearchSubscription(action string, request *models.SearchSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@pageHeading() {
					{{ var title string }}
					switch action {
						case "add":
							{{ title = "Add a Search Subscription" }}
						case "edit":
							{{ title = "Editing " + request.Customisation.GetNickname() }}
					}
					@pageTitle(title)
				}
				<div class="mt-12 space-y-8 divide-y divide-base-content/15">
					<form
						id="add-subscription"
						if action == "add" {
							hx-post="/subscription/add/search"
						} else {
							hx-post={ "/subscriptions/" + string(*request.Search.SubscriptionID) + "/edit" }
						}
						hx-swap="none"
						hx-encoding="multipart/form-data"
						hx-disable="find button[type='submit']"
						class="group"
					>
						// Add hidden inputs when editing a subscription to know which subscription we are editing.
						if action == "edit" {
							<input type="hidden" name="subscription_id" value={ string(*request.Search.SubscriptionID) }/>
							<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeSearch) }/>
						}
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Customisation</legend>
							<label class="fieldset">
								<span class="label">Nickname</span>
								<input
									id="nickname"
									type="text"
									name="customisation.nickname"
									if request.Customisation != nil && request.Customisation.GetNickname() != "" {
										value={ request.Customisation.GetNickname() }
									}
									placeholder="My cool subscription…"
									class="input w-full bg-base-content/10 input-primary"
								/>
								<p>Add a nickname for the subscription.</p>
							</label>
							<label class="fieldset">
								<span class="label">Thumbnail</span>
								<div class="flex items-center gap-4">
									if request.Customisation != nil && request.Customisation.ImageURL != nil {
										@thumbnail(*request.Customisation.ImageURL, *request.Customisation.Nickname)
									} else {
										@thumbnail("", *request.Customisation.Nickname)
									}
									<input
										id="thumbnail"
										type="file"
										class="file-input flex bg-base-content/10 file-input-primary"
										name="customisation.thumbnail"
										accept=".jpg,.png,.webp"
									/>
								</div>
								<p>Customize the subscription thumbnail</p>
							</label>
						</fieldset>
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Search Filters</legend>
							// Search Text.
							<label class="fieldset">
								<span class="label">Text:</span>
								<textarea
									rows="2"
									id="search-text"
									type="text"
									name="search.text"
									placeholder={ `+keyword -"some phrase"` }
									class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-primary textarea-sm"
								>
									if request.Search.Text != "" {
										{ request.Search.Text }
									}
								</textarea>
							</label>
							<div>
								<button type="button" command="--toggle" commandfor="filtering" class="flex w-full items-center justify-between text-left">
									<span class="label">Additional Filtering</span>
									<span class="ml-6 flex h-7 items-center">
										@tableroutline.Plus(templ.Attributes{"class": "in-aria-expanded:hidden", "aria-label": "Expand content"})
										@tableroutline.Minus(templ.Attributes{"class": "not-in-aria-expanded:hidden", "aria-label": "Collapse content"})
									</span>
								</button>
								<el-disclosure
									id="filtering"
									hidden
								>
									// Category Filters.
									<label class="fieldset">
										<span class="label">Categories:</span>
										<textarea
											rows="2"
											id="search-categories"
											type="text"
											name="search.categories"
											placeholder={ `+keyword -"some phrase"` }
											class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-primary textarea-sm"
										>
											if request.Search.Categories != nil {
												{ *request.Search.Categories }
											}
										</textarea>
									</label>
									// Author Filters.
									<label class="fieldset">
										<span class="label">Authors:</span>
										<textarea
											rows="2"
											id="search-authors"
											type="text"
											name="search.authors"
											placeholder={ `+keyword -"some phrase"` }
											class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-primary textarea-sm"
										>
											if request.Search.Authors != nil {
												{ *request.Search.Authors }
											}
										</textarea>
									</label>
									// Published Within Filter.
									<label class="fieldset">
										<span class="label">Published Within:</span>
										<select id="subscription-published-within" name="search.published_within" class="select my-2 bg-base-300 select-primary">
											<option
												value="last_hour"
											>Last hour</option>
											<option
												value="last_half_day"
											>Last 12 hours</option>
											<option
												value="last_day"
											>Last day</option>
											<option
												value="last_week"
												selected
											>Last week</option>
											<option
												value="last_month"
											>Last month</option>
										</select>
									</label>
									// View Filter.
									<label class="fieldset">
										<span class="label">View:</span>
										<select id="search-view" name="search.view" class="select my-2 bg-base-300 select-primary">
											<option
												value={ string(models.ViewUnread) }
												if request.Search.View == models.ViewUnread {
													selected
												}
											>
												Unread
											</option>
											<option
												value={ string(models.ViewRead) }
												if request.Search.View == models.ViewRead {
													selected
												}
											>Read</option>
											<option
												value={ string(models.ViewAll) }
												if request.Search.View == models.ViewAll {
													selected
												}
											>All</option>
										</select>
									</label>
								</el-disclosure>
							</div>
						</fieldset>
						// Categories.
						if request.Customisation != nil {
							@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
						} else {
							@CategoryManagement(request.SuggestedCategories, nil)
						}
						<div class="mt-4 flex w-full justify-end gap-4">
							<button
								type="button"
								class="btn btn-secondary hover:btn-error"
								if prev, found := breadcrumbs.Previous(ctx); !found {
									hx-get="/home"
								} else {
									hx-get={ prev.Path + prev.Fragment }
								}
								hx-target={ ContentID.Target() }
								hx-swap="innerMorph transition:true"
								hx-push-url="true"
							>
								Back
							</button>
							<button type="submit" class="group btn btn-primary">
								<span class="hidden items-center group-[.htmx-request]:inline-flex">
									<span class="loading mr-3 loading-spinner"></span>
									<span class="text-sm/6">Processing</span>
								</span>
								<span class="inline-flex items-center group-[.htmx-request]:hidden">
									switch action {
										case "add":
											<span class="text-sm/6">Add</span>
										case "edit":
											<span class="text-sm/6">Save</span>
									}
								</span>
							</button>
						</div>
					</form>
				</div>
			}
		}
	}
}

// AddGroupSubscription is a page for adding a new group subscription.
templ AddGroupSubscription(request *models.GroupSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@manageGroupSubscription("add", request, breadcrumbs)
}

// EditGroupSubscription is a page for editing a group subscription.
templ EditGroupSubscription(request *models.GroupSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@manageGroupSubscription("edit", request, breadcrumbs)
}

// manageGroupSubscription generates the appropriate form layout for either adding or editing a group subscription.
templ manageGroupSubscription(action string, request *models.GroupSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@pageHeading() {
					{{ var title string }}
					switch action {
						case "add":
							{{ title = "Add a Group Subscription" }}
						case "edit":
							{{ title = "Editing " + request.Customisation.GetNickname() }}
					}
					@pageTitle(title)
				}
				<div class="mt-12 space-y-8 divide-y divide-base-content/15">
					<form
						id="add-subscription"
						if action == "add" {
							hx-post="/subscription/add/group"
						} else {
							hx-post={ "/subscriptions/" + string(*request.SubscriptionID) + "/edit" }
						}
						hx-swap="none"
						hx-encoding="multipart/form-data"
						hx-disable="find button[type='submit']"
						class="group"
					>
						// Add hidden inputs when editing a subscription to know which subscription we are editing.
						if action == "edit" {
							<input type="hidden" name="subscription_id" value={ string(*request.SubscriptionID) }/>
							<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeGroup) }/>
						}
						// Customisation.
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Customisation</legend>
							<label class="fieldset">
								<span class="label">Nickname</span>
								<input
									id="nickname"
									type="text"
									name="customisation.nickname"
									if request.Customisation != nil && request.Customisation.GetNickname() != "" {
										value={ request.Customisation.GetNickname() }
									}
									placeholder="My cool subscription…"
									class="input w-full bg-base-content/10 input-primary"
								/>
								<p>Add a nickname for the subscription.</p>
							</label>
							<label class="fieldset">
								<span class="label">Thumbnail</span>
								<div class="flex items-center gap-4">
									if request.Customisation != nil && request.Customisation.ImageURL != nil {
										@thumbnail(*request.Customisation.ImageURL, *request.Customisation.Nickname)
									} else {
										@thumbnail("", *request.Customisation.Nickname)
									}
									<input
										id="thumbnail"
										type="file"
										class="file-input flex bg-base-content/10 file-input-primary"
										name="customisation.thumbnail"
										accept=".jpg,.png,.webp"
									/>
								</div>
								<p>Customize the subscription thumbnail</p>
							</label>
						</fieldset>
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Subscriptions</legend>
							<label class="fieldset">
								<span class="label">Add Subscriptions</span>
								<div class="join mt-2 sm:mt-0">
									<el-autocomplete id="suggestions" class="join">
										<input
											id="subscription-suggestion"
											name="suggestion_text"
											class="input join-item bg-base-300 brightness-95 input-primary"
											placeholder="Subscription..."
											_="on keydown[key=='Enter'] send subscriptionSuggestionSelected then halt the event"
										/>
										<button
											type="button"
											class="btn join-item btn-primary"
											aria-label="Show subscription suggestions"
										>
											@tableroutline.ChevronDown(templ.Attributes{"class": "transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
										</button>
										<el-options
											popover
											anchor="bottom start"
											class="max-h-60 w-(--input-width) overflow-auto rounded-box bg-base-200 shadow-lg outline-1 outline-neutral/5 [--anchor-gap:--spacing(1)]"
										>
											<ul class="menu">
												for subscription := range slices.Values(request.SuggestedSubscriptions) {
													<li>
														<el-option value={ subscription.GetTitle() }>
															<input type="hidden" name={ "suggestions[" + subscription.GetID() + "]" } value={ subscription.GetTitle() }/>
															{ subscription.GetTitle() }
														</el-option>
													</li>
												}
											</ul>
										</el-options>
									</el-autocomplete>
									<button
										hx-post="/subscription/group/add"
										hx-target="#subscriptions"
										hx-encoding="application/x-www-form-urlencoded"
										hx-include="#suggestions,#subscriptions"
										hx-swap="beforeend"
										hx-trigger="click, subscriptionSuggestionSelected from:body"
										type="button"
										class="btn join-item btn-secondary"
										_="on htmx:after:request set #subscription-suggestion.value to ''"
										aria-label="Add subscription to group"
									>
										@tableroutline.Plus(templ.Attributes{"aria-hidden": "true"})
									</button>
								</div>
							</label>
							<div class="fieldset">
								<span class="label">Existing Subscriptions</span>
								<div
									id="subscriptions"
									class="flex flex-wrap items-center gap-2"
								>
									for id, name := range request.Subscriptions {
										@AddSubscriptionToGroup(id, name)
									}
								</div>
							</div>
						</fieldset>
						// Categories.
						if request.Customisation != nil {
							@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
						} else {
							@CategoryManagement(request.SuggestedCategories, nil)
						}
						// Article Filters.
						@subscriptionArticleFiltersFields(request.ArticleFilters)
						<div class="mt-4 flex w-full justify-end gap-4">
							<button
								type="button"
								class="btn btn-secondary hover:btn-error"
								if prev, found := breadcrumbs.Previous(ctx); !found {
									hx-get="/home"
								} else {
									hx-get={ prev.Path + prev.Fragment }
								}
								hx-target={ ContentID.Target() }
								hx-swap="innerMorph transition:true"
								hx-push-url="true"
							>
								Back
							</button>
							<button type="submit" class="group btn btn-primary">
								<span class="hidden items-center group-[.htmx-request]:inline-flex">
									<span class="loading mr-3 loading-spinner"></span>
									<span class="text-sm/6">Processing</span>
								</span>
								<span class="inline-flex items-center group-[.htmx-request]:hidden">
									switch action {
										case "add":
											<span class="text-sm/6">Add</span>
										case "edit":
											<span class="text-sm/6">Save</span>
									}
								</span>
							</button>
						</div>
					</form>
				</div>
			}
		}
	}
}

// AddSubscriptionToGroup renders a button indicating a subscription is part of a group subscription. Clicking the
// button removes it from the group.
templ AddSubscriptionToGroup(id, name string) {
	<button
		class="btn btn-outline btn-sm hover:btn-error"
		_="on click remove me"
		aria-label={ "Remove " + name + " from group" }
	>
		<input type="hidden" name={ "subscriptions[" + id + "]" } value={ name }/>
		{ name }
		@tableroutline.X(templ.Attributes{"class": "size-4", "aria-hidden": "true"})
	</button>
}

templ EditEmailSubscription(request *models.EditEmailSubscriptionRequest, breadcrumbs Breadcrumbs) {
	@LayoutInternal(NavSubscriptions, &InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				@pageHeading() {
					@pageTitle("Editing " + request.Customisation.GetNickname())
