	"strconv"
	"strings"
)

templ (s *Subscription) subscriptionFavoriteToggle() {
	<div class="tooltip tooltip-top tooltip-end" data-tip="Toggle favorite">
		<label
			id={ s.GetID() + "-toggle-favorite" }
			aria-label={ "Toggle favorite status for " + s.GetTitle() }
			class="btn swap btn-square btn-ghost btn-md"
			_="
		on htmx:afterRequest(successful) halt the event's bubbling end
    	on htmx:afterRequest(failed) toggle @checked on <input[type='checkbox'] in me/>
		"
			{ s.favoriteAttributes()... }
		>
			<input
				type="checkbox"
				_="on click halt the event's bubbling"
				if s.IsFavorite() {
					checked
				}
				aria-label={ "Toggle favorite status for " + s.GetTitle() }
			/>
			@tablerfilled.Heart(templ.Attributes{"class": "swap-on size-5 fill-primary"})
			@tableroutline.Heart(templ.Attributes{"class": "swap-off size-5 stroke-primary"})
		</label>
	</div>
}

templ (s *Subscription) subscriptionMarkToggle() {
	// Mark action.
	if s.GetSubscriptionType() != models.SubscriptionTypeSearch {
		{{
			var mark models.Mark
			if s.GetStats().IsUnread() {
				mark = models.MarkRead
			} else {
				mark = models.MarkUnread
			}
		}}
		<div class="tooltip tooltip-top tooltip-end" data-tip={ "Toggle mark" }>
			<label
				id={ s.GetID() + "-toggle-mark" }
				aria-label={ "Toggle mark status for " + s.GetTitle() }
				class="btn swap btn-square btn-ghost btn-md"
				_="
				  on htmx:afterRequest
    				if event.detail.successful
				  		halt the event's bubbling
						if closest .card exists
				  			toggle .brightness-90 on closest .card
						end
						set :mark to the first <input/> in me
						if :mark.value is 'read'
							set :mark.value to 'unread'
						else if :mark.value is 'unread'
							set :mark.value to 'read'
						end
					else
    			  		toggle @checked on <input[type='checkbox']/> in me
					end
				"
				{ s.markAttributes(service.ListFiltersFromCtx(ctx).View)... }
			>
				<input
					id={ s.GetID() + "-mark-action" }
					type="hidden"
					name="mark"
					value={ string(mark) }
				/>
				<input
					type="checkbox"
					_="on click halt the event's bubbling"
					if s.GetStats().IsUnread() {
						checked
					}
					aria-label={ "Toggle mark status for " + s.GetTitle() }
				/>
				@tableroutline.MailOpened(templ.Attributes{"class": "swap-on size-5 stroke-primary"})
				@tableroutline.Mail(templ.Attributes{"class": "swap-off size-5 stroke-primary"})
			</label>
		</div>
	}
}

// SubscriptionCard renders a subscription in a card format, suitable for showing together with other subscriptions in a
// list/grid. The idx argument is used to indicate the position of this subscription card relative to others in a
// grid/list (and is used for CSS-based animations).
templ SubscriptionCard(idx int, path string, subscription *models.Subscription) {
	{{ s := &Subscription{Subscription: subscription} }}
	@partials.Card(element.WithAttribute("id", s.GetID()),
		element.WithAttribute("style", "--i: "+strconv.Itoa(idx)),
		element.WithClasses("group", "relative", "transition-opacity", "animate-fadeinup", "animation-delay-[calc(min(var(--i),15)*80ms)]", "masonry-item"),
		element.WithHXIndicator("this"),
	) {
		// Show unread count in badge at top right if user wants stats shown.
		if user := models.UserFromCtx(ctx); user != nil && user.GetSettings().ShowSubscriptionStats {
			<div class="absolute top-0 right-0">
				<span class="mt-2 mr-2 badge badge-sm badge-primary">
					if s.GetStats().UnreadTotal() >= 100 {
						99+
					} else {
						{ s.GetStats().UnreadTotal() }
					}
				</span>
			</div>
		}
		<input type="hidden" name="selected_subscriptions" value={ s.GetID() }/>
		// Card header.
		@partials.CardHeader() {
			<div class="group flex cursor-pointer touch-manipulation items-center" { s.viewAttributes()... }>
				<div class="mr-4 shrink-0 self-center transition-transform duration-400 ease-in-out group-hover:scale-[1.04]">
					if s.GetImage() == "" {
						@subscriptionThumbnail(nil, s.GetTitle())
					} else {
						@subscriptionThumbnail(models.NewRemoteImage(s.GetImage(), s.GetTitle()), s.GetTitle())
					}
				</div>
				<h2 class="card-title font-serif text-lg text-balance transition-colors group-hover:text-primary group-has-[.card-footer:active]:transition-none group-has-[.category-badge:active]:scale-none group-has-[.category-badge:active]:transition-none group-has-[.latest-items:active]:scale-none group-has-[.latest-items:active]:transition-none">
					{ s.GetTitle() }
				</h2>
				// Add an icon to indicate whether article filtering is being applied.
				if articleFilters := s.GetArticleFilters(); !articleFilters.IsEmpty() {
					<div class="tooltip" data-tip="Article filtering applied">
						<span class="sr-only">Article filtering applied</span>
						@tablerfilled.Filter(templ.Attributes{"class": "ml-2 size-4 fill-accent", "aria-hidden": "true"})
					</div>
				}
			</div>
		}
		// Card body.
		@partials.CardBody(element.WithClasses("flex-1")) {
			// Display up to 5 of the subscription categories.
			@SubscriptionCategoryBadges(subscription)
			// Any custom body.
			if templ.GetChildren(ctx) != nil {
				{ children... }
			}
		}
		// Card footer.
		@partials.CardFooter(element.WithClasses("items-center")) {
			<div class="flex items-center justify-between border-t border-neutral/20 pt-3">
				<div class="flex min-w-0 flex-col gap-1">
					// Show stats if user has requested them.
					if user := models.UserFromCtx(ctx); user != nil && user.GetSettings().ShowSubscriptionStats {
						<span class="badge justify-start badge-sm tabular-nums">
							<relative-time
								datetime={ s.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
								format="relative"
							>
								{ s.GetUpdatedDate().Format("Jan _2, 2006") }
							</relative-time>
						</span>
						if s.GetSubscriptionType() == models.SubscriptionTypeFeed {
							<span class="badge justify-start badge-sm tabular-nums">
								{ s.GetStats().UpdateFrequency() }
							</span>
						}
					} else {
						<span class="badge badge-sm tabular-nums">
							<relative-time
								datetime={ s.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
								format="relative"
							>
								{ s.GetUpdatedDate().Format("Jan _2, 2006") }
							</relative-time>
						</span>
					}
				</div>
				<div class="flex shrink-0 items-center">
					// Favorite action.
					@s.subscriptionFavoriteToggle()
					// Mark action.
					@s.subscriptionMarkToggle()
					// Separator.
					<div aria-hidden="true" class="mx-1 h-4 w-px bg-neutral/20"></div>
					// Context menu actions.
					<div class="tooltip tooltip-top tooltip-end" data-tip="Subscription actions">
						<el-dropdown class="relative touch-manipulation" _="on click halt the event's bubbling">
							<button
								id={ "btn-" + s.GetID() + "-actions" }
								class="btn btn-ghost btn-sm"
							>
								<span class="sr-only">{ s.GetTitle() + " Actions" }</span>
								@tableroutline.Menu2(templ.Attributes{"class": "size-5 stroke-primary", "aria-hidden": "true"})
							</button>
							@partials.Menu(element.WithAttribute("id", "menu-"+s.GetID()+"-actions")) {
								// View action.
								if s.GetSubscriptionType() == models.SubscriptionTypeFeed && s.GetLink() != "" {
									@partials.MenuItem() {
										<a
											href={ s.GetLink() }
											rel="noopener"
											target="_blank"
											_="on click halt the event's bubbling"
										>
											@tableroutline.ExternalLink(templ.Attributes{"class": "size-5 stroke-primary", "aria-hidden": "true"})
											Feed Website
										</a>
									}
								}
								// Edit action.
								@partials.MenuItem() {
									<a { s.editAttributes(path)... }>
										@tableroutline.Edit(templ.Attributes{"class": " size-5 stroke-primary", "aria-hidden": "true"})
										Edit Subscription
									</a>
								}
								// Unsubscribe action.
								@partials.MenuItem() {
									<a { s.unsubscribeAttributes()... }>
										@tableroutline.Trash(templ.Attributes{"class": " size-5 stroke-primary", "aria-hidden": "true"})
										Remove Subscription
									</a>
								}
								// Report issue action.
								@partials.MenuItem() {
									<a { s.reportIssueAttributes()... }>
										@tableroutline.Flag2(templ.Attributes{"class": " size-5 stroke-primary", "aria-hidden": "true"})
										Report an Issue
									</a>
								}
							}
						</el-dropdown>
					</div>
				</div>
			</div>
		}
	}
}

templ SubscriptionCategoryBadges(subscription *models.Subscription) {
	{{ categoryLimit := 10 }}
	{{ categories := subscription.GetCategories(categoryLimit) }}
	// Category Badges (up to 10).
	if len(categories) > 0 {
		<div class="mb-2.5 flex flex-wrap gap-1.5 self-start">
			for idx, category := range categories {
				{{
					filters := models.NewListDisplayFilters()
					filters.Categories = append(filters.Categories, category)
					var extraClasses string
					// Only show the first three categories, hide all others behind a button toggle.
					if idx >= 3 {
						extraClasses = "hidden"
					}
				}}
				@CategoryBadge(category,
					element.WithHXMethod(http.MethodGet, "/list/subscriptions"),
					element.WithHXTarget(ContentID.Target()),
					element.WithHXValues(filters.Values()),
					element.WithClasses(extraClasses),
					element.WithAttribute("_", "on click halt the event's bubbling"),
				)
			}
			// Add a button to reveal all categories when clicked.
			if len(categories) > 3 {
				<button
					class="toggle-categories-btn btn btn-outline btn-xs"
					_="
							on click
							  halt the event's bubbling
          					  set :tags to <span/> in the closest parent <div/> where it matches .category-badge
							  for tag in :tags
							   remove .hidden from tag
							  end
							  remove me
							end
							"
				>
					{ fmt.Sprintf("+ %d more",len(categories)-3) }
				</button>
			}
		</div>
	}
}

// ListSubscriptions renders the list of subscriptions in a grid layout with filtering controls and an actions menu.
templ ListSubscriptions(response *models.ListSubscriptionsResponse) {
	{{ controls := &listControls{path: "/list/subscriptions", filters: response.Filters, categories: response.Subscriptions.GetCategories()} }}
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@scrollRestore()
		<div _="install ScrollRestore(gridSelector: '#grid-objects', cardSelector: '.card', endpoint: '/list/subscriptions', storageKey: 'subscriptionsList')">
			@templ.Fragment(ContentFragment) {
				@partials.PullToRefresh()
				@buttonBackToTop()
				@container(element.WithClasses("pt-4 ptr-scroll"), element.WithAttribute("_", "install PullToRefresh(threshold: 70)")) {
					// Show a page header.
					@pageHeading() {
						@pageTitle("Subscriptions")
					}
					// List actions.
					@controls.Show(nil, listSubscriptionsButtons(response))
					<section id="subscriptions-list" class="ptr-content pt-4">
						<div id="refreshing" class="group mx-auto flex w-full justify-center">
							<div class="hidden py-4 text-center group-[.htmx-request]:inline-flex">
								<span class="loading mr-3 loading-xl loading-bars"></span>
								<p class="text-lg/loose font-semibold">Refreshing...</p>
							</div>
						</div>
						if len(response.Subscriptions) > 0 {
							@masonryGrid()
							@grid(element.WithClasses("masonry-grid", "relative"),
								element.WithAttribute("_", "install MasonryGrid"),
								element.WithHXMethod(http.MethodGet, "/list/subscriptions"),
								element.WithHXTarget(ContentID.Target()),
								element.WithHXTrigger("refresh"),
								element.WithHXIndicator("#refreshing"),
							) {
								@templ.Fragment(PaginateFragment) {
									for idx, subscription := range response.Subscriptions {
										@SubscriptionCard(idx, "/list/subscriptions", subscription) {
											if response.LatestArticles != nil {
												{{ itemsData, ok := response.LatestArticles.Load(subscription.GetID()) }}
												if ok {
													{{ items, ok := itemsData.(models.Items) }}
													if ok {
														<div class="mt-auto h-full">
															<ul class="latest-items menu">
																for item := range slices.Values(items) {
																	<li class="my-1 border-l-2 border-accent/40 pl-3 text-base">
																		<div class="tooltip tooltip-bottom" data-tip={ item.GetTitle() }>
																			<a
																				hx-get={ "/view/article/" + item.GetID() }
																				hx-target={ ContentID.Target() }
																				hx-swap="innerHTML show:top transition:true"
																				hx-trigger="click"
																				hx-push-url="true"
																				_="on click halt the event's bubbling"
																				class="line-clamp-3 font-serif text-base"
																			>
																				{ item.GetTitle() }
																			</a>
																		</div>
																	</li>
																}
															</ul>
														</div>
													}
												}
											}
										}
									}
								}
							}
							@ListPaginationControl("/list/subscriptions/paginate", &response.Filters, response.Pagination)
							<div id="loading-items" class="group mx-auto mt-4 flex w-full justify-center">
								<div class="hidden text-center group-[.htmx-request]:inline-flex">
									<span class="loading mr-3 loading-xl loading-bars"></span>
									<p class="text-lg/loose font-semibold">Loading content...</p>
								</div>
							</div>
							// Show some actions at the bottom of the list.
							<ul class="menu menu-vertical mt-8 w-full items-center justify-center gap-2 sm:menu-horizontal">
								// Mark all subscriptions action.
								<li>
									<button
										class="group btn border-neutral/15 btn-outline"
										if response.Filters.GetView() == models.ViewUnread {
											hx-post={ "/list/subscriptions/mark/" + string(models.MarkRead) }
											hx-vals={ templ.JSONString(map[string]any{
										"mark": models.MarkRead,
									}) }
										} else {
											hx-post={ "/list/subscriptions/mark/" + string(models.MarkUnread) }
											hx-vals={ templ.JSONString(map[string]any{
										"mark": models.MarkUnread,
									}) }
										}
										hx-target={ ContentID.Target() }
										hx-include="article > input"
									>
										<span class="hidden items-center group-[.htmx-request]:inline-flex">
											<span class="loading mr-3 loading-spinner"></span>
											<span class="text-sm/6">Loading</span>
										</span>
										<span class="inline-flex items-center group-[.htmx-request]:hidden">
											if response.Filters.GetView() == models.ViewUnread {
												@tableroutline.MailOpened(templ.Attributes{"class": "mr-3 size-5 stroke-base-content/80", "aria-hidden": "true"})
												<span class="text-sm/6">Mark All Read</span>
											} else {
												@tableroutline.Mail(templ.Attributes{"class": "mr-3 size-5 stroke-base-content/80", "aria-hidden": "true"})
												<span class="text-sm/6">Mark All Unread</span>
											}
										</span>
									</button>
								</li>
							</ul>
						} else {
							@partials.NoContent()
						}
					</section>
				}
				// Watch for updates.
				<div
					id="updates"
					class="toast toast-center z-10"
					hx-post="/list/subscriptions/updates"
					hx-vals={ templ.JSONString(response.Filters.Values()) }
					hx-trigger="every 5m"
					hx-target="#updates"
				></div>
			}
		</div>
	}
}

templ listSubscriptionsButtons(response *models.ListSubscriptionsResponse) {
	{{
		var mark models.Mark
		if response.Filters.GetView() == models.ViewUnread {
			mark = models.MarkRead
		} else {
			mark = models.MarkUnread
		}
	}}
	<button
		hx-post={ "/list/subscriptions/mark/" + string(mark) }
		hx-target={ ContentID.Target() }
		hx-include=".card > input"
		hx-vals={ templ.JSONString(map[string]string{
			"view": string(response.Filters.GetView()),
			"mark": string(mark),
		}) }
		class="btn border-neutral/15 btn-outline btn-sm"
	>
		if response.Filters.GetView() == models.ViewUnread {
			@tableroutline.MailOpened(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
			Mark shown as Read
		} else {
			@tableroutline.Mail(templ.Attributes{"class": "size-5 stroke-base-content/80", "aria-hidden": "true"})
			Mark shown as Unread
		}
	</button>
}

templ subscriptionArticleFiltersFields(filters *models.ArticleFilters) {
	<fieldset class="fieldset min-w-0 py-8">
		<legend class="flex items-center gap-2 text-lg font-medium">
			Article Filtering
			<button popovertarget="article-filtering-help" type="button">
				@tableroutline.InfoCircle(templ.Attributes{"class": "size-6 text-info", "aria-hidden": "true"})
			</button>
			<el-popover popover id="article-filtering-help" anchor="bottom" class="[--anchor-gap:4px]">
				<div class="card-body block rounded-box bg-base-300 font-light shadow-sm outline-1 -outline-offset-1 outline-base-content/15">
					<p>
						The following operators can be used for more refined searches:
					</p>
					<ul class="mt-1">
						<li>| signifies OR operation (i.e., food OR beverages). This is the default.</li>
						<li>+ signifies AND operation (i.e., food AND beverages).</li>
						<li>- negates the word (i.e., NOT samsung)</li>
						<li>"" represents an exact phrase match (i.e., "galaxy watch").</li>
						<li>\* at the end of a word indicates a prefix match (i.e., bird\* will match bird, birding and birds).</li>
					</ul>
				</div>
			</el-popover>
		</legend>
		<label class="fieldset">
			<span class="label">Text</span>
			<textarea
				rows="2"
				id="article-text-filters"
				name="article_filters.text"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Text != nil {
					{ *filters.Text }
				}
			</textarea>
		</label>
		<label class="fieldset">
			<span class="label">Categories</span>
			<textarea
				rows="2"
				id="article-category-filters"
				name="article_filters.categories"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Categories != nil {
					{ *filters.Categories }
				}
			</textarea>
		</label>
		<label class="fieldset">
			<span class="label">Authors</span>
			<textarea
				rows="2"
				id="article-author-filters"
				name="article_filters.authors"
				placeholder={ `keyword -"some phrase"` }
				class="textarea w-full bg-base-content/10 textarea-primary"
				spellcheck="false"
			>
				if filters != nil && filters.Authors != nil {
					{ *filters.Authors }
				}
			</textarea>
		</label>
	</fieldset>
}

// AddFeedSubscription is a page for adding a new subscription to a feed.
templ AddFeedSubscription(request *models.FeedSubscriptionRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@pageHeading() {
					@pageTitle("Add a subscription")
				}
				<div id="add-subscription" class="space-y-8 divide-y divide-base-content/15">
					<fieldset class="fieldset min-w-0 py-8">
						<ol>
							<li>Choose from <span class="font-semibold">sources</span> drop-down on right to search Youtube, Google News, etc.</li>
							<li>Enter search terms (see notes below) as appropriate.</li>
						</ol>
						<div class="join mt-2 w-full join-vertical items-center sm:join-horizontal">
							<label class="input join-item w-full p-2 input-primary sm:w-2/3 sm:p-0">
								<span class="label">
									@tableroutline.Search(templ.Attributes{"class": "sm:ml-1 text-primary"})
								</span>
								<input
									id="add-subscription-search"
									type="search"
									name="suggestion_text"
									if request.URL != "" {
										value={ request.URL }
									}
									autocomplete="off"
									placeholder="Text, phrase or URL..."
									hx-post="/subscription/add/suggestions"
									hx-target="#subscription-suggestions"
									hx-trigger="keyup changed delay:500ms, search[this.value != ''], load[this.value != '']"
									hx-sync="this:replace"
									hx-indicator="#suggestions-loading"
									hx-include="[name='suggestion_source']"
									_="
									on htmx:beforeRequest set #subscription-suggestions.innerHTML to ''
									on keydown[key=='Enter'] halt the event
									"
								/>
							</label>
							<label class="select join-item w-full select-primary sm:w-1/3">
								<span class="label">Source:</span>
								<select
									id="suggestion-source"
									name="suggestion_source"
									class="shrink"
									_="
									on change if my.value is 'web' set #add-subscription-search.placeholder to 'Text, phrase or URL...' end
									on change if my.value is 'youtube' set #add-subscription-search.placeholder to 'Channel name, text or phrase...' end
									on change if my.value is 'gnews' set #add-subscription-search.placeholder to 'Search keywords...' end
									"
								>
									<option value="web" selected>Web</option>
									<option value="youtube">Youtube</option>
									<option value="gnews">Google News</option>
								</select>
							</label>
						</div>
						<ul class="mt-4 block list-inside list-disc text-neutral">
							<div _="on change from #suggestion-source if its value is 'web' remove @hidden from me else add @hidden to me">
								<li>
									Enter text or a phrase to search feed titles, descriptions and categories in the Foragd database.
								</li>
								<li>
									Enter a URL to fetch and parse the website for a suitable feed.
								</li>
							</div>
							<div _="on change from #suggestion-source if its value is 'youtube' remove @hidden from me else add @hidden to me" hidden>
								<li>
									Enter <span class="italic">{ `@ChannelName` }</span> to fetch a channel's feed.
								</li>
								<li>
									Enter keywords or a phrase to search YouTube for channels that match.
								</li>
							</div>
							<div _="on change from #suggestion-source if its value is 'gnews' remove @hidden from me else add @hidden to me" hidden>
								<li>
									Enter search terms to fetch and generate a feed with matching articles.
								</li>
								<li>
									For example: <span class="italic">when:24h site:reuters.com "World Events"</span>.
								</li>
							</div>
						</ul>
						// Loading skeleton.
						<div id="suggestions-loading" class="group">
							<div class="mt-8 hidden w-full group-[.htmx-request]:inline-flex sm:max-w-5xl">
								<ul class="divide-y divide-neutral/15">
									<li>
										<div class="flex">
											<div class="mr-4 shrink-0">
												<div class="size-12 skeleton"></div>
											</div>
											<div class="flex flex-1 justify-between">
												<div class="h-6 w-64 skeleton"></div>
												<div class="ml-4 h-12 w-32 shrink-0 skeleton"></div>
											</div>
										</div>
										<div class="mt-8 h-12 w-lg skeleton"></div>
										<div class="mt-8 flex flex-col gap-y-4">
											<div class="flex">
												<div class="mr-4 shrink-0 self-center">
													<div class="size-16 skeleton"></div>
												</div>
												<div>
													<div class="h-6 w-48 skeleton"></div>
													<div class="mt-2 h-12 w-96 skeleton"></div>
												</div>
											</div>
											<div class="flex">
												<div class="mr-4 shrink-0 self-center">
													<div class="size-16 skeleton"></div>
												</div>
												<div>
													<div class="h-6 w-48 skeleton"></div>
													<div class="mt-2 h-12 w-96 skeleton"></div>
												</div>
											</div>
											<div class="flex">
												<div class="mr-4 shrink-0 self-center">
													<div class="size-16 skeleton"></div>
												</div>
												<div>
													<div class="h-6 w-48 skeleton"></div>
													<div class="mt-2 h-12 w-96 skeleton"></div>
												</div>
											</div>
										</div>
									</li>
								</ul>
							</div>
						</div>
						// Suggestions.
						<div id="subscription-suggestions" class="mt-8 overflow-x-auto"></div>
					</fieldset>
					// Other Actions.
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						<div
							class="card-body cursor-pointer touch-manipulation rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/subscription/add/group"
							hx-target={ ContentID.Target() }
							hx-push-url="true"
						>
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Plus(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Add a Group Subscription</div>
							</div>
							<p>Combine muliple feed subscriptions into one. Filter across all articles.</p>
						</div>
						<div
							class="card-body cursor-pointer touch-manipulation rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md active:scale-[0.98]"
							hx-get="/subscription/add/search"
							hx-target={ ContentID.Target() }
							hx-include="#search-filters"
							hx-push-url="true"
						>
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Plus(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Add a Search Subscription</div>
							</div>
							<p>Search for articles and combine results into a single feed.</p>
						</div>
						<div class="col-span-full card-body justify-self-center rounded-box bg-base-200 hover:border hover:border-secondary hover:shadow-md">
							<div class="flex flex-row items-center gap-x-3">
								@tableroutline.Mailbox(templ.Attributes{"class": "text-secondary", "aria-hidden": "true"})
								<div class="card-title text-secondary">Subscribe to email newsletters</div>
							</div>
							{{ user := models.UserFromCtx(ctx) }}
							<div id="subscription-email" class="group">
								if user.Settings.SubscriptionEmail == nil {
									<p>Generate an email for subscribing to email newsletters.</p>
									<button
										hx-post="/user/settings/subscriptionemail"
										hx-target="#subscription-email"
										hx-swap="innerHTML transition:true"
										class="btn btn-primary"
									>
										<span class="hidden items-center group-[.htmx-request]:inline-flex">
											<span class="loading mr-3 loading-spinner"></span>
											<span class="text-sm/6">Processing</span>
										</span>
										<span class="inline-flex items-center group-[.htmx-request]:hidden">
											<span>Generate email address</span>
										</span>
									</button>
								} else {
									@ShowSubscriptionEmail(*user.Settings.SubscriptionEmail)
								}
							</div>
						</div>
					</div>
				</div>
			}
		}
	}
}

// EditFeedSubscription is a page for editing an existing feed subscription.
templ EditFeedSubscription(request *models.FeedSubscriptionRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@manageFeedSubscription("edit", request)
			}
		}
	}
}

// manageFeedSubscription generates the appropriate form layout for either adding or editing a feed subscription.
templ manageFeedSubscription(action string, request *models.FeedSubscriptionRequest) {
	@pageHeading() {
		{{ var title string }}
		switch action {
			case "add":
				{{ title = "Add a Subscription" }}
			case "edit":
				{{ title = "Editing " + request.Customisation.GetNickname() }}
		}
		@pageTitle(title)
	}
	<div class="mt-12 space-y-8 divide-y divide-base-content/15">
		<form
			id="add-subscription"
			if action == "add" {
				hx-post="/subscription/add"
			} else {
				hx-post={ "/subscription/save/" + request.SubscriptionID }
			}
			hx-swap="none"
			hx-encoding="multipart/form-data"
			hx-disinherit="*"
			class="group"
		>
			// Add hidden inputs when editing a subscription to know which subscription we are editing.
			if action == "edit" {
				<input type="hidden" name={ models.ParamSubscriptionID } value={ request.SubscriptionID }/>
				<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeFeed) }/>
			}
			// Customisation.
			<fieldset class="fieldset min-w-0 py-8">
				<legend class="text-lg font-medium">Customisation</legend>
				<label class="fieldset">
					<span class="label">Nickname</span>
					<input
						id="nickname"
						type="text"
						name="customisation.nickname"
						if request.Customisation != nil && request.Customisation.GetNickname() != "" {
							value={ request.Customisation.GetNickname() }
						}
						placeholder="My cool subscription…"
						class="input w-full bg-base-content/10 input-primary"
					/>
					<p>Add a nickname for the subscription.</p>
				</label>
				<label class="fieldset">
					<span class="label">Thumbnail</span>
					<div class="flex items-center gap-4">
						if request.Customisation != nil && request.Customisation.ImageURL != nil {
							@subscriptionThumbnail(&models.RemoteImage{URL: request.Customisation.ImageURL}, *request.Customisation.Nickname)
						} else {
							@subscriptionThumbnail(nil, *request.Customisation.Nickname)
						}
						<input
							id="thumbnail"
							type="file"
							class="file-input flex bg-base-content/10 file-input-primary"
							name="customisation.thumbnail"
							accept=".jpg,.png,.webp"
						/>
					</div>
					<p>Customize the subscription thumbnail</p>
				</label>
			</fieldset>
			// Categories.
			if request.Customisation != nil {
				@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
			} else {
				@CategoryManagement(request.SuggestedCategories, nil)
			}
			// Article Filters.
			@subscriptionArticleFiltersFields(request.ArticleFilters)
			// Additional Options for Existing Subscriptions.
			if action == "edit" {
				<fieldset class="fieldset min-w-0 py-8">
					<legend class="text-lg font-medium">Additional Settings</legend>
					<label class="fieldset">
						<div class="flex items-center gap-4">
							<span class="label">Always Show Full Article Content</span>
							<input
								id="show-full-article-content"
								type="checkbox"
								if request.Settings != nil && request.Settings.ShowFullArticleContent {
									checked="checked"
								}
								name="show_full_article_content"
								class="toggle toggle-primary toggle-sm"
							/>
						</div>
						<p>
							If articles in the subscription are only showing a summary, set this
							toggle to attempt to fetch the full content from the website.
						</p>
						<p>
							Note: fetching full content is based on a heuristic that tries to locate
							the article content on the page. It does not always produce optimal
							results.
						</p>
					</label>
				</fieldset>
			}
			<div class="mt-4 flex w-full justify-end gap-4">
				<button
					type="button"
					class="btn btn-secondary hover:btn-error"
					hx-get={ FromPathFromCtx(ctx) }
					hx-target={ ContentID.Target() }
					hx-swap="innerHTML transition:true"
					hx-push-url="true"
				>
					Back
				</button>
				<button type="submit" class="group btn btn-primary">
					<span class="hidden items-center group-[.htmx-request]:inline-flex">
						<span class="loading mr-3 loading-spinner"></span>
						<span class="text-sm/6">Processing</span>
					</span>
					<span class="inline-flex items-center group-[.htmx-request]:hidden">
						switch action {
							case "add":
								<span class="text-sm/6">Add</span>
							case "edit":
								<span class="text-sm/6">Save</span>
						}
					</span>
				</button>
			</div>
		</form>
	</div>
}

templ ShowFeedSuggestions(request *models.FeedSuggestionsResults) {
	if len(request.Feeds) == 0 {
		@ShowNoSuggestions(request.Text)
	} else {
		<ul id="feed-suggestions" class="divide-y divide-neutral/15">
			for feed := range slices.Values(request.Feeds) {
				<li
					id={ "suggestion-" + feed.GetID() }
					class="group/item py-4"
				>
					<div class="flex">
						<div class="mr-4 shrink-0">
							if img := feed.GetImage(); img == nil {
								@subscriptionThumbnail(nil, feed.GetTitle())
							} else {
								{{
									var imgTitle string
									if feed.Image.Title == nil {
										imgTitle = feed.GetTitle()
									} else {
										imgTitle = *feed.Image.Title
									}
								}}
								@subscriptionThumbnail(models.NewRemoteImage(*feed.Image.URL, imgTitle), feed.GetTitle())
							}
						</div>
						<div class="flex flex-1">
							<h2 class="card-title line-clamp-2 flex-1 tracking-tight text-pretty">
								{ feed.GetTitle() }
							</h2>
							<div class="ml-4 shrink-0">
								<form hx-encoding="multipart/form-data">
									<input type="hidden" name="url" value={ feed.GetSourceURLs()[0] }/>
									<input type="hidden" name="feed_id" value={ feed.GetID() }/>
									<button
										type="submit"
										class="group btn btn-primary"
										hx-post="/subscription/add/feed"
										hx-swap="none"
										data-suggestionid={ "#suggestion-" + feed.GetID() }
										_="on htmx:afterRequest(successful) remove me"
									>
										<span class="hidden items-center group-[.htmx-request]:inline-flex">
											<span class="loading mr-3 loading-md loading-spinner text-primary"></span>
											Subscribing
										</span>
										<span class="inline-flex items-center group-[.htmx-request]:hidden">
											Subscribe
										</span>
									</button>
								</form>
							</div>
						</div>
					</div>
					if feed.GetDescription() != "" {
						<p class="pt-8 text-sm/6 text-neutral">{ feed.GetDescription() }</p>
					}
					if items, ok := request.LatestItems[feed.GetID()]; ok {
						<div class="flex flex-col gap-y-4 pt-8">
							for item := range slices.Values(items) {
								<div class="flex">
									<div class="mr-4 shrink-0 self-center">
										if img := item.GetImage(); img != nil {
											{{ img := item.GetImage() }}
											if img.GetTitle() == "" {
												{{ img.Title = new(item.GetTitle()) }}
											}
											<figure class="mask mask-squircle">
												@partials.NewProxiedImage(img, "rs:auto:64:64/sh:0.5/q:80/el:1/ex:1/gravity:sm/sm:1/kcr:1/scp:1/ext:webp",
													element.WithAttribute("width", "64"),
													element.WithAttribute("height", "64"),
													element.WithClasses("aspect-square", "object-cover"),
												)
											</figure>
										}
									</div>
									<div>
										<h3 class="text-base font-semibold">
											if item.GetTitle() != "" {
												{ item.GetTitle() }
											} else {
												(no title)
											}
										</h3>
										<div class="prose-summary mb-3 line-clamp-2">
											switch  {
												case item.GetDescription() != "":
													@templ.Raw(item.GetDescription())
												case item.GetContent() != "":
													@templ.Raw(item.GetContent())
											}
										</div>
									</div>
								</div>
							}
						</div>
					}
				</li>
			}
		</ul>
	}
}

templ ShowNoSuggestions(text string) {
	<div class="flex">
		<div class="mr-4 shrink-0 self-center">
			@tablerfilled.ZoomQuestion(templ.Attributes{"class": "size-16 fill-primary"})
		</div>
		<div>
			<h2 class="text-lg font-semibold">No results.</h2>
			<p class="mt-1 text-neutral">
				We could not find any good matches for <strong>{ text }</strong>.
				if !strings.HasPrefix(text,"http") {
					Try entering the URL of the website you want to subscribe to and Foragd will try to find its feed.
				} else {
					Double-check the keywords you've entered or add additional ones to focus the search.
				}
			</p>
		</div>
	</div>
}

// AddSearchSubscription is a page for adding a new search subscription.
templ AddSearchSubscription(request *models.SearchSubscriptionRequest) {
	// Change the sort order to newest first as in most cases, when creating a search subscription. Users will be
	// interested in the newest articles that match.
	{{ request.Search.Sort = models.SortNewestFirst }}
	@manageSearchSubscription("add", request)
}

// EditSearchSubscription is a page for editing a search subscription.
templ EditSearchSubscription(request *models.SearchSubscriptionRequest) {
	@manageSearchSubscription("edit", request)
}

// manageSearchSubscription generates the appropriate form layout for either adding or editing a search subscription.
templ manageSearchSubscription(action string, request *models.SearchSubscriptionRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@pageHeading() {
					{{ var title string }}
					switch action {
						case "add":
							{{ title = "Add a Search Subscription" }}
						case "edit":
							{{ title = "Editing " + request.Customisation.GetNickname() }}
					}
					@pageTitle(title)
				}
				<div class="mt-12 space-y-8 divide-y divide-base-content/15">
					<form
						id="add-subscription"
						if action == "add" {
							hx-post="/subscription/add/search"
						} else {
							hx-post={ "/subscription/save/" + string(*request.Search.SubscriptionID) }
						}
						hx-swap="none"
						hx-encoding="multipart/form-data"
						hx-disinherit="*"
						class="group"
					>
						// Add hidden inputs when editing a subscription to know which subscription we are editing.
						if action == "edit" {
							<input type="hidden" name={ models.ParamSubscriptionID } value={ string(*request.Search.SubscriptionID) }/>
							<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeSearch) }/>
						}
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Customisation</legend>
							<label class="fieldset">
								<span class="label">Nickname</span>
								<input
									id="nickname"
									type="text"
									name="customisation.nickname"
									if request.Customisation != nil && request.Customisation.GetNickname() != "" {
										value={ request.Customisation.GetNickname() }
									}
									placeholder="My cool subscription…"
									class="input w-full bg-base-content/10 input-primary"
								/>
								<p>Add a nickname for the subscription.</p>
							</label>
							<label class="fieldset">
								<span class="label">Thumbnail</span>
								<div class="flex items-center gap-4">
									if request.Customisation != nil && request.Customisation.ImageURL != nil {
										@subscriptionThumbnail(&models.RemoteImage{URL: request.Customisation.ImageURL}, "")
									} else {
										@subscriptionThumbnail(nil, "")
									}
									<input
										id="thumbnail"
										type="file"
										class="file-input flex bg-base-content/10 file-input-primary"
										name="customisation.thumbnail"
										accept=".jpg,.png,.webp"
									/>
								</div>
								<p>Customize the subscription thumbnail</p>
							</label>
						</fieldset>
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Search Filters</legend>
							// Search Text.
							<label class="fieldset">
								<span class="label">Text:</span>
								<textarea
									rows="2"
									id="search-text"
									type="text"
									name="search.text"
									placeholder={ `+keyword -"some phrase"` }
									class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-sm textarea-primary"
								>
									if request.Search.Text != "" {
										{ request.Search.Text }
									}
								</textarea>
							</label>
							<div>
								<button type="button" command="--toggle" commandfor="filtering" class="flex w-full items-center justify-between text-left">
									<span class="label">Additional Filtering</span>
									<span class="ml-6 flex h-7 items-center">
										@tableroutline.Plus(templ.Attributes{"class": "in-aria-expanded:hidden", "aria-label": "Expand content"})
										@tableroutline.Minus(templ.Attributes{"class": "not-in-aria-expanded:hidden", "aria-label": "Collapse content"})
									</span>
								</button>
								<el-disclosure
									id="filtering"
									hidden
								>
									// Category Filters.
									<label class="fieldset">
										<span class="label">Categories:</span>
										<textarea
											rows="2"
											id="search-categories"
											type="text"
											name="search.categories"
											placeholder={ `+keyword -"some phrase"` }
											class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-sm textarea-primary"
										>
											if request.Search.Categories != nil {
												{ *request.Search.Categories }
											}
										</textarea>
									</label>
									// Author Filters.
									<label class="fieldset">
										<span class="label">Authors:</span>
										<textarea
											rows="2"
											id="search-authors"
											type="text"
											name="search.authors"
											placeholder={ `+keyword -"some phrase"` }
											class="textarea mt-2 w-full bg-base-300 brightness-95 textarea-sm textarea-primary"
										>
											if request.Search.Authors != nil {
												{ *request.Search.Authors }
											}
										</textarea>
									</label>
									// Published Within Filter.
									<label class="fieldset">
										<span class="label">Published Within:</span>
										<select id="subscription-published-within" name="search.published_within" class="select my-2 bg-base-300 select-primary">
											<option
												value="last_hour"
											>Last hour</option>
											<option
												value="last_half_day"
											>Last 12 hours</option>
											<option
												value="last_day"
											>Last day</option>
											<option
												value="last_week"
												selected
											>Last week</option>
											<option
												value="last_month"
											>Last month</option>
										</select>
									</label>
									// View Filter.
									<label class="fieldset">
										<span class="label">View:</span>
										<select id="search-view" name="search.view" class="select my-2 bg-base-300 select-primary">
											<option
												value={ string(models.ViewUnread) }
												if request.Search.View == models.ViewUnread {
													selected
												}
											>
												Unread
											</option>
											<option
												value={ string(models.ViewRead) }
												if request.Search.View == models.ViewRead {
													selected
												}
											>Read</option>
											<option
												value={ string(models.ViewAll) }
												if request.Search.View == models.ViewAll {
													selected
												}
											>All</option>
										</select>
									</label>
								</el-disclosure>
							</div>
						</fieldset>
						// Categories.
						if request.Customisation != nil {
							@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
						} else {
							@CategoryManagement(request.SuggestedCategories, nil)
						}
						<div class="mt-4 flex w-full justify-end gap-4">
							<button
								type="button"
								class="btn btn-secondary hover:btn-error"
								hx-get={ FromPathFromCtx(ctx) }
								hx-target={ ContentID.Target() }
								hx-swap="innerHTML transition:true"
								hx-push-url="true"
							>
								Back
							</button>
							<button type="submit" class="group btn btn-primary">
								<span class="hidden items-center group-[.htmx-request]:inline-flex">
									<span class="loading mr-3 loading-spinner"></span>
									<span class="text-sm/6">Processing</span>
								</span>
								<span class="inline-flex items-center group-[.htmx-request]:hidden">
									switch action {
										case "add":
											<span class="text-sm/6">Add</span>
										case "edit":
											<span class="text-sm/6">Save</span>
									}
								</span>
							</button>
						</div>
					</form>
				</div>
			}
		}
	}
}

// AddGroupSubscription is a page for adding a new group subscription.
templ AddGroupSubscription(request *models.GroupSubscriptionRequest) {
	@manageGroupSubscription("add", request)
}

// EditGroupSubscription is a page for editing a group subscription.
templ EditGroupSubscription(request *models.GroupSubscriptionRequest) {
	@manageGroupSubscription("edit", request)
}

// manageGroupSubscription generates the appropriate form layout for either adding or editing a group subscription.
templ manageGroupSubscription(action string, request *models.GroupSubscriptionRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@narrowContainer(element.WithClasses("pt-4")) {
				@pageHeading() {
					{{ var title string }}
					switch action {
						case "add":
							{{ title = "Add a Group Subscription" }}
						case "edit":
							{{ title = "Editing " + request.Customisation.GetNickname() }}
					}
					@pageTitle(title)
				}
				<div class="mt-12 space-y-8 divide-y divide-base-content/15">
					<form
						id="add-subscription"
						if action == "add" {
							hx-post="/subscription/add/group"
						} else {
							hx-post={ "/subscription/save/" + string(*request.SubscriptionID) }
						}
						hx-swap="none"
						hx-encoding="multipart/form-data"
						hx-params="not suggestion_text,suggestions,category"
						hx-disinherit="*"
						class="group"
					>
						// Add hidden inputs when editing a subscription to know which subscription we are editing.
						if action == "edit" {
							<input type="hidden" name={ models.ParamSubscriptionID } value={ string(*request.SubscriptionID) }/>
							<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeGroup) }/>
						}
						// Customisation.
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Customisation</legend>
							<label class="fieldset">
								<span class="label">Nickname</span>
								<input
									id="nickname"
									type="text"
									name="customisation.nickname"
									if request.Customisation != nil && request.Customisation.GetNickname() != "" {
										value={ request.Customisation.GetNickname() }
									}
									placeholder="My cool subscription…"
									class="input w-full bg-base-content/10 input-primary"
								/>
								<p>Add a nickname for the subscription.</p>
							</label>
							<label class="fieldset">
								<span class="label">Thumbnail</span>
								<div class="flex items-center gap-4">
									if request.Customisation != nil && request.Customisation.ImageURL != nil {
										@subscriptionThumbnail(&models.RemoteImage{URL: request.Customisation.ImageURL}, "")
									} else {
										@subscriptionThumbnail(nil, "")
									}
									<input
										id="thumbnail"
										type="file"
										class="file-input flex bg-base-content/10 file-input-primary"
										name="customisation.thumbnail"
										accept=".jpg,.png,.webp"
									/>
								</div>
								<p>Customize the subscription thumbnail</p>
							</label>
						</fieldset>
						<fieldset class="fieldset min-w-0 py-8">
							<legend class="text-lg font-medium">Subscriptions</legend>
							<label class="fieldset">
								<span class="label">Add Subscriptions</span>
								<div class="join mt-2 sm:mt-0">
									<el-autocomplete id="suggestions" class="join join-item sm:col-span-4">
										<input
											id="subscription-suggestion"
											name="suggestion_text"
											class="input join-item bg-base-300 brightness-95 input-primary"
											placeholder="Subscription..."
											_="on keydown[key=='Enter'] send subscriptionSuggestionSelected then halt the event"
										/>
										<button
											type="button"
											class="btn join-item bg-base-100 brightness-95"
											aria-label="Show subscription suggestions"
										>
											@tableroutline.ChevronDown(templ.Attributes{"class": "transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180"})
										</button>
										<el-options
											popover
											anchor="bottom start"
											class="max-h-60 w-(--input-width) overflow-auto rounded-box bg-base-200 shadow-lg outline-1 outline-neutral/5 [--anchor-gap:--spacing(1)]"
										>
											<ul class="menu">
												for subscription := range slices.Values(request.SuggestedSubscriptions) {
													<li>
														<el-option value={ subscription.GetTitle() }>
															<input type="hidden" name={ "suggestions[" + subscription.GetID() + "]" } value={ subscription.GetTitle() }/>
															{ subscription.GetTitle() }
														</el-option>
													</li>
												}
											</ul>
										</el-options>
									</el-autocomplete>
									<button
										hx-post="/subscription/group/add"
										hx-target="#subscriptions"
										hx-encoding="application/x-www-form-urlencoded"
										hx-include="#suggestions,#subscriptions"
										hx-swap="beforeend"
										hx-trigger="click, subscriptionSuggestionSelected from:body"
										type="button"
										class="btn join-item btn-primary"
										_="on htmx:afterRequest set #subscription-suggestion.value to ''"
										aria-label="Add subscription to group"
									>
										@tableroutline.Plus(templ.Attributes{"aria-hidden": "true"})
									</button>
								</div>
							</label>
							<label class="fieldset">
								<span class="label">Existing Subscriptions</span>
								<div
									id="subscriptions"
									class="flex flex-wrap items-center gap-2"
								>
									for id, name := range request.Subscriptions {
										@AddSubscriptionToGroup(id, name)
									}
								</div>
							</label>
						</fieldset>
						// Categories.
						if request.Customisation != nil {
							@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
						} else {
							@CategoryManagement(request.SuggestedCategories, nil)
						}
						// Article Filters.
						@subscriptionArticleFiltersFields(request.ArticleFilters)
						<div class="mt-4 flex w-full justify-end gap-4">
							<button
								type="button"
								class="btn btn-secondary hover:btn-error"
								hx-get={ FromPathFromCtx(ctx) }
								hx-target={ ContentID.Target() }
								hx-swap="innerHTML transition:true"
								hx-push-url="true"
							>
								Back
							</button>
							<button type="submit" class="group btn btn-primary">
								<span class="hidden items-center group-[.htmx-request]:inline-flex">
									<span class="loading mr-3 loading-spinner"></span>
									<span class="text-sm/6">Processing</span>
								</span>
								<span class="inline-flex items-center group-[.htmx-request]:hidden">
									switch action {
										case "add":
											<span class="text-sm/6">Add</span>
										case "edit":
											<span class="text-sm/6">Save</span>
									}
								</span>
							</button>
						</div>
					</form>
				</div>
			}
		}
	}
}

// AddSubscriptionToGroup renders a button indicating a subscription is part of a group subscription. Clicking the
// button removes it from the group.
templ AddSubscriptionToGroup(id, name string) {
	<button
		class="btn btn-outline hover:btn-error"
		_="on click remove me"
		aria-label="Remove subscription from group"
	>
		<input type="hidden" name={ "subscriptions[" + id + "]" } value={ name }/>
		{ name }
		@tableroutline.X(templ.Attributes{"aria-hidden": "true"})
	</button>
}

templ EditEmailSubscription(request *models.EditEmailSubscriptionRequest) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				@pageHeading() {
					@pageTitle("Editing " + request.Customisation.GetNickname())
				}
				<form
					id="add-subscription"
					hx-post={ "/subscription/save/" + string(request.SubscriptionID) }
					hx-swap="none"
					hx-encoding="multipart/form-data"
					hx-disinherit="*"
					class="group"
				>
					// Add hidden inputs when editing a subscription to know which subscription we are editing.
					<input type="hidden" name={ models.ParamSubscriptionID } value={ string(request.SubscriptionID) }/>
					<input type="hidden" name="subscription_type" value={ string(models.SubscriptionTypeEmail) }/>
					<div class="space-y-12 sm:space-y-16">
						// Subscription name, suggestions and existing subscriptions.
						<div>
							@partials.FormSection() {
								@partials.FormField() {
									<label for="nickname" class="block font-medium text-base-content sm:pt-1.5">Nickname</label>
									<div class="mt-2 sm:col-span-2 sm:mt-0">
										<input
											id="nickname"
											type="text"
											name="customisation.nickname"
											if request.Customisation != nil && request.Customisation.GetNickname() != "" {
												value={ request.Customisation.GetNickname() }
											}
											placeholder="My cool subscription…"
											class="input bg-base-300 brightness-95 input-primary"
										/>
									</div>
								}
								@partials.FormField() {
									<label for="thumbnail" class="block font-medium text-base-content sm:pt-1.5">Thumbnail</label>
									<div class="mt-2 sm:col-span-2 sm:mt-0">
										<div class="col-span-full mt-2 flex items-center gap-x-2">
											if request.Customisation != nil && request.Customisation.ImageURL != nil {
												@subscriptionThumbnail(&models.RemoteImage{URL: request.Customisation.ImageURL}, "")
											} else {
												@subscriptionThumbnail(nil, "")
											}
											<input
												id="thumbnail"
												type="file"
												class="file-input flex bg-base-content/10 file-input-primary"
												name="customisation.thumbnail"
												accept=".jpg,.png,.webp"
											/>
										</div>
									</div>
								}
							}
						</div>
						// Subscription category management.
						if request.Customisation != nil {
							@CategoryManagement(request.SuggestedCategories, request.Customisation.GetCategories())
						} else {
							@CategoryManagement(request.SuggestedCategories, nil)
						}
					</div>
					<div class="mt-4 flex w-full justify-end gap-4">
						<button
							type="button"
							class="btn btn-secondary hover:btn-error"
							hx-get={ FromPathFromCtx(ctx) }
							hx-target={ ContentID.Target() }
							hx-swap="innerHTML transition:true"
							hx-push-url="true"
						>
							Back
						</button>
						<button type="submit" class="group btn btn-primary">
							<span class="hidden items-center group-[.htmx-request]:inline-flex">
								<span class="loading mr-3 loading-spinner"></span>
								<span class="text-sm/6">Processing</span>
							</span>
							<span class="inline-flex items-center group-[.htmx-request]:hidden">
								<span class="text-sm/6">Save</span>
							</span>
						</button>
					</div>
				</form>
			}
		}
	}
}

// RemoveObjectModal renders a modal that will action an unsubscribe request when the user has confirmed.
templ RemoveSubscriptionModal(request *models.RemoveSubscriptionRequest, options ...element.PropertiesOption) {
	{{
		id := request.SubscriptionID + "-unsubscribe-modal"
		props := element.NewProperties(options...)
	}}
	@partials.Modal(id, true) {
		<div class="sm:flex sm:items-start">
			<span class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tableroutline.AlertTriangle(templ.Attributes{"class": "size-12"})
			</span>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-lg font-medium">Unsubscribe confirmation</h3>
				<div class="mt-2">
					<p class="text-sm">Are you sure you want to unsubscribe from { request.Nickname }?</p>
				</div>
			</div>
		</div>
		<div class="mt-5 flex flex-row-reverse items-center justify-center gap-x-2 sm:mt-4">
			<form
				hx-post={ "/remove/subscription/" + string(request.SubscriptionID) }
				{ props.Attributes()... }
				class="flex"
				_="on htmx:afterRequest(successful) remove @open from  the closest <el-dialog/>"
			>
				<input type="hidden" name="nickname" value={ request.Nickname }/>
				<input type="hidden" name="confirmed" value="true"/>
				<button
					type="submit"
					class="btn btn-primary"
				>Unsubscribe</button>
			</form>
			<button
				type="button"
				command="close"
				commandfor={ id }
				class="btn btn-secondary hover:btn-error"
			>Cancel</button>
		</div>
	}
}

templ subscriptionThumbnail(img *models.RemoteImage, name string) {
	if img != nil {
		// If the source has an image, use that as the avatar.
		<div class="avatar" aria-hidden="true">
			// rs:auto:48:48 - resize to 48x48 https://docs.imgproxy.net/usage/processing#resize
			// sh:0.5 - sharpen https://docs.imgproxy.net/usage/processing#sharpen
			// q:80 - quality https://docs.imgproxy.net/usage/processing#quality
			// sm:1 - strip metadata
			// kcr:1 - keep copyright
			// scp:1 - convert color profile to sRGB
			@partials.NewProxiedImage(img, "rs:auto:48:48/q:80/sm:1/kcr:1/scp:1/ext:webp",
				element.WithAttribute("width", "48"),
				element.WithAttribute("height", "48"),
				element.WithClasses("mask mask-squircle size-12", "ring-1", "ring-neutral-content/25"),
			)
		</div>
	} else {
		// Otherwise, take the first letter of the subscription name and create a placeholder avatar.
		<div class="avatar avatar-placeholder" aria-hidden="true">
			<div class="mask w-12 bg-neutral mask-squircle text-neutral-content ring-1 ring-neutral-content/25">
				if name != "" {
					<span class="text-3xl font-serif capitalize">{ name[0:1] }</span>
				} else {
					<span class="text-3xl font-serif capitalize">S</span>
				}
			</div>
		</div>
	}
}

func subscriptionViewArticlesAttributes(s *models.Subscription) templ.Attributes {
	attrs := make(templ.Attributes)
	attrs["hx-target"] = ContentID.Target()
	attrs["hx-swap"] = "innerHTML show:top transition:true"
	attrs["hx-trigger"] = "click consume"
	attrs["hx-push-url"] = true
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed, models.SubscriptionTypeEmail:
		filters := models.NewListDisplayFilters()
		filters.Subscriptions = []string{s.GetID()}
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		values := filters.Values()
		values[models.ParamSubscriptionID] = s.GetID()
		attrs["hx-vals"], _ = templ.JSONString(values)
		attrs["hx-get"] = "/list/articles"
	case models.SubscriptionTypeGroup:
		filters := models.NewListDisplayFilters()
		filters.Subscriptions = s.GroupData.Subscriptions
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		values := filters.Values()
		values[models.ParamSubscriptionID] = s.GetID()
		attrs["hx-vals"], _ = templ.JSONString(values)
		attrs["hx-get"] = "/list/articles"
	case models.SubscriptionTypeSearch:
		attrs["hx-get"] = "/search"
		s.SearchData.Search.SubscriptionID = new(s.GetID())
		attrs["hx-vals"] = s.SearchData.Search.HXVals()
	}
	return attrs
}

func subscriptionViewArticlesLink(s *models.Subscription) string {
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed, models.SubscriptionTypeEmail:
		filters := models.NewListDisplayFilters()
		filters.Subscriptions = []string{s.GetID()}
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		return "/list/articles?" + filters.QueryParams().Encode()
	case models.SubscriptionTypeGroup:
		filters := models.NewListDisplayFilters()
		filters.Subscriptions = s.GroupData.Subscriptions
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		return "/list/articles?" + filters.QueryParams().Encode()
	case models.SubscriptionTypeSearch:
		s.SearchData.Search.SubscriptionID = new(s.GetID())
		return "/search?" + s.SearchData.Search.Query()
	}
	return "/list/articles"
}
