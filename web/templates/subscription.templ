// generateSubscriptionViewAttributes generates a templ.Attributes map containing the appropriate hx-* attributes for
// viewing the subscription, depending on its type.
func generateSubscriptionViewAttributes(s *models.Subscription) templ.Attributes {
	var (
		path string
		vals any
	)
	switch s.GetSubscriptionType() {
	case models.SubscriptionTypeFeed, models.SubscriptionTypeEmail:
		filters := models.NewListFilters()
		filters.Subscriptions = []string{s.GetID()}
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		filters.Subscriptions = []models.SubscriptionID{s.GetID()}
		vals = filters
		path = routeArticles.String()
	case models.SubscriptionTypeGroup:
		filters := models.NewListFilters()
		filters.Subscriptions = s.GroupData.GetGroupedSubscriptionIDs()
		if s.GetStats().IsUnread() {
			filters.View = models.ViewUnread
		} else {
			filters.View = models.ViewRead
		}
		filters.Subscriptions = []models.SubscriptionID{s.GetID()}
		vals = filters
		path = routeArticles.String()
	case models.SubscriptionTypeSearch:
		s.SearchData.Search.SubscriptionID = new(s.GetID())
		vals = s.SearchData.Search
		path = "/search"
	}
	return htmx.NewAttributes(
		htmx.WithHXMethod(http.MethodGet, path),
		htmx.WithHXTarget(ContentID.Target()),
		htmx.WithHXSwap("innerMorph show:top transition:true"),
		htmx.WithHXPushURL(path),
		htmx.WithHXTrigger("click consume"),
		htmx.WithHXVals(vals),
	).GetAttributes()
}

templ subscriptionCategoryBadges(subscription *models.Subscription) {
	{{ categoryLimit := 10 }}
	{{ categories := subscription.GetCategories(categoryLimit) }}
	// Category Badges (up to 10).
	if len(categories) > 0 {
		<div class="mb-2.5 flex flex-wrap gap-1.5 self-start">
			for idx, category := range categories {
				{{
					filters := models.NewListFilters()
					filters.Category = &category
					var extraClasses string
					// Only show the first three categories, hide all others behind a button toggle.
					if idx >= 3 {
						extraClasses = "hidden"
					}
				}}
				@CategoryBadge(category,
					element.WithHXMethod(http.MethodGet, "/subscriptions"),
					element.WithHXTarget(ContentID.Target()),
					element.WithHXValues(filters),
					element.WithClasses(extraClasses),
					element.WithHXTrigger("click consume"),
				)
			}
			// Add a button to reveal all categories when clicked.
			if len(categories) > 3 {
				<button
					class="toggle-categories-btn badge items-center badge-outline badge-neutral hover:bg-secondary hover:text-secondary-content"
					_="
					on click
					  halt the event's bubbling
          			  set :tags to <span/> in the closest parent <div/> where it matches .category-badge
					  for tag in :tags
					   remove .hidden from tag
					  end
					  remove me
					end
					"
				>
					{ fmt.Sprintf("+ %d more",len(categories)-3) }
				</button>
			}
		</div>
	}
}

// thumbnail generates a thumbnail image. If the image URL is given, it uses that image. Else, it will use a placeholder
// constructed from the first letter of the alt text.
templ thumbnail(imgURL, altText string) {
	<div class="relative flex-none">
		if imgURL != "" {
			{{ img := models.NewRemoteImage(imgURL, altText) }}
			// If the source has an image, use that as the avatar.
			<span class="avatar" aria-hidden="true">
				// rs:auto:48:48 - resize to 48x48 https://docs.imgproxy.net/usage/processing#resize
				// sh:0.5 - sharpen https://docs.imgproxy.net/usage/processing#sharpen
				// q:80 - quality https://docs.imgproxy.net/usage/processing#quality
				// sm:1 - strip metadata
				// kcr:1 - keep copyright
				// scp:1 - convert color profile to sRGB
				@partials.NewProxiedImage(img, "rs:auto:48:48/q:80/sm:1/kcr:1/scp:1/ext:webp",
					element.WithAttribute("width", "48"),
					element.WithAttribute("height", "48"),
					element.WithClasses("mask mask-squircle size-12", "ring-1", "ring-neutral-content/25"),
				)
			</span>
		} else {
			// Otherwise, take the first letter of the subscription name and create a placeholder avatar.
			<span class="avatar avatar-placeholder" aria-hidden="true">
				<div class="mask w-12 accent-hue-rotate mask-squircle font-serif text-lg font-semibold ring-1 ring-neutral-content/25">
					{ initialLetter(altText) }
				</div>
			</span>
		}
	</div>
}
