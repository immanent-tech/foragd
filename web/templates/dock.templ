package templates

import (
	"github.com/dimmerz92/go-icons/tabler-filled"
	tableroutline "github.com/dimmerz92/go-icons/tabler-outline"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/element"
	"strings"
)

templ Dock(options ...element.PropertiesOption) {
	{{ pageURL := PathFromCtx(ctx) }}
	{{ props := element.NewProperties(options...) }}
	<footer
		aria-label="Footer Navigation"
		id="page-dock"
		class="dock border-t border-neutral/20 bg-base-200 px-safe text-base-content shadow-sm lg:hidden"
		{ props.Attributes()... }
	>
		<a
			hx-get="/home"
			hx-trigger="click,globalShortcutHome"
			hx-target={ ContentID.Target() }
			hx-swap="morph:innerHTML show:top transition:true"
			hx-sync="#page-dock:drop"
			class={ "group", templ.KV("rounded-lg bg-primary/25", strings.HasPrefix(pageURL, "/home")) }
		>
			<span class="sr-only">Go to Home Page</span>
			<span class="hidden items-center group-[.htmx-request]:inline-flex">
				<span class="loading loading-md loading-spinner text-base-content"></span>
			</span>
			<span class="inline-flex items-center group-[.htmx-request]:hidden">
				@tablerfilled.Home(templ.Attributes{
					"class":       "size-6 shrink-0 fill-base-content transition-transform duration-150 ease-in-out group-hover:scale-[1.05] group-active:scale-[0.9]",
					"aria-hidden": "true"})
			</span>
			<span class="dock-label not-sr-only">Home</span>
		</a>
		{{ filters := models.NewListFilters() }}
		<a
			hx-get="/list/subscriptions"
			hx-target={ ContentID.Target() }
			hx-vals={ templ.JSONString(filters) }
			hx-params="not subscriptions"
			hx-swap="morph:innerHTML show:top transition:true"
			hx-sync="#page-dock:drop"
			class={ "group", templ.KV("rounded-lg bg-primary/25", strings.HasPrefix(pageURL, "/list/subscriptions")) }
		>
			<span class="sr-only">Go to Subscriptions</span>
			<span class="hidden items-center group-[.htmx-request]:inline-flex">
				<span class="loading loading-md loading-spinner text-base-content"></span>
			</span>
			<span class="inline-flex items-center group-[.htmx-request]:hidden">
				@tableroutline.Rss(templ.Attributes{
					"class":       "size-6 shrink-0 text-base-content transition-transform duration-150 ease-in-out group-hover:scale-[1.05] group-active:scale-[0.9]",
					"aria-hidden": "true"})
			</span>
			<span class="dock-label not-sr-only">Subscriptions</span>
		</a>
		<a
			hx-get="/list/articles"
			hx-target={ ContentID.Target() }
			hx-vals={ templ.JSONString(filters) }
			hx-swap="morph:innerHTML show:top transition:true"
			hx-sync="#page-dock:drop"
			class={ "group", templ.KV("bg-primary/10 rounded-lg", strings.HasPrefix(pageURL, "/list/articles")),
			templ.KV("rounded-lg bg-primary/25", strings.HasPrefix(pageURL, "/view/article")) }
			if strings.HasPrefix(pageURL, "/view/article") {
				hx-include="[name='subscriptions']"
			}
		>
			<span class="sr-only">Go to Articles</span>
			<span class="hidden items-center group-[.htmx-request]:inline-flex">
				<span class="loading loading-md loading-spinner text-base-content"></span>
			</span>
			<span class="inline-flex items-center group-[.htmx-request]:hidden">
				@tablerfilled.FileRss(templ.Attributes{
					"class":       "size-6 shrink-0 fill-base-content transition-transform duration-150 ease-in-out group-hover:scale-[1.05] group-active:scale-[0.9]",
					"aria-hidden": "true"})
			</span>
			<span class="dock-label not-sr-only">Articles</span>
		</a>
		<a
			hx-get="/list/favorites"
			hx-target={ ContentID.Target() }
			hx-swap="morph:innerHTML show:top transition:true"
			hx-sync="#page-dock:drop"
			class={ "group", templ.KV("rounded-lg bg-primary/25", strings.HasPrefix(pageURL, "/list/favorites")) }
		>
			<span class="sr-only">Go to Favorites</span>
			<span class="hidden items-center group-[.htmx-request]:inline-flex">
				<span class="loading loading-md loading-spinner text-base-content"></span>
			</span>
			<span class="inline-flex items-center group-[.htmx-request]:hidden">
				@tablerfilled.Heart(templ.Attributes{
					"class":       "size-6 shrink-0 fill-base-content transition-transform duration-150 ease-in-out group-hover:scale-[1.05] group-active:scale-[0.9]",
					"aria-hidden": "true"})
			</span>
			<span class="dock-label not-sr-only">Favorites</span>
		</a>
		<a
			hx-get="/subscription/add"
			hx-target={ ContentID.Target() }
			hx-swap="morph:innerHTML show:top transition:true"
			hx-sync="#page-dock:drop"
			class={ "group", templ.KV("rounded-lg bg-primary/25", strings.HasPrefix(pageURL, "/subscription/add")) }
		>
			<span class="sr-only">Add a Subscription</span>
			<span class="hidden items-center group-[.htmx-request]:inline-flex">
				<span class="loading loading-md loading-spinner text-base-content"></span>
			</span>
			<span class="inline-flex items-center group-[.htmx-request]:hidden">
				@tableroutline.Plus(templ.Attributes{
					"class":       "size-6 shrink-0 text-base-content transition-transform duration-150 ease-in-out group-hover:scale-[1.05] group-active:scale-[0.9]",
					"aria-hidden": "true"})
			</span>
			<span class="dock-label not-sr-only">Add</span>
		</a>
	</footer>
}
