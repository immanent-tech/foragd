package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"strings"
)

templ Dock(attributes templ.Attributes) {
	{{ pageURL := models.PathFromCtx(ctx) }}
	<footer aria-label="Footer Navigation" id="page-dock" class="dock bg-base-200 border-t border-base-content/10 lg:hidden text-primary" { attributes... }>
		<button
			hx-get="/home"
			hx-trigger="click,globalShortcutHome"
			hx-target={ ContentID.Target() }
			hx-swap="innerHTML show:window:top transition:true"
			class={ templ.KV("dock-active", strings.HasPrefix(pageURL, "/home")) }
			_="on keydown from body if the event's key is 'h' and event.altKey then send globalShortcutHome"
		>
			<span class="sr-only">Go to Home Page</span>
			@tabler.HomeFilled(i.Props{Class: "size-6 text-primary"})
			<span class="dock-label">Home</span>
		</button>
		<button
			hx-get="/list/subscriptions"
			hx-target={ ContentID.Target() }
			hx-vals={ templ.JSONString(models.PageFiltersFromCtx(ctx, "/list/subscriptions").Values()) }
			hx-params={ "not " + models.ParamSubscriptions }
			hx-swap="innerHTML show:window:top transition:true"
			class={ templ.KV("dock-active", strings.HasPrefix(pageURL, "/list/subscriptions")) }
		>
			@tabler.Rss(i.Props{Class: "size-6 text-primary"})
			<span class="sr-only">Go to Subscriptions</span>
			<span class="dock-label">Subscriptions</span>
		</button>
		{{ filters := models.NewListDisplayFilters() }}
		<button
			hx-get="/list/articles"
			hx-target={ ContentID.Target() }
			hx-vals={ templ.JSONString(filters.Values()) }
			hx-swap="innerHTML show:window:top transition:true"
			class={ templ.KV("dock-active", strings.HasPrefix(pageURL, "/list/articles")) }
			if strings.HasPrefix(pageURL, "/view/article") {
				hx-include="[name='subscriptions']"
			}
		>
			@tabler.FileRssFilled(i.Props{Class: "size-6 text-primary"})
			<span class="sr-only">Go to Articles</span>
			<span class="dock-label">Articles</span>
		</button>
		<button
			hx-get="/list/favorites"
			hx-target={ ContentID.Target() }
			hx-swap="innerHTML show:window:top transition:true"
			class={ templ.KV("dock-active", strings.HasPrefix(pageURL, "/list/favorites")) }
		>
			@tabler.HeartFilled(i.Props{Class: "size-6 text-primary"})
			<span class="sr-only">Go to Favorites</span>
			<span class="dock-label">Favorites</span>
		</button>
	</footer>
}
