	"time"
)

// favoriteToggle renders a button toggle for toggling the favorite status of an article.
templ (a *Article) favoriteToggle() {
	<div class="tooltip" data-tip="Toggle favorite">
		<label
			class="btn btn-square btn-ghost btn-sm swap"
			{ a.favoriteAttributes()... }
			_="
		on htmx:afterRequest(successful) halt the event's bubbling end
    	on htmx:afterRequest(failed) toggle @checked on <input /> in me end
		"
		>
			<input
				type="checkbox"
				if a.IsFavorite() {
					checked
				}
				_="on click halt the event's bubbling"
				aria-label={ "Toggle favorite status for " + a.GetTitle() }
			/>
			@tablerfilled.Heart(templ.Attributes{"class": "swap-on size-5 text-primary"})
			@tableroutline.Heart(templ.Attributes{"class": "swap-off size-5 text-primary"})
		</label>
	</div>
}

// markToggle renders a button toggle for toggling the read status of an article.
templ (a *Article) markToggle() {
	{{
		var mark models.Mark
		if a.IsUnread() {
			mark = models.MarkRead
		} else {
			mark = models.MarkUnread
		}
	}}
	<div class="tooltip" data-tip="Toggle read status">
		<label
			id={ a.GetID() + "-mark-toggle" }
			class="btn btn-square btn-ghost btn-sm swap"
			_="
			  on htmx:afterRequest
			  	if event.detail.successful
					halt the event's bubbling
					if closest .card exists
			  			toggle .brightness-90 on closest .card
					end
					set :mark to the first <input/> in me
					if :mark.value is 'read'
						set :mark.value to 'unread'
					else if :mark.value is 'unread'
						set :mark.value to 'read'
					end
				else
    			  toggle @checked on next <input[type='checkbox']/> in me
				end
				"
			{ a.markAttributes(service.ListFiltersFromCtx(ctx).View)... }
		>
			<input
				id={ a.markValueID().String() }
				type="hidden"
				name="mark"
				value={ string(mark) }
			/>
			<input
				type="checkbox"
				_="on click halt the event's bubbling"
				if a.IsUnread() {
					checked
				}
				aria-label={ "Toggle mark status for " + a.GetTitle() }
			/>
			@tablerfilled.MailOpened(templ.Attributes{"class": "swap-on size-5 text-primary"})
			@tableroutline.Mail(templ.Attributes{"class": "swap-off size-5 text-primary"})
		</label>
	</div>
}

// shareAction renders a button for prompting to share an article.
templ (a *Article) shareButton() {
	// Mobile share action via navigator API.
	<a
		class="border border-neutral/15 hidden text-sm rounded-field"
		data-title={ a.GetTitle() }
		data-url={ a.GetLink() }
		_="init if navigator.share remove .hidden from me end
		   on click
		   js(me)
		      navigator.share({ title: me.dataset.title, url: me.dataset.url })
		   end"
	>
		@tableroutline.Share(templ.Attributes{"class": "stroke-1 mr-3", "aria-hidden": "true"})
		<span class="text-sm/6">Share</span>
	</a>
	// Desktop share action with modal and options.
	<a
		class="border border-neutral/15 hidden text-sm rounded-field"
		_="init if not navigator.share remove .hidden from me"
		{ a.desktopShareAttributes()... }
	>
		@tableroutline.Share(templ.Attributes{"class": "stroke-1 mr-3", "aria-hidden": "true"})
		<span class="text-sm/6">Share</span>
	</a>
}

// viewOriginalButton shows a button to go to the original article.
templ (a *Article) viewOriginalButton() {
	<a
		role="button"
		class="border border-neutral/15 text-sm rounded-field"
		href={ a.GetLink() }
		target="_blank"
		rel="noopener"
		_="on click halt the event's bubbling"
	>
		@tableroutline.ExternalLink(templ.Attributes{"class": "stroke-1 mr-3", "aria-hidden": "true"})
		<span class="text-sm/6">View Remote</span>
	</a>
}

// showRemoteContentButton renders a button to show the remote content.
templ (a *Article) showRemoteContentButton() {
	<a
		id="show-remote-content-button"
		class="border border-neutral/15 text-sm rounded-field"
		_="
	    on htmx:beforeRequest from me
	      add .in-flight-request to me
    	  set my.disabled to true
    	on htmx:afterRequest from me
      		remove .in-flight-request from me
      		set my.disabled to false
		on htmx:afterRequest(failed) add @disabled to me
		"
		{ a.showContentAttributes(true)... }
	>
		<span class="show-loading items-center">
			<span class="loading mr-3 loading-spinner"></span>
			Loading
		</span>
		<span class="hide-loading">
			@tableroutline.Download(templ.Attributes{"class": "stroke-1 mr-3", "aria-hidden": "true"})
			<span class="text-sm/6">Get Remote Content</span>
		</span>
	</a>
}

// showFeedContentButton renders a button to show the feed content.
templ (a *Article) showFeedContentButton() {
	<a
		id="show-feed-content-button"
		class="border border-neutral/15 text-sm rounded-field"
		_="
	    on htmx:beforeRequest from me
	      add .in-flight-request to me
    	  set my.disabled to true
    	on htmx:afterRequest from me
      		remove .in-flight-request from me
      		set my.disabled to false
		"
		{ a.showContentAttributes(false)... }
	>
		<span class="show-loading items-center">
			<span class="loading mr-3 loading-xs loading-spinner"></span>
			Loading
		</span>
		<span class="hide-loading">
			@tableroutline.FileRss(templ.Attributes{"class": "stroke-1 mr-3", "aria-hidden": "true"})
			<span class="text-sm/6">Show Feed Content</span>
		</span>
	</a>
}

// actionsMenu renders a menu containing article-specific actions.
templ (a *Article) actionsMenu() {
	<div class="tooltip overflow-visible" data-tip="Article actions">
		<el-dropdown class="relative ml-auto touch-manipulation" _="on click halt the event's bubbling">
			<button id={ a.GetID() + "-actions-menu" } class="btn btn-square btn-ghost btn-sm">
				<span class="sr-only">{ a.GetTitle() + " Actions" }</span>
				@tableroutline.Menu2(templ.Attributes{"class": "size-5 text-primary", "aria-hidden": "true"})
			</button>
			@partials.Menu(element.WithAttribute("aria-labelledby", a.GetID()+"-actions-menu")) {
				// View original article action.
				@partials.MenuItem() {
					<a { a.viewOriginalAttributes()... }>
						@tableroutline.ExternalLink(templ.Attributes{"class": "stroke-1 size-4", "aria-hidden": "true"})
						Go To Article
					</a>
				}
				// Find similar action.
				@partials.MenuItem() {
					<a { a.findSimilarAttributes()... }>
						@tableroutline.Search(templ.Attributes{"class": "stroke-1 size-4", "aria-hidden": "true"})
						Find similar...
					</a>
				}
				// Mobile share action via navigator API.
				@partials.MenuItem(element.WithAttribute("_", "init if not navigator.share then hide me")) {
					<a
						data-title={ a.GetTitle() }
						data-url={ a.GetLink() }
						_="init if navigator.share remove .hidden from me end
						   on click
		   					js(me)
		      					navigator.share({ title: me.dataset.title, url: me.dataset.url })
		   					end
							"
					>
						@tableroutline.Share(templ.Attributes{"class": "stroke-1 size-4", "aria-hidden": "true"})
						Share
					</a>
				}
				// Desktop share action with modal and options.
				@partials.MenuItem(element.WithAttribute("_", "init if navigator.share then hide me")) {
					<a { a.desktopShareAttributes()... }>
						@tableroutline.Share(templ.Attributes{"class": "stroke-1 size-4", "aria-hidden": "true"})
						Share
					</a>
				}
				// Report issue action.
				@partials.MenuItem() {
					<a { a.reportIssueAttributes()... }>
						@tableroutline.Flag2(templ.Attributes{"class": "stroke-1 size-4", "aria-hidden": "true"})
						Report an issue
					</a>
				}
			}
		</el-dropdown>
	</div>
}

// Card renders an article as a card, for displaying in a list.
templ ArticleCard(idx int, a *models.Article) {
	{{ article := &Article{Article: a} }}
	@partials.Card(element.WithAttribute("id", article.GetID()),
		element.WithAttribute("style", "--i: "+strconv.Itoa(idx)),
		element.WithAttribute("hx-disinherit", "*"),
		element.WithClasses(
			"group", "animate-fadeinup", "self-start", "cursor-pointer", "touch-manipulation", "masonry-item"),
		element.WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()),
		element.WithHXTarget(ContentID.Target()),
		element.WithHXSwap("innerHTML show:window:top transition:true"),
		element.WithHXTrigger("click"),
		element.WithHXPushURL(true),
	) {
		// Hidden inputs used for some group article actions.
		<input type="hidden" name={ "displayed_articles[" + article.GetSubscriptionID() + "]" } value={ article.GetID() }/>
		<div>
			if img := article.GetImage(); img != nil {
				{{ img := article.GetImage() }}
				if img.GetTitle() == "" {
					{{ img.Title = new(article.GetTitle()) }}
				}
				// Article Main Image.
				<figure class="relative overflow-hidden rounded-t-[inherit]">
					{{
						var loadingAttrKey, loadingAttrValue string
						if idx < 3 {
							loadingAttrKey = "fetchpriority"
							loadingAttrValue = "high"
						} else {
							loadingAttrKey = "loading"
							loadingAttrValue = "lazy"
						}
					}}
					//  rounded-t-[inherit] transition-transform duration-400 ease-in-out group-hover:scale-[1.04]">
					@partials.NewProxiedImage(img, "rs:auto:400:300/sh:0.5/q:80/el:1/ex:1/gravity:sm/sm:1/kcr:1/scp:1/ext:webp",
						element.WithAttribute("width", "400"),
						element.WithAttribute("height", "300"),
						element.WithAttribute(loadingAttrKey, loadingAttrValue),
						element.WithClasses("w-full", "aspect-[4/3]", "object-cover", "transition-transform", "duration-400", "ease-in-out", "group-hover:scale-[1.04]"),
					)
					<div class="pointer-events-none absolute inset-0 rounded-t-[inherit] shadow-[inset_0_-2px_8px_rgba(0,0,0,0.12)]"></div>
					// Overlay the feed name on the image.
					<div class="absolute top-2.5 left-2.5">
						<span class="badge badge-neutral badge-soft badge-sm font-medium backdrop-blur-sm">{ article.Item.FeedTitle }</span>
					</div>
				</figure>
			} else {
				// Show the feed name at the top left.
				<span class="mt-2.5 ml-2.5 badge badge-ghost badge-sm font-medium">{ article.Item.FeedTitle }</span>
			}
		</div>
		{{
			var bodyClasses string
			if img := article.GetImage(); img != nil {
				bodyClasses = "flex-1"
			}
		}}
		@partials.CardBody(element.WithClasses(bodyClasses)) {
			{{ categoryLimit := 10 }}
			// Category Badges (up to 10).
			if len(article.GetCategories(categoryLimit)) > 0 {
				<div class="mb-2.5 flex flex-wrap gap-1.5 self-start">
					for idx, category := range article.GetCategories(categoryLimit) {
						{{
							filters := models.NewListDisplayFilters()
							filters.Categories = append(filters.Categories, category)
							var extraClasses string
							// Only show the first three categories, hide all others behind a button toggle.
							if idx >= 3 {
								extraClasses = "hidden"
							}
						}}
						@CategoryBadge(category,
							element.WithHXMethod(http.MethodGet, "/list/articles"),
							element.WithHXTarget(ContentID.Target()),
							element.WithHXValues(filters.Values()),
							element.WithClasses(extraClasses),
							element.WithAttribute("_", "on click halt the event's bubbling"),
						)
					}
					// Add a button to reveal all categories when clicked.
					if len(article.GetCategories(categoryLimit)) > 3 {
						<button
							class="toggle-categories-btn btn btn-outline btn-xs"
							_="
							on click
							  halt the event's bubbling
          					  set :tags to <span/> in the closest parent <div/> where it matches .category-badge
							  for tag in :tags
							   remove .hidden from tag
							  end
							  remove me
							end
							"
						>
							{ fmt.Sprintf("+ %d more",len(article.GetCategories(categoryLimit))-3) }
						</button>
					}
				</div>
			}
			// Article Title.
			<h3 class="mb-2 line-clamp-2 font-serif text-base leading-tight font-bold text-balance transition-colors group-hover:text-primary">
				if article.GetTitle() != "" {
					{ article.GetTitle() }
				} else {
					(no title)
				}
			</h3>
			// Article Summary (if any).
			if content := article.GetContent(); content != "" {
				<div class={ "prose-summary mb-3", templ.KV("line-clamp-3",article.GetImage() != nil),templ.KV("line-clamp-6",article.GetImage() == nil) }>
					@templ.Raw(content)
				</div>
			}
		}
		@partials.CardFooter(element.WithClasses("items-center")) {
			<div class="flex items-center justify-between border-t border-neutral/20 pt-3">
				<div class="flex-separated flex min-w-0 items-center">
					if len(article.GetAuthors()) > 0 {
						{{
							authors := make([]string, 0)
							for author := range slices.Values(article.GetAuthors()) {
								authors = append(authors, author.String())
							}
						}}
						<div class="truncate text-xs/4">
							{ strings.Join(authors,",") }
						</div>
					}
					<relative-time
						datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
						format="relative"
						class="shrink-0 text-xs/4 text-neutral capitalize tabular-nums"
					>
						{ article.GetUpdatedDate().Format("Jan _2, 2006") }
					</relative-time>
				</div>
				<div class="flex shrink-0 items-center">
					// Toggle favorite action.
					@article.favoriteToggle()
					// Toggle mark action.
					@article.markToggle()
					// Separator.
					<div aria-hidden="true" class="h-4 w-px bg-neutral/20 mx-1"></div>
					// Actions menu.
					@article.actionsMenu()
				</div>
			</div>
		}
	}
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(a *models.Article) {
	{{ article := &Article{Article: a} }}
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container() {
				// Add the subscription ID as a hidden input that htmx can use for actions.
				<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
				<article id={ article.GetID() } class="w-full sm:mx-auto sm:max-w-prose">
					// Show a subtle reading progress bar across the top of the article.
					@partials.ReadingProgress()
					// Subscription and timestamp.
					<div class="my-4 flex items-center font-display text-sm/6 text-neutral">
						{{ filters := session.GetListArticleFiltersFromSession(ctx) }}
						<a
							hx-get="/list/articles"
							hx-target={ ContentID.Target() }
							hx-swap="innerHTML show:window:top transition:true"
							hx-vals={ templ.JSONString(map[string]any{
									"view": filters.GetView(),
									"count": filters.GetCount(),
									"sort": filters.GetSort(),
									"subscriptions": article.GetSubscriptionID(),
									"subscription_name": article.GetFeedTitle(),
									"subscription_id": article.GetSubscriptionID(),
								}) }
							class="flex link link-hover"
						>
							{  article.GetFeedTitle() }
						</a>
						<span class="flex-none px-4">·</span>
						<span class="flex-none capitalize">
							<relative-time
								datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
								format="relative"
								class="tabular-nums"
							>
								{ article.GetUpdatedDate().Format("Jan _2, 2006") }
							</relative-time>
						</span>
					</div>
					// Categories.
					if len(article.GetCategories(0)) > 0 {
						<div class="mb-4 flex flex-row flex-wrap gap-2 self-start">
							for category := range slices.Values(article.GetCategories(5)) {
								{{
									filters := models.NewListDisplayFilters()
									filters.Categories = append(filters.Categories, category)
								}}
								@CategoryBadge(category,
									element.WithHXMethod(http.MethodGet, "/list/articles"),
									element.WithHXTarget(ContentID.Target()),
									element.WithHXValues(filters.Values()),
									element.WithHXParams("not subscription_id"),
									element.WithAttribute("_", "on click halt the event's bubbling"),
								)
							}
						</div>
					}
					// Article title.
					<div class="flex flex-1 pb-2">
						if article.SourceType != models.SourceTypeEmail {
							<a
								href={ article.GetLink() }
								target="_blank"
								rel="noopener"
								class="link link-hover focus:text-primary focus:outline-hidden"
							>
								<h1 class="mt-4 mb-2 scroll-mt-16 font-serif text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
							</a>
						} else {
							<h1 class="mt-4 mb-2 scroll-mt-16 font-serif text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
						}
					</div>
					// Byline and actions.
					<div class="grid grid-cols-2 items-center justify-between border-b border-neutral/20 p-1">
						<div class="flex items-center">
							if article.SourceType != models.SourceTypeEmail {
								// Show authors if found.
								if len(article.GetAuthors()) > 0 {
									{{
										authors := make([]string, 0)
										for author := range slices.Values(article.GetAuthors()) {
											authors = append(authors, author.String())
										}
									}}
									<strong class="truncate text-sm/6">
										{ strings.Join(authors,",") }
									</strong>
								}
							}
						</div>
						// Actions.
						<div class="col-start-2 ml-auto flex shrink-0 items-center">
							// Toggle favorite action.
							@article.favoriteToggle()
							// Toggle mark action.
							@article.markToggle()
							// Actions menu.
							@article.actionsMenu()
						</div>
					</div>
					// Show reading time if content length is greater than around two paragraphs of text...
					if text.CountWords(article.GetContent()) > 160 {
						<div class="ml-auto flex flex-1 justify-end p-1">
							<span class="text-sm/6 text-neutral">
								Reading time:
								{ strings.ReplaceAll(text.ReadingTime(string(article.GetContent())).Round(time.Minute).String(),"0s","") }
							</span>
						</div>
					}
					// Content.
					switch  {
						case article.IsEmail():
							// Article from email newsletter.
							<div
								class="prose-email mt-4"
								data-disable-scripting
								hx-disable
							>
								@templ.Raw(article.GetContent())
							</div>
						case article.IsYoutubeVideo():
							// Youtube video.
							if youtubeData, err := article.AsYoutubeVideo(); err == nil {
								<div class="relative aspect-video h-auto max-w-full overflow-hidden p-8">
									<embed-youtube
										video-id={ youtubeData.VideoId }
										width={ *youtubeData.Width }
										height={ *youtubeData.Height }
										origin={ config.GetBaseURL() }
										credentialless
									></embed-youtube>
								</div>
							}
							if article.GetDescription() != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4"
								>
									@templ.Raw(article.GetDescription())
								</div>
							}
							<ul class="mt-8 menu menu-vertical sm:menu-horizontal w-full justify-center items-center gap-2">
								<li>
									@article.shareButton()
								</li>
							</ul>
						default:
							// Try to display content or description.
							if content := article.GetContent(); content != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4 px-2"
								>
									@templ.Raw(content)
								</div>
							}
							<div class="mt-8 w-full border-t border-neutral/20"></div>
							<ul class="mt-8 menu menu-vertical sm:menu-horizontal w-full justify-center items-center gap-2">
								// Show a toggle for fetching full content where it appears the feed content is only a summary
								if !article.IsRemoteContent() {
									<li>
										@article.showRemoteContentButton()
									</li>
								} else {
									<li>
										@article.showFeedContentButton()
									</li>
								}
								// View original article action.
								<li>
									@article.viewOriginalButton()
								</li>
								// Share article.
								<li>
									@article.shareButton()
								</li>
							</ul>
					}
				</article>
				<div class="p-4">
					@buttonBackToTop()
					// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is
					// read and mark it so (when the user has set this option).
					if article.IsUnread() && article.MarkArticleReadOnView {
						<div
							id="auto-mark-read"
							hx-target="#auto-mark-read"
							hx-post={ "/mark/article/" + article.GetID() }
							hx-swap="delete transition:false"
							hx-vals={ templ.JSONString(map[string]any{
							"subscription_id": article.GetSubscriptionID(),
							"item_id": article.GetID(),
							"mark": models.MarkRead,
						}) }
							hx-trigger="intersect once delay:5s,load delay:5s"
							aria-hidden="true"
							_={ "on htmx:afterRequest(successful) toggle @checked on <input[type='checkbox']/> in #" + article.GetID() + "-mark-toggle" }
						></div>
					}
				</div>
			}
		}
	}
}

// ListArticles renders the list of articles in a grid layout with filtering controls and an actions menu.
templ ListArticles(response *models.ListArticlesResponse) {
	{{ controls := &listControls{path: "/list/articles", filters: response.Filters} }}
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				// Show a page header.
				@pageHeading() {
					{{ var title string }}
					if response.Subscription != nil {
						{{ title = response.Subscription.GetTitle() }}
					} else {
						{{ title = "Articles" }}
					}
					@pageTitle(title)
					@pageActions(element.WithClasses("justify-between")) {
						@controls.viewFilters()
						@controls.sortOptions()
					}
				}
				// List actions.
				if len(response.Articles) > 0 {
					<ul
						id="list-actions"
						class="menu menu-horizontal w-full flex justify-end"
						if response.Subscription != nil {
							hx-vals={ templ.JSONString(map[string]string{models.ParamSubscriptionID: response.Subscription.GetID()}) }
						}
					>
						// For viewing articles from multiple subscriptions, show a mark button that marks the displayed articles.
						if response.Subscription == nil {
							{{
								var mark models.Mark
								if response.Filters.GetView() == models.ViewUnread {
									mark = models.MarkRead
								} else {
									mark = models.MarkUnread
								}
							}}
							<li>
								<a
									if response.Filters.GetView() == models.ViewUnread {
										hx-post="/list/articles/mark/read"
									} else {
										hx-post="/list/articles/mark/unread"
									}
									hx-target={ ContentID.Target() }
									hx-include=".card > input"
									hx-vals={ templ.JSONString(map[string]string{"mark": string(mark)}) }
									class="rounded-field border border-neutral/15 text-sm"
								>
									if response.Filters.GetView() == models.ViewUnread {
										@tablerfilled.MailOpened(templ.Attributes{"class": "size-5", "aria-hidden": "true"})
										Mark shown read
									} else {
										@tablerfilled.Mail(templ.Attributes{"class": "size-5", "aria-hidden": "true"})
										Mark shown unread
									}
								</a>
							</li>
						} else {
							// For viewing articles from a single subscription, show a mark read/unread action when not viewing all articles.
							if response.Filters.GetView() != models.ViewAll {
								{{
									var mark models.Mark
									if response.Filters.GetView() == models.ViewUnread {
										mark = models.MarkRead
									} else {
										mark = models.MarkUnread
									}
								}}
								<li>
									<a
										hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
										hx-vals={ templ.JSONString(map[string]string{
														"mark": string(mark),
														"subscription_id": response.Subscription.GetID(),
														"view": string(response.Filters.GetView()),
														}) }
										class="rounded-field border border-neutral/15 text-sm"
									>
										if response.Filters.GetView() == models.ViewUnread {
											@tablerfilled.MailOpened(templ.Attributes{"class": "size-5", "aria-hidden": "true"})
											Mark all read
										} else {
											@tablerfilled.Mail(templ.Attributes{"class": "size-5", "aria-hidden": "true"})
											Mark all unread
										}
									</a>
								</li>
							}
						}
					</ul>
				}
				<section id="articles-list" class="pt-4">
					if len(response.Articles) > 0 {
						@masonryGrid()
						@grid(element.WithClasses("masonry-grid", "relative"),
							element.WithAttribute("_", "install MasonryGrid")) {
							@templ.Fragment(PaginateFragment) {
								for idx, article := range response.Articles {
									@ArticleCard(idx, article)
								}
							}
						}
						@ListPaginationControl("/list/articles/paginate", &response.Filters, response.Pagination)
						<div id="loading-items" class="mt-4 flex w-full mx-auto justify-center">
							<div class="show-loading text-center">
								<span class="loading mr-3 loading-xl loading-bars"></span>
								<p class="text-lg/loose font-semibold">Loading content...</p>
							</div>
						</div>
						// Show some actions at the bottom of the list.
						<ul class="mt-8 menu menu-vertical sm:menu-horizontal w-full justify-center items-center gap-2">
							// Mark all subscriptions action.
							if response.Subscription == nil {
								// Mark all articles action.
								<li>
									<a
										class="rounded-field border border-neutral/15 text-sm"
										if response.Filters.GetView() == models.ViewUnread {
											hx-post="/list/articles/mark/read"
											hx-vals={ templ.JSONString(map[string]any{
														"mark": models.MarkRead,
													}) }
										} else {
											hx-post="/list/articles/mark/unread"
											hx-vals={ templ.JSONString(map[string]any{
														"mark": models.MarkUnread,
													}) }
										}
										hx-target={ ContentID.Target() }
										hx-include="article > input"
									>
										<span class="show-loading items-center">
											<span class="loading mr-3 loading-spinner"></span>
											<span class="text-sm/6">Loading</span>
										</span>
										<span class="hide-loading items-center">
											if response.Filters.GetView() == models.ViewUnread {
												@tablerfilled.MailOpened(templ.Attributes{"class": "stroke-1 mr-3 size-5", "aria-hidden": "true"})
												<span class="text-sm/6">Mark Articles Read</span>
											} else {
												@tablerfilled.Mail(templ.Attributes{"class": "stroke-1 mr-3 size-5", "aria-hidden": "true"})
												<span class="text-sm/6">Mark Articles Unread</span>
											}
										</span>
									</a>
								</li>
							} else {
								// Show mark read/unread action when not viewing all articles.
								if response.Filters.GetView() != models.ViewAll {
									// Mark subscription action.
									{{
										values := make(map[string]any)
										values["subscription_id"] = response.Subscription.GetID()
										values["view"] = response.Filters.GetView()
										if response.Filters.GetView() == models.ViewUnread {
											values["mark"] = models.MarkRead
										} else {
											values["mark"] = models.MarkUnread
										}
									}}
									<li>
										<a
											hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
											hx-vals={ templ.JSONString(values) }
											class="rounded-field border border-neutral/15 text-sm"
										>
											<span class="show-loading items-center">
												<span class="loading mr-3 loading-spinner"></span>
												Loading
											</span>
											<span class="hide-loading items-center">
												if response.Filters.GetView() == models.ViewUnread {
													@tablerfilled.MailOpened(templ.Attributes{"class": "stroke-1 mr-3 size-5", "aria-hidden": "true"})
													<span class="text-sm/6">Mark Subscription Read</span>
												} else {
													@tablerfilled.Mail(templ.Attributes{"class": "stroke-1 mr-3 size-5", "aria-hidden": "true"})
													<span class="text-sm/6">Mark Subscription Unread</span>
												}
											</span>
										</a>
									</li>
								}
							}
						</ul>
						@buttonBackToTop()
					} else {
						{{ response.Filters.Subscriptions = nil }}
						@partials.NoContent()
					}
				</section>
			}
			// Watch for updates.
			<div
				id="updates"
				class="toast toast-center"
				hx-post="/list/articles/updates"
				hx-vals={ templ.JSONString(response.Filters.Values()) }
				hx-trigger="every 5m"
				hx-target="#updates"
			></div>
		}
	}
}

templ ShareArticleModal(request *models.ShareArticleRequest) {
	{{ id := string(request.ItemID) + "-share" }}
	// _={ "on click if navigator.share then " + shareAPIDialog(a.GetTitle(), a.GetLink()) + " else call document.getElementById('share-" + a.GetID() + "').show() then halt the event's bubbling" }
	@partials.Modal(id, true) {
		<div class="sm:flex sm:items-start">
			<span class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				@tableroutline.Share(templ.Attributes{"class": "size-12"})
			</span>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Share</h3>
				<div class="mt-2">
					<p class="text-sm">{ request.Title }</p>
				</div>
			</div>
		</div>
		<div class="mt-5 grid grid-flow-row grid-cols-3 items-center justify-center gap-x-2 gap-y-2 sm:mt-4">
			<a
				href={ fmt.Sprintf("mailto:?subject=%q&body=%s", html.EscapeString(request.Title), request.Link) }
				class="btn col-span-1 col-start-2"
			>
				@tableroutline.Send(templ.Attributes{"class": "size-5 text-primary", "aria-hidden": "true"})
				Email
			</a>
			<div class="join col-span-3 flex space-x-2">
				<div class="flex-1">
					<label class="input join-item w-full">
						<input type="text" value={ request.Link } readonly/>
					</label>
				</div>
				<button
					_={ "on click set currentValue to (my innerHTML) then writeText('" + request.Link + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
					class="btn join-item flex items-center"
				>
					@tableroutline.Copy(templ.Attributes{"class": "size-4", "aria-hidden": "true"})
					Copy Link
				</button>
			</div>
		</div>
	}
}
