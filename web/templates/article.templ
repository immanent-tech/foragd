package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strconv"
	"strings"
)

// Card renders an article as a card, for displaying in a list.
templ ArticleCard(article *models.Article) {
	<article
		id={ article.GetID() }
		class={ "card w-full h-full bg-base-200 shadow-md",
		templ.KV("row-span-1",article.GetImage() == nil),
		templ.KV("row-span-2",article.GetImage() != nil),
		templ.KV("opacity-50",!article.IsUnread()) }
	>
		if img := article.GetImage(); img != nil {
			@NewLink(
				WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()),
				WithHXTarget(ContentID.Target()),
				WithHXPushURL(true),
				WithHXSwap("innerHTML show:window:top"),
				WithClasses("link-hover"),
			) {
				{{ img := article.GetImage() }}
				if img.GetTitle() == "" {
					{{ img.Title = article.GetTitle() }}
				}
				<figure>
					@NewProxiedImage(img, "rs:auto:400:266/sh:0.5/q:80/el:1/ex:1/gravity:sm/sm:1/kcr:1/scp:1",
						WithAttribute("width", "400"),
						WithAttribute("height", "266"),
						WithClasses("w-full"),
					)
				</figure>
			}
		}
		<div class="card-body">
			@articleCardTitle(article)
			<div class="grid grid-cols-1 grid-flow-row mb-4">
				if len(article.GetAuthors()) > 0 {
					<p class="inline-block text-xs/4 italic truncate">
						{ strings.Join(article.GetAuthors(),",") }
					</p>
				}
				<p class="inline-block text-xs/4 truncate">
					@viewFeedSubscriptionLink(article.GetSubscriptionID(), article.GetFeedTitle(), models.ViewUnread, WithClasses("truncate")) {
						{ article.GetFeedTitle() }
					}
				</p>
			</div>
			<div class="card-actions mt-auto justify-between items-center">
				// Timestamp.
				<div class="flex flex-1 gap-x-2">
					<p class="text-xs/4 capitalize">
						Updated&nbsp;
						@showTimestamp(article.GetUpdatedDate())
					</p>
				</div>
				// Actions menu.
				<div class="flex flex-none">
					<el-dropdown class="relative ml-auto">
						<button class="btn btn-sm btn-ghost btn-square">
							<span class="sr-only">article.GetTitle() + " Actions"</span>
							@tabler.DotsVertical(i.Props{Class: "size-5"})
						</button>
						<el-menu
							anchor="bottom end"
							popover
						>
							// View original article action.
							@goToArticleLink(article, "link-hover") {
								@tabler.ExternalLink(i.Props{Class: "size-4"})
								Go To Article
							}
							// Find similar action.
							@findSimilarArticlesLink(article)
							// Mark action.
							<form id={ "mark-" + article.GetID() }>
								<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
								{{ var markURL string }}
								if article.IsUnread() {
									{{ markURL = "/mark/article/" + article.GetID() + "/read" }}
								} else {
									{{ markURL = "/mark/article/" + article.GetID() + "/unread" }}
								}
								@NewLink(
									WithHXMethod(http.MethodPost, markURL),
									WithHXTarget("#"+article.GetID()),
									WithHXInclude("[name='csrf_token'],#content-filters"),
									WithClasses("link-hover"),
								) {
									switch article.IsUnread() {
										case true:
											@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
											Mark Read
										case false:
											@tabler.MailFilled(i.Props{Class: "size-4"})
											Mark Unread
									}
								}
							</form>
							// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
							@favoriteArticleLink(article) {
								@ToggleFavorite(article.GetID(), string(article.GetObjectType()), article.IsFavorite())
							}
							// Share action.
							@shareArticleLink(article, "link-hover") {
								@tabler.Share(i.Props{Class: "size-4"})
								Share
							}
							// Report issue action.
							@reportArticleIssueLink(article, "link-hover") {
								@tabler.FlagFilled(i.Props{Class: "size-4"})
								Report an issue
							}
						</el-menu>
					</el-dropdown>
				</div>
			</div>
		</div>
		@ShareObjectModal(article.GetID(), "Sharing "+article.GetTitle(), article.GetLink())
	</article>
}

templ articleCardTitle(article *models.Article) {
	@NewLink(
		WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(true),
		WithHXSwap("innerHTML show:window:top"),
		WithClasses("link-hover"),
	) {
		<h2 class="card-title text-pretty line-clamp-3 tracking-tight">
			if article.GetTitle() != "" {
				{ article.GetTitle() }
			} else {
				(no title)
			}
		</h2>
	}
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(article *models.Article) {
	// Add the subscription ID as a hidden input that htmx can use for actions.
	<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
	@container() {
		<article id={ article.GetID() } class="w-full sm:max-w-prose sm:mx-auto">
			// Article title.
			<div class="flex flex-1 pb-2">
				@NewLink(
					WithAttribute("href", article.GetLink()),
					WithAttribute("target", "_blank"),
					WithAttribute("rel", "noopener"),
					WithClasses("group/item", "no-underline", "hover:underline", "focus:text-primary", "focus:outline-hidden"),
				) {
					@h2(article.GetTitle())
				}
			</div>
			// Subscription link.
			<div class="flex flex-1 pb-4">
				<form>
					{{ filters := models.PageFiltersFromCtx(ctx, "/list/articles") }}
					<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
					<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
					<input type="hidden" name={ models.ParamSort } value={ filters.GetSort() }/>
					<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
					<input type="hidden" name={ models.ParamSubscriptionName } value={ article.GetFeedTitle() }/>
					<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
					@NewLink(
						WithHXMethod(http.MethodPost, "/list/articles"),
						WithHXTarget(ContentID.Target()),
						WithHXInclude("[name='csrf_token']"),
						WithHXPushURL(true),
						WithHXSwap("innerHTML show:window:top transition:true"),
						WithClasses("group/item", "no-underline", "hover:underline", "focus:text-primary", "focus:outline-hidden"),
					) {
						<h3>{ article.GetFeedTitle() }</h3>
					}
				</form>
			</div>
			<div class="flex items-center">
				<div class="flex-1 inline-grid">
					// Author(s) and Published Time.
					if len(article.GetAuthors()) > 0 {
						<p class="col-span-full text-sm/6 italic truncate">
							{ strings.Join(article.GetAuthors(),",") }
						</p>
					}
					<p class="col-span-full text-sm/6 capitalize">
						Updated&nbsp;
						@showTimestamp(article.GetUpdatedDate())
					</p>
				</div>
				<div class="flex items-center justify-end">
					<el-dropdown>
						<button id="article-content-menu-toggle">
							<span class="sr-only">Article Actions</span>
							@tabler.DotsVertical(i.Props{Class: "size-6"})
						</button>
						<el-menu id="article-content-menu" anchor="bottom end" popover>
							// Find similar action.
							@findSimilarArticlesLink(article)
							// Mark action.
							<form>
								<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
								<div id={ "mark_" + article.GetID() }>
									@UpdateViewArticleMark(article.GetID(), article.IsUnread())
								</div>
							</form>
							// Favorite action.
							@favoriteArticleLink(article) {
								@UpdateViewArticleFavorite(article.GetID(), article.IsFavorite())
							}
							// Report article issue action.
							@reportArticleIssueLink(article, "link-hover") {
								@tabler.FlagFilled(i.Props{Class: "size-4"})
								Report an issue
							}
						</el-menu>
					</el-dropdown>
				</div>
			</div>
			// Content.
			if article.GetContent() != "" || article.GetDescription() != "" {
				<div data-disable-scripting class="prose-custom forced-width">
					switch  {
						case article.GetContent() != "":
							@templ.Raw(article.GetContent())
						case article.GetDescription() != "":
							@templ.Raw(article.GetDescription())
					}
				</div>
			}
		</article>
	}
	<nav class="my-16 flex items-center justify-center gap-x-4 text-sm">
		// Toggle view full content action.
		@NewLink(
			WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()),
			WithHXTarget(ContentID.Target()),
			WithHXInclude("[name='csrf_token']"),
			WithHXVals(map[string]any{models.ParamFullArticleContent: strconv.FormatBool(!article.IsRemoteContent())}),
		) {
			if article.IsRemoteContent() {
				Feed content
			} else {
				Original content
			}
		}
		// View original article action.
		@goToArticleLink(article) {
			Go to article
		}
		// Share article action.
		@shareArticleLink(article) {
			Share
		}
	</nav>
	@btnBackToTop()
	// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is
	// read and mark it so (when the user has set this option).
	if article.IsUnread() && article.MarkArticleReadOnView {
		<input type="hidden" name="view" value={ models.ViewAll }/>
		<div
			aria-hidden="true"
			hx-post={ "/mark/article/" + article.GetID() + "/read" }
			hx-swap="none"
			hx-include="[name='csrf_token'],[name='view']"
			hx-vals={ templ.JSONString(map[string]any{models.ParamSubscriptionID: article.GetSubscriptionID(), models.ParamMark: string(models.MarkRead)}) }
			hx-trigger="intersect once,load delay:10s"
			hx-push-url="false"
			_="on htmx:afterRequest remove me"
		></div>
	}
}

// UpdateViewArticleMark updates the mark action when viewing an article.
templ UpdateViewArticleMark(id string, isUnread bool) {
	{{ var markURL string }}
	if isUnread {
		{{ markURL = "/mark/article/" + id + "/read" }}
		<input type="hidden" name={ models.ParamView } value={ models.ViewUnread }/>
	} else {
		{{ markURL = "/mark/article/" + id + "/unread" }}
		<input type="hidden" name={ models.ParamView } value={ models.ViewRead }/>
	}
	@NewLink(
		WithHXMethod(http.MethodPost, markURL),
		WithHXTarget("#mark_"+id),
		WithHXInclude("[name='csrf_token']"),
		WithClasses("link-hover", "group/item", "flex", "items-center", "px-4", "py-2", "no-underline", "hover:underline", "text-sm", "gap-4", "focus:text-primary", "focus:outline-hidden"),
	) {
		switch isUnread {
			case true:
				@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
				Mark Read
			case false:
				@tabler.MailFilled(i.Props{Class: "size-4"})
				Mark Unread
		}
	}
}

// UpdateViewArticleFavorite updates the favorite action when viewing an article.
templ UpdateViewArticleFavorite(id models.ItemID, isFavorite bool) {
	{{ var favoriteURL string }}
	if isFavorite {
		{{ favoriteURL = "/user/favorite/remove/article/" + id }}
	} else {
		{{ favoriteURL = "/user/favorite/add/article/" + id }}
	}
	@NewLink(
		WithHXMethod(http.MethodPost, favoriteURL),
		WithHXTarget("#favorite_"+id),
		WithHXInclude("[name='csrf_token']"),
		WithHXVals(map[string]any{"display": "content"}),
		WithClasses("link-hover", "group/item", "flex", "items-center", "px-4", "py-2", "no-underline", "hover:underline", "text-sm", "gap-4", "focus:text-primary", "focus:outline-hidden"),
	) {
		switch isFavorite {
			case true:
				@tabler.HeartFilled(i.Props{Class: "size-4"})
				Remove Favorite
			case false:
				@tabler.Heart(i.Props{Class: "size-4"})
				Add Favorite
		}
	}
}

// ListArticles renders the list of articles in a grid layout with filtering controls and an actions menu.
templ ListArticles(response *models.ListArticlesResponse) {
	@container() {
		@generateFilters(&response.Filters)
		// Watch for updates.
		<div id="update-notifications" sse-connect={ "/list/articles/updates?" + response.Filters.QueryString() } sse-swap="message" class="toast toast-center z-50"></div>
		// Show a page header.
		<div class="md:flex md:items-center md:justify-between">
			<div class="min-w-0 flex-1">
				{{ var title string }}
				if response.Subscription != nil {
					{{ title = response.Subscription.GetTitle() }}
				} else {
					{{ title = "Articles" }}
				}
				@h2(title)
			</div>
			<div class="mt-4 flex md:mt-0 md:ml-4 space-x-4">
				@h3(response.Filters.GetView())
				@h3(response.Filters.GetSort().String())
			</div>
		</div>
		<div
			if response.Subscription != nil {
				hx-vals={ templ.JSONString(map[string]string{models.ParamSubscriptionID: response.Subscription.GetID()}) }
			}
		>
			@FilterControls("/list/articles", response.Articles.GetCategoryCounts(), &response.Filters) {
				<el-dropdown class="inline-block flex-none">
					<button id="articles-actions-button" class="inline-flex btn btn-wide">
						Actions
						@tabler.ChevronDown(i.Props{Class: "-mr-1 size-5"})
					</button>
					<el-menu
						id="articles-actions-menu"
						anchor="bottom end"
						popover
						_="on keydown from body if the event's key is 'x' and event.altKey then togglePopover() on me"
					>
						<div class="py-1">
							if response.Subscription == nil {
								// Mark all articles action.
								<form>
									<input type="hidden" name={ models.ParamView } value={ response.Filters.GetView() }/>
									<a
										class="link link-hover"
										if response.Filters.GetView() == models.ViewUnread {
											hx-post="/list/articles/mark/read"
										} else {
											hx-post="/list/articles/mark/unread"
										}
										hx-target={ ContentID.Target() }
										hx-include="#grid-objects,[name='csrf_token']"
									>
										if response.Filters.GetView() == models.ViewUnread {
											@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
											<span class="sr-only">Mark All Read</span>
											Mark Articles Read
											<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
										} else {
											@tabler.MailFilled(i.Props{Class: "size-4"})
											<span class="sr-only">Mark All Unread</span>
											Mark Articles Unread
											<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
										}
									</a>
								</form>
							} else {
								// Mark subscription action.
								<form id={ "mark-" + response.Subscription.GetID() }>
									// MarkURL returns the app URL for marking the subscription.
									{{ var markURL string }}
									{{ var markText string }}
									{{ var markIcon templ.Component }}
									if response.Filters.GetView() == models.ViewUnread {
										{{ markURL = "/mark/subscription/" + response.Subscription.GetID() + "/read" }}
										{{ markText = "Mark Subscription Read" }}
										{{ markIcon = tabler.MailOpenedFilled(i.Props{Class: "size-4"}) }}
									} else {
										{{ markURL = "/mark/subscription/" + response.Subscription.GetID() + "/unread" }}
										{{ markText = "Mark Subscription Unread" }}
										{{ markIcon = tabler.MailFilled(i.Props{Class: "size-4"}) }}
									}
									@NewLink(
										WithHXMethod(http.MethodPost, markURL),
										WithHXInclude("[name='csrf_token'],[name='view']"),
										WithClasses("link-hover"),
									) {
										@markIcon
										{ markText }
									}
								</form>
								// Edit subscription action.
								@NewLink(
									WithHXMethod(http.MethodGet, "/edit/subscription/"+response.Subscription.GetID()),
									WithHXTarget(ContentID.Target()),
									WithHXPushURL(true),
									WithClasses("link-hover"),
								) {
									@tabler.Edit(i.Props{Class: "size-4"})
									Edit Subscription
								}
							}
						</div>
					</el-menu>
				</el-dropdown>
			}
		</div>
		<section class="mt-4">
			if len(response.Articles) > 0 {
				@grid() {
					@PaginateArticles(response)
				}
			} else {
				{{ response.Filters.Subscriptions = nil }}
				@emptyContent()
			}
		</section>
	}
}

// PaginateArticles renders the given list of articles as cards with an optional element to trigger pagination to load more.
templ PaginateArticles(response *models.ListArticlesResponse) {
	for article := range slices.Values(response.Articles) {
		<input type="hidden" name={ "metadata[" + article.GetSubscriptionID() + "]" } value={ article.GetID() }/>
		@ArticleCard(article)
	}
	// Add pagination element if pagination is required.
	if response.Pagination != "" && len(response.Articles) == response.Filters.GetCount() {
		// Add pagination htmx props to last article.
		@PaginationControl(ctx, "/list/articles/paginate", "#content-filters,[name='csrf_token']", response.Pagination)
	}
}

// shareArticleLink renders a link that opens the share dialog. This will be either the native navigator.share API
// dialog or a custom modal, depending on browser support.
templ shareArticleLink(article *models.Article, classes ...string) {
	@NewLink(
		WithClasses(classes...),
		WithAttribute("_",
			"on click if navigator.share then "+shareAPIDialog(article.GetTitle(), article.GetLink())+" else call document.getElementById('share-"+article.GetID()+"').show() ",
		),
	) {
		{ children... }
	}
}

// goToArticleLink renders a link that directs to the remote article.
templ goToArticleLink(article *models.Article, classes ...string) {
	@NewLink(
		WithAttribute("href", article.GetLink()),
		WithAttribute("target", "_blank"),
		WithAttribute("rel", "noopener"),
		WithClasses(classes...),
	) {
		{ children... }
	}
}

// reportArticleIssueLink renders a link that opens the form to report an issue with the article.
templ reportArticleIssueLink(article *models.Article, classes ...string) {
	@NewLink(
		WithHXMethod(http.MethodGet, "/issue/article/"+article.GetID()),
		WithHXTarget(ContentID.Target()),
		WithHXReplaceURL(true),
		WithClasses(classes...),
	) {
		{ children... }
	}
}

// favoriteArticleLink renders a link for toggling an article favorite.
templ favoriteArticleLink(article *models.Article) {
	<form>
		<input type="hidden" name="display" value="card"/>
		<div id={ "favorite_" + article.GetID() }>
			{ children... }
		</div>
	</form>
}

templ findSimilarArticlesLink(article *models.Article) {
	@NewLink(
		WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()+"/similar"),
		WithHXTarget(ContentID.Target()),
		WithHXPushURL(true),
		WithClasses("link-hover"),
	) {
		@tabler.FileSearch(i.Props{Class: "size-4"})
		Find similar...
	}
}
