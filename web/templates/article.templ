package templates

import (
	"fmt"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/pkg/formats/text"
	"github.com/immanent-tech/foragd/server/session"
	"github.com/immanent-tech/foragd/service"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"html"
	"net/http"
	"slices"
	"strconv"
	"strings"
	"time"
)

// Card renders an article as a card, for displaying in a list.
templ ArticleCard(idx int, article *models.Article) {
	@partials.Card(element.WithAttribute("id", article.GetID()),
		element.WithAttribute("style", "--i: "+strconv.Itoa(idx)),
		element.WithClasses(
			"group", "animate-fadeinup", "has-[.animation-done]:will-change-auto", "self-start", "cursor-pointer", "touch-manipulation"),
		element.WithHXMethod(http.MethodGet, "/view/article/"+article.GetID()),
		element.WithHXTarget(ContentID.Target()),
		element.WithHXSwap("innerHTML show:window:top transition:true"),
		element.WithHXTrigger("click"),
		element.WithHXPushURL(true),
	) {
		// Hidden inputs used for some group article actions.
		<input type="hidden" name={ "displayed_articles[" + article.GetSubscriptionID() + "]" } value={ article.GetID() }/>
		<div>
			if img := article.GetImage(); img != nil {
				{{ img := article.GetImage() }}
				if img.GetTitle() == "" {
					{{ img.Title = new(article.GetTitle()) }}
				}
				// Article Main Image.
				<figure class="relative overflow-hidden rounded-t-[inherit]">
					{{
						var loadingAttrKey, loadingAttrValue string
						if idx < 3 {
							loadingAttrKey = "fetchpriority"
							loadingAttrValue = "high"
						} else {
							loadingAttrKey = "loading"
							loadingAttrValue = "lazy"
						}
					}}
					//  rounded-t-[inherit] transition-transform duration-400 ease-in-out group-hover:scale-[1.04]">
					@partials.NewProxiedImage(img, "rs:auto:400:300/sh:0.5/q:80/el:1/ex:1/gravity:sm/sm:1/kcr:1/scp:1/ext:webp",
						element.WithAttribute("width", "400"),
						element.WithAttribute("height", "300"),
						element.WithAttribute(loadingAttrKey, loadingAttrValue),
						element.WithClasses("w-full", "aspect-[4/3]", "object-cover", "transition-transform", "duration-400", "ease-in-out", "group-hover:scale-[1.04]"),
					)
					<div class="pointer-events-none absolute inset-0 rounded-t-[inherit] shadow-[inset_0_-2px_8px_rgba(0,0,0,0.12)]"></div>
					// Overlay the feed name on the image.
					<div class="absolute top-2.5 left-2.5">
						<span class="badge border-0 bg-base-100/90 badge-sm font-medium text-base-content/80 backdrop-blur-sm">{ article.Item.FeedTitle }</span>
					</div>
				</figure>
			} else {
				// Show the feed name at the top left.
				<span class="mt-2.5 ml-2.5 badge badge-ghost badge-sm font-medium text-base-content/80">{ article.Item.FeedTitle }</span>
			}
		</div>
		{{
			var bodyClasses string
			if img := article.GetImage(); img != nil {
				bodyClasses = "flex-1"
			}
		}}
		@partials.CardBody(element.WithClasses(bodyClasses)) {
			{{ categoryLimit := 10 }}
			// Category Badges (up to 10).
			if len(article.GetCategories(categoryLimit)) > 0 {
				<div class="mb-2.5 flex flex-wrap gap-1.5 self-start">
					for idx, category := range article.GetCategories(categoryLimit) {
						{{
							filters := models.NewListDisplayFilters()
							filters.Categories = append(filters.Categories, category)
							var extraClasses string
							// Only show the first three categories, hide all others behind a button toggle.
							if idx >= 3 {
								extraClasses = "hidden"
							}
						}}
						@CategoryBadge(category,
							element.WithHXMethod(http.MethodGet, "/list/articles"),
							element.WithHXTarget(ContentID.Target()),
							element.WithHXValues(filters.Values()),
							element.WithClasses(extraClasses),
							element.WithAttribute("_", "on click halt the event's bubbling"),
						)
					}
					// Add a button to reveal all categories when clicked.
					if len(article.GetCategories(categoryLimit)) > 3 {
						<button
							class="toggle-categories-btn btn btn-outline btn-xs"
							_="
							on click
							  halt the event's bubbling
          					  set :tags to <span/> in the closest parent <div/> where it matches .category-badge
							  for tag in :tags
							   remove .hidden from tag
							  end
							  remove me
							end
							"
						>
							{ fmt.Sprintf("+ %d more",len(article.GetCategories(categoryLimit))-3) }
						</button>
					}
				</div>
			}
			// Article Title.
			<h3 class="mb-2 line-clamp-2 font-serif text-base leading-snug font-bold text-balance transition-colors group-hover:text-primary">
				if article.GetTitle() != "" {
					{ article.GetTitle() }
				} else {
					(no title)
				}
			</h3>
			// Article Summary (if any).
			if content := article.GetContent(); content != "" {
				<div class={ "prose-summary mb-3", templ.KV("line-clamp-3",article.GetImage() != nil),templ.KV("line-clamp-6",article.GetImage() == nil) }>
					@templ.Raw(content)
				</div>
			}
		}
		@partials.CardFooter(element.WithClasses("items-center")) {
			<div class="flex items-center justify-between gap-4 border-t border-neutral/25 pt-3">
				<div class="flex-separated flex min-w-0 items-center">
					if len(article.GetAuthors()) > 0 {
						{{
							authors := make([]string, 0)
							for author := range slices.Values(article.GetAuthors()) {
								authors = append(authors, author.String())
							}
						}}
						<div class="truncate text-xs/4">
							{ strings.Join(authors,",") }
						</div>
					}
					<relative-time
						datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
						format="relative"
						class="shrink-0 text-xs/4 text-neutral capitalize tabular-nums"
					>
						{ article.GetUpdatedDate().Format("Jan _2, 2006") }
					</relative-time>
				</div>
				<div class="flex shrink-0 items-center gap-1">
					<div class="tooltip" data-tip="Toggle favorite">
						<button class="btn btn-square btn-ghost btn-sm">
							<form>
								<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
								<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
								<label class="swap touch-manipulation" _="on click halt the event's bubbling">
									<input
										hx-post={ "/favorite/article/" + article.GetID() }
										hx-swap="none"
										id={ article.GetID() + "-favorite-state" }
										type="checkbox"
										if article.IsFavorite() {
											checked
										}
										_="on htmx:afterRequest(failed) toggle @checked on me"
										aria-label={ "Toggle favorite status for " + article.GetTitle() }
									/>
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-heart swap-on size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z"></path>
									</svg>
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart swap-off size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
									</svg>
								</label>
							</form>
						</button>
					</div>
					<div
						class="tooltip"
						if article.IsUnread() {
							data-tip={ "Mark " + string(models.MarkRead) }
						} else {
							data-tip={ "Mark " + string(models.MarkUnread) }
						}
					>
						<button class="btn btn-square btn-ghost btn-sm">
							<form>
								<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
								<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
								<input type="hidden" name="view" value={ service.ListFiltersFromCtx(ctx).View }/>
								<input
									type="hidden"
									name={ models.ParamMark }
									if article.IsUnread() {
										value={ models.MarkRead }
									} else {
										value={ models.MarkUnread }
									}
								/>
								<label class="swap touch-manipulation" _="on click halt the event's bubbling">
									<input
										hx-post={ "/mark/article/" + article.GetID() }
										hx-swap="none"
										id={ article.GetID() + "-read-state" }
										type="checkbox"
										if !article.IsUnread() {
											checked
										}
										_="install HandleReadStatus"
										aria-label={ "Toggle read status for " + article.GetTitle() }
									/>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail-opened swap-on size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 9l9 6l9 -6l-9 -6l-9 6"></path><path d="M21 9v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 19l6 -6"></path><path d="M15 13l6 6"></path>
									</svg>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
									</svg>
								</label>
							</form>
						</button>
					</div>
					// Actions menu.
					<div class="flex flex-none">
						<div class="tooltip overflow-visible" data-tip="Article actions">
							<el-dropdown class="relative ml-auto touch-manipulation" _="on click halt the event's bubbling">
								<button id={ article.GetID() + "-actions-menu" } class="btn btn-square btn-ghost btn-sm">
									<span class="sr-only">{ article.GetTitle() + " Actions" }</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path>
									</svg>
								</button>
								@partials.Menu(element.WithAttribute("aria-labelledby", article.GetID()+"-actions-menu")) {
									// View original article action.
									@partials.MenuItem() {
										<a
											href={ article.GetLink() }
											target="_blank"
											rel="noopener"
											_="on click halt the event's bubbling"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path><path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
											</svg>
											Go To Article
										</a>
									}
									// Find similar action.
									@partials.MenuItem() {
										<a
											hx-get={ "/view/article/" + article.GetID() + "/similar" }
											hx-target={ ContentID.Target() }
											hx-trigger="click consume"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-search size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M12 21h-5a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v4.5"></path><path d="M14 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0"></path><path d="M18.5 19.5l2.5 2.5"></path>
											</svg>
											Find similar...
										</a>
									}
									// Mobile share action via navigator API.
									@partials.MenuItem(element.WithAttribute("_", "init if not navigator.share then hide me")) {
										<a
											_={ "on click " + fmt.Sprintf("navigator.share({title: %q, url: %q})", article.GetTitle(), article.GetLink()) + "then halt the event's bubbling" }
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
											</svg>
											Share
										</a>
									}
									// Desktop share action with modal and options.
									@partials.MenuItem(element.WithAttribute("_", "init if navigator.share then hide me")) {
										<a
											hx-post={ "/share/article/" + article.GetID() }
											hx-target={ partials.ModalContainerID.Target() }
											hx-trigger="click consume"
											hx-vals={ templ.JSONString(map[string]string{
												"item_id": article.GetID(),
												"title": article.GetTitle(),
												"link": article.GetLink(),
											}) }
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
											</svg>
											Share
										</a>
									}
									// Report issue action.
									@partials.MenuItem() {
										<a
											hx-get="/issue"
											hx-target={ ContentID.Target() }
											hx-vals={ templ.JSONString(map[string]any{
												"object_id": article.GetID(),
											}) }
											hx-replace-url="true"
											hx-trigger="click consume"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-flag-2 size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19 4a1 1 0 0 1 .993 .883l.007 .117v9a1 1 0 0 1 -.883 .993l-.117 .007h-13v6a1 1 0 0 1 -.883 .993l-.117 .007a1 1 0 0 1 -.993 -.883l-.007 -.117v-16a1 1 0 0 1 .883 -.993l.117 -.007h14z"></path>
											</svg>
											Report an issue
										</a>
									}
								}
							</el-dropdown>
						</div>
					</div>
				</div>
			</div>
		}
	}
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(article *models.Article) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container() {
				// Add the subscription ID as a hidden input that htmx can use for actions.
				<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
				<article id={ article.GetID() } class="w-full sm:mx-auto sm:max-w-prose">
					// Show a subtle reading progress bar across the top of the article.
					@partials.ReadingProgress()
					// Subscription and timestamp.
					<div class="my-4 flex items-center font-display text-sm/6 text-neutral">
						{{ filters := session.GetListArticleFiltersFromSession(ctx) }}
						<a
							hx-get="/list/articles"
							hx-target={ ContentID.Target() }
							hx-swap="innerHTML show:window:top transition:true"
							hx-vals={ templ.JSONString(map[string]any{
									"view": filters.GetView(),
									"count": filters.GetCount(),
									"sort": filters.GetSort(),
									"subscriptions": article.GetSubscriptionID(),
									"subscription_name": article.GetFeedTitle(),
									"subscription_id": article.GetSubscriptionID(),
								}) }
							class="flex link link-hover"
						>
							{  article.GetFeedTitle() }
						</a>
						<span class="flex-none px-4">·</span>
						<span class="flex-none capitalize">
							<relative-time
								datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
								format="relative"
								class="tabular-nums"
							>
								{ article.GetUpdatedDate().Format("Jan _2, 2006") }
							</relative-time>
						</span>
					</div>
					// Categories.
					if len(article.GetCategories(0)) > 0 {
						<div class="mb-4 flex flex-row flex-wrap gap-2 self-start">
							for category := range slices.Values(article.GetCategories(5)) {
								{{
									filters := models.NewListDisplayFilters()
									filters.Categories = append(filters.Categories, category)
								}}
								@CategoryBadge(category,
									element.WithHXMethod(http.MethodGet, "/list/articles"),
									element.WithHXTarget(ContentID.Target()),
									element.WithHXValues(filters.Values()),
									element.WithHXParams("not subscription_id"),
									element.WithAttribute("_", "on click halt the event's bubbling"),
								)
							}
						</div>
					}
					// Article title.
					<div class="flex flex-1 pb-2">
						if article.SourceType != models.SourceTypeEmail {
							<a
								href={ article.GetLink() }
								target="_blank"
								rel="noopener"
								class="link link-hover focus:text-primary focus:outline-hidden"
							>
								<h1 class="mt-4 mb-2 scroll-mt-16 font-serif text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
							</a>
						} else {
							<h1 class="mt-4 mb-2 scroll-mt-16 font-serif text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
						}
					</div>
					// Byline and actions.
					<div class="grid grid-cols-2 items-center justify-between border-b border-neutral/25 p-1">
						<div class="flex items-center">
							if article.SourceType != models.SourceTypeEmail {
								// Show authors if found.
								if len(article.GetAuthors()) > 0 {
									{{
										authors := make([]string, 0)
										for author := range slices.Values(article.GetAuthors()) {
											authors = append(authors, author.String())
										}
									}}
									<strong class="truncate text-sm/6">
										{ strings.Join(authors,",") }
									</strong>
								}
							}
						</div>
						// Actions.
						<div class="col-start-2 ml-auto flex shrink-0 items-center">
							<button class="btn btn-square p-2 btn-ghost">
								<label class="swap" _="on click halt the event's bubbling">
									<input
										hx-post={ "/favorite/article/" + article.GetID() }
										hx-swap="none"
										hx-vals={ templ.JSONString(map[string]any{
											"subscription_id": article.GetSubscriptionID(),
											"item_id": article.GetID(),
										}) }
										id={ article.GetID() + "-favorite-state" }
										type="checkbox"
										if article.IsFavorite() {
											checked
										}
										_="on htmx:afterRequest(failed) toggle @checked on me"
										aria-label="Toggle favorite status"
									/>
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-heart swap-on size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z"></path>
									</svg>
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart swap-off size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
									</svg>
								</label>
							</button>
							<button class="btn btn-square p-2 btn-ghost">
								<label class="swap" _="on click halt the event's bubbling">
									{{
										var mark models.Mark
										if article.IsUnread() {
											mark = models.MarkRead
										} else {
											mark = models.MarkUnread
										}
									}}
									<input
										hx-post={ "/mark/article/" + article.GetID() }
										hx-swap="none"
										hx-vals={ templ.JSONString(map[string]any{
											"subscription_id": article.GetSubscriptionID(),
											"item_id": article.GetID(),
											"mark": mark,
										}) }
										id={ article.GetID() + "-read-state" }
										type="checkbox"
										if !article.IsUnread() {
											checked
										}
										_="
										on htmx:afterRequest(successful)
										tell the previous <input />
											get your value
											if your value equals 'read'
											set your value to 'unread'
											else
											set your value to 'read'
											end
										on htmx:afterRequest(failed) toggle @checked on me
										"
										aria-label="Toggle read status"
									/>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail-opened swap-on size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 9l9 6l9 -6l-9 -6l-9 6"></path><path d="M21 9v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 19l6 -6"></path><path d="M15 13l6 6"></path>
									</svg>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
									</svg>
								</label>
							</button>
							<el-dropdown>
								<button
									class="btn btn-square btn-ghost"
								>
									<span class="sr-only">Article Actions</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path>
									</svg>
								</button>
								@partials.Menu() {
									// Find similar action.
									@partials.MenuItem() {
										<a
											hx-get={ "/view/article/" + article.GetID() + "/similar" }
											hx-target={ ContentID.Target() }
											hx-trigger="click consume"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-search size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M12 21h-5a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v4.5"></path><path d="M14 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0"></path><path d="M18.5 19.5l2.5 2.5"></path>
											</svg>
											Find similar...
										</a>
									}
									// Report article issue action.
									@partials.MenuItem() {
										<a
											hx-get={ "/issue/article/" + article.GetID() }
											hx-target={ ContentID.Target() }
											hx-replace-url="true"
											hx-trigger="click consume"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-flag-2 size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19 4a1 1 0 0 1 .993 .883l.007 .117v9a1 1 0 0 1 -.883 .993l-.117 .007h-13v6a1 1 0 0 1 -.883 .993l-.117 .007a1 1 0 0 1 -.993 -.883l-.007 -.117v-16a1 1 0 0 1 .883 -.993l.117 -.007h14z"></path>
											</svg>
											Report an issue
										</a>
									}
								}
							</el-dropdown>
						</div>
					</div>
					// Show reading time if content length is greater than around two paragraphs of text...
					if text.CountWords(article.GetContent()) > 160 {
						<div class="ml-auto flex flex-1 justify-end p-1">
							<span class="text-sm/6 text-neutral">
								Reading time:
								{ strings.ReplaceAll(text.ReadingTime(string(article.GetContent())).Round(time.Minute).String(),"0s","") }
							</span>
						</div>
					}
					// Content.
					switch  {
						case article.IsEmail():
							// Article from email newsletter.
							<div
								class="prose-email mt-4"
								data-disable-scripting
								hx-disable
							>
								@templ.Raw(article.GetContent())
							</div>
						case article.IsYoutubeVideo():
							// Youtube video.
							if youtubeData, err := article.AsYoutubeVideo(); err == nil {
								<div class="relative aspect-video h-auto max-w-full overflow-hidden p-8">
									<embed-youtube
										video-id={ youtubeData.VideoId }
										width={ *youtubeData.Width }
										height={ *youtubeData.Height }
										origin="https://foragd.app"
										credentialless
									></embed-youtube>
								</div>
							}
							if article.GetDescription() != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4"
								>
									@templ.Raw(article.GetDescription())
								</div>
							}
							<nav class="my-16 flex flex-col items-center justify-center gap-2 text-sm sm:flex-row">
								@shareArticleButton(article)
							</nav>
						default:
							// Try to display content or description.
							if content := article.GetContent(); content != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4 px-2 sm:px-0"
								>
									@templ.Raw(content)
								</div>
							}
							<div class="mt-8 w-full border-t border-neutral/25"></div>
							<div class="mx-auto mt-4 fieldset w-xs justify-items-center">
								// Show a toggle for fetching full content where it appears the feed content is only a summary
								if !article.IsRemoteContent() {
									// {{ proxyURL, _ := reverseproxy.GenerateProxyURL(article.GetLink()) }}
									// <button
									// 	id="show-remote-content-button"
									// 	class="btn btn-wide btn-primary"
									// 	data-url={ proxyURL }
									// 	_="
									// 	on click
									// 		add .in-flight-request to me
									// 		set my.disabled to true
									// 		fetch me.dataset.url
									// 		put the result into #article-full-text's value then
									// 		    remove .in-flight-request from me
									// 		    set my.disabled to false
									// 			send submit to #extract-article
									// 		catch e
									// 		  log 'fetchAndProxy failed with status: ' + e.status
									// 		  set #article-full-text's value to ''
									// 		  send submit to #extract-article
									// 		  remove .in-flight-request from me
									// 		  set my.disabled to true
									// 		end
									// 	"
									// >
									// 	<span class="show-loading items-center">
									// 		<span class="loading mr-3 loading-spinner"></span>
									// 		Loading
									// 	</span>
									// 	<span class="hide-loading">
									// 		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-download mr-3">
									// 			<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17v-6"></path><path d="M9.5 14.5l2.5 2.5l2.5 -2.5"></path>
									// 		</svg>
									// 		<span class="text-sm/6">Get Remote Content</span>
									// 	</span>
									// </button>
									// <form
									// 	id="extract-article"
									// 	hx-post={ "/view/article/" + article.GetID() }
									// 	hx-target={ ContentID.Target() }
									// 	hx-swap="innerHTML"
									// 	hx-push-url="false"
									// 	hx-trigger="submit"
									// 	hx-vals={ templ.JSONString(map[string]any{models.ParamFullArticleContent: true}) }
									// 	_="
									// 	  on htmx:afterRequest(failed) add @disabled to #show-remote-content-button
									// 	  "
									// >
									// class="invisible"
									// <input type="hidden" name="article-full-text" id="article-full-text"/>
									<button
										id="show-remote-content-button"
										class="btn btn-wide btn-primary"
										hx-post={ "/view/article/" + article.GetID() }
										hx-target={ ContentID.Target() }
										hx-swap="innerHTML"
										hx-push-url="false"
										hx-vals={ templ.JSONString(map[string]any{models.ParamFullArticleContent: true}) }
										_="on htmx:afterRequest(failed) add @disabled to me"
									>
										<span class="show-loading items-center">
											<span class="loading mr-3 loading-spinner"></span>
											Loading
										</span>
										<span class="hide-loading">
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-download mr-3">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17v-6"></path><path d="M9.5 14.5l2.5 2.5l2.5 -2.5"></path>
											</svg>
											<span class="text-sm/6">Get Remote Content</span>
										</span>
									</button>
									// </form>
								} else {
									<button
										id="show-feed-content-button"
										class="btn btn-wide btn-primary"
										hx-get={ "/view/article/" + article.GetID() }
										hx-target={ ContentID.Target() }
										hx-swap="innerHTML"
										hx-trigger="click consume"
										hx-push-url="false"
										hx-vals={ templ.JSONString(map[string]any{models.ParamFullArticleContent: false}) }
										_="install LoadingButton"
									>
										<span class="show-loading items-center">
											<span class="loading mr-3 loading-xs loading-spinner"></span>
											Loading
										</span>
										<span class="hide-loading">
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-rss mr-3">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17a3 3 0 0 0 -3 -3"></path><path d="M15 17a6 6 0 0 0 -6 -6"></path><path d="M9 17h.01"></path>
											</svg>
											<span class="text-sm/6">Show Feed Content</span>
										</span>
									</button>
								}
								// View original article action.
								<a
									role="button"
									class="btn m-2 btn-wide btn-outline"
									href={ article.GetLink() }
									target="_blank"
									rel="noopener"
									_="on click halt the event's bubbling"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link mr-3">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path><path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
									</svg>
									<span class="text-sm/6">View Remote</span>
								</a>
								@shareArticleButton(article)
							</div>
					}
				</article>
				<div class="p-4">
					@partials.ButtonBackToTop()
					// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is
					// read and mark it so (when the user has set this option).
					if article.IsUnread() && article.MarkArticleReadOnView {
						<div
							id="auto-mark-read"
							hx-target="#auto-mark-read"
							hx-post={ "/mark/article/" + article.GetID() }
							hx-swap="delete transition:false"
							hx-vals={ templ.JSONString(map[string]any{
							"subscription_id": article.GetSubscriptionID(),
							"item_id": article.GetID(),
							"mark": models.MarkRead,
						}) }
							hx-trigger="intersect once delay:5s,load delay:5s"
							aria-hidden="true"
							_={ "on htmx:afterRequest(successful) toggle @checked on #" + article.GetID() + "-read-state" }
						></div>
					}
				</div>
			}
		}
	}
}

templ shareArticleButton(a *models.Article) {
	// Mobile share action via navigator API.
	<button
		class="btn hidden btn-wide btn-outline"
		data-title={ a.GetTitle() }
		data-url={ a.GetLink() }
		_="init if navigator.share remove .hidden from me end
		   on click
		   js(me)
		      navigator.share({ title: me.dataset.title, url: me.dataset.url })
		   end"
	>
		<svg
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="icon icon-tabler icons-tabler-outline icon-tabler-share mr-3"
		>
			<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
		</svg>
		<span class="text-sm/6">Share</span>
	</button>
	// Desktop share action with modal and options.
	<button
		class="btn hidden btn-wide btn-outline"
		hx-post={ "/share/article/" + a.GetID() }
		hx-target={ partials.ModalContainerID.Target() }
		hx-trigger="click consume"
		hx-vals={ templ.JSONString(map[string]any{
				"item_id": a.GetID(),
				"title": a.GetTitle(),
				"link": a.GetLink(),
			}) }
		_="init if not navigator.share remove .hidden from me"
	>
		<svg
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="icon icon-tabler icons-tabler-outline icon-tabler-share mr-3"
		>
			<path
				stroke="none"
				d="M0 0h24v24H0z"
				fill="none"
			></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
		</svg>
		<span class="text-sm/6">Share</span>
	</button>
}

// ListArticles renders the list of articles in a grid layout with filtering controls and an actions menu.
templ ListArticles(response *models.ListArticlesResponse) {
	@LayoutInternal(&InternalLayoutProps{User: models.UserFromCtx(ctx)}) {
		@templ.Fragment(ContentFragment) {
			@container(element.WithClasses("pt-4")) {
				// Show a page header.
				@pageHeading() {
					{{ var title string }}
					if response.Subscription != nil {
						{{ title = response.Subscription.GetTitle() }}
					} else {
						{{ title = "Articles" }}
					}
					@pageTitle(title)
					@pageActions() {
						// <div class="w-full justify-end">
						// 	<div class="tabs tabs-box">
						// 		<input type="radio" name="view" class="tab" aria-label="Unread"/>
						// 		<input type="radio" name="view" class="tab" aria-label="Read" checked="checked"/>
						// 		<input type="radio" name="view" class="tab" aria-label="All"/>
						// 	</div>
						// </div>
						<p aria-live="polite" class="flex gap-x-4 md:ml-4">
							<span class="text-lg font-medium capitalize">{ response.Filters.GetView() }</span>
							<span class="text-lg font-medium capitalize">{ response.Filters.GetSort().String() }</span>
						</p>
					}
				}
				<div
					if response.Subscription != nil {
						hx-vals={ templ.JSONString(map[string]string{models.ParamSubscriptionID: response.Subscription.GetID()}) }
					}
				>
					@FilterControls("/list/articles", &response.Filters) {
						<el-dropdown class="inline-block flex-none">
							<button id="articles-actions-button" class="btn inline-flex btn-wide">
								Actions
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
							@partials.Menu(
								element.WithAttribute("id", "articles-actions-menu"),
								element.WithAttribute("_", "on keydown from body if the event's key is 'x' and event.altKey then togglePopover() on me end"),
								element.WithAttribute("anchor", "bottom start"),
							) {
								if response.Subscription == nil {
									if len(response.Articles) > 0 {
										// Mark all articles action.
										@partials.MenuItem() {
											{{
												var mark models.Mark
												if response.Filters.GetView() == models.ViewUnread {
													mark = models.MarkRead
												} else {
													mark = models.MarkUnread
												}
											}}
											<a
												if response.Filters.GetView() == models.ViewUnread {
													hx-post="/list/articles/mark/read"
												} else {
													hx-post="/list/articles/mark/unread"
												}
												hx-target={ ContentID.Target() }
												hx-include="article > input"
												hx-vals={ templ.JSONString(map[string]string{"mark": string(mark)}) }
											>
												if response.Filters.GetView() == models.ViewUnread {
													<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail-opened size-4 stroke-accent">
														<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
														<path d="M3 9l9 6l9 -6l-9 -6l-9 6"></path>
														<path d="M21 9v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path>
														<path d="M3 19l6 -6"></path>
														<path d="M15 13l6 6"></path>
													</svg>
													Mark Articles Read
												} else {
													<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail size-4 text-accent">
														<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
														<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path>
														<path d="M3 7l9 6l9 -6"></path>
													</svg>
													Mark Articles Unread
												}
											</a>
										}
									} else {
										@partials.MenuItem() {
											<p class="px-4 py-2 italic">No actions.</p>
										}
									}
								} else {
									// Show mark read/unread action when not viewing all articles.
									if response.Filters.GetView() != models.ViewAll {
										// Mark subscription action.
										@partials.MenuItem() {
											{{
												var mark models.Mark
												if response.Filters.GetView() == models.ViewUnread {
													mark = models.MarkRead
												} else {
													mark = models.MarkUnread
												}
											}}
											<a
												hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
												hx-vals={ templ.JSONString(map[string]string{
														"mark": string(mark),
														"subscription_id": response.Subscription.GetID(),
														"view": string(response.Filters.GetView()),
														}) }
											>
												if response.Filters.GetView() == models.ViewUnread {
													<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4 fill-accent">
														<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
													</svg>
													Mark Subscription Read
												} else {
													<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail size-4 stroke-accent">
														<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z"></path><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z"></path>
													</svg>
													Mark Subscription Unread
												}
											</a>
										}
									}
									// Edit subscription action.
									@partials.MenuItem() {
										<a
											hx-get={ "/subscription/edit/" + response.Subscription.GetID() }
											hx-target={ ContentID.Target() }
											hx-params="not subscription_id"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-edit size-4 stroke-accent">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"></path><path d="M16 5l3 3"></path>
											</svg>
											Edit Subscription
										</a>
									}
									// Unsubscribe action.
									@partials.MenuItem() {
										<a
											hx-post={ "/remove/subscription/" + response.Subscription.GetID() }
											hx-target={ partials.ModalContainerID.Target() }
											hx-vals={ templ.JSONString(map[string]string{
													"nickname": response.Subscription.GetTitle(),
													"confirmed": "false",
												}) }
											hx-trigger="click consume"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-trash size-4 stroke-accent">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path d="M14 11l0 6"></path><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
											</svg>
											Remove Subscription
										</a>
									}
								}
							}
						</el-dropdown>
					}
				</div>
				<section class="mt-4">
					if len(response.Articles) > 0 {
						@grid() {
							@templ.Fragment(PaginateFragment) {
								for idx, article := range response.Articles {
									@ArticleCard(idx, article)
								}
								// Add pagination element if pagination is required.
								if response.Pagination != "" && len(response.Articles) == response.Filters.GetCount() {
									{{
										values := response.Filters.Values()
										values["pagination"] = response.Pagination
									}}
									<div
										class="col-span-full mx-auto"
										hx-post="/list/articles/paginate"
										hx-vals={ templ.JSONString(values) }
										hx-trigger="intersect once threshold:0.1"
										hx-target="#grid-objects"
										hx-swap="beforeend transition:false"
										_="on htmx:afterRequest remove me"
									>
										<div class="show-loading text-center">
											<span class="loading mr-3 loading-xl loading-bars"></span>
											<p class="text-lg/loose font-semibold">Loading content...</p>
										</div>
									</div>
								}
							}
						}
						// Show some actions at the bottom of the list.
						<nav class="mt-8 hidden justify-center" _="install RevealAtBottom">
							if response.Subscription == nil {
								// Mark all articles action.
								<button
									class="btn btn-wide btn-outline"
									if response.Filters.GetView() == models.ViewUnread {
										hx-post="/list/articles/mark/read"
										hx-vals={ templ.JSONString(map[string]any{
														"mark": models.MarkRead,
													}) }
									} else {
										hx-post="/list/articles/mark/unread"
										hx-vals={ templ.JSONString(map[string]any{
														"mark": models.MarkUnread,
													}) }
									}
									hx-target={ ContentID.Target() }
									hx-include="article > input"
								>
									<span class="show-loading items-center">
										<span class="loading mr-3 loading-spinner"></span>
										<span class="text-sm/6">Loading</span>
									</span>
									<span class="hide-loading items-center">
										if response.Filters.GetView() == models.ViewUnread {
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened mr-3 size-5">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
											</svg>
											<span class="text-sm/6">Mark Articles Read</span>
										} else {
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail mr-3 size-5">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
											</svg>
											<span class="text-sm/6">Mark Articles Unread</span>
										}
									</span>
								</button>
							} else {
								// Show mark read/unread action when not viewing all articles.
								if response.Filters.GetView() != models.ViewAll {
									// Mark subscription action.
									{{
										values := make(map[string]any)
										values["subscription_id"] = response.Subscription.GetID()
										values["view"] = response.Filters.GetView()
										if response.Filters.GetView() == models.ViewUnread {
											values["mark"] = models.MarkRead
										} else {
											values["mark"] = models.MarkUnread
										}
									}}
									<button
										hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
										hx-vals={ templ.JSONString(values) }
										class="btn btn-wide btn-outline"
										type="submit"
									>
										<span class="show-loading items-center">
											<span class="loading mr-3 loading-spinner"></span>
											Loading
										</span>
										<span class="hide-loading items-center">
											if response.Filters.GetView() == models.ViewUnread {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened mr-3 size-5">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
												</svg>
												<span class="text-sm/6">Mark Subscription Read</span>
											} else {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail mr-3 size-5">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z"></path><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z"></path>
												</svg>
												<span class="text-sm/6">Mark Subscription Unread</span>
											}
										</span>
									</button>
								}
							}
						</nav>
						@partials.ButtonBackToTop()
					} else {
						{{ response.Filters.Subscriptions = nil }}
						@partials.NoContent()
					}
				</section>
			}
			// Watch for updates.
			<div
				id="updates"
				class="toast toast-center"
				hx-post="/list/articles/updates"
				hx-vals={ templ.JSONString(response.Filters.Values()) }
				hx-trigger="every 5m"
				hx-target="#updates"
			></div>
		}
	}
}

templ ShareArticleModal(request *models.ShareArticleRequest) {
	{{ id := string(request.ItemID) + "-share" }}
	// _={ "on click if navigator.share then " + shareAPIDialog(a.GetTitle(), a.GetLink()) + " else call document.getElementById('share-" + a.GetID() + "').show() then halt the event's bubbling" }
	@partials.Modal(id, true) {
		<div class="sm:flex sm:items-start">
			<span class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-12">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
				</svg>
			</span>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Share</h3>
				<div class="mt-2">
					<p class="text-sm">{ request.Title }</p>
				</div>
			</div>
		</div>
		<div class="mt-5 grid grid-flow-row grid-cols-3 items-center justify-center gap-x-2 gap-y-2 sm:mt-4">
			<a
				href={ fmt.Sprintf("mailto:?subject=%q&body=%s", html.EscapeString(request.Title), request.Link) }
				class="btn col-span-1 col-start-2"
			>
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
				</svg>
				Email
			</a>
			<div class="join col-span-3 flex space-x-2">
				<div class="flex-1">
					<label class="input join-item w-full">
						<input type="text" value={ request.Link } readonly/>
					</label>
				</div>
				<button
					_={ "on click set currentValue to (my innerHTML) then writeText('" + request.Link + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
					class="btn join-item flex items-center"
				>
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-copy size-4">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"></path><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"></path>
					</svg>
					Copy Link
				</button>
			</div>
		</div>
	}
}
