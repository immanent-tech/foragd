package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/sebasvil20/templicons/i"
	"github.com/sebasvil20/templicons/tabler"
	"net/http"
	"slices"
	"strings"
)

// Card renders an article as a card, for displaying in a list.
templ ArticleCard(article *models.Article, view models.View) {
	<li id={ article.GetID() }>
		<div
			class={ "card-base", templ.KV("opacity-50",!article.IsUnread()) }
		>
			// Header.
			<div class="px-4 py-5 sm:px-6">
				if img := article.GetImage(); img != nil {
					@NewLink(
						WithHXMethod(http.MethodGet, article.ViewURL()),
						WithHXTarget(ContentID.Target()),
						WithHXPushURL(),
					) {
						<div class="relative w-full">
							<img
								class="aspect-video w-full rounded-2xl bg-base-content-10 object-cover sm:aspect-2/1 lg:aspect-3/2"
								src={ img.GetURL() }
								if img.GetTitle() != "" {
									alt={ img.GetTitle() }
								}
							/>
							<div class="inset-0 rounded-2xl inset-ring inset-ring-base-content/20"></div>
						</div>
						<div class="flex max-w-xl grow flex-col justify-between">
							<div class="group relative grow">
								<h3 class="mt-3 text-lg/6 font-semibold text-pretty">
									if article.GetTitle() != "" {
										{ article.GetTitle() }
									} else {
										(no title)
									}
								</h3>
							</div>
						</div>
					}
				} else {
					@NewLink(
						WithHXMethod(http.MethodGet, article.ViewURL()),
						WithHXTarget(ContentID.Target()),
						WithHXPushURL(),
					) {
						<div class="group relative grow">
							<h3 class="mt-3 text-lg/6 font-semibold text-pretty">
								if article.GetTitle() != "" {
									{ article.GetTitle() }
								} else {
									(no title)
								}
							</h3>
						</div>
					}
				}
			</div>
			// Body.
			<div class="px-4 sm:px-6">
				<p class="text-xs/4 text-base-content/80 italic text-ellipsis">
					{ strings.Join(article.GetAuthors(),",") }
				</p>
			</div>
			<div class="px-4 py-5 sm:p-6">
				{{ text, err := models.ExtractText(article.GetContent()) }}
				if err == nil {
					<article class="prose prose-sm line-clamp-3">
						{ text }
					</article>
				}
			</div>
			// Footer.
			<div class="px-4 py-4 sm:px-6">
				<div class="flex items-center">
					<div class="flex flex-1">
						<p class="text-xs/4 text-base-content/80 capitalize">
							@ShowTimestamp(article.GetUpdatedDate())
						</p>
					</div>
					<div class="flex flex-1">
						@ContextMenu(article.GetTitle() + " Actions") {
							// Find similar action.
							@NewLink(
								WithHXMethod(http.MethodGet, article.ViewURL()+"/similar"),
								WithHXTarget(ContentID.Target()),
								WithHXPushURL(),
								WithClasses("menu-item"),
							) {
								@tabler.FileSearch(i.Props{Class: "size-4"})
								Find similar...
							}
							// Mark action.
							<form id={ "mark-" + article.GetID() }>
								<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
								if view == models.ViewAll {
									@MarkObjectLink(article, "#"+article.GetID(), "outerHTML", "menu-item")
								} else {
									@MarkObjectLink(article, "#"+article.GetID(), "delete", "menu-item")
								}
								// Favorite action. Wrapped in a div that can be targeted for hx-swapping.
							</form>
							<form>
								<input type="hidden" name="display" value="card"/>
								<div id={ "favorite_" + article.GetID() }>
									@FavoriteObjectLink(article, "menu-item")
								</div>
							</form>
							// Share action.
							<a
								_={ "on click set currentValue to (my innerHTML) then writeText('" + article.GetLink() + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
								class={ "link link-hover", "menu-item" }
							>
								@tabler.Share(i.Props{Class: "size-4"})
								Share
							</a>
							// Report issue action.
							<a
								hx-get={ article.IssueURL() }
								hx-target={ ContentID.Target() }
								class="link link-hover menu-item"
							>
								@tabler.FlagFilled(i.Props{Class: "size-4"})
								Report an issue
							</a>
						}
					</div>
				</div>
			</div>
		</div>
	</li>
}

// ArticleSummary renders a summary of the article with an image (if available) and snippet of the article content.
templ ArticleSummary(article *models.Article) {
	<div class={ "sm:flex items-center", templ.KV("opacity-50",!article.IsUnread()) }>
		if img := article.GetImage(); img != nil {
			<div class="mb-4 shrink-0 sm:mr-4 sm:mb-0">
				<img
					src={ img.GetURL() }
					if img.GetTitle() != "" {
						alt={ article.GetImage().GetTitle() }
					}
					class="h-32 sm:w-32 w-full object-cover sm:aspect-2/1 lg:aspect-3/2 rounded-box border border-base-content"
				/>
			</div>
		}
		<div class="space-y-4">
			<a
				hx-get={ article.ViewURL() }
				hx-target={ ContentID.Target() }
				hx-push-url="true"
				hx-swap="innerHTML show:top"
				class={ "link link-hover" }
			>
				<h4 class="text-lg font-bold">{ article.GetTitle() }</h4>
			</a>
			<div class="flex gap-x-4">
				<p class="flex-none text-xs text-base-content/80">
					@ShowTimestamp(article.GetUpdatedDate())
				</p>
				<p class="flex-none text-xs text-base-content/80">
					{ article.GetFeedTitle() }
				</p>
			</div>
			{{ text, err := models.ExtractText(article.GetContent()) }}
			if err == nil {
				<article class="prose prose-sm line-clamp-3">
					{ text }
				</article>
			}
		</div>
	</div>
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(article *models.Article) {
	@Main() {
		// Add the subscription ID as a hidden input that htmx can use for actions.
		<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
		// Article.
		<div class="flex justify-center">
			<article id={ article.GetID() } class="prose prose-sm sm:prose-lg w-full dark:prose-invert px-4 py-4 sm:px-6">
				<h2 class="flex items-center gap-x-2 text-xl font-bold text-pretty sm:text-2xl sm:tracking-tight">
					{ article.GetTitle() }
					// <a href={ article.GetLink() } target="_blank" rel="noopener" class="link link-hover hover:text-accent">
					// 	@tabler.ExternalLink(i.Props{Class: "size-8"})
					// </a>
				</h2>
				<p class="text-base-content/80 text-wrap italic">
					{ strings.Join(article.GetAuthors(),",") }
				</p>
				<p class="text-base-content/80 capitalize">
					@ShowTimestamp(article.GetUpdatedDate())
				</p>
				switch  {
					case article.GetContent() != "":
						@templ.Raw(article.GetContent())
					case article.GetDescription() != "":
						@templ.Raw(article.GetDescription())
				}
			</article>
		</div>
		// Actions menu.
		<div class="fixed bottom-20 sm:bottom-4 right-4">
			<button popovertarget="article-actions" class="btn btn-circle btn-primary" type="button">
				<label class="swap">
					<input type="checkbox"/>
					@tabler.Menu(i.Props{Class: "swap-off size-6"})
					@tabler.X(i.Props{Class: "swap-on size-6"})
				</label>
			</button>
			<el-popover popover id="article-actions" anchor="top end" class="bg-base-100/0 [--anchor-gap:4px] data-closed:opacity-0 data-enter:duration-75 data-enter:ease-out data-leave:duration-100 data-leave:ease-in">
				<ul class="grid space-y-2 text-sm justify-items-end">
					// Toggle full content.
					<li>
						<form
							hx-get={ article.ViewURL() }
							hx-target={ ContentID.Target() }
							hx-include="[name='csrf_token']"
						>
							<input
								type="hidden"
								name={ models.ParamFullArticleContent }
								if article.ShowFullContent {
									value="false"
								} else {
									value="true"
								}
							/>
							<span class="badge badge-primary badge-soft shadow-sm">Toggle Full Content</span>
							<button type="submit" class="btn btn-circle btn-primary btn-soft shadow-sm">
								@tabler.FileDownloadFilled(i.Props{Class: "size-5"})
							</button>
						</form>
					</li>
					// View original article action.
					<li>
						<span class="badge badge-primary badge-soft shadow-sm">View Article Externally</span>
						<a role="btn" href={ article.GetLink() } target="_blank" rel="noopener" class="btn btn-circle btn-primary btn-soft shadow-sm">
							@tabler.ExternalLink(i.Props{Class: "size-5"})
						</a>
					</li>
					// Mark article action.
					<li>
						<form>
							<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
							<div id={ "mark_" + article.GetID() }>
								@UpdateViewArticleMark(article)
							</div>
						</form>
					</li>
					// Favorite action.
					<li>
						<form>
							<input type="hidden" name="display" value="content"/>
							<div id={ "favorite_" + article.GetID() }>
								@UpdateViewArticleFavorite(article)
							</div>
						</form>
					</li>
					// Share action.
					<li>
						<span class="badge badge-primary badge-soft shadow-sm">Share Article</span>
						<a
							role="btn"
							_={ "on click set currentValue to (my innerHTML) then writeText('" + article.GetLink() + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
							class="btn btn-circle btn-primary btn-soft shadow-sm"
						>
							@tabler.Share(i.Props{Class: "size-5"})
						</a>
					</li>
					// Report issue action.
					<li>
						<span class="badge badge-primary badge-soft shadow-sm">Report Article Issue</span>
						<a
							role="btn"
							hx-get={ article.IssueURL() }
							hx-target={ ContentID.Target() }
							class="btn btn-circle btn-primary btn-soft shadow-sm"
						>
							@tabler.Flag(i.Props{Class: "size-5"})
						</a>
					</li>
				</ul>
			</el-popover>
		</div>
		// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is read and mark it so.
		if article.IsUnread() {
			<div
				hx-post={ article.MarkURL() }
				hx-target={ "#mark_" + article.GetID() }
				hx-include="[name='csrf_token']"
				hx-vals={ models.GenerateHXVals(map[string]string{models.ParamSubscriptionID: article.GetSubscriptionID(), models.ParamMark: string(models.MarkRead)}) }
				hx-swap="innerHTML"
				hx-trigger="intersect once,load delay:10s"
				hx-push-url="false"
				_="on htmx:afterRequest remove me"
			></div>
		}
	}
}

// UpdateViewArticleMark updates the mark action when viewing an article.
templ UpdateViewArticleMark(article *models.Article) {
	switch article.IsUnread() {
		case true:
			<span class="badge badge-primary badge-soft shadow-sm">Mark Read</span>
		case false:
			<span class="badge badge-primary badge-soft shadow-sm">Mark Unread</span>
	}
	@NewLink(
		WithHXMethod(http.MethodPost, article.MarkURL()),
		WithHXTarget("#mark_"+article.GetID()),
		WithHXInclude("[name='csrf_token']"),
		WithClasses("btn btn-circle btn-primary btn-soft shadow-sm"),
		WithCustomAttribute("role", "btn"),
	) {
		switch article.IsUnread() {
			case true:
				@tabler.MailOpenedFilled(i.Props{Class: "size-5"})
			case false:
				@tabler.MailFilled(i.Props{Class: "size-5"})
		}
	}
}

// UpdateViewArticleFavorite updates the favorite action when viewing an article.
templ UpdateViewArticleFavorite(article *models.Article) {
	switch article.IsFavorite() {
		case true:
			<span class="badge badge-primary badge-soft shadow-sm">Remove Favorite</span>
		case false:
			<span class="badge badge-primary badge-soft shadow-sm">Add Favorite</span>
	}
	@NewLink(
		WithHXMethod(http.MethodPost, article.FavoriteURL()),
		WithHXTarget("#favorite_"+article.GetID()),
		WithHXInclude("[name='csrf_token']"),
		WithHXVals(map[string]string{"display": "content"}),
		WithClasses("btn btn-circle btn-primary btn-soft shadow-sm"),
		WithCustomAttribute("role", "btn"),
	) {
		switch article.Favorite {
			case true:
				@tabler.HeartFilled(i.Props{Class: "size-5"})
			case false:
				@tabler.Heart(i.Props{Class: "size-5"})
		}
	}
}

templ ArticlesGrid(articles models.Articles, pagination models.Pagination) {
	{{ filters := models.PageFiltersFromCtx(ctx, "/list/articles") }}
	@Main() {
		<div class="flex items-center justify-between mt-4">
			<div class="min-w-0 flex-1">
				<h2 class="text-2xl/7 font-bold sm:truncate sm:text-3xl sm:tracking-tight">Articles</h2>
			</div>
			<el-dropdown class="inline-block flex-none">
				<button class="inline-flex flex-col items-center">
					<span class="sr-only">Articles Actions</span>
					@tabler.DotsVertical(i.Props{Class: "size-6"})
				</button>
				<el-menu anchor="bottom end" popover class="origin-top-right divide-y divide-base-content/50 rounded-md bg-base-300 shadow-lg outline-1 outline-accent/50 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
					<div class="py-1">
						// Mark all subscriptions action.
						@NewLink(
							WithHXMethod(http.MethodPost, "/list/articles/mark"),
							WithHXTarget(ContentID.Target()),
							WithHXInclude("#content-filters,[name='csrf_token']"),
							WithClasses("group/item", "flex", "items-center", "px-4", "py-2", "text-sm", "space-x-2", "focus:text-accent", "focus:outline-hidden"),
						) {
							if models.PageFiltersFromCtx(ctx,"/list/articles").GetView() == models.ViewUnread {
								@tabler.MailOpenedFilled(i.Props{Class: "size-4"})
								<span class="sr-only">Mark All Read</span>
								Mark all Read
							} else {
								@tabler.MailFilled(i.Props{Class: "size-4"})
								<span class="sr-only">Mark All Unread</span>
								Mark all Unread
							}
						}
					</div>
				</el-menu>
			</el-dropdown>
		</div>
		<div id="content-filters" class="hidden">
			<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
			<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
			<input type="hidden" name={ models.ParamSortBy } value={ string(filters.GetSort().SortBy) }/>
			<input type="hidden" name={ models.ParamSortOrder } value={ string(filters.GetSort().SortOrder) }/>
			if len(filters.GetCategories()) > 0 {
				<input type="hidden" name={ models.ParamCategories } value={ strings.Join(filters.GetCategories(), ",") }/>
			}
			if len(filters.GetSubscriptions()) > 0 {
				<input type="hidden" name={ models.ParamSubscriptions } value={ strings.Join(filters.GetSubscriptions(), ",") }/>
			}
		</div>
		<div id="update-notifications" sse-connect={ "/list/articles/updates?" + filters.QueryString() } sse-swap="message" class="toast toast-center z-50"></div>
		@ListDisplayFilters(articles.GetCategoryCounts(), filters)
		@Grid() {
			@ArticlesList(articles, pagination)
		}
	}
}

templ ArticlesList(articles models.Articles, pagination models.Pagination) {
	{{ filters := models.PageFiltersFromCtx(ctx, "/list/articles") }}
	for article := range slices.Values(articles) {
		@ArticleCard(article, filters.GetView())
	}
	// Add pagination element if pagination is required.
	if pagination != "" && len(articles) == filters.GetCount() {
		// Add pagination htmx props to last article.
		@PaginationControl(ctx, "/list/articles/paginate", pagination)
	}
}
