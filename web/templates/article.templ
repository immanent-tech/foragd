package templates

import (
	"fmt"
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/server/session"
	"github.com/immanent-tech/foragd/web/templates/element"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"html"
	"strconv"
	"strings"
)

// Card renders an article as a card, for displaying in a list.
templ ArticleCard(idx int, article *models.Article) {
	<article
		style={ "--i: " + strconv.Itoa(idx) }
		hx-get={ "/view/article/" + article.GetID() }
		hx-target={ ContentID.Target() }
		hx-swap="innerHTML show:window:top transition:true"
		hx-trigger="click"
		hx-push-url="true"
		hx-disinherit="*"
		tabindex="0"
		id={ article.GetID() }
		class={
			"card bg-base-200 h-full w-full max-w-prose cursor-pointer touch-manipulation focus:outline-primary active:scale-[0.96] hover:scale-[0.99] transition-transform duration-150",
			templ.KV("row-span-1", article.GetImage() == nil),
			templ.KV("row-span-2", article.GetImage() != nil),
		}
		_="on keydown[key=='Enter' or key==' '] trigger click"
		aria-label={ article.GetTitle() }
	>
		if img := article.GetImage(); img != nil {
			{{ img := article.GetImage() }}
			if img.GetTitle() == "" {
				{{ img.Title = new(article.GetTitle()) }}
			}
			<figure>
				@partials.NewProxiedImage(img, "rs:auto:400:300/sh:0.5/q:80/el:1/ex:1/gravity:sm/sm:1/kcr:1/scp:1/ext:webp",
					element.WithAttribute("width", "400"),
					element.WithAttribute("height", "300"),
					element.WithClasses("card-img"),
				)
			</figure>
		}
		// Hidden inputs used for some group article actions.
		<input type="hidden" name={ "displayed_articles[" + article.GetSubscriptionID() + "]" } value={ article.GetID() }/>
		<div class="card-body">
			<div class="mt-auto card-title line-clamp-3 tracking-tight text-balance">
				if article.GetTitle() != "" {
					{ article.GetTitle() }
				} else {
					(no title)
				}
			</div>
			// Author and subscription details.
			<div class="mb-4 grid grid-flow-row grid-cols-1">
				if len(article.GetAuthors()) > 0 {
					<p class="inline-block truncate text-xs/4 italic">
						{ strings.Join(article.GetAuthors(),",") }
					</p>
				}
				<p class="inline-block truncate text-xs/4">
					<a
						hx-get="/list/articles"
						hx-target={ ContentID.Target() }
						hx-swap="innerHTML show:window:top transition:true"
						hx-trigger="click consume"
						hx-vals={ generateHXVals(map[string]any{models.ParamView: models.ViewUnread, models.ParamSubscriptions: article.GetSubscriptionID()}) }
						class="link truncate link-hover"
					>
						{ article.GetFeedTitle() }
					</a>
				</p>
			</div>
			// Add summarised description if article has one.
			if article.GetDescription() != "" {
				<div class="prose-summary">
					@templ.Raw(article.GetDescription())
				</div>
			}
			<div class="mt-auto card-actions items-center justify-between">
				// Timestamp.
				<div class="flex flex-1 gap-x-2">
					<span class="label text-xs/4 capitalize">
						Updated&nbsp;
						<relative-time
							datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
							format="relative"
						>
							{ article.GetUpdatedDate().Format("ANSIC") }
						</relative-time>
					</span>
				</div>
				<button class="btn btn-square btn-ghost btn-md">
					<form>
						<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
						<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
						<label class="swap touch-manipulation" _="on click halt the event's bubbling">
							<input
								hx-post={ "/favorite/article/" + article.GetID() }
								hx-swap="none"
								id={ article.GetID() + "-favorite-state" }
								type="checkbox"
								if article.IsFavorite() {
									checked
								}
								_="on htmx:afterRequest(failed) toggle @checked on me"
								aria-label={ "Toggle favorite status for " + article.GetTitle() }
							/>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-heart swap-on size-5 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z"></path>
							</svg>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart swap-off size-5 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
							</svg>
						</label>
					</form>
				</button>
				<button class="btn btn-square btn-ghost btn-md">
					<form>
						<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
						<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
						<input
							type="hidden"
							name={ models.ParamMark }
							if article.IsUnread() {
								value={ models.MarkRead }
							} else {
								value={ models.MarkUnread }
							}
						/>
						<label class="swap touch-manipulation" _="on click halt the event's bubbling">
							<input
								hx-post={ "/mark/article/" + article.GetID() }
								hx-swap="none"
								id={ article.GetID() + "-read-state" }
								type="checkbox"
								if !article.IsUnread() {
									checked
								}
								_="
					on htmx:afterRequest(successful)
					tell the previous <input />
						get your value
						if your value equals 'read'
						set your value to 'unread'
						else
						set your value to 'read'
						end
					on htmx:afterRequest(failed) toggle @checked on me
					"
								aria-label={ "Toggle read status for " + article.GetTitle() }
							/>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail-opened swap-on size-5 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 9l9 6l9 -6l-9 -6l-9 6"></path><path d="M21 9v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 19l6 -6"></path><path d="M15 13l6 6"></path>
							</svg>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
							</svg>
						</label>
					</form>
				</button>
				// Actions menu.
				<div class="flex flex-none">
					<el-dropdown class="relative ml-auto touch-manipulation" _="on click halt the event's bubbling">
						<button class="btn btn-square btn-ghost btn-md">
							<span class="sr-only">{ article.GetTitle() + " Actions" }</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 size-5 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path>
							</svg>
						</button>
						<el-menu
							anchor="bottom end"
							popover
							_="on htmx:afterRequest(successful) hidePopover() on me"
							class="w-fit"
						>
							<ul class="menu">
								// View original article action.
								<li>
									<a
										href={ article.GetLink() }
										target="_blank"
										rel="noopener"
										_="on click halt the event's bubbling"
										role="menuitem"
										tabindex="-1"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path><path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
										</svg>
										Go To Article
									</a>
								</li>
								// Find similar action.
								<li>
									<a
										role="menuitem"
										tabindex="-1"
										hx-get={ "/view/article/" + article.GetID() + "/similar" }
										hx-target={ ContentID.Target() }
										hx-trigger="click consume"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-search size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M12 21h-5a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v4.5"></path><path d="M14 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0"></path><path d="M18.5 19.5l2.5 2.5"></path>
										</svg>
										Find similar...
									</a>
								</li>
								// Mobile share action via navigator API.
								<li _="init if not navigator.share then hide me">
									<a
										role="menuitem"
										tabindex="-1"
										_={ "on click " + fmt.Sprintf("navigator.share({title: %q, url: %q})", article.GetTitle(), article.GetLink()) + "then halt the event's bubbling" }
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
										</svg>
										Share
									</a>
								</li>
								// Desktop share action with modal and options.
								<li _="init if navigator.share then hide me">
									<form>
										<input type="hidden" name="item_id" value={ article.GetID() }/>
										<input type="hidden" name="title" value={ article.GetTitle() }/>
										<input type="hidden" name="link" value={ article.GetLink() }/>
										<a
											role="menuitem"
											tabindex="-1"
											hx-post={ "/share/article/" + article.GetID() }
											hx-target={ partials.ModalContainerID.Target() }
											hx-trigger="click consume"
											class="flex items-center gap-x-2"
										>
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
												<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
											</svg>
											Share
										</a>
									</form>
								</li>
								// Report issue action.
								<li>
									<a
										role="menuitem"
										tabindex="-1"
										hx-get={ "/issue/article/" + article.GetID() }
										hx-target={ ContentID.Target() }
										hx-replace-url="true"
										hx-trigger="click consume"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-flag-2 size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19 4a1 1 0 0 1 .993 .883l.007 .117v9a1 1 0 0 1 -.883 .993l-.117 .007h-13v6a1 1 0 0 1 -.883 .993l-.117 .007a1 1 0 0 1 -.993 -.883l-.007 -.117v-16a1 1 0 0 1 .883 -.993l.117 -.007h14z"></path>
										</svg>
										Report an issue
									</a>
								</li>
							</ul>
						</el-menu>
					</el-dropdown>
				</div>
			</div>
		</div>
	</article>
}

// ArticleContent renders the complete content of an article.
templ ArticleContent(article *models.Article) {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				// Add the subscription ID as a hidden input that htmx can use for actions.
				<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
				<article id={ article.GetID() } class="w-full sm:mx-auto sm:max-w-prose">
					// Article title.
					<div class="flex flex-1 pb-2">
						if article.SourceType != models.SourceTypeEmail {
							<a
								href={ article.GetLink() }
								target="_blank"
								rel="noopener"
								class="link link-hover focus:text-primary focus:outline-hidden"
							>
								<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
							</a>
						} else {
							<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ article.GetTitle() }</h1>
						}
					</div>
					// Subscription link.
					<div class="flex flex-1 pb-4">
						<form>
							{{ filters := session.GetListArticleFiltersFromSession(ctx) }}
							<input type="hidden" name={ models.ParamView } value={ filters.GetView() }/>
							<input type="hidden" name={ models.ParamCount } value={ filters.GetCount() }/>
							<input type="hidden" name={ models.ParamSort } value={ filters.GetSort() }/>
							<input type="hidden" name={ models.ParamSubscriptions } value={ article.GetSubscriptionID() }/>
							<input type="hidden" name={ models.ParamSubscriptionName } value={ article.GetFeedTitle() }/>
							<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
							<a
								hx-post="/list/articles"
								hx-target={ ContentID.Target() }
								hx-swap="innerHTML show:window:top transition:true"
								class="link link-hover focus:text-primary focus:outline-hidden"
							>
								{  article.GetFeedTitle() }
							</a>
						</form>
					</div>
					<div class="flex items-center">
						<div class="inline-grid flex-1">
							if article.SourceType != models.SourceTypeEmail {
								// Show authors if found.
								if len(article.GetAuthors()) > 0 {
									<p class="col-span-full truncate text-sm/6 italic">
										{ strings.Join(article.GetAuthors(),",") }
									</p>
								}
							}
							// Show updated date.
							<p class="col-span-full text-sm/6 capitalize">
								Updated&nbsp;
								<relative-time
									datetime={ article.GetUpdatedDate().Format("2006-01-02T15:04:05-0700") }
									format="relative"
								>
									{ article.GetUpdatedDate().Format("ANSIC") }
								</relative-time>
							</p>
						</div>
						<form class="p-2 btn btn-ghost btn-square">
							<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
							<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
							<label class="swap" _="on click halt the event's bubbling">
								<input
									hx-post={ "/favorite/article/" + article.GetID() }
									hx-swap="none"
									id={ article.GetID() + "-favorite-state" }
									type="checkbox"
									if article.IsFavorite() {
										checked
									}
									_="on htmx:afterRequest(failed) toggle @checked on me"
									aria-label="Toggle favorite status"
								/>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-heart swap-on size-5 text-primary">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z"></path>
								</svg>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart swap-off size-5 text-primary">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
								</svg>
							</label>
						</form>
						<form class="p-2 btn btn-ghost btn-square">
							<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
							<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
							<input
								type="hidden"
								name={ models.ParamMark }
								if article.IsUnread() {
									value={ models.MarkRead }
								} else {
									value={ models.MarkUnread }
								}
							/>
							<label class="swap" _="on click halt the event's bubbling">
								<input
									hx-post={ "/mark/article/" + article.GetID() }
									hx-swap="none"
									id={ article.GetID() + "-read-state" }
									type="checkbox"
									if !article.IsUnread() {
										checked
									}
									_="
					on htmx:afterRequest(successful)
					tell the previous <input />
						get your value
						if your value equals 'read'
						set your value to 'unread'
						else
						set your value to 'read'
						end
					on htmx:afterRequest(failed) toggle @checked on me
					"
									aria-label="Toggle read status"
								/>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail-opened swap-on size-5 text-primary">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 9l9 6l9 -6l-9 -6l-9 6"></path><path d="M21 9v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 19l6 -6"></path><path d="M15 13l6 6"></path>
								</svg>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
								</svg>
							</label>
						</form>
						<div class="flex items-center justify-end">
							<el-dropdown>
								<button
									class="btn btn-square btn-ghost"
								>
									<span class="sr-only">Article Actions</span>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 size-5 text-primary">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path>
									</svg>
								</button>
								<el-menu
									anchor="bottom end"
									popover
									_="on htmx:afterRequest(successful) hidePopover() on me"
									class="w-fit"
								>
									<ul class="menu">
										// Find similar action.
										<li>
											<a
												hx-get={ "/view/article/" + article.GetID() + "/similar" }
												hx-target={ ContentID.Target() }
												hx-trigger="click consume"
												role="menuitem"
											>
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-search size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M12 21h-5a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v4.5"></path><path d="M14 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0"></path><path d="M18.5 19.5l2.5 2.5"></path>
												</svg>
												Find similar...
											</a>
										</li>
										// Report article issue action.
										<li>
											<a
												hx-get={ "/issue/article/" + article.GetID() }
												hx-target={ ContentID.Target() }
												hx-replace-url="true"
												hx-trigger="click consume"
												role="menuitem"
											>
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-flag-2 size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19 4a1 1 0 0 1 .993 .883l.007 .117v9a1 1 0 0 1 -.883 .993l-.117 .007h-13v6a1 1 0 0 1 -.883 .993l-.117 .007a1 1 0 0 1 -.993 -.883l-.007 -.117v-16a1 1 0 0 1 .883 -.993l.117 -.007h14z"></path>
												</svg>
												Report an issue
											</a>
										</li>
									</ul>
								</el-menu>
							</el-dropdown>
						</div>
					</div>
					// Content.
					switch  {
						case article.SourceType == models.SourceTypeEmail:
							// Article from email newsletter.
							<div
								class="prose-email mt-4 forced-width"
								data-disable-scripting
								hx-disable
							>
								@templ.Raw(article.GetContent())
							</div>
						case article.Item.ExtensionType != nil && *article.Item.ExtensionType == models.ItemExtensionTypeYoutube:
							// Youtube video.
							if youtubeData, err := article.Item.ExtensionData.AsItemExtensionYoutube(); err == nil {
								<div class="mt-8">
									<embed-youtube
										video-id={ youtubeData.VideoId }
										width={ *youtubeData.Width }
										height={ *youtubeData.Height }
										origin="https://foragd.app"
										credentialless
									></embed-youtube>
								</div>
							}
							if article.GetDescription() != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4 forced-width"
								>
									@templ.Raw(article.GetDescription())
								</div>
							}
							<nav class="my-16 flex flex-col items-center justify-center gap-2 text-sm sm:flex-row">
								@shareArticleButton(article)
							</nav>
						default:
							// Try to display content or description.
							if article.GetContent() != "" || article.GetDescription() != "" {
								<div
									data-disable-scripting
									hx-disable
									class="prose-article mt-4 forced-width"
									if article.ShowFullContent {
										transition-style="in:wipe:down"
									}
								>
									switch  {
										case article.GetContent() != "":
											@templ.Raw(article.GetContent())
										case article.GetDescription() != "":
											@templ.Raw(article.GetDescription())
									}
								</div>
							}
							<nav class="my-16 flex flex-col items-center justify-center gap-2 text-sm sm:flex-row">
								// Show a toggle for fetching full content where it appears the feed content is only a summary
								// if len(strings.Fields(a.GetContent())) < 100 && !a.IsRemoteContent() {
								<a
									role="button"
									class="btn btn-wide btn-outline"
									hx-get={ "/view/article/" + article.GetID() }
									hx-target={ ContentID.Target() }
									hx-swap="innerHTML transition:true"
									hx-replace-url="true"
									hx-trigger="click consume"
									hx-indicator="#content-loading"
									hx-vals={ generateHXVals(map[string]any{models.ParamFullArticleContent: strconv.FormatBool(!article.IsRemoteContent())}) }
								>
									// _="on htmx:afterResponse[detail.failed] add @disabled to me"
									if article.IsRemoteContent() {
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-rss">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17a3 3 0 0 0 -3 -3"></path><path d="M15 17a6 6 0 0 0 -6 -6"></path><path d="M9 17h.01"></path>
										</svg>
										Show Feed Content
									} else {
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-download">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17v-6"></path><path d="M9.5 14.5l2.5 2.5l2.5 -2.5"></path>
										</svg>
										Get Remote Content
									}
								</a>
								// View original article action.
								<a
									role="button"
									class="btn btn-wide btn-outline"
									href={ article.GetLink() }
									target="_blank"
									rel="noopener"
									_="on click halt the event's bubbling"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-external-link size-4">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path><path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
									</svg>
									View Remote
								</a>
								@shareArticleButton(article)
							</nav>
					}
				</article>
				@partials.LoadingIndicator("")
				@partials.ButtonBackToTop()
				// If the article is unread, after a delay or when the user scrolls this div into view, assume the article is
				// read and mark it so (when the user has set this option).
				if article.IsUnread() && article.MarkArticleReadOnView {
					<form
						id="auto-mark-read"
						hx-target="#auto-mark-read"
						hx-post={ "/mark/article/" + article.GetID() }
						hx-swap="delete transition:false"
						hx-trigger="intersect once delay:5s,load delay:5s"
						aria-hidden="true"
						_={ "on htmx:afterRequest(successful) toggle @checked on #" + article.GetID() + "-read-state" }
					>
						<input type="hidden" name={ models.ParamItemID } value={ article.GetID() }/>
						<input type="hidden" name={ models.ParamSubscriptionID } value={ article.GetSubscriptionID() }/>
						<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
					</form>
				}
			}
		}
	}
}

templ shareArticleButton(a *models.Article) {
	// Mobile share action via navigator API.
	<div class="flex w-full justify-center" _="init if not navigator.share then hide me">
		<button
			class="btn btn-wide btn-outline"
			_={ "on click " + fmt.Sprintf("navigator.share({title: %q, url: %q})", a.GetTitle(), a.GetLink()) + "then halt the event's bubbling" }
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
			</svg>
			Share
		</button>
	</div>
	// Desktop share action with modal and options.
	<form class="flex w-full justify-center" _="init if navigator.share then hide me">
		<input type="hidden" name="item_id" value={ a.GetID() }/>
		<input type="hidden" name="title" value={ a.GetTitle() }/>
		<input type="hidden" name="link" value={ a.GetLink() }/>
		<button
			class="btn btn-wide btn-outline"
			hx-post={ "/share/article/" + a.GetID() }
			hx-target={ partials.ModalContainerID.Target() }
			hx-trigger="click consume"
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-4">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
			</svg>
			Share
		</button>
	</form>
}

// ListArticles renders the list of articles in a grid layout with filtering controls and an actions menu.
templ ListArticles(response *models.ListArticlesResponse) {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				// Watch for updates.
				<div
					id="update-notifications"
					sse-connect={ "/list/articles/updates?" + response.Filters.QueryString() }
					sse-swap="updates"
					class="toast toast-center z-50"
				></div>
				// Show a page header.
				<div class="md:flex md:items-center md:justify-between">
					<div class="min-w-0 flex-1">
						{{ var title string }}
						if response.Subscription != nil {
							{{ title = response.Subscription.GetTitle() }}
						} else {
							{{ title = "Articles" }}
						}
						<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">{ title }</h1>
					</div>
					<p aria-live="polite" class="mt-4 mb-2 flex space-x-4 sm:mt-8 sm:mb-4 md:ml-4">
						<span class="text-lg font-medium capitalize">{ response.Filters.GetView() }</span>
						<span class="text-lg font-medium capitalize">{ response.Filters.GetSort().String() }</span>
					</p>
				</div>
				<div
					if response.Subscription != nil {
						hx-vals={ templ.JSONString(map[string]string{models.ParamSubscriptionID: response.Subscription.GetID()}) }
					}
				>
					@FilterControls("/list/articles", &response.Filters) {
						<el-dropdown class="inline-block flex-none">
							<button id="articles-actions-button" class="btn inline-flex btn-wide">
								Actions
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down -mr-1 size-5 transform transition-transform duration-200 not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
								</svg>
							</button>
							<el-menu
								id="articles-actions-menu"
								anchor="bottom start"
								popover
								_="
						on keydown from body if the event's key is 'x' and event.altKey then togglePopover() on me end
						on htmx:afterRequest(successful) hidePopover() on me
						"
								class="w-fit"
							>
								<ul class="menu">
									if response.Subscription == nil {
										if len(response.Articles) > 0 {
											// Mark all articles action.
											<form class="flex w-full items-center">
												<li>
													<a
														role="menuitem"
														tabindex="-1"
														if response.Filters.GetView() == models.ViewUnread {
															hx-post="/list/articles/mark/read"
														} else {
															hx-post="/list/articles/mark/unread"
														}
														hx-target={ ContentID.Target() }
														hx-include="article > input"
													>
														if response.Filters.GetView() == models.ViewUnread {
															<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4">
																<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
															</svg>
															Mark Articles Read
															<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
														} else {
															<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail size-4">
																<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
															</svg>
															Mark Articles Unread
															<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
														}
													</a>
												</li>
											</form>
										} else {
											<li>
												<p class="px-4 py-2 italic">No actions.</p>
											</li>
										}
									} else {
										// Show mark read/unread action when not viewing all articles.
										if response.Filters.GetView() != models.ViewAll {
											// Mark subscription action.
											<form id={ "mark-" + response.Subscription.GetID() } class="flex w-full items-center">
												<input type="hidden" name={ models.ParamSubscriptionID } value={ response.Subscription.GetID() }/>
												<input type="hidden" name={ models.ParamView } value={ response.Filters.GetView() }/>
												// MarkURL returns the app URL for marking the subscription.
												<li>
													<a
														hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
														role="menuitem"
														tabindex="-1"
													>
														if response.Filters.GetView() == models.ViewUnread {
															<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4">
																<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
															</svg>
															Mark Subscription Read
															<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
														} else {
															<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail size-4">
																<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z"></path><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z"></path>
															</svg>
															Mark Subscription Unread
															<input type="hidden" name={ models.ParamMark } value={ models.MarkUnread }/>
														}
													</a>
												</li>
											</form>
										}
										// Edit subscription action.
										<li>
											<a
												hx-get={ "/subscription/edit/" + response.Subscription.GetID() }
												hx-target={ ContentID.Target() }
												hx-params="not subscription_id"
												role="menuitem"
												tabindex="-1"
											>
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-edit size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"></path><path d="M16 5l3 3"></path>
												</svg>
												Edit Subscription
											</a>
										</li>
									}
								</ul>
							</el-menu>
						</el-dropdown>
					}
				</div>
				<section class="mt-4">
					if len(response.Articles) > 0 {
						@grid(
							element.WithAttribute("hx-indicator", ""),
							element.WithClasses("content-auto"),
						) {
							@templ.Fragment(PaginateFragment) {
								for idx, article := range response.Articles {
									@ArticleCard(idx, article)
								}
								// Add pagination element if pagination is required.
								if response.Pagination != "" && len(response.Articles) == response.Filters.GetCount() {
									<form
										class="invisible"
										hx-post="/list/articles/paginate"
										hx-vals={ generateHXVals(response.Filters.Values()) }
										hx-trigger="intersect once"
										hx-target="#grid-objects"
										hx-swap="beforeend transition:false"
										hx-indicator="#loading-articles"
										preload
										preload-images="true"
										_="on htmx:afterRequest remove me"
									>
										<input type="hidden" name={ models.ParamPagination } value={ response.Pagination }/>
									</form>
								}
							}
						}
						// Show some actions at the bottom of the list.
						<nav class="my-16 flex flex-col items-center justify-center gap-2 text-sm sm:flex-row">
							if response.Subscription == nil {
								// Mark all articles action.
								<form class="flex w-full items-center">
									<li>
										<a
											role="button"
											class="btn btn-wide btn-outline"
											if response.Filters.GetView() == models.ViewUnread {
												hx-post="/list/articles/mark/read"
											} else {
												hx-post="/list/articles/mark/unread"
											}
											hx-target={ ContentID.Target() }
											hx-include="article > input"
										>
											if response.Filters.GetView() == models.ViewUnread {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
												</svg>
												Mark Articles Read
												<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
											} else {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
												</svg>
												Mark Articles Unread
												<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
											}
										</a>
									</li>
								</form>
							} else {
								// Show mark read/unread action when not viewing all articles.
								if response.Filters.GetView() != models.ViewAll {
									// Mark subscription action.
									<form id={ "mark-" + response.Subscription.GetID() } class="flex w-full items-center justify-center">
										<input type="hidden" name={ models.ParamSubscriptionID } value={ response.Subscription.GetID() }/>
										<input type="hidden" name={ models.ParamView } value={ response.Filters.GetView() }/>
										// MarkURL returns the app URL for marking the subscription.
										<button
											hx-post={ "/mark/subscription/" + response.Subscription.GetID() }
											class="btn btn-wide btn-outline"
											type="submit"
										>
											if response.Filters.GetView() == models.ViewUnread {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
												</svg>
												Mark Subscription Read
												<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
											} else {
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail size-4">
													<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z"></path><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z"></path>
												</svg>
												Mark Subscription Unread
												<input type="hidden" name={ models.ParamMark } value={ models.MarkUnread }/>
											}
										</button>
									</form>
								}
							}
						</nav>
						@partials.LoadingIndicator("loading-articles")
						@partials.ButtonBackToTop()
					} else {
						{{ response.Filters.Subscriptions = nil }}
						@partials.NoContent()
					}
				</section>
			}
		}
	}
}

templ ShareArticleModal(request *models.ShareArticleRequest) {
	{{ id := string(request.ItemID) + "-share" }}
	// _={ "on click if navigator.share then " + shareAPIDialog(a.GetTitle(), a.GetLink()) + " else call document.getElementById('share-" + a.GetID() + "').show() then halt the event's bubbling" }
	@partials.Modal(id, true) {
		<div class="sm:flex sm:items-start">
			<span class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full sm:mx-0 sm:size-10">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-share size-12">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M15 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M8.7 10.7l6.6 -3.4"></path><path d="M8.7 13.3l6.6 3.4"></path>
				</svg>
			</span>
			<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
				<h3 id="dialog-title" class="text-base font-semibold">Share</h3>
				<div class="mt-2">
					<p class="text-sm">{ request.Title }</p>
				</div>
			</div>
		</div>
		<div class="mt-5 grid grid-flow-row grid-cols-3 items-center justify-center gap-x-2 gap-y-2 sm:mt-4">
			<a
				href={ fmt.Sprintf("mailto:?subject=%q&body=%s", html.EscapeString(request.Title), request.Link) }
				class="btn col-span-1 col-start-2"
			>
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail swap-off size-5 text-primary">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
				</svg>
				Email
			</a>
			<div class="join col-span-3 flex space-x-2">
				<div class="flex-1">
					<label class="input join-item w-full">
						<input type="text" value={ request.Link } readonly/>
					</label>
				</div>
				<button
					_={ "on click set currentValue to (my innerHTML) then writeText('" + request.Link + "') on navigator.clipboard put 'Copied!' into me wait 1s put currentValue into me" }
					class="btn join-item flex items-center"
				>
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-copy size-4">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"></path><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"></path>
					</svg>
					Copy Link
				</button>
			</div>
		</div>
	}
}
