package templates

import (
	"encoding/base64"
	"github.com/immanent-tech/go-syndication/types"
)

templ largeImage(img *types.ImageInfo, altTitle string, classes ...string) {
	<img
		class={ "rounded-box responsive-img border border-base-content", classes }
		src={ "/img-proxy/300x200/" + base64.RawURLEncoding.EncodeToString([]byte(img.GetURL())) }
		height="300"
		width="200"
		if img.GetTitle() != "" {
			alt={ img.GetTitle() }
		} else {
			alt={ altTitle }
		}
	/>
}
