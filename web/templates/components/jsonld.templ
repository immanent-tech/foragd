package components

import (
	"github.com/indaco/teseo/opengraph"
	"github.com/indaco/teseo/schemaorg"
	"net/url"
)

templ SiteJSONLD(baseURL *url.URL) {
	@schemaorg.NewWebSite(baseURL.String(),
		"Foragd",
		"Foragd RSS and Atom Feed Reader",
		"Foragd is a web-based RSS and Atom Feed Reader with a responsive design, no ads and no algorithm directing you.",
		nil,
	).ToJsonLd()
}

templ SiteOG(baseURL *url.URL) {
	@opengraph.NewWebSite("Foragd",
		baseURL.String(),
		"Foragd is a web-based RSS and Atom Feed Reader with a responsive design, no ads and no algorithm directing you.",
		baseURL.Clone().JoinPath("/images/logo-vertical-light.webp").String(),
	).ToMetaTags()
}

var sameAs = []string{
	"https://github.com/immanent-tech",
}

var OrgJSONLD = schemaorg.NewOrganization(
	"Immanent Tech",
	"https://immanent.tech",
	"https://immanent.tech/images/immanent-tech-icon-dark.svg",
	nil,
	sameAs,
)

templ AppMetadataJSONLD() {
	<script id="application-metadata" type="application/ld+json" hx-preserve="true">
		{
		  "@context": "https://schema.org",
		  "@type": ["SoftwareApplication","WebApplication"],
		  "name": "Foragd",
		  "applicationCategory": "News & RSS Reader",
		  "operatingSystem": "Web",
		  "description": "Foragd is a web-based reader that combines RSS and Atom feeds, YouTube channels, Google News search and email newsletters into one searchable view, without ads or an algorithmic feed.",
		  "browserRequirements": "Requires JavaScript",
		  "offers": {
		    "@type": "AggregateOffer",
		    "priceCurrency": "USD",
		    "lowPrice": "5.00",
		    "highPrice": "36.00",
		    "offerCount": 2,
		    "offers": [
		      {
		        "@type": "Offer",
		        "name": "Monthly plan",
		        "price": "5.00",
		        "priceCurrency": "USD",
		        "priceSpecification": {
		          "@type": "UnitPriceSpecification",
		          "price": "5.00",
		          "priceCurrency": "USD",
		          "billingDuration": "P1M"
		        },
		        "url": "https://foragd.app/#pricing"
		      },
		      {
		        "@type": "Offer",
		        "name": "Annual plan",
		        "price": "36.00",
		        "priceCurrency": "USD",
		        "priceSpecification": {
		          "@type": "UnitPriceSpecification",
		          "price": "36.00",
		          "priceCurrency": "USD",
		          "billingDuration": "P1Y"
		        },
		        "url": "https://foragd.app/#pricing"
		      }
		    ]
		  }
		}
	</script>
}
