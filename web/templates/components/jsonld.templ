package components

templ AppMetadataJSONLD() {
	<script id="application-metadata" type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication","WebApplication"],
  "name": "Foragd",
  "applicationCategory": "News & RSS Reader",
  "operatingSystem": "Web",
  "description": "Foragd is a web-based reader that combines RSS and Atom feeds, YouTube channels, subreddits and email newsletters into one searchable view, without ads or an algorithmic feed.",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "5.00",
    "highPrice": "36.00",
    "offerCount": 2,
    "offers": [
      {
        "@type": "Offer",
        "name": "Monthly plan",
        "price": "5.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "5.00",
          "priceCurrency": "USD",
          "billingDuration": "P1M"
        },
        "url": "https://foragd.app/#pricing"
      },
      {
        "@type": "Offer",
        "name": "Annual plan",
        "price": "36.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "36.00",
          "priceCurrency": "USD",
          "billingDuration": "P1Y"
        },
        "url": "https://foragd.app/#pricing"
      }
    ]
  }
}
</script>
}
