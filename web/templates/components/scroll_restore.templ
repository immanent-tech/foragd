package components

var scrollRestoreOnce = templ.NewOnceHandle()

templ ScrollRestoreBehavior() {
	@scrollRestoreOnce.Once() {
		<script id="scroll-restore-behavior" type="text/hyperscript" nonce={ templ.GetNonce(ctx) } hx-preserve="true">
			behavior ScrollRestore
                init
                  set window.history.scrollRestoration to 'manual'
                end

                on scroll from window debounced at 100ms
                  if not $restoring
                    call sessionStorage.setItem('scroll:' + location.pathname + location.search, window.scrollY)
                  end
                end

                on htmx:before:request from document
                  if not $restoring
                    call sessionStorage.setItem('scroll:' + location.pathname + location.search, window.scrollY)
                  end
                end

                on htmx:before:history:restore from document
                  set $restoring to true
                end

                on htmx:after:swap from document
                  if $restoring
                    log 'restoring scroll position'
                    set y to parseInt(sessionStorage.getItem('scroll:' + location.pathname + location.search) or '0')
                    set tries to 0
                    repeat until Math.abs(window.scrollY - y) < 2 or tries > 20
                      call window.scrollTo({ top: y, left: 0, behavior: 'instant' })
                      wait 50ms
                      increment tries
                    end
                    set $restoring to false
                  end
                end

                on htmx:error from document
                  set $restoring to false
                end
		</script>
	}
}
