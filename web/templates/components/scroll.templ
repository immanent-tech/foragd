package components

import "fmt"

var scrollRestoreOnce = templ.NewOnceHandle()

templ ScrollRestoreBehavior() {
	@scrollRestoreOnce.Once() {
		<script id="scroll-restore-setup">
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }
  </script>
		<script id="scroll-restore-behavior" type="text/hyperscript">
behavior ScrollRestore(gridSelector, cardSelector, endpoint, storageKey)
  def doRestore()
    log 'performing restore'
    js(gridSelector, cardSelector, endpoint, storageKey)
      const y = sessionStorage.getItem(`${storageKey}-scroll`);
      if (y) {
        window.scrollTo(0, parseInt(y));
      }
    end
  end

  // normal load / reload: fresh document, but sessionStorage survives
  // (sessionStorage is per-tab and persists across normal navigation/reload,
  // it's only cleared when the tab closes)
  on load from me
    js
      const missFlag = sessionStorage.getItem('foragd-history-miss');
      sessionStorage.removeItem('foragd-history-miss');
      const nav = performance.getEntriesByType('navigation')[0];
      return !!missFlag || (nav && nav.type === 'back_forward');
    end
    if it
      log 'back button restoration'
      call doRestore()
    end
  end

  // bfcache restore: browser reused the in-memory page, JS state intact
  on pageshow from window
    if event.persisted
      call doRestore()
    end
  end

  -- htmx4 history mode: page restored via htmx after back button
  on "htmx:after:load" from document
    call doRestore()
  end

  -- Also handle after htmx swap completes
  on "htmx:after:swap" from document
    call doRestore()
  end


  // store scroll position peridorically
  on scroll from window debounced at 200ms
  	js(storageKey)
      sessionStorage.setItem(`${storageKey}-scroll`, window.scrollY)
    end
  end
end
  </script>
	}
}

func ScrollRestoreScript(endPoint, storageKey string) string {
	return fmt.Sprintf("install ScrollRestore(gridSelector: '#grid-objects', cardSelector: '.card', endpoint: '%s', storageKey: '%s')", endPoint, storageKey)
}
