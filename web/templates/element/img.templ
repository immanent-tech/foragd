package element

type Img struct {
	Src    string
	Alt    string
	Width  int
	Height int
	props  *Properties
}

func NewImg(src, alt string, width, height int, options ...PropertiesOption) *Img {
	return &Img{
		Src:    src,
		Alt:    alt,
		Width:  width,
		Height: height,
		props:  NewProperties(options...),
	}
}

templ (i *Img) Template() {
	<img
		width={ i.Width }
		height={ i.Height }
		src={ i.Src }
		alt={ i.Alt }
		class={ i.props.Classes() }
		{ i.props.Attributes()... }
	/>
}
