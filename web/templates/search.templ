package templates

import (
	"github.com/immanent-tech/foragd/models"
	"github.com/immanent-tech/foragd/web/templates/partials"
	"slices"
)

templ searchCommands() {
	<button
		command="show-modal"
		commandfor="commands"
		class="hidden"
		_="on keydown from body if the event's key is 'k' and event.altKey then showModal() on #commands"
	>
		Open command palette
	</button>
	<el-dialog>
		<dialog id="commands">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="fixed inset-0 w-screen overflow-y-auto p-4 focus:outline-none sm:p-6 md:p-20">
				<el-dialog-panel class="mx-auto block max-w-2xl transform overflow-hidden rounded-xl bg-base-300 shadow-2xl outline-1 outline-primary/5 backdrop-blur-sm backdrop-filter transition-all data-closed:scale-95 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in">
					<el-command-palette>
						<div class="grid grid-cols-1 items-center border-b border-primary/10">
							<input
								id="command-text"
								name="command-text"
								type="text"
								autofocus
								placeholder="Search..."
								class="col-start-1 row-start-1 h-12 w-full bg-transparent pr-4 pl-11 text-base outline-hidden placeholder:text-primary sm:text-sm"
							/>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search pointer-events-none col-start-1 row-start-1 ml-4 size-5 self-center text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path>
							</svg>
						</div>
						<el-command-list class="block max-h-80 scroll-py-2 overflow-y-auto">
							// <el-defaults class="block divide-y divide-gray-500/10 dark:divide-white/10">
							// 	<div class="p-2">
							// 		<h2 class="sr-only">Quick actions</h2>
							// 		<div class="text-sm text-gray-700 dark:text-gray-300">
							// 			<a href="#" class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-gray-900/5 aria-selected:text-gray-900 dark:aria-selected:bg-white/5 dark:aria-selected:text-white">
							// 				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 flex-none text-gray-900/40 group-aria-selected:text-gray-900 dark:text-gray-500 dark:group-aria-selected:text-white">
							// 					<path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" stroke-linecap="round" stroke-linejoin="round"></path>
							// 				</svg>
							// 				<span class="ml-3 flex-auto truncate">Add new file...</span>
							// 				<span aria-hidden="true" class="ml-3 flex-none text-xs font-semibold text-gray-500 dark:text-gray-400"><kbd class="font-sans">⌘</kbd><kbd class="font-sans">N</kbd> </span>
							// 			</a>
							// 			<a href="#" class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-gray-900/5 aria-selected:text-gray-900 dark:aria-selected:bg-white/5 dark:aria-selected:text-white">
							// 				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 flex-none text-gray-900/40 group-aria-selected:text-gray-900 dark:text-gray-500 dark:group-aria-selected:text-white">
							// 					<path d="M12 10.5v6m3-3H9m4.06-7.19-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" stroke-linecap="round" stroke-linejoin="round"></path>
							// 				</svg>
							// 				<span class="ml-3 flex-auto truncate">Add new folder...</span>
							// 				<span aria-hidden="true" class="ml-3 flex-none text-xs font-semibold text-gray-500 dark:text-gray-400"><kbd class="font-sans">⌘</kbd><kbd class="font-sans">F</kbd> </span>
							// 			</a>
							// 			<a href="#" class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-gray-900/5 aria-selected:text-gray-900 dark:aria-selected:bg-white/5 dark:aria-selected:text-white">
							// 				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 flex-none text-gray-900/40 group-aria-selected:text-gray-900 dark:text-gray-500 dark:group-aria-selected:text-white">
							// 					<path d="M5.25 8.25h15m-16.5 7.5h15m-1.8-13.5-3.9 19.5m-2.1-19.5-3.9 19.5" stroke-linecap="round" stroke-linejoin="round"></path>
							// 				</svg>
							// 				<span class="ml-3 flex-auto truncate">Add hashtag...</span>
							// 				<span aria-hidden="true" class="ml-3 flex-none text-xs font-semibold text-gray-500 dark:text-gray-400"><kbd class="font-sans">⌘</kbd><kbd class="font-sans">H</kbd> </span>
							// 			</a>
							// 			<a href="#" class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-gray-900/5 aria-selected:text-gray-900 dark:aria-selected:bg-white/5 dark:aria-selected:text-white">
							// 				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 flex-none text-gray-900/40 group-aria-selected:text-gray-900 dark:text-gray-500 dark:group-aria-selected:text-white">
							// 					<path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" stroke-linecap="round" stroke-linejoin="round"></path>
							// 					<path d="M6 6h.008v.008H6V6Z" stroke-linecap="round" stroke-linejoin="round"></path>
							// 				</svg>
							// 				<span class="ml-3 flex-auto truncate">Add label...</span>
							// 				<span aria-hidden="true" class="ml-3 flex-none text-xs font-semibold text-gray-500 dark:text-gray-400"><kbd class="font-sans">⌘</kbd><kbd class="font-sans">L</kbd> </span>
							// 			</a>
							// 		</div>
							// 	</div>
							// </el-defaults>
							<el-command-group
								hidden
								class="block text-sm text-base-content"
								aria-labelledby="subscriptions-group-label"
								hx-post="/action/subscription/suggestions"
								hx-include="[name='command-text']"
								hx-trigger="keyup changed delay:500ms from:#command-text"
							></el-command-group>
							<el-command-group hidden class="block text-sm text-base-content" aria-labelledby="pages-group-label">
								<div id="pages-group-label" class="px-3 py-4 font-semibold text-base-content/80">Pages</div>
								<a
									href="/home"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M5 12l-2 0l9 -9l9 9l-2 0"></path><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Go to Home</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
								</a>
								<a
									href="/list/subscriptions"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-rss size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Go to Subscriptions</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
								</a>
								<a
									href="/list/articles"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-rss size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2"></path><path d="M12 17a3 3 0 0 0 -3 -3"></path><path d="M15 17a6 6 0 0 0 -6 -6"></path><path d="M9 17h.01"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Go to Articles</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
								</a>
								<a
									href="/list/favorites"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Go to Favorites</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
								</a>
								<a
									href="/user/settings"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-settings size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065"></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Go to Settings</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Jump to...</span>
								</a>
							</el-command-group>
							<el-command-group hidden class="block text-sm text-base-content" aria-labelledby="actions-group-label">
								<div id="actions-group-label" class="px-3 py-4 font-semibold text-base-content/80">Actions</div>
								<a
									href="/user/subscription/add/feed"
									hx-get="/user/subscription/add/feed"
									hx-target={ ContentID.Target() }
									hx-push-url="true"
									hx-on::after-request="document.getElementById('commands').close()"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M9 12h6"></path><path d="M12 9v6"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Add a feed subscription</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Create...</span>
								</a>
								<a
									href="/user/subscription/add/search"
									hx-get="/user/subscription/add/search"
									hx-target={ ContentID.Target() }
									hx-push-url="true"
									hx-include="#search-filters"
									hx-on::after-request="document.getElementById('commands').close()"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M9 12h6"></path><path d="M12 9v6"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Add a search subscription</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Create...</span>
								</a>
								<a
									href="/user/subscription/add/group"
									hx-get="/user/subscription/add/group"
									hx-target={ ContentID.Target() }
									hx-push-url="true"
									hx-on::after-request="document.getElementById('commands').close()"
									hidden
									class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus size-6 flex-none text-base-content group-aria-selected:text-primary-content forced-colors:group-aria-selected:text-[Highlight]">
										<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M9 12h6"></path><path d="M12 9v6"></path>
									</svg>
									<span class="ml-3 flex-auto truncate">Add a group subscription</span>
									<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Create...</span>
								</a>
							</el-command-group>
						</el-command-list>
						<el-no-results hidden class="block px-6 py-14 text-center sm:px-14">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-question-mark mx-auto size-6 text-primary">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 8a3.5 3 0 0 1 3.5 -3h1a3.5 3 0 0 1 3.5 3a3 3 0 0 1 -2 3a3 4 0 0 0 -2 4"></path><path d="M12 19l0 .01"></path>
							</svg>
							<p class="mt-4 font-semibold text-primary">We couldn't find any actions with that term. Please try again.</p>
						</el-no-results>
					</el-command-palette>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

templ ActionSuggestionSubscriptions(subscriptions models.Subscriptions) {
	<div id="subscriptions-group-label" class="px-3 py-4 font-semibold text-base-content/80">Subscriptions</div>
	for subscription := range slices.Values(subscriptions) {
		<a
			href={ subscriptionViewArticlesLink(subscription) }
			{ subscriptionViewArticlesAttributes(subscription)... }
			hx-on::after-request="document.getElementById('commands').close()"
			class="group flex cursor-default items-center rounded-md px-3 py-2 select-none focus:outline-hidden aria-selected:bg-primary aria-selected:text-primary-content"
		>
			<div class="flex-none">
				if subscription.GetImage() == "" {
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-rss">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path>
					</svg>
				} else {
					@partials.Thumbnail(
						&models.RemoteImage{
							URL:   new(subscription.GetImage()),
							Title: new(subscription.GetTitle()),
						},
						subscription.GetTitle(),
						"size-6",
					)
				}
			</div>
			<div class="ml-3 line-clamp-1 flex-auto tracking-tight text-pretty">{ subscription.GetTitle() }</div>
			<span aria-hidden="true" class="ml-3 hidden flex-none text-primary-content/50 group-aria-selected:inline">Go to...</span>
		</a>
	}
}

templ Search() {
	<div class="input w-full bg-base-300 text-base brightness-95 input-primary placeholder:text-base-content/80 sm:max-w-3xl sm:text-sm/6">
		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search pointer-events-none flex-none text-primary">
			<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path>
		</svg>
		<input
			hx-get="/search"
			hx-target={ ContentID.Target() }
			hx-include="#search-filters,[id='timezone']"
			hx-trigger="keyup[key=='Enter'] consume"
			hx-sync="#search-suggestions-popover:drop"
			id="global-search"
			type="search"
			name="text"
			placeholder="Search..."
			spellcheck="false"
			autocomplete="off"
			aria-label="Search"
			_="
			  on keydown from body if the event's key is 'q' and event.altKey then focus() me end
			  "
		/>
		<button
			hx-post="/search/suggestions"
			hx-target="#search-suggestions-popover"
			hx-include="#search-filters,[id='timezone'],[id='global-search']"
			hx-trigger="keyup[key!='Enter'] delay:500ms from:#global-search"
			hx-on::after-request="document.getElementById('search-suggestions-popover').showPopover()"
			_="on htmx:trigger if event.detail.triggeringEvent.key == 'Enter' then halt the event end"
			popovertarget="search-suggestions-popover"
			type="button"
			aria-label="Search suggestions"
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-chevron-down pointer-events-none flex-none text-primary transform not-in-aria-expanded:rotate-0 in-aria-expanded:-rotate-180">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18.707 8.293a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1 -1.414 0l-6 -6a1 1 0 0 1 1.414 -1.414l5.293 5.293l5.293 -5.293a1 1 0 0 1 1.414 0"></path>
			</svg>
		</button>
		<el-popover
			id="search-suggestions-popover"
			anchor="bottom end"
			popover
			role="listbox"
			class="h-fit max-h-9/10 w-full divide-y divide-primary/80 rounded-box bg-base-300 shadow-sm outline-1 -outline-offset-1 outline-base-content/15 [--anchor-gap:10px] sm:max-w-3xl sm:[--anchor-offset:42px]"
		></el-popover>
		<button
			command="show-modal"
			commandfor="advanced-search-dialog"
			aria-label="Show advanced search dialog"
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-adjustments text-primary">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 10a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path><path d="M6 4v4"></path><path d="M6 12v8"></path><path d="M10 16a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path><path d="M12 4v10"></path><path d="M12 18v2"></path><path d="M16 7a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path><path d="M18 4v1"></path><path d="M18 9v11"></path>
			</svg>
		</button>
	</div>
	<el-dialog>
		<dialog id="advanced-search-dialog" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
			<el-dialog-backdrop></el-dialog-backdrop>
			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-left focus:outline-none sm:items-center sm:p-0">
				<el-dialog-panel class="relative w-full transform overflow-hidden rounded-lg bg-base-300 px-4 pt-5 pb-4 shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:max-w-3xl sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
					@AdvancedSearch(models.NewSearchRequest(), nil)
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>
}

// SearchSuggestions will render suggestions for a given search.
templ SearchSuggestions(suggestions *models.SearchResults) {
	<ul
		class="menu w-full"
		role="listbox"
	>
		<li role="option">
			// _="on htmx:afterRequest[detail.successful] set #search-suggestions-popover.innerHTML to ''"
			<form
				id="show-search-results"
				hx-get="/search"
				hx-target={ ContentID.Target() }
				hx-include="#search-filters,[id='timezone']"
				hx-sync="#search-suggestions-popover:drop"
				hx-on::before-request="document.getElementById('search-suggestions-popover').hidePopover()"
			>
				<input type="hidden" name="text" value={ suggestions.Search.Text }/>
				<button type="submit" class="group flex items-center" tabindex="0">
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search group-hover:text-primary">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path>
					</svg>
					<span class="ml-3 flex-auto truncate">Search for { suggestions.Search.Text }</span>
					<span aria-hidden="true" class="ml-3 hidden flex-none text-primary group-hover:inline">Search...</span>
				</button>
			</form>
		</li>
		if len(suggestions.Subscriptions) > 0 {
			// Subscription suggestions.
			<li id="subscription-suggestions" class="menu-title" tabindex="-1" role="none">Subscriptions</li>
			for subscription := range slices.Values(suggestions.Subscriptions) {
				<li role="option">
					// href={ subscriptionViewArticlesLink(subscription) }
					<button
						class="group flex items-center"
						tabindex="0"
						type="submit"
						{ subscriptionViewArticlesAttributes(subscription)... }
						hx-on::before-request=" document.getElementById('search-suggestions-popover').hidePopover()"
					>
						if subscription.GetImage() != "" {
							@partials.Thumbnail(
								&models.RemoteImage{
									URL:   new(subscription.GetImage()),
									Title: new(subscription.GetTitle()),
								},
								subscription.GetTitle(),
								"size-6",
							)
						} else {
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-rss group-hover:text-primary size-6">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path>
							</svg>
						}
						<span class="ml-3 flex-auto truncate">{ subscription.GetTitle() } </span>
						<span aria-hidden="true" class="ml-3 hidden flex-none text-primary group-hover:inline">Jump to...</span>
					</button>
				</li>
			}
		}
		if len(suggestions.Articles)> 0 {
			// Article suggestions.
			<li id="article-suggestions" class="menu-title" role="none">
				Articles
			</li>
			for article := range slices.Values(suggestions.Articles) {
				<li role="option">
					<button
						type="button"
						href={ "/view/article/" + article.GetID() }
						hx-get={ "/view/article/" + article.GetID() }
						hx-target={ ContentID.Target() }
						hx-push-url="true"
						hx-on::before-request="document.getElementById('search-suggestions-popover').hidePopover()"
						class="group"
						tabindex="0"
					>
						if article.GetImage() != nil {
							@partials.Thumbnail(
								&models.RemoteImage{
									URL:   new(article.GetImage().GetURL()),
									Title: new(article.GetTitle()),
								},
								article.GetTitle(),
								"size-6",
							)
						} else {
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-file-rss group-hover:text-primary size-6">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 2l.117 .007a1 1 0 0 1 .876 .876l.007 .117v4l.005 .15a2 2 0 0 0 1.838 1.844l.157 .006h4l.117 .007a1 1 0 0 1 .876 .876l.007 .117v9a3 3 0 0 1 -2.824 2.995l-.176 .005h-10a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-14a3 3 0 0 1 2.824 -2.995l.176 -.005zm-3 11a1 1 0 0 0 0 2a2 2 0 0 1 1.995 1.85l.005 .15a1 1 0 0 0 2 0a4 4 0 0 0 -4 -4m0 -3a1 1 0 0 0 0 2a5 5 0 0 1 5 5a1 1 0 0 0 2 0a7 7 0 0 0 -7 -7m.01 6h-.01a1 1 0 0 0 -.117 1.993l.127 .007a1 1 0 0 0 0 -2m5.989 -13.001l4.001 4.001h-4z"></path>
							</svg>
						}
						<span class="ml-3 flex-auto truncate">{ article.GetTitle() } </span>
						<span aria-hidden="true" class="ml-3 hidden flex-none text-primary group-hover:inline">Jump to...</span>
					</button>
				</li>
			}
		}
	</ul>
}

// SearchResults renders the given articles returned from the given search in a grid layout with an actions menu.
templ SearchResults(results *models.SearchResults) {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				if len(results.Articles) == 0 {
					<div class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
						<div class="text-center">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-zoom-question mx-auto text-accent size-12">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path><path d="M10 13l0 .01"></path><path d="M10 10a1.5 1.5 0 1 0 -1.14 -2.474"></path>
							</svg>
							<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Nothing found</h1>
							<p class="mt-6 text-lg font-medium text-pretty sm:text-xl/8">Looks like there are no matches for that search.</p>
						</div>
					</div>
				} else {
					// Watch for updates.
					// <div
					// 	id="update-notifications"
					// 	sse-connect={ "/search/updates?" + results.Search.Query() }
					// 	sse-swap="updates"
					// 	class="toast toast-center z-50"
					// ></div>
					<div id="header" class="mt-4 flex items-center justify-between">
						// Page title.
						<div class="min-w-0 flex-1">
							<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">Search Results</h1>
						</div>
						// Actions menu.
						<el-dropdown class="inline-block flex-none">
							<button class="btn inline-flex flex-col items-center">
								<span class="sr-only">Articles Actions</span>
								<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2">
									<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path>
								</svg>
							</button>
							<el-menu anchor="bottom end" popover>
								// Mark all read action.
								<form>
									<input type="hidden" name={ models.ParamView } value={ models.ViewUnread }/>
									<input type="hidden" name={ models.ParamMark } value={ models.MarkRead }/>
									<a
										hx-post="/list/articles/mark/read"
										hx-target={ ContentID.Target() }
										hx-include="#grid-objects"
										class="group/item flex link items-center gap-x-2 rounded-md px-3 py-2 text-sm link-hover focus:bg-primary focus:text-primary-content focus:outline-hidden"
										role="menuitem"
										tabindex="-1"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail-opened size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M14.872 14.287l6.522 6.52a2.996 2.996 0 0 1 -2.218 1.188l-.176 .005h-14a2.995 2.995 0 0 1 -2.394 -1.191l6.521 -6.522l2.318 1.545l.116 .066a1 1 0 0 0 .878 0l.116 -.066l2.317 -1.545z"></path><path d="M2 9.535l5.429 3.62l-5.429 5.43z"></path><path d="M22 9.535v9.05l-5.43 -5.43z"></path><path d="M12.44 2.102l.115 .066l8.444 5.629l-8.999 6l-9 -6l8.445 -5.63a1 1 0 0 1 .994 -.065z"></path>
										</svg>
										Mark all Read
									</a>
								</form>
								// Mark all unread action.
								<form>
									<input type="hidden" name={ models.ParamView } value={ models.ViewRead }/>
									<input type="hidden" name={ models.ParamMark } value={ models.MarkUnread }/>
									<a
										hx-post="/list/articles/mark/unread"
										hx-target={ ContentID.Target() }
										hx-include="#grid-objects"
										class="group/item flex link items-center gap-x-2 rounded-md px-3 py-2 text-sm link-hover focus:bg-primary focus:text-primary-content focus:outline-hidden"
										role="menuitem"
										tabindex="-1"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path>
										</svg>
										Mark all Unread
									</a>
								</form>
								if results.Search.SubscriptionID != nil {
									// Edit action.
									<a
										hx-get={ "/edit/subscription/" + *results.Search.SubscriptionID }
										hx-target={ ContentID.Target() }
										hx-swap="innerHTML show:window:top transition:true"
										class="group/item flex link items-center gap-x-2 rounded-md px-3 py-2 text-sm link-hover focus:bg-primary focus:text-primary-content focus:outline-hidden"
										role="menuitem"
										tabindex="-1"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-edit size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"></path><path d="M16 5l3 3"></path>
										</svg>
										Edit Subscription
									</a>
								} else {
									<a
										hx-get="/user/subscription/add/search"
										hx-target={ ContentID.Target() }
										hx-include="#search-filters"
										class="group/item flex link items-center gap-x-2 rounded-md px-3 py-2 text-sm link-hover focus:bg-primary focus:text-primary-content focus:outline-hidden"
										role="menuitem"
										tabindex="-1"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus size-4">
											<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path>
										</svg>
										Add Subscription
									</a>
								}
							</el-menu>
						</el-dropdown>
					</div>
					if len(results.Articles) > 1 {
						<div class="m-2 flex justify-center gap-2 p-2">
							<div id="top-categories" class="flex flex-row flex-wrap place-content-center gap-2 p-2">
								for category := range slices.Values(results.Categories) {
									{{ search := results.Search }}
									{{ search.Categories = &category }}
									<a
										hx-get="/search"
										hx-target={ ContentID.Target() }
										hx-vals={ search.HXVals() }
										class="link link-hover"
									>
										<span class="badge line-clamp-1 badge-lg badge-secondary">
											{ category }
										</span>
									</a>
								}
							</div>
						</div>
					}
					// Articles grid.
					<section class="mt-4">
						@grid() {
							@templ.Fragment(PaginateFragment) {
								for article := range slices.Values(results.Articles) {
									<input type="hidden" name={ "metadata[" + article.GetSubscriptionID() + "]" } value={ article.GetID() }/>
									@NewArticleView(article).Card()
								}
								if results.Pagination != nil && len(results.Articles) == 15 {
									<form
										hx-post="/search/paginate"
										hx-vals={ templ.JSONString(results.Search) }
										hx-trigger="intersect once"
										hx-target="#grid-objects"
										hx-swap="beforeend transition:false"
										hx-indicator="#loading-results"
										preload
										preload-images="true"
										_="on htmx:afterRequest remove me"
										class="invisible"
									>
										<input type="hidden" name="pagination" value={ *results.Pagination }/>
									</form>
								}
							}
							@partials.ButtonBackToTop()
							@partials.LoadingIndicator("loading-results")
						}
					</section>
				}
			}
		}
	}
}

templ AdvancedSearch(request *models.SearchRequest, attributes templ.Attributes) {
	// Search form.
	<div id="search-filters" { attributes... }>
		<h3 id="search-filters-dialog-title" class="text-base font-semibold">Advanced Search</h3>
		<div class="grid w-full grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-6 sm:gap-y-8 md:col-span-2">
			// Full text search filter.
			<fieldset class="col-span-full fieldset">
				<legend class="fieldset-legend">Includes the words</legend>
				<textarea
					rows="2"
					id="search-text"
					type="text"
					name="text"
					placeholder={ `+keyword -"some phrase"` }
					class="textarea mt-2 w-full bg-base-300 textarea-sm brightness-95 textarea-primary"
				>
					if request.Text != "" {
						{ request.Text }
					}
				</textarea>
			</fieldset>
			// Categories filter.
			<fieldset class="fieldset sm:col-span-3">
				<legend class="fieldset-legend">Categories</legend>
				<textarea
					id="search-categories"
					type="text"
					name="categories"
					placeholder="favorite-category -unwanted-category"
					class="textarea mt-2 w-full bg-base-300 textarea-sm brightness-95 textarea-primary"
				>
					if request.Categories != nil {
						{ *request.Categories }
					}
				</textarea>
			</fieldset>
			// Authors filter.
			<fieldset class="fieldset sm:col-span-3">
				<legend class="fieldset-legend">Authors</legend>
				<textarea
					id="search-authors"
					type="text"
					name="authors"
					placeholder="bob +jenny@blog.me"
					class="textarea mt-2 w-full bg-base-300 textarea-sm brightness-95 textarea-primary"
				>
					if request.Authors != nil {
						{ *request.Authors }
					}
				</textarea>
			</fieldset>
			<fieldset class="fieldset sm:col-span-2">
				<legend class="fieldset-legend">View</legend>
				<div class="flex items-center gap-x-3">
					<input
						id="search-view-unread"
						type="radio"
						name="view"
						value="unread"
						if request.View == models.ViewUnread {
							checked
						}
						class="radio radio-sm radio-primary"
					/>
					<label for="search-view-unread" class="block text-xs font-medium">Unread</label>
				</div>
				<div class="flex items-center gap-x-3">
					<input
						id="search-view-read"
						type="radio"
						name="view"
						value="read"
						if request.View == models.ViewRead {
							checked
						}
						class="radio radio-sm radio-primary"
					/>
					<label for="search-view-read" class="block text-xs font-medium">Read</label>
				</div>
				<div class="flex items-center gap-x-3">
					<input
						id="search-view-all"
						type="radio"
						name="view"
						value="all"
						if request.View == models.ViewAll {
							checked
						}
						class="radio radio-sm radio-primary"
					/>
					<label for="search-view-all" class="block text-xs font-medium">All</label>
				</div>
			</fieldset>
			// Date range filter.
			<fieldset class="fieldset sm:col-span-2">
				<legend class="fieldset-legend">Published Within</legend>
				<select id="search-published-within" name="published_within" class="select my-2 bg-base-300 select-sm brightness-95 select-primary">
					<option
						value="last_hour"
						if request.PublishedWithin == models.SearchRequestPublishedWithinLastHour {
							selected
						}
					>Last hour</option>
					<option
						value="last_half_day"
						if request.PublishedWithin == models.SearchRequestPublishedWithinLast12hours {
							selected
						}
					>Last 12 hours</option>
					<option
						value="last_day"
						if request.PublishedWithin == models.SearchRequestPublishedWithinLastDay {
							selected
						}
					>Last day</option>
					<option
						value="last_week"
						if request.PublishedWithin == models.SearchRequestPublishedWithinLastWeek {
							selected
						}
					>Last week</option>
					<option
						value="last_month"
						if request.PublishedWithin == models.SearchRequestPublishedWithinLastMonth {
							selected
						}
					>Last month</option>
					<option
						value="all_time"
						if request.PublishedWithin == models.SearchRequestPublishedWithinAllTime || request.PublishedWithin == "" {
							selected
						}
					>All time</option>
				</select>
			</fieldset>
			// Sort option.
			<fieldset class="fieldset sm:col-span-2">
				<legend class="fieldset-legend">Sort By</legend>
				<select id="search-sort" name="sort" class="select my-2 bg-base-300 select-sm brightness-95 select-primary">
					<option
						value={ string(models.SortMostRelevant) }
						if request.Sort == models.SortMostRelevant {
							selected
						}
					>
						Most Relevant
					</option>
					<option
						value={ string(models.SortNewestFirst) }
						if request.Sort == models.SortNewestFirst {
							selected
						}
					>Newest First</option>
					<option
						value={ string(models.SortOldestFirst) }
						if request.Sort == models.SortOldestFirst {
							selected
						}
					>Oldest First</option>
				</select>
			</fieldset>
			<div class="col-span-full mt-6 flex items-center justify-end gap-x-6">
				<button
					type="button"
					class="btn btn-sm btn-secondary hover:btn-error"
					command="close"
					commandfor="advanced-search-dialog"
				>Cancel</button>
				<form
					id="search-results"
					hx-get="/search"
					hx-target={ ContentID.Target() }
					hx-include="[id='timezone'],#search-filters"
					hx-params="not subscription-text"
					hx-on::before-request="document.getElementById('advanced-search-dialog').close()"
				>
					<button
						type="submit"
						class="btn btn-sm btn-primary"
					>Search</button>
				</form>
			</div>
			// Help dialog.
			<div class="absolute top-2 right-2">
				<button
					id="filter-operators-help-button"
					popovertarget="filter-operators-help"
					type="button"
					class="btn btn-circle text-info btn-ghost btn-xs"
					aria-label="Search filters help"
				>
					<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-info-circle size-6 text-info">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path><path d="M12 9h.01"></path><path d="M11 12h1v4h1"></path>
					</svg>
				</button>
				<el-popover popover="hint" id="filter-operators-help" anchor="bottom end" class="[--anchor-gap:4px]">
					<div class="card-body max-w-full rounded-box border border-primary bg-base-300 text-xs text-wrap shadow-md">
						<p>By default words are matched with OR (i.e., cats dogs will match cats OR dogs). The following operators can be used for more refined searches:</p>
						<ul>
							<li>+ signifies AND operation (i.e., food AND beverages)</li>
							<li>| signifies OR operation (i.e., food OR beverages)</li>
							<li>- negates the word (i.e., NOT alcoholic)</li>
							<li>"" represents an exact phrase match (i.e., "rum-based drinks")</li>
							<li>* at the end of a term indicates a prefix match (i.e., match bird, birding and birds)</li>
						</ul>
					</div>
				</el-popover>
			</div>
		</div>
	</div>
}

templ SearchSubscriptionFilterSuggestions(subscriptions models.Subscriptions) {
	for subscription := range slices.Values(subscriptions) {
		<button
			hx-post="/search/subscription"
			hx-swap="beforeend"
			hx-vals={ templ.JSONString(map[string]any{"subscription_id": subscription.GetID(), "subscription_name": subscription.GetTitle()}) }
			hx-params="subscription_id,subscription_name,subscriptions-input-name"
			_="on htmx:afterRequest(successful) remove me"
			aria-label={ "Add subscription filter for " + subscription.GetTitle() }
		>
			<div class="badge badge-sm hover:cursor-pointer hover:badge-success">
				{ subscription.GetTitle() }
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus size-4">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 5l0 14"></path><path d="M5 12l14 0"></path>
				</svg>
			</div>
		</button>
	}
}

templ AddSearchSubscriptionFilter(filter *models.AddSubscriptionSearchFilterRequest) {
	<li>
		<button
			_="on click remove the closest <li/>"
			type="button"
			class="btn btn-wide"
			aria-label={ "Remove subscription filter " + filter.SubscriptionName }
		>
			<input type="hidden" name={ filter.InputName } value={ filter.SubscriptionID }/>
			// <div class="badge badge-sm hover:cursor-pointer hover:badge-error">
			{ filter.SubscriptionName }
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-4">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
			</svg>
			// </div>
		</button>
	</li>
}

// SimilarArticles renders a page of articles that are the result of a search for similar articles to a given input set.
templ SimilarArticles(articles models.Articles) {
	@content() {
		@templ.Fragment(ContentFragment) {
			@container() {
				// Show a page header.
				<div class="md:flex md:items-center md:justify-between">
					<div class="min-w-0 flex-1">
						<h1 class="mt-4 mb-2 scroll-mt-16 text-2xl/7 font-bold tracking-tight text-balance sm:mt-8 sm:mb-4 sm:text-3xl">
							Similar Articles
						</h1>
					</div>
				</div>
				if len(articles) == 0 {
					<div class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
						<div class="text-center">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-zoom-question mx-auto text-accent size-12">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path><path d="M10 13l0 .01"></path><path d="M10 10a1.5 1.5 0 1 0 -1.14 -2.474"></path>
							</svg>
							<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl">Nothing found</h1>
							<p class="mt-6 text-lg font-medium text-pretty sm:text-xl/8">Looks like there are no matches for that search.</p>
						</div>
					</div>
				} else {
					// Show results.
					<section class="mt-4">
						@grid() {
							for article := range slices.Values(articles) {
								@NewArticleView(article).Card()
							}
						}
						@partials.ButtonBackToTop()
					</section>
				}
			}
		}
	}
}
