{
    "name": "foragd",
    "dockerComposeFile": "docker-compose.yml",
    "service": "devcontainer",
    "postCreateCommand": {
        "fix-permissions": "bash base/.devcontainer/postcreate.sh"
        // "frontend": "bash base/.devcontainer/postcreate.scripts.d/frontend.sh",
        // "google-cloud": "bash base/.devcontainer/postcreate.scripts.d/gcloud.sh"
    },
    "containerUser": "vscode",
    "containerEnv": {
        "HOME": "/home/vscode",
        "GOCACHE": "/home/vscode/.cache/go-build",
        "GOMODCACHE": "/go/pkg/mod"
    },
    "forwardPorts": [
        6060,
        6061
    ],
    "remoteEnv": {
        "PODMAN_COMPOSE_WARNING_LOGS": "false",
        "DOCKER_SOCK": "/run/user/1000/podman/podman.sock",
        "TZ": "${localEnv:TZ:Australia/Brisbane}",
        "EDITOR": "micro"
    },
    "updateRemoteUserUID": true,
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "a-h.templ",
                "bradlc.vscode-tailwindcss",
                "dz4k.vscode-hyperscript-org",
                "cossssmin.posthtml",
                "csstools.postcss",
                "Vue.volar",
                "SimonSiefke.svg-preview",
                "42Crunch.vscode-openapi"
            ]
        }
    }
}
