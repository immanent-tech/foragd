{
  "name": "foragd",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "postCreateCommand": {
    "fix-permissions": "bash base/.devcontainer/postcreate.sh",
    "oh-my-posh": "bash base/.devcontainer/postcreate.scripts.d/oh-my-posh.sh",
    "zyte": "bash base/.devcontainer/postcreate.scripts.d/zyte.sh",
    "frontend": "bash base/.devcontainer/postcreate.scripts.d/frontend.sh",
    "go": "bash base/.devcontainer/postcreate.scripts.d/go.sh",
    "google-cloud": "bash base/.devcontainer/postcreate.scripts.d/gcloud.sh"
  },
  "containerUser": "vscode",
  "containerEnv": {
    "HOME": "/home/vscode"
  },
  "forwardPorts": [6060, 6061],
  "remoteEnv": {
    "PODMAN_COMPOSE_WARNING_LOGS": "false",
    "DOCKER_SOCK": "/run/user/1000/podman/podman.sock",
    "TZ": "${localEnv:TZ:Australia/Brisbane}",
    "EDITOR": "micro"
  },
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "a-h.templ",
        "bradlc.vscode-tailwindcss",
        "dz4k.vscode-hyperscript-org",
        "cossssmin.posthtml",
        "csstools.postcss",
        "Vue.volar",
        "SimonSiefke.svg-preview"
      ]
    }
  }
}
