{
  "name": "Go Feed Me Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "postCreateCommand": "bash .devcontainer/postcreate.sh",
  "containerUser": "vscode",
  "containerEnv": {
    "HOME": "/home/vscode",
    "GOFEEDME_LOGLEVEL": "debug"
  },
  "remoteEnv": {
    "PODMAN_COMPOSE_WARNING_LOGS": "false",
    "TZ": "${localEnv:TZ:Australia/Brisbane}"
  },
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/michidk/devcontainers-features/bun:1": {},
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2": {},
    "ghcr.io/schlich/devcontainer-features/starship:0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vivaxy.vscode-conventional-commits",
        "golang.go",
        "ymotongpoo.licenser",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode",
        "a-h.templ",
        "bradlc.vscode-tailwindcss",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "dnut.rewrap-revived",
        "dz4k.vscode-hyperscript-org",
        "elijah-potter.harper",
        "DotJoshJohnson.xml"
      ]
    }
  }
}
