{
  "name": "go-feed-me",
  "version": "0.0.0",
  "description": "A place for all your feeds",
  "license": "AGPL-3.0-or-later",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "type": "module",
  "source": [
    "./assets/scripts.js",
    "./assets/surreal.js",
    "./assets/styles.css"
  ],
  "targets": {
    "default": {
      "distDir": "./static"
    }
  },
  "exports": {
    ".": "./scripts.js"
  },
  "scripts": {
    "dev:build:js": "bun build ./assets/scripts.js ./assets/surreal*.js --sourcemap --outdir=./static",
    "build:css": "postcss ./assets/styles.css -o ./static/styles.css"
  },
  "dependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@tabler/icons": "^3.34.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.46",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "htmx-ext-response-targets": "^2.0.3",
    "htmx-ext-sse": "^2.2.3",
    "htmx.org": "^2.0.6",
    "hyperscript.org": "^0.9.14",
    "idiomorph": "^0.7.3",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@prettier/plugin-xml": "^3.4.1",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.11",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "prettier-plugin-toml": "^2.0.5"
  }
}
