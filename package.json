{
  "name": "foragd",
  "version": "0.0.0",
  "description": "Gather the information important to you",
  "license": "AGPL-3.0-or-later",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "type": "module",
  "source": [
    "web/assets/scripts.js",
    "web/assets/styles.css"
  ],
  "targets": {
    "default": {
      "distDir": "web/content"
    }
  },
  "scripts": {
    "build:prod": "parcel build --no-source-maps",
    "build:dev": "parcel build --no-optimize",
    "templ:generate": "go run github.com/a-h/templ/cmd/templ@latest generate -path web"
  },
  "dependencies": {
    "@github/relative-time-element": "^5.0.0",
    "@tailwindplus/elements": "^1.0.22",
    "daisyui": "^5.5.19",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "grid-rows-masonry": "^1.2.11",
    "htmx.org": "^2.0.10",
    "hyperscript.org": "^0.9.91",
    "tailwindcss": "^4.3.0",
    "tailwindcss-safe-area": "^1.3.0",
    "tailwindcss-visibility": "^1.0.1"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prettier-plugin-tailwindcss-extra-plus": "^0.3.1",
    "release-please": "^17.6.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
