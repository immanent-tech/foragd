{
  "name": "app.foragd",
  "version": "0.0.0",
  "description": "Foragd is a web-based RSS and feed reader. Follow any website, blog or newsletter in one place. No algorithms, no ads, fully searchable.",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "rss",
    "atom",
    "feed",
    "golang",
    "templ",
    "htmx"
  ],
  "homepage": "https://github.com/immanent-tech/foragd#README",
  "bugs": {
    "url": "https://github.com/immanent-tech/foragd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immanent-tech/foragd.git"
  },
  "browserslist": "last 2 years, not dead, > 0.2%",
  "type": "module",
  "lint": "eslint .",
  "format": "prettier --write .",
  "targets": {
    "frontend": {
      "distDir": "web/content",
      "outputFormat": "esmodule"
    }
  },
  "scripts": {
    "server:run": "air -c server.air.toml",
    "scheduler:run": "air -c scheduler.air.toml",
    "dev:css": "tailwindcss -i ./web/assets/styles.css -o ./web/content/styles.css",
    "prod:css": "tailwindcss -i ./web/assets/styles.css -o ./web/content/styles.css --minify",
    "dev:js": "esbuild ./web/assets/scripts.js --bundle --outfile=./web/content/scripts.js",
    "prod:js": "esbuild ./web/assets/scripts.js --bundle --minify --outfile=./web/content/scripts.js",
    "templ:generate": "go run github.com/a-h/templ/cmd/templ@latest generate -path web"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@github/relative-time-element": "^5.3.1",
    "@maizzle/framework": "^6.0.13",
    "@tailwindplus/elements": "^1.0.22",
    "daisyui": "^5.7.16",
    "date-fns": "^4.4.0",
    "htmx-ext-head-support": "^2.0.5",
    "htmx.org": "^2.0.10",
    "hyperscript.org": "^0.9.93",
    "idiomorph": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-please": "^17.11.1"
  }
}
