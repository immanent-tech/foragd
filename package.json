{
  "name": "foragd",
  "version": "0.0.0",
  "description": "Gather the information important to you",
  "license": "AGPL-3.0-or-later",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "type": "module",
  "scripts": {
    "build:js": "esbuild --bundle --minify ./web/assets/scripts.js --outdir=./web/content/ --format=esm --entry-names=[name]-[hash]",
    "build:js:dev": "esbuild --bundle --sourcemap ./web/assets/scripts.js --outdir=./web/content/ --format=esm",
    "build:css": "tailwindcss -i ./web/assets/styles.css -o ./web/content/styles.css --minify",
    "build:css:dev": "tailwindcss -i ./web/assets/styles.css -o ./web/content/styles.css --map",
    "postinstall": "cd email && npm install",
    "email:serve": "cd email && npx maizzle serve",
    "email:build": "cd email && npx maizzle build production"
  },
  "dependencies": {
    "@github/relative-time-element": "^5.0.0",
    "@tailwindplus/elements": "^1.0.22",
    "daisyui": "^5.5.19",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "dotenv-cli": "^11.0.0",
    "htmx-ext-head-support": "^2.0.5",
    "htmx-ext-preload": "^2.1.2",
    "htmx-ext-response-targets": "^2.0.4",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.8",
    "hyperscript.org": "^0.9.14",
    "idiomorph": "^0.7.4",
    "tailwindcss": "^4.2.2",
    "tailwindcss-safe-area": "^1.3.0",
    "tailwindcss-visibility": "^1.0.1",
    "transition-style": "^0.1.4"
  },
  "devDependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@cloudflare/containers": "^0.2.2",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "hono": "^4.12.10",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-tailwindcss-extra-plus": "^0.3.1",
    "release-please": "^17.3.0",
    "wrangler": "^4.78.0"
  }
}
