{
  "name": "app.foragd",
  "version": "0.0.0",
  "description": "Foragd is a web-based RSS and feed reader. Follow any website, blog or newsletter in one place. No algorithms, no ads, fully searchable.",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "rss",
    "atom",
    "feed",
    "golang",
    "templ",
    "htmx"
  ],
  "homepage": "https://github.com/immanent-tech/foragd#README",
  "bugs": {
    "url": "https://github.com/immanent-tech/foragd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immanent-tech/foragd.git"
  },
  "browserslist": "last 2 years, not dead, > 0.2%",
  "type": "module",
  "lint": "eslint .",
  "format": "prettier --write .",
  "targets": {
    "frontend": {
      "distDir": "web/content",
      "outputFormat": "esmodule"
    }
  },
  "scripts": {
    "server:run": "go tool air -c server.air.toml",
    "scheduler:run": "go tool air -c scheduler.air.toml",
    "dev:tailwind": "tailwindcss -i ./web/assets/styles.css -o ./web/assets/styles.processed.css",
    "dev:esbuild": "rm web/files/dist/*.js web/files/dist/*.css; esbuild ./web/assets/fonts.css ./web/assets/styles.processed.css ./web/assets/scripts.js --bundle --loader:.woff2=file --loader:.woff=file --entry-names=[name]-[hash]  --asset-names=fonts/[name]-[hash] --public-path=/files --outdir=web/files/dist --metafile=web/files/dist/meta.json",
    "prod:tailwind": "tailwindcss -i ./web/assets/styles.css -o ./web/assets/styles.processed.css --minify",
    "prod:esbuild": "esbuild ./web/assets/fonts.css ./web/assets/styles.processed.css ./web/assets/scripts.js --bundle --minify --loader:.woff2=file --loader:.woff=file --entry-names=[name]-[hash]  --asset-names=fonts/[name]-[hash] --public-path=/files --outdir=web/files/dist --metafile=web/files/dist/meta.json",
    "templ:generate": "go tool templ generate -path web"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@github/relative-time-element": "^5.3.1",
    "@maizzle/framework": "^6.1.7",
    "@tailwindplus/elements": "^1.0.22",
    "daisyui": "^5.7.46",
    "date-fns": "^4.4.0",
    "htmx.org": "^4.0.0",
    "hyperscript.org": "^0.9.93",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-please": "^17.11.2"
  }
}
