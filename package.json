{
  "name": "app.foragd",
  "version": "0.0.0",
  "description": "Foragd is a web-based RSS and feed reader. Follow any website, blog or newsletter in one place. No algorithms, no ads, fully searchable.",
  "license": "AGPL-3.0-or-later",
  "browserslist": "last 2 years, not dead, > 0.2%",
  "type": "module",
  "source": [
    "web/assets/scripts.js",
    "web/assets/styles.css"
  ],
  "targets": {
    "frontend": {
      "distDir": "web/content",
      "outputFormat": "esmodule"
    }
  },
  "scripts": {
    "build:prod": "parcel build --no-source-maps --target frontend",
    "build:dev": "parcel build --no-optimize --target frontend",
    "templ:generate": "go run github.com/a-h/templ/cmd/templ@latest generate -path web"
  },
  "dependencies": {
    "@github/relative-time-element": "^5.2.0",
    "@tailwindplus/elements": "^1.0.22",
    "daisyui": "^5.5.23",
    "date-fns": "^4.4.0",
    "grid-rows-masonry": "^1.2.11",
    "htmx.org": "^2.0.10",
    "hyperscript.org": "^0.9.91",
    "tailwindcss": "^4.3.0",
    "tailwindcss-safe-area": "^1.3.0",
    "tailwindcss-visibility": "^1.0.3"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prettier-plugin-tailwindcss-extra-plus": "^0.3.1",
    "release-please": "^17.9.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
