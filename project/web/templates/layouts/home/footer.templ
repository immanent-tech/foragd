package home

import (
	"github.com/joshuar/go-feed-me/web/templates/partials"
	"github.com/joshuar/go-templ-daisyui/actions/button"
	"github.com/joshuar/go-templ-daisyui/display/icon"
)

type Footer struct {
	backPath string
}

templ (f *Footer) FullRender() {
	<div
		id="content-footer"
		hx-swap-oob="true"
		hx-swap="morph:outerHTML"
		class="bg-base-200 dock dock-sm"
	>
		<div class="basis-xs">
			@partials.BackButton(ctx, f.backPath, ContentTarget)
		</div>
		<div class="basis-xs">
			@button.Build(
				button.WithContent(icon.Build("fa-circle-info")),
			).Show()
		</div>
		<div class="basis-xs">
			@button.Build(
				button.WithContent(icon.Build("fa-bars")),
			).Show()
		</div>
	</div>
}

