package home

import "github.com/joshuar/go-templ-daisyui/feedback/loading"
import "github.com/joshuar/go-templ-daisyui/modifiers/color"

// MainContent of /home consists of zero or more Elements.
type MainContent struct {
	content []Element
	title   string
}

// EmptyContent renders a hero with options for the user when the request
// returned no other content.
templ emptyContent() {
	<div class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">Nothing to show.</h1>
				<p class="py-6">
					Provident cupiditate voluptatem et in. Quaerat fugiat ut assumenda excepturi exercitationem
					quasi. In deleniti eaque aut repudiandae et a id nisi.
				</p>
				<button
					class="btn btn-primary"
					hx-get="/subscription/new"
					hx-target="#command_modal"
				>Add Subscription</button>
			</div>
		</div>
	</div>
}

// FullRender will render the elements wrapped in the content div.
templ (c *MainContent) FullRender() {
	<div id="content" class="flex flex-wrap p-4 h-full">
		@c.PartialRender()
	</div>
}

// PartialRender will render the elements directly.
templ (c *MainContent) PartialRender() {
	if c.title != "" {
		<title>{ c.title }</title>
	}
	if len(c.content) == 0 {
		@emptyContent()
	} else {
		for _, part := range c.content {
			@part.Show()
		}
	}
	<div id="content-loading" class="flex items-center justify-center">
		@loading.Build(loading.Bars,
			loading.AsHTMXIndicator(),
			loading.WithThemeColor(color.Accent),
		).Show()
	</div>
	// <div sse-connect="/home/notifications" sse-swap="notification">
	// 	<div id="test-toast" class="toast toast-end z-50"></div>
	// </div>
	// <div
	// 	hx-get="/home/notifications"
	// 	hx-trigger="load"
	// 	hx-swap="outerHTML"
	// ></div>
}

func BuildMainContent(title string, elements ...Element) *MainContent {
	return &MainContent{
		title:   title,
		content: elements,
	}
}
