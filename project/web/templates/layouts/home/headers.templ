package home

import "github.com/joshuar/go-templ-daisyui/display/icon"
import "github.com/joshuar/go-feed-me/internal/models"

// ListHeader represents the content header for a list of objects.
type ListHeader struct {
	filtersMenu templ.Component
	sortMenu    templ.Component
}

templ (h *ListHeader) Show(classes ...string) {
	<div id="list-header" hx-swap-oob="true">
		<div class="navbar bg-base-100 justify-end">
			// <div class="flex-1"></div>
			<div class="flex flex-row">
				@h.filtersMenu
				@h.sortMenu
			</div>
		</div>
	</div>
}

func BuildListHeader(filters templ.Component, sorts templ.Component) *ListHeader {
	return &ListHeader{
		filtersMenu: filters,
		sortMenu:    sorts,
	}
}

// ArticleHeader represents the content header for an individual article.
type ArticleHeader struct {
	item *models.APIItem
}

templ (h *ArticleHeader) Show(classes ...string) {
	<div id="list-header" hx-swap-oob="true">
		<div class="navbar bg-base-100 justify-end">
			<div class="flex flex-row">
				<a href={ templ.URL(h.item.GetLink()) } target="_blank">
					@icon.Build("fa-globe").Show()
				</a>
			</div>
		</div>
	</div>
}

func BuildArticleHeader(item *models.APIItem) *ArticleHeader {
	return &ArticleHeader{
		item: item,
	}
}
