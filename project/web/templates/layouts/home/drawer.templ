package home

import "github.com/joshuar/go-templ-daisyui/display/text"
import "github.com/joshuar/go-feed-me/internal/models"

templ (side *SideProps) Show() {
	<div
		class="menu bg-base-200 content-center text-base-content min-h-full p-4"
		{ side.ShowAttributes()... }
	>
		@text.Build("Actions",
			text.WithTextWeight(text.Bold),
			text.WithTextSize(text.SM),
		).Show()
		for _, action :=range side.ActionButtons {
			@action.Show()
		}
		@text.Build("Filters",
			text.WithTextWeight(text.Bold),
			text.WithTextSize(text.SM),
		).Show()
		for _, filter := range side.FilterControls {
			@filter
		}
	</div>
}

templ (view *ViewFilterProps) Show() {
	<div role="tablist" class="tabs tabs-boxed tab-xs">
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.ViewRead) }
			{ view.Attributes[models.ViewRead]... }
		>Read</a>
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.ViewUnread) }
			{ view.Attributes[models.ViewUnread]... }
		>Unread</a>
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.ViewAll) }
			{ view.Attributes[models.ViewAll]... }
		>All</a>
	</div>
}
