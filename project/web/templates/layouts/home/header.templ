package home

import "github.com/joshuar/go-templ-daisyui/display/text"
import "github.com/joshuar/go-feed-me/web/templates/partials"

templ Header() {
	<div id="content_header">
		<div tabindex="0" class="collapse bg-base-200">
			@text.Build("Categories", text.WithTextWeight(text.Semibold), text.WithTextSize(text.SM)).Show("collapse-title")
			<div class="collapse-content">
				<p>Category 1</p>
				<p>Category 2</p>
			</div>
		</div>
	</div>
}

templ FeedsHeader(categoryFilters partials.CategoryFilters) {
	<div id="content_header" hx-swap-oob="true">
		<div class="collapse collapse-arrow bg-base-200">
			<input type="checkbox" aria-label="Checkbox" class="btn btn-wide"/>
			// <input type="checkbox"/>
			<div class="collapse-title text-sm font-medium">Feed Categories</div>
			<div class="collapse-content">
				@categoryFilters.Show()
			</div>
		</div>
	</div>
}
