package signup

import "github.com/joshuar/go-feed-me/internal/models"
import "github.com/joshuar/go-templ-daisyui/input/fieldset"
import "github.com/joshuar/go-templ-daisyui/input/textinput"
import "github.com/joshuar/go-templ-daisyui/actions/button"
import "github.com/joshuar/go-templ-daisyui/input/form"
import "github.com/joshuar/go-templ-daisyui/attributes"
import "github.com/joshuar/go-templ-daisyui/feedback/alert"
import "github.com/joshuar/go-templ-daisyui/modifiers/style"
import "github.com/joshuar/go-templ-daisyui/modifiers/state"

const SignupPath = "/signup"

var SignupDetailsID = attributes.ID("signup-details")
var SignupFormID = attributes.ID("signup-form")

templ Show(userDetails *models.UserSignupRequest) {
	<div class="hero bg-base-200 min-h-screen">
		<div class="hero-content flex-col lg:flex-row-reverse">
			<div class="text-center lg:text-left">
				<h1 class="text-5xl font-bold">Sign-up now!</h1>
				<p class="py-6">
					Enter your details below to create an account.
				</p>
			</div>
			<div id={ SignupDetailsID.String() } class="card bg-base-100 w-full max-w-sm shrink-0 shadow-2xl">
				<div class="card-body">
					@SignupForm(userDetails)
				</div>
			</div>
		</div>
	</div>
}

templ SignupForm(userDetails *models.UserSignupRequest) {
	if userDetails.Err != nil {
		@SignupError(userDetails.Err)
	}
	@form.BuildForm(
		form.WithID(SignupFormID.String()),
		form.WithExtraAttributes(
			templ.Attributes{
				"hx-post":   SignupPath,
				"hx-target": SignupFormID.Target(),
				"hx-swap":   "morph:outerHTML",
			},
		),
		form.WithElements(
			fieldset.Build(
				fieldset.WithField("Nickname",
					textinput.Build(
						textinput.WithName("nickname"),
						textinput.WithValue(userDetails.Nickname),
					),
				),
				fieldset.WithField("Email",
					textinput.Build(
						textinput.WithName("email"),
						textinput.AsType(textinput.TypeEmail),
						textinput.WithPlaceholder("you@yourdomain.com"),
						textinput.Required(),
						textinput.Validate(),
						textinput.ValidateHint("Valid email address is required."),
						textinput.WithValue(userDetails.Email),
					),
				),
				fieldset.WithField("Password",
					textinput.Build(
						textinput.WithName("password"),
						textinput.AsType(textinput.TypePassword),
						textinput.Required(),
						textinput.Validate(),
						textinput.ValidatePattern(`(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}`),
						textinput.ValidateMinLength(10),
						textinput.ValidateHint("Password needs to be minimum 10 characters and include at least one: lowercase letter, uppercase letter and number"),
						textinput.WithValue(userDetails.Password),
					),
				),
				fieldset.WithField("",
					button.Build(
						button.WithContent("Sign-up"),
					),
				),
			).Show(),
		),
	).Show()
}

templ SignupSuccess() {
	@alert.Build(state.Success,
		alert.WithStyle(style.Outline),
		alert.WithText("Account created!"),
	).Show()
	<a
		class="btn btn-primary"
		hx-boost="false"
		href="/login/auth0"
	>Login</a>
}

templ SignupError(err *models.ExternalError) {
	<div
		tabindex="0"
		class="collapse collapse-arrow bg-error/50"
	>
		<input type="checkbox"/>
		<div
			class="collapse-title font-semibold text-justify text-sm text-error-content"
		>Problem: { err.Summary }</div>
		<div class="collapse-content text-error-content text-xs">
			if err.Retryable {
				<p>Please check the inputs and try again.</p>
			}
			if err.Details != "" {
				<p class="font-semibold">Technical Details:</p>
				<p class="text-justify">{ err.Details }</p>
			}
		</div>
	</div>
}
