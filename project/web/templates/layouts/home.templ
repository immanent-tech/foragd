package layouts

import "github.com/joshuar/go-feed-me/web/templates/partials/content"

templ HomeLayout(triggerPath string) {
	<!-- Header -->
	<div class="sticky top-0 z-10 w-full">
		<input id="my-drawer-2" type="checkbox" class="drawer-toggle"/>
		@content.AppBarTop()
	</div>
	<div class="drawer lg:drawer-open">
		<!-- Navbar -->
		<input id="home-drawer" type="checkbox" class="drawer-toggle"/>
		@content.Drawer()
		// </div>
		<!-- Main Content Area-->
		<div class="drawer-content flex flex-1 flex-col">
			<!-- Modal for commands -->
			<dialog id="command-modal" class="modal"></dialog>
			<!-- Content -->
			<div class="flex overflow-y-scroll">
				<div id="content" hx-get={ triggerPath } hx-trigger="load" hx-swap="outerHTML" class="flex flex-col space-y-8"></div>
			</div>
			<!-- Footer -->
			@content.AppBarBottom()
			// <div class="sticky top-0 block bg-pink-500 py-5 md:hidden">
			// 	<h1 class="text-center text-xl">Bottom Navigation</h1>
			// </div>
		</div>
		// <div class="hidden h-full flex-[0.3] lg:block">
		// 	<!-- Right Sidebar -->
		// 	<div class="grid h-full place-content-center bg-blue-600">
		// 		<h1 class="text-xl">Right</h1>
		// 		<h1 class="text-xl">Sidebar</h1>
		// 	</div>
		// </div>
	</div>
}
