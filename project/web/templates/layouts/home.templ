package layouts

import "github.com/joshuar/go-templ-daisyui"

templ HomeLayout(content, drawer templ.Component) {
	<div id="command_modal" class="max-w-full"></div>
	@components.Drawer("home_drawer",
		components.WithDrawerVisibility(components.LG),
		components.WithMainContent(content),
		components.WithSideContent(drawer),
	)
}
