package layouts

import (
	"github.com/joshuar/go-templ-daisyui/layout/drawer"
	"github.com/joshuar/go-templ-daisyui/modifiers/size"
)

// HomeLayout defines the layout of the /home pages. These are wrapped in a
// drawer that has page-specific actions/content in the side drawer.
templ HomeLayout(mainContent, sideContent templ.Component) {
	<div id="command_modal" class="container mx-auto px-4"></div>
	@drawer.Build("home_drawer", mainContent, sideContent,
		drawer.WithDrawerVisibility(size.LG),
	).Show()
}
