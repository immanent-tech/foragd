package layouts

import (
	"github.com/joshuar/go-feed-me/web/templates/partials/content"
	"github.com/joshuar/go-templ-daisyui"
)

templ HomeLayout(data templ.Component) {
	<!-- Header -->
	<div class="sticky top-0 z-40 w-full">
		@content.AppBarTop()
	</div>
	@components.NewDrawer("home-drawer",
		components.WithDrawerVisibility(components.LG),
		components.WithMainContent(content.DrawerMain(data)),
		components.WithSideContent(content.DrawerSide()),
		components.WithZIndex[*components.DrawerProps](components.Z50, false),
	).Show()
}
