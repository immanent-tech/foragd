package partials

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

templ CategoryBadge(category models.Category) {
	@components.Badge(
		components.WithResponsiveSize[*components.BadgeProps](components.MD),
	) {
		{ category }
	}
}
