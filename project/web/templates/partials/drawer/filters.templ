package drawer

import "github.com/joshuar/go-feed-me/internal/models"

templ (view *ViewFilterProps) Show() {
	<div role="tablist" class="tabs tabs-boxed tab-xs">
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.Read) }
			{ view.Attributes[models.Read]... }
		>Read</a>
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.Unread) }
			{ view.Attributes[models.Unread]... }
		>Unread</a>
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active",view.Active == models.All) }
			{ view.Attributes[models.All]... }
		>All</a>
	</div>
}
