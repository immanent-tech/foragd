package content

templ Drawer() {
	<div class="drawer-side">
		<label for="home-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
		<div class="bg-base-200 h-svh max-h-svh">
			<h1 class="text-xl">Navigation</h1>
			<h1 class="text-xl">Drawer</h1>
			// @buttonAddItemIcon("join-item")
			// @buttonToggleReadIcon("join-item")
		</div>
	</div>
}
