package content

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

templ ContentHeader() {
	if NavigationFromCtx(ctx).Parent != nil {
		<form method="dialog" hx-target={ "#" + ContentTarget } hx-get={ NavigationFromCtx(ctx).Parent.String() }>
			@components.NewButton("", "back",
				components.WithButtonShape(components.ButtonCircle),
				components.WithColor[components.Button](components.ColorGhost, false),
				components.WithIcon(components.NewIcon("fa-arrow-left"), components.AlignMiddle),
				// components.WithContainerAlignment(components.TopLeft),
			).Show()
		</form>
	}
}

// hx-get={ TriggerFromCtx(ctx) }
// hx-trigger="load"
// hx-swap="innerHTML"
templ DrawerMain(data templ.Component) {
	<!-- Modal for commands -->
	<dialog id="command-modal" class="modal"></dialog>
	<!-- Content -->
	<div id="content">
		<!-- Content Header -->
		<div id="content-header" class="bg-orange-500 sticky top-0 w-full">
			@ContentHeader()
		</div>
		<div id="content-main">
			<!-- Content -->
			<form id={ ContentTarget }>
				@data
			</form>
		</div>
	</div>
	<!-- Footer -->
	@AppBarBottom()
}

templ DrawerSide() {
	<div class="bg-base-200">
		@components.NewButton("", "add",
			components.WithColor[components.Button](components.ColorGhost, false),
			components.WithIcon(components.NewIcon("fa-plus"), components.AlignMiddle),
			components.WithButtonTooltip("Add Item", components.AlignRight),
			components.WithAttributes[components.Button](templ.Attributes{
				"hx-get":    "/subscription/add",
				"hx-target": "#command-modal",
				"_":         "on htmx:afterOnLoad wait 10ms then add .modal-open to #command-modal",
			})).Show()
	</div>
}

// ShowArticle displays an item as an article.
templ ShowArticle(item *models.APIItem) {
	<div id="content-header" hx-swap-oob="true" class="bg-orange-500 sticky top-0 w-full">
		@ContentHeader()
	</div>
	@components.NewArticle(item.GetTitle(), item.GetContent()).Show()
}

// ShowCards displays a list of the given cards.
templ ShowCards(name string, cards ...components.Card) {
	// {{ spew.Dump(ctx) }}
	// <!-- Content Header -->
	<div id="content-header" hx-swap-oob="true" class="bg-orange-500 sticky top-0 w-full">
		@ContentHeader()
	</div>
	// <!-- Content -->
	for _, card := range cards {
		<div>
			@components.NewHiddenInput(card.ID(), name, card.ID()).Show()
			@components.NewHiddenInput(card.ID(), "backlink", NavigationFromCtx(ctx).Backlink.String()).Show()
			@card.Show()
		</div>
	}
	if NavigationFromCtx(ctx).Pagination != "" {
		<div
			hx-get={ NavigationFromCtx(ctx).Backlink.String() + "&pagination=" + NavigationFromCtx(ctx).Pagination }
			hx-trigger="revealed"
			hx-swap="afterend"
		>
			// @components.NewHiddenInput("pagination", "pagination", NavigationFromCtx(ctx).Pagination).Show()
		</div>
	}
}
