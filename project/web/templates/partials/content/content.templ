package content

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

templ ContentHeader() {
	<div
		id="content-header"
		class="bg-base-300 sticky top-0
	z-30 w-full"
		hx-swap-oob="true"
	>
		@components.NewMenu(
			components.WithLayout[components.Menu](components.HorizontalLayout),
			components.WithItems[components.Menu](
				backButton(),
				refreshButton(),
				markAllReadButton(),
			),
		).Show()
	</div>
}

// AppBarBottom displays an app bar at the bottom of the content.
templ ContentFooter() {
	<div
		id="content-footer"
		hx-swap-oob="true"
		class="bg-base-300 sticky z-30
	bottom-0 w-full py-12"
	>
		<h1 class="text-center text-xl">Footer</h1>
	</div>
}

templ DrawerMain(data templ.Component) {
	<!-- Modal for commands -->
	<dialog id="command-modal" class="modal"></dialog>
	<!-- Content -->
	<div id="content">
		@data
	</div>
}

templ DrawerSide() {
	<div class="bg-base-200">
		@components.NewButton("", "add",
			components.WithColor[components.Button](components.ColorGhost, false),
			components.WithIcon("fa-plus", components.AlignMiddle),
			components.WithButtonTooltip("Add Item", components.AlignRight),
			components.WithAttributes[components.Button](templ.Attributes{
				"hx-get":    "/subscription/add",
				"hx-target": "#command-modal",
				"_":         "on htmx:afterOnLoad wait 10ms then add .modal-open to #command-modal",
			})).Show()
	</div>
}

// ShowArticle displays an item as an article.
templ ShowArticle(item *models.APIItem) {
	@ContentHeader()
	<div id="content-main" class="flex flex-row flex-wrap gap-2">
		<div id="article">
			<article class={ "prose dark:prose-invert" }>
				<h2>{ item.Title }</h2>
				if len(item.GetCategories()) > 0 {
					<p>
						for _, c := range item.GetCategories() {
							@components.Badge(
								components.WithBadgeDescription(c),
								components.WithResponsiveSize[components.BadgeProps](components.SM),
								components.WithColor[components.BadgeProps](components.ColorGhost,
									false))
						}
					</p>
				}
				<p class="text-sm justify-end">
					{ RelativeTime(item.GetTimestamp()) }
				</p>
				<p>
					@templ.Raw(item.GetContent())
				</p>
				<center>
					<p>
						<a class="link link-hover" hx-boost="false" href={ templ.URL(item.GetLink()) }>View Original</a>
					</p>
				</center>
			</article>
		</div>
	</div>
	@ContentFooter()
}

// ShowCards displays a list of the given cards.
templ ShowCards(cards ...templ.Component) {
	@ContentHeader()
	<div id="content-main" class="flex flex-row flex-wrap gap-2 w-full">
		for _, card := range cards {
			@card
		}
		// Infinite scroll when bottom of list reached.
		if NavigationFromCtx(ctx).Pagination != "" && len(cards) == NavigationFromCtx(ctx).Count {
			<div
				hx-get={ NavigationFromCtx(ctx).Pagination }
				hx-trigger="revealed"
				hx-swap="afterend"
				hx-push-url="false"
				hx-indicator="#content-loading"
			>
				@components.Loading(components.LoadingBars,
					components.WithID[components.LoadingProps]("content-loading"),
					components.WithColor[components.LoadingProps](components.ColorGhost,
						false),
					components.WithResponsiveSize[components.LoadingProps](components.LG))
			</div>
		}
	</div>
	@ContentFooter()
}
