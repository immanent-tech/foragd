package content

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

templ ContentHeader() {
	<div
		id="content-header"
		class="bg-base-300 sticky top-0
	z-30 w-full"
		hx-swap-oob="true"
	>
		@components.NewMenu(
			components.WithLayout[components.Menu](components.HorizontalLayout),
			components.WithItems[components.Menu](
				backButton(),
				refreshButton(),
				markAllReadButton(),
			),
		).Show()
	</div>
}

// AppBarBottom displays an app bar at the bottom of the content.
templ ContentFooter() {
	<div
		id="content-footer"
		hx-swap-oob="true"
		class="bg-base-300 sticky z-30 bottom-0 w-full py-12"
	>
		<h1 class="text-center text-xl">Footer</h1>
	</div>
}

templ DrawerMain(data templ.Component) {
	<!-- Modal for commands -->
	<div id="command_modal"></div>
	<!-- Content -->
	<div id="content">
		<div id="content-header" class="bg-base-300 sticky top-0 z-30 w-full" hx-swap-oob="true"></div>
		<div id="content-main" class="flex flex-row flex-wrap gap-2 w-full">
			@data
		</div>
		@components.Loading(components.LoadingBars,
			components.WithID[components.LoadingProps]("content-indicator"),
			components.AsHTMXIndicator(),
			components.WithColor[components.LoadingProps](components.ColorGhost,
				false),
			components.WithResponsiveSize[components.LoadingProps](components.LG))
		<div id="content-footer" hx-swap-oob="true" class="bg-base-300 sticky z-30 bottom-0 w-full py-12"></div>
	</div>
}

templ DrawerSide() {
	<div class="bg-base-200">
		@components.Button(
			components.WithID[components.ButtonProps]("add"),
			components.WithColor[components.ButtonProps](components.ColorGhost, false),
			components.WithButtonContent(components.AsIconContent("fa-plus")),
			components.WithAttributes[components.ButtonProps](templ.Attributes{
				"hx-get":    "/home/subscription/add",
				"hx-target": "#command_modal",
				"_":         "on htmx:afterOnLoad wait 10ms then add .modal-open to #add_subscription_modal",
			}))
	</div>
}

// ShowArticle displays an item as an article.
templ ShowArticle(item *models.APIItem) {
	@ContentHeader()
	<div id="content-main" class="flex flex-row flex-wrap gap-2">
		<div id="article">
			@components.Article() {
				<h2>{ item.Title }</h2>
				if len(item.GetCategories()) > 0 {
					<p>
						for _, c := range item.GetCategories() {
							@components.Badge(
								components.WithBadgeDescription(c),
								components.WithResponsiveSize[components.BadgeProps](components.SM),
								components.WithColor[components.BadgeProps](components.ColorGhost,
									false))
						}
					</p>
				}
				<p class="text-sm justify-end">
					{ RelativeTime(item.GetTimestamp()) }
				</p>
				<p>
					@templ.Raw(item.GetContent())
				</p>
				<center>
					<p>
						<a class="link link-hover" hx-boost="false" href={ templ.URL(item.GetLink()) }>View Original</a>
					</p>
				</center>
			}
		</div>
	</div>
	@ContentFooter()
}

// ShowCards displays a list of the given cards.
templ ShowContent(cards ...templ.Component) {
	// Update content header with oob swap.
	@ContentHeader()
	// Show cards.
	for _, card := range cards {
		@card
	}
	// Update content footer with oob swap.
	@ContentFooter()
}

templ ShowEmptyContent() {
	<div class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-md">
				<h1 class="text-5xl font-bold">Nothing to show.</h1>
				<p class="py-6">
					Provident cupiditate voluptatem et in. Quaerat fugiat ut assumenda excepturi exercitationem
					quasi. In deleniti eaque aut repudiandae et a id nisi.
				</p>
				<button
					class="btn btn-primary"
					hx-get="/home/subscription/add"
					hx-target="#command_modal"
				>Add Subscription</button>
			</div>
		</div>
	</div>
}

// _="on htmx:afterOnLoad wait 10ms then add .modal-open to #add_subscription_modal"
