package content

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

// AddSubscriptionForm is a form for a user to enter details about a new
// subscription.
templ AddSubscriptionForm() {
	@components.Modal(
		components.WithID[components.ModalProps]("add_subscription_modal"),
		components.WithModalCloseButton(components.AlignRight),
		components.WithModalCloseOutside(),
	) {
		<form hx-post="/home/subscription/add" hx-target="#command_modal">
			<div class="flex flex-col gap-4">
				{{ req := models.SubscriptionRequestFromCtx(ctx) }}
				if req != nil {
					@req.ShowNameInput()
					@req.ShowURLInput()
					@req.ShowCategoriesInput()
					@components.Button(
						components.NewButton("Add", "add",
							components.WithColor[components.Button](components.ColorPrimary, true)),
					).Show()
				}
			</div>
		</form>
	}
}
