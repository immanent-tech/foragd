package partials

import (
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/layout/indicator"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/joshuar/go-templ-daisyui/modifiers/size"
)

// RequiredInput wraps the given input component with an indicator that signals it
// is required.
templ RequiredInput(component templ.Component) {
	@indicator.BuildBadgeIndicator(
		indicator.WithBadgeOptions(
			badge.WithSize(size.SM),
			badge.WithThemeColor(color.Accent, true),
			badge.WithText("required"),
		),
	).Show() {
		@component
	}
}
