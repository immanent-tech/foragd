package subscription

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/feedback/alert"
)

templ detailsInputs(req *models.APISubscriptionRequest) {
	@components.Form(
		components.WithID[*components.FormProps]("new_subscription"),
		components.WithFormComponents(
			generateNameInput(req),
			generateURLInput(req),
		),
		components.WithAttributes[*components.FormProps](
			templ.Attributes{
				"hx-put": "/subscription/new",
			},
		),
	)
}

templ categoriesInput(req *models.APISubscriptionRequest) {
	@generateCategoriesInput(req)
}

templ manageCategories(req *models.APISubscriptionRequest) {
	@generateCategoriesList(req)
}

templ Form(req *models.APISubscriptionRequest) {
	<div id="add_subscription_form" hx-target="this">
		@detailsInputs(req)
		@categoriesInput(req)
		@manageCategories(req)
		@components.FormControl() {
			@components.Button(
				components.WithID[*components.ButtonProps]("add"),
				components.WithButtonContent(components.AsTextContent("Add")),
				components.WithColor[*components.ButtonProps](components.ColorPrimary, true),
				components.WithAttributes[*components.ButtonProps](templ.Attributes{
					"form": "new_subscription",
				}),
			)
		}
	</div>
}

// NewSubscriptionModal displays a modal for a user to enter new subscription details.
templ Modal(req *models.APISubscriptionRequest) {
	@components.Modal(
		components.WithID[*components.ModalProps]("add_subscription_modal"),
		components.WithModalCloseOutside(),
		components.OpenModalInitially(),
	) {
		<div id="warnings_toast"></div>
		<div class="absolute right-2 top-2 p-2">
			@components.Button(
				components.WithID[*components.ButtonProps]("close"),
				components.WithButtonShape(components.ButtonCircle, false),
				components.WithColor[*components.ButtonProps](components.ColorGhost, false),
				components.WithButtonContent(components.AsIconContent("fa-xmark")),
				components.WithAttributes[*components.ButtonProps](templ.Attributes{
					"_": "on click or keyup[key=='Esc'] take .modal-open from #add_subscription_modal wait 200ms then remove #add_subscription_modal",
				}),
			)
		</div>
		@components.Text("Add a new subscription", components.WithTextSize(components.TextLG))
		@components.Text("Enter the details and click Add", components.AsItalicText())
		if req != nil {
			@Form(req)
		}
	}
}

templ AddCategory(category models.Category) {
	<li>
		@generateCategoryItem(category)
	</li>
}

templ AddSubscriptionSuccess() {
	@components.Modal(
		components.WithID[*components.ModalProps]("subscription_added_modal"),
		components.WithModalCloseOutside(),
		components.OpenModalInitially(),
	) {
		@alert.Success(alert.WithText("Subscription Saved!"))
		// <div class="p-8 flex items-center justify-center"></div>
		<div class="modal-action">
			@components.Button(
				components.WithResponsiveSize[*components.ButtonProps](components.SM),
				components.WithButtonContent(components.AsTextContent("Add Another?")),
				components.WithAttributes[*components.ButtonProps](templ.Attributes{
					"hx-get":    "/subscription/new",
					"hx-target": "#command_modal",
				}),
			)
			// <form method="dialog">
			@components.Button(
				components.WithResponsiveSize[*components.ButtonProps](components.SM),
				components.WithButtonContent(components.AsTextContent("Close")),
				components.WithAutofocus[*components.ButtonProps](),
				components.WithAttributes[*components.ButtonProps](templ.Attributes{
					"_": "on click trigger closeModal",
				}),
			)
			// </form>
		</div>
	}
}

templ AddSubscriptionWarning(message string) {
	<div id="warnings_toast" hx-swap-oob="true">
		@alert.Warning(
			alert.WithID("warning"),
			alert.WithText(message),
		) {
			@components.Button(
				components.WithResponsiveSize[*components.ButtonProps](components.SM),
				components.WithButtonContent(components.AsTextContent("Okay")),
				components.WithAutofocus[*components.ButtonProps](),
				components.WithAttributes[*components.ButtonProps](templ.Attributes{
					"_": "on click remove #warning",
				}),
			)
		}
	</div>
}
