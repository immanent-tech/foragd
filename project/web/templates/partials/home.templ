package partials

import "github.com/joshuar/go-templ-daisyui"

// skeletonCard displays a skeleton that can represent a feed card that is
// loading.
templ skeletonCard() {
	<div class="skeleton h-32 w-32"></div>
	<div class="flex items-center gap-4">
		<div class="flex flex-col gap-4">
			<div class="skeleton h-6 w-28"></div>
			<div class="skeleton h-4 w-24"></div>
		</div>
	</div>
}

templ ShowCardList(cards ...components.Card) {
	<div id="content" class="flex flex-col space-y-8">
		for _, card := range cards {
			<div>
				// Render a hidden input for this feed.
				@components.NewHiddenInput(card.ID(), "feeds", card.ID()).Show()
				// Render the feed card.
				@card.Show()
			</div>
		}
	</div>
}

templ ShowFeeds(cards ...components.Card) {
	@ShowCardList(cards...)
}

templ ShowItems(cards ...components.Card) {
}
