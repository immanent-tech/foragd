package templates

templ PageTempl(data Page, bodyContent ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(data.CustomHeaders)
		<body hx-ext="sse">
			for _, content := range bodyContent {
				@content
			}
		</body>
	</html>
}
