package panes

import (
	"github.com/joshuar/go-templ-daisyui"
	"github.com/joshuar/go-templ-daisyui/display/badge"
	"github.com/joshuar/go-templ-daisyui/display/text"
	"github.com/joshuar/go-templ-daisyui/modifiers/color"
	"github.com/joshuar/go-templ-daisyui/navigation/menu"

	"github.com/joshuar/go-feed-me/internal/models"
	"strconv"
)

templ Header() {
	<div
		id="content-header"
		hx-swap-oob="true"
		class="bg-base-300 sticky top-0 max-w-full"
	>
		// {{ markReadURL := models.PageNavigationFromCtx(ctx).GenerateActionURL(models.StateRead) }}
		@menu.Build(
			menu.WithLayout(menu.Horizontal),
		).Show(
			navButton(models.PageNavigationFromCtx(ctx).Parent.String(), "fa-arrow-left", "Back"),
			navButton(models.PageNavigationFromCtx(ctx).Current.String(), "fa-rotate", "Refresh"),
			// navButton(markReadURL.String(), "fa-check", "Mark All Read"),
		)
	</div>
}

// AppBarBottom displays an app bar at the bottom of the content.
templ Footer() {
	<div
		id="content-footer"
		hx-swap-oob="true"
		class="bg-base-300 sticky bottom-0 py-12 max-w-full"
	>
		<h1 class="text-center text-xl">Footer</h1>
	</div>
}

// AllContent will display all content (headers, footers, main content, etc.)
templ AllContent(bar, header, footer, cards templ.Component) {
	@bar
	@header
	<div class="flex flex-col items-center justify-center">
		<div id="content">
			@cards
		</div>
		@components.Loading(components.LoadingBars,
			components.WithID[*components.LoadingProps]("content-loading"),
			components.AsHTMXIndicator(),
			components.WithColor[*components.LoadingProps](components.ColorGhost,
				false),
			components.WithResponsiveSize[*components.LoadingProps](components.LG))
	</div>
	@footer
}

templ FeedCard(feed Feed) {
	@text.Build(feed.GetTitle(),
		text.WithTextSize(text.LG),
		text.WithTextWeight(text.Semibold),
	).Show()
	@badge.Build(
		badge.WithThemeColor(color.Primary, false),
		badge.WithText(strconv.Itoa(feed.GetUnreadCount())),
	).Show()
	@templ.Raw(feed.GetContent())
}
