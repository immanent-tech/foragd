package content

import (
	"github.com/joshuar/go-feed-me/internal/models"
	"github.com/joshuar/go-templ-daisyui"
)

// wrapContent wraps children with the appropriate div for displaying main home content.
templ wrapContent() {
	<div id="content" class="flex flex-col space-y-8">
		{ children... }
	</div>
}

// ShowFeeds shows a list of feed cards.
templ ShowFeeds(cards ...components.Card) {
	@wrapContent() {
		@showCardList("feeds", cards...)
	}
}

// ShowFeedItems shows a list of item cards.
templ ShowFeedItems(cards ...components.Card) {
	@wrapContent() {
		<form method="dialog">
			@navButton("/home/feeds").Show()
		</form>
		@showCardList("items", cards...)
	}
}

templ ShowItem(item *models.APIItem) {
	@wrapContent() {
		<form method="dialog">
			@navButton("/home/items").Show()
		</form>
		@item.AsArticle().Show()
		if len(item.CategoryBadges()) > 0 {
			<div class="badges">
				for _, badge := range item.CategoryBadges() {
					@badge.Show()
				}
			</div>
		}
	}
}

templ showCardList(name string, cards ...components.Card) {
	for _, card := range cards {
		<form>
			// Render a hidden input for this feed.
			@components.NewHiddenInput(card.ID(), name, card.ID()).Show()
			// Render the feed card.
			@card.Show()
		</form>
	}
}

func navButton(link string) components.Button {
	return components.NewButton("", "back",
		components.AsShape(components.ButtonCircle),
		components.WithModifier(components.ButtonGhost),
		components.WithIcon(components.NewIcon("arrow-left"), components.AlignMiddle),
		components.WithClasses[components.Button]("left-2", "top-2"),
		components.WithAttributes[components.Button](templ.Attributes{
			"hx-target": "#content",
			"hx-get":    link}),
	)
}
