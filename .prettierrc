{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSameLine": true,
  "htmlWhitespaceSensitivity": "css",
  "plugins": ["@prettier/plugin-xml", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./web/assets/styles.css"
}
