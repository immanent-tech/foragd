  "version": "2.0.0",
  "tasks": [
    {
      "label": "gowebly: doctor",
      "type": "shell",
      "command": "go run github.com/gowebly/gowebly/v3@latest doctor",
      "problemMatcher": []
    },
    {
      "label": "gowebly: run",
      "type": "shell",
      "command": "go run github.com/gowebly/gowebly/v3@latest run",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "service: scheduler",
      "type": "shell",
      "command": "go run main.go --log-level=debug scheduler",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Logs: view server log",
      "type": "shell",
      "command": "tail -F deployments/server.log",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
