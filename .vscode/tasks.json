{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "server: run",
      "type": "shell",
      "command": "air -c server.air.toml",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "scheduler: run",
      "type": "shell",
      "command": "air -c scheduler.air.toml",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
    },
    {
      "label": "elastic: update indices",
      "type": "shell",
      "command": "dotenv -e .env.${input:environment} go run main.go --log-level=debug --no-log-file elastic indices update ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "elastic: migrate indices",
      "type": "shell",
      "command": "dotenv -e .env.${input:environment} go run main.go --log-level=debug --no-log-file elastic indices migrate ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "elastic: create indices",
      "type": "shell",
      "command": "dotenv -e .env.${input:environment} go run main.go --log-level=debug --no-log-file elastic indices create ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "elastic: update ilm",
      "type": "shell",
      "command": "dotenv -e .env.${input:environment} go run main.go --log-level=debug --no-log-file elastic ilm update ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "email: run",
      "type": "shell",
      "command": "dotenv -e ../.env.${input:environment} npx maizzle serve ${input:environment}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}/email",
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "email: build",
      "type": "shell",
      "command": "dotenv -e ../.env.${input:environment} mage build ${input:environment}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/email"
      }
    },
    {
      "label": "email: install",
      "type": "shell",
      "command": "dotenv -e ../.env.${input:environment} mage install ${input:environment}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/email"
      }
    },
    {
      "label": "reverseproxy: deploy",
      "type": "shell",
      "command": "wrangler deploy",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/reverseproxy/js"
      }
    },
    {
      "label": "android: build apk",
      "type": "shell",
      "command": "dotenv -e ../.env.${input:environment} bubblewrap build --manifest /workspace/.devcontainer/twa-manifest-secret.json",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/usr/bin/fish",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/android"
      }
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "objects",
      "description": "list of objects to update (leave blank for all available)"
    },
    {
      "type": "pickString",
      "id": "environment",
      "description": "choose envrionment",
      "options": [
        "production",
        "development"
      ],
      "default": "development"
    }
  ]
}
