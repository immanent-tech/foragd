{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run: server",
      "type": "shell",
      "command": "air -c server.air.toml",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "run: scheduler",
      "type": "shell",
      "command": "air -c scheduler.air.toml",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
    },
    {
      "label": "run: elastic|indices|update",
      "type": "shell",
      "command": "node_modules/.bin/dotenv -e .env.${input:environment} -- go run -ldflags=\"-X github.com/immanent-tech/foragd/config.Version=$(git describe --tags --always --long --dirty)\" main.go --log-level=debug --no-log-file elastic indices update ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "run: elastic|indices|migrate",
      "type": "shell",
      "command": "node_modules/.bin/dotenv -e .env.${input:environment} -- go run -ldflags=\"-X github.com/immanent-tech/foragd/config.Version=$(git describe --tags --always --long --dirty)\" main.go --log-level=debug --no-log-file elastic indices migrate ${input:objects}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "run: stripe listen",
      "type": "shell",
      "command": "/usr/local/bin/stripe listen --skip-verify --forward-to localhost:7000/checkout/webhooks",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "email: run server",
      "type": "shell",
      "command": "npx maizzle serve",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}/email",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      }
    },
    {
      "label": "email: build",
      "type": "shell",
      "command": "dotenv -e ../.env.development -- mage build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/email"
      }
    },
    {
      "label": "email: install",
      "type": "shell",
      "command": "dotenv -e ../.env.development -- mage install",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ],
        },
        "cwd": "${workspaceFolder}/email"
      }
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "objects",
      "description": "list of objects to update (leave blank for all available)"
    },
    {
      "type": "pickString",
      "id": "environment",
      "description": "choose envrionment",
      "options": [
        "production",
        "development"
      ],
      "default": "development"
    }
  ]
}
