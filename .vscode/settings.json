{
  "[go.mod]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ"
  },
  "conventionalCommits.lineBreak": "\\n",
  "conventionalCommits.scopes": [
    "models",
    "platforms/elastic",
    "components/layout",
    "components/image",
    "components/card",
    "components/table",
    "components/tabs",
    "components/tooltip",
    "components/menu",
    "components/button",
    "components/icon",
    "components/modal",
    "components/input",
    "components/list",
    "components/badge",
    "components/fit",
    "components/header",
    "components/size",
    "components/article",
    "components/drawer",
    "components/loading",
    "components/indicator",
    "components/form",
    "components/dropdown",
    "components/alert",
    "devcontainer",
    "go",
    "scheduler",
    "providers/elastic",
    "layouts/home",
    "components/text",
    "layouts/settings",
    "layouts",
    "handlers",
    "partials",
    "templates",
    "session",
    "elastic",
    "views",
    "components/join",
    "components",
    "components/dock",
    "schemas",
    "cli",
    "css"
  ],
  "editor.formatOnSave": true,
  "emmet.includeLanguages": {
    "templ": "html"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/*_templ.go": true,
    "**/CVS": true,
    "**/Thumbs.db": true
  },
  "go.alternateTools": {
    "customFormatter": "golangci-lint"
  },
  "go.formatFlags": ["fmt", "--stdin"],
  "go.formatTool": "custom",
  "go.inlayHints.constantValues": true,
  "go.lintFlags": [
    "run",
    "--timeout=5m",
    "--issues-exit-code=0",
    "--output.text.colors=true",
    "--output.text.path=stdout",
    "--output.text.print-issued-lines=false",
    "--show-stats=false"
  ],
  "go.lintTool": "golangci-lint",
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true
  },
  "licenser.author": "Joshua Rich <joshua.rich@gmail.com>",
  "licenser.license": "AGPLv3",
  "licenser.useSPDXLicenseFormat": true,
  "ltex.language": "en-AU",
  "tailwindCSS.includeLanguages": {
    "templ": "html"
  },
  "templ.goplsRemote": "auto",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.scrollback": 10000
}
