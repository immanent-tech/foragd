{
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.cwd": "${workspaceFolder}/project",
  "editor.formatOnSave": true,
  "gopls": {
    "formatting.local": "github.com/joshuar/go-feed-me",
    "ui.semanticTokens": true,
    "ui.noSemanticString": true, // delegates string syntax highlighting to vscode
    "ui.noSemanticNumber": true, // delegates number syntax highlighting to vscode
    "formatting.gofumpt": true,
    "ui.diagnostic.analyses": {
      "unusedvariable": true,
      "copylocks": false,
    }
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*_templ.go": true,
  },
  "licenser.author": "Joshua Rich <joshua.rich@gmail.com>",
  "licenser.license": "AGPLv3",
  "licenser.useSPDXLicenseFormat": true,
  "conventionalCommits.scopes": [
    "server",
    "css",
    "vscode",
    "go",
    "devcontainer",
    "user",
    "handlers",
    "git",
    "templates",
    "platforms/auth0",
    "resources",
    "templates/components",
    "platforms/postgres",
    "git/github",
    "ci/github",
    "models",
    "platforms/elastic",
    "templates/meta",
    "components/layout",
    "components/image",
    "assets",
    "components/card",
    "components/table",
    "components/tabs",
    "templates/pages",
    "templates/partials",
    "components/tooltip",
    "components/menu",
    "components",
    "modifiers/size",
    "modifiers/alignment",
    "modifiers/layout",
    "components/button",
    "components/icon",
    "components/modal",
    "components/input",
    "components/list",
    "platforms/scheduler",
    "components/badge",
    "components/fit",
    "components/header",
    "components/size",
    "components/article",
    "middlewares",
    "models,server",
    "logging",
    "modifiers/z-index",
    "components/drawer",
    "templates/layouts",
    "components/loading",
    "templates/content",
    "components/indicator",
    "modifiers/attributes",
    "modifiers/shadow",
    "modifiers/mask",
    "modifiers/object",
    "modifiers/color",
    "routes/home",
    "components/form",
    "components/dropdown",
    "components/alert",
    "modifiers/state",
    "internal/id",
    "cli",
    "app/scheduler",
    "components/text",
    "routes",
    "modifier/position",
    "components/toggle",
    "components/navbar",
    "modifiers",
    "server/middlewares"
  ],
  "emmet.includeLanguages": {
    "templ": "html"
  },
  "conventionalCommits.lineBreak": "\\n",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--fast"
  ],
  "go.useLanguageServer": true,
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always"
    }
  },
  "[go.mod]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "ltex.language": "en-AU",
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ"
  },
  "tailwindCSS.includeLanguages": {
    "templ": "html"
  },
  "files.associations": {
    "*.scss": "tailwindcss"
  },
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "server": "postgres",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "Go Feed Me",
      "database": "gofeedme",
      "username": "gofeedme"
    }
  ],
  "yaml.schemas": {
    "https://spec.openapis.org/oas/3.1/schema/2022-10-07": "file:///workspace/project/api/server/api.yaml"
  }
}
