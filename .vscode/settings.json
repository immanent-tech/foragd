{
  "go.lintTool": "golangci-lint",
  "go.lintFlags": ["--path-mode=abs", "--fast-only"],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint"
  },
  "go.formatFlags": ["fmt", "--stdin"],
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ"
  },
  "gopls": {
    "ui.diagnostic.staticcheck": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "emmet.includeLanguages": {
    "templ": "html"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/*_templ.go": true,
    "**/CVS": true,
    "**/Thumbs.db": true,
    "**/dist": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/*_templ.go": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "**/*_templ.go": true
  },
  "html.format.wrapAttributes": "force-expand-multiline",
  "licenser.author": "Joshua Rich <joshua.rich@gmail.com>",
  "licenser.license": "AGPLv3",
  "licenser.useSPDXLicenseFormat": true,
  "prettier.bracketSameLine": true,
  "rewrap.wrappingColumn": 120,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.includeLanguages": {
    "templ": "html"
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.scrollback": 10000,
  "xmlTools.enforcePrettySelfClosingTagOnFormat": true,
  "xmlTools.splitAttributesOnFormat": true,
  "git.autofetch": true,
  "git.followTagsWhenSync": true,
  "git.enableSmartCommit": true,
  "markdown.validate.enabled": true,
  "harper-ls": {
    "excludePatterns": ["**/*.go", "**/*_templ.go"]
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.format.semicolons": "insert",
  "psi-header.config": {
    "forceToTop": true,
    "creation": "new",
    "blankLinesAfter": 1,
    "license": "AGPLv3"
  },
  "psi-header.templates": [
    {
      "language": "*",
      "template": [
        "Copyright (c) <<year>> <<company>>",
        "SPDX-License-Identifier: AGPL-3.0-or-later"
      ]
    }
  ],
  "psi-header.changes-tracking": {
    "isActive": true,
    "modAuthor": "Modified By:",
    "modDate": "Last Modified:",
    "modDateFormat": "date"
  },
  "psi-header.variables": [["company", "Immanent Tech"]]
}
