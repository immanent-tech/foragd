{
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go.mod]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "always"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ"
  },
  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml"
  },
  "css.lint.idSelector": "warning",
  "emmet.includeLanguages": {
    "templ": "html"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/*_templ.go": true,
    "**/CVS": true,
    "**/Thumbs.db": true
  },
  "go.alternateTools": {
    "customFormatter": "golangci-lint-v2"
  },
  "go.formatFlags": [
    "fmt",
    "--stdin"
  ],
  "go.formatTool": "custom",
  "go.inlayHints.constantValues": true,
  "go.lintFlags": [
    "run",
    "--timeout=5m",
    "--issues-exit-code=0",
    "--output.text.colors=true",
    "--output.text.path=stdout",
    "--output.text.print-issued-lines=false",
    "--show-stats=false"
  ],
  "go.lintTool": "golangci-lint-v2",
  "go.useLanguageServer": true,
  "gopls": {
    "ui.semanticTokens": true
  },
  "html.format.wrapAttributes": "force-expand-multiline",
  "licenser.author": "Joshua Rich <joshua.rich@gmail.com>",
  "licenser.license": "AGPLv3",
  "licenser.useSPDXLicenseFormat": true,
  "prettier.bracketSameLine": true,
  "rewrap.wrappingColumn": 120,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.includeLanguages": {
    "templ": "html"
  },
  "templ.goplsRemote": "auto",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.scrollback": 10000,
  "xmlTools.enforcePrettySelfClosingTagOnFormat": true,
  "xmlTools.splitAttributesOnFormat": true,
  "git.autofetch": true,
  "git.followTagsWhenSync": true,
  "git.enableSmartCommit": true,
}
